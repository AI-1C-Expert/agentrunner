// CMPT-03: строит редактор текстового поля секции «Совместимость» - textarea
// для редактируемых tools, read-only span (тот же класс ar-refval, что уже
// использует HTMLСекцияПакет) для пакетных.
//
// Параметры:
//  ЭтоПакет - Булево - Объект.ar_ИсточникТип = "Пакет".
//  Ид       - Строка - id HTML-элемента (используется только когда Не ЭтоПакет,
//             т.к. в read-only ветке элемент с этим id не создаётся - см.
//             СобратьДанныеИзDOM/ДобавитьЗначениеИзDOM: отсутствие id в DOM
//             у пакетного tool означает, что поле молча не будет отправлено).
//  Строки   - Число - атрибут rows textarea.
//  Значение - Строка - текущее значение реквизита.
//
&НаСервере
Функция HTMLРедакторTextarea(Знач ЭтоПакет, Знач Ид, Знач Строки, Знач Значение)

	Если ЭтоПакет Тогда
		Возврат "<span class=""ar-refval"">" + ar_ЭкранироватьHTML(Значение) + "</span>";
	КонецЕсли;

	Возврат "<textarea id=""" + Ид + """ class=""ar-textarea ar-textarea-mid ar-code"" rows=""" + Строки + """ spellcheck=""false"">"
		+ ar_ЭкранироватьHTML(Значение) + "</textarea>";

КонецФункции

// CMPT-03: строит редактор однострочного текстового поля секции
// «Совместимость» - input для редактируемых tools, read-only span для
// пакетных. См. HTMLРедакторTextarea.
//
&НаСервере
Функция HTMLРедакторInput(Знач ЭтоПакет, Знач Ид, Знач Значение)

