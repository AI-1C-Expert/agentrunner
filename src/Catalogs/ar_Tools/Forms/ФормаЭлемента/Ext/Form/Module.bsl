// Секция «Реализация»: переключатель режима + поля выбранного режима.
//
&НаСервере
Функция HTMLСекцияРеализация()

	РежимКод = (Объект.ar_ТипРеализации = "Код");

	Вкладки =
		"<div class=""ar-tabs"">"
		+ СсылкаДействие("mode", "value=Процедура",
			НСтр("ru='Процедура модуля'; en='Module procedure'"),
			"ar-tab" + ?(РежимКод, "", " ar-tab-active"))
		+ СсылкаДействие("mode", "value=Код",
			НСтр("ru='Код 1С'; en='1C code'"),
			"ar-tab" + ?(РежимКод, " ar-tab-active", ""))
		+ "</div>";

	Если РежимКод Тогда
		// SEC-TOOL-01: предупреждение различается по состоянию константы
		// ar_РазрешитьТулыВРежимеКод - явный текст вместо чек-бокса без
		// пояснения (UC-2/UC-3 спеки, DoD D8).
		//
		// Режим остаётся редактируемым и при выключенной константе: администратор
		// настраивает tool до её включения. Запрет на вызов обеспечивает
		// диспетчер, карточка лишь показывает состояние - выключенная константа
		// оформлена плашкой ar-banner (как недоступность), чтобы «в стол»
		// записанный код не выглядел рабочим.
		Если ar_Константы.РазрешитьТулыВРежимеКод() Тогда
			ТекстПредупрежденияКод = НСтр(
				"ru='Внимание: код выполняется в правах пользователя сессии, без блокировки чтения данных / записи в обход подтверждений / HTTP-запросов - см. .docs/Модель-угроз-режим-Код.md.';
				|en='Warning: the code runs with the session user rights, without blocking data reads / writes bypassing approval / HTTP requests - see .docs/Модель-угроз-режим-Код.md.'");
			КлассПредупрежденияКод = "ar-note ar-note-warning";
		Иначе
			ТекстПредупрежденияКод = НСтр(
				"ru='Режим «Код» заблокирован: tool не будет вызван, пока администратор не включит константу ar_РазрешитьТулыВРежимеКод (Настройки AgentRunner). Запись карточки при этом разрешена.';
				|en='""Code"" mode is blocked: the tool will not be called until an administrator enables the ar_РазрешитьТулыВРежимеКод constant (AgentRunner Settings). Saving the card is still allowed.'");
			КлассПредупрежденияКод = "ar-banner";
		КонецЕсли;

		Поля =
			"<div class=""" + КлассПредупрежденияКод + """>"
			+ ar_ЭкранироватьHTML(ТекстПредупрежденияКод)
			+ "</div>"
			+ "<div class=""ar-note"">"
			+ ar_ЭкранироватьHTML(НСтр(
				"ru='Код выполняется при вызове tool в безопасном режиме. Доступны переменные: Аргументы (Строка, JSON-аргументы от LLM), Контекст (Структура запуска: RunId, Агент, DryRun и др.) и Результат (Строка; присвойте JSON-строку observation, которая вернётся модели).';
				|en='The code runs on tool call in safe mode. Available variables: Аргументы (String, JSON arguments from the LLM), Контекст (run structure: RunId, agent, DryRun etc.) and Результат (String; assign the JSON observation string returned to the model).'"))
			+ "</div>"
			+ "<textarea id=""fld_code"" class=""ar-textarea ar-code"" rows=""14"" spellcheck=""false"">"
			+ ar_ЭкранироватьHTML(Объект.ar_КодРеализации) + "</textarea>";
	Иначе
		Поля =
			HTMLСтрокаПоля(
				НСтр("ru='Общий модуль'; en='Common module'"),
				НСтр("ru='Имя общего модуля-реализации (например ar_ToolCRM).'; en='Implementation common module name (e.g. ar_ToolCRM).'"),
				"<input id=""fld_module"" class=""ar-input ar-input-wide"" type=""text"" value="""
					+ ar_ЭкранироватьHTML(Объект.ar_ОбщийМодуль) + """>")
			+ HTMLСтрокаПоля(
				НСтр("ru='Имя процедуры'; en='Procedure name'"),
				НСтр("ru='Экспортная функция внутри общего модуля (например ПоискКлиентов).'; en='Export function inside the common module (e.g. ПоискКлиентов).'"),
				"<input id=""fld_procedure"" class=""ar-input ar-input-wide"" type=""text"" value="""
					+ ar_ЭкранироватьHTML(Объект.ar_ИмяПроцедуры) + """>");
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Реализация'; en='Implementation'")) + "</h2>"
		+ Вкладки
		+ Поля
		+ "</div>";

КонецФункции

