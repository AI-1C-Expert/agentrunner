		+ ar_ЭкранироватьHTML(НСтр("ru='(не выбран)'; en='(not selected)'")) + "</option>";

	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.ar_RiskLevel.ЗначенияПеречисления Цикл
