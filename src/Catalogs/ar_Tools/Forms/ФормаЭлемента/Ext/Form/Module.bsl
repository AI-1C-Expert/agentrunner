////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_Tools.
//
// Карточка tool на базе единого HTML-поля (ПолеHTMLTool) - тот же подход,
// что в общих формах ar_Настройки и ar_Диалог и в карточке ar_Hooks: сервер
// собирает HTML карточки, обратная связь HTML -> BSL идёт через штатное событие
// поля ПриНажатии и служебные ссылки "1c://<действие>?<параметры>". Значения
// полей ввода читаются из DOM (Элементы.ПолеHTMLTool.Документ.getElementById) -
// работает в толстом/тонком клиенте; в веб-клиенте DOM-доступ деградирует,
// поэтому чтение обёрнуто в Попытку.
//
// Два режима реализации tool (ar_ТипРеализации):
//   "Процедура" - общий модуль + экспортная процедура (двухуровневое ветвление
//                 ar_ToolDispatcher, без Выполнить());
//   "Код"       - произвольный код 1С (ar_КодРеализации), исполняемый
//                 диспетчером через Выполнить() в безопасном режиме.
//
// Запись объекта - только через HTML-кнопки «Записать» / «Записать и закрыть»:
// перед любым действием значения из DOM переносятся в Объект, поэтому
// перерисовка панели не теряет введённые данные.
//
// Поле Наименование можно оставить пустым - авто-заполняется из ar_Имя
// в ObjectModule.ПередЗаписью (META-12).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Единый паттерн форм расширения: при программном открытии тестами - выход.
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// Значения по умолчанию для нового объекта.
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ar_Включён = Истина;
	КонецЕсли;

	Если ПустаяСтрока(Объект.ar_ТипРеализации) Тогда
		Объект.ar_ТипРеализации = ?(ПустаяСтрока(Объект.ar_КодРеализации), "Процедура", "Код");
	КонецЕсли;

	ПерерисоватьКарточку();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Обрабатывает клик по любому элементу внутри HTML-карточки tool.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент             - ПолеФормы - поле ПолеHTMLTool.
//  ДанныеСобытия       - ФиксированнаяСтруктура - данные DOM-события клика
//                        (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                        открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLToolПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	// Дальше ссылку обрабатываем сами.
	СтандартнаяОбработка = Ложь;

	Действие = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	// Перед любым действием переносим введённые значения из DOM в Объект,
	// чтобы перерисовка панели не потеряла правки пользователя.
	ДанныеПолей = СобратьДанныеИзDOM();

	Если Действие = "save" Тогда
		ЗаписатьTool(ДанныеПолей, Ложь);
	ИначеЕсли Действие = "save-close" Тогда
		ЗаписатьTool(ДанныеПолей, Истина);
	ИначеЕсли Действие = "mode" Тогда
		РежимРеализации = "";
		ПараметрыСсылки.Свойство("value", РежимРеализации);
		ПереключитьРежим(ДанныеПолей, РежимРеализации);
	ИначеЕсли Действие = "toggle" Тогда
		КлючФлага = "";
		ПараметрыСсылки.Свойство("key", КлючФлага);
		ПереключитьФлаг(ДанныеПолей, КлючФлага);
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаДействийКлиента

// Читает значения всех полей ввода карточки из DOM HTML-документа.
//
// Возвращаемое значение:
//  Структура - { ИмяПоля -> Строка } только для полей, которые удалось прочитать
//  (в веб-клиенте DOM недоступен - структура может быть пустой).
//
&НаКлиенте
Функция СобратьДанныеИзDOM()

	Данные = Новый Структура;

	ДобавитьЗначениеИзDOM(Данные, "name",        "fld_name");
	ДобавитьЗначениеИзDOM(Данные, "toolname",    "fld_toolname");
	ДобавитьЗначениеИзDOM(Данные, "description", "fld_description");
	ДобавитьЗначениеИзDOM(Данные, "risk",        "fld_risk");
	ДобавитьЗначениеИзDOM(Данные, "version",     "fld_version");
	ДобавитьЗначениеИзDOM(Данные, "source",      "fld_source");
	ДобавитьЗначениеИзDOM(Данные, "required",    "fld_required");
	ДобавитьЗначениеИзDOM(Данные, "configs",     "fld_configs");
	ДобавитьЗначениеИзDOM(Данные, "min_cfg_version", "fld_min_cfg_version");
	ДобавитьЗначениеИзDOM(Данные, "max_cfg_version", "fld_max_cfg_version");
	ДобавитьЗначениеИзDOM(Данные, "min_ar_version",  "fld_min_ar_version");
	ДобавитьЗначениеИзDOM(Данные, "subsystems",  "fld_subsystems");
	ДобавитьЗначениеИзDOM(Данные, "manifest",    "fld_manifest");
	ДобавитьЗначениеИзDOM(Данные, "module",      "fld_module");
	ДобавитьЗначениеИзDOM(Данные, "procedure",   "fld_procedure");
	ДобавитьЗначениеИзDOM(Данные, "code",        "fld_code");

	Возврат Данные;

КонецФункции

// Читает значение одного элемента input/textarea/select по id из DOM и кладёт
// его в структуру данных. Отсутствие элемента/DOM - молча пропускаем.
//
&НаКлиенте
Процедура ДобавитьЗначениеИзDOM(Данные, Знач ИмяПоля, Знач Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLTool.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Данные.Вставить(ИмяПоля, "" + ЭлементВвода.value);
	Исключение
		// DOM недоступен (веб-клиент) - поле останется нетронутым в Объект.
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Записывает tool: переносит данные DOM в Объект, проверяет заполнение и пишет.
//
&НаКлиенте
Процедура ЗаписатьTool(Знач ДанныеПолей, Знач ЗакрытьПослеЗаписи)

	Результат = ЗаписатьToolНаСервере(ДанныеПолей);

	Если Результат.Успех Тогда
		ОповеститьОбИзменении(Объект.Ссылка);
		Оповестить("Запись_ar_Tools", Новый Структура("Ссылка", Объект.Ссылка), ЭтотОбъект);
		Если ЗакрытьПослеЗаписи Тогда
			Закрыть();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Переключает режим реализации (Процедура/Код) с сохранением введённых данных.
//
&НаКлиенте
Процедура ПереключитьРежим(Знач ДанныеПолей, Знач РежимРеализации)

	Если РежимРеализации <> "Процедура" И РежимРеализации <> "Код" Тогда
		Возврат;
	КонецЕсли;

	ПереключитьРежимНаСервере(ДанныеПолей, РежимРеализации);

КонецПроцедуры

// Инвертирует булев флаг карточки (Включён / ТребуетApproval) с сохранением
// введённых данных.
//
&НаКлиенте
Процедура ПереключитьФлаг(Знач ДанныеПолей, Знач КлючФлага)

	Если КлючФлага <> "enabled" И КлючФлага <> "approval" И КлючФлага <> "adapter"
		И КлючФлага <> "measure" Тогда
		Возврат;
	КонецЕсли;

	ПереключитьФлагНаСервере(ДанныеПолей, КлючФлага);

КонецПроцедуры

#КонецОбласти

#Область СерверныеДействия

// Переносит прочитанные из DOM значения в реквизиты Объект.
//
// Параметры:
//  ДанныеПолей - Структура - { имя поля -> строковое значение } из DOM.
//
&НаСервере
Процедура ПрименитьДанныеКОбъекту(Знач ДанныеПолей)

	Значение = Неопределено;

	Если ДанныеПолей.Свойство("name", Значение) Тогда
		Объект.Наименование = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("toolname", Значение) Тогда
		Объект.ar_Имя = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("description", Значение) Тогда
		Объект.ar_Описание = Значение;
	КонецЕсли;

	Если ДанныеПолей.Свойство("risk", Значение) Тогда
		Объект.ar_RiskLevel = RiskLevelПоИмени(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("version", Значение) Тогда
		Объект.ar_Версия = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("source", Значение) Тогда
		Объект.ar_ИсточникРасширение = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("required", Значение) Тогда
		Объект.ar_ТребуемыеОбъекты = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("configs", Значение) Тогда
		Объект.ar_ПоддерживаемыеКонфигурации = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("manifest", Значение) Тогда
		Объект.ar_JSONManifest = Значение;
	КонецЕсли;

	Если ДанныеПолей.Свойство("module", Значение) Тогда
		Объект.ar_ОбщийМодуль = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("procedure", Значение) Тогда
		Объект.ar_ИмяПроцедуры = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("code", Значение) Тогда
		Объект.ar_КодРеализации = Значение;
	КонецЕсли;

	ПрименитьДанныеСовместимостиКОбъекту(ДанныеПолей);

КонецПроцедуры

// CMPT-03: переносит 4 новых поля секции «Совместимость» (CMPT-01) из DOM в
// Объект. Вынесено из ПрименитьДанныеКОбъекту отдельной процедурой -
// добавление этих полей туда же подряд подняло CognitiveComplexity
// ПрименитьДанныеКОбъекту с 12 до 16 (порог BSL LS - 15).
//
// Параметры:
//  ДанныеПолей - Структура - см. ПрименитьДанныеКОбъекту.
//
&НаСервере
Процедура ПрименитьДанныеСовместимостиКОбъекту(Знач ДанныеПолей)

	Значение = Неопределено;

	Если ДанныеПолей.Свойство("min_cfg_version", Значение) Тогда
		Объект.ar_МинВерсияКонфигурации = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("max_cfg_version", Значение) Тогда
		Объект.ar_МаксВерсияКонфигурации = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("min_ar_version", Значение) Тогда
		Объект.ar_МинВерсияAgentRunner = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("subsystems", Значение) Тогда
		Объект.ar_ТребуемыеПодсистемы = СокрЛП(Значение);
	КонецЕсли;

КонецПроцедуры

// Применяет данные DOM и записывает объект с проверкой заполнения.
//
// Возвращаемое значение:
//  Структура - { Успех - Булево, Статус - Строка }.
//
&НаСервере
Функция ЗаписатьToolНаСервере(Знач ДанныеПолей)

	ПрименитьДанныеКОбъекту(ДанныеПолей);

	Результат = Новый Структура("Успех, Статус", Ложь, "");

	ОбъектЗаписи = РеквизитФормыВЗначение("Объект");

	// ar_ПоддерживаемыеКонфигурации - Строка(200). Платформа обрезала бы лишнее
	// молча, а усечённый JSON-массив перестаёт быть валидным JSON: пересчёт
	// доступности трактует это как invalid-конфигурацию и гасит tool. Поэтому
	// явный отказ до записи вместо тихой потери хвоста.
	ДлинаПоляКонфигураций = 200;
	ФактическаяДлинаКонфигураций = СтрДлина(Объект.ar_ПоддерживаемыеКонфигурации);
	Если ФактическаяДлинаКонфигураций > ДлинаПоляКонфигураций Тогда
		Результат.Статус = СтрШаблон(
			НСтр("ru='Поддерживаемые конфигурации: превышена длина поля (%1 из %2 символов)';
				|en='Supported configurations: field length exceeded (%1 of %2 characters)'"),
			ФактическаяДлинаКонфигураций,
			ДлинаПоляКонфигураций);
		ПерерисоватьКарточку(Результат.Статус, Истина);
		Возврат Результат;
	КонецЕсли;

	// Ручная запись мимо штатной команды формы: проверку заполнения
	// (ОбработкаПроверкиЗаполнения объекта) вызываем явно.
	Если Не ОбъектЗаписи.ПроверитьЗаполнение() Тогда
		Результат.Статус = ТекстСообщенийПользователю();
		Если ПустаяСтрока(Результат.Статус) Тогда
			Результат.Статус = НСтр("ru='Не заполнены обязательные поля'; en='Required fields are not filled'");
		КонецЕсли;
		ПерерисоватьКарточку(Результат.Статус, Истина);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ОбъектЗаписи.Записать();
	Исключение
		ar_СлужебныйЛог.Записать("ar_Tools.ФормаЭлемента", "write_error",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Результат.Статус = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПерерисоватьКарточку(Результат.Статус, Истина);
		Возврат Результат;
	КонецПопытки;

	ЗначениеВРеквизитФормы(ОбъектЗаписи, "Объект");
	Модифицированность = Ложь;

	Результат.Успех = Истина;
	Результат.Статус = НСтр("ru='Записано ✓'; en='Saved ✓'");
	ПерерисоватьКарточку(Результат.Статус);

	Возврат Результат;

КонецФункции

// Применяет данные DOM, меняет режим реализации и перерисовывает карточку.
//
&НаСервере
Процедура ПереключитьРежимНаСервере(Знач ДанныеПолей, Знач РежимРеализации)

	ПрименитьДанныеКОбъекту(ДанныеПолей);
	Объект.ar_ТипРеализации = РежимРеализации;
	Модифицированность = Истина;
	ПерерисоватьКарточку();

КонецПроцедуры

// Применяет данные DOM, инвертирует булев флаг и перерисовывает карточку.
//
&НаСервере
Процедура ПереключитьФлагНаСервере(Знач ДанныеПолей, Знач КлючФлага)

	ПрименитьДанныеКОбъекту(ДанныеПолей);
	Если КлючФлага = "enabled" Тогда
		Объект.ar_Включён = Не Объект.ar_Включён;
	ИначеЕсли КлючФлага = "approval" Тогда
		Объект.ar_ТребуетApproval = Не Объект.ar_ТребуетApproval;
	ИначеЕсли КлючФлага = "adapter" Тогда
		Объект.ar_ТребуетАдаптер = Не Объект.ar_ТребуетАдаптер;
	ИначеЕсли КлючФлага = "measure" Тогда
		// PERF-01: переключатель read-only в HTML, если подсистемы БСП нет
		// (см. HTMLСекцияОсновное) - тем не менее защита от Ссылка,
		// сформированной вручную/устаревшей вкладкой, дублируется и здесь.
		Если ar_ToolDispatcherПовтИсп.ПодсистемаОценкаПроизводительностиЕсть() Тогда
			Объект.ar_ЗамерПроизводительности = Не Объект.ar_ЗамерПроизводительности;
		КонецЕсли;
	КонецЕсли;
	Модифицированность = Истина;
	ПерерисоватьКарточку();

КонецПроцедуры

// Собирает накопленные сообщения пользователю (проверка заполнения) в одну строку.
//
&НаСервере
Функция ТекстСообщенийПользователю()

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Тексты = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

#КонецОбласти

#Область ПерерисовкаКарточки

// Собирает HTML карточки tool и кладёт его в реквизит СтрокаHTMLTool.
//
// Параметры:
//  СтатусДействия - Строка - статус последнего действия для шапки («Записано ✓»).
//  ЭтоОшибка      - Булево - статус отображается как ошибка (красным).
//
&НаСервере
Процедура ПерерисоватьКарточку(Знач СтатусДействия = "", Знач ЭтоОшибка = Ложь)

	Содержимое = HTMLСекцияШапки(СтатусДействия, ЭтоОшибка)
		+ HTMLБаннерДоступности()
		+ HTMLСекцияПакет()
		+ HTMLСекцияОсновное()
		+ HTMLСекцияСовместимость()
		+ HTMLСекцияМанифест()
		+ HTMLСекцияРеализация()
		+ HTMLСекцияКнопки();

	СтрокаHTMLTool = HTMLКаркасКарточки(Содержимое);

КонецПроцедуры

#КонецОбласти

#Область СборкаHTML

// Секция-шапка: заголовок карточки + статус последнего действия.
//
&НаСервере
Функция HTMLСекцияШапки(Знач СтатусДействия, Знач ЭтоОшибка)

	СтатусHTML = "";
	Если Не ПустаяСтрока(СтатусДействия) Тогда
		КлассСтатуса = ?(ЭтоОшибка, "ar-status ar-status-error", "ar-status");
		СтатусHTML = "<span class=""" + КлассСтатуса + """>"
			+ ar_ЭкранироватьHTML(СтатусДействия) + "</span>";
	КонецЕсли;

	ТекстЗаголовка = ?(ЗначениеЗаполнено(Объект.Ссылка),
		НСтр("ru='Инструмент агента'; en='Agent tool'"),
		НСтр("ru='Инструмент агента (создание)'; en='Agent tool (new)'"));

	Возврат
		"<div class=""ar-head"">"
		+ "<h1>" + ar_ЭкранироватьHTML(ТекстЗаголовка) + "</h1>"
		+ СтатусHTML
		+ "</div>";

КонецФункции

// Секция «Пакет» (PKG-06 D8): namespace, объект-обработка и версия пакета,
// от которого унаследован tool. Поля только для чтения - управляются
// регистрацией пакета (ar_ToolПакеты), а не карточкой конкретного tool.
// Видна только при ar_ИсточникТип = "Пакет" (для ядровых/кодовых tools пусто).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент секции, либо "" если tool не из пакета.
//
&НаСервере
Функция HTMLСекцияПакет()

	Если Объект.ar_ИсточникТип <> "Пакет" Тогда
		Возврат "";
	КонецЕсли;

	СведенияОПакете = СведенияОПакетеПоИдентификатору(Объект.ar_ИдентификаторПакета);

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Пакет'; en='Package'")) + "</h2>"
		+ "<div class=""ar-note"">"
		+ ar_ЭкранироватьHTML(НСтр(
			"ru='Tool унаследован от установленного пакета. Поля ниже управляются регистрацией
				|пакета (форма «Пакеты инструментов») и здесь не редактируются.';
			|en='This tool comes from an installed package. The fields below are managed by
				|package registration (the ""Tool packages"" form) and are not editable here.'"))
		+ "</div>"
		+ HTMLСтрокаПоля(
			НСтр("ru='Namespace'; en='Namespace'"),
			НСтр("ru='Префикс имени tool, общий для всех инструментов пакета.'; en='Tool name prefix shared by all tools of the package.'"),
			"<span class=""ar-refval"">" + ar_ЭкранироватьHTML(Объект.ar_Namespace) + "</span>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Обработка (внешняя)'; en='External data processor'"),
			НСтр("ru='Имя объекта дополнительной обработки, из которой зарегистрирован пакет.'; en='Name of the additional data processor object the package was registered from.'"),
			"<span class=""ar-refval"">" + ar_ЭкранироватьHTML(СведенияОПакете.ИмяОбъекта) + "</span>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Версия пакета'; en='Package version'"),
			НСтр("ru='Версия пакета в целом (отличается от версии этого tool выше).'; en='Version of the package as a whole (differs from this tool''s version above).'"),
			"<span class=""ar-refval"">" + ar_ЭкранироватьHTML(СведенияОПакете.ВерсияПакета) + "</span>")
		+ "</div>";

КонецФункции

// Читает версию пакета и имя объекта обработки из РегистрСведений.ar_ПакетыTools
// по идентификатору (dimension ar_ИдентификаторОбработки) - те же данные, что
// показывает форма ar_ПакетыTools (PKG-06). Не расширяет контракт ar_ToolПакеты -
// прямое чтение регистра, как это уже делает форма ar_ПакетыTools списком.
//
// Параметры:
//  ИдентификаторОбработки - Строка - значение реквизита Объект.ar_ИдентификаторПакета
//                           (тот же формат UUID, что dimension регистра).
//
// Возвращаемое значение:
//  Структура:
//   * ИмяОбъекта   - Строка - ar_ИмяОбъектаОбработки записи регистра, "" если не найдено.
//   * ВерсияПакета - Строка - ar_ВерсияПакета записи регистра, "" если не найдено.
//
&НаСервереБезКонтекста
Функция СведенияОПакетеПоИдентификатору(Знач ИдентификаторОбработки)

	Результат = Новый Структура("ИмяОбъекта, ВерсияПакета", "", "");

	Если ПустаяСтрока(ИдентификаторОбработки) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИдентификаторОбработки", ИдентификаторОбработки);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Пакеты.ar_ИмяОбъектаОбработки КАК ИмяОбъекта,
			|	Пакеты.ar_ВерсияПакета КАК ВерсияПакета
			|ИЗ
			|	РегистрСведений.ar_ПакетыTools КАК Пакеты
			|ГДЕ
			|	Пакеты.ar_ИдентификаторОбработки = &ИдентификаторОбработки";

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.ИмяОбъекта = Выборка.ИмяОбъекта;
			Результат.ВерсияПакета = Выборка.ВерсияПакета;
		КонецЕсли;
	Исключение
		// Карточка tool не должна падать из-за диагностической секции -
		// в худшем случае поля "Пакет" останутся пустыми.
		ar_СлужебныйЛог.Записать("ar_Tools.ФормаЭлемента", "package_info_read_error",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Секция «Основное»: имя tool, наименование, описание, риск, флаги, версия, источник.
//
&НаСервере
Функция HTMLСекцияОсновное()

	СостояниеВкл = ?(Объект.ar_Включён = Истина, "on", "off");
	МеткаВкл = ?(Объект.ar_Включён = Истина,
		НСтр("ru='Вкл'; en='On'"), НСтр("ru='Выкл'; en='Off'"));

	СостояниеApproval = ?(Объект.ar_ТребуетApproval = Истина, "on", "off");
	МеткаApproval = ?(Объект.ar_ТребуетApproval = Истина,
		НСтр("ru='Да'; en='Yes'"), НСтр("ru='Нет'; en='No'"));

	// PERF-01: подсистема БСП «Оценка производительности» может отсутствовать
	// в целевой конфигурации (graceful degradation) - тогда флаг read-only с
	// пояснением причины вместо переключателя.
	ПодсистемаЗамераЕсть = ar_ToolDispatcherПовтИсп.ПодсистемаОценкаПроизводительностиЕсть();
	МеткаЗамер = ?(Объект.ar_ЗамерПроизводительности = Истина,
		НСтр("ru='Вкл'; en='On'"), НСтр("ru='Выкл'; en='Off'"));
	Если ПодсистемаЗамераЕсть Тогда
		СостояниеЗамера = ?(Объект.ar_ЗамерПроизводительности = Истина, "on", "off");
		РедакторЗамера = СсылкаДействие("toggle", "key=measure", МеткаЗамер, "ar-toggle ar-toggle-" + СостояниеЗамера);
	Иначе
		РедакторЗамера = "<span class=""ar-refval"">"
			+ ar_ЭкранироватьHTML(НСтр(
				"ru='Недоступно: в конфигурации нет подсистемы БСП «Оценка производительности»';
				|en='Unavailable: the BSP subsystem ""Performance Measurement"" is not in the configuration'"))
			+ "</span>";
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Основное'; en='General'")) + "</h2>"
		+ HTMLСтрокаПоля(
			НСтр("ru='Имя (tool id)'; en='Name (tool id)'"),
			НСтр("ru='Идентификатор tool в snake_case (например search_clients). Уникален.'; en='Tool id in snake_case (e.g. search_clients). Unique.'"),
			"<input id=""fld_toolname"" class=""ar-input ar-input-wide"" type=""text"" value="""
				+ ar_ЭкранироватьHTML(Объект.ar_Имя) + """>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Наименование'; en='Description'"),
			НСтр("ru='Пусто — заполнится автоматически из имени tool.'; en='Empty — generated from the tool name automatically.'"),
			"<input id=""fld_name"" class=""ar-input ar-input-wide"" type=""text"" value="""
				+ ar_ЭкранироватьHTML(Объект.Наименование) + """>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Описание'; en='Description text'"),
			НСтр("ru='Краткое описание tool для списка и UI.'; en='Short tool description for lists and UI.'"),
			"<textarea id=""fld_description"" class=""ar-textarea ar-textarea-mid"" rows=""3"">"
				+ ar_ЭкранироватьHTML(Объект.ar_Описание) + "</textarea>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Уровень риска'; en='Risk level'"),
			НСтр("ru='Read / Draft / Write / Commit — влияет на политику разрешений.'; en='Read / Draft / Write / Commit — drives the permission policy.'"),
			HTMLВыборRiskLevel())
		+ HTMLСтрокаПоля(
			НСтр("ru='Требует подтверждения'; en='Requires approval'"),
			НСтр("ru='Вызов ставится в очередь подтверждений вместо немедленного выполнения.'; en='Calls are queued for approval instead of immediate execution.'"),
			СсылкаДействие("toggle", "key=approval", МеткаApproval, "ar-toggle ar-toggle-" + СостояниеApproval))
		+ HTMLСтрокаПоля(
			НСтр("ru='Включён'; en='Enabled'"),
			НСтр("ru='Ручной выключатель: выключенный tool не передаётся LLM. Отдельно от него действует расчётная доступность (см. «Совместимость»).'; en='Manual switch: a disabled tool is not sent to the LLM. Computed availability applies independently (see ""Compatibility"").'"),
			СсылкаДействие("toggle", "key=enabled", МеткаВкл, "ar-toggle ar-toggle-" + СостояниеВкл))
		+ HTMLСтрокаПоля(
			НСтр("ru='Замер производительности'; en='Performance measurement'"),
			НСтр("ru='Включить замер БСП («Оценка производительности», ключевая операция ar_Tool_<имя>) для этого инструмента. Запись реально идёт только если ВКЛЮЧЕНА ещё и глобальная константа ar_ЗамерятьВсеTools ИЛИ этот флаг, и одновременно включён общий переключатель БСП «Выполнять замеры производительности» (Администрирование).'; en='Enable BSP measurement (""Performance Measurement"", key operation ar_Tool_<name>) for this tool. Recording only actually happens if EITHER the global constant ar_ЗамерятьВсеTools or this flag is on, and the BSP-wide toggle ""Perform performance measurements"" (Administration) is enabled too.'"),
			РедакторЗамера)
		+ HTMLСтрокаПоля(
			НСтр("ru='Версия'; en='Version'"),
			НСтр("ru='SemVer реализации tool (например 1.0.0).'; en='SemVer of the tool implementation (e.g. 1.0.0).'"),
			"<input id=""fld_version"" class=""ar-input"" type=""text"" value="""
				+ ar_ЭкранироватьHTML(Объект.ar_Версия) + """>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Источник (расширение)'; en='Source extension'"),
			НСтр("ru='Пусто = ядро AgentRunner; имя Expert Pack для плагинов.'; en='Empty = AgentRunner core; Expert Pack name for plugins.'"),
			"<input id=""fld_source"" class=""ar-input ar-input-wide"" type=""text"" value="""
				+ ar_ЭкранироватьHTML(Объект.ar_ИсточникРасширение) + """>")
		+ "</div>";

КонецФункции

// Баннер доступности (UNIV-03): read-only плашка над карточкой, когда tool
// физически не может отработать в текущей конфигурации.
//
// ar_Доступен / ar_ПричинаНедоступности - вычисляемый кэш, его пересчитывает
// ar_ToolDispatcher.ПересчитатьДоступностьВсехTools() (регистрация tools и
// обработчик обновления версии расширения). Вручную из карточки они не
// правятся - поэтому баннер, а не поля ввода. Без него пользователь видит
// «Включён: Вкл» и не понимает, почему LLM не вызывает tool: фильтр выдачи
// (ar_RuntimeКонтекст.СобратьВидимыеTools) отсекает записи по обоим признакам.
//
// Для нового (ещё не записанного) объекта баннер не показываем: доступность
// не рассчитана, ar_Доступен = Ложь по умолчанию дало бы ложную тревогу.
//
// CMPT-03: текст причины - через ar_ToolDispatcher.ПредставлениеПричиныНедоступности
// (единственное место расшифровки, см. .docs/specs/CMPT-03.md, раздел B) вместо
// сырого кода ar_ПричинаНедоступности. Второй параметр -
// Объект.ar_ПоддерживаемыеКонфигурации - обязателен для полного текста
// unsupported_configuration («рассчитан на БП, текущая - УТ»).
//
&НаСервере
Функция HTMLБаннерДоступности()

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Объект.ar_Доступен = Истина Тогда
		Возврат "";
	КонецЕсли;

	Причина = ar_ToolDispatcher.ПредставлениеПричиныНедоступности(
		Объект.ar_ПричинаНедоступности, Объект.ar_ПоддерживаемыеКонфигурации);

	ТекстБаннера = НСтр(
		"ru='Tool недоступен в текущей конфигурации и не передаётся LLM.';
		|en='The tool is unavailable in the current configuration and is not sent to the LLM.'");

	Если Не ПустаяСтрока(Причина) Тогда
		ТекстБаннера = ТекстБаннера + " "
			+ НСтр("ru='Причина:'; en='Reason:'") + " " + Причина;
	КонецЕсли;

	Возврат
		"<div class=""ar-banner"">"
		+ ar_ЭкранироватьHTML(ТекстБаннера)
		+ "<div class=""ar-banner-hint"">"
		+ ar_ЭкранироватьHTML(НСтр(
			"ru='Доступность пересчитывается при регистрации tools и при обновлении расширения — вручную не редактируется. Проверьте требуемые объекты и поддерживаемые конфигурации ниже.';
			|en='Availability is recalculated on tool registration and extension update — it is not editable manually. Check the required objects and supported configurations below.'"))
		+ "</div>"
		+ "</div>";

КонецФункции

// Секция «Совместимость» (UNIV-02 / UNIV-04 / UNIV-06 / CMPT-01): входные
// данные расчёта доступности - требуемые объекты метаданных, список
// поддерживаемых конфигураций, признак необходимости адаптера заполнения,
// диапазон версий конфигурации/AgentRunner и требуемые подсистемы БСП.
//
// Поля редактируемые для ядровых/кодовых tools: без них нельзя объявить
// требования своего tool из карточки (сценарий .docs/Tutorial-свой-tool.md),
// а у ядровых tools их проставляет регистрация. Пустая строка и "[]"
// равнозначны и означают «универсальный tool» - см.
// ar_ToolDispatcher.РезультатПроверкиДоступности.
//
// CMPT-03: для tools с ar_ИсточникТип = "Пакет" ВСЕ 7 полей секции -
// только чтение (<span class="ar-refval">, тот же паттерн, что уже
// использует HTMLСекцияПакет) - поля унаследованы из манифеста пакета
// (CMPT-02), правка их в карточке разошлась бы с пакетом при первом
// переподтверждении. См. .docs/specs/CMPT-03.md, раздел E.
//
&НаСервере
Функция HTMLСекцияСовместимость()

	ЭтоПакет = (Объект.ar_ИсточникТип = "Пакет");

	СостояниеАдаптера = ?(Объект.ar_ТребуетАдаптер = Истина, "on", "off");
	МеткаАдаптера = ?(Объект.ar_ТребуетАдаптер = Истина,
		НСтр("ru='Да'; en='Yes'"), НСтр("ru='Нет'; en='No'"));

	Если ЭтоПакет Тогда
		РедакторАдаптера = "<span class=""ar-refval"">" + ar_ЭкранироватьHTML(МеткаАдаптера) + "</span>";
	Иначе
		РедакторАдаптера = СсылкаДействие("toggle", "key=adapter", МеткаАдаптера, "ar-toggle ar-toggle-" + СостояниеАдаптера);
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Совместимость'; en='Compatibility'")) + "</h2>"
		+ "<div class=""ar-note"">"
		+ ar_ЭкранироватьHTML(НСтр(
			"ru='Определяет, доступен ли tool в текущей конфигурации. Изменения вступают в силу после пересчёта доступности (перерегистрация tools или обновление расширения).';
			|en='Defines whether the tool is available in the current configuration. Changes take effect after availability is recalculated (tool re-registration or extension update).'"))
		+ "</div>"
		+ HTMLСтрокаПоля(
			НСтр("ru='Требуемые объекты'; en='Required objects'"),
			НСтр("ru='JSON-массив логических имён объектов, например [""ЗаказКлиента""]. Пусто или [] — tool не привязан к объектам.'; en='JSON array of logical object names, e.g. [""ЗаказКлиента""]. Empty or [] — the tool is not bound to any objects.'"),
			HTMLРедакторTextarea(ЭтоПакет, "fld_required", 3, Объект.ar_ТребуемыеОбъекты))
		+ HTMLСтрокаПоля(
			НСтр("ru='Поддерживаемые конфигурации'; en='Supported configurations'"),
			НСтр("ru='JSON-массив типов конфигураций, например [""БП"",""УТ""]. Пусто или [] — любая конфигурация.'; en='JSON array of configuration types, e.g. [""БП"",""УТ""]. Empty or [] — any configuration.'"),
			HTMLРедакторTextarea(ЭтоПакет, "fld_configs", 2, Объект.ar_ПоддерживаемыеКонфигурации))
		+ HTMLСтрокаПоля(
			НСтр("ru='Требует адаптер'; en='Requires adapter'"),
			НСтр("ru='Tool пишет данные через адаптер заполнения. Без адаптера для текущей конфигурации tool недоступен.'; en='The tool writes data through a fill adapter. Without an adapter for the current configuration the tool is unavailable.'"),
			РедакторАдаптера)
		+ HTMLСтрокаПоля(
			НСтр("ru='Мин. версия конфигурации'; en='Min configuration version'"),
			НСтр("ru='Минимальная версия целевой конфигурации в 4-разрядном формате (например 3.0.180.0). Пусто — без ограничения.'; en='Minimum target configuration version, 4-part format (e.g. 3.0.180.0). Empty — no limit.'"),
			HTMLРедакторInput(ЭтоПакет, "fld_min_cfg_version", Объект.ar_МинВерсияКонфигурации))
		+ HTMLСтрокаПоля(
			НСтр("ru='Макс. версия конфигурации'; en='Max configuration version'"),
			НСтр("ru='Максимальная версия конфигурации в 4-разрядном формате (например 3.0.201.0). Пусто — без ограничения.'; en='Maximum configuration version, 4-part format (e.g. 3.0.201.0). Empty — no limit.'"),
			HTMLРедакторInput(ЭтоПакет, "fld_max_cfg_version", Объект.ar_МаксВерсияКонфигурации))
		+ HTMLСтрокаПоля(
			НСтр("ru='Мин. версия AgentRunner'; en='Min AgentRunner version'"),
			НСтр("ru='Минимальная версия расширения AgentRunner в 4-разрядном формате (например 0.1.0.230). Пусто — без ограничения.'; en='Minimum AgentRunner extension version, 4-part format (e.g. 0.1.0.230). Empty — no limit.'"),
			HTMLРедакторInput(ЭтоПакет, "fld_min_ar_version", Объект.ar_МинВерсияAgentRunner))
		+ HTMLСтрокаПоля(
			НСтр("ru='Требуемые подсистемы'; en='Required subsystems'"),
