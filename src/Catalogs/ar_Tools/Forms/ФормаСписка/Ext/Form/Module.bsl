////////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Tools (UI-15), реестр инструментов агентов.
//
// Динамический список по Catalog.ar_Tools (стандартные колонки реестра) +
// команда "Просмотр манифеста": читает ar_JSONManifest выбранной строки,
// форматирует через ar_JSON.КрасивыйФорматJSON и показывает read-only
// (ПоказатьЗначение). Граничные случаи: пустой манифест, невалидный JSON,
// удалённая запись, отсутствие выбранной строки (Plan §2.9, UI-15).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ветка автотеста: при программном открытии формы тестами пропускаем
	// инициализацию (единый паттерн форм расширения).
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Управляет доступностью команды "Просмотр манифеста" (D4): неактивна, если
// строка списка не выбрана.
//
// Параметры:
//   Элемент - ПолеТабличногоДокумента, ТаблицаФормы - элемент формы "Список",
//             вызвавший событие ПриАктивизацииСтроки.
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	Элементы.КнопкаПросмотрМанифеста.Доступность = (Элемент.ТекущиеДанные <> Неопределено);

КонецПроцедуры

// CMPT-03 (итерация 3): подменяет отображаемое значение колонки "Причина
// недоступности" (ar_ПричинаНедоступности) - с машинного кода на
// человекочитаемый текст ar_ToolDispatcher.ПредставлениеПричиныНедоступности
// (та же функция, что использует HTMLБаннерДоступности карточки - единый
// источник текста, требование раздела B спеки).
//
// Диагноз итераций 1-2 (live-проверка в buh3-web, зафиксирован в
// .docs/specs/CMPT-03.md): ar_ТекстКонфигурации был вычисляемым полем без
// физического столбца ни в справочнике, ни (после ManualQuery=true) без
// устойчивого текста запроса - в обоих случаях сервер ibsrv падал жёстко
// при открытии формы списка. Итерация 3 полностью отказывается от
// вычисляемого поля и от ManualQuery: Список вернулся к автозапросу
// (ManualQuery=false), диапазон версий показывается двумя РЕАЛЬНЫМИ
// реквизитами справочника (ar_МинВерсияКонфигурации,
// ar_МаксВерсияКонфигурации - см. Form.xml), а расшифровка причины
// перезаписывает значение РЕАЛЬНОГО реквизита ar_ПричинаНедоступности прямо
// в структуре Данные строки - образец приёма подтверждён фактом в БСП
// [Реф: БСП/Catalogs/ГруппыДоступа/Forms/ФормаСписка/Ext/Form/Module.bsl:193-212],
// где ПриПолученииДанныхНаСервере точно так же перезаписывает Данные.Наименование
// (обычный реквизит) человекочитаемым представлением. Перезапись работает
// только над представлением строки в клиентской форме и не приводит к
// записи в базу данных - "Строки" здесь являются копией данных для
// отображения, а не объектом СУБД.
//
// Сигнатура (ИмяЭлемента, Настройки, Строки) и &НаСервереБезКонтекста -
// подтверждены тем же образцом БСП; "Строки" - ДанныеФормыКоллекция с
// ключами-ссылками (Строки.Значение.Данные для доступа к полям строки).
//
// Параметры:
//   ИмяЭлемента - Строка - имя элемента таблицы формы ("Список").
//   Настройки   - ДинамическийСписокРасширениеПолученияДанных - настройки
//                 получения данных списка, не используется.
//   Строки      - ДанныеФормыКоллекция - строки, полученные динамическим
//                 списком (вызывается, только если получена хотя бы одна
//                 строка).
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	Для Каждого СтрокаСписка Из Строки Цикл
		Данные = СтрокаСписка.Значение.Данные;
		Попытка
			Данные.ar_ПричинаНедоступности = ar_ToolDispatcher.ПредставлениеПричиныНедоступности(
				Данные.ar_ПричинаНедоступности,
				Данные.ar_ПоддерживаемыеКонфигурации);
		Исключение
			// Диагностика не глушится (память feedback_reviewer_ai_findings) -
			// причина сбоя расшифровки одной строки уходит в служебный лог,
			// сама строка остаётся с исходным кодом причины вместо падения
			// всего списка.
			ar_СлужебныйЛог.Записать(
				"ar_Tools.ФормаСписка.СписокПриПолученииДанныхНаСервере",
				"list_row_render_error",
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
				"Предупреждение");
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовКоманднойПанели

// CMPT-03: переключатель "Только недоступные" - показывает лишь tools с
// ar_Доступен = Ложь.
//
// Параметры:
//   Элемент - ПолеФлажка - элемент формы "ПоказыватьТолькоНедоступные".
&НаКлиенте
Процедура ПоказыватьТолькоНедоступныеПриИзменении(Элемент)

	УстановитьОтборТолькоНедоступные();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Команда "Просмотр манифеста" (D3-D5, use-case 2): показывает
// ar_JSONManifest выбранного tool в read-only виде, отформатированным через
// ar_JSON.КрасивыйФорматJSON.
//
// Параметры:
//   Команда - КомандаФормы - команда формы "ar_ПросмотрМанифеста"
//             (параметр стандартного обработчика, не используется).
&НаКлиенте
Процедура ar_ПросмотрМанифеста(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Выберите tool'; en = 'Select a tool'"));
		Возврат;
	КонецЕсли;

	// Ссылка берётся через ТекущаяСтрока (ключ строки динамического списка), а не
	// ТекущиеДанные.Ссылка - при автозапросе (ManualQuery=false) без явного
	// объявления полей списка поле "Ссылка" может отсутствовать в ТекущиеДанные
	// ("Object field not found"). ТекущаяСтрока для списка справочника - это и
	// есть СправочникСсылка.
	Результат = ПолучитьМанифестНаСервере(Элементы.Список.ТекущаяСтрока, ТекущиеДанные.Description);

	Если НЕ Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
		Возврат;
	КонецЕсли;

	Если Результат.Предупреждение Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;

	ПоказатьЗначение(, Результат.Текст);

КонецПроцедуры

// Команда "Обновить манифесты": вызывает регистрацию всех ядровых tools
// (ar_ToolDispatcher.ЗарегистрироватьВсеTools) - upsert по имени, актуализирует
// ar_JSONManifest/ar_Описание существующих записей до текущего контракта и
// создаёт недостающие. Без проверки прав - доступна любому пользователю формы.
//
// Параметры:
//   Команда - КомандаФормы - команда формы "ar_ОбновитьМанифесты"
//             (параметр стандартного обработчика, не используется).
&НаКлиенте
Процедура ar_ОбновитьМанифесты(Команда)

	Результат = ОбновитьМанифестыНаСервере();

	ПоказатьОповещениеПользователя(СтрШаблон(
		НСтр("ru = 'Реестр tools обновлён: создано %1, обновлено %2';
			|en = 'Tools registry updated: created %1, updated %2'"),
		Результат.Создано, Результат.Обновлено));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// CMPT-03: применяет/снимает отбор по ar_Доступен = Ложь.
//
// Итерации 1-4 (диагностика в живой БП, бинарный поиск по правкам):
// самодельная работа с Список.Отбор.Элементы дала три дефекта подряд -
// Очистить() сносил служебные элементы отбора платформы (сервер ibsrv падал
// жёстко при открытии формы), конструкция "Для Индекс = N По -1 Цикл" не
// является циклом с шагом -1 и на пустой коллекции давала
// "Index value exceeds range limits", а тип "ДинамическийСписокОтборПоПолю"
// в платформе вовсе не определён. Тот же нерабочий код лежит в
// ar_Рутины.ПрименитьОтборПоАгентуНаСервере, где просто не исполнялся.
//
// Итог: используем штатный метод БСП, который сам управляет составом отбора
// [Реф: БСП/CommonModules/ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка].
// Использование = Ложь снимает отбор, не удаляя элемент вручную.
&НаСервере
Процедура УстановитьОтборТолькоНедоступные()

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"ar_Доступен",
		Ложь,
		ВидСравненияКомпоновкиДанных.Равно,
		,
		ПоказыватьТолькоНедоступные);

КонецПроцедуры

// Читает ar_JSONManifest элемента Ссылка и готовит текст для read-only показа.
//
// Параметры:
//   Ссылка - СправочникСсылка.ar_Tools - выбранный в списке элемент.
//   Имя    - Строка - представление tool (Description/ar_Имя текущей строки
//            списка) для заголовка диалога. Передаётся с клиента, чтобы не
//            делать лишний запрос за полем, уже доступным в ТекущиеДанные.
//
// Возвращаемое значение:
//   Структура:
//     * Успех         - Булево - Ложь, если запись больше не существует
//                        (показывается ошибка вместо диалога).
//     * Предупреждение - Булево - Истина, если манифест невалиден как JSON
//                        (показан исходный текст вместо отформатированного).
//     * Сообщение     - Строка - текст для ПоказатьПредупреждение (пусто при
//                        Успех = Истина и Предупреждение = Ложь).
//     * Текст         - Строка - текст для read-only показа.
//     * Заголовок     - Строка - заголовок диалога ПоказатьЗначение.
&НаСервере
Функция ПолучитьМанифестНаСервере(Знач Ссылка, Знач Имя)

	// Имя переменной не совпадает со свойством формы "Заголовок": присваивание
	// в него молча меняет заголовок окна списка на "JSON-манифест: ..." вместо
	// создания локальной переменной (см. память reference_form_property_name_collision
	// - в PKG-06 этот класс ошибки ловился дважды).
	ЗаголовокДиалога = СтрШаблон(НСтр("ru = 'JSON-манифест: %1'; en = 'JSON manifest: %1'"), Имя);

	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Предупреждение", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Текст", "");
	Результат.Вставить("Заголовок", ЗаголовокДиалога);

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ar_Tools.ar_JSONManifest КАК ar_JSONManifest
			|ИЗ
			|	Справочник.ar_Tools КАК ar_Tools
			|ГДЕ
			|	ar_Tools.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);

		Выборка = Запрос.Выполнить().Выбрать();

		Если НЕ Выборка.Следующий() Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = НСтр(
				"ru = 'Запись больше не существует, обновите список';
				|en = 'The record no longer exists, refresh the list'");
			Возврат Результат;
		КонецЕсли;

		Манифест = Выборка.ar_JSONManifest;

		Если ПустаяСтрока(Манифест) Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = НСтр(
				"ru = 'Манифест не заполнен'; en = 'Manifest is not filled in'");
			Возврат Результат;
		КонецЕсли;

		ЗначениеJSON = ar_JSON.ИзJSON(Манифест);
		Если ЗначениеJSON = Неопределено Тогда
			// Невалидный JSON (D5): показываем исходную строку как есть с
			// предупреждением, без необработанного исключения.
			Результат.Предупреждение = Истина;
			Результат.Сообщение = НСтр(
				"ru = 'JSON невалиден, показан исходный текст';
				|en = 'JSON is invalid, showing the raw text'");
			Результат.Текст = Манифест;
			Возврат Результат;
		КонецЕсли;

		Результат.Текст = ar_JSON.КрасивыйФорматJSON(ЗначениеJSON);
		Если ПустаяСтрока(Результат.Текст) Тогда
			// КрасивыйФорматJSON не выбрасывает исключений, но при внутренней
			// ошибке форматирования возвращает "", деградируем на исходный текст.
			Результат.Предупреждение = Истина;
			Результат.Сообщение = НСтр(
				"ru = 'JSON невалиден, показан исходный текст';
				|en = 'JSON is invalid, showing the raw text'");
			Результат.Текст = Манифест;
		КонецЕсли;

		Возврат Результат;
	Исключение
		// Сюда попадают только технические ошибки выполнения запроса (нет прав,
		// сбой СУБД, таймаут и т. п.) - случай "записи больше нет" уже обработан
		// отдельной веткой выше (Выборка.Следующий()) и не приводит к исключению.
		ЗаписьЖурналаРегистрации(
			"ar_Tools.ФормаСписка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

		Результат.Успех = Ложь;
		Результат.Сообщение = НСтр(
			"ru = 'Не удалось получить манифест tool, подробности - в журнале регистрации';
			|en = 'Failed to retrieve the tool manifest, see the event log for details'");
		Возврат Результат;
	КонецПопытки;

КонецФункции

// Выполняет регистрацию всех ядровых tools на сервере (upsert по имени).
// Делегирует в ar_ToolDispatcher.ЗарегистрироватьВсеTools - единую точку
// синхронизации реестра ar_Tools с текущими манифестами tool-модулей.
//
// Возвращаемое значение:
//   Структура { Создано - Число, Обновлено - Число } - статистика регистрации.
&НаСервере
Функция ОбновитьМанифестыНаСервере()
	Возврат ar_ToolDispatcher.ЗарегистрироватьВсеTools();
КонецФункции

#КонецОбласти
