// Модуль объекта справочника ar_Tools.
//
// Зона ответственности (META-12):
//   - валидация формата реквизита ar_Имя (snake_case: строчные латинские буквы, цифры, подчёркивания);
//   - проверка уникальности ar_Имя на уровне приложения (запросом, исключая текущий элемент);
//   - заполнение Наименования = ar_Имя при пустом наименовании, чтобы карточка
//     отображалась осмысленно (DefaultPresentation = AsDescription);
//   - предупреждение (без блокировки) о невалидном JSON в ar_JSONManifest;
//   - режим реализации «Код» (ar_ТипРеализации): ar_ОбщийМодуль/ar_ИмяПроцедуры
//     не обязательны, вместо них требуется непустой ar_КодРеализации.
//
// Проверка уровня платформы (уникальный индекс) для произвольных реквизитов
// справочника недоступна в XML-метаданных - программная проверка ниже является
// обязательным уровнем защиты. См. DEV-NOTE в .docs/specs/META-12.md.

#Область ОбработчикиСобытий

// Платформенный обработчик проверки заполнения реквизитов.
// Вызывается перед записью элемента.
//
// Параметры:
//  Отказ                  - Булево          - флаг отказа от записи.
//  ПроверяемыеРеквизиты   - Массив из Строка - список реквизитов, проверяемых платформой.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// При обмене данными - пропускаем валидацию.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	МассивНепроверяемыхРеквизитов = Новый Массив;

	// Режим реализации «Код»: tool реализован произвольным кодом 1С
	// (ar_КодРеализации), общий модуль и процедура не нужны - исключаем их из
	// платформенной проверки обязательности, но требуем непустой код.
	Если СокрЛП(ar_ТипРеализации) = "Код" Тогда

		МассивНепроверяемыхРеквизитов.Добавить("ar_ОбщийМодуль");
		МассивНепроверяемыхРеквизитов.Добавить("ar_ИмяПроцедуры");

		Если ПустаяСтрока(ar_КодРеализации) Тогда
			ТекстСообщения = НСтр(
				"ru = 'Для tool в режиме «Код» необходимо заполнить код 1С (ar_КодРеализации)';
				|en = 'A tool in ""Code"" mode requires the 1C code (ar_КодРеализации) to be filled'");
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				Ссылка,
				"Объект.ar_КодРеализации",
				,
				Отказ);
		КонецЕсли;

	КонецЕсли;

	// Проверка формата ar_Имя - только если оно заполнено
	// (если пусто - стандартная проверка обязательности уже сработает).
	Если ЗначениеЗаполнено(ar_Имя) Тогда

		Если Не ar_ИмяКорректноеSnakeCase(ar_Имя) Тогда
			ТекстСообщения = НСтр(
				"ru = 'Имя tool должно быть в snake_case: только строчные латинские буквы, цифры и подчёркивания (получено: «%1»)';
				|en = 'Tool name must be snake_case: lowercase latin letters, digits and underscores only (got: ""%1"")'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ar_Имя);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				Ссылка,
				"Объект.ar_Имя",
				,
				Отказ);
		ИначеЕсли ar_ЕстьДубльИмени(ar_Имя, Ссылка) Тогда
			ТекстСообщения = НСтр(
				"ru = 'Tool с именем «%1» уже существует в справочнике';
				|en = 'A tool named ""%1"" already exists in the catalog'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ar_Имя);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				Ссылка,
				"Объект.ar_Имя",
				,
				Отказ);
		КонецЕсли;

	КонецЕсли;

	// Предупреждение о невалидном JSON-манифесте - не блокирует запись.
	Если ЗначениеЗаполнено(ar_JSONManifest) И Не ar_JSONВалиден(ar_JSONManifest) Тогда
		ТекстПредупреждения = НСтр(
			"ru = 'Внимание: JSONManifest не является валидным JSON. LLM не получит описание этого tool, пока манифест не будет исправлен.';
			|en = 'Warning: JSONManifest is not valid JSON. LLM will not see this tool description until the manifest is fixed.'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстПредупреждения,
			Ссылка,
			"Объект.ar_JSONManifest");
	КонецЕсли;

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(
		ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);

КонецПроцедуры

// Платформенный обработчик перед записью.
// Используется для авто-заполнения Наименования значением ar_Имя и (SEC-TOOL-01)
// для фиксации audit-события при изменении кода реализации tool в режиме «Код».
//
// Параметры:
//  Отказ - Булево - флаг отказа от записи.
//
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Если наименование пустое - синхронизируем с ar_Имя для удобства отображения.
	Если ПустаяСтрока(Наименование) И ЗначениеЗаполнено(ar_Имя) Тогда
		Наименование = ar_Имя;
	КонецЕсли;

	ar_ЗафиксироватьИзменениеКодаTool();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииSecTool01

// SEC-TOOL-01: зафиксировать audit-событие ToolCodeChanged при создании нового
// tool в режиме «Код» с непустым кодом или при изменении ar_КодРеализации
// существующего tool относительно версии, хранящейся в ИБ. Не пишет сам код в
// payload - только факт изменения и его SHA-256 хеш (утечка потенциально
// чувствительного кода в audit-лог недопустима).
//
// Знач в параметрах ПередЗаписью не даёт «старое» состояние объекта - читаем
// его отдельным запросом по Ссылка, если объект не новый.
//
Процедура ar_ЗафиксироватьИзменениеКодаTool()

	Если СокрЛП(ar_ТипРеализации) <> "Код" Тогда
		Возврат;
	КонецЕсли;

	СтароеЗначениеКода = "";
	Если Не ЭтотОбъект.ЭтоНовый() Тогда
		СтароеЗначениеКода = ar_СтароеЗначениеКодаРеализации(Ссылка);
	КонецЕсли;

	Если СтароеЗначениеКода = ar_КодРеализации Тогда
		// Код не менялся. Совпадение возможно на "" = "" только при создании
		// нового tool с пустым ar_КодРеализации - но платформа вызывает
		// ОбработкаПроверкиЗаполнения (и, соответственно, Отказ = Истина при
		// пустом коде, см. выше) СТРОГО ДО ПередЗаписью, поэтому этот
		// обработчик до записи с пустым кодом в режиме "Код" не доходит.
		Возврат;
	КонецЕсли;

	ТекущийПользователь = Пользователи.ТекущийПользователь();

	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("tool", ar_Имя);
	ДанныеСобытия.Вставить("actor", Строка(ТекущийПользователь));
	ДанныеСобытия.Вставить("code_hash", ar_ХешКодаSHA256(ar_КодРеализации));
	ДанныеСобытия.Вставить("has_code", Не ПустаяСтрока(ar_КодРеализации));

	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(
		"", Перечисления.ar_ТипСобытия.ToolCodeChanged, ДанныеСобытия);

	// Дублирующая запись в служебный лог для быстрой технической диагностики
	// (проект разделяет "audit для безопасности" и "служебный лог для
	// диагностики" - обе фиксации, не одна вместо другой). ar_СлужебныйЛог.
	// Записать сам по себе best-effort (не пробрасывает исключений), поэтому
	// дополнительная защита Попытка здесь не требуется.
	ar_СлужебныйЛог.Записать(
		"Catalogs.ar_Tools.ObjectModule",
		"tool_code_changed",
		ar_JSON.ВЗначениеJSON(ДанныеСобытия));

КонецПроцедуры

// Прочитать текущее (до применения изменений в этой транзакции) значение
// ar_КодРеализации по ссылке. Отдельный запрос вместо Знач в параметрах
// ПередЗаписью, который «старого» состояния объекта не даёт.
//
// Параметры:
//  СсылкаTool - СправочникСсылка.ar_Tools - ссылка на существующий элемент.
//
// Возвращаемое значение:
//  Строка - значение ar_КодРеализации в ИБ на момент вызова, "" если не найдено.
//
Функция ar_СтароеЗначениеКодаРеализации(Знач СсылкаTool)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_КодРеализации КАК КодРеализации
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаTool);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КодРеализации;
	КонецЕсли;

	Возврат "";

КонецФункции

// SEC-TOOL-01/UC-4: SHA-256 хеш кода реализации в hex, для audit-payload.
// Хеш фиксирует факт изменения байтов кода, не его содержание (diff/ревью
// человеком - вне рамок этой задачи, см. риски в .docs/specs/SEC-TOOL-01.md).
//
// Параметры:
//  Код - Строка - текст ar_КодРеализации.
//
// Возвращаемое значение:
//  Строка - SHA-256 хеш в hex без пробелов, "" для пустого кода.
//
Функция ar_ХешКодаSHA256(Знач Код)

	Если ПустаяСтрока(Код) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ОбщегоНазначения.КонтрольнаяСуммаСтрокой(Код, ХешФункция.SHA256);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что строка соответствует формату snake_case:
// только строчные латинские буквы (a-z), цифры (0-9) и подчёркивания (_).
// Пустая строка считается некорректной.
//
// Параметры:
//  Имя - Строка - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если формат корректный.
//
Функция ar_ИмяКорректноеSnakeCase(Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyz0123456789_";
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет наличие другого элемента справочника с таким же ar_Имя.
//
// Параметры:
//  ПроверяемоеИмя - Строка - имя для поиска дубля.
//  ТекущаяСсылка  - СправочникСсылка.ar_Tools - ссылка текущего элемента (исключается из поиска).
//
// Возвращаемое значение:
//  Булево - Истина, если дубль найден.
//
Функция ar_ЕстьДубльИмени(ПроверяемоеИмя, ТекущаяСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И Tools.Ссылка <> &ТекущаяСсылка";

	Запрос.УстановитьПараметр("Имя", ПроверяемоеИмя);
	Запрос.УстановитьПараметр("ТекущаяСсылка", ТекущаяСсылка);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Простая проверка: является ли строка валидным JSON.
// Использует платформенный ПрочитатьJSON. Возвращает Ложь при любом исключении.
//
// Параметры:
//  Текст - Строка - проверяемый JSON.
//
// Возвращаемое значение:
//  Булево - Истина, если строка парсится как JSON.
//
Функция ar_JSONВалиден(Текст)

	Результат = Ложь;
	ЧтениеJSON = Неопределено;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ПрочитатьJSON(ЧтениеJSON);
		Результат = Истина;
	Исключение
		Результат = Ложь;
	КонецПопытки;

	// При невалидном JSON (или ошибке конструктора/УстановитьСтроку выше) поток
	// мог остаться в неконсистентном состоянии - Закрыть() сам способен
	// выбросить исключение. Результат уже определён выше (Истина/Ложь по
	// исходу разбора JSON), вторичная ошибка закрытия потока на него не
	// влияет - гасим её отдельной попыткой, фиксируя факт в журнале
	// регистрации (единственное содержательное действие, доступное здесь).
	Если ЧтениеJSON <> Неопределено Тогда
		Попытка
			ЧтениеJSON.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'ar_Tools.ar_JSONВалиден'; en = 'ar_Tools.ar_JSONВалиден'"),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				НСтр("ru = 'Ошибка закрытия потока ЧтениеJSON после проверки валидности - подавлена, не влияет на результат проверки.';
					|en = 'Error closing the ЧтениеJSON stream after validity check - suppressed, does not affect the check result.'"));
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
