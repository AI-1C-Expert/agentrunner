////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_Hooks (UI-19).
//
// Карточка hook-обработчика на базе единого HTML-поля (ПолеHTMLHook) - тот же
// подход, что в общих формах ar_Настройки и ar_Диалог: сервер собирает HTML
// карточки, обратная связь HTML -> BSL идёт через штатное событие поля
// ПриНажатии и служебные ссылки "1c://<действие>?<параметры>". Значения полей
// ввода читаются из DOM (Элементы.ПолеHTMLHook.Документ.getElementById) -
// работает в толстом/тонком клиенте; в веб-клиенте DOM-доступ деградирует,
// поэтому чтение обёрнуто в Попытку.
//
// Два режима обработчика (ar_ТипОбработчика):
//   "Процедура" - общий модуль + экспортная процедура (двухуровневое ветвление
//                 ar_HookDispatcher, без Выполнить());
//   "Код"       - произвольный код 1С (ar_КодОбработчика), исполняемый
//                 диспетчером через Выполнить() в безопасном режиме.
//
// Запись объекта - только через HTML-кнопки «Записать» / «Записать и закрыть»:
// перед любым действием значения из DOM переносятся в Объект, поэтому
// перерисовка панели не теряет введённые данные.
//
// Поле Description (Наименование) можно оставить пустым - авто-заполняется
// в ObjectModule.ПередЗаписью (META-20).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Единый паттерн форм расширения: при программном открытии тестами - выход.
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// Значения по умолчанию для нового объекта.
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ar_Приоритет = 100;
		Объект.ar_Включён = Истина;
	КонецЕсли;

	Если ПустаяСтрока(Объект.ar_ТипОбработчика) Тогда
		Объект.ar_ТипОбработчика = ?(ПустаяСтрока(Объект.ar_КодОбработчика), "Процедура", "Код");
	КонецЕсли;

	// Если форма открыта с параметром Событие (например, "Создать для события X").
	СобытиеПараметр = Неопределено;
	Параметры.Свойство("Событие", СобытиеПараметр);
	Если ЗначениеЗаполнено(СобытиеПараметр) Тогда
		Объект.ar_Событие = СобытиеПараметр;
	КонецЕсли;

	ПерерисоватьКарточку();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Обрабатывает клик по любому элементу внутри HTML-карточки hook.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент             - ПолеФормы - поле ПолеHTMLHook.
//  ДанныеСобытия       - ФиксированнаяСтруктура - данные DOM-события клика
//                        (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                        открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLHookПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	// Дальше ссылку обрабатываем сами.
	СтандартнаяОбработка = Ложь;

	Действие = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	// Перед любым действием переносим введённые значения из DOM в Объект,
	// чтобы перерисовка панели не потеряла правки пользователя.
	ДанныеПолей = СобратьДанныеИзDOM();

	Если Действие = "save" Тогда
		ЗаписатьHook(ДанныеПолей, Ложь);
	ИначеЕсли Действие = "save-close" Тогда
		ЗаписатьHook(ДанныеПолей, Истина);
	ИначеЕсли Действие = "mode" Тогда
		РежимОбработчика = "";
		ПараметрыСсылки.Свойство("value", РежимОбработчика);
		ПереключитьРежим(ДанныеПолей, РежимОбработчика);
	ИначеЕсли Действие = "toggle" Тогда
		ПереключитьВключён(ДанныеПолей);
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаДействийКлиента

// Читает значения всех полей ввода карточки из DOM HTML-документа.
//
// Возвращаемое значение:
//  Структура - { ИмяПоля -> Строка } только для полей, которые удалось прочитать
//  (в веб-клиенте DOM недоступен - структура может быть пустой).
//
&НаКлиенте
Функция СобратьДанныеИзDOM()

	Данные = Новый Структура;

	ДобавитьЗначениеИзDOM(Данные, "name",      "fld_name");
	ДобавитьЗначениеИзDOM(Данные, "event",     "fld_event");
	ДобавитьЗначениеИзDOM(Данные, "module",    "fld_module");
	ДобавитьЗначениеИзDOM(Данные, "procedure", "fld_procedure");
	ДобавитьЗначениеИзDOM(Данные, "code",      "fld_code");
	ДобавитьЗначениеИзDOM(Данные, "priority",  "fld_priority");
	ДобавитьЗначениеИзDOM(Данные, "source",    "fld_source");

	Возврат Данные;

КонецФункции

// Читает значение одного элемента input/textarea/select по id из DOM и кладёт
// его в структуру данных. Отсутствие элемента/DOM - молча пропускаем.
//
&НаКлиенте
Процедура ДобавитьЗначениеИзDOM(Данные, Знач ИмяПоля, Знач Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLHook.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Данные.Вставить(ИмяПоля, "" + ЭлементВвода.value);
	Исключение
		// DOM недоступен (веб-клиент) - поле останется нетронутым в Объект.
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Записывает hook: переносит данные DOM в Объект, проверяет заполнение и пишет.
//
&НаКлиенте
Процедура ЗаписатьHook(Знач ДанныеПолей, Знач ЗакрытьПослеЗаписи)

	Результат = ЗаписатьHookНаСервере(ДанныеПолей);

	Если Результат.Успех Тогда
		ОповеститьОбИзменении(Объект.Ссылка);
		Оповестить("Запись_ar_Hooks", Новый Структура("Ссылка", Объект.Ссылка), ЭтотОбъект);
		Если ЗакрытьПослеЗаписи Тогда
			Закрыть();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Переключает режим обработчика (Процедура/Код) с сохранением введённых данных.
// В href передаются только ASCII-идентификаторы (procedure/code): кириллица в
// query служебной ссылки может вернуться percent-encoded (см. ar_Настройки).
//
&НаКлиенте
Процедура ПереключитьРежим(Знач ДанныеПолей, Знач КодРежима)

	Если КодРежима = "procedure" Тогда
		РежимОбработчика = "Процедура";
	ИначеЕсли КодРежима = "code" Тогда
		РежимОбработчика = "Код";
	Иначе
		Возврат;
	КонецЕсли;

	ПереключитьРежимНаСервере(ДанныеПолей, РежимОбработчика);

КонецПроцедуры

// Инвертирует флаг «Включён» с сохранением введённых данных.
//
&НаКлиенте
Процедура ПереключитьВключён(Знач ДанныеПолей)

	ПереключитьВключёнНаСервере(ДанныеПолей);

КонецПроцедуры

#КонецОбласти

#Область СерверныеДействия

// Переносит прочитанные из DOM значения в реквизиты Объект.
//
// Параметры:
//  ДанныеПолей - Структура - { имя поля -> строковое значение } из DOM.
//
&НаСервере
Процедура ПрименитьДанныеКОбъекту(Знач ДанныеПолей)

	Значение = Неопределено;

	Если ДанныеПолей.Свойство("name", Значение) Тогда
		Объект.Наименование = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("event", Значение) Тогда
		Объект.ar_Событие = СобытиеПоИмени(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("module", Значение) Тогда
		Объект.ar_ОбщийМодуль = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("procedure", Значение) Тогда
		Объект.ar_ИмяПроцедуры = СокрЛП(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("code", Значение) Тогда
		Объект.ar_КодОбработчика = Значение;
	КонецЕсли;

	Если ДанныеПолей.Свойство("priority", Значение) Тогда
		Объект.ar_Приоритет = ПривестиКЧислу(Значение);
	КонецЕсли;

	Если ДанныеПолей.Свойство("source", Значение) Тогда
		Объект.ar_ИсточникРасширение = СокрЛП(Значение);
	КонецЕсли;

КонецПроцедуры

// Применяет данные DOM и записывает объект с проверкой заполнения.
//
// Возвращаемое значение:
//  Структура - { Успех - Булево, Статус - Строка }.
//
&НаСервере
Функция ЗаписатьHookНаСервере(Знач ДанныеПолей)

	ПрименитьДанныеКОбъекту(ДанныеПолей);

	Результат = Новый Структура("Успех, Статус", Ложь, "");

	ОбъектЗаписи = РеквизитФормыВЗначение("Объект");

	// Ручная запись мимо штатной команды формы: проверку заполнения
	// (ОбработкаПроверкиЗаполнения объекта) вызываем явно.
	Если Не ОбъектЗаписи.ПроверитьЗаполнение() Тогда
		Результат.Статус = ТекстСообщенийПользователю();
		Если ПустаяСтрока(Результат.Статус) Тогда
			Результат.Статус = НСтр("ru='Не заполнены обязательные поля'; en='Required fields are not filled'");
		КонецЕсли;
		ПерерисоватьКарточку(Результат.Статус, Истина);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ОбъектЗаписи.Записать();
	Исключение
		ar_СлужебныйЛог.Записать("ar_Hooks.ФормаЭлемента", "write_error",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Результат.Статус = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПерерисоватьКарточку(Результат.Статус, Истина);
		Возврат Результат;
	КонецПопытки;

	ЗначениеВРеквизитФормы(ОбъектЗаписи, "Объект");
	Модифицированность = Ложь;

	Результат.Успех = Истина;
	Результат.Статус = НСтр("ru='Записано ✓'; en='Saved ✓'");
	ПерерисоватьКарточку(Результат.Статус);

	Возврат Результат;

КонецФункции

// Применяет данные DOM, меняет режим обработчика и перерисовывает карточку.
//
&НаСервере
Процедура ПереключитьРежимНаСервере(Знач ДанныеПолей, Знач РежимОбработчика)

	ПрименитьДанныеКОбъекту(ДанныеПолей);
	Объект.ar_ТипОбработчика = РежимОбработчика;
	Модифицированность = Истина;
	ПерерисоватьКарточку();

КонецПроцедуры

// Применяет данные DOM, инвертирует «Включён» и перерисовывает карточку.
//
&НаСервере
Процедура ПереключитьВключёнНаСервере(Знач ДанныеПолей)

	ПрименитьДанныеКОбъекту(ДанныеПолей);
	Объект.ar_Включён = Не Объект.ar_Включён;
	Модифицированность = Истина;
	ПерерисоватьКарточку();

КонецПроцедуры

// Собирает накопленные сообщения пользователю (проверка заполнения) в одну строку.
//
&НаСервере
Функция ТекстСообщенийПользователю()

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Тексты = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

#КонецОбласти

#Область ПерерисовкаКарточки

// Собирает HTML карточки hook и кладёт его в реквизит СтрокаHTMLHook.
//
// Параметры:
//  СтатусДействия - Строка - статус последнего действия для шапки («Записано ✓»).
//  ЭтоОшибка      - Булево - статус отображается как ошибка (красным).
//
&НаСервере
Процедура ПерерисоватьКарточку(Знач СтатусДействия = "", Знач ЭтоОшибка = Ложь)

	Заголовок = ?(ЗначениеЗаполнено(Объект.Ссылка),
		Строка(Объект.Ссылка),
		НСтр("ru='Hook-обработчик (создание)'; en='Hook handler (new)'"));
	Заголовок = ?(ПустаяСтрока(Объект.Наименование), Заголовок, Объект.Наименование);
	АвтоЗаголовок = Ложь;

	Содержимое = HTMLСекцияШапки(СтатусДействия, ЭтоОшибка)
		+ HTMLСекцияОсновное()
		+ HTMLСекцияОбработчик()
		+ HTMLСекцияКнопки();

	СтрокаHTMLHook = HTMLКаркасКарточки(Содержимое);

КонецПроцедуры

#КонецОбласти

#Область СборкаHTML

// Секция-шапка: заголовок карточки + статус последнего действия.
//
&НаСервере
Функция HTMLСекцияШапки(Знач СтатусДействия, Знач ЭтоОшибка)

	СтатусHTML = "";
	Если Не ПустаяСтрока(СтатусДействия) Тогда
		КлассСтатуса = ?(ЭтоОшибка, "ar-status ar-status-error", "ar-status");
		СтатусHTML = "<span class=""" + КлассСтатуса + """>"
			+ ar_ЭкранироватьHTML(СтатусДействия) + "</span>";
	КонецЕсли;

	ТекстЗаголовка = ?(ЗначениеЗаполнено(Объект.Ссылка),
		НСтр("ru='Hook-обработчик'; en='Hook handler'"),
		НСтр("ru='Hook-обработчик (создание)'; en='Hook handler (new)'"));

	Возврат
		"<div class=""ar-head"">"
		+ "<h1>" + ar_ЭкранироватьHTML(ТекстЗаголовка) + "</h1>"
		+ СтатусHTML
		+ "</div>";

КонецФункции

// Секция «Основное»: наименование, событие, приоритет, включён, источник.
//
&НаСервере
Функция HTMLСекцияОсновное()

	СостояниеВкл = ?(Объект.ar_Включён = Истина, "on", "off");
	МеткаВкл = ?(Объект.ar_Включён = Истина,
		НСтр("ru='Вкл'; en='On'"), НСтр("ru='Выкл'; en='Off'"));

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Основное'; en='General'")) + "</h2>"
		+ HTMLСтрокаПоля(
			НСтр("ru='Наименование'; en='Description'"),
			НСтр("ru='Пусто — сформируется автоматически из события и обработчика.'; en='Empty — generated from event and handler automatically.'"),
			"<input id=""fld_name"" class=""ar-input ar-input-wide"" type=""text"" value="""
				+ ar_ЭкранироватьHTML(Объект.Наименование) + """>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Событие'; en='Event'"),
			НСтр("ru='Точка жизненного цикла agent-runtime, в которой срабатывает hook.'; en='Agent-runtime lifecycle point where the hook fires.'"),
			HTMLВыборСобытия())
		+ HTMLСтрокаПоля(
			НСтр("ru='Приоритет'; en='Priority'"),
			НСтр("ru='Меньшее значение — раньше вызывается.'; en='Lower value — called earlier.'"),
			"<input id=""fld_priority"" class=""ar-input"" type=""number"" value="""
				+ Формат(Объект.ar_Приоритет, "ЧГ=0; ЧДЦ=0") + """>")
		+ HTMLСтрокаПоля(
			НСтр("ru='Включён'; en='Enabled'"),
			НСтр("ru='Выключенный hook не вызывается диспетчером.'; en='Disabled hook is not invoked by the dispatcher.'"),
			СсылкаДействие("toggle", "", МеткаВкл, "ar-toggle ar-toggle-" + СостояниеВкл))
		+ HTMLСтрокаПоля(
			НСтр("ru='Источник (расширение)'; en='Source extension'"),
			НСтр("ru='Пусто = ядро AgentRunner; имя Expert Pack для плагинов.'; en='Empty = AgentRunner core; Expert Pack name for plugins.'"),
			"<input id=""fld_source"" class=""ar-input ar-input-wide"" type=""text"" value="""
				+ ar_ЭкранироватьHTML(Объект.ar_ИсточникРасширение) + """>")
		+ "</div>";

КонецФункции

// Секция «Обработчик»: переключатель режима + поля выбранного режима.
//
&НаСервере
Функция HTMLСекцияОбработчик()

	РежимКод = (Объект.ar_ТипОбработчика = "Код");

	Вкладки =
		"<div class=""ar-tabs"">"
		+ СсылкаДействие("mode", "value=procedure",
			НСтр("ru='Процедура модуля'; en='Module procedure'"),
			"ar-tab" + ?(РежимКод, "", " ar-tab-active"))
		+ СсылкаДействие("mode", "value=code",
			НСтр("ru='Код 1С'; en='1C code'"),
			"ar-tab" + ?(РежимКод, " ar-tab-active", ""))
		+ "</div>";

	Если РежимКод Тогда
		Поля =
			"<div class=""ar-note"">"
			+ ar_ЭкранироватьHTML(НСтр(
				"ru='Код выполняется при срабатывании события в безопасном режиме. Доступны переменные: КонтекстСобытия (Структура события) и Результат (Структура; Результат.Прервать = Истина прерывает цепочку обработчиков).';
				|en='The code runs on the event in safe mode. Available variables: КонтекстСобытия (event structure) and Результат (structure; Результат.Прервать = True stops the handler chain).'"))
			+ "</div>"
			+ "<textarea id=""fld_code"" class=""ar-textarea ar-code"" rows=""14"" spellcheck=""false"">"
			+ ar_ЭкранироватьHTML(Объект.ar_КодОбработчика) + "</textarea>";
	Иначе
		Поля =
			HTMLСтрокаПоля(
				НСтр("ru='Общий модуль'; en='Common module'"),
				НСтр("ru='Имя общего модуля BSL (например: aosHookAuditMetrics).'; en='BSL common module name (e.g.: aosHookAuditMetrics).'"),
				"<input id=""fld_module"" class=""ar-input ar-input-wide"" type=""text"" value="""
					+ ar_ЭкранироватьHTML(Объект.ar_ОбщийМодуль) + """>")
			+ HTMLСтрокаПоля(
				НСтр("ru='Имя процедуры'; en='Procedure name'"),
				НСтр("ru='Экспортная процедура вида ОбработчикСобытия(КонтекстСобытия).'; en='Export procedure of form EventHandler(EventContext).'"),
				"<input id=""fld_procedure"" class=""ar-input ar-input-wide"" type=""text"" value="""
					+ ar_ЭкранироватьHTML(Объект.ar_ИмяПроцедуры) + """>");
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Обработчик'; en='Handler'")) + "</h2>"
		+ Вкладки
		+ Поля
		+ "</div>";

КонецФункции

// Секция кнопок записи.
//
&НаСервере
Функция HTMLСекцияКнопки()

	Возврат
		"<div class=""ar-actions"">"
		+ СсылкаДействие("save-close", "",
			НСтр("ru='Записать и закрыть'; en='Save and close'"), "ar-btn ar-btn-primary")
		+ СсылкаДействие("save", "",
			НСтр("ru='Записать'; en='Save'"), "ar-btn")
		+ "</div>";

КонецФункции

// HTML-select всех значений перечисления ar_СобытиеHook с текущим выбором.
//
&НаСервере
Функция HTMLВыборСобытия()

	ТекущееИмя = ИмяСобытия(Объект.ar_Событие);

	Опции = "<option value=""""" + ?(ПустаяСтрока(ТекущееИмя), " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='(не выбрано)'; en='(not selected)'")) + "</option>";

	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.ar_СобытиеHook.ЗначенияПеречисления Цикл
		Имя = ЗначениеПеречисления.Имя;
		Представление = ЗначениеПеречисления.Синоним;
		Если ПустаяСтрока(Представление) Тогда
			Представление = Имя;
		КонецЕсли;
		Опции = Опции
			+ "<option value=""" + Имя + """" + ?(Имя = ТекущееИмя, " selected", "") + ">"
			+ ar_ЭкранироватьHTML(Представление) + "</option>";
	КонецЦикла;

	Возврат "<select id=""fld_event"" class=""ar-input ar-input-wide"">" + Опции + "</select>";

КонецФункции

// Строит HTML одной строки поля карточки: подпись, описание, редактор.
//
&НаСервере
Функция HTMLСтрокаПоля(Знач Подпись, Знач Описание, Знач РедакторHTML)

	Возврат
		"<div class=""ar-setting"">"
		+ "<div class=""ar-setting-info"">"
		+ "<div class=""ar-setting-label"">" + ar_ЭкранироватьHTML(Подпись) + "</div>"
		+ "<div class=""ar-setting-desc"">" + ar_ЭкранироватьHTML(Описание) + "</div>"
		+ "</div>"
		+ "<div class=""ar-setting-editor"">" + РедакторHTML + "</div>"
		+ "</div>";

КонецФункции

// Формирует HTML-ссылку-действие с href схемы "1c://".
//
// Параметры:
//  Действие         - Строка - имя действия (save/save-close/mode/toggle).
//  ПараметрыЗапроса - Строка - строка query-параметров ("value=..." или "").
//  Текст            - Строка - видимый текст ссылки.
//  КлассCSS         - Строка - CSS-классы.
//
&НаСервере
Функция СсылкаДействие(Знач Действие, Знач ПараметрыЗапроса, Знач Текст, Знач КлассCSS)

	Href = "1c://" + Действие;
	Если Не ПустаяСтрока(ПараметрыЗапроса) Тогда
		Href = Href + "?" + ПараметрыЗапроса;
	КонецЕсли;

	Возврат "<a href=""" + Href + """ class=""" + КлассCSS + """>" + ar_ЭкранироватьHTML(Текст) + "</a>";

КонецФункции

