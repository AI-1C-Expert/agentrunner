////////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Hooks (UI-19), реестр hook-обработчиков.
//
// Динамический список по Catalog.ar_Hooks с колонками:
//   Description (авто-имя "событие: модуль.процедура"), ar_Событие,
//   ar_ОбщийМодуль, ar_ИмяПроцедуры, ar_Приоритет, ar_Включён,
//   ar_ИсточникРасширение.
//
// Возможности:
//   - Быстрый отбор по событию (СписокСобытиеФильтр).
//   - Команда "Включить/Выключить" (ar_ПереключитьВключён): инвертирует
//     флаг ar_Включён через серверный вызов без открытия формы элемента.
//   - Предупреждение для Expert Pack hooks (ar_ИсточникРасширение <> "").
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Единый паттерн форм расширения: при программном открытии тестами - выход.
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// Если форма открыта с параметром Событие - применить отбор.
	ЗначениеСобытия = Неопределено;
	Если Параметры.Свойство("Событие", ЗначениеСобытия)
		И ЗначениеЗаполнено(ЗначениеСобытия) Тогда
		СписокСобытиеФильтр = ЗначениеСобытия;
		ПрименитьОтборПоСобытиюНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Управляет доступностью команды "Включить/Выключить": неактивна,
// если в списке нет выбранной строки.
//
// Параметры:
//   Элемент - ТаблицаФормы - элемент "Список", вызвавший событие.
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	Элементы.КнопкаПереключитьВключен.Доступность = (Элемент.ТекущиеДанные <> Неопределено);

КонецПроцедуры

// Обработчик изменения поля быстрого отбора по событию.
// При заполнении - применяет отбор; при сбросе - снимает.
//
// Параметры:
//   Элемент - ПолеФормы - элемент "СписокСобытиеФильтр".
//
&НаКлиенте
Процедура СписокСобытиеФильтрПриИзменении(Элемент)

	ПрименитьОтборПоСобытиюНаКлиенте();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Команда "Включить/Выключить": инвертирует ar_Включён у текущей строки.
// При ошибке (запись удалена другим пользователем) - нейтральное сообщение
// и запись в ЖурналРегистрации. Для Expert Pack hooks - информационное
// предупреждение (не блокирующее) перед выполнением операции.
//
// Параметры:
//   Команда - КомандаФормы - стандартный параметр обработчика команды.
//
&НаКлиенте
Процедура ar_ПереключитьВключен(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Предупреждение для Expert Pack hooks (информационное, не блокирующее).
	Если ЗначениеЗаполнено(ТекущиеДанные.ar_ИсточникРасширение) Тогда
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru = 'Этот обработчик управляется плагином ""%1"". Выключение вручную может нарушить работу плагина.';
				|en = 'This handler is managed by the ""%1"" plugin. Disabling it manually may break the plugin.'"),
			ТекущиеДанные.ar_ИсточникРасширение);
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;

	Результат = ПереключитьВключенНаСервере(ТекущиеДанные.Ссылка);

	Если НЕ Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
		Возврат;
	КонецЕсли;

	Элементы.Список.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Применяет или снимает отбор по событию (клиентская обертка).
//
&НаКлиенте
Процедура ПрименитьОтборПоСобытиюНаКлиенте()

	ПрименитьОтборПоСобытиюНаСервере();

КонецПроцедуры

// Применяет или снимает отбор динамического списка по полю ar_Событие.
// При заполненном СписокСобытиеФильтр - добавляет элемент отбора "Равно".
// При пустом - удаляет все элементы отбора по этому полю.
//
&НаСервере
Процедура ПрименитьОтборПоСобытиюНаСервере()

	// Отбор ставится штатным методом БСП: он сам управляет составом элементов
	// (Использование = Ложь снимает отбор, не удаляя элемент вручную).
	// Прежний самодельный вариант не работал: тип "ДинамическийСписокОтборПоПолю"
	// в платформе не определён (Type is not defined), а конструкция
	// "Для Индекс = N По -1 Цикл" не является циклом с шагом -1 - на пустой
	// коллекции давала "Index value exceeds range limits". Дефект вскрылся при
	// живой проверке CMPT-03, где такой же код ронял форму списка ar_Tools.
	// [Реф: БСП/CommonModules/ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка]
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"ar_Событие",
		СписокСобытиеФильтр,
		ВидСравненияКомпоновкиДанных.Равно,
		,
		ЗначениеЗаполнено(СписокСобытиеФильтр));

	Список.Прочитать();

КонецПроцедуры

// Инвертирует флаг ar_Включён у записи справочника ar_Hooks по ссылке.
// Выполняется в транзакции с защитой Попытка/Исключение.
// При ошибке - фиксирует в ЖурналРегистрации и возвращает Успех = Ложь.
//
// Параметры:
//   Ссылка - СправочникСсылка.ar_Hooks - переключаемый обработчик.
//
// Возвращаемое значение:
//   Структура:
//     * Успех    - Булево - Ложь при ошибке.
//     * Сообщение - Строка - текст для ПоказатьПредупреждение (пусто при успехе).
//
&НаСервере
Функция ПереключитьВключенНаСервере(Знач Ссылка)

	Результат = Новый Структура("Успех, Сообщение", Истина, "");

	ОбъектЗапись = Ссылка.ПолучитьОбъект();
	Если ОбъектЗапись = Неопределено Тогда
		Результат.Успех = Ложь;
		Результат.Сообщение = НСтр(
			"ru = 'Запись больше не существует, обновите список';
			|en = 'The record no longer exists, refresh the list'");
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		ОбъектЗапись.ar_Включён = НЕ ОбъектЗапись.ar_Включён;
		ОбъектЗапись.Записать();
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();

		ЗаписьЖурналаРегистрации(
			"ar_Hooks.ФормаСписка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);

		Результат.Успех = Ложь;
		Результат.Сообщение = НСтр(
			"ru = 'Не удалось изменить состояние обработчика, подробности - в журнале регистрации';
			|en = 'Failed to change handler state, see the event log for details'");

	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
