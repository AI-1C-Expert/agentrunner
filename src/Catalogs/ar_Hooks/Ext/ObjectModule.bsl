// Модуль объекта справочника ar_Hooks.
//
// Зона ответственности (META-20):
//   - автозаполнение Наименования на основе ar_Событие + обработчик
//     (модуль.процедура либо метка «код 1С») при пустом наименовании,
//     чтобы карточка отображалась осмысленно (DefaultPresentation = AsDescription);
//   - проверка заполнения с учётом типа обработчика (ar_ТипОбработчика):
//     "Процедура" (или пусто) — обязательны ar_ОбщийМодуль и ar_ИмяПроцедуры;
//     "Код" — обязателен ar_КодОбработчика.
//
// Справочник - реестр hook-обработчиков событий жизненного цикла agent-runtime.
// Каждая запись связывает одно событие lifecycle (ar_Событие) либо с процедурой
// в общем модуле (ar_ОбщийМодуль + ar_ИмяПроцедуры), либо с произвольным кодом 1С
// (ar_КодОбработчика), исполняемым диспетчером в безопасном режиме.

#Область ОбработчикиСобытий

// Платформенный обработчик перед записью.
// Используется для авто-заполнения Наименования на основе события и обработчика.
//
// Параметры:
//  Отказ - Булево - флаг отказа от записи.
//
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Если наименование пустое - формируем из события и обработчика для удобства отображения.
	Если ПустаяСтрока(Наименование) Тогда

		ЧастиНаименования = Новый Массив;

		Если ЗначениеЗаполнено(ar_Событие) Тогда
			ЧастиНаименования.Добавить(Строка(ar_Событие));
		КонецЕсли;

		Если ЭтоОбработчикКодом() Тогда
			ЧастиНаименования.Добавить(НСтр("ru='код 1С'; en='1C code'"));
		ИначеЕсли ЗначениеЗаполнено(ar_ОбщийМодуль) И ЗначениеЗаполнено(ar_ИмяПроцедуры) Тогда
			ЧастиНаименования.Добавить(ar_ОбщийМодуль + "." + ar_ИмяПроцедуры);
		КонецЕсли;

		Если ЧастиНаименования.Количество() > 0 Тогда
			Наименование = СтрСоединить(ЧастиНаименования, ": ");
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Платформенный обработчик проверки заполнения.
// FillChecking у ar_ОбщийМодуль / ar_ИмяПроцедуры снят (DontCheck):
// обязательность зависит от типа обработчика и проверяется здесь.
//
// Параметры:
//  Отказ - Булево - флаг отказа.
//  ПроверяемыеРеквизиты - Массив - реквизиты со стандартной проверкой.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоОбработчикКодом() Тогда

		Если ПустаяСтрока(ar_КодОбработчика) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Не заполнен код обработчика (1С).'; en='Handler code (1C) is not filled.'"),
				Ссылка, "Объект.ar_КодОбработчика", , Отказ);
		КонецЕсли;

	Иначе

		Если ПустаяСтрока(ar_ОбщийМодуль) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Не заполнено имя общего модуля.'; en='Common module name is not filled.'"),
				Ссылка, "Объект.ar_ОбщийМодуль", , Отказ);
		КонецЕсли;

		Если ПустаяСтрока(ar_ИмяПроцедуры) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Не заполнено имя процедуры.'; en='Procedure name is not filled.'"),
				Ссылка, "Объект.ar_ИмяПроцедуры", , Отказ);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик задан кодом 1С (а не процедурой общего модуля).
//
// Возвращаемое значение:
//  Булево - Истина, если ar_ТипОбработчика = "Код".
//
Функция ЭтоОбработчикКодом()
	Возврат СокрЛП(ar_ТипОбработчика) = "Код";
КонецФункции

#КонецОбласти
