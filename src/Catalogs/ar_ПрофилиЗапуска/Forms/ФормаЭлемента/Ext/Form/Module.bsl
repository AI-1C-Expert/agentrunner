////////////////////////////////////////////////////////////////////////////////
// Форма элемента Справочник.ar_ПрофилиЗапуска (CONS-01).
//
// Единственная нестандартная обязанность формы - держать реквизит формы
// Расшифровка актуальным по данным ТЧ Объект.ar_ОбластьДанных ДО записи
// объекта (спека CONS-01, «Текстовая расшифровка»): пересчёт на сервере при
// открытии формы и при каждом изменении/удалении строки таблицы. Логика
// самого текста - в ar_ПрофилиЗапуска.ТекстоваяРасшифровкаПоТаблице, форма
// только вызывает её и не дублирует allow/deny-семантику.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьРасшифровкуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьРасшифровкуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыОбластьДанных

&НаКлиенте
Процедура ОбластьДанныхПриИзменении(Элемент)

	ОбновитьРасшифровкуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбластьДанныхПослеУдаления(Элемент)

	ОбновитьРасшифровкуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пересчитывает реквизит формы Расшифровка по текущим (возможно, ещё не
// записанным) данным Объект.ar_ОбластьДанных - работает без обращения к уже
// сохранённому в базе объекту (спека CONS-01: пользователь должен видеть
// актуальную расшифровку до записи).
//
&НаСервере
Процедура ОбновитьРасшифровкуНаСервере()

	Расшифровка = ar_ПрофилиЗапуска.ТекстоваяРасшифровкаПоТаблице(Объект.ar_ОбластьДанных);

КонецПроцедуры

#КонецОбласти
