// Модуль объекта справочника ar_Skills.
//
// Зона ответственности (META-23):
//   - автообновление ar_Обновлено при создании нового элемента или изменении ar_Содержимое;
//   - автозаполнение Наименования значением ar_Имя при пустом наименовании.
//
// Справочник - реестр переиспользуемых markdown-skills для агентов.
// Каждая запись хранит markdown-тело skill (ar_Содержимое) и метаданные
// (Имя, Описание, Категория, Версия, Автор).

#Область ОбработчикиСобытий

// Платформенный обработчик перед записью.
// Используется для автообновления ar_Обновлено и автозаполнения Наименования.
//
// Параметры:
//  Отказ - Булево - флаг отказа от записи.
//
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Автозаполнение Наименования значением ar_Имя.
	Если ПустаяСтрока(Наименование) И ЗначениеЗаполнено(ar_Имя) Тогда
		Наименование = ar_Имя;
	КонецЕсли;

	// Автообновление ar_Обновлено при создании или изменении Содержимого.
	Если ЭтоНовый() Тогда
		// Новый элемент - устанавливаем текущую дату.
		ar_Обновлено = ТекущаяДатаСеанса();
	Иначе
		// Существующий элемент - проверяем, изменилось ли Содержимое.
		ОбъектБД = Ссылка.ПолучитьОбъект();
		Если ОбъектБД <> Неопределено И ОбъектБД.ar_Содержимое <> ar_Содержимое Тогда
			ar_Обновлено = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
