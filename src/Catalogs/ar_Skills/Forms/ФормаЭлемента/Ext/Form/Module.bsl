КонецФункции

// Экранирует спецсимволы HTML (тот же контракт, что в ar_Настройки/ar_Диалог).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст,    "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РендерMarkdown

// Предельная длина содержимого (символов), рендерящаяся в HTML-превью.
//
&НаСервере
Функция МаксДлинаПревью()
	Возврат 20000;
КонецФункции

// Преобразует минимальный subset markdown в HTML-тело превью (без каркаса).
// Поддержано: заголовки H1-H3, **жирный**/__жирный__, *курсив*/_курсив_,
// маркированные (- / *) и нумерованные (N.) списки, `код`, абзацы.
// Спецсимволы <, >, &, " экранируются.
// Парсер унаследован от SKILL-01 (копия из UI-03, ar_Агенты.ФормаЭлемента);
// директивы переведены на сервер: превью теперь рендерится при сборке панели.
//
&НаСервере
Функция МаркdownТелоHTML(Знач ТекстМД)

	ПредельнаяДлина = МаксДлинаПревью();
	Обрезано = Ложь;
	Если СтрДлина(ТекстМД) > ПредельнаяДлина Тогда
		ТекстМД = Лев(ТекстМД, ПредельнаяДлина);
		Обрезано = Истина;
	КонецЕсли;

	Если ПустаяСтрока(ТекстМД) Тогда
		Возврат "<p style=""color:gray"">"
			+ НСтр("ru = 'Содержимое не введено'; en = 'No content entered'")
			+ "</p>";
	КонецЕсли;

	Строки = СтрРазделить(ТекстМД, Символы.ПС, Истина);

	Парсер = Новый Структура("Фрагменты, ВСписке", Новый Массив, "");
	Для Каждого Строка Из Строки Цикл
		РазобратьСтрокуMD(Парсер, СокрП(Строка));
	КонецЦикла;
	ЗакрытьСписокЕслиОткрыт(Парсер);

	Если Обрезано Тогда
		Парсер.Фрагменты.Добавить("<p style=""color:red"">"
			+ НСтр("ru = '...текст обрезан для превью...'; en = '...text truncated for preview...'")
			+ "</p>");
	КонецЕсли;

	Возврат СтрСоединить(Парсер.Фрагменты, "");

КонецФункции

&НаСервере
Процедура РазобратьСтрокуMD(Парсер, Знач Строка)

	Если ПустаяСтрока(Строка) Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Возврат;
	КонецЕсли;

	Если ДобавитьЗаголовокMD(Парсер, Строка) Тогда
		Возврат;
	КонецЕсли;

	Если ДобавитьПунктСпискаMD(Парсер, Строка) Тогда
		Возврат;
	КонецЕсли;

	ЗакрытьСписокЕслиОткрыт(Парсер);
	Парсер.Фрагменты.Добавить("<p>" + ВстроенноеФорматирование(Строка) + "</p>");

КонецПроцедуры

&НаСервере
Функция ДобавитьЗаголовокMD(Парсер, Знач Строка)

	Если СтрНачинаетсяС(Строка, "### ") Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Парсер.Фрагменты.Добавить("<h3>" + ВстроенноеФорматирование(Сред(Строка, 5)) + "</h3>");
		Возврат Истина;
	ИначеЕсли СтрНачинаетсяС(Строка, "## ") Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Парсер.Фрагменты.Добавить("<h2>" + ВстроенноеФорматирование(Сред(Строка, 4)) + "</h2>");
		Возврат Истина;
	ИначеЕсли СтрНачинаетсяС(Строка, "# ") Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Парсер.Фрагменты.Добавить("<h1>" + ВстроенноеФорматирование(Сред(Строка, 3)) + "</h1>");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция ДобавитьПунктСпискаMD(Парсер, Знач Строка)

	Если СтрНачинаетсяС(Строка, "- ") ИЛИ СтрНачинаетсяС(Строка, "* ") Тогда
		ОткрытьСписок(Парсер, "ul");
		Парсер.Фрагменты.Добавить("<li>" + ВстроенноеФорматирование(Сред(Строка, 3)) + "</li>");
		Возврат Истина;
	КонецЕсли;

	Если ЭтоНумерованныйПункт(Строка) Тогда
		ОткрытьСписок(Парсер, "ol");
		ПозицияТочки = СтрНайти(Строка, ". ");
		НачалоТекста = ПозицияТочки + 2;
		Парсер.Фрагменты.Добавить("<li>" + ВстроенноеФорматирование(Сред(Строка, НачалоТекста)) + "</li>");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ОткрытьСписок(Парсер, Знач ТипСписка)

	Если Парсер.ВСписке = ТипСписка Тогда
		Возврат;
	КонецЕсли;

	ЗакрытьСписокЕслиОткрыт(Парсер);
	Парсер.Фрагменты.Добавить("<" + ТипСписка + ">");
	Парсер.ВСписке = ТипСписка;

КонецПроцедуры

&НаСервере
Процедура ЗакрытьСписокЕслиОткрыт(Парсер)

	Если Парсер.ВСписке = "ul" Тогда
		Парсер.Фрагменты.Добавить("</ul>");
	ИначеЕсли Парсер.ВСписке = "ol" Тогда
		Парсер.Фрагменты.Добавить("</ol>");
	КонецЕсли;

	Парсер.ВСписке = "";

КонецПроцедуры

&НаСервере
Функция ЭтоНумерованныйПункт(Знач Строка)

	ПозицияТочки = СтрНайти(Строка, ". ");
	Если ПозицияТочки < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Цифры = Лев(Строка, ПозицияТочки - 1);
	Для Индекс = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаСервере
Функция ВстроенноеФорматирование(Знач Текст)

	Результат = ar_ЭкранироватьHTML(Текст);
	Результат = ЗаменитьПарныйМаркер(Результат, "**", "<strong>", "</strong>");
	Результат = ЗаменитьПарныйМаркер(Результат, "__", "<strong>", "</strong>");
	Результат = ЗаменитьПарныйМаркер(Результат, "*", "<em>", "</em>");
	Результат = ЗаменитьПарныйМаркер(Результат, "_", "<em>", "</em>");
	Результат = ЗаменитьПарныйМаркер(Результат, "`", "<code>", "</code>");
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗаменитьПарныйМаркер(Знач Текст, Знач Маркер, Знач ОткрывающийТег, Знач ЗакрывающийТег)

	Результат = "";
	Остаток = Текст;
	Открыт = Ложь;

	ПозицияМаркера = СтрНайти(Остаток, Маркер);
	Пока ПозицияМаркера > 0 Цикл
		Результат = Результат + Лев(Остаток, ПозицияМаркера - 1);
		Если Открыт Тогда
			Результат = Результат + ЗакрывающийТег;
		Иначе
			Результат = Результат + ОткрывающийТег;
		КонецЕсли;
		Открыт = НЕ Открыт;
		Остаток = Сред(Остаток, ПозицияМаркера + СтрДлина(Маркер));
		ПозицияМаркера = СтрНайти(Остаток, Маркер);
	КонецЦикла;

	Результат = Результат + Остаток;

	Если Открыт Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имена реквизитов объекта, редактируемых через поля ввода HTML-панели.
// id элементов input/textarea в HTML совпадают с этими именами.
//
&НаКлиентеНаСервереБезКонтекста
Функция ИменаПолейВвода()

	Имена = Новый Массив;
	Имена.Добавить("ar_Имя");
	Имена.Добавить("ar_Категория");
	Имена.Добавить("ar_Версия");
	Имена.Добавить("ar_Автор");
	Имена.Добавить("ar_ИсточникРасширение");
	Имена.Добавить("ar_Описание");
	Имена.Добавить("ar_Содержимое");
	Возврат Имена;

КонецФункции

// Извлекает имя действия из служебной ссылки "1c://<действие>?<параметры>".
//
&НаКлиентеНаСервереБезКонтекста
Функция ДействиеИзСсылки(Знач Ссылка)
	Тело = Сред(Ссылка, СтрДлина("1c://") + 1);
	ПозицияВопроса = СтрНайти(Тело, "?");
	Если ПозицияВопроса > 0 Тогда
		Тело = Лев(Тело, ПозицияВопроса - 1);
	КонецЕсли;
	Возврат СокрЛП(Тело);
КонецФункции

#КонецОбласти
