////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_Skills («Навык»).
//
// Форма целиком построена на подходе «управление через HTML-поле»
// (референсы: ОбщаяФорма.ar_Настройки, ОбщаяФорма.ar_Диалог): вся форма - одно
// поле ПолеHTMLДокумента (ПолеHTMLSkill), сервер собирает HTML-панель:
//   1) шапка с именем навыка, статусом последнего действия и кнопками
//      (Записать / Записать и закрыть / Экспорт);
//   2) карточка реквизитов (Имя, Категория, Версия, Автор, Источник, Описание);
//   3) карточка содержимого: textarea markdown + живое HTML-превью.
//
// Обратная связь HTML -> BSL реализована штатным событием поля ПриНажатии:
// каждый интерактивный элемент - ссылка вида "1c://<действие>?<параметры>".
// При клике href приходит в ДанныеСобытия.Href (эталон БСП
// ВзаимодействияКлиент.ПолеHTMLПриНажатии), стандартная обработка подавляется,
// а BSL разбирает схему и выполняет действие. Значения полей ввода читаются
// из DOM (Элементы.ПолеHTMLSkill.Документ.getElementById) - это работает в
// толстом клиенте; в веб-клиенте DOM-доступ деградирует, поэтому чтение
// обёрнуто в Попытку (тот же контракт, что в ar_Настройки).
//
// Запись объекта идёт через штатный клиентский Записать() формы, поэтому вся
// логика МодуляОбъекта (автообновление ar_Обновлено, автозаполнение
// Наименования) сохраняется без изменений.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ветка автотеста: при программном открытии формы тестами пропускаем
	// инициализацию (единый паттерн форм расширения).
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПравоДоступа("Изменение", Метаданные.Справочники.ar_Skills) Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

	ПерерисоватьПанельSkill();

КонецПроцедуры

#КонецОбласти

#Область ДиспетчерHTML

// Обрабатывает клик по любому элементу внутри HTML-панели навыка.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент             - ПолеФормы - поле ПолеHTMLSkill.
//  ДанныеСобытия       - ФиксированнаяСтруктура - данные DOM-события клика
//                        (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                        открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLSkillПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	// Дальше ссылку обрабатываем сами.
	СтандартнаяОбработка = Ложь;

	Действие = ДействиеИзСсылки(Ссылка);

	Если Действие = "save" Тогда
		ОбработатьСохранение(Ложь);
	ИначеЕсли Действие = "save-close" Тогда
		ОбработатьСохранение(Истина);
	ИначеЕсли Действие = "preview" Тогда
		ОбработатьПревью();
	ИначеЕсли Действие = "export" Тогда
		ОбработатьЭкспорт();
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ДействияКлиент

// Переносит значения из DOM в Объект и записывает его штатным Записать().
//
// Параметры:
//  ЗакрытьПосле - Булево - Истина для действия «Записать и закрыть».
//
&НаКлиенте
Процедура ОбработатьСохранение(ЗакрытьПосле)

	СинхронизироватьОбъектСDOM();

	Если Записать() Тогда
		Если ЗакрытьПосле Тогда
			Закрыть();
			Возврат;
		КонецЕсли;
		ПерерисоватьПанельSkillНаСервере(НСтр("ru='Сохранено ✓'; en='Saved ✓'"));
	Иначе
		// Причины отказа (незаполненные обязательные поля и т.п.) платформа
		// уже вывела в окно сообщений - в шапке показываем краткий статус.
		ПерерисоватьПанельSkillНаСервере(НСтр("ru='Не сохранено'; en='Not saved'"));
	КонецЕсли;

КонецПроцедуры

// Обновляет HTML-превью markdown-содержимого: синхронизирует Объект с DOM
// и перерисовывает панель (превью рендерится на сервере при сборке HTML).
//
&НаКлиенте
Процедура ОбработатьПревью()

	СинхронизироватьОбъектСDOM();
	ПерерисоватьПанельSkillНаСервере();

КонецПроцедуры

// Экспортирует навык в .md-файл через ar_SkillsИмпортЭкспорт (логика SKILL-01).
//
&НаКлиенте
Процедура ОбработатьЭкспорт()

	СинхронизироватьОбъектСDOM();

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ Модифицированность Тогда
		ПерерисоватьПанельSkillНаСервере(НСтр("ru='Сначала запишите навык, затем экспортируйте';
			|en='Save the skill before exporting'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Объект.ar_Имя) Тогда
		ПерерисоватьПанельSkillНаСервере(НСтр("ru='Поле «Имя» не заполнено - экспорт невозможен';
			|en='Field ""Name"" is empty - export is not possible'"));
		Возврат;
	КонецЕсли;

	Результат = ЭкспортироватьНаСервере(Объект.Ссылка);

	Если НЕ Результат.Успех Тогда
		ПерерисоватьПанельSkillНаСервере(Результат.Ошибка);
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеСохраненияФайлаЭкспорта", ЭтотОбъект);
	ПередаваемыйФайл = Новый ОписаниеПередаваемогоФайла(Результат.ИмяФайла, Результат.АдресВХранилище);
	ОписаниеФайлов = Новый Массив;
	ОписаниеФайлов.Добавить(ПередаваемыйФайл);

	ПараметрыПолучения = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыПолучения.Интерактивно = Истина;

	НачатьПолучениеФайлов(Оповещение, ОписаниеФайлов, ПараметрыПолучения);

КонецПроцедуры

&НаКлиенте
Процедура ПослеСохраненияФайлаЭкспорта(ПолученныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Навык экспортирован'; en = 'Skill exported'"),
		,
		НСтр("ru = 'Файл сохранен'; en = 'File saved'"),
		,
		СтатусОповещенияПользователя.Информация);

КонецПроцедуры

// Переносит текущие значения полей ввода из DOM HTML-документа в Объект.
// Если DOM недоступен (веб-клиент), значения остаются как были - деградация
// та же, что в ar_Настройки. Программное присваивание не выставляет
// Модифицированность автоматически, поэтому флаг ставится вручную при
// фактическом изменении - иначе не сработают проверка несохранённых правок
// перед экспортом и стандартный вопрос при закрытии формы.
//
&НаКлиенте
Процедура СинхронизироватьОбъектСDOM()

	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИмяПоля Из ИменаПолейВвода() Цикл
		Значение = ПрочитатьЗначениеИзDOM(ИмяПоля);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Объект[ИмяПоля] <> "" + Значение Тогда
			Объект[ИмяПоля] = "" + Значение;
			Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Читает значение элемента input/textarea по id из DOM HTML-документа.
// Возвращает Неопределено, если DOM-доступ недоступен (веб-клиент) или элемент не найден.
//
&НаКлиенте
Функция ПрочитатьЗначениеИзDOM(Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLSkill.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЭлементВвода.value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СерверныеМетоды

// Серверная обёртка экспорта (ar_SkillsИмпортЭкспорт недоступен на клиенте).
//
// Параметры:
//  СсылкаНавыка - СправочникСсылка.ar_Skills - экспортируемый навык.
//
// Возвращаемое значение:
//  Структура (Успех, Ошибка, ИмяФайла, АдресВХранилище) - результат экспорта.
//
&НаСервереБезКонтекста
Функция ЭкспортироватьНаСервере(Знач СсылкаНавыка)

	Возврат ar_SkillsИмпортЭкспорт.Экспортировать(СсылкаНавыка);

КонецФункции

#КонецОбласти

#Область ПерерисовкаПанели

// Клиентская обёртка перерисовки: пересобирает HTML-панель на сервере.
//
// Параметры:
//  СтатусДействия - Строка - необязательный статус последнего действия для показа
//                   в шапке панели (например «Сохранено ✓»).
//
&НаКлиенте
Процедура ПерерисоватьПанельSkillНаСервере(СтатусДействия = "")
	ПерерисоватьПанельSkill(СтатусДействия);
КонецПроцедуры

// Собирает HTML панели навыка и кладёт его в реквизит СтрокаHTMLSkill.
//
&НаСервере
Процедура ПерерисоватьПанельSkill(Знач СтатусДействия = "")

	СтрокаHTMLSkill = СобратьHTMLSkill(СтатусДействия);

КонецПроцедуры

#КонецОбласти

#Область СборкаHTML

// Собирает полный HTML-документ панели навыка.
//
// Параметры:
//  СтатусДействия - Строка - статус последнего действия для шапки.
//
// Возвращаемое значение:
//  Строка - готовый HTML-документ для поля ПолеHTMLSkill.
//
&НаСервере
Функция СобратьHTMLSkill(Знач СтатусДействия)

	Содержимое = HTMLСекцияШапки(СтатусДействия)
		+ HTMLСекцияРеквизитов()
		+ HTMLСекцияСодержимого();

	Возврат HTMLКаркасSkill(Содержимое);

КонецФункции

// Секция-шапка: имя навыка, статус последнего действия и кнопки действий.
//
&НаСервере
Функция HTMLСекцияШапки(Знач СтатусДействия)

	Заголовок = Объект.ar_Имя;
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = ?(ЗначениеЗаполнено(Объект.Ссылка),
			Объект.Наименование,
			НСтр("ru='Новый навык'; en='New skill'"));
	КонецЕсли;

	СтатусHTML = "";
	Если НЕ ПустаяСтрока(СтатусДействия) Тогда
		СтатусHTML = "<span class=""ar-status"">" + ar_ЭкранироватьHTML(СтатусДействия) + "</span>";
	КонецЕсли;

	Кнопки = "";
	Если НЕ ТолькоПросмотр Тогда
		Кнопки = СсылкаДействие("save", НСтр("ru='Записать'; en='Save'"), "ar-btn")
			+ СсылкаДействие("save-close", НСтр("ru='Записать и закрыть'; en='Save and close'"), "ar-btn ar-btn-primary");
	КонецЕсли;
	Кнопки = Кнопки + СсылкаДействие("export", НСтр("ru='Экспорт в .md'; en='Export to .md'"), "ar-btn");

	Возврат
		"<div class=""ar-head"">"
		+ "<h1>" + ar_ЭкранироватьHTML(Заголовок) + "</h1>"
		+ СтатусHTML
		+ "<div class=""ar-head-actions"">" + Кнопки + "</div>"
		+ "</div>";

КонецФункции

// Карточка реквизитов навыка: сетка полей ввода + служебная строка «Обновлено».
//
&НаСервере
Функция HTMLСекцияРеквизитов()

	Обновлено = ?(ЗначениеЗаполнено(Объект.ar_Обновлено),
		Формат(Объект.ar_Обновлено, "ДЛФ=DT"),
		НСтр("ru='не заполнено'; en='not set'"));

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Основное'; en='General'")) + "</h2>"
		+ "<div class=""ar-grid"">"
		+ HTMLПолеВвода("ar_Имя", НСтр("ru='Имя *'; en='Name *'"), Объект.ar_Имя)
		+ HTMLПолеВвода("ar_Категория", НСтр("ru='Категория'; en='Category'"), Объект.ar_Категория)
		+ HTMLПолеВвода("ar_Версия", НСтр("ru='Версия'; en='Version'"), Объект.ar_Версия)
		+ HTMLПолеВвода("ar_Автор", НСтр("ru='Автор'; en='Author'"), Объект.ar_Автор)
		+ HTMLПолеВвода("ar_ИсточникРасширение", НСтр("ru='Источник (расширение)'; en='Source extension'"), Объект.ar_ИсточникРасширение)
		+ "<div class=""ar-field""><label>" + ar_ЭкранироватьHTML(НСтр("ru='Обновлено'; en='Updated'")) + "</label>"
		+ "<span class=""ar-refval"">" + ar_ЭкранироватьHTML(Обновлено) + "</span></div>"
		+ "</div>"
		+ "<div class=""ar-field ar-field-wide""><label>"
		+ ar_ЭкранироватьHTML(НСтр("ru='Описание'; en='Description'")) + "</label>"
		+ "<textarea id=""ar_Описание"" class=""ar-textarea"" rows=""3""" + АтрибутТолькоПросмотр() + ">"
		+ ar_ЭкранироватьHTML(Объект.ar_Описание) + "</textarea></div>"
		+ "</div>";

КонецФункции

// Карточка содержимого: markdown-textarea слева, HTML-превью справа.
//
&НаСервере
Функция HTMLСекцияСодержимого()

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Содержимое (markdown) *'; en='Content (markdown) *'")) + "</h2>"
		+ СсылкаДействие("preview", НСтр("ru='Обновить превью'; en='Refresh preview'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ "<div class=""ar-content"">"
		+ "<textarea id=""ar_Содержимое"" class=""ar-textarea ar-md-input"" rows=""20""" + АтрибутТолькоПросмотр() + ">"
		+ ar_ЭкранироватьHTML(Объект.ar_Содержимое) + "</textarea>"
		+ "<div class=""ar-md-preview"">" + МаркdownТелоHTML(Объект.ar_Содержимое) + "</div>"
		+ "</div>"
		+ "</div>";

КонецФункции

// Строит поле ввода реквизита: подпись + input с id, равным имени реквизита.
//
&НаСервере
Функция HTMLПолеВвода(Знач Ид, Знач Подпись, Знач Значение)

	Возврат
		"<div class=""ar-field"">"
		+ "<label for=""" + Ид + """>" + ar_ЭкранироватьHTML(Подпись) + "</label>"
		+ "<input id=""" + Ид + """ class=""ar-input"" type=""text"" value="""
		+ ar_ЭкранироватьHTML(Значение) + """" + АтрибутТолькоПросмотр() + ">"
		+ "</div>";

КонецФункции

// HTML-атрибут disabled для режима «только просмотр».
//
&НаСервере
Функция АтрибутТолькоПросмотр()
	Возврат ?(ТолькоПросмотр, " disabled", "");
КонецФункции

// Формирует HTML-ссылку-действие с href схемы "1c://".
//
// Параметры:
//  Действие - Строка - имя действия (save/save-close/preview/export).
//  Текст    - Строка - видимый текст ссылки.
//  КлассCSS - Строка - CSS-классы.
//
&НаСервере
Функция СсылкаДействие(Знач Действие, Знач Текст, Знач КлассCSS)

	Возврат "<a href=""1c://" + Действие + """ class=""" + КлассCSS + """>"
		+ ar_ЭкранироватьHTML(Текст) + "</a>";

КонецФункции

// Обёртка HTML-каркаса со встроенными стилями (офлайн-first, без внешних CDN).
// JS отсутствует: вся навигация - через <a href="1c://">, значения читаются из DOM.
//
&НаКлиентеНаСервереБезКонтекста
Функция HTMLКаркасSkill(Знач Содержимое)

	Возврат
		"<!DOCTYPE html><html><head><meta charset=""utf-8""><style>"
		+ "html,body{margin:0;padding:0;background:#f4f6f8;color:#1b1f23;"
		+ "font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:13px;}"
		+ ".ar-wrap{max-width:1100px;margin:0 auto;padding:12px;}"
		+ ".ar-head{display:flex;align-items:center;gap:12px;margin:6px 4px 10px;flex-wrap:wrap;}"
		+ ".ar-head h1{font-size:18px;margin:0;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}"
		+ ".ar-head-actions{display:flex;gap:8px;}"
		+ ".ar-status{color:#1a7f37;font-weight:600;}"
		+ ".ar-card{background:#fff;border:1px solid #e1e6eb;border-radius:10px;"
