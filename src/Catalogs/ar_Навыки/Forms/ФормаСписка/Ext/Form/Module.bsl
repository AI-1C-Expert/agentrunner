//////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Навыки (SKILL-01, SKILL-04).
//
// Команда "Импорт" (SKILL-04): принимает .md-файл с frontmatter,
// разбирает через ar_НавыкиИмпортЭкспорт.РазобратьФайл, выполняет upsert
// через ar_НавыкиИмпортЭкспорт.Импортировать.
//////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ar_ИмпортНавыка(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайлаИмпорта", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ПослеПомещенияФайлаИмпорта(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено ИЛИ НЕ ПомещенныйФайл.Получен Тогда
		Возврат;
	КонецЕсли;

	Результат = ИмпортSkillНаСервере(ПомещенныйФайл.Адрес);
	УдалитьИзВременногоХранилищаНаСервере(ПомещенныйФайл.Адрес);

	Если НЕ Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;

	Если Результат.Создан Тогда
		ТекстОповещения = СтрШаблон(
			НСтр("ru = 'Создан новый skill: %1';
				|en = 'Created new skill: %1'"),
			Результат.Имя);
	Иначе
		ТекстОповещения = СтрШаблон(
			НСтр("ru = 'Обновлен skill: %1';
				|en = 'Updated skill: %1'"),
			Результат.Имя);
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		ТекстОповещения,
		,
		,
		,
		СтатусОповещенияПользователя.Информация);

	Элементы.Список.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ИмпортSkillНаСервере(АдресВХранилище)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Имя", "");
	Результат.Вставить("Создан", Ложь);
	Результат.Вставить("Ошибка", "");

	ДанныеФайла = ar_НавыкиИмпортЭкспорт.РазобратьФайл(АдресВХранилище);
	Если НЕ ДанныеФайла.Успех Тогда
		Результат.Ошибка = ДанныеФайла.Ошибка;
		Возврат Результат;
	КонецЕсли;

	РезультатИмпорт = ar_НавыкиИмпортЭкспорт.Импортировать(ДанныеФайла);
	Если НЕ РезультатИмпорт.Успех Тогда
		Результат.Ошибка = РезультатИмпорт.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Имя = ДанныеФайла.Имя;
	Результат.Создан = РезультатИмпорт.Создан;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура УдалитьИзВременногоХранилищаНаСервере(АдресВХранилище)

	Попытка
		УдалитьИзВременногоХранилища(АдресВХранилище);
	Исключение
		// Тихая деградация: временное хранилище может быть уже очищено.
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
