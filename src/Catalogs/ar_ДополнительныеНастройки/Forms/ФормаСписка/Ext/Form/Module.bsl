////////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_ДополнительныеНастройки (PAY-01).
//
// Команда "Заполнить типовые настройки" идемпотентно создаёт недостающие
// известные ключи (на старте - только ОрганизацииКонтроляОплат), чтобы
// администратор не угадывал точное имя ключа вручную (паттерн - upsert по
// ключу, без дублей, аналог ar_ToolФинансы.ЗарегистрироватьОдинTool).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьТиповыеНастройки(Команда)

	Итог = ЗаполнитьТиповыеНастройкиНаСервере();
	ПоказатьОповещениеПользователя(СтрШаблон(
		НСтр("ru = 'Типовые настройки заполнены: создано %1, уже было %2';
			|en = 'Default settings applied: created %1, already existed %2'"),
		Итог.Создано, Итог.БылоРанее));

	// Динамический список обновляется через элемент формы: присваивание
	// реквизиту типа ДинамическийСписок запрещено платформой
	// ("Cannot assign a value to a form attribute of ДинамическийСписок type").
	// Эталон - ar_Skills/ar_Hooks/ar_ОчередьПодтверждений.
	Элементы.Список.Обновить();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьТиповыеНастройкиНаСервере()
	// Каталог ключей и само заполнение живут в ar_Настройки - тот же код
	// вызывается обработчиком обновления релиза (ar_ОбновлениеРасширения),
	// поэтому на обновлении настройки появляются без ручного нажатия кнопки.
	Возврат ar_Настройки.ЗаполнитьТиповыеНастройки();
КонецФункции



#КонецОбласти
