// Модуль объекта справочника ar_Пресеты.
//
// Зона ответственности (META-22):
//   - проверка валидности ar_JSON (предупреждение, не блокирует запись);
//   - автозаполнение Наименования значением ar_Имя при пустом наименовании.
//
// Справочник - реестр готовых конфигураций агентов (пресетов).

#Область ОбработчикиСобытий

// Платформенный обработчик проверки заполнения реквизитов.
//
// Параметры:
//  Отказ                  - Булево          - флаг отказа от записи.
//  ПроверяемыеРеквизиты   - Массив из Строка - список реквизитов, проверяемых платформой.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Предупреждение о невалидном JSON - не блокирует запись.
	Если ЗначениеЗаполнено(ar_JSON) И Не ar_JSONВалиден(ar_JSON) Тогда
		ТекстПредупреждения = НСтр(
			"ru = 'Внимание: JSON не является валидным. Пресет не может быть импортирован, пока JSON не будет исправлен.';
			|en = 'Warning: JSON is not valid. Preset cannot be imported until JSON is fixed.'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстПредупреждения,
			Ссылка,
			"Объект.ar_JSON");
	КонецЕсли;

	МассивНепроверяемыхРеквизитов = Новый Массив;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(
		ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);

КонецПроцедуры

// Платформенный обработчик перед записью.
//
// Параметры:
//  Отказ - Булево - флаг отказа от записи.
//
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Автозаполнение Наименования значением ar_Имя.
	Если ПустаяСтрока(Наименование) И ЗначениеЗаполнено(ar_Имя) Тогда
		Наименование = ar_Имя;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Простая проверка: является ли строка валидным JSON.
//
// Параметры:
//  Текст - Строка - проверяемый JSON.
//
// Возвращаемое значение:
//  Булево - Истина, если строка парсится как JSON.
//
Функция ar_JSONВалиден(Текст)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Попытка
		ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Результат = Истина;
	Исключение
		// JSON невалиден (или поток нельзя корректно закрыть после невалидных данных) -
		// в обоих случаях фиксируем результат как "невалиден".
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти
