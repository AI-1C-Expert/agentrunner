////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_ПодпискиАгентов (META-35).
//
// Поле "Событие 1С" (ar_Событие1С) - строка со списком выбора: список
// заполняется программно готовыми событиями "горячих" типов EXT-07
// (ar_ОбработчикПодписок.ГорячиеТипы() + ".ПриЗаписи"), при этом ListChoiceMode
// выключен - можно ввести и произвольную строку для типов, опрашиваемых
// регламентным заданием EXT-08 (см. ar_Scheduler.ОбработатьОпросПодписок).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ar_Включён = Истина;
	КонецЕсли;

	ЗаполнитьСписокВыбораСобытий();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список выбора поля "Событие 1С" готовыми событиями горячих типов
// EXT-07. Пользователь может выбрать значение из списка либо ввести своё -
// РежимВыбораИзСписка формы выключен (см. Form.xml, ПолеСобытие1С).
//
&НаСервере
Процедура ЗаполнитьСписокВыбораСобытий()

	// Список фиксирован (не зависит от данных объекта) - заполняется всегда,
	// в том числе при открытии существующей подписки, чтобы список выбора
	// не потерялся между обращениями к серверу.

	СписокВыбора = Элементы.ПолеСобытие1С.СписокВыбора;
	СписокВыбора.Очистить();

	Для Каждого ПолноеИмяТипа Из ar_ОбработчикПодписок.ГорячиеТипы() Цикл
		СписокВыбора.Добавить(ПолноеИмяТипа + ".ПриЗаписи");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
