////////////////////////////////////////////////////////////////////////////////
// Модуль объекта справочника ar_Агенты (Agent Builder).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

// UI-06. Проверяет, что заполненное ar_ИмяРоли1С соответствует существующей
// роли текущей конфигурации (Метаданные.Роли). На форме (ФормаЭлемента) ввод
// уже ограничен выпадающим списком ролей (РежимВыбораИзСписка), поэтому здесь
// страховка для программной записи (импорт, обмен, API, групповая обработка),
// не проходящей через форму.
//
// Пустое значение допустимо - означает "роль не проверяется" (см. RT-10,
// ar_RuntimeЦикл.ПроверитьРольПользователя) и проверку не проходит.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ar_ИмяРоли1С) Тогда
		Если Метаданные.Роли.Найти(ar_ИмяРоли1С) = Неопределено Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Роль с именем ""%1"" не найдена в метаданных конфигурации.';
					|en = 'Role ""%1"" was not found in the configuration metadata.'"),
				ar_ИмяРоли1С);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				ЭтотОбъект,
				"ar_ИмяРоли1С",
				Неопределено,
				Отказ);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
