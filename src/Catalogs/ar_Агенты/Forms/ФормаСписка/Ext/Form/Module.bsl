////////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Агенты (UI-07).
//
// Стандартный динамический список агентов + команда «Запустить сейчас».
// Команда запускает выбранного(-ых) агента(-ов) тем же каноническим путём, что
// и форма элемента (UI-02): ar_RuntimeЗапуск.СтартоватьВФоне(СсылкаАгент,
// {Триггер: "manual"}). Никакой собственной постановки фонового задания, проверки
// роли или дедупликации форма не делает — всё это инкапсулировано в
// ar_RuntimeЗапуск (RT-02) / ar_RuntimeЦикл (RT-10).
//
// Поддержан пакетный запуск: при выборе нескольких строк каждый активный агент
// запускается отдельным вызовом СтартоватьВФоне (отдельный RunId), неактивные
// агенты пропускаются с агрегированным итогом.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ar_ЗапуститьАгента(Команда)

	ВыделенныеСсылки = СобратьВыделенныеСсылки();

	Если ВыделенныеСсылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите агента для запуска.';
			|en = 'Select an agent to run.'"));
		Возврат;
	КонецЕсли;

	Результат = ЗапуститьАгентовНаСервере(ВыделенныеСсылки);
	ОбработатьРезультатЗапуска(Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает массив ссылок выделенных строк динамического списка. Для списка по
// справочнику идентификаторы выделенных строк совпадают со ссылками строк.
// Справочник ar_Агенты нехиерархический (Hierarchical=false), групп в нём нет —
// фильтр оставляет только идентификаторы-ссылки нужного типа.
//
&НаКлиенте
Функция СобратьВыделенныеСсылки()

	Ссылки = Новый Массив;

	Для Каждого ИдентификаторСтроки Из Элементы.Список.ВыделенныеСтроки Цикл
		Если ТипЗнч(ИдентификаторСтроки) = Тип("СправочникСсылка.ar_Агенты") Тогда
			Ссылки.Добавить(ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// Запускает выделенных агентов. Источник истины по активности — запрос к базе
// (не реквизит динамического списка, который мог устареть в кэше). Каждый
// активный агент стартует отдельным вызовом ar_RuntimeЗапуск.СтартоватьВФоне.
//
// Возвращаемое значение:
//  Структура:
//   * Запущено         - Число   - сколько агентов поставлено в фон.
//   * RunIds           - Массив  - идентификаторы успешных запусков.
//   * Неактивные       - Массив  - представления пропущенных неактивных агентов.
//   * Ошибки           - Массив  - строки "<представление>: <причина>".
//
&НаСервере
Функция ЗапуститьАгентовНаСервере(Знач ВыделенныеСсылки)

	Результат = Новый Структура;
	Результат.Вставить("Запущено", 0);
	Результат.Вставить("RunIds", Новый Массив);
	Результат.Вставить("Неактивные", Новый Массив);
	Результат.Вставить("Ошибки", Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Ссылка КАК Ссылка,
		|	Агенты.Наименование КАК Наименование,
		|	Агенты.ar_Активен КАК Активен
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	Агенты.Ссылка В (&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", ВыделенныеСсылки);

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "manual");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если НЕ Выборка.Активен Тогда
			Результат.Неактивные.Добавить(Выборка.Наименование);
			Продолжить;
		КонецЕсли;

		РезультатЗапуска = ar_RuntimeЗапуск.СтартоватьВФоне(Выборка.Ссылка, КонтекстТриггера);

		Если РезультатЗапуска.Успех Тогда
			Результат.Запущено = Результат.Запущено + 1;
			Результат.RunIds.Добавить(РезультатЗапуска.RunId);
		Иначе
			Результат.Ошибки.Добавить(СтрШаблон("%1: %2", Выборка.Наименование, РезультатЗапуска.Причина));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатЗапуска(Знач Результат)

	// Одиночный запуск без проблем — показываем компактное сообщение, идентичное
	// форме элемента (единообразие UX, DoD D6).
	Если Результат.Запущено = 1
		И Результат.Неактивные.Количество() = 0
		И Результат.Ошибки.Количество() = 0 Тогда

		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Агент запущен. RunId: %1';
				|en = 'Agent started. RunId: %1'"),
			Результат.RunIds[0]);
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	КонецЕсли;

	// Единичный неактивный агент — тот же текст, что и в форме элемента.
	Если Результат.Запущено = 0
		И Результат.Неактивные.Количество() = 1
		И Результат.Ошибки.Количество() = 0 Тогда

		ПоказатьПредупреждение(, НСтр("ru = 'Агент неактивен. Установите флажок «Активен» перед запуском.';
			|en = 'Agent is inactive. Set the «Active» flag before running.'"));
		Возврат;
	КонецЕсли;

	// Единичная ошибка запуска — тот же шаблон, что и в форме элемента.
	Если Результат.Запущено = 0
		И Результат.Неактивные.Количество() = 0
		И Результат.Ошибки.Количество() = 1 Тогда

		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Не удалось запустить агента. Причина: %1';
				|en = 'Failed to start the agent. Reason: %1'"),
			Результат.Ошибки[0]));
		Возврат;
	КонецЕсли;

	// Сводный итог пакетного запуска.
	ЧастиСообщения = Новый Массив;
	ЧастиСообщения.Добавить(СтрШаблон(
		НСтр("ru = 'Запущено: %1, пропущено неактивных: %2, ошибок: %3.';
			|en = 'Started: %1, inactive skipped: %2, errors: %3.'"),
		Результат.Запущено, Результат.Неактивные.Количество(), Результат.Ошибки.Количество()));

	Если Результат.Неактивные.Количество() > 0 Тогда
		ЧастиСообщения.Добавить(СтрШаблон(
			НСтр("ru = 'Неактивные: %1';
				|en = 'Inactive: %1'"),
			СтрСоединить(Результат.Неактивные, ", ")));
	КонецЕсли;

	Если Результат.Ошибки.Количество() > 0 Тогда
		ЧастиСообщения.Добавить(СтрШаблон(
			НСтр("ru = 'Ошибки: %1';
				|en = 'Errors: %1'"),
			СтрСоединить(Результат.Ошибки, "; ")));
	КонецЕсли;

	ПоказатьПредупреждение(, СтрСоединить(ЧастиСообщения, Символы.ПС));

КонецПроцедуры

#КонецОбласти
