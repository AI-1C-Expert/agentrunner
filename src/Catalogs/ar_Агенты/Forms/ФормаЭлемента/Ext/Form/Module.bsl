КонецФункции

// Экранирует спецсимволы HTML (тот же контракт, что в ar_Диалог и ar_Настройки).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст,    "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область MarkdownПревью

// Предельная длина инструкции (символов), рендерящаяся в HTML-превью. Текст
// сверх лимита усекается, чтобы не подвешивать документ большим объёмом.
//
&НаКлиентеНаСервереБезКонтекста
Функция МаксДлинаПревью()

	Возврат 20000;

КонецФункции

// Преобразует минимальный subset markdown в HTML-фрагмент для предпросмотра
// инструкции. Поддержано: заголовки H1-H3, **жирный**/__жирный__,
// *курсив*/_курсив_, маркированные (- / *) и нумерованные (N.) списки, `код`,
// абзацы. Спецсимволы экранируются - встроенный HTML в инструкции не исполняется.
//
&НаКлиентеНаСервереБезКонтекста
Функция МаркdownВHTML(Знач ТекстМД)

	ПредельнаяДлина = МаксДлинаПревью();
	Обрезано = Ложь;
	Если СтрДлина(ТекстМД) > ПредельнаяДлина Тогда
		ТекстМД = Лев(ТекстМД, ПредельнаяДлина);
		Обрезано = Истина;
	КонецЕсли;

	Если ПустаяСтрока(ТекстМД) Тогда
		Возврат "<p style=""color:gray"">"
			+ НСтр("ru='Инструкция не введена'; en='No instruction entered'") + "</p>";
	КонецЕсли;

	Строки = СтрРазделить(ТекстМД, Символы.ПС, Истина);

	// Состояние парсера: Фрагменты - накопленный HTML, ВСписке - открытый список.
	Парсер = Новый Структура("Фрагменты, ВСписке", Новый Массив, "");
	Для Каждого Строка Из Строки Цикл
		РазобратьСтрокуMD(Парсер, СокрП(Строка));
	КонецЦикла;
	ЗакрытьСписокЕслиОткрыт(Парсер);

	Если Обрезано Тогда
		Парсер.Фрагменты.Добавить("<p style=""color:red"">"
			+ НСтр("ru='...текст обрезан для превью...'; en='...text truncated for preview...'") + "</p>");
	КонецЕсли;

	Возврат СтрСоединить(Парсер.Фрагменты, "");

КонецФункции

// Разбирает одну markdown-строку и дописывает HTML в Парсер.Фрагменты,
// поддерживая открытый список через Парсер.ВСписке.
//
&НаКлиентеНаСервереБезКонтекста
Процедура РазобратьСтрокуMD(Парсер, Знач Строка)

	Если ПустаяСтрока(Строка) Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Возврат;
	КонецЕсли;

	Если ДобавитьЗаголовокMD(Парсер, Строка) Тогда
		Возврат;
	КонецЕсли;

	Если ДобавитьПунктСпискаMD(Парсер, Строка) Тогда
		Возврат;
	КонецЕсли;

	// Обычный абзац.
	ЗакрытьСписокЕслиОткрыт(Парсер);
	Парсер.Фрагменты.Добавить("<p>" + ВстроенноеФорматирование(Строка) + "</p>");

КонецПроцедуры

// Добавляет заголовок H1-H3, если строка им является. Возвращает Истина,
// если строка обработана как заголовок.
//
&НаКлиентеНаСервереБезКонтекста
Функция ДобавитьЗаголовокMD(Парсер, Знач Строка)

	ДлинаПрефикса3 = 4; // "### "
	ДлинаПрефикса2 = 3; // "## "
	ДлинаПрефикса1 = 2; // "# "

	Если СтрНачинаетсяС(Строка, "### ") Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Парсер.Фрагменты.Добавить("<h3>" + ВстроенноеФорматирование(Сред(Строка, ДлинаПрефикса3 + 1)) + "</h3>");
	ИначеЕсли СтрНачинаетсяС(Строка, "## ") Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Парсер.Фрагменты.Добавить("<h2>" + ВстроенноеФорматирование(Сред(Строка, ДлинаПрефикса2 + 1)) + "</h2>");
	ИначеЕсли СтрНачинаетсяС(Строка, "# ") Тогда
		ЗакрытьСписокЕслиОткрыт(Парсер);
		Парсер.Фрагменты.Добавить("<h1>" + ВстроенноеФорматирование(Сред(Строка, ДлинаПрефикса1 + 1)) + "</h1>");
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Добавляет пункт маркированного или нумерованного списка, открывая список
// нужного типа. Возвращает Истина, если строка обработана как пункт списка.
//
&НаКлиентеНаСервереБезКонтекста
Функция ДобавитьПунктСпискаMD(Парсер, Знач Строка)

	ДлинаМаркераПункта = 2; // "- " / "* "

	Если СтрНачинаетсяС(Строка, "- ") ИЛИ СтрНачинаетсяС(Строка, "* ") Тогда
		ОткрытьСписок(Парсер, "ul");
		Парсер.Фрагменты.Добавить("<li>" + ВстроенноеФорматирование(Сред(Строка, ДлинаМаркераПункта + 1)) + "</li>");
		Возврат Истина;
	КонецЕсли;

	Если ЭтоНумерованныйПункт(Строка) Тогда
		ОткрытьСписок(Парсер, "ol");
		РазделительНумерации = ". ";
		ПозицияТочки = СтрНайти(Строка, РазделительНумерации);
		НачалоТекста = ПозицияТочки + СтрДлина(РазделительНумерации);
		Парсер.Фрагменты.Добавить("<li>" + ВстроенноеФорматирование(Сред(Строка, НачалоТекста)) + "</li>");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Открывает список заданного типа (ul/ol), предварительно закрыв список другого
// типа, если он был открыт.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОткрытьСписок(Парсер, Знач ТипСписка)

	Если Парсер.ВСписке = ТипСписка Тогда
		Возврат;
	КонецЕсли;

	ЗакрытьСписокЕслиОткрыт(Парсер);
	Парсер.Фрагменты.Добавить("<" + ТипСписка + ">");
	Парсер.ВСписке = ТипСписка;

КонецПроцедуры

// Закрывает открытый тег списка (ul/ol), если он был открыт, и сбрасывает
// состояние Парсер.ВСписке.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ЗакрытьСписокЕслиОткрыт(Парсер)

	Если Парсер.ВСписке = "ul" Тогда
		Парсер.Фрагменты.Добавить("</ul>");
	ИначеЕсли Парсер.ВСписке = "ol" Тогда
		Парсер.Фрагменты.Добавить("</ol>");
	Иначе
		// Открытого списка нет - закрывать нечего.
	КонецЕсли;

	Парсер.ВСписке = "";

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоНумерованныйПункт(Знач Строка)

	МинимальнаяПозицияТочки = 2; // хотя бы одна цифра перед разделителем ". "
	ПозицияТочки = СтрНайти(Строка, ". ");
	Если ПозицияТочки < МинимальнаяПозицияТочки Тогда
		Возврат Ложь;
	КонецЕсли;

	Цифры = Лев(Строка, ПозицияТочки - 1);
	Для Индекс = 1 По СтрДлина(Цифры) Цикл
		Символ = Сред(Цифры, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Экранирует спецсимволы и применяет inline-разметку (**жирный**, *курсив*, `код`).
//
&НаКлиентеНаСервереБезКонтекста
Функция ВстроенноеФорматирование(Знач Текст)

	Результат = ar_ЭкранироватьHTML(Текст);

	Результат = ЗаменитьПарныйМаркер(Результат, "**", "<strong>", "</strong>");
	Результат = ЗаменитьПарныйМаркер(Результат, "__", "<strong>", "</strong>");
	Результат = ЗаменитьПарныйМаркер(Результат, "*", "<em>", "</em>");
	Результат = ЗаменитьПарныйМаркер(Результат, "_", "<em>", "</em>");
	Результат = ЗаменитьПарныйМаркер(Результат, "`", "<code>", "</code>");

	Возврат Результат;

КонецФункции

// Заменяет парные вхождения Маркер на открывающий/закрывающий теги. Непарный
// остаток маркера оставляется как есть.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьПарныйМаркер(Знач Текст, Знач Маркер, Знач ОткрывающийТег, Знач ЗакрывающийТег)

	Результат = "";
	Остаток = Текст;
	Открыт = Ложь;

	ПозицияМаркера = СтрНайти(Остаток, Маркер);
	Пока ПозицияМаркера > 0 Цикл
		Результат = Результат + Лев(Остаток, ПозицияМаркера - 1);
		Если Открыт Тогда
			Результат = Результат + ЗакрывающийТег;
		Иначе
			Результат = Результат + ОткрывающийТег;
		КонецЕсли;
		Открыт = НЕ Открыт;
		Остаток = Сред(Остаток, ПозицияМаркера + СтрДлина(Маркер));
		ПозицияМаркера = СтрНайти(Остаток, Маркер);
	КонецЦикла;

	Результат = Результат + Остаток;

	// Непарный маркер: возвращаем исходный текст, чтобы не оставить висячий тег.
	Если Открыт Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ДанныеДляОтображения

// Соответствие "ВРег(имя tool) → сведения из реестра ar_Tools" для отрисовки
// таблицы инструментов одним запросом.
//
// Возвращаемое значение:
//   Соответствие; значение - Структура:
//     * Имя                    - Строка - ar_Имя в исходном регистре (SCALE-08,
//                                для рендеринга <option value>, ключ карты - ВРег(Имя)).
//     * RiskLevel              - Строка - имя значения перечисления ("Read"...)
//     * RiskLevelПредставление - Строка - синоним перечисления
//     * ТребуетApproval        - Булево
//     * Описание               - Строка
//
&НаСервере
Функция КартаToolsРеестра()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_RiskLevel КАК RiskLevel,
		|	Tools.ar_ТребуетApproval КАК ТребуетApproval,
		|	Tools.ar_Описание КАК Описание
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Сведения = Новый Структура;
		Сведения.Вставить("Имя", Выборка.Имя);
		Сведения.Вставить("RiskLevel", ИмяЗначенияПеречисленияRiskLevel(Выборка.RiskLevel));
		Сведения.Вставить("RiskLevelПредставление", Строка(Выборка.RiskLevel));
		Сведения.Вставить("ТребуетApproval", Выборка.ТребуетApproval);
		Сведения.Вставить("Описание", Выборка.Описание);
		Карта.Вставить(ВРег(Выборка.Имя), Сведения);
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Возвращает строковое имя значения перечисления ar_RiskLevel
// ("Read"/"Draft"/"Write"/"Commit") либо "unknown" для пустого/неизвестного.
//
&НаСервере
Функция ИмяЗначенияПеречисленияRiskLevel(Знач ЗначениеПеречисления)

	Если ЗначениеПеречисления = Перечисления.ar_RiskLevel.Read Тогда
		Возврат "Read";
	ИначеЕсли ЗначениеПеречисления = Перечисления.ar_RiskLevel.Draft Тогда
		Возврат "Draft";
	ИначеЕсли ЗначениеПеречисления = Перечисления.ar_RiskLevel.Write Тогда
		Возврат "Write";
	ИначеЕсли ЗначениеПеречисления = Перечисления.ar_RiskLevel.Commit Тогда
		Возврат "Commit";
	КонецЕсли;

	Возврат "unknown";

КонецФункции

// Рутины текущего агента для вкладки «Расписание».
//
// Возвращаемое значение:
//   Массив из Структур { Ид, Имя, ТипТриггера, Активна, ПараметрыJSON }.
//
&НаСервере
Функция РутиныАгента()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Рутины.Ссылка КАК Ссылка,
		|	Рутины.ar_Имя КАК Имя,
		|	Рутины.ar_ТипТриггера КАК ТипТриггера,
		|	Рутины.ar_Активна КАК Активна,
		|	Рутины.ar_ПараметрыJSON КАК ПараметрыJSON
		|ИЗ
		|	Справочник.ar_Рутины КАК Рутины
		|ГДЕ
		|	Рутины.ar_Агент = &Агент
		|	И НЕ Рутины.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Имя";
	Запрос.УстановитьПараметр("Агент", Объект.Ссылка);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Ид", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("Имя", Выборка.Имя);
		Элемент.Вставить("ТипТриггера", Выборка.ТипТриггера);
		Элемент.Вставить("Активна", Выборка.Активна);
		Элемент.Вставить("ПараметрыJSON", Выборка.ПараметрыJSON);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Последние записи памяти текущего агента для вкладки «Память» (UI-18).
//
// Возвращаемое значение:
//   Массив из Структур { Ид, Тип, Текст, КлючевыеСлова, Обновлено, Источник }.
//
&НаСервере
Функция ПамятьАгента()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Память.Ссылка КАК Ссылка,
		|	Память.ar_Тип КАК Тип,
		|	Память.ar_Текст КАК Текст,
		|	Память.ar_КлючевыеСлова КАК КлючевыеСлова,
		|	Память.ar_Обновлено КАК Обновлено,
		|	Память.ar_Источник КАК Источник
		|ИЗ
		|	Справочник.ar_ПамятьАгента КАК Память
		|ГДЕ
		|	Память.ar_Агент = &Агент
		|	И НЕ Память.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Обновлено УБЫВ";
	Запрос.УстановитьПараметр("Агент", Объект.Ссылка);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Ид", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("Тип", Выборка.Тип);
		Элемент.Вставить("Текст", Выборка.Текст);
		Элемент.Вставить("КлючевыеСлова", Выборка.КлючевыеСлова);
		Элемент.Вставить("Обновлено", Выборка.Обновлено);
		Элемент.Вставить("Источник", Выборка.Источник);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает имя действия из служебной ссылки "1c://<действие>?<параметры>".
//
&НаКлиентеНаСервереБезКонтекста
Функция ДействиеИзСсылки(Знач Ссылка)

	Тело = Сред(Ссылка, СтрДлина("1c://") + 1);
	ПозицияВопроса = СтрНайти(Тело, "?");
	Если ПозицияВопроса > 0 Тогда
		Тело = Лев(Тело, ПозицияВопроса - 1);
	КонецЕсли;
	Возврат СокрЛП(Тело);

КонецФункции

// Разбирает query-параметры служебной ссылки в структуру { имя -> значение }.
// URL-декодирование не применяется: в ссылках передаются только служебные
// идентификаторы (имена вкладок, индексы строк, UUID) без спецсимволов,
// пробелов и %-последовательностей. Значения полей ввода через ссылку не
// передаются - они читаются из DOM в СобратьВводИзDOM.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыИзСсылки(Знач Ссылка)

	Результат = Новый Структура;
	ПозицияВопроса = СтрНайти(Ссылка, "?");
	Если ПозицияВопроса = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = Сред(Ссылка, ПозицияВопроса + 1);
	Пары = СтрРазделить(Хвост, "&", Ложь);
	Для Каждого Пара Из Пары Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Пара, ПозицияРавно - 1);
		Значение = Сред(Пара, ПозицияРавно + 1);
		Если Не ПустаяСтрока(Имя) Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Приводит строковое значение к числу (терпимо к пробелам, запятой, пустоте).
//
&НаСервереБезКонтекста
Функция ПривестиКЧислу(Знач Значение)

	Строка = СокрЛП("" + Значение);
	Строка = СтрЗаменить(Строка, " ", "");
	Строка = СтрЗаменить(Строка, ",", ".");
	Если ПустаяСтрока(Строка) Тогда
		Возврат 0;
	КонецЕсли;
	ОписаниеТипов = Новый ОписаниеТипов("Число");
	Возврат ОписаниеТипов.ПривестиЗначение(Строка);

КонецФункции

// Человекочитаемое сообщение об ошибке разбора пресета по коду причины.
//
&НаКлиенте
Функция ТекстОшибкиРазбораПресета(Знач Причина)

	Если Причина = "wrong_kind" Тогда
		Возврат НСтр("ru='Файл не является пресетом инструментов агента (неверный kind).';
			|en='File is not an agent tools preset (wrong kind).'");
	ИначеЕсли Причина = "unsupported_version" Тогда
		Возврат НСтр("ru='Версия пресета не поддерживается. Обновите конфигурацию.';
			|en='Preset version is not supported. Update the configuration.'");
	ИначеЕсли Причина = "no_tools" Тогда
		Возврат НСтр("ru='В пресете нет ни одного корректного инструмента.';
			|en='The preset contains no valid tools.'");
	ИначеЕсли Причина = "tool_code_import_forbidden" Тогда
		Возврат НСтр("ru='Импорт запрещён: пресет содержит код реализации tool (code_implementation). Режим «Код» настраивается только вручную в карточке инструмента.';
			|en='Import forbidden: the preset contains tool implementation code (code_implementation). ""Code"" mode can only be set manually in the tool card.'");
	КонецЕсли;

	Возврат НСтр("ru='Файл не является корректным JSON-пресетом.';
		|en='File is not a valid JSON preset.'");

КонецФункции

// Максимальная поддерживаемая версия формата пресета. При импорте файла с
// более высокой версией импорт отклоняется (forward-compatibility guard).
//
&НаКлиентеНаСервереБезКонтекста
Функция МаксПоддерживаемаяВерсияПресета()

	Возврат 1;

КонецФункции

#КонецОбласти
