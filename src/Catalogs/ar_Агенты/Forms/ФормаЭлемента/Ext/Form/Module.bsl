////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_Агенты (Agent Builder) - UI-02, HTML-редизайн.
//
// Вся форма - одно поле ПолеHTMLДокумента (ПолеHTMLАгент), в котором сервер
// собирает карточку агента с вкладками: «Основное», «Инструкция», «Tools»,
// «Расписание», «LLM», «Память», «Тест». Паттерн отрисовки и обратной связи -
// тот же, что в ОбщаяФорма.ar_Настройки и ОбщаяФорма.ar_Диалог:
//
//  - интерактивные элементы - ссылки вида "1c://<действие>?<параметры>";
//    клик приходит в ПолеHTMLАгентПриНажатии через ДанныеСобытия.Href
//    (эталон БСП ВзаимодействияКлиент.ПолеHTMLПриНажатии), стандартная
//    обработка подавляется, BSL разбирает схему и выполняет действие;
//  - значения полей ввода читаются из DOM (Элементы.ПолеHTMLАгент.Документ),
//    что работает в толстом/тонком клиенте; в веб-клиенте DOM-доступ
//    деградирует, поэтому чтение обёрнуто в Попытку;
//  - перед каждым действием, перерисовывающим HTML, введённые значения
//    снимаются из DOM и применяются к Объекту (СобратьВводИзDOM +
//    ПрименитьВводНаСервере), чтобы ввод не терялся при перерисовке.
//
// Функциональность прежней вкладочной формы сохранена: запуск агента,
// тестовый запуск с dry-run (UI-05), перевыпуск токена (SEC-03/SEC-05),
// предпросмотр prompt, подбор/импорт/экспорт tools (UI-04), память и skills
// (UI-18), рутины расписания (UI-20). Значение токена нигде не отображается -
// только UUID-идентификатор и статус «задан/не задан».
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ветка автотеста: при программном открытии формы тестами пропускаем
	// инициализацию (паттерн catalog_form_on_create, как в UI-01).
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ТекущаяВкладка = "main";
	DryRun = Ложь;
	ПоследнийRunId = "";
	СтатусПоследнегоЗапуска = "";
	ФильтрRiskLevel = "";
	ФильтрКатегория = "";
	ФильтрПакет = "";
	ПредпросмотрНабораАктивен = Ложь;

	Если НЕ ПравоДоступа("Изменение", Метаданные.Справочники.ar_Агенты) Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

	// Значения по умолчанию для новой записи.
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ar_Активен = Истина;
		Объект.ar_Температура = 0.7;
		Объект.ar_МаксШагов = ar_Константы.МаксШагов();
		Объект.ar_РежимАвтономии = Перечисления.ar_РежимАвтономии.Manual;
	КонецЕсли;

	ОбновитьВидимостьТаблицыПравил();
	ПерерисоватьКарточку();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ПерерисоватьКарточку(НСтр("ru='Записано ✓'; en='Saved ✓'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Обрабатывает клик по любому элементу внутри HTML-карточки агента.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент             - ПолеФормы - поле ПолеHTMLАгент.
//  ДанныеСобытия       - ФиксированнаяСтруктура - данные DOM-события клика
//                        (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                        открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLАгентПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	// Дальше ссылку обрабатываем сами.
	СтандартнаяОбработка = Ложь;

	Действие = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	// Перед любым действием снимаем введённые значения из DOM, чтобы
	// перерисовка HTML не потеряла незафиксированный ввод пользователя.
	ЗначенияВвода = СобратьВводИзDOM();

	Если Действие = "tab" Тогда
		ПереключитьВкладку(ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "refresh" Тогда
		ПрименитьИПерерисовать(ЗначенияВвода);
	ИначеЕсли Действие = "save" Тогда
		СохранитьАгента(ЗначенияВвода, Ложь);
	ИначеЕсли Действие = "save-close" Тогда
		СохранитьАгента(ЗначенияВвода, Истина);
	ИначеЕсли Действие = "toggle" Тогда
		ОбработатьПереключение(ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "rotate-token" Тогда
		НачатьПеревыпускТокена(ЗначенияВвода);
	ИначеЕсли Действие = "run-agent" Тогда
		ЗапуститьАгента(ЗначенияВвода);
	ИначеЕсли Действие = "test-run" Тогда
		ВыполнитьТестовыйЗапуск(ЗначенияВвода);
	ИначеЕсли Действие = "show-prompt" Тогда
		ПоказатьPrompt(ЗначенияВвода);
	ИначеЕсли Действие = "open-run" Тогда
		ОткрытьRunViewer();
	ИначеЕсли Действие = "pick-user" Тогда
		ВыбратьСсылку(ЗначенияВвода, "user", "Справочник.Пользователи.ФормаВыбора");
	ИначеЕсли Действие = "pick-provider" Тогда
		ВыбратьСсылку(ЗначенияВвода, "provider", "Справочник.ar_LLMПровайдеры.ФормаВыбора");
	ИначеЕсли Действие = "add-tools" Тогда
		НачатьПодборTools(ЗначенияВвода);
	ИначеЕсли Действие = "toggle-tool" Тогда
		ВыполнитьДействиеСтроки("toggle-tool", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "remove-tool" Тогда
		ВыполнитьДействиеСтроки("remove-tool", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "rule-add" Тогда
		ВыполнитьДействиеСтроки("rule-add", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "rule-del" Тогда
		ВыполнитьДействиеСтроки("rule-del", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "preview-toggle" Тогда
		ПереключитьПредпросмотрНабора(ЗначенияВвода);
	ИначеЕсли Действие = "export-preset" Тогда
		ЭкспортироватьПресетTools(ЗначенияВвода);
	ИначеЕсли Действие = "import-preset" Тогда
		ИмпортироватьПресетTools(ЗначенияВвода);
	ИначеЕсли Действие = "kv-add" Тогда
		ВыполнитьДействиеСтроки("kv-add", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "kv-del" Тогда
		ВыполнитьДействиеСтроки("kv-del", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "skill-add" Тогда
		НачатьПодборSkill(ЗначенияВвода);
	ИначеЕсли Действие = "skill-toggle" Тогда
		ВыполнитьДействиеСтроки("skill-toggle", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "skill-del" Тогда
		ВыполнитьДействиеСтроки("skill-del", ПараметрыСсылки, ЗначенияВвода);
	ИначеЕсли Действие = "mem-add" Тогда
		ДобавитьЗаписьПамяти(ЗначенияВвода);
	ИначеЕсли Действие = "mem-open" Тогда
		ОткрытьЭлементПоИд(ПараметрыСсылки, "memory");
	ИначеЕсли Действие = "rt-add" Тогда
		ДобавитьРутину(ЗначенияВвода);
	ИначеЕсли Действие = "rt-open" Тогда
		ОткрытьЭлементПоИд(ПараметрыСсылки, "routine");
	ИначеЕсли Действие = "rt-del" Тогда
		НачатьУдалениеРутины(ПараметрыСсылки, ЗначенияВвода);
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЧтениеВводаИзDOM

// Читает значение элемента input/textarea/select по id из DOM HTML-документа.
// Возвращает Неопределено, если DOM-доступ недоступен (веб-клиент) или элемент
// не найден.
//
&НаКлиенте
Функция ПрочитатьЗначениеИзDOM(Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLАгент.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЭлементВвода.value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Снимает значения всех полей ввода текущей вкладки из DOM.
//
// Возвращаемое значение:
//  Массив из Структур { Ид - Строка, Значение - Строка }.
//
&НаКлиенте
Функция СобратьВводИзDOM()

	Значения = Новый Массив;

	Для Каждого Ид Из СтатическиеИдентификаторыВвода(ТекущаяВкладка) Цикл
		Значение = ПрочитатьЗначениеИзDOM(Ид);
		Если Значение <> Неопределено Тогда
			Значения.Добавить(Новый Структура("Ид, Значение", Ид, "" + Значение));
		КонецЕсли;
	КонецЦикла;

	// Динамические ряды: переопределения промпта (kvk_N/kvv_N) и порядок skills (ord_N).
	Если ТекущаяВкладка = "llm" Тогда
		ДобавитьЗначенияРядов(Значения, "kvk_");
		ДобавитьЗначенияРядов(Значения, "kvv_");
	ИначеЕсли ТекущаяВкладка = "memory" Тогда
		ДобавитьЗначенияРядов(Значения, "ord_");
	ИначеЕсли ТекущаяВкладка = "rules" Тогда
		// SCALE-08: тип критерия (rt_N), значение критерия (rv_N, зависит от
		// типа - select или input), флаг "разрешить" (ra_N) и порядок (ro_N)
		// каждой строки ar_ПравилаДоступаTools, отрисованной HTML-таблицей.
		ДобавитьЗначенияРядов(Значения, "rt_");
		ДобавитьЗначенияРядов(Значения, "rv_");
		ДобавитьЗначенияРядов(Значения, "ra_");
		ДобавитьЗначенияРядов(Значения, "ro_");
	КонецЕсли;

	Возврат Значения;

КонецФункции

// Идентификаторы «одиночных» полей ввода вкладки (для чтения из DOM).
//
&НаКлиенте
Функция СтатическиеИдентификаторыВвода(Знач Вкладка)

	Иды = Новый Массив;
	Если Вкладка = "main" Тогда
		Иды.Добавить("fld_name");
		Иды.Добавить("sel_role");
		Иды.Добавить("sel_autonomy");
	ИначеЕсли Вкладка = "instr" Тогда
		Иды.Добавить("fld_instruction");
	ИначеЕсли Вкладка = "llm" Тогда
		Иды.Добавить("fld_model");
		Иды.Добавить("fld_temp");
		Иды.Добавить("fld_maxsteps");
		Иды.Добавить("fld_maxactions");
		Иды.Добавить("fld_maxsum");
	ИначеЕсли Вкладка = "tools" Тогда
		Иды.Добавить("sel_riskfilter");
		Иды.Добавить("sel_catfilter");
		Иды.Добавить("sel_pkgfilter");
	ИначеЕсли Вкладка = "test" Тогда
		Иды.Добавить("fld_testreq");
	КонецЕсли;

	Возврат Иды;

КонецФункции

// Читает пронумерованный ряд полей "<Префикс>0", "<Префикс>1", ... до первого
// отсутствующего и дописывает найденные значения в массив.
//
&НаКлиенте
Процедура ДобавитьЗначенияРядов(Значения, Знач Префикс)

	МаксРядов = 200; // защита от бесконечного цикла при повреждённом DOM
	Для Индекс = 0 По МаксРядов Цикл
		Ид = Префикс + Формат(Индекс, "ЧГ=0");
		Значение = ПрочитатьЗначениеИзDOM(Ид);
		Если Значение = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Значения.Добавить(Новый Структура("Ид, Значение", Ид, "" + Значение));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область КлиентскиеДействия

&НаКлиенте
Процедура ПереключитьВкладку(ПараметрыСсылки, ЗначенияВвода)

	ИмяВкладки = "";
	ПараметрыСсылки.Свойство("name", ИмяВкладки);
	Если ПустаяСтрока(ИмяВкладки) Тогда
		Возврат;
	КонецЕсли;

	ПереключитьВкладкуНаСервере(ИмяВкладки, ЗначенияВвода);

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИПерерисовать(ЗначенияВвода)

	ПрименитьВводИПерерисоватьНаСервере(ЗначенияВвода);

КонецПроцедуры

// Записывает агента: применяет ввод из DOM и вызывает штатную запись формы.
// Перерисовка происходит в ПослеЗаписиНаСервере.
//
&НаКлиенте
Процедура СохранитьАгента(ЗначенияВвода, ЗакрытьПослеЗаписи)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если НЕ Записать() Тогда
		// Запись не прошла (проверка заполнения и т.п.) - показать текущее состояние.
		ПрименитьВводИПерерисоватьНаСервере(Новый Массив,
			НСтр("ru='Не записано - проверьте заполнение'; en='Not saved - check the fields'"));
		Возврат;
	КонецЕсли;

	Если ЗакрытьПослеЗаписи Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

// Открывает/закрывает блок предпросмотра эффективного набора tools (SCALE-08,
// часть 2). При открытии для несохранённого агента или агента с несохранёнными
// правками формы сперва выполняет запись (тот же паттерн, что ЗапуститьАгента/
// ВыполнитьТестовыйЗапуск) - набор считается ЧЕРЕЗ БАЗУ
// (ar_ToolAccessRules.ЭффективныйНаборTools делает Запрос), поэтому без
// предварительной записи предпросмотр показал бы устаревшие данные.
//
&НаКлиенте
Процедура ПереключитьПредпросмотрНабора(ЗначенияВвода)

	// Намерение фиксируется ДО ПрименитьВводНаСервере: правки строк правил
	// (rt_/rv_/ra_/ro_) в ЗначенияВвода сбрасывают ПредпросмотрНабораАктивен
	// как побочный эффект (см. ПрименитьВвод) - если это сделать после,
	// клик "Скрыть предпросмотр" при наличии таких полей ошибочно откроет
	// его заново вместо того чтобы закрыть.
	Открываем = НЕ ПредпросмотрНабораАктивен;

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если НЕ Открываем Тогда
		// Закрытие - без записи, чтобы случайный клик "Скрыть предпросмотр"
		// не заставлял пользователя сохранять ещё не готовые правки.
		ПредпросмотрНабораАктивен = Ложь;
		ПерерисоватьКарточку();
		Возврат;
	КонецЕсли;

	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если НЕ Записать() Тогда
			Возврат; // Запись не прошла - предпросмотр не открываем, пользователь видит стандартную ошибку заполнения.
		КонецЕсли;
	КонецЕсли;

	ПредпросмотрНабораАктивен = Истина;
	ПерерисоватьКарточку();

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПереключение(ПараметрыСсылки, ЗначенияВвода)

	Ключ = "";
	ПараметрыСсылки.Свойство("key", Ключ);
	Если ПустаяСтрока(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Если Ключ = "dryrun" Тогда
		DryRun = НЕ DryRun;
		ПрименитьВводИПерерисоватьНаСервере(ЗначенияВвода);
	Иначе
		ПереключитьФлагНаСервере(Ключ, ЗначенияВвода);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьПеревыпускТокена(ЗначенияВвода)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Сначала запишите агента.'; en='Save the agent first.'"));
		Возврат;
	КонецЕсли;

	ПрименитьВводНаСервере(ЗначенияВвода);

	Оповещение = Новый ОписаниеОповещения("ПеревыпуститьТокенЗавершение", ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение,
		НСтр("ru='Текущий токен будет инвалидирован немедленно. Продолжить?';
			|en='Current token will be immediately invalidated. Continue?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПеревыпуститьТокенЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ПеревыпуститьТокенНаСервере();

	ПоказатьПредупреждение(, НСтр("ru='Токен перевыпущен. Прежнее значение более недействительно.';
		|en='Token has been rotated. The previous value is no longer valid.'"));

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьАгента(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если НЕ Объект.ar_Активен Тогда
		ПоказатьПредупреждение(, НСтр("ru='Агент неактивен. Включите флажок «Активен» перед запуском.';
			|en='Agent is inactive. Set the «Active» flag before running.'"));
		Возврат;
	КонецЕсли;

	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если НЕ Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Результат = ЗапуститьАгентаНаСервере(Объект.Ссылка);

	Если Результат.Успех Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Агент запущен. RunId: %1'; en='Agent started. RunId: %1'"), Результат.RunId);
	Иначе
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось запустить агента. Причина: %1';
				|en='Failed to start the agent. Reason: %1'"),
			Результат.Причина);
	КонецЕсли;

	ПоказатьПредупреждение(, ТекстСообщения);

КонецПроцедуры

// Тестовый запуск с вкладки «Тест» (UI-05). Текст запроса и режим dry-run
// уже сняты из DOM/переключателя; статус и RunId отображаются в HTML-панели
// результата после перерисовки.
//
&НаКлиенте
Процедура ВыполнитьТестовыйЗапуск(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если ПустаяСтрока(ТестовыйЗапрос) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Введите текст запроса.'; en='Enter the request text.'"));
		Возврат;
	КонецЕсли;

	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если НЕ Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Результат = ТестовыйЗапускНаСервере(Объект.Ссылка, ТестовыйЗапрос, DryRun);
	ОбработатьРезультатТестовогоЗапуска(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатТестовогоЗапуска(Результат)

	Если Результат.Успех Тогда

		ПоследнийRunId = Результат.RunId;
		Если DryRun Тогда
			СтатусПоследнегоЗапуска = НСтр("ru='Dry-run запущен'; en='Dry-run started'");
		Иначе
			СтатусПоследнегоЗапуска = НСтр("ru='Агент запущен'; en='Agent started'");
		КонецЕсли;

		ПрименитьВводИПерерисоватьНаСервере(Новый Массив, СтатусПоследнегоЗапуска);

		ПоказатьОповещениеПользователя(
			СтатусПоследнегоЗапуска,
			,
			СтрШаблон(НСтр("ru='RunId: %1'; en='RunId: %1'"), ПоследнийRunId),
			,
			СтатусОповещенияПользователя.Информация);

	Иначе

		ПоследнийRunId = "";
		СтатусПоследнегоЗапуска = СтрШаблон(
			НСтр("ru='Ошибка: %1'; en='Error: %1'"), Результат.Причина);
		ПрименитьВводИПерерисоватьНаСервере(Новый Массив);

		// Поведение UI-02 для ошибочного случая сохранено - модальное предупреждение.
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru='Не удалось запустить агента. Причина: %1';
				|en='Failed to start the agent. Reason: %1'"),
			Результат.Причина));

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьPrompt(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Сначала запишите агента.'; en='Save the agent first.'"));
		Возврат;
	КонецЕсли;

	РезультатSrv = ПостроитьPromptНаСервере(Объект.Ссылка);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстPrompt", РезультатSrv.ТекстPrompt);
	ПараметрыФормы.Вставить("СистемныйPrompt", РезультатSrv.СистемныйPrompt);
	ПараметрыФормы.Вставить("ИнструкцияPrompt", РезультатSrv.ИнструкцияPrompt);
	ПараметрыФормы.Вставить("ИмяМодели", РезультатSrv.ИмяМодели);
	ОткрытьФорму("ОбщаяФорма.ar_ФормаПросмотраPrompt", ПараметрыФормы, ЭтотОбъект,
		, , , , РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьRunViewer()

	Если ПустаяСтрока(ПоследнийRunId) Тогда
		// Ссылка не рендерится при пустом RunId - тихий выход на случай прямого вызова.
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("RunId", ПоследнийRunId);

	Попытка
		ОткрытьФорму("ОбщаяФорма.ar_ПросмотрЗапуска", ПараметрыФормы, ЭтотОбъект);
	Исключение
		// Форма Run Viewer (UI-10) может быть не установлена в базе - не падаем.
		ПоказатьПредупреждение(, НСтр("ru='Форма Run Viewer недоступна.';
			|en='The Run Viewer form is unavailable.'"));
	КонецПопытки;

КонецПроцедуры

// Выбор ссылочного реквизита (пользователь / LLM-провайдер) через стандартный
// диалог выбора. Вид реквизита передаётся в дополнительных параметрах оповещения.
//
&НаКлиенте
Процедура ВыбратьСсылку(ЗначенияВвода, Знач ВидСсылки, Знач ИмяФормыВыбора)

	ПрименитьВводНаСервере(ЗначенияВвода);

	ДополнительныеПараметры = Новый Структура("ВидСсылки", ВидСсылки);
	Оповещение = Новый ОписаниеОповещения("ВыборСсылкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);

	// РежимВыбора + ЗакрытьПриВыборе обязательны, иначе форма списка открывается
	// в обычном режиме просмотра и не возвращает выбранное значение в оповещение.
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрытьПриВыборе", Истина);

	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормыВыбора, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборСсылкиЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьСсылкуНаСервере(ДополнительныеПараметры.ВидСсылки, ВыбранноеЗначение);

КонецПроцедуры

// Подбор инструментов из реестра ar_Tools (множественный выбор) с учётом
// фильтра risk_level, выбранного на вкладке «Tools».
//
&НаКлиенте
Процедура НачатьПодборTools(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);

	// SCALE-08, часть 1б: фильтр RiskLevel дополнен категорией и пакетом - та же
	// структура Отбор, расширяем её, не переписывая (спека, «Граничные случаи»).
	Отбор = Новый Структура;
	Если НЕ ПустаяСтрока(ФильтрRiskLevel) Тогда
		Отбор.Вставить("ar_RiskLevel", ЗначениеRiskLevelНаСервере(ФильтрRiskLevel));
	КонецЕсли;
	Если НЕ ПустаяСтрока(ФильтрКатегория) Тогда
		Отбор.Вставить("ar_Категория", ФильтрКатегория);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ФильтрПакет) Тогда
		Отбор.Вставить("ar_ИдентификаторПакета", ФильтрПакет);
	КонецЕсли;
	Если Отбор.Количество() > 0 Тогда
		ПараметрыФормыВыбора.Вставить("Отбор", Отбор);
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораToolsЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.ar_Tools.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект,
		, , , Оповещение);

КонецПроцедуры

// Завершение подбора инструментов из реестра ar_Tools. Добавляет выбранные
// элементы в ТЧ без дублей по имени tool (ar_Tool - строка ar_Имя, не ссылка,
// контракт META-12/UI-04). Включает добавленные строки по умолчанию.
//
&НаКлиенте
Процедура ПослеВыбораToolsЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыбранныеЭлементы = Новый Массив;
	Если ТипЗнч(РезультатВыбора) = Тип("Массив") Тогда
		ВыбранныеЭлементы = РезультатВыбора;
	Иначе
		ВыбранныеЭлементы.Добавить(РезультатВыбора);
	КонецЕсли;

	Добавлено = ДобавитьВыбранныеToolsНаСервере(ВыбранныеЭлементы);

	Если Добавлено = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru='Выбранные инструменты уже добавлены';
			|en='Selected tools are already added'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьПресетTools(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если Объект.ar_ДоступныеTools.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Список Tools пуст - нечего экспортировать.';
			|en='Tools list is empty - nothing to export.'"));
		Возврат;
	КонецЕсли;

	ДанныеЭкспорта = СформироватьПресетJSON();

	// Сохранение через платформенный диалог получения файла из временного
	// хранилища: работает на тонком/веб-клиенте, расширение работы с файлами
	// запрашивается платформой автоматически только при необходимости.
	ПередаваемыйФайл = Новый ОписаниеПередаваемогоФайла(
		ДанныеЭкспорта.ИмяФайла, ДанныеЭкспорта.АдресХранилища);
	ОписаниеПередаваемогоФайла = Новый Массив;
	ОписаниеПередаваемогоФайла.Добавить(ПередаваемыйФайл);

	Оповещение = Новый ОписаниеОповещения("ПослеСохраненияПресета", ЭтотОбъект,
		ДанныеЭкспорта.АдресХранилища);

	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru='Сохранить пресет инструментов';
		|en='Save tools preset'");
	ПараметрыДиалога.Фильтр = "JSON (*.json)|*.json";
	ПараметрыДиалога.Интерактивно = Истина;

	НачатьПолучениеФайлов(Оповещение, ОписаниеПередаваемогоФайла, ПараметрыДиалога);

КонецПроцедуры

// Завершение интерактивного сохранения файла пресета. Очищает временное
// хранилище и уведомляет об успехе, если файл действительно сохранен.
//
&НаКлиенте
Процедура ПослеСохраненияПресета(ПолученныеФайлы, АдресХранилища) Экспорт

	Если ЗначениеЗаполнено(АдресХранилища) Тогда
		УдалитьИзВременногоХранилищаНаСервере(АдресХранилища);
	КонецЕсли;

	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		// Пользователь отменил сохранение - тихий выход.
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru='Пресет сохранен'; en='Preset saved'"));

КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьПресетTools(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайлаПресета", ЭтотОбъект);
	Интерактивно = Истина;
	НачатьПомещениеФайла(Оповещение, , , Интерактивно, УникальныйИдентификатор);

КонецПроцедуры

// Завершение выбора файла пресета для импорта. Читает JSON на сервере,
// валидирует формат, при успехе предлагает режим загрузки (Заменить / Добавить).
//
&НаКлиенте
Процедура ПослеВыбораФайлаПресета(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено ИЛИ НЕ ПомещенныйФайл.Получен Тогда
		// Пользователь отменил выбор файла - тихий выход.
		Возврат;
	КонецЕсли;

	РазборПресета = РазобратьПресетJSON(ПомещенныйФайл.Адрес);
	УдалитьИзВременногоХранилищаНаСервере(ПомещенныйФайл.Адрес);

	Если НЕ РазборПресета.Успех Тогда
		ПоказатьПредупреждение(, ТекстОшибкиРазбораПресета(РазборПресета.Причина));
		Возврат;
	КонецЕсли;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Заменить", НСтр("ru='Заменить'; en='Replace'"));
	Кнопки.Добавить("Добавить", НСтр("ru='Добавить'; en='Merge'"));
	Кнопки.Добавить("Отмена", НСтр("ru='Отмена'; en='Cancel'"));

	ТекстВопроса = СтрШаблон(
		НСтр("ru='Будет загружено %1 инструментов (%2 включенных). Выберите режим:';
			|en='About to load %1 tools (%2 enabled). Choose the mode:'"),
		РазборПресета.ВсегоTools, РазборПресета.ВключенныхTools);

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораРежимаИмпорта", ЭтотОбъект, РазборПресета);
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);

КонецПроцедуры

// Применяет импорт пресета в выбранном режиме (Заменить / Добавить),
// предупреждает о tools, не найденных в реестре.
//
&НаКлиенте
Процедура ПослеВыбораРежимаИмпорта(РезультатВопроса, РазборПресета) Экспорт

	Если РезультатВопроса = Неопределено ИЛИ РезультатВопроса = "Отмена" Тогда
		Возврат;
	КонецЕсли;

	Заменять = (РезультатВопроса = "Заменить");
	НеНайденные = ПрименитьПресетНаСервере(РазборПресета.Tools, Заменять);

	Если НеНайденные.Количество() > 0 Тогда
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru='Следующие инструменты не найдены в реестре ar_Tools и добавлены как есть
				|(могут быть недоступны до установки соответствующего расширения):
				|%1';
				|en='The following tools were not found in the ar_Tools registry and added as is
				|(may be unavailable until the corresponding extension is installed):
				|%1'"),
			СтрСоединить(НеНайденные, ", "));
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;

КонецПроцедуры

// Подбор skill из реестра ar_Skills (множественный выбор) для ТЧ
// ar_ПодключённыеSkills (UI-18).
//
&НаКлиенте
Процедура НачатьПодборSkill(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина);

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораSkillsЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.ar_Skills.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект,
		, , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораSkillsЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыбранныеЭлементы = Новый Массив;
	Если ТипЗнч(РезультатВыбора) = Тип("Массив") Тогда
		ВыбранныеЭлементы = РезультатВыбора;
	Иначе
		ВыбранныеЭлементы.Добавить(РезультатВыбора);
	КонецЕсли;

	ДобавитьВыбранныеSkillsНаСервере(ВыбранныеЭлементы);

КонецПроцедуры

// UI-18. Открывает форму элемента ar_ПамятьАгента с предзаполненными полями
// ar_Агент (текущий агент) и ar_Источник = "manual". После закрытия формы
// карточка перерисовывается, чтобы показать новую запись.
//
&НаКлиенте
Процедура ДобавитьЗаписьПамяти(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		// Граничный случай: агент ещё не записан - ссылка не рендерится,
		// но на случай прямого вызова тихо выходим.
		Возврат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ar_Агент", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("ar_Источник", "manual");

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы", ЭтотОбъект);
	ОткрытьФорму("Справочник.ar_ПамятьАгента.ФормаЭлемента",
		ПараметрыФормы, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// UI-20. Открывает форму элемента ar_Рутины для создания новой рутины,
// предзаполняя реквизит ar_Агент текущим агентом.
//
&НаКлиенте
Процедура ДобавитьРутину(ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ar_Агент", Объект.Ссылка);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы", ЭтотОбъект);
	ОткрытьФорму("Справочник.ar_Рутины.ФормаЭлемента",
		ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Открывает форму элемента записи памяти или рутины по UUID из ссылки.
//
&НаКлиенте
Процедура ОткрытьЭлементПоИд(ПараметрыСсылки, Знач ВидЭлемента)

	Ид = "";
	ПараметрыСсылки.Свойство("id", Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат;
	КонецЕсли;

	СсылкаЭлемента = СсылкаПоИдНаСервере(ВидЭлемента, Ид);
	Если СсылкаЭлемента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяФормы = ?(ВидЭлемента = "memory",
		"Справочник.ar_ПамятьАгента.ФормаЭлемента",
		"Справочник.ar_Рутины.ФормаЭлемента");

	ПараметрыФормы = Новый Структура("Ключ", СсылкаЭлемента);

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы", ЭтотОбъект);
	ОткрытьФорму(ИмяФормы, ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Перерисовывает карточку после закрытия дочерней формы (память / рутина) -
// чтобы таблицы вкладок подхватили добавленные или изменённые записи.
//
&НаКлиенте
Процедура ПослеЗакрытияДочернейФормы(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ПрименитьВводИПерерисоватьНаСервере(СобратьВводИзDOM());

КонецПроцедуры

// UI-20. Запрашивает подтверждение и удаляет выбранную рутину физически (без
// пометки на удаление).
//
&НаКлиенте
Процедура НачатьУдалениеРутины(ПараметрыСсылки, ЗначенияВвода)

	ПрименитьВводНаСервере(ЗначенияВвода);

	Ид = "";
	ПараметрыСсылки.Свойство("id", Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат;
	КонецЕсли;

	СсылкаНаРутину = СсылкаПоИдНаСервере("routine", Ид);
	Если СсылкаНаРутину = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон(
		НСтр("ru='Удалить рутину ""%1""? Действие необратимо.';
			|en='Delete routine ""%1""? This action cannot be undone.'"),
		Строка(СсылкаНаРутину));

	ДополнительныеПараметры = Новый Структура("Ссылка", СсылкаНаРутину);
	Оповещение = Новый ОписаниеОповещения("УдалитьРутинуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Завершение запроса подтверждения удаления рутины.
//
&НаКлиенте
Процедура УдалитьРутинуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОшибкаУдаления = УдалитьРутинуНаСервере(ДополнительныеПараметры.Ссылка);
	Если НЕ ПустаяСтрока(ОшибкаУдаления) Тогда
		ПоказатьПредупреждение(, ОшибкаУдаления);
		Возврат;
	КонецЕсли;

	ПрименитьВводИПерерисоватьНаСервере(Новый Массив);

КонецПроцедуры

// Действия над строками таблиц (tools / kv-переопределения / skills), полностью
// выполняемые на сервере: применить ввод, изменить строку, перерисовать.
//
&НаКлиенте
Процедура ВыполнитьДействиеСтроки(Знач Действие, ПараметрыСсылки, ЗначенияВвода)

	Индекс = -1;
	ЗначениеИндекса = "";
	Если ПараметрыСсылки.Свойство("idx", ЗначениеИндекса) Тогда
		ОписаниеТипов = Новый ОписаниеТипов("Число");
		Индекс = ОписаниеТипов.ПривестиЗначение(ЗначениеИндекса);
	КонецЕсли;

	ВыполнитьДействиеСтрокиНаСервере(Действие, Индекс, ЗначенияВвода);

КонецПроцедуры

#КонецОбласти

#Область СерверныеДействия

&НаСервере
Процедура ПереключитьВкладкуНаСервере(Знач ИмяВкладки, Знач ЗначенияВвода)

	ПрименитьВвод(ЗначенияВвода);
	ТекущаяВкладка = ИмяВкладки;
	ОбновитьВидимостьТаблицыПравил();
	ПерерисоватьКарточку();

КонецПроцедуры

// Штатное табличное поле ТаблицаПравилДоступа больше не отображается ни на
// одной вкладке (SCALE-08): ТЧ ar_ПравилаДоступаTools теперь полностью
// рисуется HTML-таблицей в HTMLСекцияПравилаДоступа/HTMLРядПравила - с
// отбором значений по реестру (часть 1а) и подсветкой висячих строк
// (часть 3), которые штатное табличное поле дать не может без потери
// биндинга к ТЧ. Элемент оставлен в Form.xml (Visible=false) - на случай
// диагностики через конфигуратор, из UI недостижим.
//
&НаСервере
Процедура ОбновитьВидимостьТаблицыПравил()

	Элементы.ТаблицаПравилДоступа.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Процедура ПрименитьВводНаСервере(Знач ЗначенияВвода)

	ПрименитьВвод(ЗначенияВвода);

КонецПроцедуры

&НаСервере
Процедура ПрименитьВводИПерерисоватьНаСервере(Знач ЗначенияВвода, Знач Статус = "")

	ПрименитьВвод(ЗначенияВвода);
	ПерерисоватьКарточку(Статус);

КонецПроцедуры

// Применяет значения, снятые из DOM, к данным формы. Значения присваиваются
// только при фактическом отличии, чтобы не помечать форму изменённой зря.
//
&НаСервере
Процедура ПрименитьВвод(Знач ЗначенияВвода)

	Для Каждого Элемент Из ЗначенияВвода Цикл

		Ид = Элемент.Ид;
		Значение = Элемент.Значение;

		Если Ид = "fld_name" Тогда
			УстановитьСтроку(Объект, "Наименование", Значение);
		ИначеЕсли Ид = "sel_role" Тогда
			УстановитьСтроку(Объект, "ar_ИмяРоли1С", Значение);
		ИначеЕсли Ид = "sel_autonomy" Тогда
			УстановитьРежимАвтономии(Значение);
		ИначеЕсли Ид = "fld_instruction" Тогда
			УстановитьСтроку(Объект, "ar_Инструкция", Значение);
		ИначеЕсли Ид = "fld_model" Тогда
			УстановитьСтроку(Объект, "ar_Модель", Значение);
		ИначеЕсли Ид = "fld_temp" Тогда
			УстановитьЧисло(Объект, "ar_Температура", Значение);
		ИначеЕсли Ид = "fld_maxsteps" Тогда
			УстановитьЧисло(Объект, "ar_МаксШагов", Значение);
		ИначеЕсли Ид = "fld_maxactions" Тогда
			УстановитьЧисло(Объект, "ar_МаксДействий", Значение);
		ИначеЕсли Ид = "fld_maxsum" Тогда
			УстановитьЧисло(Объект, "ar_МаксСуммаДействия", Значение);
		ИначеЕсли Ид = "fld_testreq" Тогда
			ТестовыйЗапрос = Значение;
		ИначеЕсли Ид = "sel_riskfilter" Тогда
			ФильтрRiskLevel = Значение;
		ИначеЕсли Ид = "sel_catfilter" Тогда
			ФильтрКатегория = Значение;
		ИначеЕсли Ид = "sel_pkgfilter" Тогда
			ФильтрПакет = Значение;
		ИначеЕсли СтрНачинаетсяС(Ид, "kvk_") Тогда
			УстановитьЗначениеРяда(Объект.ar_ПереопределенияПромпта, "ar_Ключ", Сред(Ид, 5), Значение);
		ИначеЕсли СтрНачинаетсяС(Ид, "kvv_") Тогда
			УстановитьЗначениеРяда(Объект.ar_ПереопределенияПромпта, "ar_Значение", Сред(Ид, 5), Значение);
		ИначеЕсли СтрНачинаетсяС(Ид, "ord_") Тогда
			УстановитьЧислоРяда(Объект.ar_ПодключённыеSkills, "ar_Порядок", Сред(Ид, 5), Значение);
		ИначеЕсли СтрНачинаетсяС(Ид, "rt_") Тогда
			УстановитьТипПравилаРяда(Сред(Ид, 4), Значение);
			ПредпросмотрНабораАктивен = Ложь; // Часть 2: правка правила - открытый предпросмотр устарел до следующей записи.
		ИначеЕсли СтрНачинаетсяС(Ид, "rv_") Тогда
			УстановитьЗначениеРяда(Объект.ar_ПравилаДоступаTools, "ar_Значение", Сред(Ид, 4), Значение);
			ПредпросмотрНабораАктивен = Ложь;
		ИначеЕсли СтрНачинаетсяС(Ид, "ra_") Тогда
			УстановитьБулевоРяда(Объект.ar_ПравилаДоступаTools, "ar_Разрешить", Сред(Ид, 4), Значение);
			ПредпросмотрНабораАктивен = Ложь;
		ИначеЕсли СтрНачинаетсяС(Ид, "ro_") Тогда
			УстановитьЧислоРяда(Объект.ar_ПравилаДоступаTools, "ar_Порядок", Сред(Ид, 4), Значение);
			ПредпросмотрНабораАктивен = Ложь;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьСтроку(ДанныеОбъекта, Знач ИмяПоля, Знач Значение)

	Если ДанныеОбъекта[ИмяПоля] <> Значение Тогда
		ДанныеОбъекта[ИмяПоля] = Значение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьЧисло(ДанныеОбъекта, Знач ИмяПоля, Знач Значение)

	Число = ПривестиКЧислу(Значение);
	Если ДанныеОбъекта[ИмяПоля] <> Число Тогда
		ДанныеОбъекта[ИмяПоля] = Число;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьРежимАвтономии(Знач ИмяЗначения)

	Попытка
		НовоеЗначение = Перечисления.ar_РежимАвтономии[ИмяЗначения];
	Исключение
		Возврат; // неизвестное имя значения - оставляем прежний режим
	КонецПопытки;

	Если Объект.ar_РежимАвтономии <> НовоеЗначение Тогда
		Объект.ar_РежимАвтономии = НовоеЗначение;
	КонецЕсли;

КонецПроцедуры

// Устанавливает строковое значение колонки ТЧ по индексу строки из id поля.
//
&НаСервере
Процедура УстановитьЗначениеРяда(ТабличнаяЧасть, Знач ИмяКолонки, Знач ИндексСтрокой, Знач Значение)

	ОписаниеТипов = Новый ОписаниеТипов("Число");
	Индекс = ОписаниеТипов.ПривестиЗначение(ИндексСтрокой);
	Если Индекс < 0 ИЛИ Индекс >= ТабличнаяЧасть.Количество() Тогда
		Возврат;
	КонецЕсли;

	Строка = ТабличнаяЧасть[Индекс];
	Если Строка[ИмяКолонки] <> Значение Тогда
		Строка[ИмяКолонки] = Значение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьЧислоРяда(ТабличнаяЧасть, Знач ИмяКолонки, Знач ИндексСтрокой, Знач Значение)

	УстановитьЗначениеРяда(ТабличнаяЧасть, ИмяКолонки, ИндексСтрокой, ПривестиКЧислу(Значение));

КонецПроцедуры

// Устанавливает булево значение колонки ТЧ по индексу строки из id поля -
// селект ra_N (часть 1а) передаёт строку "1"/"0" (см. HTMLРядПравила).
//
&НаСервере
Процедура УстановитьБулевоРяда(ТабличнаяЧасть, Знач ИмяКолонки, Знач ИндексСтрокой, Знач Значение)

	УстановитьЗначениеРяда(ТабличнаяЧасть, ИмяКолонки, ИндексСтрокой, (Значение = "1"));

КонецПроцедуры

// Устанавливает ar_ТипПравила строки ar_ПравилаДоступаTools по программному
// имени значения перечисления (селект rt_N, часть 1а). Неизвестное/пустое
// имя - тип сбрасывается в пустую ссылку (СелектТипаПравила рисует пункт
// "(не выбран)"), не роняет применение остального ввода.
//
&НаСервере
Процедура УстановитьТипПравилаРяда(Знач ИндексСтрокой, Знач ИмяЗначения)

	ОписаниеТипов = Новый ОписаниеТипов("Число");
	Индекс = ОписаниеТипов.ПривестиЗначение(ИндексСтрокой);
	Если Индекс < 0 ИЛИ Индекс >= Объект.ar_ПравилаДоступаTools.Количество() Тогда
		Возврат;
	КонецЕсли;

	НовоеЗначение = Перечисления.ar_ТипПравилаДоступа.ПустаяСсылка();
	Если Не ПустаяСтрока(ИмяЗначения) Тогда
		Попытка
			НовоеЗначение = Перечисления.ar_ТипПравилаДоступа[ИмяЗначения];
		Исключение
			НовоеЗначение = Перечисления.ar_ТипПравилаДоступа.ПустаяСсылка(); // неизвестное имя - тип не выбран
		КонецПопытки;
	КонецЕсли;

	Строка = Объект.ar_ПравилаДоступаTools[Индекс];
	Если Строка.ar_ТипПравила <> НовоеЗначение Тогда
		Строка.ar_ТипПравила = НовоеЗначение;
	КонецЕсли;

КонецПроцедуры

// Инвертирует булев реквизит агента по ключу действия toggle.
//
&НаСервере
Процедура ПереключитьФлагНаСервере(Знач Ключ, Знач ЗначенияВвода)

	ПрименитьВвод(ЗначенияВвода);

	Если Ключ = "agent_active" Тогда
		Объект.ar_Активен = НЕ Объект.ar_Активен;
	ИначеЕсли Ключ = "use_sessions" Тогда
		Объект.ar_ИспользоватьСессии = НЕ Объект.ar_ИспользоватьСессии;
	КонецЕсли;

	ПерерисоватьКарточку();

КонецПроцедуры

// Действия над строками таблиц HTML-карточки.
//
&НаСервере
Процедура ВыполнитьДействиеСтрокиНаСервере(Знач Действие, Знач Индекс, Знач ЗначенияВвода)

	ПрименитьВвод(ЗначенияВвода);

	Если Действие = "toggle-tool" Тогда
		Если Индекс >= 0 И Индекс < Объект.ar_ДоступныеTools.Количество() Тогда
			Строка = Объект.ar_ДоступныеTools[Индекс];
			Строка.ar_Включен = НЕ Строка.ar_Включен;
		КонецЕсли;
		ПредпросмотрНабораАктивен = Ложь; // Часть 2: набор в базе устарел до следующей записи - не показывать неактуальные данные.
	ИначеЕсли Действие = "remove-tool" Тогда
		Если Индекс >= 0 И Индекс < Объект.ar_ДоступныеTools.Количество() Тогда
			Объект.ar_ДоступныеTools.Удалить(Индекс);
		КонецЕсли;
		ПредпросмотрНабораАктивен = Ложь;
	ИначеЕсли Действие = "kv-add" Тогда
		Объект.ar_ПереопределенияПромпта.Добавить();
	ИначеЕсли Действие = "kv-del" Тогда
		Если Индекс >= 0 И Индекс < Объект.ar_ПереопределенияПромпта.Количество() Тогда
			Объект.ar_ПереопределенияПромпта.Удалить(Индекс);
		КонецЕсли;
	ИначеЕсли Действие = "skill-toggle" Тогда
		Если Индекс >= 0 И Индекс < Объект.ar_ПодключённыеSkills.Количество() Тогда
			Строка = Объект.ar_ПодключённыеSkills[Индекс];
			Строка.ar_Включен = НЕ Строка.ar_Включен;
		КонецЕсли;
	ИначеЕсли Действие = "skill-del" Тогда
		Если Индекс >= 0 И Индекс < Объект.ar_ПодключённыеSkills.Количество() Тогда
			Объект.ar_ПодключённыеSkills.Удалить(Индекс);
		КонецЕсли;
	ИначеЕсли Действие = "rule-add" Тогда
		НоваяСтрокаПравила = Объект.ar_ПравилаДоступаTools.Добавить();
		НоваяСтрокаПравила.ar_Разрешить = Истина;
		НоваяСтрокаПравила.ar_Порядок = (Объект.ar_ПравилаДоступаTools.Количество()) * 10;
		ПредпросмотрНабораАктивен = Ложь;
	ИначеЕсли Действие = "rule-del" Тогда
		Если Индекс >= 0 И Индекс < Объект.ar_ПравилаДоступаTools.Количество() Тогда
			Объект.ar_ПравилаДоступаTools.Удалить(Индекс);
		КонецЕсли;
		ПредпросмотрНабораАктивен = Ложь;
	КонецЕсли;

	ПерерисоватьКарточку();

КонецПроцедуры

// Устанавливает ссылочный реквизит (пользователь / LLM-провайдер) после выбора.
//
&НаСервере
Процедура УстановитьСсылкуНаСервере(Знач ВидСсылки, Знач ВыбранноеЗначение)

	Если ВидСсылки = "user" Тогда
		Объект.ar_Пользователь = ВыбранноеЗначение;
	ИначеЕсли ВидСсылки = "provider" Тогда
		Объект.ar_LLMПровайдер = ВыбранноеЗначение;
	КонецЕсли;

	ПерерисоватьКарточку();

КонецПроцедуры

// Перевыпуск токена агента (SEC-03/SEC-05): новый UUID-идентификатор + новый
// секрет в БезопасноеХранилище, всё в одной транзакции, с событием аудита.
//
&НаСервере
Процедура ПеревыпуститьТокенНаСервере()

	НовыйИдентификатор = ar_Утилиты.НовыйUUID();
	НовыйСекрет = ar_Утилиты.НовыйUUID();

	НачатьТранзакцию();
	Попытка
		// ar_Secrets сам поднимает привилегированный режим (контракт SEC-01) -
		// форма не управляет режимом напрямую.
		ar_Secrets.Сохранить("agent.token." + НовыйИдентификатор, НовыйСекрет);

		ОбъектАгент = Объект.Ссылка.ПолучитьОбъект();
		ОбъектАгент.ar_ТокенИдентификатор = НовыйИдентификатор;
		ОбъектАгент.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// Текст не содержит значения секрета - наружу уходит безопасное сообщение.
		ВызватьИсключение НСтр("ru='Не удалось перевыпустить токен агента.';
			|en='Failed to rotate the agent token.'");
	КонецПопытки;

	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("target", "agent.token");
	ДанныеСобытия.Вставить("agent", XMLСтрока(Объект.Ссылка));
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", "SecretRotated", ДанныеСобытия);

	Объект.ar_ТокенИдентификатор = НовыйИдентификатор;
	ПерерисоватьКарточку(НСтр("ru='Токен перевыпущен ✓'; en='Token rotated ✓'"));

КонецПроцедуры

&НаСервере
Функция ЗапуститьАгентаНаСервере(Знач СсылкаАгент)

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "manual");

	Возврат ar_RuntimeЗапуск.СтартоватьВФоне(СсылкаАгент, КонтекстТриггера);

КонецФункции

&НаСервере
Функция ТестовыйЗапускНаСервере(Знач СсылкаАгент, Знач ТекстЗапроса, Знач ЭтоDryRun)

	ДополнительныеПараметры = Новый Соответствие;
	ДополнительныеПараметры.Вставить("user_message", ТекстЗапроса);

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "manual");
	КонтекстТриггера.Вставить("DryRun", ЭтоDryRun);
	КонтекстТриггера.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);

	Возврат ar_RuntimeЗапуск.СтартоватьВФоне(СсылкаАгент, КонтекстТриггера);

КонецФункции

&НаСервере
Функция ПостроитьPromptНаСервере(Знач СсылкаАгент)

	ДанныеАгента = ДанныеАгентаДляПревью(СсылкаАгент);

	Состояние = Новый Структура;
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Вставить("RunId", "");

	ОкноКонтекста = ar_RuntimeКонтекст.ПостроитьКонтекст(Состояние, ДанныеАгента);

	СистемноеСообщение = "";
	Если ОкноКонтекста.messages.Количество() > 0 Тогда
		СистемноеСообщение = ОкноКонтекста.messages[0].content;
	КонецЕсли;

	// Разбиваем STABLE-слой на части для наглядности в форме «Что увидит LLM».
	СистемныйPrompt = Константы.ar_ОбщийСистемныйPrompt.Получить();

	Результат = Новый Структура;
	Результат.Вставить("ТекстPrompt", СистемноеСообщение);
	Результат.Вставить("СистемныйPrompt", СистемныйPrompt);
	Результат.Вставить("ИнструкцияPrompt", Объект.ar_Инструкция);
	Результат.Вставить("ИмяМодели", Объект.ar_Модель);

	Возврат Результат;

КонецФункции

// Собирает контракт ДанныеАгента (RT-06) из реквизитов формы для предпросмотра
// системного prompt. Дублирует минимально необходимый набор полей, не обращаясь
// к внутренним функциям ar_RuntimeЦикл.
//
&НаСервере
Функция ДанныеАгентаДляПревью(СсылкаАгент)

	ДанныеАгента = Новый Структура;
	ДанныеАгента.Вставить("Ссылка", СсылкаАгент);
	ДанныеАгента.Вставить("Наименование", Объект.Наименование);
	ДанныеАгента.Вставить("ИмяРоли1С", Объект.ar_ИмяРоли1С);
	ДанныеАгента.Вставить("LLMПровайдер", Объект.ar_LLMПровайдер);
	ДанныеАгента.Вставить("Модель", Объект.ar_Модель);
	ДанныеАгента.Вставить("Температура", Объект.ar_Температура);
	ДанныеАгента.Вставить("МаксШагов", Объект.ar_МаксШагов);
	ДанныеАгента.Вставить("МаксДействий", Объект.ar_МаксДействий);
	ДанныеАгента.Вставить("РежимАвтономии", Объект.ar_РежимАвтономии);
	ДанныеАгента.Вставить("Инструкция", Объект.ar_Инструкция);

	Возврат ДанныеАгента;

КонецФункции

// Добавляет выбранные в реестре tools в ТЧ ar_ДоступныеTools без дублей по
// имени. Возвращает количество фактически добавленных строк.
//
&НаСервере
Функция ДобавитьВыбранныеToolsНаСервере(Знач ВыбранныеСсылки)

	СуществующиеИмена = ИменаДоступныхTools();

	Добавлено = 0;
	Для Каждого ВыбраннаяСсылка Из ВыбранныеСсылки Цикл
		ИмяTool = ВыбраннаяСсылка.ar_Имя;
		Если ПустаяСтрока(ИмяTool) Или СуществующиеИмена[ВРег(ИмяTool)] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.ar_ДоступныеTools.Добавить();
		НоваяСтрока.ar_Tool = ИмяTool;
		НоваяСтрока.ar_Включен = Истина;
		СуществующиеИмена.Вставить(ВРег(ИмяTool), Истина);
		Добавлено = Добавлено + 1;
	КонецЦикла;

	// Модификация Объект.ar_ДоступныеTools в контексте формы автоматически
	// помечает форму измененной, явная установка Модифицированность не нужна.
	Если Добавлено > 0 Тогда
		ПредпросмотрНабораАктивен = Ложь; // Часть 2: явный список изменился - открытый предпросмотр устарел.
	КонецЕсли;
	ПерерисоватьКарточку();
	Возврат Добавлено;

КонецФункции

// Добавляет выбранные skills в ТЧ ar_ПодключённыеSkills без дублей по ссылке,
// включёнными, с порядком в конец списка.
//
&НаСервере
Процедура ДобавитьВыбранныеSkillsНаСервере(Знач ВыбранныеСсылки)

	ШагПорядка = 10;

	Для Каждого ВыбраннаяСсылка Из ВыбранныеСсылки Цикл
		Если Объект.ar_ПодключённыеSkills.НайтиСтроки(
				Новый Структура("ar_Skill", ВыбраннаяСсылка)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.ar_ПодключённыеSkills.Добавить();
		НоваяСтрока.ar_Skill = ВыбраннаяСсылка;
		НоваяСтрока.ar_Включен = Истина;
		НоваяСтрока.ar_Порядок = Объект.ar_ПодключённыеSkills.Количество() * ШагПорядка;
	КонецЦикла;

	ПерерисоватьКарточку();

КонецПроцедуры

// Соответствие "ВРег(имя tool) → Истина" для существующих строк ТЧ -
// для быстрой проверки дублей без учета регистра.
//
&НаСервере
Функция ИменаДоступныхTools()

	Имена = Новый Соответствие;
	Для Каждого Стр Из Объект.ar_ДоступныеTools Цикл
		Если НЕ ПустаяСтрока(Стр.ar_Tool) Тогда
			Имена.Вставить(ВРег(Стр.ar_Tool), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Формирует JSON-пресет набора инструментов агента (портируемый по имени,
// не по ссылке). Результат помещается во временное хранилище для последующей
// интерактивной выгрузки на клиент.
//
// Возвращаемое значение:
//   Структура:
//     * АдресХранилища - Строка - адрес JSON в временном хранилище
//     * ИмяФайла       - Строка - предложенное имя файла (.json)
//
&НаСервере
Функция СформироватьПресетJSON()

	МассивTools = Новый Массив;
	Для Каждого Стр Из Объект.ar_ДоступныеTools Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("name", Стр.ar_Tool);
		Элемент.Вставить("enabled", Стр.ar_Включен);
		МассивTools.Добавить(Элемент);
	КонецЦикла;

	Пресет = Новый Структура;
	Пресет.Вставить("ar_preset_version", МаксПоддерживаемаяВерсияПресета());
	Пресет.Вставить("kind", "agent_tools_preset");
	Пресет.Вставить("exported_at", ar_Утилиты.ФорматДата(ТекущаяДатаСеанса()));
	Пресет.Вставить("agent", Объект.Наименование);
	Пресет.Вставить("tools", МассивTools);

	ТекстJSON = ar_JSON.КрасивыйФорматJSON(Пресет);

	АдресХранилища = ПоместитьВоВременноеХранилище(
		ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, "UTF-8", Ложь),
		УникальныйИдентификатор);

	Результат = Новый Структура;
	Результат.Вставить("АдресХранилища", АдресХранилища);
	Результат.Вставить("ИмяФайла", ИмяФайлаПресета());

	Возврат Результат;

КонецФункции

// Формирует предложенное имя файла пресета: tools_preset_<агент>_<ГГГГММДД>.json.
//
&НаСервере
Функция ИмяФайлаПресета()

	ИмяАгента = ОчиститьИмяДляФайла(Объект.Наименование);
	Если ПустаяСтрока(ИмяАгента) Тогда
		ИмяАгента = "agent";
	КонецЕсли;

	ДатаЧасть = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	Возврат "tools_preset_" + ИмяАгента + "_" + ДатаЧасть + ".json";

КонецФункции

// Оставляет в строке только латиницу/цифры/подчеркивание для безопасного
// имени файла; прочие символы заменяет подчеркиванием.
//
&НаСервере
Функция ОчиститьИмяДляФайла(Знач Имя)

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
	Результат = "";
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, Символ) > 0 Тогда
			Результат = Результат + Символ;
		Иначе
			Результат = Результат + "_";
		КонецЕсли;
	КонецЦикла;

	Возврат ar_Утилиты.ОбрезатьДо(Результат, 60);

КонецФункции

// Разбирает и валидирует JSON-пресет из временного хранилища.
//
// Возвращаемое значение:
//   Структура:
//     * Успех          - Булево
//     * Причина        - Строка - код причины при Успех = Ложь
//                        ("invalid_json"/"wrong_kind"/"unsupported_version"/"no_tools"/
//                        "tool_code_import_forbidden" - SEC-TOOL-01, элемент tools[]
//                        содержит запрещённый ключ code_implementation)
//     * Tools          - Массив структур "Имя, Включен"
//     * ВсегоTools     - Число
//     * ВключенныхTools - Число
//
&НаСервере
Функция РазобратьПресетJSON(Знач АдресФайла)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Причина", "");
	Результат.Вставить("Tools", Новый Массив);
	Результат.Вставить("ВсегоTools", 0);
	Результат.Вставить("ВключенныхTools", 0);

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Результат.Причина = "invalid_json";
		Возврат Результат;
	КонецЕсли;

	ТекстJSON = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, "UTF-8");
	Данные = ar_JSON.ИзJSON(ТекстJSON);

	// ar_JSON.ИзJSON возвращает JSON-объекты как Соответствие (ключи через [...]).
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Результат.Причина = "invalid_json";
		Возврат Результат;
	КонецЕсли;

	Если Данные["kind"] <> "agent_tools_preset" Тогда
		Результат.Причина = "wrong_kind";
		Возврат Результат;
	КонецЕсли;

	Версия = Данные["ar_preset_version"];
	Если ТипЗнч(Версия) <> Тип("Число") Или Версия > МаксПоддерживаемаяВерсияПресета() Тогда
		Результат.Причина = "unsupported_version";
		Возврат Результат;
	КонецЕсли;

	МассивTools = Данные["tools"];
	Если ТипЗнч(МассивTools) <> Тип("Массив") Тогда
		Результат.Причина = "no_tools";
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементTool Из МассивTools Цикл
		Если ТипЗнч(ЭлементTool) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		// SEC-TOOL-01: тот же превентивный guard, что и в
		// ar_ПресетыИмпорт.ВалидироватьСтруктуруПресета - ключ
		// "code_implementation" зарезервирован как запрещенный в формате
		// пресета tools[]. Этот импорт работает со ссылками по имени на уже
		// существующие ar_Tools (не создаёт элементы и не переносит
		// ar_КодРеализации), но структура JSON идентична - явный отказ
		// вместо тихого игнорирования лишнего ключа. См.
		// .docs/Модель-угроз-режим-Код.md.
		Если ar_ЭлементToolСодержитЗапрещенныйКод(ЭлементTool) Тогда
			Результат.Причина = "tool_code_import_forbidden";
			Возврат Результат;
		КонецЕсли;

		ИмяTool = ЭлементTool["name"];
		Если ТипЗнч(ИмяTool) <> Тип("Строка") Или ПустаяСтрока(ИмяTool) Тогда
			Продолжить;
		КонецЕсли;

		Включен = (ЭлементTool["enabled"] = Истина);

		ЭлементРезультата = Новый Структура;
		ЭлементРезультата.Вставить("Имя", ИмяTool);
		ЭлементРезультата.Вставить("Включен", Включен);
		Результат.Tools.Добавить(ЭлементРезультата);

		Если Включен Тогда
			Результат.ВключенныхTools = Результат.ВключенныхTools + 1;
		КонецЕсли;
	КонецЦикла;

	Если Результат.Tools.Количество() = 0 Тогда
		Результат.Причина = "no_tools";
		Возврат Результат;
	КонецЕсли;

	Результат.ВсегоTools = Результат.Tools.Количество();
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// SEC-TOOL-01: проверяет, содержит ли элемент tools[] пресета запрещённый
// ключ "code_implementation" с непустым значением. См. комментарий в месте
// вызова (РазобратьПресетJSON) и .docs/Модель-угроз-режим-Код.md.
//
// Параметры:
//   ЭлементTool - Соответствие - один элемент массива tools[] пресета.
//
// Возвращаемое значение:
//   Булево - Истина, если элемент содержит непустой "code_implementation".
//
&НаСервере
Функция ar_ЭлементToolСодержитЗапрещенныйКод(Знач ЭлементTool)

	КодРеализацииИзПресета = ЭлементTool["code_implementation"];
	Возврат ТипЗнч(КодРеализацииИзПресета) = Тип("Строка") И Не ПустаяСтрока(КодРеализацииИзПресета);

КонецФункции

// Применяет распарсенный пресет к ТЧ ar_ДоступныеTools.
//
// Параметры:
//   ToolsПресета - Массив структур "Имя, Включен".
//   Заменять     - Булево - Истина: очистить ТЧ перед загрузкой;
//                  Ложь: объединить (обновить ar_Включен у существующих,
//                  добавить отсутствующие).
//
// Возвращаемое значение:
//   Массив строк - имена tools, отсутствующих в реестре ar_Tools.
//
&НаСервере
Функция ПрименитьПресетНаСервере(Знач ToolsПресета, Знач Заменять)

	Если Заменять Тогда
		Объект.ar_ДоступныеTools.Очистить();
	КонецЕсли;

	НеНайденные = Новый Массив;
	КартаРеестра = КартаToolsРеестра();

	Для Каждого ЭлементПресета Из ToolsПресета Цикл
		ИмяTool = ЭлементПресета.Имя;

		НайденнаяСтрока = Неопределено;
		Если НЕ Заменять Тогда
			НайденнаяСтрока = НайтиСтрокуToolПоИмени(ИмяTool);
		КонецЕсли;

		Если НайденнаяСтрока <> Неопределено Тогда
			НайденнаяСтрока.ar_Включен = ЭлементПресета.Включен;
		Иначе
			НоваяСтрока = Объект.ar_ДоступныеTools.Добавить();
			НоваяСтрока.ar_Tool = ИмяTool;
			НоваяСтрока.ar_Включен = ЭлементПресета.Включен;
		КонецЕсли;

		Если КартаРеестра[ВРег(ИмяTool)] = Неопределено Тогда
			НеНайденные.Добавить(ИмяTool);
		КонецЕсли;
	КонецЦикла;

	// Изменение Объект.ar_ДоступныеTools в контексте формы помечает форму
	// измененной автоматически.
	ПредпросмотрНабораАктивен = Ложь; // Часть 2: явный список изменился импортом - открытый предпросмотр устарел.
	ПерерисоватьКарточку();
	Возврат НеНайденные;

КонецФункции

// Находит строку ТЧ ar_ДоступныеTools по имени tool (без учета регистра).
//
&НаСервере
Функция НайтиСтрокуToolПоИмени(Знач ИмяTool)

	ИмяВРег = ВРег(ИмяTool);
	Для Каждого Стр Из Объект.ar_ДоступныеTools Цикл
		Если ВРег(Стр.ar_Tool) = ИмяВРег Тогда
			Возврат Стр;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Серверное удаление рутины в транзакции. Возвращает пустую строку при успехе
// или текст ошибки для вывода пользователю.
//
// Параметры:
//   СсылкаНаРутину - СправочникСсылка.ar_Рутины - ссылка на удаляемую рутину.
//
// Возвращаемое значение:
//   Строка - пустая при успехе, иначе сообщение об ошибке.
//
&НаСервереБезКонтекста
Функция УдалитьРутинуНаСервере(Знач СсылкаНаРутину)

	// Проверяем существование объекта ДО открытия транзакции.
	ОбъектРутины = СсылкаНаРутину.ПолучитьОбъект();
	Если ОбъектРутины = Неопределено Тогда
		Возврат НСтр("ru='Рутина не найдена или уже удалена.';
			|en='Routine not found or already deleted.'");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ОбъектРутины.Удалить();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"ar_Агенты.ФормаЭлемента",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ar_Рутины,
			СсылкаНаРутину,
			НСтр("ru='Ошибка удаления рутины'; en='Error deleting routine'") + ": " + ТекстОшибки);
		Возврат НСтр("ru='Не удалось удалить рутину. Возможно, на неё есть ссылки в других объектах.';
			|en='Failed to delete the routine. It may be referenced by other objects.'");
	КонецПопытки;

	Возврат "";

КонецФункции

// Возвращает ссылку на элемент справочника памяти или рутин по строке UUID
// из служебной ссылки. Неопределено - при некорректном UUID.
//
&НаСервереБезКонтекста
Функция СсылкаПоИдНаСервере(Знач ВидЭлемента, Знач Ид)

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Ид);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ВидЭлемента = "memory" Тогда
		Возврат Справочники.ar_ПамятьАгента.ПолучитьСсылку(Идентификатор);
	ИначеЕсли ВидЭлемента = "routine" Тогда
		Возврат Справочники.ar_Рутины.ПолучитьСсылку(Идентификатор);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Значение перечисления ar_RiskLevel по имени - для отбора формы подбора tools.
//
&НаСервереБезКонтекста
Функция ЗначениеRiskLevelНаСервере(Знач ИмяЗначения)

	Попытка
		Возврат Перечисления.ar_RiskLevel[ИмяЗначения];
	Исключение
		Возврат Перечисления.ar_RiskLevel.ПустаяСсылка();
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьИзВременногоХранилищаНаСервере(Знач Адрес)

	Если ЗначениеЗаполнено(Адрес) Тогда
		УдалитьИзВременногоХранилища(Адрес);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПерерисовкаКарточки

// Собирает HTML всей карточки агента (шапка + вкладки + секция текущей
// вкладки) и кладёт его в реквизит СтрокаHTMLАгент.
//
// Параметры:
//  Статус - Строка - необязательный статус последнего действия для показа
//           в шапке карточки (например «Записано ✓»).
//
&НаСервере
Процедура ПерерисоватьКарточку(Знач Статус = "")

	Содержимое = HTMLСекцияШапки(Статус) + HTMLПанельВкладок();

	Если ТекущаяВкладка = "instr" Тогда
		Содержимое = Содержимое + HTMLСекцияИнструкция();
	ИначеЕсли ТекущаяВкладка = "tools" Тогда
		Содержимое = Содержимое + HTMLСекцияTools();
	ИначеЕсли ТекущаяВкладка = "rules" Тогда
		Содержимое = Содержимое + HTMLСекцияПравилаДоступа();
	ИначеЕсли ТекущаяВкладка = "sched" Тогда
		Содержимое = Содержимое + HTMLСекцияРасписание();
	ИначеЕсли ТекущаяВкладка = "llm" Тогда
		Содержимое = Содержимое + HTMLСекцияLLM();
	ИначеЕсли ТекущаяВкладка = "memory" Тогда
		Содержимое = Содержимое + HTMLСекцияПамять();
	ИначеЕсли ТекущаяВкладка = "test" Тогда
		Содержимое = Содержимое + HTMLСекцияТест();
	Иначе
		Содержимое = Содержимое + HTMLСекцияОсновное();
	КонецЕсли;

	СтрокаHTMLАгент = HTMLКаркасКарточки(Содержимое);

КонецПроцедуры

// Шапка карточки: наименование, бейдж активности, статус действия и кнопки
// «Записать», «Записать и закрыть», «Запустить», «Показать prompt».
//
&НаСервере
Функция HTMLСекцияШапки(Знач Статус)

	Имя = Объект.Наименование;
	Если ПустаяСтрока(Имя) Тогда
		Имя = НСтр("ru='Новый агент'; en='New agent'");
	КонецЕсли;

	БейджАктивности = ?(Объект.ar_Активен,
		"<span class=""ar-badge-on"">" + ar_ЭкранироватьHTML(НСтр("ru='Активен'; en='Active'")) + "</span>",
		"<span class=""ar-badge-off"">" + ar_ЭкранироватьHTML(НСтр("ru='Неактивен'; en='Inactive'")) + "</span>");

	СтатусHTML = "";
	Если Не ПустаяСтрока(Статус) Тогда
		СтатусHTML = "<span class=""ar-status"">" + ar_ЭкранироватьHTML(Статус) + "</span>";
	ИначеЕсли Модифицированность Тогда
		СтатусHTML = "<span class=""ar-modified"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Есть несохранённые изменения'; en='Unsaved changes'")) + "</span>";
	КонецЕсли;

	Кнопки = "";
	Если НЕ ТолькоПросмотр Тогда
		Кнопки = Кнопки
			+ СсылкаДействие("save", "", НСтр("ru='💾 Записать'; en='💾 Save'"), "ar-btn ar-btn-primary")
			+ СсылкаДействие("save-close", "", НСтр("ru='Записать и закрыть'; en='Save and close'"), "ar-btn");
	КонецЕсли;
	Кнопки = Кнопки
		+ СсылкаДействие("run-agent", "", НСтр("ru='▶ Запустить'; en='▶ Run'"), "ar-btn ar-btn-run")
		+ СсылкаДействие("show-prompt", "", НСтр("ru='Показать prompt'; en='Show prompt'"), "ar-btn");

	Возврат
		"<div class=""ar-head"">"
		+ "<div class=""ar-head-title""><h1>🤖 " + ar_ЭкранироватьHTML(Имя) + "</h1>"
		+ БейджАктивности + СтатусHTML + "</div>"
		+ "<div class=""ar-head-actions"">" + Кнопки + "</div>"
		+ "</div>";

КонецФункции

// Панель вкладок карточки. Активная вкладка выделяется классом ar-tab-active.
//
&НаСервере
Функция HTMLПанельВкладок()

	Вкладки = Новый Массив;
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "main",   НСтр("ru='Основное'; en='Main'")));
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "instr",  НСтр("ru='Инструкция'; en='Instruction'")));
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "tools",  НСтр("ru='Tools'; en='Tools'")));
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "rules",  НСтр("ru='Правила доступа'; en='Access rules'")));
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "sched",  НСтр("ru='Расписание'; en='Schedule'")));
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "llm",    НСтр("ru='LLM'; en='LLM'")));
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "memory", НСтр("ru='Память'; en='Memory'")));
	Вкладки.Добавить(Новый Структура("Ключ, Заголовок", "test",   НСтр("ru='Тест'; en='Test'")));

	HTMLВкладок = "";
	Для Каждого Вкладка Из Вкладки Цикл
		Класс = ?(Вкладка.Ключ = ТекущаяВкладка, "ar-tab ar-tab-active", "ar-tab");
		HTMLВкладок = HTMLВкладок
			+ СсылкаДействие("tab", "name=" + Вкладка.Ключ, Вкладка.Заголовок, Класс);
	КонецЦикла;

	Возврат "<div class=""ar-tabs"">" + HTMLВкладок + "</div>";

КонецФункции

// Вкладка «Основное»: наименование, роль 1С, режим автономии, пользователь,
// флаги и статус токена.
//
&НаСервере
Функция HTMLСекцияОсновное()

	// Реквизит типизирован конкретно как СправочникСсылка.Пользователи, поэтому ЗначениеЗаполнено()
	// применим напрямую; пустая ссылка даёт "(не выбран)".
	Если ЗначениеЗаполнено(Объект.ar_Пользователь) Тогда
		ПредставлениеПользователя = Строка(Объект.ar_Пользователь);
	Иначе
		ПредставлениеПользователя = НСтр("ru='(не выбран)'; en='(not set)'");
	КонецЕсли;

	ТокенЗадан = НЕ ПустаяСтрока(Объект.ar_ТокенИдентификатор);
	Если ТокенЗадан Тогда
		СтатусТокена = "<span class=""ar-badge-on"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Токен задан'; en='Token is set'")) + "</span> <code>"
			+ ar_ЭкранироватьHTML(Объект.ar_ТокенИдентификатор) + "</code>";
	Иначе
		СтатусТокена = "<span class=""ar-badge-off"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Токен не задан'; en='Token not set'")) + "</span>";
	КонецЕсли;

	КнопкаТокена = "";
	Если НЕ ТолькоПросмотр И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		КнопкаТокена = СсылкаДействие("rotate-token", "",
			НСтр("ru='Перевыпустить токен'; en='Rotate token'"), "ar-btn ar-btn-small");
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ СтрокаПоля(НСтр("ru='Наименование'; en='Name'"),
			ПолеВвода("fld_name", Объект.Наименование, "ar-input ar-input-wide"),
			НСтр("ru='Отображаемое имя агента: показывается в списках, журнале запусков и подставляется в системный prompt.';
				|en='Display name of the agent: shown in lists, the run log, and injected into the system prompt.'"))
		+ СтрокаПоля(НСтр("ru='Активен'; en='Active'"),
			Переключатель("agent_active", Объект.ar_Активен),
			НСтр("ru='Выключенный агент нельзя запустить ни вручную, ни по расписанию рутин.';
				|en='An inactive agent cannot be started manually or by routine schedule.'"))
		+ СтрокаПоля(НСтр("ru='Режим автономии'; en='Autonomy mode'"), СелектРежимаАвтономии(),
			НСтр("ru='Что агент делает без подтверждения: Manual - только чтение; AutoThreshold - чтение и черновики; Autonomous - всё, кроме commit; ReadOnly - мутации запрещены. Commit всегда требует подтверждения.';
				|en='What the agent may do without approval: Manual - read only; AutoThreshold - read and drafts; Autonomous - everything but commit; ReadOnly - mutations denied. Commit always requires approval.'"))
		+ СтрокаПоля(НСтр("ru='Роль 1С'; en='1C role'"), СелектРолей(),
			НСтр("ru='Роль, ограничивающая права агента при выполнении tools. Пусто - роль не проверяется.';
				|en='Role that limits the agent''s permissions when executing tools. Empty - the role is not checked.'"))
		+ СтрокаПоля(НСтр("ru='Пользователь'; en='User'"),
			"<span class=""ar-refval"">" + ar_ЭкранироватьHTML(ПредставлениеПользователя) + "</span>"
			+ ?(ТолькоПросмотр, "", СсылкаДействие("pick-user", "",
				НСтр("ru='Выбрать…'; en='Select…'"), "ar-btn ar-btn-small")),
			НСтр("ru='Пользователь 1С - владелец агента: отвечает за его запуски и виден в аудите.';
				|en='1C user who owns the agent: responsible for its runs and shown in the audit trail.'"))
		+ СтрокаПоля(НСтр("ru='Использовать сессии'; en='Use sessions'"),
			Переключатель("use_sessions", Объект.ar_ИспользоватьСессии),
			НСтр("ru='Сохранять контекст диалога между запусками (сессии с TTL из настроек). Без флажка каждый запуск начинается «с чистого листа».';
				|en='Keep dialog context between runs (sessions with TTL from settings). Without the flag every run starts from scratch.'"))
		+ "</div>"
		+ "<div class=""ar-card""><h2>" + ar_ЭкранироватьHTML(НСтр("ru='Токен агента'; en='Agent token'")) + "</h2>"
		+ "<div class=""ar-token-row"">" + СтатусТокена + КнопкаТокена + "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Токен аутентифицирует внешние обращения к агенту через HTTP-сервисы. Значение не отображается и не хранится в открытом виде (SEC-03/SEC-05); при компрометации перевыпустите токен - старый перестанет действовать сразу.';
				|en='The token authenticates external calls to the agent via HTTP services. Its value is never displayed or stored in plain text (SEC-03/SEC-05); if compromised, rotate it - the old value stops working immediately.'")) + "</div>"
		+ "</div>";

КонецФункции

// Вкладка «Инструкция»: textarea markdown-инструкции + предпросмотр.
//
&НаСервере
Функция HTMLСекцияИнструкция()

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Инструкция (markdown)'; en='Instruction (markdown)'")) + "</h2>"
		+ СсылкаДействие("refresh", "", НСтр("ru='Обновить превью'; en='Refresh preview'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Главный текст роли агента: кто он, что делает, каких правил придерживается. Попадает в системный prompt после общего prompt воркспейса (из Настроек). Поддерживается markdown: заголовки, списки, **жирный**, `код`.';
				|en='The core role text of the agent: who it is, what it does, what rules it follows. Goes into the system prompt after the workspace-wide prompt (from Settings). Markdown supported: headings, lists, **bold**, `code`.'")) + "</div>"
		+ "<textarea id=""fld_instruction"" class=""ar-textarea ar-textarea-instr"" rows=""14"""
		+ ?(ТолькоПросмотр, " readonly", "") + ">"
		+ ar_ЭкранироватьHTML(Объект.ar_Инструкция) + "</textarea>"
		+ "</div>"
		+ "<div class=""ar-card""><h2>" + ar_ЭкранироватьHTML(НСтр("ru='Превью'; en='Preview'")) + "</h2>"
		+ "<div class=""ar-md-preview"">" + МаркdownВHTML(Объект.ar_Инструкция) + "</div>"
		+ "</div>";

КонецФункции

// Вкладка «Tools»: таблица ТЧ ar_ДоступныеTools со сведениями из реестра,
// счётчик, фильтр risk_level для подбора, импорт/экспорт пресета (UI-04).
//
&НаСервере
Функция HTMLСекцияTools()

	КартаРеестра = КартаToolsРеестра();

	Всего = Объект.ar_ДоступныеTools.Количество();
	Включено = 0;
	Ряды = "";

	Для Индекс = 0 По Всего - 1 Цикл
		Строка = Объект.ar_ДоступныеTools[Индекс];
		Если Строка.ar_Включен Тогда
			Включено = Включено + 1;
		КонецЕсли;
		Ряды = Ряды + HTMLРядTool(Индекс, Строка, КартаРеестра);
	КонецЦикла;

	Если Всего = 0 Тогда
		Ряды = "<tr><td colspan=""6"" class=""ar-empty"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Инструменты не добавлены. Используйте «Добавить из реестра».';
				|en='No tools added. Use «Add from registry».'")) + "</td></tr>";
	КонецЕсли;

	Счетчик = СтрШаблон(НСтр("ru='Включено: %1 из %2'; en='Enabled: %1 of %2'"), Включено, Всего);

	КнопкиПанели = "";
	Если НЕ ТолькоПросмотр Тогда
		КнопкиПанели =
			СелектФильтраRisk()
			+ СелектФильтраКатегория()
			+ СелектФильтраПакет()
			+ СсылкаДействие("add-tools", "", НСтр("ru='+ Добавить из реестра'; en='+ Add from registry'"), "ar-btn")
			+ СсылкаДействие("import-preset", "", НСтр("ru='Импорт пресета'; en='Import preset'"), "ar-btn ar-btn-small")
			+ СсылкаДействие("export-preset", "", НСтр("ru='Экспорт пресета'; en='Export preset'"), "ar-btn ar-btn-small");
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Инструменты агента'; en='Agent tools'")) + "</h2>"
		+ "<span class=""ar-counter"">" + ar_ЭкранироватьHTML(Счетчик) + "</span>"
		+ "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Что агенту разрешено делать: LLM видит только включённые (Вкл) инструменты. Риск и «Approval» берутся из реестра ar_Tools - чем выше риск, тем строже режим автономии, а действия с «Approval: Да» всегда идут через очередь подтверждений. Фильтр слева сужает подбор из реестра.';
				|en='What the agent is allowed to do: the LLM only sees enabled (On) tools. Risk and «Approval» come from the ar_Tools registry - the higher the risk, the stricter the autonomy mode, and «Approval: Yes» actions always go through the approval queue. The filter narrows registry selection.'")) + "</div>"
		+ "<div class=""ar-toolbar"">" + КнопкиПанели + "</div>"
		+ "<table class=""ar-table""><thead><tr>"
		+ "<th></th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Tool'; en='Tool'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Риск'; en='Risk'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Approval'; en='Approval'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Описание'; en='Description'")) + "</th>"
		+ "<th></th>"
		+ "</tr></thead><tbody>" + Ряды + "</tbody></table>"
		+ "</div>";

КонецФункции

// Вкладка «Правила доступа» (SCALE-07/SCALE-08): ТЧ ar_ПравилаДоступаTools
// отрисована HTML-таблицей (тем же способом, что вкладка «Tools»/HTMLРядTool) -
// каждая строка даёт подбор значения из реестра по выбранному ar_ТипПравила
// (часть 1а) и подсветку висячих/неработающих строк (часть 3). Штатное
// табличное поле ТаблицаПравилДоступа сохранено в форме (Visible=false),
// но больше не участвует в отображении - см. риск «Штатное табличное поле
// vs HTML» в спеке SCALE-08.
//
// Ниже - блок предпросмотра эффективного набора (часть 2): включается кнопкой
// «Показать предпросмотр» (ПереключитьПредпросмотрНабора), данные - СТРОГО
// результат ar_ToolAccessRules.ЭффективныйНаборTools (DoD D9), без
// собственной реконструкции union/deny в форме.
//
&НаСервере
Функция HTMLСекцияПравилаДоступа()

	КартаКатегорий = КартаКатегорийTools();
	КартаПакетов = КартаПакетовTools();
	КартаРеестраTools = КартаToolsРеестра();
	ИзвестныеNamespace = ar_ToolПакеты.ВсеИзвестныеNamespace();

	Всего = Объект.ar_ПравилаДоступаTools.Количество();
	Ряды = "";
	Для Индекс = 0 По Всего - 1 Цикл
		Строка = Объект.ar_ПравилаДоступаTools[Индекс];
		Ряды = Ряды + HTMLРядПравила(Индекс, Строка, КартаКатегорий, КартаПакетов,
			КартаРеестраTools, ИзвестныеNamespace);
	КонецЦикла;

	Если Всего = 0 Тогда
		Ряды = "<tr><td colspan=""6"" class=""ar-empty"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Правил нет. Явный список вкладки «Tools» определяет доступ агента без изменений.';
				|en='No rules. The explicit list on the «Tools» tab defines agent access unchanged.'")) + "</td></tr>";
	КонецЕсли;

	КнопкаДобавления = ?(ТолькоПросмотр, "",
		СсылкаДействие("rule-add", "", НСтр("ru='+ Добавить правило'; en='+ Add rule'"), "ar-btn"));

	ТекстКнопкиПредпросмотра = ?(ПредпросмотрНабораАктивен,
		НСтр("ru='Скрыть предпросмотр'; en='Hide preview'"),
		НСтр("ru='Показать предпросмотр набора'; en='Show set preview'"));

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Правила доступа к tools'; en='Tool access rules'")) + "</h2>"
		+ КнопкаДобавления
		+ "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Разрешающие правила объединяются (union) и расширяют набор поверх вкладки «Tools». Запрещающее правило всегда исключает tool, даже если он разрешён явным списком или другим правилом. Пустое значение правила не совпадает ни с чем. Если и явный список, и правила пусты - агенту доступен весь реестр. Строки с красной пометкой ссылаются на значение, которого нет в реестре, или не дают никакого эффекта - см. подсказку в строке.';
				|en='Allow rules are combined by union and extend the set on top of the «Tools» tab. A deny rule always excludes a tool, even if it is allowed by the explicit list or another rule. An empty rule value matches nothing. If both the explicit list and the rules are empty, the agent gets the whole registry. Rows marked in red reference a value missing from the registry, or have no effect - see the row hint.'")) + "</div>"
		+ "<table class=""ar-table""><thead><tr>"
		+ "<th></th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Тип правила'; en='Rule type'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Значение'; en='Value'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Разрешить'; en='Allow'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Порядок'; en='Order'")) + "</th>"
		+ "<th></th>"
		+ "</tr></thead><tbody>" + Ряды + "</tbody></table>"
		+ "<div class=""ar-toolbar"">"
		+ СсылкаДействие("preview-toggle", "", ТекстКнопкиПредпросмотра, "ar-btn ar-btn-small")
		+ "</div>"
		+ "</div>"
		+ ?(ПредпросмотрНабораАктивен, HTMLБлокПредпросмотраНабора(), "");

КонецФункции

// Селект значений типа правила для строки ТЧ ar_ПравилаДоступаTools (часть 1а).
// Форма без JS (см. шапку модуля - вся навигация через "1c://"-ссылки),
// поэтому смена select сама по себе карточку не перерисовывает: рядом
// рисуется ссылка-действие "refresh" (тот же приём, что "Обновить превью" на
// вкладке «Инструкция»), по клику на которую текущее значение select уже
// снято из DOM (rt_N входит в СобратьВводИзDOM для вкладки rules) и под новый
// тип пересобирается список опций «Значение» ниже.
//
&НаСервере
Функция СелектТипаПравила(Знач ИндексСтрокой, Знач ТекущийТип)

	Типы = Новый Массив;
	Типы.Добавить("Категория");
	Типы.Добавить("Пакет");
	Типы.Добавить("Namespace");
	Типы.Добавить("Tool");
	Типы.Добавить("RiskLevel");

	Опции = "<option value=""""" + ?(ПустаяСтрока(ТекущийТип), " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='(не выбран)'; en='(not set)'")) + "</option>";
	Для Каждого Тип Из Типы Цикл
		Опции = Опции + "<option value=""" + Тип + """" + ?(Тип = ТекущийТип, " selected", "") + ">"
			+ Тип + "</option>";
	КонецЦикла;

	Селект = "<select id=""rt_" + ИндексСтрокой + """ class=""ar-select ar-select-narrow"""
		+ ?(ТолькоПросмотр, " disabled", "") + ">" + Опции + "</select>";

	Возврат Селект + ?(ТолькоПросмотр, "", СсылкаДействие("refresh", "",
		НСтр("ru='↻'; en='↻'"), "ar-btn ar-btn-small"));

КонецФункции

// Селект значения правила (часть 1а): состав опций зависит от ТипПравила
// строки - подбор из реестра вместо свободного текста, чтобы опечатка не
// осталась незамеченной "пустым совпадением" (см. ar_ToolAccessRules,
// ЭтоСовпадениеКритерия). Namespace дополнительно содержит опцию "*" - это
// осознанный wildcard (работает только в запрещающих правилах), а не текст
// для свободного набора, поэтому список закрыт даже для этого типа.
//
&НаСервере
Функция СелектЗначенияПравила(Знач ИндексСтрокой, Знач ТипПравила, Знач ТекущееЗначение,
	Знач КартаКатегорий, Знач КартаПакетов, Знач КартаРеестраTools, Знач ИзвестныеNamespace)

	Если ПустаяСтрока(ТипПравила) Тогда
		Возврат "<select id=""rv_" + ИндексСтрокой + """ class=""ar-select ar-select-narrow"" disabled>"
			+ "<option value="""">" + ar_ЭкранироватьHTML(НСтр("ru='(сначала выберите тип)'; en='(pick type first)'"))
			+ "</option></select>";
	КонецЕсли;

	Опции = "<option value=""""" + ?(ПустаяСтрока(ТекущееЗначение), " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='(не выбрано)'; en='(not set)'")) + "</option>";

	Если ТипПравила = "Категория" Тогда
		Для Каждого КлючЗначение Из КартаКатегорий Цикл
			Опции = Опции + "<option value=""" + ar_ЭкранироватьHTML(КлючЗначение.Ключ) + """"
				+ ?(КлючЗначение.Ключ = ТекущееЗначение, " selected", "") + ">"
				+ ar_ЭкранироватьHTML(КлючЗначение.Значение) + "</option>";
		КонецЦикла;
	ИначеЕсли ТипПравила = "Пакет" Тогда
		Для Каждого КлючЗначение Из КартаПакетов Цикл
			Опции = Опции + "<option value=""" + ar_ЭкранироватьHTML(КлючЗначение.Ключ) + """"
				+ ?(КлючЗначение.Ключ = ТекущееЗначение, " selected", "") + ">"
				+ ar_ЭкранироватьHTML(КлючЗначение.Значение) + "</option>";
		КонецЦикла;
	ИначеЕсли ТипПравила = "Namespace" Тогда
		Для Каждого КлючЗначение Из ИзвестныеNamespace Цикл
			Опции = Опции + "<option value=""" + ar_ЭкранироватьHTML(КлючЗначение.Ключ) + """"
				+ ?(КлючЗначение.Ключ = ТекущееЗначение, " selected", "") + ">"
				+ ar_ЭкранироватьHTML(КлючЗначение.Ключ) + "</option>";
		КонецЦикла;
		Опции = Опции + "<option value=""*""" + ?(ТекущееЗначение = "*", " selected", "") + ">"
			+ ar_ЭкранироватьHTML(НСтр("ru='* (все namespace - только для запрещающих правил)'; en='* (all namespaces - deny rules only)'"))
			+ "</option>";
	ИначеЕсли ТипПравила = "Tool" Тогда
		Для Каждого КлючЗначение Из КартаРеестраTools Цикл
			Опции = Опции + "<option value=""" + ar_ЭкранироватьHTML(КлючЗначение.Значение.Имя) + """"
				+ ?(КлючЗначение.Значение.Имя = ТекущееЗначение, " selected", "") + ">"
				+ ar_ЭкранироватьHTML(КлючЗначение.Значение.Имя) + "</option>";
		КонецЦикла;
	ИначеЕсли ТипПравила = "RiskLevel" Тогда
		ИменаУровней = Новый Массив;
		ИменаУровней.Добавить("Read");
		ИменаУровней.Добавить("Draft");
		ИменаУровней.Добавить("Write");
		ИменаУровней.Добавить("Commit");
		Для Каждого Имя Из ИменаУровней Цикл
			Опции = Опции + "<option value=""" + Имя + """" + ?(Имя = ТекущееЗначение, " selected", "") + ">"
				+ Имя + "</option>";
		КонецЦикла;
	КонецЕсли;

	Возврат "<select id=""rv_" + ИндексСтрокой + """ class=""ar-select ar-select-narrow"""
		+ ?(ТолькоПросмотр, " disabled", "") + ">" + Опции + "</select>";

КонецФункции

// Одна строка HTML-таблицы правил доступа: тип, значение (зависимый подбор),
// разрешить (селект да/нет - id ra_N, читается тем же ПрочитатьЗначениеИзDOM,
// что текстовые поля), порядок (input), удаление. Подсветка строки:
//  * ar-rule-dangling - Значение не находит соответствия в реестре для этого
//    типа (часть 3, "висячее имя");
//  * ar-rule-noop - Значение пустое или "*" в разрешающем правиле - критерий
//    синтаксически корректен, но не даёт никакого эффекта (часть 3, отдельный
//    от "висячего" индикатор, см. спеку "Граничные случаи").
// "*" в запрещающем правиле - НЕ подсвечивается: осознанный wildcard-барьер.
//
&НаСервере
Функция HTMLРядПравила(Знач Индекс, Знач Строка, Знач КартаКатегорий, Знач КартаПакетов,
	Знач КартаРеестраTools, Знач ИзвестныеNamespace)

	ИндексСтрокой = Формат(Индекс, "ЧГ=0");

	ИмяТипа = "";
	Если ЗначениеЗаполнено(Строка.ar_ТипПравила) Тогда
		ИмяТипа = ИмяЗначенияПеречисленияТипаПравила(Строка.ar_ТипПравила);
	КонецЕсли;

	Значение = СокрЛП(Строка.ar_Значение);

	СелектТип = СелектТипаПравила(ИндексСтрокой, ИмяТипа);
	СелектЗначение = СелектЗначенияПравила(ИндексСтрокой, ИмяТипа, Значение,
		КартаКатегорий, КартаПакетов, КартаРеестраTools, ИзвестныеNamespace);

	СостояниеРяда = СостояниеСтрокиПравила(ИмяТипа, Значение, Строка.ar_Разрешить,
		КартаКатегорий, КартаПакетов, КартаРеестраTools, ИзвестныеNamespace);

	КлассСтроки = "";
	Подсказка = "";
	Если СостояниеРяда.Висячее Тогда
		КлассСтроки = " class=""ar-rule-dangling""";
		Подсказка = "<div class=""ar-rule-hint ar-rule-hint-dangling"">" + ar_ЭкранироватьHTML(СостояниеРяда.Текст) + "</div>";
	ИначеЕсли СостояниеРяда.НетЭффекта Тогда
		КлассСтроки = " class=""ar-rule-noop""";
		Подсказка = "<div class=""ar-rule-hint ar-rule-hint-noop"">" + ar_ЭкранироватьHTML(СостояниеРяда.Текст) + "</div>";
	КонецЕсли;

	СелектРазрешить = "<select id=""ra_" + ИндексСтрокой + """ class=""ar-select ar-select-narrow"""
		+ ?(ТолькоПросмотр, " disabled", "") + ">"
		+ "<option value=""1""" + ?(Строка.ar_Разрешить, " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='Да'; en='Yes'")) + "</option>"
		+ "<option value=""0""" + ?(НЕ Строка.ar_Разрешить, " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='Нет (запрет)'; en='No (deny)'")) + "</option>"
		+ "</select>";

	ПолеПорядка = ПолеВвода("ro_" + ИндексСтрокой, Формат(Строка.ar_Порядок, "ЧГ=0; ЧДЦ=0"), "ar-input ar-input-narrow");

	Удаление = ?(ТолькоПросмотр, "", СсылкаДействие("rule-del", "idx=" + ИндексСтрокой, "✕", "ar-del"));

	Возврат
		"<tr" + КлассСтроки + ">"
		+ "<td></td>"
		+ "<td>" + СелектТип + "</td>"
		+ "<td>" + СелектЗначение + Подсказка + "</td>"
		+ "<td>" + СелектРазрешить + "</td>"
		+ "<td>" + ПолеПорядка + "</td>"
		+ "<td>" + Удаление + "</td>"
		+ "</tr>";

КонецФункции

// Определяет, "висячая" ли строка правила (Значение не находит соответствия
// в реестре для данного типа - часть 3) или "не даёт эффекта" (пустое
// Значение либо "*" в разрешающем правиле - отдельный индикатор, см. спеку
// "Граничные случаи"). "*" в запрещающем правиле - осознанный барьер, не
// подсвечивается никак (DoD D8).
//
&НаСервере
Функция СостояниеСтрокиПравила(Знач ИмяТипа, Знач Значение, Знач Разрешить,
	Знач КартаКатегорий, Знач КартаПакетов, Знач КартаРеестраTools, Знач ИзвестныеNamespace)

	Результат = Новый Структура("Висячее, НетЭффекта, Текст", Ложь, Ложь, "");

	Если ПустаяСтрока(Значение) Тогда
		Результат.НетЭффекта = Истина;
		Результат.Текст = НСтр("ru='Значение не заполнено - правило ничего не делает (пустое совпадение).';
			|en='Value is empty - the rule has no effect (empty match).'");
		Возврат Результат;
	КонецЕсли;

	Если Значение = "*" Тогда
		Если Разрешить Тогда
			Результат.НетЭффекта = Истина;
			Результат.Текст = НСтр("ru='«*» работает только в запрещающих правилах - это разрешающее правило не действует.';
				|en='«*» only works in deny rules - this allow rule has no effect.'");
		КонецЕсли;
		Возврат Результат; // "*" в запрете - осознанный барьер, не висячее (DoD D8).
	КонецЕсли;

	Если ПустаяСтрока(ИмяТипа) Тогда
		Возврат Результат; // Тип не выбран - подсветка значения не показательна, ошибка заполнения покажет ФормаЭлемента.
	КонецЕсли;

	Если ИмяТипа = "Категория" Тогда
		Если КартаКатегорий.Получить(Значение) = Неопределено Тогда
			Результат.Висячее = Истина;
			Результат.Текст = НСтр("ru='Категория не найдена в справочнике ar_КатегорииTools.';
				|en='Category not found in the ar_КатегорииTools catalog.'");
		КонецЕсли;
	ИначеЕсли ИмяТипа = "Пакет" Тогда
		Если КартаПакетов.Получить(Значение) = Неопределено Тогда
			Результат.Висячее = Истина;
			Результат.Текст = НСтр("ru='Пакет не найден в реестре ar_ПакетыTools (удалён/не установлен).';
				|en='Package not found in the ar_ПакетыTools registry (removed/not installed).'");
		КонецЕсли;
	ИначеЕсли ИмяТипа = "Namespace" Тогда
		Если ИзвестныеNamespace.Получить(Значение) = Неопределено Тогда
			Результат.Висячее = Истина;
			Результат.Текст = НСтр("ru='Namespace не встречается ни у одного зарегистрированного пакета.';
				|en='Namespace is not used by any registered package.'");
		КонецЕсли;
	ИначеЕсли ИмяТипа = "Tool" Тогда
		Если КартаРеестраTools.Получить(ВРег(Значение)) = Неопределено Тогда
			Результат.Висячее = Истина;
			Результат.Текст = НСтр("ru='Инструмент с таким именем не найден в реестре ar_Tools.';
				|en='No tool with this name found in the ar_Tools registry.'");
		КонецЕсли;
	ИначеЕсли ИмяТипа = "RiskLevel" Тогда
		Если Значение <> "Read" И Значение <> "Draft" И Значение <> "Write" И Значение <> "Commit" Тогда
			Результат.Висячее = Истина;
			Результат.Текст = НСтр("ru='Недопустимое значение RiskLevel (ожидается Read/Draft/Write/Commit).';
				|en='Invalid RiskLevel value (expected Read/Draft/Write/Commit).'");
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Программное имя значения перечисления ar_ТипПравилаДоступа - тот же приём,
// что ar_ToolAccessRules.ИмяТипаПравила (DefaultLanguage=Русский делает
// Строка() непригодной для сравнения с латинскими кодами типов).
//
&НаСервере
Функция ИмяЗначенияПеречисленияТипаПравила(Знач ЗначениеПеречисления)

	Для Каждого ОписаниеЗначения Из Метаданные.Перечисления.ar_ТипПравилаДоступа.ЗначенияПеречисления Цикл
		Если Перечисления.ar_ТипПравилаДоступа[ОписаниеЗначения.Имя] = ЗначениеПеречисления Тогда
			Возврат ОписаниеЗначения.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Соответствие "Код категории -> Наименование" из Справочник.ar_КатегорииTools -
// источник истины для подсветки "висячей категории" (спека SCALE-08, «Риски»:
// справочник корректнее фактических значений у tools, т.к. категория может
// существовать, но временно не иметь ни одного tool).
//
&НаСервере
Функция КартаКатегорийTools()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Категории.Код КАК Код,
		|	Категории.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ar_КатегорииTools КАК Категории
		|ГДЕ
		|	НЕ Категории.ПометкаУдаления";

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Выборка.Код);
		Если Не ПустаяСтрока(Код) Тогда
			Карта.Вставить(Код, Выборка.Наименование);
		КонецЕсли;
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Соответствие "ar_ИдентификаторОбработки -> ar_ИмяОбъектаОбработки" из
// РегистрСведений.ar_ПакетыTools - источник истины для подбора и подсветки
// "висячего пакета" (независимо от текущего статуса - пакет мог быть отключён,
// но ещё существует в реестре; отсутствие записи вовсе - висячий случай).
//
&НаСервере
Функция КартаПакетовTools()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_ИдентификаторОбработки КАК Идентификатор,
		|	Пакеты.ar_ИмяОбъектаОбработки КАК Имя
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты";

	Карта = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Идентификатор = СокрЛП(Выборка.Идентификатор);
		Если Не ПустаяСтрока(Идентификатор) Тогда
			Представление = Выборка.Имя;
			Если ПустаяСтрока(Представление) Тогда
				Представление = Идентификатор;
			КонецЕсли;
			Карта.Вставить(Идентификатор, Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Блок предпросмотра эффективного набора tools (SCALE-08, часть 2). Источник
// данных - СТРОГО ar_ToolAccessRules.ЭффективныйНаборTools(Объект.Ссылка), без
// собственной реконструкции union/deny (DoD D9) - тот же принцип, что уже
// закреплён в ar_PermissionEngine/ar_RuntimeКонтекст (SCALE-07).
//
&НаСервере
Функция HTMLБлокПредпросмотраНабора()

	Набор = ar_ToolAccessRules.ЭффективныйНаборTools(Объект.Ссылка);

	Если Набор = Неопределено Тогда
		Возврат
			"<div class=""ar-card""><h2>" + ar_ЭкранироватьHTML(НСтр("ru='Предпросмотр набора'; en='Set preview'")) + "</h2>"
			+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Сохраните агента, чтобы увидеть предпросмотр набора.'; en='Save the agent to see the set preview.'"))
			+ "</div></div>";
	КонецЕсли;

	N = Набор.Количество();

	ЕстьЯвныйСписокИлиПравила = (Объект.ar_ДоступныеTools.Количество() > 0)
		ИЛИ (Объект.ar_ПравилаДоступаTools.Количество() > 0);

	Пояснение = "";
	Если N = 0 Тогда
		Если ЕстьБарьерНамespaceДляВсех() Тогда
			Пояснение = "<div class=""ar-note ar-note-warn"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Агент не может вызвать ни один инструмент - действует запрещающее правило по всем namespace (Namespace = «*», Разрешить = Нет). Такое правило-барьер заводится автоматически при обновлении расширения, чтобы не расширить права агента молча (SCALE-07). Удалите или сузьте это правило, если агенту нужны инструменты.';
					|en='The agent cannot call any tool - a deny rule for all namespaces is active (Namespace = «*», Allow = No). This barrier rule is added automatically during extension update so agent rights are never silently widened (SCALE-07). Remove or narrow this rule if the agent needs tools.'"))
				+ "</div>";
		Иначе
			Пояснение = "<div class=""ar-note ar-note-warn"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Набор пуст. Проверьте правила и явный список вкладки «Tools».';
					|en='The set is empty. Check the rules and the explicit list on the «Tools» tab.'"))
				+ "</div>";
		КонецЕсли;
	ИначеЕсли НЕ ЕстьЯвныйСписокИлиПравила Тогда
		Пояснение = "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Явный список и правила доступа пусты - агенту доступен весь реестр (текущее решение SCALE-07 для пустой настройки, а не ошибка).';
				|en='The explicit list and access rules are empty - the agent gets the whole registry (SCALE-07 behaviour for an empty configuration, not an error).'"))
			+ "</div>";
	КонецЕсли;

	Порог = ar_Константы.ПорогПрогрессивнойВыдачи();
	Если N > Порог Тогда
		Строки = Набор.НайтиСтроки(Новый Структура("ВсегдаВКонтексте", Истина));
		ВсегдаВКонтексте = Строки.Количество();
		Пояснение = Пояснение
			+ "<div class=""ar-note ar-note-warn"">" + ar_ЭкранироватьHTML(СтрШаблон(
				НСтр("ru='Агент превышает порог прогрессивной выдачи (%1): в промпт сразу попадёт %2 инструментов с пометкой «Всегда в контексте», остальные %3 агент дозагрузит через find_tools/describe_tool.';
					|en='The agent exceeds the progressive disclosure threshold (%1): %2 tools marked «Always in context» go into the prompt immediately, the remaining %3 are fetched by the agent via find_tools/describe_tool.'"),
				Порог, ВсегдаВКонтексте, N - ВсегдаВКонтексте)) + "</div>";
	КонецЕсли;

	КартаРеестраДляСтрок = КартаToolsРеестра();

	Ряды = "";
	Для Каждого СтрокаНабора Из Набор Цикл
		ИмяКатегорииПредставление = СтрокаНабора.КодКатегории;
		ДанныеРеестра = КартаРеестраДляСтрок[ВРег(СтрокаНабора.ИмяTool)];
		БейджРиска = "";
		Если ДанныеРеестра <> Неопределено Тогда
			БейджРиска = "<span class=""ar-risk ar-risk-" + ДанныеРеестра.RiskLevel + """>"
				+ ar_ЭкранироватьHTML(ДанныеРеестра.RiskLevelПредставление) + "</span>";
		КонецЕсли;
		Ряды = Ряды
			+ "<tr>"
			+ "<td><code>" + ar_ЭкранироватьHTML(СтрокаНабора.ИмяTool) + "</code></td>"
			+ "<td>" + ar_ЭкранироватьHTML(ИмяКатегорииПредставление) + "</td>"
			+ "<td>" + БейджРиска + "</td>"
			+ "<td>" + ?(СтрокаНабора.ВсегдаВКонтексте, ar_ЭкранироватьHTML(НСтр("ru='Да'; en='Yes'")), "") + "</td>"
			+ "</tr>";
	КонецЦикла;

	Если N = 0 Тогда
		Ряды = "<tr><td colspan=""4"" class=""ar-empty"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Пусто.'; en='Empty.'")) + "</td></tr>";
	КонецЕсли;

	Счетчик = СтрШаблон(НСтр("ru='Всего в наборе: %1'; en='Total in the set: %1'"), N);

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Предпросмотр набора'; en='Set preview'")) + "</h2>"
		+ "<span class=""ar-counter"">" + ar_ЭкранироватьHTML(Счетчик) + "</span>"
		+ "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Данные строго из ar_ToolAccessRules.ЭффективныйНаборTools - то же, что реально увидит и разрешит агенту рантайм.';
				|en='Data strictly from ar_ToolAccessRules.ЭффективныйНаборTools - exactly what the runtime will actually see and allow the agent.'")) + "</div>"
		+ Пояснение
		+ "<table class=""ar-table""><thead><tr>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Tool'; en='Tool'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Категория'; en='Category'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Риск'; en='Risk'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Всегда в контексте'; en='Always in context'")) + "</th>"
		+ "</tr></thead><tbody>" + Ряды + "</tbody></table>"
		+ "</div>";

КонецФункции

// Проверяет, есть ли у сохранённого агента запрещающее правило-барьер
// Namespace="*" (миграция SCALE-07) - используется только для текста
// пояснения пустого предпросмотра, не для расчёта самого набора (DoD D9).
//
&НаСервере
Функция ЕстьБарьерНамespaceДляВсех()

	Строки = Объект.ar_ПравилаДоступаTools.НайтиСтроки(Новый Структура("ar_Значение", "*"));
	Для Каждого Строка Из Строки Цикл
		Если НЕ Строка.ar_Разрешить
			И ЗначениеЗаполнено(Строка.ar_ТипПравила)
			И ИмяЗначенияПеречисленияТипаПравила(Строка.ar_ТипПравила) = "Namespace" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Одна строка таблицы tools: переключатель, имя, бейдж риска, признак approval,
// краткое описание, удаление.
//
&НаСервере
Функция HTMLРядTool(Знач Индекс, Знач Строка, Знач КартаРеестра)

	ИндексСтрокой = Формат(Индекс, "ЧГ=0");
	ДанныеРеестра = КартаРеестра[ВРег(Строка.ar_Tool)];

	Если ДанныеРеестра = Неопределено Тогда
		БейджРиска = "<span class=""ar-risk ar-risk-unknown"">" + ar_ЭкранироватьHTML(
			НСтр("ru='не в реестре'; en='not in registry'")) + "</span>";
		ПризнакApproval = "-";
		Описание = "";
	Иначе
		БейджРиска = "<span class=""ar-risk ar-risk-" + ДанныеРеестра.RiskLevel + """>"
			+ ar_ЭкранироватьHTML(ДанныеРеестра.RiskLevelПредставление) + "</span>";
		ПризнакApproval = ?(ДанныеРеестра.ТребуетApproval,
			НСтр("ru='Да'; en='Yes'"), НСтр("ru='Нет'; en='No'"));
		Описание = ar_Утилиты.ОбрезатьДо(ДанныеРеестра.Описание, 160);
	КонецЕсли;

	Переключение = ?(ТолькоПросмотр,
		?(Строка.ar_Включен, "✓", "○"),
		СсылкаДействие("toggle-tool", "idx=" + ИндексСтрокой,
			?(Строка.ar_Включен, НСтр("ru='Вкл'; en='On'"), НСтр("ru='Выкл'; en='Off'")),
			"ar-toggle " + ?(Строка.ar_Включен, "ar-toggle-on", "ar-toggle-off")));

	Удаление = ?(ТолькоПросмотр, "",
		СсылкаДействие("remove-tool", "idx=" + ИндексСтрокой, "✕", "ar-del"));

	Возврат
		"<tr>"
		+ "<td>" + Переключение + "</td>"
		+ "<td><code>" + ar_ЭкранироватьHTML(Строка.ar_Tool) + "</code></td>"
		+ "<td>" + БейджРиска + "</td>"
		+ "<td>" + ar_ЭкранироватьHTML(ПризнакApproval) + "</td>"
		+ "<td class=""ar-desc"">" + ar_ЭкранироватьHTML(Описание) + "</td>"
		+ "<td>" + Удаление + "</td>"
		+ "</tr>";

КонецФункции

// Вкладка «Расписание»: таблица рутин агента (UI-20).
//
&НаСервере
Функция HTMLСекцияРасписание()

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат
			"<div class=""ar-card""><div class=""ar-note"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Сохраните агента, чтобы управлять расписанием.';
					|en='Save the agent to manage its schedule.'")) + "</div></div>";
	КонецЕсли;

	Рутины = РутиныАгента();

	Ряды = "";
	Для Каждого Рутина Из Рутины Цикл
		Ид = Рутина.Ид;
		БейджАктивности = ?(Рутина.Активна,
			"<span class=""ar-badge-on"">" + ar_ЭкранироватьHTML(НСтр("ru='активна'; en='active'")) + "</span>",
			"<span class=""ar-badge-off"">" + ar_ЭкранироватьHTML(НСтр("ru='выкл'; en='off'")) + "</span>");
		Действия = СсылкаДействие("rt-open", "id=" + Ид, НСтр("ru='Открыть'; en='Open'"), "ar-btn ar-btn-small")
			+ ?(ТолькоПросмотр, "", СсылкаДействие("rt-del", "id=" + Ид, "✕", "ar-del"));
		Ряды = Ряды
			+ "<tr>"
			+ "<td>" + ar_ЭкранироватьHTML(Рутина.Имя) + "</td>"
			+ "<td>" + ar_ЭкранироватьHTML(Рутина.ТипТриггера) + "</td>"
			+ "<td>" + БейджАктивности + "</td>"
			+ "<td class=""ar-desc"">" + ar_ЭкранироватьHTML(ar_Утилиты.ОбрезатьДо(Рутина.ПараметрыJSON, 120)) + "</td>"
			+ "<td>" + Действия + "</td>"
			+ "</tr>";
	КонецЦикла;

	Если Рутины.Количество() = 0 Тогда
		Ряды = "<tr><td colspan=""5"" class=""ar-empty"">" + ar_ЭкранироватьHTML(
			НСтр("ru='У агента нет рутин.'; en='The agent has no routines.'")) + "</td></tr>";
	КонецЕсли;

	КнопкаДобавления = ?(ТолькоПросмотр, "",
		СсылкаДействие("rt-add", "", НСтр("ru='+ Добавить рутину'; en='+ Add routine'"), "ar-btn"));

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Рутины агента'; en='Agent routines'")) + "</h2>"
		+ КнопкаДобавления
		+ "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Рутины - автоматические запуски агента по триггеру (cron-расписание, событие, webhook). Триггер, параметры и статус настраиваются в карточке рутины; здесь - обзор и быстрые действия.';
				|en='Routines are automatic agent runs by trigger (cron schedule, event, webhook). Trigger, parameters and status are configured in the routine card; this is an overview with quick actions.'")) + "</div>"
		+ "<table class=""ar-table""><thead><tr>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Имя'; en='Name'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Триггер'; en='Trigger'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Статус'; en='Status'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Параметры'; en='Parameters'")) + "</th>"
		+ "<th></th>"
		+ "</tr></thead><tbody>" + Ряды + "</tbody></table>"
		+ "</div>";

КонецФункции

// Вкладка «LLM»: провайдер, модель, температура, лимиты и переопределения промпта.
//
&НаСервере
Функция HTMLСекцияLLM()

	ПредставлениеПровайдера = ?(ЗначениеЗаполнено(Объект.ar_LLMПровайдер),
		Строка(Объект.ar_LLMПровайдер), НСтр("ru='(не выбран)'; en='(not set)'"));

	РядыKV = "";
	КоличествоKV = Объект.ar_ПереопределенияПромпта.Количество();
	Для Индекс = 0 По КоличествоKV - 1 Цикл
		СтрокаKV = Объект.ar_ПереопределенияПромпта[Индекс];
		ИндексСтрокой = Формат(Индекс, "ЧГ=0");
		РядыKV = РядыKV
			+ "<tr>"
			+ "<td>" + ПолеВвода("kvk_" + ИндексСтрокой, СтрокаKV.ar_Ключ, "ar-input") + "</td>"
			+ "<td>" + ПолеВвода("kvv_" + ИндексСтрокой, СтрокаKV.ar_Значение, "ar-input ar-input-wide") + "</td>"
			+ "<td>" + ?(ТолькоПросмотр, "",
				СсылкаДействие("kv-del", "idx=" + ИндексСтрокой, "✕", "ar-del")) + "</td>"
			+ "</tr>";
	КонецЦикла;

	Если КоличествоKV = 0 Тогда
		РядыKV = "<tr><td colspan=""3"" class=""ar-empty"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Переопределений нет.'; en='No overrides.'")) + "</td></tr>";
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ СтрокаПоля(НСтр("ru='LLM-провайдер'; en='LLM provider'"),
			"<span class=""ar-refval"">" + ar_ЭкранироватьHTML(ПредставлениеПровайдера) + "</span>"
			+ ?(ТолькоПросмотр, "", СсылкаДействие("pick-provider", "",
				НСтр("ru='Выбрать…'; en='Select…'"), "ar-btn ar-btn-small")),
			НСтр("ru='Подключение к LLM (адрес, ключ, тип API) из реестра провайдеров. Без провайдера агент не сможет обратиться к модели.';
				|en='LLM connection (URL, key, API type) from the provider registry. Without a provider the agent cannot reach the model.'"))
		+ СтрокаПоля(НСтр("ru='Модель'; en='Model'"),
			ПолеВвода("fld_model", Объект.ar_Модель, "ar-input ar-input-wide"),
			НСтр("ru='Имя модели в API провайдера (например, gpt-4o, qwen2.5-32b). Должно совпадать с именем на стороне провайдера.';
				|en='Model name in the provider''s API (e.g. gpt-4o, qwen2.5-32b). Must match the name on the provider side.'"))
		+ СтрокаПоля(НСтр("ru='Температура'; en='Temperature'"),
			ПолеВвода("fld_temp", Формат(Объект.ar_Температура, "ЧДЦ=2; ЧРД=.; ЧГ=0"), "ar-input"),
			НСтр("ru='Случайность генерации: 0 - максимально предсказуемые ответы, ближе к 1 - разнообразнее. Для рабочих агентов обычно 0-0.7.';
				|en='Sampling randomness: 0 - most predictable answers, closer to 1 - more diverse. Working agents usually use 0-0.7.'"))
		+ СтрокаПоля(НСтр("ru='Макс. шагов'; en='Max steps'"),
			ПолеВвода("fld_maxsteps", Формат(Объект.ar_МаксШагов, "ЧГ=0; ЧДЦ=0"), "ar-input"),
			НСтр("ru='Предел итераций «рассуждения» LLM за один запуск - защита от зацикливания. По исчерпании запуск останавливается.';
				|en='Limit of LLM reasoning iterations per run - guards against infinite loops. The run stops when exhausted.'"))
		+ СтрокаПоля(НСтр("ru='Макс. действий'; en='Max actions'"),
			ПолеВвода("fld_maxactions", Формат(Объект.ar_МаксДействий, "ЧГ=0; ЧДЦ=0"), "ar-input"),
			НСтр("ru='Предел вызовов инструментов (tools) за один запуск.';
				|en='Limit of tool calls per run.'"))
		+ СтрокаПоля(НСтр("ru='Макс. сумма действия'; en='Max action amount'"),
			ПолеВвода("fld_maxsum", Формат(Объект.ar_МаксСуммаДействия, "ЧГ=0; ЧДЦ=0"), "ar-input"),
			НСтр("ru='Денежный предел одного действия: если сумма в аргументах инструмента больше лимита, действие блокируется. 0 - без ограничения.';
				|en='Monetary cap per action: if the amount in tool arguments exceeds the limit, the action is denied. 0 - no limit.'"))
		+ "</div>"
		+ "<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Переопределения промпта'; en='Prompt overrides'")) + "</h2>"
		+ ?(ТолькоПросмотр, "", СсылкаДействие("kv-add", "", НСтр("ru='+ Строка'; en='+ Row'"), "ar-btn ar-btn-small"))
		+ "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Каждая пара добавляется в системный prompt отдельным блоком «[Ключ]» с текстом значения - удобно дописать или переопределить отдельное правило, не трогая основную инструкцию.';
				|en='Each pair is appended to the system prompt as a separate «[Key]» block with the value text - handy for adding or overriding a single rule without touching the main instruction.'")) + "</div>"
		+ "<table class=""ar-table""><thead><tr>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Ключ'; en='Key'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Значение'; en='Value'")) + "</th>"
		+ "<th></th>"
		+ "</tr></thead><tbody>" + РядыKV + "</tbody></table>"
		+ "</div>";

КонецФункции

// Вкладка «Память»: последние записи памяти агента + подключённые skills (UI-18).
//
&НаСервере
Функция HTMLСекцияПамять()

	// --- Память ---
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаписиПамяти = ПамятьАгента();
		РядыПамяти = "";
		Для Каждого Запись Из ЗаписиПамяти Цикл
			РядыПамяти = РядыПамяти
				+ "<tr>"
				+ "<td>" + ar_ЭкранироватьHTML(Запись.Тип) + "</td>"
				+ "<td class=""ar-desc"">" + ar_ЭкранироватьHTML(ar_Утилиты.ОбрезатьДо(Запись.Текст, 140)) + "</td>"
				+ "<td>" + ar_ЭкранироватьHTML(Запись.КлючевыеСлова) + "</td>"
				+ "<td>" + ar_ЭкранироватьHTML(Формат(Запись.Обновлено, "ДЛФ=DT")) + "</td>"
				+ "<td>" + ar_ЭкранироватьHTML(Запись.Источник) + "</td>"
				+ "<td>" + СсылкаДействие("mem-open", "id=" + Запись.Ид,
					НСтр("ru='Открыть'; en='Open'"), "ar-btn ar-btn-small") + "</td>"
				+ "</tr>";
		КонецЦикла;
		Если ЗаписиПамяти.Количество() = 0 Тогда
			РядыПамяти = "<tr><td colspan=""6"" class=""ar-empty"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Записей памяти нет.'; en='No memory records.'")) + "</td></tr>";
		КонецЕсли;

		ЕстьПравоДобавления = ПравоДоступа("Добавление", Метаданные.Справочники.ar_ПамятьАгента);
		КнопкаПамяти = ?(ЕстьПравоДобавления И НЕ ТолькоПросмотр,
			СсылкаДействие("mem-add", "", НСтр("ru='+ Добавить запись'; en='+ Add record'"), "ar-btn"), "");

		СекцияПамяти =
			"<div class=""ar-card"">"
			+ "<div class=""ar-card-head"">"
			+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Память агента'; en='Agent memory'")) + "</h2>"
			+ КнопкаПамяти
			+ "</div>"
			+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Долгосрочная память: факты и выводы, которые подмешиваются в prompt при каждом запуске (Memory Index). Записи создаёт сам агент или пользователь вручную; показаны последние 50.';
					|en='Long-term memory: facts and conclusions mixed into the prompt on every run (Memory Index). Records are created by the agent itself or manually; the latest 50 are shown.'")) + "</div>"
			+ "<table class=""ar-table""><thead><tr>"
			+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Тип'; en='Type'")) + "</th>"
			+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Текст'; en='Text'")) + "</th>"
			+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Ключевые слова'; en='Keywords'")) + "</th>"
			+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Обновлено'; en='Updated'")) + "</th>"
			+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Источник'; en='Source'")) + "</th>"
			+ "<th></th>"
			+ "</tr></thead><tbody>" + РядыПамяти + "</tbody></table>"
			+ "</div>";
	Иначе
		СекцияПамяти =
			"<div class=""ar-card""><div class=""ar-note"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Сохраните агента, чтобы работать с памятью.';
					|en='Save the agent to work with its memory.'")) + "</div></div>";
	КонецЕсли;

	// --- Skills ---
	РядыSkills = "";
	КоличествоSkills = Объект.ar_ПодключённыеSkills.Количество();
	Для Индекс = 0 По КоличествоSkills - 1 Цикл
		СтрокаSkill = Объект.ar_ПодключённыеSkills[Индекс];
		ИндексСтрокой = Формат(Индекс, "ЧГ=0");
		Переключение = ?(ТолькоПросмотр,
			?(СтрокаSkill.ar_Включен, "✓", "○"),
			СсылкаДействие("skill-toggle", "idx=" + ИндексСтрокой,
				?(СтрокаSkill.ar_Включен, НСтр("ru='Вкл'; en='On'"), НСтр("ru='Выкл'; en='Off'")),
				"ar-toggle " + ?(СтрокаSkill.ar_Включен, "ar-toggle-on", "ar-toggle-off")));
		РядыSkills = РядыSkills
			+ "<tr>"
			+ "<td>" + Переключение + "</td>"
			+ "<td>" + ar_ЭкранироватьHTML(Строка(СтрокаSkill.ar_Skill)) + "</td>"
			+ "<td>" + ПолеВвода("ord_" + ИндексСтрокой,
				Формат(СтрокаSkill.ar_Порядок, "ЧГ=0; ЧДЦ=0"), "ar-input ar-input-narrow") + "</td>"
			+ "<td>" + ?(ТолькоПросмотр, "",
				СсылкаДействие("skill-del", "idx=" + ИндексСтрокой, "✕", "ar-del")) + "</td>"
			+ "</tr>";
	КонецЦикла;

	Если КоличествоSkills = 0 Тогда
		РядыSkills = "<tr><td colspan=""4"" class=""ar-empty"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Skills не подключены.'; en='No skills attached.'")) + "</td></tr>";
	КонецЕсли;

	СекцияSkills =
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Подключённые skills'; en='Attached skills'")) + "</h2>"
		+ ?(ТолькоПросмотр, "", СсылкаДействие("skill-add", "",
			НСтр("ru='+ Добавить skill'; en='+ Add skill'"), "ar-btn ar-btn-small"))
		+ "</div>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Skills - готовые блоки инструкций из реестра ar_Skills. Включённые добавляются в prompt по возрастанию колонки «Порядок»: меньше число - выше по тексту.';
				|en='Skills are reusable instruction blocks from the ar_Skills registry. Enabled ones are appended to the prompt in ascending «Order»: lower number - higher in the text.'")) + "</div>"
		+ "<table class=""ar-table""><thead><tr>"
		+ "<th></th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Skill'; en='Skill'")) + "</th>"
		+ "<th>" + ar_ЭкранироватьHTML(НСтр("ru='Порядок'; en='Order'")) + "</th>"
		+ "<th></th>"
		+ "</tr></thead><tbody>" + РядыSkills + "</tbody></table>"
		+ "</div>";

	Возврат СекцияПамяти + СекцияSkills;

КонецФункции

// Вкладка «Тест»: текст запроса, dry-run, запуск и панель результата (UI-05).
//
&НаСервере
Функция HTMLСекцияТест()

	ПанельРезультата = "";
	Если НЕ ПустаяСтрока(СтатусПоследнегоЗапуска) Тогда
		СсылкаНаViewer = "";
		Если НЕ ПустаяСтрока(ПоследнийRunId) Тогда
			СсылкаНаViewer = "<div>RunId: <code>" + ar_ЭкранироватьHTML(ПоследнийRunId) + "</code> "
				+ СсылкаДействие("open-run", "", НСтр("ru='Открыть Run Viewer'; en='Open Run Viewer'"),
					"ar-btn ar-btn-small") + "</div>";
		КонецЕсли;
		ПанельРезультата =
			"<div class=""ar-card""><h2>" + ar_ЭкранироватьHTML(НСтр("ru='Результат'; en='Result'")) + "</h2>"
			+ "<div class=""ar-runstatus"">" + ar_ЭкранироватьHTML(СтатусПоследнегоЗапуска) + "</div>"
			+ СсылкаНаViewer
			+ "</div>";
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Тестовый запуск'; en='Test run'")) + "</h2>"
		+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Проверка агента без ожидания триггера: текст ниже уходит как сообщение пользователя. Dry-run - пробный прогон: цикл и выбор инструментов работают, но реальные изменения не применяются (запреты безопасности действуют как обычно). Ход запуска смотрите в Run Viewer.';
				|en='Check the agent without waiting for a trigger: the text below is sent as a user message. Dry-run is a rehearsal: the loop and tool selection work, but no real changes are applied (safety denials still apply). Watch the run in the Run Viewer.'")) + "</div>"
		+ "<textarea id=""fld_testreq"" class=""ar-textarea ar-textarea-instr"" rows=""6"" placeholder="""
		+ ar_ЭкранироватьHTML(НСтр("ru='Текст запроса к агенту...'; en='Request text for the agent...'")) + """>"
		+ ar_ЭкранироватьHTML(ТестовыйЗапрос) + "</textarea>"
		+ "<div class=""ar-toolbar"">"
		+ СсылкаДействие("toggle", "key=dryrun",
			?(DryRun, НСтр("ru='Dry-run: Вкл'; en='Dry-run: On'"), НСтр("ru='Dry-run: Выкл'; en='Dry-run: Off'")),
			"ar-toggle " + ?(DryRun, "ar-toggle-on", "ar-toggle-off"))
		+ СсылкаДействие("test-run", "", НСтр("ru='▶ Выполнить'; en='▶ Execute'"), "ar-btn ar-btn-primary")
		+ "</div>"
		+ "</div>"
		+ ПанельРезультата;

КонецФункции

#КонецОбласти

#Область HTMLЭлементы

// Строка «подпись + описание + редактор» карточки (аналог ar-setting в
// ar_Настройки). Описание - короткая подсказка, зачем заполнять поле.
//
&НаСервере
Функция СтрокаПоля(Знач Подпись, Знач РедакторHTML, Знач Описание = "")

	ОписаниеHTML = "";
	Если НЕ ПустаяСтрока(Описание) Тогда
		ОписаниеHTML = "<div class=""ar-setting-desc"">" + ar_ЭкранироватьHTML(Описание) + "</div>";
	КонецЕсли;

	Возврат
		"<div class=""ar-setting"">"
		+ "<div class=""ar-setting-info"">"
		+ "<div class=""ar-setting-label"">" + ar_ЭкранироватьHTML(Подпись) + "</div>"
		+ ОписаниеHTML
		+ "</div>"
		+ "<div class=""ar-setting-editor"">" + РедакторHTML + "</div>"
		+ "</div>";

КонецФункции

&НаСервере
Функция ПолеВвода(Знач Ид, Знач Значение, Знач КлассCSS)

	Возврат "<input id=""" + Ид + """ class=""" + КлассCSS + """ type=""text"" value="""
		+ ar_ЭкранироватьHTML("" + Значение) + """" + ?(ТолькоПросмотр, " readonly", "") + ">";

КонецФункции

// Переключатель булева реквизита - ссылка-действие toggle с ключом.
//
&НаСервере
Функция Переключатель(Знач Ключ, Знач Включен)

	Если ТолькоПросмотр Тогда
		Возврат ?(Включен, "✓", "○");
	КонецЕсли;

	Возврат СсылкаДействие("toggle", "key=" + Ключ,
		?(Включен, НСтр("ru='Вкл'; en='On'"), НСтр("ru='Выкл'; en='Off'")),
		"ar-toggle " + ?(Включен, "ar-toggle-on", "ar-toggle-off"));

КонецФункции

// Селект режима автономии из значений перечисления ar_РежимАвтономии.
//
&НаСервере
Функция СелектРежимаАвтономии()

	ИмяТекущего = "";
	Для Каждого ОписаниеЗначения Из Метаданные.Перечисления.ar_РежимАвтономии.ЗначенияПеречисления Цикл
		Если Объект.ar_РежимАвтономии = Перечисления.ar_РежимАвтономии[ОписаниеЗначения.Имя] Тогда
			ИмяТекущего = ОписаниеЗначения.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Опции = "";
	Для Каждого ОписаниеЗначения Из Метаданные.Перечисления.ar_РежимАвтономии.ЗначенияПеречисления Цикл
		Представление = ОписаниеЗначения.Синоним;
		Если ПустаяСтрока(Представление) Тогда
			Представление = ОписаниеЗначения.Имя;
		КонецЕсли;
		Опции = Опции + "<option value=""" + ОписаниеЗначения.Имя + """"
			+ ?(ОписаниеЗначения.Имя = ИмяТекущего, " selected", "") + ">"
			+ ar_ЭкранироватьHTML(Представление) + "</option>";
	КонецЦикла;

	Возврат "<select id=""sel_autonomy"" class=""ar-select"""
		+ ?(ТолькоПросмотр, " disabled", "") + ">" + Опции + "</select>";

КонецФункции

// Селект ролей: все роли текущей конфигурации (основная, БСП, все расширения,
// в т.ч. ar_*), отсортированные по представлению. Пустое значение - «роль не
// проверяется» (см. RT-10, ОбработкаПроверкиЗаполнения).
//
&НаСервере
Функция СелектРолей()

	СписокРолей = Новый СписокЗначений;
	Для Каждого ОписаниеРоли Из Метаданные.Роли Цикл
		Представление = ОписаниеРоли.Синоним;
		Если ПустаяСтрока(Представление) Тогда
			Представление = ОписаниеРоли.Имя;
		КонецЕсли;
		СписокРолей.Добавить(ОписаниеРоли.Имя, Представление);
	КонецЦикла;
	СписокРолей.СортироватьПоПредставлению();

	Опции = "<option value=""""" + ?(ПустаяСтрока(Объект.ar_ИмяРоли1С), " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='(не проверяется)'; en='(not checked)'")) + "</option>";
	Для Каждого ЭлементСписка Из СписокРолей Цикл
		Опции = Опции + "<option value=""" + ar_ЭкранироватьHTML(ЭлементСписка.Значение) + """"
			+ ?(ЭлементСписка.Значение = Объект.ar_ИмяРоли1С, " selected", "") + ">"
			+ ar_ЭкранироватьHTML(ЭлементСписка.Представление) + "</option>";
	КонецЦикла;

	Возврат "<select id=""sel_role"" class=""ar-select"""
		+ ?(ТолькоПросмотр, " disabled", "") + ">" + Опции + "</select>";

КонецФункции

// Селект фильтра risk_level для подбора tools («Все» = пустое значение).
//
&НаСервере
Функция СелектФильтраRisk()

	ИменаУровней = Новый Массив;
	ИменаУровней.Добавить("Read");
	ИменаУровней.Добавить("Draft");
	ИменаУровней.Добавить("Write");
	ИменаУровней.Добавить("Commit");

	Опции = "<option value=""""" + ?(ПустаяСтрока(ФильтрRiskLevel), " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='Все уровни риска'; en='All risk levels'")) + "</option>";
	Для Каждого Имя Из ИменаУровней Цикл
		Опции = Опции + "<option value=""" + Имя + """"
			+ ?(Имя = ФильтрRiskLevel, " selected", "") + ">" + Имя + "</option>";
	КонецЦикла;

	Возврат "<select id=""sel_riskfilter"" class=""ar-select ar-select-narrow"">" + Опции + "</select>";

КонецФункции

// Селект фильтра категории для подбора tools (SCALE-08, часть 1б) - источник
// значений Справочник.ar_КатегорииTools (Код/Наименование), «Все» = пустое
// значение. Тот же стиль, что СелектФильтраRisk выше.
//
&НаСервере
Функция СелектФильтраКатегория()

	Опции = "<option value=""""" + ?(ПустаяСтрока(ФильтрКатегория), " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='Все категории'; en='All categories'")) + "</option>";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Категории.Код КАК Код,
		|	Категории.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ar_КатегорииTools КАК Категории
		|ГДЕ
		|	НЕ Категории.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Категории.ar_Порядок,
		|	Категории.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Выборка.Код);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Опции = Опции + "<option value=""" + ar_ЭкранироватьHTML(Код) + """"
			+ ?(Код = ФильтрКатегория, " selected", "") + ">"
			+ ar_ЭкранироватьHTML(Выборка.Наименование) + "</option>";
	КонецЦикла;

	Возврат "<select id=""sel_catfilter"" class=""ar-select ar-select-narrow"">" + Опции + "</select>";

КонецФункции

// Селект фильтра пакета для подбора tools (SCALE-08, часть 1б) - источник
// значений РегистрСведений.ar_ПакетыTools (PKG-03), значение - строковый
// ar_ИдентификаторОбработки, представление - ar_ИмяОбъектаОбработки. Только
// пакеты со статусом «Зарегистрирован»/«ТребуетПереподтверждения» - отбор
// заведомо неактивного пакета не даст кандидатов (ar_Tools таких пакетов
// ar_Доступен=Ложь и в подбор всё равно не попадут).
//
&НаСервере
Функция СелектФильтраПакет()

	Опции = "<option value=""""" + ?(ПустаяСтрока(ФильтрПакет), " selected", "") + ">"
		+ ar_ЭкранироватьHTML(НСтр("ru='Все пакеты'; en='All packages'")) + "</option>";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_ИдентификаторОбработки КАК Идентификатор,
		|	Пакеты.ar_ИмяОбъектаОбработки КАК Имя
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Статус В (""Зарегистрирован"", ""ТребуетПереподтверждения"")
		|УПОРЯДОЧИТЬ ПО
		|	Имя";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Идентификатор = СокрЛП(Выборка.Идентификатор);
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Представление = Выборка.Имя;
		Если ПустаяСтрока(Представление) Тогда
			Представление = Идентификатор;
		КонецЕсли;
		Опции = Опции + "<option value=""" + ar_ЭкранироватьHTML(Идентификатор) + """"
			+ ?(Идентификатор = ФильтрПакет, " selected", "") + ">"
			+ ar_ЭкранироватьHTML(Представление) + "</option>";
	КонецЦикла;

	Возврат "<select id=""sel_pkgfilter"" class=""ar-select ar-select-narrow"">" + Опции + "</select>";

КонецФункции

// Формирует HTML-ссылку-действие с href схемы "1c://".
//
// Параметры:
//  Действие         - Строка - имя действия (tab/save/toggle/...).
//  ПараметрыЗапроса - Строка - строка query-параметров ("key=..." или "").
//  Текст            - Строка - видимый текст ссылки.
//  КлассCSS         - Строка - CSS-классы.
//
&НаСервере
Функция СсылкаДействие(Знач Действие, Знач ПараметрыЗапроса, Знач Текст, Знач КлассCSS)

	Href = "1c://" + Действие;
	Если Не ПустаяСтрока(ПараметрыЗапроса) Тогда
		Href = Href + "?" + ПараметрыЗапроса;
	КонецЕсли;

	Возврат "<a href=""" + Href + """ class=""" + КлассCSS + """>" + ar_ЭкранироватьHTML(Текст) + "</a>";

КонецФункции

