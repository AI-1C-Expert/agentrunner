//////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Рутины (ROUT-01).
//
// Динамический список рутин с отбором по агенту.
//////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// Если форма открыта с параметром Агент - установить фильтр.
	АгентПараметр = Неопределено;
	Параметры.Свойство("Агент", АгентПараметр);
	Если АгентПараметр <> Неопределено Тогда
		СписокАгентФильтр = АгентПараметр;
		ПрименитьОтборПоАгентуНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СписокАгентФильтрПриИзменении(Элемент)

	ПрименитьОтборПоАгентуНаКлиенте();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьОтборПоАгентуНаКлиенте()

	ПрименитьОтборПоАгентуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборПоАгентуНаСервере()

	// Очистить существующие отборы по агенту (обратный цикл для безопасного удаления).
	Для Индекс = Список.Отбор.Элементы.Количество() - 1 По - 1 Цикл
		ЭлементОтбора = Список.Отбор.Элементы.Получить(Индекс);
		Если ТипЗнч(ЭлементОтбора) = Тип("ДинамическийСписокОтборПоПолю")
			И ЭлементОтбора.Поле = "ar_Агент" Тогда
			Список.Отбор.Элементы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(СписокАгентФильтр) Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ДинамическийСписокОтборПоПолю"));
		ЭлементОтбора.Поле = "ar_Агент";
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Значение = СписокАгентФильтр;
	КонецЕсли;

	Список.Прочитать();

КонецПроцедуры

#КонецОбласти
