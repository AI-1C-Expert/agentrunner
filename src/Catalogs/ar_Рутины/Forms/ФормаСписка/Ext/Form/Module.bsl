//////////////////////////////////////////////////////////////////////////////
// Форма списка справочника ar_Рутины (ROUT-01).
//
// Динамический список рутин с отбором по агенту.
//////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// Если форма открыта с параметром Агент - установить фильтр.
	АгентПараметр = Неопределено;
	Параметры.Свойство("Агент", АгентПараметр);
	Если АгентПараметр <> Неопределено Тогда
		СписокАгентФильтр = АгентПараметр;
		ПрименитьОтборПоАгентуНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СписокАгентФильтрПриИзменении(Элемент)

	ПрименитьОтборПоАгентуНаКлиенте();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьОтборПоАгентуНаКлиенте()

	ПрименитьОтборПоАгентуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборПоАгентуНаСервере()

	// Отбор ставится штатным методом БСП: он сам управляет составом элементов
	// (Использование = Ложь снимает отбор, не удаляя элемент вручную).
	// Прежний самодельный вариант не работал: тип "ДинамическийСписокОтборПоПолю"
	// в платформе не определён (Type is not defined), а конструкция
	// "Для Индекс = N По -1 Цикл" не является циклом с шагом -1 - на пустой
	// коллекции давала "Index value exceeds range limits". Дефект вскрылся при
	// живой проверке CMPT-03, где такой же код ронял форму списка ar_Tools.
	// [Реф: БСП/CommonModules/ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка]
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"ar_Агент",
		СписокАгентФильтр,
		ВидСравненияКомпоновкиДанных.Равно,
		,
		ЗначениеЗаполнено(СписокАгентФильтр));

	Список.Прочитать();

КонецПроцедуры

#КонецОбласти
