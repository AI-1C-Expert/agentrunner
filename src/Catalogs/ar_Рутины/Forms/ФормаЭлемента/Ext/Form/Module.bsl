//////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_Рутины (ROUT-01) - HTML-панель.
//
// Подход единый с ar_Настройки / ar_Диалог: вся форма - одно поле
// ПолеHTMLДокумента (ПолеHTMLРутины), сервер собирает HTML карточки рутины.
// Обратная связь HTML -> BSL - штатное событие поля ПриНажатии: каждый
// интерактивный элемент - ссылка "1c://<действие>?<параметры>", href приходит
// в ДанныеСобытия.Href (эталон БСП ВзаимодействияКлиент.ПолеHTMLПриНажатии).
// Значения полей ввода читаются из DOM (Элементы.ПолеHTMLРутины.Документ) -
// работает в толстом клиенте; в веб-клиенте DOM-доступ деградирует, поэтому
// чтение обёрнуто в Попытку.
//
// Тип триггера выбирается карточками (cron/mention/webhook/manual) с описанием,
// параметры показываются только для текущего типа - с подсказками, примерами
// cron-выражений, валидацией и предпросмотром ближайших запусков (ar_Cron).
//
// ar_ПараметрыJSON не выводится напрямую - сериализуется/десериализуется
// через view-реквизиты формы (РасписаниеCron, MentionКлючевыеСлова,
// WebhookПараметрыJSON).
//////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПравоДоступа("Изменение", Метаданные.Справочники.ar_Рутины) Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

	// Значения по умолчанию для новой записи.
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ar_Активна = Истина;
		Если ПустаяСтрока(Объект.ar_ТипТриггера) Тогда
			Объект.ar_ТипТриггера = "cron";
		КонецЕсли;
	КонецЕсли;

	// Разобрать параметры JSON в view-реквизиты.
	РазобратьПараметрыJSON();

	ПерерисоватьПанельРутины();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	СериализоватьПараметрыJSON(ТекущийОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Обрабатывает клик по любому элементу внутри HTML-панели рутины.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент             - ПолеФормы - поле ПолеHTMLРутины.
//  ДанныеСобытия       - ФиксированнаяСтруктура - данные DOM-события клика
//                        (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                        открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLРутиныПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	// Дальше ссылку обрабатываем сами.
	СтандартнаяОбработка = Ложь;

	// Перед любым действием забираем текущий ввод из DOM,
	// чтобы перерисовка панели не потеряла несохранённые правки.
	СчитатьПоляВводаИзDOM();

	Действие = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	Если Действие = "set-type" Тогда
		УстановитьТипТриггера(ПараметрыСсылки);
	ИначеЕсли Действие = "toggle-active" Тогда
		Объект.ar_Активна = Не Объект.ar_Активна;
		ПерерисоватьПанельРутиныНаСервере();
	ИначеЕсли Действие = "check-cron" Тогда
		// Валидация и предпросмотр ближайших запусков выполняются при перерисовке.
		ПерерисоватьПанельРутиныНаСервере();
	ИначеЕсли Действие = "pick-agent" Тогда
		ВыбратьАгента();
	ИначеЕсли Действие = "pick-profile" Тогда
		ВыбратьПрофильЗапуска();
	ИначеЕсли Действие = "clear-profile" Тогда
		Объект.ar_ПрофильЗапуска = Справочники.ar_ПрофилиЗапуска.ПустаяСсылка();
		ПерерисоватьПанельРутиныНаСервере();
	ИначеЕсли Действие = "save" Тогда
		СохранитьРутину(Ложь);
	ИначеЕсли Действие = "save-close" Тогда
		СохранитьРутину(Истина);
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаДействийКлиента

// Устанавливает тип триггера из параметров ссылки и перерисовывает панель.
//
&НаКлиенте
Процедура УстановитьТипТриггера(ПараметрыСсылки)

	ТипТриггера = "";
	ПараметрыСсылки.Свойство("type", ТипТриггера);
	Если ПустаяСтрока(ТипТриггера) Или ТипТриггера = Объект.ar_ТипТриггера Тогда
		Возврат;
	КонецЕсли;

	Объект.ar_ТипТриггера = ТипТриггера;
	ПерерисоватьПанельРутиныНаСервере();

КонецПроцедуры

// Считывает все поля ввода HTML-панели из DOM в реквизиты формы.
// В веб-клиенте DOM недоступен - значения остаются прежними.
//
&НаКлиенте
Процедура СчитатьПоляВводаИзDOM()

	Значение = ПрочитатьЗначениеИзDOM("fld-name");
	Если Значение <> Неопределено Тогда
		Объект.Description = Значение;
	КонецЕсли;

	Значение = ПрочитатьЗначениеИзDOM("fld-cron");
	Если Значение <> Неопределено Тогда
		РасписаниеCron = СокрЛП(Значение);
	КонецЕсли;

	Значение = ПрочитатьЗначениеИзDOM("fld-keywords");
	Если Значение <> Неопределено Тогда
		MentionКлючевыеСлова = Значение;
	КонецЕсли;

	Значение = ПрочитатьЗначениеИзDOM("fld-webhook");
	Если Значение <> Неопределено Тогда
		WebhookПараметрыJSON = Значение;
	КонецЕсли;

	Значение = ПрочитатьЗначениеИзDOM("fld-instr");
	Если Значение <> Неопределено Тогда
		Объект.ar_ИнструкцияПереопределение = Значение;
	КонецЕсли;

КонецПроцедуры

// Читает значение элемента input/textarea по id из DOM HTML-документа.
// Возвращает Неопределено, если DOM-доступ недоступен (веб-клиент) или элемент не найден.
//
&НаКлиенте
Функция ПрочитатьЗначениеИзDOM(Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLРутины.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЭлементВвода.value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Выбор агента через стандартный диалог выбора справочника ar_Агенты.
//
&НаКлиенте
Процедура ВыбратьАгента()

	Оповещение = Новый ОписаниеОповещения("ВыборАгентаЗавершение", ЭтотОбъект);

	// РежимВыбора + ЗакрытьПриВыборе обязательны, иначе форма списка открывается
	// в обычном режиме просмотра и не возвращает выбранное значение в оповещение.
	// Имя переменной не должно совпадать со свойством формы ПараметрыВыбора -
	// присваивание ему падает с "Type mismatch".
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрытьПриВыборе", Истина);

	ОткрытьФорму("Справочник.ar_Агенты.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборАгентаЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.ar_Агент = ВыбранноеЗначение;
	ПерерисоватьПанельРутиныНаСервере();

КонецПроцедуры

// Выбор профиля запуска (CONS-02) через стандартный диалог выбора справочника
// ar_ПрофилиЗапуска, отфильтрованный по агенту этой рутины - профиль другого
// агента технически не запрещён метаданными, но подсказка/отбор ведут
// пользователя к согласованному выбору (спека CONS-02, "форма элемента
// ar_Рутины").
//
&НаКлиенте
Процедура ВыбратьПрофильЗапуска()

	Оповещение = Новый ОписаниеОповещения("ВыборПрофиляЗапускаЗавершение", ЭтотОбъект);

	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрытьПриВыборе", Истина);
	Если ЗначениеЗаполнено(Объект.ar_Агент) Тогда
		ПараметрыФормыВыбора.Вставить("Отбор", Новый Структура("ar_Агент", Объект.ar_Агент));
	КонецЕсли;

	ОткрытьФорму("Справочник.ar_ПрофилиЗапуска.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборПрофиляЗапускаЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.ar_ПрофильЗапуска = ВыбранноеЗначение;
	ПерерисоватьПанельРутиныНаСервере();

КонецПроцедуры

// Проверяет заполнение, записывает рутину и (опционально) закрывает форму.
//
// Параметры:
//  ЗакрытьПослеЗаписи - Булево - Истина для действия «Записать и закрыть».
//
&НаКлиенте
Процедура СохранитьРутину(ЗакрытьПослеЗаписи)

	// Служебное имя синхронизируем с наименованием: проверка заполнения
	// ar_Имя (ВыдаватьОшибку) выполняется платформой до ПередЗаписьюНаСервере.
	Объект.ar_Имя = Объект.Description;

	Если Не ПроверитьПередЗаписьюНаСервере() Тогда
		Возврат; // панель уже перерисована с текстом ошибок
	КонецЕсли;

	Если Не Записать() Тогда
		ПерерисоватьПанельРутиныНаСервере(
			НСтр("ru='Не записано - см. сообщения'; en='Not saved - see messages'"), Истина);
		Возврат;
	КонецЕсли;

	Если ЗакрытьПослеЗаписи Тогда
		Закрыть();
	Иначе
		ПерерисоватьПанельРутиныНаСервере(НСтр("ru='Записано ✓'; en='Saved ✓'"));
	КонецЕсли;

КонецПроцедуры

// Клиентская обёртка перерисовки панели.
//
// Параметры:
//  Статус    - Строка - статус последнего действия для шапки панели.
//  ЭтоОшибка - Булево - Истина, если статус - текст ошибки (красный).
//
&НаКлиенте
Процедура ПерерисоватьПанельРутиныНаСервере(Статус = "", ЭтоОшибка = Ложь)
	ПерерисоватьПанельРутины(Статус, ЭтоОшибка);
КонецПроцедуры

#КонецОбласти

#Область СерверныеДействия

// Проверяет заполнение полей рутины перед записью. При ошибках перерисовывает
// панель с их перечнем и возвращает Ложь.
//
// Возвращаемое значение:
//  Булево - Истина, если запись можно выполнять.
//
&НаСервере
Функция ПроверитьПередЗаписьюНаСервере()

	Ошибки = Новый Массив;

	Если ПустаяСтрока(Объект.Description) Тогда
		Ошибки.Добавить(НСтр("ru='Укажите имя рутины.'; en='Enter the routine name.'"));
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ar_Агент) Тогда
		Ошибки.Добавить(НСтр("ru='Выберите агента.'; en='Select an agent.'"));
	КонецЕсли;

	ДобавитьОшибкиПараметровТриггера(Ошибки);

	Если Ошибки.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ПерерисоватьПанельРутины(СтрСоединить(Ошибки, " "), Истина);
	Возврат Ложь;

КонецФункции

// Дополняет массив Ошибки проблемами параметров текущего типа триггера.
// Вынесена из ПроверитьПередЗаписьюНаСервере для снижения когнитивной сложности.
//
// Параметры:
//  Ошибки - Массив из Строка - накапливаемые тексты ошибок заполнения.
//
&НаСервере
Процедура ДобавитьОшибкиПараметровТриггера(Ошибки)

	ТипТриггера = Объект.ar_ТипТриггера;
	Если ТипТриггера = "cron" Тогда
		Если ПустаяСтрока(РасписаниеCron) Тогда
			Ошибки.Добавить(НСтр("ru='Заполните cron-выражение расписания.'; en='Fill in the cron schedule expression.'"));
		Иначе
			РезультатРазбора = ar_Cron.РазобратьВыражение(РасписаниеCron);
			Если Не РезультатРазбора.ОК Тогда
				Ошибки.Добавить(СтрШаблон(
					НСтр("ru='Cron-выражение некорректно: %1'; en='Cron expression is invalid: %1'"),
					РезультатРазбора.Ошибка));
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипТриггера = "mention" Тогда
		Если РазобратьКлючевыеСлова(MentionКлючевыеСлова).Количество() = 0 Тогда
			Ошибки.Добавить(НСтр("ru='Укажите хотя бы одно ключевое слово.'; en='Enter at least one keyword.'"));
		КонецЕсли;
	ИначеЕсли ТипТриггера = "webhook" Тогда
		Если ЗначениеЗаполнено(WebhookПараметрыJSON) И Не ЭтоВалидныйJSON(WebhookПараметрыJSON) Тогда
			Ошибки.Добавить(НСтр("ru='Параметры вебхука не являются валидным JSON.'; en='Webhook parameters are not valid JSON.'"));
		КонецЕсли;
	Иначе
		// manual и нераспознанные типы - параметры не проверяются.
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Актуализирует ОшибкаCron и кладёт свежесобранный HTML в СтрокаHTMLРутины.
//
// Параметры:
//  Статус    - Строка - статус последнего действия для шапки панели.
//  ЭтоОшибка - Булево - Истина, если статус - текст ошибки.
//
&НаСервере
Процедура ПерерисоватьПанельРутины(Знач Статус = "", Знач ЭтоОшибка = Ложь)

	ОшибкаCron = "";
	Если Объект.ar_ТипТриггера = "cron" И Не ПустаяСтрока(РасписаниеCron) Тогда
		РезультатРазбора = ar_Cron.РазобратьВыражение(РасписаниеCron);
		Если Не РезультатРазбора.ОК Тогда
			ОшибкаCron = РезультатРазбора.Ошибка;
		КонецЕсли;
	КонецЕсли;

	СтрокаHTMLРутины = СобратьHTMLРутины(Статус, ЭтоОшибка);

КонецПроцедуры

#КонецОбласти

#Область СборкаHTML

// Собирает полный HTML-документ карточки рутины.
//
// Параметры:
//  Статус    - Строка - статус последнего действия для шапки.
//  ЭтоОшибка - Булево - Истина, если статус - текст ошибки.
//
// Возвращаемое значение:
//  Строка - готовый HTML-документ для поля ПолеHTMLРутины.
//
&НаСервере
Функция СобратьHTMLРутины(Знач Статус, Знач ЭтоОшибка)

	Содержимое = "";
	Содержимое = Содержимое + HTMLСекцияШапки(Статус, ЭтоОшибка);
	Содержимое = Содержимое + HTMLСекцияОсновное();
	Содержимое = Содержимое + HTMLСекцияТриггер();
	Содержимое = Содержимое + HTMLСекцияИнструкция();
	Содержимое = Содержимое + HTMLСекцияКнопок();

	Возврат HTMLКаркасРутины(Содержимое);

КонецФункции

// Секция-шапка: заголовок карточки + статус последнего действия.
//
&НаСервере
Функция HTMLСекцияШапки(Знач Статус, Знач ЭтоОшибка)

	Заголовок = ?(ЗначениеЗаполнено(Объект.Ссылка),
		НСтр("ru='Рутина'; en='Routine'"),
		НСтр("ru='Новая рутина'; en='New routine'"));

	СтатусHTML = "";
	Если Не ПустаяСтрока(Статус) Тогда
		КлассСтатуса = ?(ЭтоОшибка, "ar-status ar-status-error", "ar-status");
		СтатусHTML = "<span class=""" + КлассСтатуса + """>" + ar_ЭкранироватьHTML(Статус) + "</span>";
	КонецЕсли;

	Возврат
		"<div class=""ar-head"">"
		+ "<h1>" + ar_ЭкранироватьHTML(Заголовок) + "</h1>"
		+ СтатусHTML
		+ "</div>";

КонецФункции

// Секция «Основное»: имя, агент, признак активности.
//
&НаСервере
Функция HTMLСекцияОсновное()

	Отключено = ?(ТолькоПросмотр, " disabled", "");

	// Имя.
	СтрокаИмя =
		"<div class=""ar-field"">"
		+ "<div class=""ar-field-label"">" + ar_ЭкранироватьHTML(НСтр("ru='Имя'; en='Name'")) + "</div>"
		+ "<input id=""fld-name"" class=""ar-input ar-input-wide"" type=""text"" value="""
		+ ar_ЭкранироватьHTML(Объект.Description) + """" + Отключено + ">"
		+ "</div>";

	// Агент.
	ПредставлениеАгента = ?(ЗначениеЗаполнено(Объект.ar_Агент),
		"" + Объект.ar_Агент,
		НСтр("ru='(не выбран)'; en='(not set)'"));
	КнопкаВыбора = ?(ТолькоПросмотр, "",
		СсылкаДействие("pick-agent", "", НСтр("ru='Выбрать…'; en='Select…'"), "ar-btn ar-btn-small"));
	СтрокаАгент =
		"<div class=""ar-field"">"
		+ "<div class=""ar-field-label"">" + ar_ЭкранироватьHTML(НСтр("ru='Агент'; en='Agent'")) + "</div>"
		+ "<div class=""ar-field-row"">"
		+ "<span class=""ar-refval"">" + ar_ЭкранироватьHTML(ПредставлениеАгента) + "</span>"
		+ КнопкаВыбора
		+ "</div>"
		+ "<div class=""ar-hint"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Агент, которого запускает эта рутина.'; en='The agent this routine launches.'")) + "</div>"
		+ "</div>";

	// Профиль запуска (CONS-02) - необязателен, без него поведение как раньше.
	СтрокаПрофильЗапуска = HTMLСтрокаПрофиляЗапуска();

	// Активность.
	МеткаАктивности = ?(Объект.ar_Активна,
		НСтр("ru='Активна'; en='Active'"), НСтр("ru='Выключена'; en='Disabled'"));
	Если ТолькоПросмотр Тогда
		Переключатель = "<span class=""ar-toggle ar-toggle-" + ?(Объект.ar_Активна, "on", "off") + """>"
			+ ar_ЭкранироватьHTML(МеткаАктивности) + "</span>";
	Иначе
		Переключатель = СсылкаДействие("toggle-active", "", МеткаАктивности,
			"ar-toggle ar-toggle-" + ?(Объект.ar_Активна, "on", "off"));
	КонецЕсли;
	СтрокаАктивность =
		"<div class=""ar-field"">"
		+ "<div class=""ar-field-row"">"
		+ Переключатель
		+ "<span class=""ar-hint"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Планировщик обрабатывает только активные рутины.'; en='The scheduler processes only active routines.'")) + "</span>"
		+ "</div>"
		+ "</div>";

	Возврат
		"<div class=""ar-card"">"
		+ СтрокаИмя
		+ СтрокаАгент
		+ СтрокаПрофильЗапуска
		+ СтрокаАктивность
		+ "</div>";

КонецФункции

// Строка «Профиль запуска» (CONS-02): необязательный выбор
// СправочникСсылка.ar_ПрофилиЗапуска, определяющий ответственного и область
// данных этого запуска. Пустое значение - профиль не указан, поведение
// рантайма ровно такое же, как до CONS-02 (решение 22, обратная
// совместимость).
//
&НаСервере
Функция HTMLСтрокаПрофиляЗапуска()

	ПредставлениеПрофиля = ?(ЗначениеЗаполнено(Объект.ar_ПрофильЗапуска),
		"" + Объект.ar_ПрофильЗапуска,
		НСтр("ru='(не выбран)'; en='(not set)'"));

	КнопкиДействий = "";
	Если Не ТолькоПросмотр Тогда
		КнопкиДействий = КнопкиДействий
			+ СсылкаДействие("pick-profile", "", НСтр("ru='Выбрать…'; en='Select…'"), "ar-btn ar-btn-small");
		Если ЗначениеЗаполнено(Объект.ar_ПрофильЗапуска) Тогда
			КнопкиДействий = КнопкиДействий
				+ СсылкаДействие("clear-profile", "", НСтр("ru='Очистить'; en='Clear'"), "ar-btn ar-btn-small");
		КонецЕсли;
	КонецЕсли;

	МеткаПоля = ar_ЭкранироватьHTML(НСтр("ru='Профиль запуска'; en='Run profile'"));
	ТекстПодсказки = ar_ЭкранироватьHTML(
		НСтр("ru='Необязательно. Определяет ответственного и область данных этого
			|запуска. Рекомендуется выбирать профиль того же агента, что указан выше.';
			|en='Optional. Determines the responsible party and data scope for this
			|run. Choose a profile that belongs to the same agent selected above.'"));

	Возврат
		"<div class=""ar-field"">"
		+ "<div class=""ar-field-label"">" + МеткаПоля + "</div>"
		+ "<div class=""ar-field-row"">"
		+ "<span class=""ar-refval"">" + ar_ЭкранироватьHTML(ПредставлениеПрофиля) + "</span>"
		+ КнопкиДействий
		+ "</div>"
		+ "<div class=""ar-hint"">" + ТекстПодсказки + "</div>"
		+ "</div>";

КонецФункции

// Секция «Триггер»: карточки выбора типа + параметры текущего типа.
//
&НаСервере
Функция HTMLСекцияТриггер()

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Триггер - когда запускать'; en='Trigger - when to launch'")) + "</h2>"
		+ HTMLКарточкиТипов()
		+ HTMLПараметрыТриггера()
		+ "</div>";

КонецФункции

// Сетка из четырёх карточек-типов триггера. Текущий тип подсвечен.
//
&НаСервере
Функция HTMLКарточкиТипов()

	Карточки = "";
	Для Каждого Описание Из ОписанияТиповТриггера() Цикл

		Активна = (Описание.Ид = Объект.ar_ТипТриггера);
		Класс = "ar-type" + ?(Активна, " ar-type-active", "");
		Содержимое =
			"<div class=""ar-type-icon"">" + Описание.Значок + "</div>"
			+ "<div class=""ar-type-title"">" + ar_ЭкранироватьHTML(Описание.Заголовок) + "</div>"
			+ "<div class=""ar-type-desc"">" + ar_ЭкранироватьHTML(Описание.Описание) + "</div>";

		Если ТолькоПросмотр Тогда
			Карточки = Карточки + "<span class=""" + Класс + """>" + Содержимое + "</span>";
		Иначе
			Карточки = Карточки + "<a href=""1c://set-type?type=" + Описание.Ид + """ class=""" + Класс + """>"
				+ Содержимое + "</a>";
		КонецЕсли;

	КонецЦикла;

	Возврат "<div class=""ar-types"">" + Карточки + "</div>";

КонецФункции

// Блок параметров текущего типа триггера с подсказками и валидацией.
//
&НаСервере
Функция HTMLПараметрыТриггера()

	ТипТриггера = Объект.ar_ТипТриггера;

	Если ТипТриггера = "cron" Тогда
		Возврат HTMLПараметрыCron();
	ИначеЕсли ТипТриггера = "mention" Тогда
		Возврат HTMLПараметрыMention();
	ИначеЕсли ТипТриггера = "manual" Тогда
		Возврат
			"<div class=""ar-note"">" + ar_ЭкранироватьHTML(
				НСтр("ru='Параметры не требуются: рутину запускает пользователь вручную из списка рутин.';
					|en='No parameters required: the user launches the routine manually from the routine list.'"))
			+ "</div>";
	Иначе
		// webhook и нераспознанные типы - JSON-параметры.
		Возврат HTMLПараметрыWebhook();
	КонецЕсли;

КонецФункции

// Параметры cron: поле выражения, проверка, ошибка, ближайшие запуски, примеры.
//
&НаСервере
Функция HTMLПараметрыCron()

	Отключено = ?(ТолькоПросмотр, " disabled", "");

	КнопкаПроверки = ?(ТолькоПросмотр, "",
		СсылкаДействие("check-cron", "", НСтр("ru='Проверить'; en='Check'"), "ar-btn ar-btn-small"));

	Блок =
		"<div class=""ar-field"">"
		+ "<div class=""ar-field-label"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Cron-выражение (минуты часы день-месяца месяц день-недели)';
				|en='Cron expression (minutes hours day-of-month month day-of-week)'")) + "</div>"
		+ "<div class=""ar-field-row"">"
		+ "<input id=""fld-cron"" class=""ar-input ar-input-mono"" type=""text"" value="""
		+ ar_ЭкранироватьHTML(РасписаниеCron) + """ placeholder=""0 9 * * 1-5""" + Отключено + ">"
		+ КнопкаПроверки
		+ "</div>";

	Если Не ПустаяСтрока(ОшибкаCron) Тогда
		Блок = Блок + "<div class=""ar-error"">" + ar_ЭкранироватьHTML(ОшибкаCron) + "</div>";
	ИначеЕсли Не ПустаяСтрока(РасписаниеCron) Тогда
		Блок = Блок + HTMLБлижайшиеЗапуски();
	КонецЕсли;

	Блок = Блок
		+ "<div class=""ar-hint"">"
		+ HTMLПримерCron("*/15 * * * *", НСтр("ru='каждые 15 минут'; en='every 15 minutes'"))
		+ HTMLПримерCron("0 9 * * 1-5",  НСтр("ru='по будням в 9:00'; en='weekdays at 9:00'"))
		+ HTMLПримерCron("30 18 1 * *",  НСтр("ru='1-го числа каждого месяца в 18:30'; en='on the 1st of every month at 18:30'"))
		+ "</div>"
		+ "</div>";

	Возврат Блок;

КонецФункции

// Одна строка примера cron-выражения для подсказки.
//
&НаКлиентеНаСервереБезКонтекста
Функция HTMLПримерCron(Знач Выражение, Знач Пояснение)

	Возврат "<div><code>" + Выражение + "</code> &mdash; " + ar_ЭкранироватьHTML(Пояснение) + "</div>";

КонецФункции

// Список ближайших запусков по текущему валидному cron-выражению.
//
&НаСервере
Функция HTMLБлижайшиеЗапуски()

	Запуски = БлижайшиеЗапускиCron(РасписаниеCron, 3);

	Если Запуски.Количество() = 0 Тогда
		Возврат "<div class=""ar-hint"">" + ar_ЭкранироватьHTML(
			НСтр("ru='В ближайшие 60 дней запусков по этому расписанию нет.';
				|en='No runs match this schedule within the next 60 days.'")) + "</div>";
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого МоментЗапуска Из Запуски Цикл
		Строки.Добавить(Формат(МоментЗапуска, "ДФ='dd.MM.yyyy HH:mm'"));
	КонецЦикла;

	Возврат
		"<div class=""ar-ok"">" + ar_ЭкранироватьHTML(СтрШаблон(
			НСтр("ru='Выражение корректно. Ближайшие запуски: %1'; en='Expression is valid. Next runs: %1'"),
			СтрСоединить(Строки, ", "))) + "</div>";

КонецФункции

// Параметры mention: ключевые слова через запятую.
//
&НаСервере
Функция HTMLПараметрыMention()

	Отключено = ?(ТолькоПросмотр, " disabled", "");

	Возврат
		"<div class=""ar-field"">"
		+ "<div class=""ar-field-label"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Ключевые слова (через запятую)'; en='Keywords (comma-separated)'")) + "</div>"
		+ "<input id=""fld-keywords"" class=""ar-input ar-input-wide"" type=""text"" value="""
		+ ar_ЭкранироватьHTML(MentionКлючевыеСлова) + """ placeholder="""
		+ ar_ЭкранироватьHTML(НСтр("ru='отчёт, продажи, склад'; en='report, sales, warehouse'")) + """" + Отключено + ">"
		+ "<div class=""ar-hint"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Рутина сработает, когда в сообщении диалога встретится любое из этих слов.';
				|en='The routine fires when a dialog message contains any of these words.'")) + "</div>"
		+ "</div>";

КонецФункции

// Параметры webhook: JSON-контекст + подсказка с URL вызова.
//
&НаСервере
Функция HTMLПараметрыWebhook()

	Отключено = ?(ТолькоПросмотр, " disabled", "");

	ПодсказкаJSON = "";
	Если ЗначениеЗаполнено(WebhookПараметрыJSON) И Не ЭтоВалидныйJSON(WebhookПараметрыJSON) Тогда
		ПодсказкаJSON = "<div class=""ar-error"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Текст не является валидным JSON.'; en='The text is not valid JSON.'")) + "</div>";
	КонецЕсли;

	Возврат
		"<div class=""ar-field"">"
		+ "<div class=""ar-field-label"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Параметры (JSON)'; en='Parameters (JSON)'")) + "</div>"
		+ "<textarea id=""fld-webhook"" class=""ar-textarea ar-textarea-wide"" rows=""6""" + Отключено + ">"
		+ ar_ЭкранироватьHTML(WebhookПараметрыJSON) + "</textarea>"
		+ ПодсказкаJSON
		+ "<div class=""ar-hint"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Произвольный JSON, который передаётся агенту как контекст запуска. Вызов извне: POST /hs/ar_AgentsAPI/v1/agents/{id}/trigger.';
				|en='Arbitrary JSON passed to the agent as launch context. External call: POST /hs/ar_AgentsAPI/v1/agents/{id}/trigger.'")) + "</div>"
		+ "</div>";

КонецФункции

// Секция «Инструкция»: переопределение системной инструкции агента.
//
&НаСервере
Функция HTMLСекцияИнструкция()

	Отключено = ?(ТолькоПросмотр, " disabled", "");

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Инструкция (переопределение)'; en='Instruction (override)'")) + "</h2>"
		+ "<textarea id=""fld-instr"" class=""ar-textarea ar-textarea-wide"" rows=""5""" + Отключено + ">"
		+ ar_ЭкранироватьHTML(Объект.ar_ИнструкцияПереопределение) + "</textarea>"
		+ "<div class=""ar-hint"">" + ar_ЭкранироватьHTML(
			НСтр("ru='Текст добавляется к системной инструкции агента при запуске по этой рутине. Пусто - агент работает по своей основной инструкции.';
				|en='Appended to the agent''s system instruction when launched by this routine. Empty - the agent uses its base instruction.'")) + "</div>"
		+ "</div>";

КонецФункции

// Секция кнопок записи (скрыта в режиме «только просмотр»).
//
&НаСервере
Функция HTMLСекцияКнопок()

	Если ТолькоПросмотр Тогда
		Возврат "";
	КонецЕсли;

	Возврат
		"<div class=""ar-footer"">"
		+ СсылкаДействие("save-close", "", НСтр("ru='Записать и закрыть'; en='Save and close'"), "ar-btn ar-btn-primary")
		+ СсылкаДействие("save", "", НСтр("ru='Записать'; en='Save'"), "ar-btn")
		+ "</div>";

КонецФункции

// Формирует HTML-ссылку-действие с href схемы "1c://".
//
// Параметры:
//  Действие          - Строка - имя действия (set-type/save/pick-agent/...).
//  ПараметрыЗапроса  - Строка - строка query-параметров ("type=..." или "").
//  Текст             - Строка - видимый текст ссылки.
//  КлассCSS          - Строка - CSS-классы.
//
&НаСервере
Функция СсылкаДействие(Знач Действие, Знач ПараметрыЗапроса, Знач Текст, Знач КлассCSS)

	Href = "1c://" + Действие;
	Если Не ПустаяСтрока(ПараметрыЗапроса) Тогда
		Href = Href + "?" + ПараметрыЗапроса;
	КонецЕсли;

	Возврат "<a href=""" + Href + """ class=""" + КлассCSS + """>" + ar_ЭкранироватьHTML(Текст) + "</a>";

КонецФункции

// Обёртка HTML-каркаса со встроенными стилями (офлайн-first, без внешних CDN).
// JS отсутствует: вся навигация - через <a href="1c://">.
//
&НаКлиентеНаСервереБезКонтекста
Функция HTMLКаркасРутины(Знач Содержимое)

	Возврат
		"<!DOCTYPE html><html><head><meta charset=""utf-8""><style>"
		+ "html,body{margin:0;padding:0;background:#f4f6f8;color:#1b1f23;"
		+ "font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:13px;}"
		+ ".ar-wrap{max-width:760px;margin:0 auto;padding:12px;}"
		+ ".ar-head{display:flex;align-items:baseline;justify-content:space-between;margin:6px 4px 10px;}"
		+ ".ar-head h1{font-size:18px;margin:0;}"
		+ ".ar-status{color:#1a7f37;font-weight:600;}"
		+ ".ar-status-error{color:#b42318;}"
		+ ".ar-card{background:#fff;border:1px solid #e1e6eb;border-radius:10px;"
		+ "padding:14px 16px;margin-bottom:12px;box-shadow:0 1px 2px rgba(0,0,0,0.04);}"
		+ ".ar-card h2{font-size:14px;margin:0 0 10px;color:#3a4a5b;}"
		+ ".ar-field{margin:10px 0;}"
		+ ".ar-field-label{font-weight:600;margin-bottom:4px;}"
		+ ".ar-field-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}"
		+ ".ar-hint{color:#6b7a8f;font-size:12px;margin-top:6px;}"
		+ ".ar-hint code,code{background:#f0f2f5;padding:1px 5px;border-radius:4px;"
		+ "font-family:Consolas,Menlo,monospace;font-size:12px;}"
		+ ".ar-note{background:#eef1f5;color:#5b6b7c;border-radius:6px;padding:8px 10px;"
		+ "margin-top:8px;font-size:12px;}"
		+ ".ar-error{background:#fde8e8;color:#b42318;border-radius:6px;padding:6px 10px;"
		+ "margin-top:6px;font-size:12px;}"
		+ ".ar-ok{background:#e6f4ea;color:#1a7f37;border-radius:6px;padding:6px 10px;"
		+ "margin-top:6px;font-size:12px;}"
		+ ".ar-input{padding:4px 6px;border:1px solid #cdd5de;border-radius:6px;font-size:13px;}"
		+ ".ar-input-wide{width:100%;box-sizing:border-box;}"
		+ ".ar-input-mono{width:220px;font-family:Consolas,Menlo,monospace;}"
		+ ".ar-textarea{padding:6px;border:1px solid #cdd5de;border-radius:6px;"
		+ "font-family:Consolas,Menlo,monospace;font-size:12px;}"
		+ ".ar-textarea-wide{width:100%;box-sizing:border-box;}"
		+ ".ar-refval{color:#3a4a5b;font-weight:600;}"
		+ "a.ar-btn{display:inline-block;padding:4px 10px;border-radius:6px;background:#eef1f5;"
		+ "color:#3a5ba0;text-decoration:none;font-size:12px;border:1px solid #dfe4ea;}"
		+ "a.ar-btn:hover{background:#e2e8f0;}"
		+ "a.ar-btn-primary{background:#3a5ba0;color:#fff;border-color:#3a5ba0;}"
		+ "a.ar-btn-small{padding:3px 8px;}"
		+ ".ar-toggle{display:inline-block;padding:4px 14px;border-radius:12px;text-decoration:none;"
		+ "font-size:12px;font-weight:600;}"
		+ ".ar-toggle-on{background:#1a7f37;color:#fff;}"
		+ ".ar-toggle-off{background:#d0d7de;color:#57606a;}"
		+ ".ar-types{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:8px 0;}"
		+ ".ar-type{display:block;padding:10px;border:1px solid #dfe4ea;border-radius:10px;"
		+ "text-decoration:none;color:#1b1f23;background:#fff;}"
		+ "a.ar-type:hover{border-color:#3a5ba0;}"
		+ ".ar-type-active{border-color:#3a5ba0;background:#eef3fc;box-shadow:0 0 0 1px #3a5ba0 inset;}"
		+ ".ar-type-icon{font-size:18px;}"
		+ ".ar-type-title{font-weight:600;margin-top:4px;}"
		+ ".ar-type-desc{color:#6b7a8f;font-size:11px;margin-top:2px;}"
		+ ".ar-footer{display:flex;gap:8px;justify-content:flex-end;margin:4px 0 12px;}"
		+ "</style></head><body><div class=""ar-wrap"">"
		+ Содержимое
		+ "</div></body></html>";

КонецФункции

// Экранирует спецсимволы HTML (тот же контракт, что в ar_Настройки/ar_Диалог).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст,    "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

// Описания типов триггера для карточек выбора.
//
// Возвращаемое значение:
//  Массив из Структура (Ид, Значок, Заголовок, Описание).
//
&НаСервере
Функция ОписанияТиповТриггера()

	Типы = Новый Массив;
	Типы.Добавить(ОписаниеТипа("cron", "⏰",
		НСтр("ru='По расписанию'; en='On schedule'"),
		НСтр("ru='Запуск по cron-выражению'; en='Launch by cron expression'")));
	Типы.Добавить(ОписаниеТипа("mention", "💬",
		НСтр("ru='По упоминанию'; en='On mention'"),
		НСтр("ru='Запуск по ключевым словам в диалоге'; en='Launch by keywords in a dialog'")));
	Типы.Добавить(ОписаниеТипа("webhook", "🌐",
		НСтр("ru='По вебхуку'; en='On webhook'"),
		НСтр("ru='Запуск внешним HTTP-запросом'; en='Launch by external HTTP request'")));
	Типы.Добавить(ОписаниеТипа("manual", "✋",
		НСтр("ru='Вручную'; en='Manual'"),
		НСтр("ru='Запуск пользователем из списка'; en='Launched by the user from the list'")));
	Возврат Типы;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеТипа(Знач Ид, Знач Значок, Знач Заголовок, Знач Описание)

	Описание_ = Новый Структура;
	Описание_.Вставить("Ид", Ид);
	Описание_.Вставить("Значок", Значок);
	Описание_.Вставить("Заголовок", Заголовок);
	Описание_.Вставить("Описание", Описание);
	Возврат Описание_;

КонецФункции

// Вычисляет до Количество ближайших срабатываний cron-выражения.
// Горизонт поиска каждого срабатывания ограничен 60 сутками, чтобы не
// зациклиться на редких расписаниях.
//
// Параметры:
//  Выражение  - Строка - cron-выражение из 5 полей.
//  Количество - Число  - сколько ближайших моментов вернуть.
//
// Возвращаемое значение:
//  Массив из Дата - ближайшие моменты срабатывания (может быть пустым).
//
&НаСервере
Функция БлижайшиеЗапускиCron(Знач Выражение, Знач Количество)

	МинутВ60Сутках = 86400;

	Результат = Новый Массив;
	Момент = ТекущаяДатаСеанса();
	Для Н = 1 По Количество Цикл
		СледующийМомент = ar_Cron.СледующийМомент(Выражение, Момент, МинутВ60Сутках);
		Если СледующийМомент = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(СледующийМомент);
		Момент = СледующийМомент;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СериализацияПараметров

// Разобрать ar_ПараметрыJSON в view-реквизиты формы по типу триггера.
//
&НаСервере
Процедура РазобратьПараметрыJSON()

	РасписаниеCron = "";
	MentionКлючевыеСлова = "";
	WebhookПараметрыJSON = "";

	Если ПустаяСтрока(Объект.ar_ПараметрыJSON) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		РазобраноеЗначение = ar_JSON.ИзJSON(Объект.ar_ПараметрыJSON);
	Исключение
		// ar_JSON.ИзJSON не выбрасывает исключений по контракту (UTIL-01),
		// но обрабатываем защитно - невалидный/непредвиденный результат
		// трактуется как Неопределено (молчаливая деградация).
		РазобраноеЗначение = Неопределено;
	КонецПопытки;

	Если ТипЗнч(РазобраноеЗначение) = Тип("Структура")
		Или ТипЗнч(РазобраноеЗначение) = Тип("Соответствие") Тогда
		РазобратьКоллекциюПараметров(РазобраноеЗначение);
	Иначе
		// Невалидный JSON или примитив - для webhook показать сырую строку.
		WebhookПараметрыJSON = Объект.ar_ПараметрыJSON;
	КонецЕсли;

КонецПроцедуры

// Разложить разобранную коллекцию параметров (Структура или Соответствие)
// в view-реквизиты формы по текущему типу триггера.
//
// Параметры:
//  Коллекция - Структура
//             - Соответствие - результат разбора ar_ПараметрыJSON.
//
&НаСервере
Процедура РазобратьКоллекциюПараметров(Знач Коллекция)

	Если Объект.ar_ТипТриггера = "cron" Тогда
		Выражение = ПолучитьСвойствоКоллекции(Коллекция, "expression");
		РасписаниеCron = ?(Выражение = Неопределено, "", Строка(Выражение));
	ИначеЕсли Объект.ar_ТипТриггера = "mention" Тогда
		МассивКлючевыхСлов = ПолучитьСвойствоКоллекции(Коллекция, "keywords");
		Если ТипЗнч(МассивКлючевыхСлов) = Тип("Массив") Тогда
			MentionКлючевыеСлова = СтрСоединить(МассивКлючевыхСлов, ", ");
		КонецЕсли;
	Иначе
		// webhook и нераспознанные типы - показать "красиво" отформатированный JSON.
		Попытка
			WebhookПараметрыJSON = ar_JSON.КрасивыйФорматJSON(Коллекция);
		Исключение
			// ar_JSON.КрасивыйФорматJSON не выбрасывает исключений по контракту
			// (UTIL-01), но обрабатываем защитно - откатываемся на исходную строку.
			WebhookПараметрыJSON = Объект.ar_ПараметрыJSON;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Возвращает значение свойства ИмяСвойства из Коллекция (Структура или
// Соответствие) либо Неопределено, если свойство отсутствует. Унифицирует
// доступ к результату ar_JSON.ИзJSON, который может вернуть оба типа.
//
// Параметры:
//  Коллекция    - Структура
//               - Соответствие - результат разбора ar_ПараметрыJSON.
//  ИмяСвойства  - Строка - имя искомого свойства/ключа.
//
// Возвращаемое значение:
//  Произвольный - значение свойства либо Неопределено, если оно отсутствует.
//
&НаСервере
Функция ПолучитьСвойствоКоллекции(Знач Коллекция, Знач ИмяСвойства)

	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(ИмяСвойства, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(ИмяСвойства);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Сериализовать view-реквизиты в ar_ПараметрыJSON по текущему типу триггера.
//
// Параметры:
//  ТекущийОбъект - СправочникОбъект.ar_Рутины - объект, записываемый
//                  в обработчике ПередЗаписьюНаСервере.
//
&НаСервере
Процедура СериализоватьПараметрыJSON(ТекущийОбъект)

	ТипТриггера = ТекущийОбъект.ar_ТипТриггера;

	Если ТипТриггера = "manual" Тогда
		ТекущийОбъект.ar_ПараметрыJSON = "";
	ИначеЕсли ТипТриггера = "cron" Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("expression", РасписаниеCron);
		ТекущийОбъект.ar_ПараметрыJSON = СериализоватьВJSON(СтруктураПараметров);
	ИначеЕсли ТипТриггера = "mention" Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("keywords", РазобратьКлючевыеСлова(MentionКлючевыеСлова));
		ТекущийОбъект.ar_ПараметрыJSON = СериализоватьВJSON(СтруктураПараметров);
	ИначеЕсли ТипТриггера = "webhook" Тогда
		ТекущийОбъект.ar_ПараметрыJSON = WebhookПараметрыJSON;
	Иначе
		// Для прочих нераспознанных типов триггера (например, будущего "event")
		// ar_ПараметрыJSON остаётся без изменений (defensive: не теряем данные).
		ТекущийОбъект.ar_ПараметрыJSON = ТекущийОбъект.ar_ПараметрыJSON;
	КонецЕсли;

КонецПроцедуры

// Разбирает строку ключевых слов через запятую в массив непустых
// обрезанных строк.
//
// Параметры:
//  СтрокаКлючевыхСлов - Строка - ключевые слова, разделённые запятыми.
//
// Возвращаемое значение:
//  Массив из Строка - непустые обрезанные ключевые слова.
//
&НаСервере
Функция РазобратьКлючевыеСлова(Знач СтрокаКлючевыхСлов)

	Массив = Новый Массив;

	Если ПустаяСтрока(СтрокаКлючевыхСлов) Тогда
		Возврат Массив;
	КонецЕсли;

	Части = СтрРазделить(СтрокаКлючевыхСлов, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Обрезанная = СокрЛП(Часть);
		Если Не ПустаяСтрока(Обрезанная) Тогда
			Массив.Добавить(Обрезанная);
		КонецЕсли;
	КонецЦикла;

	Возврат Массив;

КонецФункции

// Сериализует значение в JSON-строку, защитно оборачивая вызов
// ar_JSON.ВЗначениеJSON (по контракту UTIL-01 функция не выбрасывает
// исключений, но обрабатываем защитно на случай непредвиденных ошибок
// окружения - запись не должна падать из-за сериализации view-полей).
//
// Параметры:
//  Значение - Структура - сериализуемые данные параметров триггера.
//
// Возвращаемое значение:
//  Строка - JSON-представление Значение либо "" при ошибке сериализации.
//
&НаСервере
Функция СериализоватьВJSON(Знач Значение)

	Попытка
		Возврат ar_JSON.ВЗначениеJSON(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Простая проверка: является ли строка валидным JSON.
//
// Параметры:
//  Текст - Строка - проверяемый JSON.
//
// Возвращаемое значение:
//  Булево - Истина, если строка парсится как JSON.
//
&НаСервере
Функция ЭтоВалидныйJSON(Знач Текст)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Попытка
		ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Результат = Истина;
	Исключение
		// JSON невалиден (или поток нельзя корректно закрыть после невалидных
		// данных) - в обоих случаях фиксируем результат как "невалиден".
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает имя действия из служебной ссылки "1c://<действие>?<параметры>".
//
&НаКлиентеНаСервереБезКонтекста
Функция ДействиеИзСсылки(Знач Ссылка)

	Тело = Сред(Ссылка, СтрДлина("1c://") + 1);
	ПозицияВопроса = СтрНайти(Тело, "?");
	Если ПозицияВопроса > 0 Тогда
		Тело = Лев(Тело, ПозицияВопроса - 1);
	КонецЕсли;
	Возврат СокрЛП(Тело);

КонецФункции

// Разбирает query-параметры служебной ссылки в структуру { имя -> значение }.
// URL-декодирование не применяется: в ссылках передаются только служебные
// идентификаторы (типы триггера, имена действий) без спецсимволов, пробелов
// и %-последовательностей. Значения полей ввода через ссылку не передаются -
// они читаются из DOM в СчитатьПоляВводаИзDOM.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыИзСсылки(Знач Ссылка)

	Результат = Новый Структура;
	ПозицияВопроса = СтрНайти(Ссылка, "?");
	Если ПозицияВопроса = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = Сред(Ссылка, ПозицияВопроса + 1);
	Пары = СтрРазделить(Хвост, "&", Ложь);
	Для Каждого Пара Из Пары Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Пара, ПозицияРавно - 1);
		Значение = Сред(Пара, ПозицияРавно + 1);
		Если Не ПустаяСтрока(Имя) Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
