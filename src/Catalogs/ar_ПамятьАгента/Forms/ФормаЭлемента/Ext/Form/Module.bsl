////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника ar_ПамятьАгента - UI-18.
//
// Поля:
//   ar_Агент      - только просмотр (заполняется при создании через форму агента).
//   ar_Текст      - основное поле редактирования (обязательное).
//   ar_Тип        - выбор из списка: fact / preference / rule / note.
//   ar_Источник   - только просмотр (устанавливается автоматически).
//   ar_Создано, ar_Обновлено - только просмотр (заполняет ObjectModule).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// Заполнить список выбора типов записи памяти.
	СписокТипов = Элементы.ПолеТип.СписокВыбора;
	СписокТипов.Добавить("fact",       НСтр("ru = 'Факт'; en = 'Fact'"));
	СписокТипов.Добавить("preference", НСтр("ru = 'Предпочтение'; en = 'Preference'"));
	СписокТипов.Добавить("rule",       НСтр("ru = 'Правило'; en = 'Rule'"));
	СписокТипов.Добавить("note",       НСтр("ru = 'Заметка'; en = 'Note'"));

	Если НЕ ПравоДоступа("Изменение", Метаданные.Справочники.ar_ПамятьАгента) Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

