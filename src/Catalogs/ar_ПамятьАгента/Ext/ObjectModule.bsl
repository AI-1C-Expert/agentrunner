// Модуль объекта справочника ar_ПамятьАгента.
//
// Зона ответственности (META-25):
//   - автозаполнение ar_Создано и ar_Обновлено при создании/изменении;
//   - автозаполнение Наименования первыми символами ar_Текст.
//
// Справочник - реестр записей долгосрочной памяти агента (index).

#Область ОбработчикиСобытий

// Платформенный обработчик перед записью.
//
// Параметры:
//  Отказ - Булево - флаг отказа от записи.
//
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Автозаполнение Наименования.
	Если ПустаяСтрока(Наименование) И ЗначениеЗаполнено(ar_Текст) Тогда
		Наименование = Лев(ar_Текст, 50);
	КонецЕсли;

	// Автозаполнение дат.
	Если ЭтоНовый() Тогда
		ar_Создано = ТекущаяДатаСеанса();
		ar_Обновлено = ТекущаяДатаСеанса();
	Иначе
		ОбъектБД = Ссылка.ПолучитьОбъект();
		Если ОбъектБД <> Неопределено И ОбъектБД.ar_Текст <> ar_Текст Тогда
			ar_Обновлено = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
