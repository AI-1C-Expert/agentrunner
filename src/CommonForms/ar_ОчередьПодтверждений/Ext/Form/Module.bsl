////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_ОчередьПодтверждений («Очередь подтверждений» / «Approval queue») -
// UI-08, HTML-редизайн UI-23.
//
// Вся форма - одно поле HTML (ПолеHTMLОчередь): список карточек pending/
// awaiting_input-записей РегистрСведений.ar_ОчередьApproval, одна карточка -
// одно действие. Паттерн рендера и обратной связи - тот же, что в
// ОбщаяФорма.ar_Диалог и Справочник.ar_Агенты.ФормаЭлемента:
//
//  - интерактивные элементы - ссылки вида "1c://<действие>?<параметры>";
//    клик приходит в ПолеHTMLОчередьПриНажатии через ДанныеСобытия.Href
//    (эталон БСП ВзаимодействияКлиент.ПолеHTMLПриНажатии), стандартная
//    обработка подавляется, BSL разбирает схему и выполняет действие;
//  - причина отклонения читается из DOM (Элементы.ПолеHTMLОчередь.Документ) -
//    работает в толстом/тонком клиенте, в веб-клиенте деградирует;
//  - человекочитаемое представление карточки (название действия, риск, что
//    произойдёт, параметры вместо GUID) собирает ar_ApprovalПредставление -
//    общий модуль, тот же, что использует карточка approval в чате ar_Диалог.
//
// Причина редизайна (UI-23, E2E-приёмка PAY-01 2026-08-14): списочная форма с
// Representation=Tree и группировкой по ar_RunId показывала голые GUID
// (ApprovalId, RunId) и пустые технические колонки ToolName/RiskLevel/AgentName,
// а узел группировки при единственном действии запуска был визуально
// неотличим от самой строки - оператор не понимал, что подтверждает, и мог
// нажать «Принять» вслепую. HTML-карточка показывает представление tool,
// бейдж риска, фразу «что произойдёт» и параметры с развёрнутыми ссылками
// без ручного раскрытия групп.
//
// Группировка по RunId сохранена как визуальный заголовок над блоком карточек
// одного запуска (не платформенная группировка дерева) - оператор видит, что
// несколько действий пришли из одного запуска, но каждая карточка кликабельна
// независимо.
//
// CONS-05: форма принимает необязательный параметр открытия RunId (Строка) -
// переход из ar_КонсольАгентов по строке запуска показывает только карточки
// этого RunId, а не всю очередь. Реквизит-приёмник ОтборRunId не сохраняемый
// (SavedData не установлен в Form.xml) - разовый параметр открытия, не
// пользовательская настройка отбора.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Параметры.Свойство("RunId", ОтборRunId);
	Если ТипЗнч(ОтборRunId) <> Тип("Строка") Тогда
		ОтборRunId = "";
	КонецЕсли;

	ПерерисоватьОчередь();

КонецПроцедуры

#КонецОбласти

#Область ДиспетчерHTML

// Обрабатывает клик по любому элементу внутри HTML-очереди.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент              - ПолеФормы - поле ПолеHTMLОчередь.
//  ДанныеСобытия        - ФиксированнаяСтруктура - данные DOM-события клика
//                         (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                         открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLОчередьПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	СтандартнаяОбработка = Ложь;

	Действие = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	// ВыполнитьApprove/Reject/Ответ - Асинх-процедуры (внутри используют
	// Ждать ПредупреждениеАсинх), но вызываются здесь без Ждать: Ждать
	// применим только к функциям, а не к процедурам - платформа падает
	// "Procedure called as function" (эталон - ar_Диалог, тот же паттерн).
	Если Действие = "approve" Тогда
		ВыполнитьApprove(ПараметрыСсылки);
	ИначеЕсли Действие = "reject" Тогда
		ВыполнитьReject(ПараметрыСсылки);
	ИначеЕсли Действие = "answer" Тогда
		ВыполнитьОтвет(ПараметрыСсылки);
	ИначеЕсли Действие = "refresh" Тогда
		ПерерисоватьОчередь();
	ИначеЕсли Действие = "open-run" Тогда
		ОткрытьRunViewer(ПараметрыСсылки);
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КлиентскиеДействия

// Открывает ОбщаяФорма.ar_ПросмотрЗапуска для RunId группы (тот же паттерн,
// что Справочник.ar_Агенты.ФормаЭлемента.ОткрытьRunViewer) - форма Run Viewer
// (UI-10) может быть не установлена в базе, в этом случае не падаем.
//
&НаКлиенте
Процедура ОткрытьRunViewer(Знач ПараметрыСсылки)

	RunId = "";
	ПараметрыСсылки.Свойство("id", RunId);
	Если ПустаяСтрока(RunId) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОткрытьФорму("ОбщаяФорма.ar_ПросмотрЗапуска", Новый Структура("RunId", RunId), ЭтотОбъект);
	Исключение
		ПоказатьПредупреждение(, НСтр("ru='Форма Run Viewer недоступна.';
			|en='The Run Viewer form is unavailable.'"));
	КонецПопытки;

КонецПроцедуры

// APPR-02: разрешить действие карточки.
//
&НаКлиенте
Асинх Процедура ВыполнитьApprove(Знач ПараметрыСсылки)

	ApprovalId = "";
	ПараметрыСсылки.Свойство("id", ApprovalId);
	Если ПустаяСтрока(ApprovalId) Тогда
		Возврат;
	КонецЕсли;

	Результат = ПринятьНаСервере(ApprovalId);

	Если Результат.Успех Тогда
		Если Результат.ДействиеВыполнено Тогда
			ПоказатьОповещениеПользователя(
				НСтр("ru = 'Принято'; en = 'Approved'"),
				,
				?(Результат.ДокументСсылка = Неопределено,
					НСтр("ru = 'Действие выполнено'; en = 'Action executed'"),
					СтрШаблон(НСтр("ru = 'Создан объект: %1'; en = 'Object created: %1'"),
						Строка(Результат.ДокументСсылка))));
		Иначе
			Ждать ПредупреждениеАсинх(СтрШаблон(
				НСтр("ru = 'Решение принято, но действие не выполнено: %1
					|
					|Подробности - в служебном логе (ar_ПоказатьЛог).';
					|en = 'Decision recorded, but the action was not executed: %1
					|
					|See the service log (ar_ПоказатьЛог) for details.'"),
				?(ПустаяСтрока(Результат.ДействиеСообщение),
					НСтр("ru = 'причина не указана'; en = 'no reason given'"),
					Результат.ДействиеСообщение)));
		КонецЕсли;
	Иначе
		Ждать ПредупреждениеАсинх(СтрШаблон(
			НСтр("ru = 'Не удалось принять действие: %1'; en = 'Failed to approve action: %1'"),
			Результат.Причина));
	КонецЕсли;

	ПерерисоватьОчередь();

КонецПроцедуры

// APPR-03: отклонить действие карточки. Причина читается из инлайн-поля ввода
// рядом с кнопкой (id="ar-reject-<ApprovalId>", тот же паттерн, что в ar_Диалог).
//
&НаКлиенте
Асинх Процедура ВыполнитьReject(Знач ПараметрыСсылки)

	ApprovalId = "";
	ПараметрыСсылки.Свойство("id", ApprovalId);
	Если ПустаяСтрока(ApprovalId) Тогда
		Возврат;
	КонецЕсли;

	Причина = ПрочитатьЗначениеИзDOM("ar-reject-" + ApprovalId);
	Если Причина = Неопределено Тогда
		Причина = "";
	КонецЕсли;

	Результат = ОтклонитьНаСервере(ApprovalId, Причина);

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отклонено'; en = 'Rejected'"));
	Иначе
		Ждать ПредупреждениеАсинх(СтрШаблон(
			НСтр("ru = 'Не удалось отклонить действие: %1'; en = 'Failed to reject action: %1'"),
			Результат.Причина));
	КонецЕсли;

	ПерерисоватьОчередь();

КонецПроцедуры

// TOOL-19 D14: ответить на вопрос ask_user. Ответ читается из инлайн-поля
// (id="ar-answer-<ApprovalId>") либо из параметра "c" (индекс кнопки-варианта).
//
&НаКлиенте
Асинх Процедура ВыполнитьОтвет(Знач ПараметрыСсылки)

	ApprovalId = "";
	ПараметрыСсылки.Свойство("id", ApprovalId);
	Если ПустаяСтрока(ApprovalId) Тогда
		Возврат;
	КонецЕсли;

	Ответ = "";
	ИндексВарианта = "";
	Если ПараметрыСсылки.Свойство("c", ИндексВарианта) И НЕ ПустаяСтрока(ИндексВарианта) Тогда
		Ответ = ВариантПоИндексуНаСервере(ApprovalId, ИндексВарианта);
	Иначе
		ЗначениеПоля = ПрочитатьЗначениеИзDOM("ar-answer-" + ApprovalId);
		Если ЗначениеПоля <> Неопределено Тогда
			Ответ = ЗначениеПоля;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Ответ) Тогда
		Ждать ПредупреждениеАсинх(НСтр(
			"ru = 'Введите ответ.'; en = 'Enter an answer.'"));
		Возврат;
	КонецЕсли;

	Успех = ОтветитьНаВопросНаСервере(ApprovalId, Ответ);
	Если НЕ Успех Тогда
		Ждать ПредупреждениеАсинх(НСтр(
			"ru='Не удалось зафиксировать ответ. Запись могла быть уже обработана.';
			|en='Failed to record the answer. The record may have already been processed.'"));
	КонецЕсли;

	ПерерисоватьОчередь();

КонецПроцедуры

// Читает значение элемента input по id из DOM HTML-документа (тот же контракт,
// что в Справочник.ar_Агенты.ФормаЭлемента / ar_Диалог). Возвращает Неопределено,
// если DOM-доступ недоступен (веб-клиент) или элемент не найден.
//
&НаКлиенте
Функция ПрочитатьЗначениеИзDOM(Знач Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLОчередь.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат "" + ЭлементВвода.value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СерверныеОбёртки

&НаСервере
Процедура ПерерисоватьОчередь()

	СтрокаHTMLОчередь = HTMLКаркас(HTMLСписокОчереди(ОтборRunId));

КонецПроцедуры

&НаСервере
Функция ПринятьНаСервере(Знач ApprovalId)

	Возврат ar_Approval.Принять(ApprovalId, Пользователи.ТекущийПользователь());

КонецФункции

&НаСервере
Функция ОтклонитьНаСервере(Знач ApprovalId, Знач Причина)

	Возврат ar_Approval.Отклонить(ApprovalId, Пользователи.ТекущийПользователь(), Причина);

КонецФункции

&НаСервере
Функция ОтветитьНаВопросНаСервере(Знач ApprovalId, Знач Ответ)

	Возврат ar_Approval.ОтветитьНаВопрос(ApprovalId, Пользователи.ТекущийПользователь(), Ответ);

КонецФункции

// Возвращает текст варианта ask_user по индексу кнопки-выбора (см. HTMLКарточкаAskUser).
//
&НаСервере
Функция ВариантПоИндексуНаСервере(Знач ApprovalId, Знач ИндексСтрокой)

	PayloadJSON = ПрочитатьPayloadПоApprovalId(ApprovalId);
	ДанныеДиалога = ДанныеДиалогаAskUser(PayloadJSON);

	ОписаниеТипов = Новый ОписаниеТипов("Число");
	Индекс = ОписаниеТипов.ПривестиЗначение(ИндексСтрокой);

	Если Индекс < 0 ИЛИ Индекс >= ДанныеДиалога.Варианты.Количество() Тогда
		Возврат "";
	КонецЕсли;

	Возврат ДанныеДиалога.Варианты[Индекс];

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает pending/awaiting_input-записи очереди, упорядоченные по запуску, и
// строит для каждой человекочитаемую карточку через ar_ApprovalПредставление.
//
// Параметры:
//   ОтборRunId - Строка - необязательный отбор по RunId (CONS-05: переход из
//                ar_КонсольАгентов). Пустая строка - без отбора, вся очередь
//                (поведение до CONS-05).
//
// Возвращаемое значение:
//  Массив из Структура - {
//    RunId          - Строка,
//    AgentName      - Строка - представление агента запуска,
//    СозданоВ       - Дата   - момент постановки первого действия в группе,
//    Карточки       - Массив из Структура (см. ar_ApprovalПредставление.СобратьКарточку,
//                      дополнительно: СозданоВ, Статус, ЭтоВопрос, Варианты)
//  } - одна структура на RunId, в порядке первого появления.
//
&НаСервереБезКонтекста
Функция СгруппированныеЗаписиОчереди(Знач ОтборRunId = "")

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.ar_ApprovalId КАК ApprovalId,
		|	Очередь.ar_RunId КАК RunId,
		|	Очередь.ar_ActionPayloadJSON КАК PayloadJSON,
		|	Очередь.ar_Статус КАК Статус,
		|	Очередь.ar_СозданоВ КАК СозданоВ
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	(Очередь.ar_Статус = ""pending""
		|		ИЛИ Очередь.ar_Статус = ""awaiting_input"")
		|	И (&ОтборRunId = """" ИЛИ Очередь.ar_RunId = &ОтборRunId)
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ar_RunId,
		|	Очередь.ar_Sequence";
	Запрос.УстановитьПараметр("ОтборRunId", ОтборRunId);

	Группы = Новый Массив;
	ИндексГруппПоRunId = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		RunId = "" + Выборка.RunId;

		Группа = ИндексГруппПоRunId.Получить(RunId);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("RunId", RunId);
			Группа.Вставить("AgentName", ИмяАгентаЗапускаНаСервере(RunId));
			Группа.Вставить("СозданоВ", Выборка.СозданоВ);
			Группа.Вставить("Карточки", Новый Массив);
			ИндексГруппПоRunId.Вставить(RunId, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;

		Карточка = ar_ApprovalПредставление.СобратьКарточку("" + Выборка.ApprovalId, "" + Выборка.PayloadJSON);
		Карточка.Вставить("СозданоВ", Выборка.СозданоВ);
		Карточка.Вставить("Статус", "" + Выборка.Статус);

		ДанныеДиалога = ДанныеДиалогаAskUser("" + Выборка.PayloadJSON);
		Карточка.Вставить("ЭтоВопрос", Выборка.Статус = "awaiting_input");
		Карточка.Вставить("Вопрос", ДанныеДиалога.Вопрос);
		Карточка.Вставить("Подсказка", ДанныеДиалога.Подсказка);
		Карточка.Вставить("Варианты", ДанныеДиалога.Варианты);

		Группа.Карточки.Добавить(Карточка);

	КонецЦикла;

	Возврат Группы;

КонецФункции

// Представление агента, запустившего RunId (для заголовка группы карточек).
// [Реф: src/InformationRegisters/ar_Запуски.xml] - измерение ar_RunId, ресурс
// ar_АгентРеф (СправочникСсылка.ar_Агенты).
//
&НаСервереБезКонтекста
Функция ИмяАгентаЗапускаНаСервере(Знач RunId)

	Если ПустаяСтрока(RunId) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПРЕДСТАВЛЕНИЕ(Запуски.ar_АгентРеф) КАК ИмяАгента
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_RunId = &RunId";
	Запрос.УстановитьПараметр("RunId", RunId);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат "";
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат "" + Выборка.ИмяАгента;

КонецФункции

// Читает ar_ActionPayloadJSON записи очереди напрямую из регистра по ApprovalId.
// Нужна для полей, отсутствующих в структуре, переданной клиентом (answer-flow).
//
&НаСервереБезКонтекста
Функция ПрочитатьPayloadПоApprovalId(Знач ApprovalId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.ar_ActionPayloadJSON КАК ActionPayloadJSON
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_ApprovalId = &ApprovalId";
	Запрос.УстановитьПараметр("ApprovalId", ApprovalId);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат "";
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат "" + Выборка.ActionPayloadJSON;

КонецФункции

// Разбирает payload ask_user (вопрос/подсказка/варианты) - тот же контракт,
// что ar_Диалог.ПолучитьДанныеДиалогаAskUser.
//
&НаСервереБезКонтекста
Функция ДанныеДиалогаAskUser(Знач PayloadJSON)

	Результат = Новый Структура;
	Результат.Вставить("Вопрос", "");
	Результат.Вставить("Подсказка", "");
	Результат.Вставить("Варианты", Новый Массив);

	Попытка
		Payload = ar_JSON.ИзJSON(PayloadJSON);
		Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
			// Payload распарсился, но это не объект - как и ошибка парсинга,
			// не критично для диалога, но должно остаться в служебном логе
			// (см. project_service_log_register).
			ar_СлужебныйЛог.Записать("ar_ОчередьПодтверждений.ДанныеДиалогаAskUser",
				"payload_not_object",
				"Payload распарсился, но не является объектом (Соответствие). Фактический тип: "
					+ Строка(ТипЗнч(Payload)),
				"Предупреждение");
			Возврат Результат;
		КонецЕсли;
		ЗначениеВопроса = Payload.Получить("question");
		ЗначениеПодсказки = Payload.Получить("hint");
		ЗначениеВариантов = Payload.Получить("choices");
		Если ТипЗнч(ЗначениеВопроса) = Тип("Строка") Тогда
			Результат.Вопрос = ЗначениеВопроса;
		КонецЕсли;
		Если ТипЗнч(ЗначениеПодсказки) = Тип("Строка") Тогда
			Результат.Подсказка = ЗначениеПодсказки;
		КонецЕсли;
		Если ТипЗнч(ЗначениеВариантов) = Тип("Массив") Тогда
			Для Каждого Вариант Из ЗначениеВариантов Цикл
				Если ТипЗнч(Вариант) = Тип("Строка") Тогда
					Результат.Варианты.Добавить(Вариант);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Ошибки парсинга не критичны - диалог без деталей, но след в служебном
		// логе остаётся для диагностики (см. project_service_log_register).
		ar_СлужебныйЛог.Записать("ar_ОчередьПодтверждений.ДанныеДиалогаAskUser",
			"payload_parse_failed", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РендерHTML

// Параметры:
//   ОтборRunId - Строка - см. СгруппированныеЗаписиОчереди. Непустое значение
//                добавляет заголовок-пометку "фильтр: запуск …" над списком
//                (CONS-05, UX-подсказка, что оператор смотрит не всю очередь).
//
&НаСервереБезКонтекста
Функция HTMLСписокОчереди(Знач ОтборRunId = "")

	Группы = СгруппированныеЗаписиОчереди(ОтборRunId);

	ПометкаОтбора = "";
	Если НЕ ПустаяСтрока(ОтборRunId) Тогда
		ПометкаОтбора = "<div class=""ar-filter-note"">"
			+ ЭкранироватьHTML(СтрШаблон(НСтр("ru='Фильтр: запуск %1'; en='Filter: run %1'"), ОтборRunId))
			+ "</div>";
	КонецЕсли;

	Если Группы.Количество() = 0 Тогда
		Возврат ПометкаОтбора + "<div class=""ar-empty"">"
			+ ЭкранироватьHTML(?(ПустаяСтрока(ОтборRunId),
				НСтр("ru='Очередь пуста'; en='Queue is empty'"),
				НСтр("ru='По этому запуску нет ожидающих подтверждений'; en='No pending approvals for this run'")))
			+ "</div>";
	КонецЕсли;

	Содержимое = "";
	Для Каждого Группа Из Группы Цикл
		Содержимое = Содержимое + HTMLГруппаЗапуска(Группа);
	КонецЦикла;

	Возврат "<div class=""ar-feed-inner"">" + ПометкаОтбора + Содержимое + "</div>";

КонецФункции

// Заголовок запуска (агент + время постановки первого действия) + карточки.
// Не платформенная группировка дерева - обычный HTML-блок, каждая карточка
// внутри кликабельна независимо (UI-23: узел-обёртка Tree был неотличим от
// строки, здесь такой проблемы нет по конструкции).
//
&НаСервереБезКонтекста
Функция HTMLГруппаЗапуска(Знач Группа)

	ЗаголовокЧасти = Новый Массив;
	Если НЕ ПустаяСтрока(Группа.AgentName) Тогда
		ЗаголовокЧасти.Добавить(ЭкранироватьHTML(Группа.AgentName));
	КонецЕсли;
	Если ЗначениеЗаполнено(Группа.СозданоВ) Тогда
		ЗаголовокЧасти.Добавить(ЭкранироватьHTML(ar_Утилиты.ФорматДатаПользователю(Группа.СозданоВ)));
	КонецЕсли;

	Заголовок = "<div class=""ar-run-head"">"
		+ "<span class=""ar-run-title"">" + СтрСоединить(ЗаголовокЧасти, " · ") + "</span>"
		+ "<a class=""ar-run-open"" href=""1c://open-run?id=" + ЭкранироватьHTML(Группа.RunId) + """>"
		+ ЭкранироватьHTML(НСтр("ru='Открыть запуск'; en='Open run'")) + "</a>"
		+ "</div>";

	Карточки = "";
	Для Каждого Карточка Из Группа.Карточки Цикл
		Если Карточка.ЭтоВопрос Тогда
			Карточки = Карточки + HTMLКарточкаAskUser(Карточка);
		Иначе
			Карточки = Карточки + HTMLКарточкаApproval(Карточка);
		КонецЕсли;
	КонецЦикла;

	Возврат "<div class=""ar-run-group"">" + Заголовок + Карточки + "</div>";

КонецФункции

// Карточка запроса на подтверждение действия - то же представление, что в
// чате ar_Диалог (общий модуль ar_ApprovalПредставление), плюс время постановки
// и технические GUID под спойлером (не первое, что видит оператор, но доступны
// для диагностики).
//
&НаСервереБезКонтекста
Функция HTMLКарточкаApproval(Знач Карточка)

	РискHTML = "";
	Если НЕ ПустаяСтрока(Карточка.Риск) Тогда
		РискHTML = ar_ApprovalПредставление.БейджРиска(Карточка.Риск, Ложь);
	КонецЕсли;

	Заголовок = ?(ПустаяСтрока(Карточка.Представление), Карточка.ИмяTool, Карточка.Представление);

	Детали = "";

	Если НЕ ПустаяСтрока(Карточка.Эффект) Тогда
		Детали = Детали + "<div class=""ar-card-effect"">"
			+ ЭкранироватьHTML(Карточка.Эффект) + "</div>";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Карточка.Обоснование) Тогда
		Детали = Детали + "<div class=""ar-card-note""><b>"
			+ ЭкранироватьHTML(НСтр("ru='Зачем:'; en='Why:'")) + "</b> "
			+ ЭкранироватьHTML(Карточка.Обоснование) + "</div>";
	КонецЕсли;

	Если Карточка.Параметры.Количество() > 0 Тогда
		Строки = "";
		Для Каждого Параметр Из Карточка.Параметры Цикл
			КлассЗначения = ?(Параметр.ЭтоСсылка, "ar-param-val ar-param-ref", "ar-param-val");
			Строки = Строки + "<div class=""ar-param"">"
				+ "<span class=""ar-param-key"">" + ЭкранироватьHTML(Параметр.Подпись) + "</span>"
				+ "<span class=""" + КлассЗначения + """>"
				+ ЭкранироватьHTML(Параметр.Значение) + "</span></div>";
		КонецЦикла;
		Детали = Детали + "<div class=""ar-card-params"">" + Строки + "</div>";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Карточка.АргументыТекст) Тогда
		Детали = Детали + "<details class=""ar-card-raw""><summary>"
			+ ЭкранироватьHTML(НСтр("ru='Технические параметры'; en='Technical parameters'"))
			+ "</summary><pre class=""ar-card-args"">"
			+ ЭкранироватьHTML(Карточка.АргументыТекст) + "</pre>"
			+ "<div class=""ar-card-ids"">ApprovalId: " + ЭкранироватьHTML(Карточка.ApprovalId) + "</div>"
			+ "</details>";
	Иначе
		Детали = Детали + "<details class=""ar-card-raw""><summary>"
			+ ЭкранироватьHTML(НСтр("ru='Технический идентификатор'; en='Technical identifier'"))
			+ "</summary><div class=""ar-card-ids"">ApprovalId: "
			+ ЭкранироватьHTML(Карточка.ApprovalId) + "</div></details>";
	КонецЕсли;

	Ид = Карточка.ApprovalId;

	ИмяТехническое = "";
	Если НЕ ПустаяСтрока(Карточка.Представление) И Карточка.Представление <> Карточка.ИмяTool Тогда
		ИмяТехническое = " <span class=""ar-card-tool"">"
			+ ЭкранироватьHTML(Карточка.ИмяTool) + "</span>";
	КонецЕсли;

	ВремяHTML = "";
	Если ЗначениеЗаполнено(Карточка.СозданоВ) Тогда
		ВремяHTML = "<span class=""ar-card-time"">"
			+ ЭкранироватьHTML(ar_Утилиты.ФорматДатаПользователю(Карточка.СозданоВ)) + "</span>";
	КонецЕсли;

	Возврат "<div class=""ar-card ar-card-approval"">"
		+ "<div class=""ar-card-head"">&#9888; "
		+ ЭкранироватьHTML(НСтр("ru='Агент запрашивает разрешение на действие:';
			|en='Agent requests permission to perform:'"))
		+ ВремяHTML
		+ "</div>"
		+ "<div class=""ar-card-title""><b>" + ЭкранироватьHTML(Заголовок) + "</b> "
		+ РискHTML + ИмяТехническое + "</div>"
		+ Детали
		+ "<div class=""ar-card-actions"">"
		+ "<a class=""ar-btn ar-btn-ok"" href=""1c://approve?id=" + Ид + """>"
		+ ЭкранироватьHTML(НСтр("ru='Разрешить'; en='Approve'")) + "</a>"
		+ "<a class=""ar-btn ar-btn-no"" href=""1c://reject?id=" + Ид + """>"
		+ ЭкранироватьHTML(НСтр("ru='Отклонить'; en='Reject'")) + "</a>"
		+ "<input class=""ar-input-inline"" id=""ar-reject-" + Ид + """ type=""text"" placeholder="""
		+ ЭкранироватьHTML(НСтр("ru='Причина отказа (необязательно)'; en='Rejection reason (optional)'"))
		+ """>"
		+ "</div></div>";

КонецФункции

// Карточка ответа на ask_user: кнопки вариантов + свободный ответ - тот же
// рендер, что в чате ar_Диалог.
//
&НаСервереБезКонтекста
Функция HTMLКарточкаAskUser(Знач Карточка)

	Ид = Карточка.ApprovalId;

	КнопкиВариантов = "";
	Индекс = 0;
	Для Каждого Вариант Из Карточка.Варианты Цикл
		КнопкиВариантов = КнопкиВариантов
			+ "<a class=""ar-btn ar-btn-choice"" href=""1c://answer?id=" + Ид
			+ "&c=" + Формат(Индекс, "ЧГ=0") + """>"
			+ ЭкранироватьHTML("" + Вариант) + "</a>";
		Индекс = Индекс + 1;
	КонецЦикла;

	ТекстВопроса = Карточка.Вопрос;
	Если НЕ ПустаяСтрока(Карточка.Подсказка) Тогда
		ТекстВопроса = ТекстВопроса + " (" + Карточка.Подсказка + ")";
	КонецЕсли;

	Возврат "<div class=""ar-card ar-card-ask"">"
		+ "<div class=""ar-card-head"">"
		+ ЭкранироватьHTML(НСтр("ru='Агент ждёт ответа, чтобы продолжить:'; en='Agent is waiting for an answer to continue:'"))
		+ "</div>"
		+ "<div class=""ar-card-title"">" + ЭкранироватьHTML(ТекстВопроса) + "</div>"
		+ ?(ПустаяСтрока(КнопкиВариантов), "",
			"<div class=""ar-card-choices"">" + КнопкиВариантов + "</div>")
		+ "<div class=""ar-card-actions"">"
		+ "<input class=""ar-input-inline"" id=""ar-answer-" + Ид + """ type=""text"" placeholder="""
		+ ЭкранироватьHTML(НСтр("ru='Свой вариант ответа...'; en='Your own answer...'")) + """>"
		+ "<a class=""ar-btn ar-btn-ok"" href=""1c://answer?id=" + Ид + """>"
		+ ЭкранироватьHTML(НСтр("ru='Ответить'; en='Answer'")) + "</a>"
		+ "<div class=""ar-card-ids"">ApprovalId: " + ЭкранироватьHTML(Ид) + "</div>"
		+ "</div></div>";

КонецФункции

// HTML-каркас страницы: минимальный CSS в той же палитре, что чат ar_Диалог
// (те же имена классов ar-card/ar-risk/ar-btn - контракт ar_ApprovalПредставление.
// БейджРиска генерирует span с этими классами).
//
&НаСервереБезКонтекста
Функция HTMLКаркас(Знач Содержимое)

	CSS =
		"html,body{margin:0;padding:0;"
		+ "font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:13px;color:#1a1a18;background:#fdfcf8;}"
		+ "*{box-sizing:border-box;}"
		+ "a{text-decoration:none;color:inherit;cursor:pointer;}"
		+ ".ar-feed-inner{max-width:760px;margin:0 auto;padding:14px 18px;}"
		+ ".ar-empty{color:#8a8778;text-align:center;margin-top:60px;line-height:1.5;}"
		+ ".ar-filter-note{font-size:11px;color:#8a7f5c;background:#f0eee6;border-radius:6px;"
		+ "padding:4px 10px;margin-bottom:10px;display:inline-block;}"
		// Группа запуска.
		+ ".ar-run-group{margin-bottom:18px;}"
		+ ".ar-run-head{display:flex;align-items:center;justify-content:space-between;"
		+ "padding:4px 2px;border-bottom:1px solid #eeece4;margin-bottom:6px;}"
		+ ".ar-run-title{font-size:12px;font-weight:600;color:#6d6a5c;}"
		+ ".ar-run-open{font-size:11px;color:#8a8778;border:1px solid #e3e1d9;border-radius:6px;padding:2px 8px;}"
		+ ".ar-run-open:hover{background:#f0eee6;}"
		// Карточки approval / ask_user (контракт ar_ApprovalПредставление.БейджРиска).
		+ ".ar-card{border-radius:12px;padding:12px 14px;margin:0 0 10px 0;}"
		+ ".ar-card-approval{background:#fdf3d7;border:1px solid #f0dfa8;}"
		+ ".ar-card-ask{background:#fdf8e8;border:1px solid #f0dfa8;}"
		+ ".ar-card-head{font-size:12px;color:#8a7f5c;margin-bottom:2px;display:flex;justify-content:space-between;}"
		+ ".ar-card-time{font-size:11px;color:#b3a67a;}"
		+ ".ar-card-title{font-size:14px;margin-bottom:6px;}"
		+ ".ar-card-tool{font-family:Consolas,Menlo,monospace;font-size:10px;color:#9a9481;}"
		+ ".ar-card-effect{font-size:12px;color:#4a4534;margin-bottom:6px;}"
		+ ".ar-card-note{font-size:12px;color:#6d6a5c;margin-bottom:6px;}"
		+ ".ar-card-params{margin-bottom:8px;}"
		+ ".ar-param{display:flex;gap:8px;font-size:12px;padding:3px 0;border-bottom:1px solid #f2ead0;}"
		+ ".ar-param:last-child{border-bottom:none;}"
		+ ".ar-param-key{flex:0 0 38%;color:#8a7f5c;}"
		+ ".ar-param-val{flex:1 1 auto;color:#2f2c22;word-break:break-word;}"
		+ ".ar-param-ref{font-weight:600;}"
		+ ".ar-card-raw{margin-bottom:8px;}"
		+ ".ar-card-raw summary{font-size:11px;color:#8a7f5c;cursor:pointer;margin-bottom:6px;}"
		+ ".ar-card-args{background:#faf9f4;border:1px solid #eeece4;border-radius:8px;padding:8px;"
		+ "font-family:Consolas,Menlo,monospace;font-size:11px;max-height:160px;overflow:auto;margin:0 0 6px 0;}"
		+ ".ar-card-ids{font-family:Consolas,Menlo,monospace;font-size:10px;color:#b3b0a2;}"
		+ ".ar-card-choices{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}"
		+ ".ar-card-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}"
		+ ".ar-risk{font-size:10px;font-weight:600;border-radius:8px;padding:1px 7px;vertical-align:middle;}"
		+ ".ar-risk-read{background:#e3f0e3;color:#2f7d32;}"
		+ ".ar-risk-write{background:#fdf3d7;color:#9c6f19;}"
		+ ".ar-risk-commit{background:#fbe9e7;color:#c0392b;}"
		// Кнопки и поля.
		+ ".ar-btn{display:inline-block;border-radius:8px;padding:6px 14px;font-weight:600;font-size:12px;}"
		+ ".ar-btn-ok{background:#2f7d32;color:#fff;}"
		+ ".ar-btn-ok:hover{background:#286b2b;}"
		+ ".ar-btn-no{background:#fff;color:#c0392b;border:1px solid #e0b4ae;}"
		+ ".ar-btn-no:hover{background:#fbe9e7;}"
		+ ".ar-btn-choice{background:#fff;border:1px solid #d8d5c8;color:#1a1a18;}"
		+ ".ar-btn-choice:hover{background:#f0eee6;}"
		+ ".ar-input-inline{flex:1;min-width:180px;border:1px solid #d8d5c8;border-radius:8px;"
		+ "padding:6px 10px;font-size:12px;font-family:inherit;}";

	Возврат "<!DOCTYPE html><html><head><meta charset=""utf-8"">"
		+ "<style>" + CSS + "</style></head><body>"
		+ Содержимое
		+ "</body></html>";

КонецФункции

#КонецОбласти

#Область HTMLУтилиты

// Экранировать спецсимволы HTML (тот же контракт, что в ar_Диалог/ar_Настройки/ar_ДиалогOld).
//
&НаСервереБезКонтекста
Функция ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

// Извлекает служебное действие из ссылки "1c://<действие>?<параметры>".
//
&НаКлиентеНаСервереБезКонтекста
Функция ДействиеИзСсылки(Знач Ссылка)

	Тело = Сред(Ссылка, СтрДлина("1c://") + 1);
	ПозицияВопроса = СтрНайти(Тело, "?");
	Если ПозицияВопроса > 0 Тогда
		Тело = Лев(Тело, ПозицияВопроса - 1);
	КонецЕсли;
	Возврат СокрЛП(Тело);

КонецФункции

// Разбирает query-параметры служебной ссылки в структуру { имя -> значение }.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыИзСсылки(Знач Ссылка)

	Результат = Новый Структура;
	ПозицияВопроса = СтрНайти(Ссылка, "?");
	Если ПозицияВопроса = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = Сред(Ссылка, ПозицияВопроса + 1);
	Пары = СтрРазделить(Хвост, "&", Ложь);
	Для Каждого Пара Из Пары Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Пара, ПозицияРавно - 1);
		Значение = Сред(Пара, ПозицияРавно + 1);
		Если НЕ ПустаяСтрока(Имя) Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
