////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_ПросмотрДействия («Просмотр действия» / «Action preview») - UI-09.
//
// Read-only генерируемая форма превью для очереди подтверждений
// (ОбщаяФорма.ar_ОчередьПодтверждений, UI-08): показывает весь набор атрибутов
// pending-действия (tool_name, agent_name, risk_level, RunId, дата постановки,
// обоснование LLM и отформатированные аргументы действия), когда payload не
// содержит навигационной ссылки на существующий объект ИБ (ветка Б команды
// «Открыть превью», см. .docs/specs/UI-09.md).
//
// Открывается программно из ar_ОчередьПодтверждений:
//   ОткрытьФорму("ОбщаяФорма.ar_ПросмотрДействия", ПараметрыФормы, ЭтотОбъект,
//       , , , , РежимОткрытияОкнаФормы.Независимый);
//
// Параметры формы (все опциональны, безопасные дефолты "" / пустая дата):
//   ApprovalId  - Строка(36) - идентификатор записи очереди.
//   RunId       - Строка(36) - идентификатор запуска.
//   ToolName    - Строка     - имя tool (tool_name).
//   AgentName   - Строка     - имя агента (agent_name).
//   RiskLevel   - Строка     - уровень риска (risk_level).
//   СозданоВ    - Дата       - момент постановки в очередь (ar_СозданоВ).
//   Rationale   - Строка(неогр.) - обоснование LLM (ar_ОбоснованиеLLM).
//   PayloadJSON - Строка(неогр.) - отформатированный JSON аргументов действия
//                 (ar_JSON.КрасивыйФорматJSON(Аргументы)).
//
// Никаких серверных мутаций форма не выполняет - закрытие не влияет на статус
// записи очереди (use-case 2, п.4 спеки UI-09).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ветка автотеста: при программном открытии формы тестами пропускаем
	// инициализацию (единый паттерн форм расширения, см. ar_ФормаПросмотраPrompt).
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ApprovalId  = СтрокаПараметра("ApprovalId");
	RunId       = СтрокаПараметра("RunId");
	ToolName    = СтрокаПараметра("ToolName");
	AgentName   = СтрокаПараметра("AgentName");
	RiskLevel   = СтрокаПараметра("RiskLevel");
	Rationale   = СтрокаПараметра("Rationale");
	PayloadJSON = СтрокаПараметра("PayloadJSON");

	ДатаПараметра = Неопределено;
	Если Параметры.Свойство("СозданоВ", ДатаПараметра) И ТипЗнч(ДатаПараметра) = Тип("Дата") Тогда
		СозданоВ = ДатаПараметра;
	КонецЕсли;

	ЗаполнитьШапку();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ar_СкопироватьPayload(Команда)

	// Глобального метода ПоместитьВБуферОбмена в платформе НЕТ - модуль не
	// компилировался вовсе ("Procedure or function with the specified name is
	// not defined"), и Попытка/Исключение это не ловила: ошибка компиляции, а не
	// выполнения. Работа с буфером идёт через СредстваБуфераОбмена
	// [Реф: БП/CommonModules/ИнтернетПоддержкаПользователейКлиент.ПоместитьСтрокуВБуферОбмена].
	Скопировано = Ложь;

	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		ФорматДанных = СтандартныйФорматДанныхБуфераОбмена.Текст;
		Если Ждать СредстваБуфераОбмена.ПоддерживаетсяФорматДанных(ФорматДанных) Тогда
			ПомещаемыеДанные = Новый ЭлементБуфераОбмена(ФорматДанных, PayloadJSON);
			Скопировано = Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ПомещаемыеДанные);
		КонецЕсли;
	КонецЕсли;

	Если Не Скопировано Тогда
		Ждать ПредупреждениеАсинх(
			НСтр("ru = 'Копирование в буфер обмена недоступно в данном режиме.
				|Выделите текст JSON и скопируйте его вручную.';
				|en = 'Copying to clipboard is not available in this mode.
				|Select the JSON text and copy it manually.'"));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Скопировано'; en = 'Copied'"),
		,
		НСтр("ru = 'JSON аргументов помещён в буфер обмена'; en = 'Arguments JSON copied to clipboard'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Безопасно читает строковый параметр формы: если не передан, возвращает "".
//
// Параметры:
//   ИмяПараметра - Строка - имя параметра формы (см. Параметры формы в Form.xml).
//
// Возвращаемое значение:
//   Строка - значение параметра, если передан и имеет тип Строка; иначе "".
//
&НаСервере
Функция СтрокаПараметра(Знач ИмяПараметра)

	Значение = "";
	Если Параметры.Свойство(ИмяПараметра, Значение) И ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат "";

КонецФункции

// Заполняет заголовок окна и декорации шапки на основании заполненных
// параметров формы (ToolName/RiskLevel/AgentName/RunId/СозданоВ).
//
&НаСервере
Процедура ЗаполнитьШапку()

	ПредставлениеТула = ?(ПустаяСтрока(ToolName),
		НСтр("ru = '(не определено)'; en = '(unknown)'"), ToolName);
	ПредставлениеРиска = ?(ПустаяСтрока(RiskLevel), "-", RiskLevel);
	ПредставлениеАгента = ?(ПустаяСтрока(AgentName), "-", AgentName);

	Элементы.ДекорацияЗаголовок.Заголовок = СтрШаблон(
		НСтр("ru = '%1 (%2) - %3'; en = '%1 (%2) - %3'"),
		ПредставлениеТула, ПредставлениеРиска, ПредставлениеАгента);

	ПредставлениеДаты = ?(ЗначениеЗаполнено(СозданоВ),
		Формат(СозданоВ, "ДЛФ=DT"), "-");

	Элементы.ДекорацияRunId.Заголовок = СтрШаблон(
		НСтр("ru = 'RunId: %1, создано: %2'; en = 'RunId: %1, created: %2'"),
		?(ПустаяСтрока(RunId), "-", RunId), ПредставлениеДаты);

	Заголовок = СтрШаблон(
		НСтр("ru = 'Просмотр действия - %1'; en = 'Action preview - %1'"),
		ПредставлениеТула);

КонецПроцедуры

#КонецОбласти
