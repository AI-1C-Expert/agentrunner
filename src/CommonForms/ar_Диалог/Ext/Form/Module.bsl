КонецФункции

// UI-32: служебные инструменты рантайма - не показываются в попапе выбора и
// не участвуют в пресетах/счётчике, но всегда доезжают до агента (см.
// ДополнитьСлужебнымиTools). Пользователю нечего решать по ним: агент без них
// не работает штатно, а часть из них рантайм и так подставляет сам.
//
// Состав опирается на точечные исключения permission-слоя, а не на категорию
// реестра:
//  * ask_user      - ar_PermissionEngine (служебный интерактивный tool);
//                    ar_RuntimeЦикл.ДобавитьМанифестAskUser и так добавляет
//                    его в интерактивном чате независимо от галок;
//  * remember      - ar_PermissionEngine (служебная запись в память агента,
//                    не меняет прикладные данные ИБ);
//  * recall_memory - чтение той же памяти агента;
//  * get_settings  - чтение настроек расширения;
//  * set_setting   - изменение настроек расширения. Скрытие из выбора не
//                    отменяет approval: у tool ТребуетApproval = Истина,
//                    карточка подтверждения выставляется как прежде.
//
// Возвращаемое значение:
//  Массив - строки с именами служебных tools.
//
&НаСервереБезКонтекста
Функция СлужебныеИменаTools()

	Имена = Новый Массив;
	Имена.Добавить("ask_user");
	Имена.Добавить("remember");
	Имена.Добавить("recall_memory");
	Имена.Добавить("get_settings");
	Имена.Добавить("set_setting");
	Возврат Имена;

КонецФункции

// Истина, если tool служебный (см. СлужебныеИменаTools).
//
&НаСервереБезКонтекста
Функция ЭтоСлужебныйTool(Знач ИмяTool)

	Возврат СлужебныеИменаTools().Найти(СокрЛП("" + ИмяTool)) <> Неопределено;

КонецФункции

// Добавить служебные tools к набору, уходящему в ОверрайдTools. Вызывается
// на отправке: попап их не показывает, поэтому в ВыбранныеToolsJSON их нет,
// а агенту они нужны всегда.
//
// Параметры:
//  Имена - Массив - имена выбранных пользователем tools.
//
// Возвращаемое значение:
//  Массив - новый массив: выбранные + служебные (без дублей).
//
&НаСервереБезКонтекста
Функция ДополнитьСлужебнымиTools(Знач Имена)

	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Результат.Добавить(Имя);
	КонецЦикла;

	Для Каждого Служебный Из СлужебныеИменаTools() Цикл
		Если Результат.Найти(Служебный) = Неопределено Тогда
			Результат.Добавить(Служебный);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все включённые инструменты реестра ar_Tools для попапа.
// Служебные (СлужебныеИменаTools) отфильтрованы: их не выбирают вручную.
//
// SCALE-01: ar_Tools.ar_Категория хранит технический код (finance, documents...),
// не готовый для показа текст - ЛЕВОЕ соединение со справочником
// ar_КатегорииTools резолвит код в человекочитаемое Наименование (Порядок -
// для сортировки групп в попапе). Если код не найден в справочнике (сторонний/
// пакетный tool заявил категорию, которой пока нет в ar_КатегорииTools) -
// показываем сам код как раньше (осознанная деградация, см. .docs/specs/SCALE-01.md,
// раздел "Риски").
//
&НаСервереБезКонтекста
Функция СписокВсехTools()

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя           КАК Имя,
		|	Tools.ar_Представление КАК Представление,
		|	Tools.ar_Категория     КАК КодКатегории,
		|	КатегорииTools.Наименование КАК НаименованиеКатегории,
		|	КатегорииTools.ar_Порядок   КАК ПорядокКатегории,
		|	Tools.ar_Описание      КАК Описание,
		|	Tools.ar_RiskLevel     КАК RiskLevel,
		|	Tools.ar_ТребуетApproval КАК ТребуетApproval
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ar_КатегорииTools КАК КатегорииTools
		|		ПО Tools.ar_Категория = КатегорииTools.Код
		|		И НЕ КатегорииTools.ПометкаУдаления
		|ГДЕ
		|	Tools.ar_Включён
		|	И НЕ Tools.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокКатегории,
		|	КодКатегории,
		|	Представление,
		|	Имя";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЭтоСлужебныйTool(Выборка.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Тул = Новый Структура;
		Тул.Вставить("Имя",      Выборка.Имя);
		// UI-31: ar_Представление может быть пустым (tool из стороннего
		// расширения либо реестр ещё не перерегистрирован) - тогда падаем
		// обратно на техническое имя, как было до UI-31.
		Представление = СокрЛП("" + Выборка.Представление);
		Тул.Вставить("Представление", ?(ПустаяСтрока(Представление), Выборка.Имя, Представление));
		КодКатегории = СокрЛП("" + Выборка.КодКатегории);
		НаименованиеКатегории = СокрЛП("" + Выборка.НаименованиеКатегории);
		Если Не ПустаяСтрока(НаименованиеКатегории) Тогда
			// Код резолвлен через ar_КатегорииTools - показываем человекочитаемое имя.
			ТекстКатегории = НаименованиеКатегории;
		ИначеЕсли Не ПустаяСтрока(КодКатегории) Тогда
			// Код не найден в справочнике (сторонний/пакетный tool) - показываем
			// сам код, деградация без ошибки (см. докстринг функции выше).
			ТекстКатегории = КодКатегории;
		Иначе
			ТекстКатегории = НСтр("ru='Прочие'; en='Other'");
		КонецЕсли;
		Тул.Вставить("Категория", ТекстКатегории);
		Тул.Вставить("Описание", Выборка.Описание);
		Тул.Вставить("Риск",     ИмяУровняРиска(Выборка.RiskLevel));
		Тул.Вставить("ТребуетApproval", Выборка.ТребуетApproval = Истина);
		Результат.Добавить(Тул);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена tools, реально доступных агенту (SCALE-07): эффективный набор -
// явный список ar_ДоступныеTools, объединённый с ar_ПравилаДоступаTools,
// минус deny. НЕ прямой запрос к старой ТЧ - до SCALE-07 она была
// единственным источником whitelist, теперь это только одна из его
// составляющих (см. ar_ToolAccessRules.ЭффективныйНаборTools). Здесь этот
// набор служит базой для дефолтного ОверрайдTools в чате без выбора
// пользователя и для предзаполнения отметок в попапе - если брать напрямую
// ar_ДоступныеTools, агент с доступом, заданным только правилами, получал бы
// пустой/урезанный ОверрайдTools и tool_not_in_whitelist на L1, хотя
// ar_PermissionEngine.ToolВWhitelist разрешил бы тот же tool без оверрайда.
//
&НаСервереБезКонтекста
Функция ИменаToolsАгента(Знач АгентСсылка)

	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(АгентСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Набор = ar_ToolAccessRules.ЭффективныйНаборTools(АгентСсылка);
	Для Каждого Строка Из Набор Цикл
		Результат.Добавить(Строка.ИмяTool);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разобрать ВыбранныеToolsJSON в массив имён.
//
&НаСервере
Функция СписокВыбранныхTools()

	Результат = Новый Массив;
	Если ПустаяСтрока(ВыбранныеToolsJSON) Тогда
		Возврат Результат;
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(ВыбранныеToolsJSON);
	Если ТипЗнч(Разобрано) = Тип("Массив") Тогда
		Для Каждого Имя Из Разобрано Цикл
			Результат.Добавить(СокрЛП("" + Имя));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сохранить выбранный набор tools в ТЧ диалога (восстановление при открытии).
//
&НаСервереБезКонтекста
Процедура СохранитьToolsДиалога(Знач ДиалогСсылка, Знач Имена)

	ОбъектДиалога = ДиалогСсылка.ПолучитьОбъект();
	Если ОбъектДиалога = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектДиалога.ar_ВыбранныеTools.Очистить();
	Для Каждого Имя Из Имена Цикл
		СтрокаТЧ = ОбъектДиалога.ar_ВыбранныеTools.Добавить();
		СтрокаТЧ.ar_Имя = Имя;
	КонецЦикла;
	ОбъектДиалога.Записать();

КонецПроцедуры

// Набор tools последнего диалога пользователя - стартовое значение для нового
// диалога (UI-31, вариант A): пользователь настроил инструменты один раз и
// продолжает работать с тем же набором, а не с пустым списком.
//
// Берётся именно последний диалог по дате, а не набор агента: если человек
// снял/добавил галки, это его осознанный выбор, который надо унаследовать.
//
// Параметры:
//  ПользовательUUID - Строка - владелец диалогов (см. ТекущийПользовательUUID).
//
// Возвращаемое значение:
//  Строка - JSON-массив имён tools; пустая строка, если диалогов ещё нет
//           либо у последнего диалога набор не сохранён.
//
&НаСервереБезКонтекста
Функция ToolsПоследнегоДиалога(Знач ПользовательUUID)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Диалоги.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Диалоги КАК Диалоги
		|ГДЕ
		|	Диалоги.ar_ПользовательUUID = &ПользовательUUID
		|	И НЕ Диалоги.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Диалоги.ar_Обновлён УБЫВ";
	Запрос.УстановитьПараметр("ПользовательUUID", ПользовательUUID);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат СохранённыеToolsДиалога(Выборка.Ссылка);

КонецФункции

// Прочитать сохранённый набор tools диалога (JSON-массив имён).
//
&НаСервереБезКонтекста
Функция СохранённыеToolsДиалога(Знач ДиалогСсылка)

	Имена = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВыбранныеTools.ar_Имя КАК Имя
		|ИЗ
		|	Справочник.ar_Диалоги.ar_ВыбранныеTools КАК ВыбранныеTools
		|ГДЕ
		|	ВыбранныеTools.Ссылка = &Диалог
		|УПОРЯДОЧИТЬ ПО
		|	ВыбранныеTools.НомерСтроки";
	Запрос.УстановитьПараметр("Диалог", ДиалогСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имена.Добавить(СокрЛП(Выборка.Имя));
	КонецЦикла;

	Если Имена.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ar_JSON.ВЗначениеJSON(Имена);

КонецФункции

// Обновить шапку диалога после старта запуска.
//
&НаСервереБезКонтекста
Процедура ОбновитьШапкуДиалога(Знач ДиалогСсылка, Знач RunId)

	Если НЕ ЗначениеЗаполнено(ДиалогСсылка) Тогда
		Возврат;
	КонецЕсли;

	ОбъектДиалога = ДиалогСсылка.ПолучитьОбъект();
	Если ОбъектДиалога = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектДиалога.ar_ПоследнийRunId = RunId;
	ОбъектДиалога.ar_Обновлён       = ТекущаяДатаСеанса();
	ОбъектДиалога.Записать();

КонецПроцедуры

// Ссылка справочника ar_Диалоги по строковому UUID (пустая - если не найден).
//
&НаСервереБезКонтекста
Функция ДиалогПоИдентификатору(Знач ИдСтрока)

	Попытка
		Ссылка = Справочники.ar_Диалоги.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ИдСтрока));
	Исключение
		Возврат Справочники.ar_Диалоги.ПустаяСсылка();
	КонецПопытки;

	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат Справочники.ar_Диалоги.ПустаяСсылка();

КонецФункции

// Сброс контекста диалога без перерисовки (внутренний шаг).
//
&НаСервере
Процедура НовыйДиалогБезРендера()

	ТекущийДиалог     = Справочники.ar_Диалоги.ПустаяСсылка();
	ТекущийЯкорь      = "";
	ТекущийRunId      = "";
	СтатусЗапуска     = "";
	ТекущийApprovalId = "";
	AskChoicesJSON    = "";
	ПоследнийSequence = 0;

КонецПроцедуры

// UUID пользователя ИБ - владельца диалогов (отбор «мои диалоги»).
//
&НаСервереБезКонтекста
Функция ТекущийПользовательUUID()

	Возврат Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);

КонецФункции

// Первый активный агент - дефолт для нового окна.
//
&НаСервереБезКонтекста
Функция ПервыйАктивныйАгент()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Агенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	НЕ Агенты.ПометкаУдаления
		|	И Агенты.ar_Активен
		|УПОРЯДОЧИТЬ ПО
		|	Агенты.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ar_Агенты.ПустаяСсылка();

КонецФункции

// Текущий статус запуска строкой из ar_Запуски.
//
&НаСервереБезКонтекста
Функция СтатусЗапускаИзРегистра(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запуски.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_RunId = &RunId";
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ИмяСтатусаЗапуска(Выборка.Статус);
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Процедура ОбновитьСтатусИзРегистра()

	НовыйСтатус = СтатусЗапускаИзРегистра(ТекущийRunId);
	Если НЕ ПустаяСтрока(НовыйСтатус) Тогда
		СтатусЗапуска = НовыйСтатус;
	КонецЕсли;

КонецПроцедуры

// Максимальный Sequence событий запуска (курсор при переоткрытии диалога).
//
&НаСервереБезКонтекста
Функция МаксимальныйSequence(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(ВЫРАЗИТЬ(События.ar_Sequence КАК ЧИСЛО(10, 0))), 0) КАК МаксНомер
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК События
		|ГДЕ
		|	События.ar_RunId = &RunId";
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.МаксНомер;
	КонецЕсли;
	Возврат 0;

КонецФункции

// Имя значения перечисления ar_СтатусЗапуска строкой.
//
&НаСервереБезКонтекста
Функция ИмяСтатусаЗапуска(Знач Статус)

	Если Статус = Перечисления.ar_СтатусЗапуска.Created Тогда
		Возврат "Created";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Running Тогда
		Возврат "Running";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.PausedForApproval Тогда
		Возврат "PausedForApproval";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.PausedForInput Тогда
		Возврат "PausedForInput";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Completed Тогда
		Возврат "Completed";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Failed Тогда
		Возврат "Failed";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Cancelled Тогда
		Возврат "Cancelled";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.MaxStepsReached Тогда
		Возврат "MaxStepsReached";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Interrupted Тогда
		Возврат "Interrupted";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.DeniedGlobally Тогда
		Возврат "DeniedGlobally";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.FailedIncompatibleState Тогда
		Возврат "FailedIncompatibleState";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Имя значения перечисления ar_ТипСобытия (только отображаемые в чате типы).
//
&НаСервереБезКонтекста
Функция ИмяТипаСобытия(Знач ТипСобытияСсылка)

	Если ТипСобытияСсылка = Перечисления.ar_ТипСобытия.LLMCalled Тогда
		Возврат "LLMCalled";
	ИначеЕсли ТипСобытияСсылка = Перечисления.ar_ТипСобытия.ToolCalled Тогда
		Возврат "ToolCalled";
	ИначеЕсли ТипСобытияСсылка = Перечисления.ar_ТипСобытия.Completed Тогда
		Возврат "Completed";
	ИначеЕсли ТипСобытияСсылка = Перечисления.ar_ТипСобытия.Failed Тогда
		Возврат "Failed";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Бейдж уровня риска для пункта попапа инструментов (UI-31, I).
//
// Вместо технического Read/Write/Commit показываем, что tool делает с данными,
// и отдельной меткой - требует ли действие подтверждения в очереди approval.
//
// Параметры:
//  Риск            - Строка - Read / Write / Commit (см. ИмяУровняРиска).
//  ТребуетApproval - Булево - действие проходит через очередь подтверждений.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент с бейджами (пустая строка, если риск не задан).
//
// Строковое имя уровня риска tool.
//
&НаСервереБезКонтекста
Функция ИмяУровняРиска(Знач RiskLevel)

	Если RiskLevel = Перечисления.ar_RiskLevel.Read Тогда
		Возврат "Read";
	ИначеЕсли RiskLevel = Перечисления.ar_RiskLevel.Write Тогда
		Возврат "Write";
	ИначеЕсли RiskLevel = Перечисления.ar_RiskLevel.Commit Тогда
		Возврат "Commit";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область РендерHTML

// Полная пересборка HTML-документа формы.
//
// Параметры:
//  ТекстПредупреждения - Строка - необязательный баннер (ошибки валидации).
//
&НаСервере
Процедура ПерерисоватьHTML(Знач ТекстПредупреждения = "")

	Данные = Новый Структура;
	Данные.Вставить("Диалоги",       СписокДиалогов(ТекущийПользовательUUID()));
	Данные.Вставить("ТекущийИд",     "");
	Данные.Вставить("Лента",         ЛентаДиалога(ТекущийЯкорь));
	Данные.Вставить("Агенты",        СписокАгентов());
	Данные.Вставить("Провайдеры",    СписокПровайдеров());
	Данные.Вставить("ВсеTools",      СписокВсехTools());
	Данные.Вставить("ВыбранныеTools", ЭффективныйНаборTools());
	Данные.Вставить("ЕстьОверрайд",  НЕ ПустаяСтрока(ВыбранныеToolsJSON));
	Данные.Вставить("Approvals",     Новый Массив);
	Данные.Вставить("AskUser",       Неопределено);
	Данные.Вставить("Статус",        СтатусЗапуска);
	Данные.Вставить("ЕстьRunId",     НЕ ПустаяСтрока(ТекущийRunId));
	Данные.Вставить("РежимБезАгента", РежимБезАгента);
	Данные.Вставить("ИмяАгента",     ?(ЗначениеЗаполнено(ВыбранныйАгент), Строка(ВыбранныйАгент), ""));
	Данные.Вставить("ИмяПровайдера", ?(ЗначениеЗаполнено(ВыбранныйПровайдер), Строка(ВыбранныйПровайдер), ""));
	Данные.Вставить("ИмяПровайдераАгентаПоУмолчанию",
		?(НЕ РежимБезАгента И ЗначениеЗаполнено(ВыбранныйАгент), ПровайдерАгентаПоУмолчанию(ВыбранныйАгент), ""));
	Данные.Вставить("ПопапToolsОткрыт",  ПопапToolsОткрыт);
	Данные.Вставить("ПопапАгентаОткрыт", ПопапАгентаОткрыт);
	Данные.Вставить("ЗаголовокДиалога", ?(ЗначениеЗаполнено(ТекущийДиалог),
		Строка(ТекущийДиалог), НСтр("ru='Новый диалог'; en='New dialog'")));
	Данные.Вставить("Черновик",      ЧерновикКомпозера);
	Данные.Вставить("Предупреждение", ТекстПредупреждения);

	Если ЗначениеЗаполнено(ТекущийДиалог) Тогда
		Данные.ТекущийИд = Строка(ТекущийДиалог.УникальныйИдентификатор());
	КонецЕсли;

	// Не привязываем видимость к СтатусЗапуска = "PausedForApproval": approve
	// одной карточки из нескольких pending на одном шаге немедленно возобновляет
	// запуск (ar_Approval.Принять, UNIV-06) - статус успевает стать Running/другим
	// раньше, чем оператор решит по остальным, и карточки пропадали из ленты,
	// хотя реально ещё ждали в ar_ОчередьApproval (видны только в отдельной форме
	// «Очередь подтверждений»). ОжидающиеApprovals - источник истины по pending
	// для этого RunId, статус запуска здесь ни при чём.
	Данные.Approvals = ОжидающиеApprovals(ТекущийRunId);

	Если СтатусЗапуска = "PausedForInput" И НЕ ПустаяСтрока(ТекущийApprovalId) Тогда
		AskUser = Новый Структура;
		AskUser.Вставить("ApprovalId", ТекущийApprovalId);
		Варианты = ar_JSON.ИзJSON(AskChoicesJSON);
		AskUser.Вставить("Варианты", ?(ТипЗнч(Варианты) = Тип("Массив"), Варианты, Новый Массив));
		Данные.AskUser = AskUser;
	КонецЕсли;

	СтрокаHTML = СобратьHTMLЧата(Данные);

КонецПроцедуры

// UI-32: сколько выбираемых (неслужебных) tools отмечено. Служебные в попапе
// не показываются и добавляются на отправке сами, поэтому в проверке
// "отметьте хотя бы один инструмент" они не участвуют - иначе набор из одних
// служебных выглядел бы заполненным при пустом попапе.
//
// Возвращаемое значение:
//  Число - количество отмеченных неслужебных tools.
//
&НаСервере
Функция ВыбираемыхToolsОтмечено()

	Счётчик = 0;
	Для Каждого Имя Из СписокВыбранныхTools() Цикл
		Если НЕ ЭтоСлужебныйTool(Имя) Тогда
			Счётчик = Счётчик + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик;

КонецФункции

// Эффективный набор tools для отметок в попапе: оверрайд, иначе ТЧ агента.
//
&НаСервере
Функция ЭффективныйНаборTools()

	Имена = СписокВыбранныхTools();
	Если Имена.Количество() = 0 И НЕ РежимБезАгента И ЗначениеЗаполнено(ВыбранныйАгент) Тогда
		Имена = ИменаToolsАгента(ВыбранныйАгент);
	КонецЕсли;
	Возврат Имена;

КонецФункции

// Сборка всего документа: сайдбар + шапка + лента + композер + каркас.
//
&НаСервереБезКонтекста
Функция СобратьHTMLЧата(Знач Данные)

	Содержимое =
		"<div class=""ar-app"">"
		+ HTMLСайдбар(Данные)
		+ "<main class=""ar-main"">"
		+ HTMLШапка(Данные)
		+ HTMLЛента(Данные)
		+ HTMLКомпозер(Данные)
		+ "</main>"
		+ "</div>";

	Возврат HTMLКаркас(Содержимое);

КонецФункции

// Сайдбар: кнопка нового диалога + список диалогов + сервисные ссылки.
//
&НаСервереБезКонтекста
Функция HTMLСайдбар(Знач Данные)

	Разметка = "<aside class=""ar-side"">"
		+ "<div class=""ar-side-top"">"
		+ "<a class=""ar-btn ar-btn-new"" href=""1c://new-dialog"">+ "
		+ ЭкранироватьHTML(НСтр("ru='Новый диалог'; en='New dialog'")) + "</a>"
		+ "</div><div class=""ar-side-list"">";

	Для Каждого Диалог Из Данные.Диалоги Цикл

		КлассАктивного = ?(Диалог.Ид = Данные.ТекущийИд, " ar-side-item-active", "");
		ПодписьДаты = Формат(Диалог.Обновлён, "ДФ=dd.MM");

		Разметка = Разметка
			+ "<div class=""ar-side-item" + КлассАктивного + """>"
			+ "<a class=""ar-side-link"" href=""1c://open-dialog?id=" + Диалог.Ид + """>"
			+ "<span class=""ar-side-title"">" + ЭкранироватьHTML(Диалог.Наименование) + "</span>"
			+ "<span class=""ar-side-meta"">" + ЭкранироватьHTML(Диалог.Подпись)
			+ " · " + ПодписьДаты + "</span>"
			+ "</a>"
			+ "<a class=""ar-side-del"" href=""1c://delete-dialog?id=" + Диалог.Ид
			+ """ title=""" + ЭкранироватьHTML(НСтр("ru='Удалить'; en='Delete'")) + """>&#10005;</a>"
			+ "</div>";

	КонецЦикла;

	Разметка = Разметка + "</div><div class=""ar-side-bottom"">"
		+ "<a class=""ar-side-svc"" href=""1c://open-queue"">"
		+ ЭкранироватьHTML(НСтр("ru='Очередь подтверждений'; en='Approval queue'")) + "</a>"
		+ "<a class=""ar-side-svc"" href=""1c://open-settings"">"
		+ ЭкранироватьHTML(НСтр("ru='Настройки'; en='Settings'")) + "</a>"
		+ "<a class=""ar-side-svc"" href=""1c://show-log"">"
		+ ЭкранироватьHTML(НСтр("ru='Служебный лог'; en='Service log'")) + "</a>"
		+ "<a class=""ar-side-svc"" href=""1c://self-check"">"
		+ ЭкранироватьHTML(НСтр("ru='Самопроверка'; en='Self-check'")) + "</a>"
		+ "<a class=""ar-side-svc"" href=""1c://clear-log"">"
		+ ЭкранироватьHTML(НСтр("ru='Очистить'; en='Clear'")) + "</a>"
		+ "</div></aside>";

	Возврат Разметка;

КонецФункции

// Шапка чата: заголовок, агент, статус-чип, сервисные ссылки запуска.
//
&НаСервереБезКонтекста
Функция HTMLШапка(Знач Данные)

	Подпись = ?(Данные.РежимБезАгента,
		НСтр("ru='Без агента'; en='No agent'") + ": " + Данные.ИмяПровайдера,
		Данные.ИмяАгента);

	ЧипСтатуса = "";
	Если НЕ ПустаяСтрока(Данные.Статус) Тогда
		ЧипСтатуса = "<span class=""ar-status ar-status-" + НРег(Данные.Статус) + """>"
			+ ЭкранироватьHTML(ПредставлениеСтатуса(Данные.Статус)) + "</span>";
	КонецЕсли;

	СсылкиЗапуска = "";
	Если Данные.ЕстьRunId Тогда
		СсылкиЗапуска = "<a class=""ar-head-svc"" href=""1c://open-run"">"
			+ ЭкранироватьHTML(НСтр("ru='Run Viewer'; en='Run Viewer'")) + "</a>";
	КонецЕсли;
	СсылкиЗапуска = СсылкиЗапуска + "<a class=""ar-head-svc"" href=""1c://refresh"" title="""
		+ ЭкранироватьHTML(НСтр("ru='Обновить'; en='Refresh'")) + """>&#8635;</a>";

	Возврат "<header class=""ar-head"">"
		+ "<div class=""ar-head-left"">"
		+ "<span class=""ar-head-title"">" + ЭкранироватьHTML(Данные.ЗаголовокДиалога) + "</span>"
		+ "<span class=""ar-head-agent"">" + ЭкранироватьHTML(Подпись) + "</span>"
		+ "</div>"
		+ "<div class=""ar-head-right"">" + ЧипСтатуса + СсылкиЗапуска + "</div>"
		+ "</header>";

КонецФункции

// Лента сообщений: пузыри, чипы tools, карточки approval и ask_user.
//
&НаСервереБезКонтекста
Функция HTMLЛента(Знач Данные)

	Содержимое = "";

	Если Данные.Лента.Количество() = 0 Тогда
		Содержимое = "<div class=""ar-empty"">"
			+ ЭкранироватьHTML(НСтр(
				"ru='Задайте вопрос или сформулируйте задачу - агент выполнит её с учётом доступных инструментов.';
				|en='Ask a question or describe a task - the agent will use its available tools.'"))
			+ "</div>";
	КонецЕсли;

	Для Каждого Запись Из Данные.Лента Цикл
		Содержимое = Содержимое + HTMLПузырь(Запись.Роль, Запись.Текст, Запись.Момент);
	КонецЦикла;

	// Индикатор «агент думает» при активном запуске.
	Если Данные.Статус = "Running" ИЛИ Данные.Статус = "Created" Тогда
		Содержимое = Содержимое
			+ "<div class=""ar-row ar-row-assistant""><div class=""ar-thinking"">"
			+ ЭкранироватьHTML(НСтр("ru='Агент думает'; en='Agent is thinking'"))
			+ "<span class=""ar-dots""><span>.</span><span>.</span><span>.</span></span>"
			+ "</div></div>";
	КонецЕсли;

	// Карточки подтверждений. Групповая кнопка - когда pending-действий на шаге
	// больше одного (модель обычно вызывает несколько однотипных commit-tools
	// подряд, см. project_dryrun_precheck_double_approval_bug) - подтверждать их
	// по одной оператору неудобно.
	Если Данные.Approvals.Количество() > 1 Тогда
		Содержимое = Содержимое
			+ "<div class=""ar-row ar-row-center"">"
			+ "<a class=""ar-btn ar-btn-ok"" href=""1c://approve-all"">"
			+ ЭкранироватьHTML(СтрШаблон(НСтр("ru='Разрешить все (%1)'; en='Approve all (%1)'"),
				Данные.Approvals.Количество())) + "</a>"
			+ "</div>";
	КонецЕсли;

	Для Каждого Карточка Из Данные.Approvals Цикл
		Содержимое = Содержимое + HTMLКарточкаApproval(Карточка);
	КонецЦикла;

	// Карточка ответа ask_user (PausedForInput).
	Если Данные.AskUser <> Неопределено Тогда
		Содержимое = Содержимое + HTMLКарточкаAskUser(Данные.AskUser);
	КонецЕсли;

	Возврат "<div class=""ar-feed"" id=""ar-feed""><div class=""ar-feed-inner"">"
		+ Содержимое + "</div></div>";

КонецФункции

// Пузырь одного сообщения ленты.
//
&НаСервереБезКонтекста
Функция HTMLПузырь(Знач Роль, Знач Текст, Знач Момент)

	ВремяHTML = ЭкранироватьHTML(Формат(Момент, "ДФ=чч:мм"));
	ТекстHTML = ТекстВHTML(Текст);

	Если Роль = "user" Тогда

		Возврат "<div class=""ar-row ar-row-user"">"
			+ "<div class=""ar-bubble ar-bubble-user"">"
			+ "<div class=""ar-text"">" + ТекстHTML + "</div>"
			+ "<div class=""ar-time"">" + ВремяHTML + "</div>"
			+ "</div></div>";

	ИначеЕсли Роль = "assistant" Тогда

		Возврат "<div class=""ar-row ar-row-assistant"">"
			+ "<div class=""ar-bubble ar-bubble-assistant"">"
			+ "<div class=""ar-text"">" + ТекстHTML + "</div>"
			+ "<div class=""ar-time"">" + ВремяHTML + "</div>"
			+ "</div></div>";

	ИначеЕсли Роль = "tool" Тогда

		Возврат "<div class=""ar-row ar-row-center"">"
			+ "<div class=""ar-chip ar-chip-tool"">&#128736; " + ТекстHTML
			+ " <span class=""ar-chip-time"">" + ВремяHTML + "</span></div></div>";

	ИначеЕсли Роль = "ask_user" Тогда

		Возврат "<div class=""ar-row ar-row-assistant"">"
			+ "<div class=""ar-bubble ar-bubble-ask"">"
			+ "<div class=""ar-ask-mark"">&#10067; "
			+ ЭкранироватьHTML(НСтр("ru='Вопрос агента'; en='Agent question'")) + "</div>"
			+ "<div class=""ar-text"">" + ТекстHTML + "</div>"
			+ "<div class=""ar-time"">" + ВремяHTML + "</div>"
			+ "</div></div>";

	Иначе // "system" и прочие технические записи.

		Возврат "<div class=""ar-row ar-row-center"">"
			+ "<div class=""ar-chip ar-chip-system"">" + ТекстHTML
			+ " <span class=""ar-chip-time"">" + ВремяHTML + "</span></div></div>";

	КонецЕсли;

КонецФункции

// Карточка подтверждения действия: имя tool, риск, обоснование, аргументы,
// причина отказа + кнопки «Разрешить»/«Отклонить».
//
&НаСервереБезКонтекста
Функция HTMLКарточкаApproval(Знач Карточка)

	// Бейдж риска - тот же, что в списке tools композера: подпись локализована
	// ("запись" вместо "Write"). Признак approval не дублируем - о нём говорит
	// сам заголовок карточки.
	РискHTML = "";
	Если НЕ ПустаяСтрока(Карточка.Риск) Тогда
		РискHTML = ar_ApprovalПредставление.БейджРиска(Карточка.Риск, Ложь);
	КонецЕсли;

	// Заголовок - человекочитаемое название действия; техническое имя tool
	// уходит на второй план, но остаётся видимым для диагностики.
	Заголовок = ?(ПустаяСтрока(Карточка.Представление), Карточка.ИмяTool, Карточка.Представление);

	Детали = "";

	Если НЕ ПустаяСтрока(Карточка.Эффект) Тогда
		Детали = Детали + "<div class=""ar-card-effect"">"
			+ ЭкранироватьHTML(Карточка.Эффект) + "</div>";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Карточка.Обоснование) Тогда
		Детали = Детали + "<div class=""ar-card-note""><b>"
			+ ЭкранироватьHTML(НСтр("ru='Зачем:'; en='Why:'")) + "</b> "
			+ ЭкранироватьHTML(Карточка.Обоснование) + "</div>";
	КонецЕсли;

	// Параметры действия в виде подписей и значений: ссылки уже развёрнуты
	// в наименования объектов, GUID пользователю не показываем.
	Если Карточка.Параметры.Количество() > 0 Тогда
		Строки = "";
		Для Каждого Параметр Из Карточка.Параметры Цикл
			КлассЗначения = ?(Параметр.ЭтоСсылка, "ar-param-val ar-param-ref", "ar-param-val");
			Строки = Строки + "<div class=""ar-param"">"
				+ "<span class=""ar-param-key"">" + ЭкранироватьHTML(Параметр.Подпись) + "</span>"
				+ "<span class=""" + КлассЗначения + """>"
				+ ЭкранироватьHTML(Параметр.Значение) + "</span></div>";
		КонецЦикла;
		Детали = Детали + "<div class=""ar-card-params"">" + Строки + "</div>";
	КонецЕсли;

	// Технический JSON - под спойлером: нужен разработчику, но не должен
	// быть первым, что видит пользователь.
	Если НЕ ПустаяСтрока(Карточка.АргументыТекст) Тогда
		Детали = Детали + "<details class=""ar-card-raw""><summary>"
			+ ЭкранироватьHTML(НСтр("ru='Технические параметры'; en='Technical parameters'"))
			+ "</summary><pre class=""ar-card-args"">"
			+ ЭкранироватьHTML(Карточка.АргументыТекст) + "</pre></details>";
	КонецЕсли;

	Ид = Карточка.ApprovalId;

	ИмяТехническое = "";
	Если НЕ ПустаяСтрока(Карточка.Представление) И Карточка.Представление <> Карточка.ИмяTool Тогда
		ИмяТехническое = " <span class=""ar-card-tool"">"
			+ ЭкранироватьHTML(Карточка.ИмяTool) + "</span>";
	КонецЕсли;

	Возврат "<div class=""ar-card ar-card-approval"">"
		+ "<div class=""ar-card-head"">&#9888; "
		+ ЭкранироватьHTML(НСтр("ru='Агент запрашивает разрешение на действие:';
			|en='Agent requests permission to perform:'"))
		+ "</div>"
		+ "<div class=""ar-card-title""><b>" + ЭкранироватьHTML(Заголовок) + "</b> "
		+ РискHTML + ИмяТехническое + "</div>"
		+ Детали
		+ "<div class=""ar-card-actions"">"
		+ "<a class=""ar-btn ar-btn-ok"" href=""1c://approve?id=" + Ид + """>"
		+ ЭкранироватьHTML(НСтр("ru='Разрешить'; en='Approve'")) + "</a>"
		+ "<a class=""ar-btn ar-btn-no"" href=""1c://reject?id=" + Ид + """>"
		+ ЭкранироватьHTML(НСтр("ru='Отклонить'; en='Reject'")) + "</a>"
		+ "<input class=""ar-input-inline"" id=""ar-reject-" + Ид + """ type=""text"" placeholder="""
		+ ЭкранироватьHTML(НСтр("ru='Причина отказа (необязательно)'; en='Rejection reason (optional)'"))
		+ """>"
		+ "</div></div>";

КонецФункции

// Карточка ответа на ask_user: кнопки вариантов + свободный ответ.
//
&НаСервереБезКонтекста
Функция HTMLКарточкаAskUser(Знач AskUser)

	Ид = AskUser.ApprovalId;

	КнопкиВариантов = "";
	Индекс = 0;
	Для Каждого Вариант Из AskUser.Варианты Цикл
		КнопкиВариантов = КнопкиВариантов
			+ "<a class=""ar-btn ar-btn-choice"" href=""1c://answer?id=" + Ид
			+ "&c=" + Формат(Индекс, "ЧГ=0") + """>"
			+ ЭкранироватьHTML("" + Вариант) + "</a>";
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат "<div class=""ar-card ar-card-ask"">"
		+ "<div class=""ar-card-head"">"
		+ ЭкранироватьHTML(НСтр("ru='Ответьте, чтобы агент продолжил:'; en='Answer so the agent can continue:'"))
		+ "</div>"
		+ ?(ПустаяСтрока(КнопкиВариантов), "",
			"<div class=""ar-card-choices"">" + КнопкиВариантов + "</div>")
		+ "<div class=""ar-card-actions"">"
		+ "<input class=""ar-input-inline"" id=""ar-answer-input"" type=""text"" placeholder="""
		+ ЭкранироватьHTML(НСтр("ru='Свой вариант ответа...'; en='Your own answer...'")) + """>"
		+ "<a class=""ar-btn ar-btn-ok"" href=""1c://answer?id=" + Ид + """>"
		+ ЭкранироватьHTML(НСтр("ru='Ответить'; en='Answer'")) + "</a>"
		+ "</div></div>";

КонецФункции

// Композер: предупреждение, textarea, попапы агента и tools, кнопки.
//
&НаСервереБезКонтекста
Функция HTMLКомпозер(Знач Данные)

	Активен = НЕ ЭтоФинальныйСтатус(Данные.Статус)
		И НЕ ПустаяСтрока(Данные.Статус)
		И Данные.ЕстьRunId;

	Предупреждение = "";
	Если НЕ ПустаяСтрока(Данные.Предупреждение) Тогда
		Предупреждение = "<div class=""ar-warn"">" + ЭкранироватьHTML(Данные.Предупреждение) + "</div>";
	КонецЕсли;

	// Попап выбора агента.
	ПунктыАгентов = "";
	Для Каждого Агент Из Данные.Агенты Цикл
		Маркер = ?(НЕ Данные.РежимБезАгента И Агент.Наименование = Данные.ИмяАгента, "&#10003; ", "");
		ПунктыАгентов = ПунктыАгентов
			+ "<a class=""ar-pop-item"" href=""1c://select-agent?id=" + Агент.Ид + """>"
			+ Маркер + ЭкранироватьHTML(Агент.Наименование) + "</a>";
	КонецЦикла;
	ПунктыАгентов = ПунктыАгентов
		+ "<a class=""ar-pop-item ar-pop-item-alt"" href=""1c://select-agent?id=no-agent"">"
		+ ?(Данные.РежимБезАгента, "&#10003; ", "")
		+ ЭкранироватьHTML(НСтр("ru='Без агента (свой набор tools)'; en='No agent (custom tools)'"))
		+ "</a>";

	// UI-01/6: попап провайдера доступен и при выбранном агенте - позволяет
	// временно переопределить провайдера агента для текущего диалога (без
	// этого отключённый/нерабочий провайдер агента блокирует чат наглухо,
	// см. UAT-2026-08-12 п.1). В режиме "без агента" провайдер обязателен;
	// при агенте не выбранный оверрайд = "провайдер по умолчанию агента".
	Если Данные.РежимБезАгента Тогда
		ПунктыАгентов = ПунктыАгентов
			+ "<div class=""ar-pop-caption"">"
			+ ЭкранироватьHTML(НСтр("ru='Провайдер LLM:'; en='LLM provider:'")) + "</div>";
		Для Каждого Провайдер Из Данные.Провайдеры Цикл
			Маркер = ?(Провайдер.Наименование = Данные.ИмяПровайдера, "&#10003; ", "");
			ПунктыАгентов = ПунктыАгентов
				+ "<a class=""ar-pop-item"" href=""1c://select-provider?id=" + Провайдер.Ид + """>"
				+ Маркер + ЭкранироватьHTML(Провайдер.Наименование) + "</a>";
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Данные.ИмяАгента) Тогда
		ПунктыАгентов = ПунктыАгентов
			+ "<div class=""ar-pop-caption"">"
			+ ЭкранироватьHTML(НСтр("ru='Провайдер LLM (переопределить для этого диалога):'; en='LLM provider (override for this dialog):'"))
			+ "</div>";
		ПунктыАгентов = ПунктыАгентов
			+ "<a class=""ar-pop-item"" href=""1c://select-provider?id=agent-default"">"
			+ ?(ПустаяСтрока(Данные.ИмяПровайдера), "&#10003; ", "")
			+ ЭкранироватьHTML(СтрШаблон(НСтр("ru='По умолчанию агента (%1)'; en='Agent default (%1)'"),
				?(ПустаяСтрока(Данные.ИмяПровайдераАгентаПоУмолчанию),
					НСтр("ru='не задан'; en='not set'"), Данные.ИмяПровайдераАгентаПоУмолчанию)))
			+ "</a>";
		Для Каждого Провайдер Из Данные.Провайдеры Цикл
			Маркер = ?(Провайдер.Наименование = Данные.ИмяПровайдера, "&#10003; ", "");
			ПунктыАгентов = ПунктыАгентов
				+ "<a class=""ar-pop-item"" href=""1c://select-provider?id=" + Провайдер.Ид + """>"
				+ Маркер + ЭкранироватьHTML(Провайдер.Наименование) + "</a>";
		КонецЦикла;
	КонецЕсли;

	ПодписьАгента = ?(Данные.РежимБезАгента,
		НСтр("ru='Без агента'; en='No agent'"), Данные.ИмяАгента);
	Если ПустаяСтрока(ПодписьАгента) Тогда
		ПодписьАгента = НСтр("ru='Выберите агента'; en='Select agent'");
	КонецЕсли;

	// Не <details>/<summary> - тот же приём, что у попапа инструментов
	// (ВыполнитьПереключениеПопапаTools): нативный toggle в толстом клиенте
	// ненадёжен при абсолютно позиционированном ar-pop-body поверх заголовка.
	ПопапАгента = "<div class=""ar-pop ar-pop-managed" + ?(Данные.ПопапАгентаОткрыт, " ar-pop-open", "") + """>"
		+ "<a class=""ar-pop-summary"" href=""1c://toggle-agent-popup"">&#129302; "
		+ ЭкранироватьHTML(ПодписьАгента) + "</a>"
		+ "<div class=""ar-pop-body"">" + ПунктыАгентов + "</div></div>";

	// Попап tools: пункты сгруппированы по категориям (UI-31, G), в каждом -
	// человекочитаемое название, техническое имя и описание (F), риск-бейдж
	// словами (I). Список отсортирован по Категория/Представление в запросе,
	// поэтому заголовок печатаем при смене категории.
	ОтмеченоВсего = 0;
	ПунктыTools = "";
	ПредыдущаяКатегория = "";
	Для Каждого Тул Из Данные.ВсеTools Цикл

		Если Тул.Категория <> ПредыдущаяКатегория Тогда
			ПунктыTools = ПунктыTools + "<div class=""ar-pop-group"">"
				+ ЭкранироватьHTML(Тул.Категория) + "</div>";
			ПредыдущаяКатегория = Тул.Категория;
		КонецЕсли;

		Отмечен = (Данные.ВыбранныеTools.Найти(Тул.Имя) <> Неопределено);
		Если Отмечен Тогда
			ОтмеченоВсего = ОтмеченоВсего + 1;
		КонецЕсли;

		ПунктыTools = ПунктыTools
			+ "<a class=""ar-tool-item" + ?(Отмечен, " ar-tool-on", "") + """"
			+ " href=""1c://toggle-tool?name=" + Тул.Имя + """>"
			+ "<span class=""ar-tool-box"">" + ?(Отмечен, "&#9745;", "&#9744;") + "</span>"
			+ "<span class=""ar-tool-body"">"
			+ "<span class=""ar-tool-head"">"
			+ "<span class=""ar-tool-title"">" + ЭкранироватьHTML(Тул.Представление) + "</span>"
			+ ar_ApprovalПредставление.БейджРиска(Тул.Риск, Тул.ТребуетApproval)
			+ "</span>"
			+ "<span class=""ar-tool-desc"">" + ЭкранироватьHTML(Тул.Описание) + "</span>"
			+ "<span class=""ar-tool-id"">" + ЭкранироватьHTML(Тул.Имя) + "</span>"
			+ "</span></a>";

	КонецЦикла;

	// Массовые действия (UI-31, H): быстрый набор без перебора галок вручную.
	ДействияTools = "<div class=""ar-pop-actions"">"
		+ "<a href=""1c://tools-preset?kind=all"">"
		+ ЭкранироватьHTML(НСтр("ru='Выбрать все'; en='Select all'")) + "</a>"
		+ "<a href=""1c://tools-preset?kind=read"">"
		+ ЭкранироватьHTML(НСтр("ru='Только чтение'; en='Read-only'")) + "</a>"
		+ "<a href=""1c://tools-preset?kind=none"">"
		+ ЭкранироватьHTML(НСтр("ru='Снять все'; en='Clear'")) + "</a>"
		+ ?(Данные.РежимБезАгента, "",
			"<a href=""1c://tools-preset?kind=agent"">"
			+ ЭкранироватьHTML(НСтр("ru='Набор агента'; en='Agent default'")) + "</a>")
		+ "<a class=""ar-pop-close"" href=""1c://close-tools-popup"">&#10005; "
		+ ЭкранироватьHTML(НСтр("ru='Закрыть'; en='Close'")) + "</a>"
		+ "</div>";

	ПодписьTools = СтрШаблон(НСтр("ru='Инструменты (%1)'; en='Tools (%1)'"),
		Формат(ОтмеченоВсего, "ЧГ=0; ЧН=0"));
	Если Данные.ЕстьОверрайд И НЕ Данные.РежимБезАгента Тогда
		ПодписьTools = ПодписьTools + " *";
	КонецЕсли;

	// Заголовок управляется явной ссылкой 1c://toggle-tools-popup, см.
	// ВыполнитьПереключениеПопапаTools (тот же приём, что у попапа агента выше).
	// Нативный <details>/<summary> toggle по клику мыши в толстом клиенте
	// ненадёжен: при открытом списке клик по заголовку может попадать на крайний
	// пункт списка (перекрытие из-за абсолютного позиционирования ar-pop-body).
	ПопапTools = "<div class=""ar-pop ar-pop-managed" + ?(Данные.ПопапToolsОткрыт, " ar-pop-open", "") + """>"
		+ "<a class=""ar-pop-summary"" href=""1c://toggle-tools-popup"">&#128736; "
		+ ЭкранироватьHTML(ПодписьTools) + "</a>"
		+ "<div class=""ar-pop-body ar-pop-tools"">"
		+ ?(Данные.РежимБезАгента ИЛИ НЕ Данные.ЕстьОверрайд, "",
			"<div class=""ar-pop-caption"">"
			+ ЭкранироватьHTML(НСтр("ru='Набор переопределён для этого диалога'; en='Set is overridden for this dialog'"))
			+ "</div>")
		+ ДействияTools
		+ ПунктыTools + "</div></div>";

	// Кнопка действия: Остановить при активном запуске, иначе Отправить.
	Если Активен Тогда
		КнопкаДействия = "<a class=""ar-btn ar-btn-stop"" href=""1c://stop"">&#9632; "
			+ ЭкранироватьHTML(НСтр("ru='Остановить'; en='Stop'")) + "</a>";
	Иначе
		КнопкаДействия = "<a class=""ar-btn ar-btn-send"" id=""ar-send-link"" href=""1c://send"">&#10148; "
			+ ЭкранироватьHTML(НСтр("ru='Отправить'; en='Send'")) + "</a>";
	КонецЕсли;

	Возврат "<footer class=""ar-composer"">"
		+ Предупреждение
		+ "<div class=""ar-composer-box"">"
		+ "<textarea id=""ar-input"" rows=""3"" placeholder="""
		+ ЭкранироватьHTML(НСтр("ru='Напишите сообщение агенту... (Enter - отправить, Shift+Enter - новая строка)';
			|en='Message the agent... (Enter - send, Shift+Enter - new line)'"))
		+ """>" + ЭкранироватьHTML(Данные.Черновик) + "</textarea>"
		+ "<div class=""ar-composer-bar"">"
		+ ПопапАгента + ПопапTools
		+ "<span class=""ar-spacer""></span>"
		+ КнопкаДействия
		+ "</div></div></footer>";

КонецФункции

// Локализованное представление статуса запуска для чипа шапки.
//
&НаСервереБезКонтекста
Функция ПредставлениеСтатуса(Знач Статус)

	Если Статус = "Running" ИЛИ Статус = "Created" Тогда
		Возврат НСтр("ru='Работает'; en='Running'");
	ИначеЕсли Статус = "PausedForApproval" Тогда
		Возврат НСтр("ru='Ждёт подтверждения'; en='Awaiting approval'");
	ИначеЕсли Статус = "PausedForInput" Тогда
		Возврат НСтр("ru='Ждёт ответа'; en='Awaiting answer'");
	ИначеЕсли Статус = "Completed" Тогда
		Возврат НСтр("ru='Завершено'; en='Completed'");
	ИначеЕсли Статус = "Failed" ИЛИ Статус = "FailedIncompatibleState" Тогда
		Возврат НСтр("ru='Ошибка'; en='Failed'");
	ИначеЕсли Статус = "Cancelled" Тогда
		Возврат НСтр("ru='Остановлено'; en='Cancelled'");
	ИначеЕсли Статус = "MaxStepsReached" Тогда
		Возврат НСтр("ru='Достигнут лимит шагов'; en='Max steps reached'");
	ИначеЕсли Статус = "Interrupted" Тогда
		Возврат НСтр("ru='Прервано'; en='Interrupted'");
	ИначеЕсли Статус = "DeniedGlobally" Тогда
		Возврат НСтр("ru='Запрещено'; en='Denied'");
	Иначе
		Возврат Статус;
	КонецЕсли;

КонецФункции

// Каркас документа: инлайн-CSS (офлайн, без CDN) + минимальный JS
// (автопрокрутка ленты, фокус композера, Enter → клик по ссылке отправки).
//
&НаСервереБезКонтекста
Функция HTMLКаркас(Знач Содержимое)

	CSS =
