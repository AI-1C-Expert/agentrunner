		+ ".ar-btn-no{background:#fff;color:#c0392b;border:1px solid #e0b4ae;}"
		+ ".ar-btn-no:hover{background:#fbe9e7;}"
		+ ".ar-btn-choice{background:#fff;border:1px solid #d8d5c8;color:#1a1a18;}"
		+ ".ar-btn-choice:hover{background:#f0eee6;}"
		+ ".ar-btn-send{background:#c96442;color:#fff;}"
		+ ".ar-btn-send:hover{background:#b55a3b;}"
		+ ".ar-btn-stop{background:#fff;color:#c0392b;border:1px solid #e0b4ae;}"
		+ ".ar-input-inline{flex:1;min-width:180px;border:1px solid #d8d5c8;border-radius:8px;"
		+ "padding:6px 10px;font-size:12px;font-family:inherit;}"
