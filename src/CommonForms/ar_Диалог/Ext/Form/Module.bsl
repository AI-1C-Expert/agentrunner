&НаКлиенте
Процедура ОткрытьRunViewer()

	Если ПустаяСтрока(ТекущийRunId) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФорму("ОбщаяФорма.ar_ПросмотрЗапуска",
		Новый Структура("RunId", ТекущийRunId));

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСлужебныйЛог()

	ТекстЛога = СобратьСлужебныйЛогНаСервере();

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ТекстЛога);
	Документ.Показать(НСтр("ru='Служебный лог AgentRunner'; en='AgentRunner service log'"));

КонецПроцедуры

// Самопроверка финансовых tools на данных текущей ИБ (ar_ТестыФинансыНаДанных).
// Заменяет ручной цикл «собрать .cfe -> задать вопрос в чате -> выгрузить лог ->
// сверить с ОСВ»: те же вызовы tools выполняются напрямую, ответ проверяется на
// инварианты. READ-ONLY - ни один mutating-tool не вызывается.
//
&НаКлиенте
Процедура ЗапуститьСамопроверку()

	ТекстОтчёта = ВыполнитьСамопроверкуНаСервере();

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ТекстОтчёта);
	Документ.Показать(НСтр("ru='Самопроверка AgentRunner'; en='AgentRunner self-check'"));

КонецПроцедуры

#КонецОбласти

#Область ТаймерОпроса

// Обработчик ожидания - опрос статуса запуска.
//
&НаКлиенте
Процедура ar_ОпросСтатуса()

	// Отключаем таймер перед серверным вызовом, чтобы не накапливались вызовы.
	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");

	Если ПустаяСтрока(ТекущийRunId) Тогда
		Возврат;
	КонецЕсли;

	// Черновик - до возможной перерисовки HTML на сервере.
	ЗапомнитьЧерновикИзDOM();

	ПродолжатьОпрос = ОпроситьНаСервере();

	Если ПродолжатьОпрос Тогда
		ИнтервалОпроса = СледующийИнтервал(ИнтервалОпроса);
		ПодключитьОбработчикОжидания("ar_ОпросСтатуса", ИнтервалОпроса);
	КонецЕсли;

КонецПроцедуры

// Запустить или перезапустить таймер опроса.
//
&НаКлиенте
Процедура ЗапуститьТаймер(Знач Интервал)

	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");
	ИнтервалОпроса = Интервал;
	ПодключитьОбработчикОжидания("ar_ОпросСтатуса", Интервал);

КонецПроцедуры

// Является ли статус запуска финальным (цикл завершён, опрос не нужен).
//
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоФинальныйСтатус(Знач Статус)

	Возврат Статус = "Completed"
		ИЛИ Статус = "Failed"
		ИЛИ Статус = "Cancelled"
		ИЛИ Статус = "Interrupted"
		ИЛИ Статус = "MaxStepsReached"
		ИЛИ Статус = "DeniedGlobally"
		ИЛИ Статус = "FailedIncompatibleState";

КонецФункции

// Следующий интервал адаптивного таймера: 1→2→3→5→8 (потолок 8 секунд).
//
&НаКлиенте
Функция СледующийИнтервал(Знач ТекущийИнтервал)

	// В паузах (approval/ask_user) держим быстрый отклик - решение оператора
	// должно подхватываться без долгого ожидания.
	Если СтатусЗапуска = "PausedForApproval" ИЛИ СтатусЗапуска = "PausedForInput" Тогда
		Возврат 3;
	КонецЕсли;

	Если ТекущийИнтервал <= 1 Тогда
		Возврат 2;
	ИначеЕсли ТекущийИнтервал <= 2 Тогда
		Возврат 3;
	ИначеЕсли ТекущийИнтервал <= 3 Тогда
		Возврат 5;
	Иначе
		Возврат 8;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СерверныеМетоды

// Отправить сообщение: создать диалог при необходимости, записать ленту,
// стартовать запуск, перерисовать.
//
// Возвращаемое значение:
//  Булево - Истина, если запуск стартовал.
//
&НаСервере
Функция ОтправитьНаСервере(Знач Текст)

	// Валидация режима.
	Если РежимБезАгента Тогда
		Если НЕ ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
			ЧерновикКомпозера = Текст;
			ПерерисоватьHTML(НСтр("ru='Выберите провайдера LLM.'; en='Select an LLM provider.'"));
			Возврат Ложь;
		КонецЕсли;
		// UI-32: считаем только выбираемые пользователем tools. Служебные
		// (СлужебныеИменаTools) добавляются принудительно ниже, и набор из
		// одних служебных не должен ложно проходить эту проверку.
		Если ВыбираемыхToolsОтмечено() = 0 Тогда
			ЧерновикКомпозера = Текст;
			ПерерисоватьHTML(НСтр("ru='Отметьте хотя бы один инструмент.'; en='Select at least one tool.'"));
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ВыбранныйАгент) Тогда
			ЧерновикКомпозера = Текст;
			ПерерисоватьHTML(НСтр("ru='Выберите агента.'; en='Select an agent.'"));
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	// Диалог создаётся при первом сообщении - якорь живёт в справочнике
	// и переиспользуется при каждом открытии (персистентность сессии).
	Если НЕ ЗначениеЗаполнено(ТекущийДиалог) Тогда
		СоздатьДиалог(Текст);
	КонецЕсли;

	ЗаписатьСообщениеЛенты(ТекущийЯкорь, "user", Текст, "", "");

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("ЗапросПользователя", Текст);
	КонтекстТриггера.Вставить("ЯкорьСсылка", ТекущийЯкорь);
	КонтекстТриггера.Вставить("ПользовательUUID", ТекущийПользовательUUID());

	Если РежимБезАгента Тогда

		КонтекстТриггера.Вставить("БезАгента",         Истина);
		// UI-32: служебные tools в попапе не показываются - дополняем набор ими
		// здесь, иначе скрытие из UI отняло бы их у агента.
		КонтекстТриггера.Вставить("ОверрайдTools",     ДополнитьСлужебнымиTools(СписокВыбранныхTools()));
		КонтекстТриггера.Вставить("ОверрайдПровайдер", ВыбранныйПровайдер);
		КонтекстТриггера.Вставить("Триггер",           "manual_chat_no_agent");

		РезЗапуска = ar_RuntimeЗапуск.СтартоватьВФонеБезАгента(КонтекстТриггера);

	Иначе

		КонтекстТриггера.Вставить("Триггер", "manual_chat");

		// Оверрайд tools на текущий диалог (UI-30): если пользователь менял
		// набор в попапе, передаём его; пустой JSON = штатная ТЧ агента.
		// UI-32: служебные tools в попапе не показываются - дополняем набор ими
		// здесь, иначе скрытие из UI отняло бы их у агента.
		//
		// Ветка без оверрайда (пользователь не трогал галки) тоже передаёт
		// ОверрайдTools: иначе ar_RuntimeКонтекст.СобратьОпределенияTools взял бы
		// строго ТЧ ar_ДоступныеTools, где служебных может не быть. Базой берём
		// набор агента - тот же, что рантайм собрал бы сам, - и дополняем его.
		Если НЕ ПустаяСтрока(ВыбранныеToolsJSON) Тогда
			КонтекстТриггера.Вставить("ОверрайдTools", ДополнитьСлужебнымиTools(СписокВыбранныхTools()));
		Иначе
			КонтекстТриггера.Вставить("ОверрайдTools",
				ДополнитьСлужебнымиTools(ИменаToolsАгента(ВыбранныйАгент)));
		КонецЕсли;

		// UI-01/6: оверрайд провайдера на текущий диалог - если пользователь
		// явно переопределил провайдера агента в попапе, передаём его; иначе
		// агент запускается на своём провайдере по умолчанию (ar_LLMПровайдер).
		Если ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
			КонтекстТриггера.Вставить("ОверрайдПровайдер", ВыбранныйПровайдер);
		КонецЕсли;

		РезЗапуска = ar_RuntimeЗапуск.СтартоватьВФоне(ВыбранныйАгент, КонтекстТриггера);

	КонецЕсли;

	Если РезЗапуска.Успех Тогда
		ТекущийRunId  = РезЗапуска.RunId;
		СтатусЗапуска = "Running";
		// Sequence нумеруется заново для каждого RunId (см. ar_СобытияЗапуска).
		ПоследнийSequence = 0;
		ЧерновикКомпозера = "";
		ПопапToolsОткрыт  = Ложь;
		ПопапАгентаОткрыт = Ложь;
		ОбновитьШапкуДиалога(ТекущийДиалог, ТекущийRunId);
		ПерерисоватьHTML();
		Возврат Истина;
	КонецЕсли;

	ТекущийRunId  = "";
	СтатусЗапуска = "Failed";
	ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
		СтрШаблон(НСтр("ru='Не удалось запустить агента: %1'; en='Failed to start agent: %1'"),
			РезЗапуска.Причина),
		"", "");
	ПерерисоватьHTML();
	Возврат Ложь;

КонецФункции

// Остановить текущий запуск.
//
&НаСервере
Процедура ОстановитьНаСервере()

	ar_RuntimeЗапуск.Отменить(ТекущийRunId);
	СтатусЗапуска = "Cancelled";

	ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
		НСтр("ru='Остановлено пользователем.'; en='Stopped by user.'"), ТекущийRunId, "");

	ПерерисоватьHTML();

КонецПроцедуры

// Разрешить действие: принять approval и немедленно возобновить запуск,
// не дожидаясь минутного тика ar_ВозобновлениеПослеApproval (гонка безопасна -
// Возобновить защищён guard'ами статуса и активного задания).
//
&НаСервере
Процедура ApproveНаСервере(Знач ApprovalId)

	Результат = ar_Approval.Принять(ApprovalId, Пользователи.ТекущийПользователь());

	Если Результат.Успех Тогда
		ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
			НСтр("ru='Действие разрешено оператором.'; en='Action approved by operator.'"),
			ТекущийRunId, ApprovalId);
		// Наблюдение с фактическим итогом исполнения (approve мог состояться, а
		// исполнитель - не отработать); без него LLM видит только
		// "queued for approval" и рапортует об успехе. Ключ появился в
		// ar_Approval.Принять - при его отсутствии поведение прежнее.
		ObservationИсполнения = Неопределено;
		Результат.Свойство("ObservationИсполнения", ObservationИсполнения);

		Если Не Результат.ДействиеВыполнено Тогда
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
				СтрШаблон(НСтр("ru='Действие не выполнено: %1'; en='Action was not executed: %1'"),
					Результат.ДействиеСообщение),
				ТекущийRunId, ApprovalId);
		КонецЕсли;

		РезультатРезюме = ar_RuntimeЗапуск.Возобновить(ТекущийRunId, ObservationИсполнения);
		// "already_running" - не сбой: запуск уже возобновлён регламентным
		// заданием или параллельным окном, опрос подхватит прогресс.
		Если НЕ РезультатРезюме.Успех И РезультатРезюме.Причина <> "already_running" Тогда
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
				СтрШаблон(НСтр("ru='Не удалось возобновить запуск: %1'; en='Failed to resume run: %1'"),
					РезультатРезюме.Причина),
				ТекущийRunId, ApprovalId);
		КонецЕсли;
	Иначе
		ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
			СтрШаблон(НСтр("ru='Не удалось разрешить действие: %1'; en='Failed to approve action: %1'"),
				Результат.Причина),
			ТекущийRunId, ApprovalId);
	КонецЕсли;

	ОбновитьСтатусИзРегистра();
	ПерерисоватьHTML();

КонецПроцедуры

// Разрешить все pending-действия текущего запуска одним кликом (кнопка
// «Разрешить все (N)» в HTMLЛента, UI-31/APPR-05). Принимает каждый approval
// по отдельности (та же ar_Approval.Принять, что и одиночный ApproveНаСервере -
// исполнение и идемпотентность не дублируются), копит наблюдения и возобновляет
// запуск ОДИН раз массивом observation - каждый approval несёт свой tool_call_id,
// склеивать их в одну строку протокольно неверно (см. ar_RuntimeЗапуск.Возобновить).
//
&НаСервере
Процедура ApproveВсеНаСервере()

	Карточки = ОжидающиеApprovals(ТекущийRunId);
	Если Карточки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Наблюдения = Новый Массив;
	Пользователь = Пользователи.ТекущийПользователь();

	Для Каждого Карточка Из Карточки Цикл

		ApprovalId = Карточка.ApprovalId;
		Результат = ar_Approval.Принять(ApprovalId, Пользователь);

		Если Результат.Успех Тогда
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
				НСтр("ru='Действие разрешено оператором.'; en='Action approved by operator.'"),
				ТекущийRunId, ApprovalId);

			Если Не Результат.ДействиеВыполнено Тогда
				ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
					СтрШаблон(НСтр("ru='Действие не выполнено: %1'; en='Action was not executed: %1'"),
						Результат.ДействиеСообщение),
					ТекущийRunId, ApprovalId);
			КонецЕсли;

			ОдноНаблюдение = Неопределено;
			Результат.Свойство("ObservationИсполнения", ОдноНаблюдение);
			Если ТипЗнч(ОдноНаблюдение) = Тип("Структура") Тогда
				Наблюдения.Добавить(ОдноНаблюдение);
			КонецЕсли;
		Иначе
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
				СтрШаблон(НСтр("ru='Не удалось разрешить действие: %1'; en='Failed to approve action: %1'"),
					Результат.Причина),
				ТекущийRunId, ApprovalId);
		КонецЕсли;

	КонецЦикла;

	Если Наблюдения.Количество() > 0 Тогда
		РезультатРезюме = ar_RuntimeЗапуск.Возобновить(ТекущийRunId, Наблюдения);
		// "already_running" - не сбой: запуск мог быть уже возобновлён (гонка с
		// регламентным заданием/параллельным окном), опрос подхватит прогресс.
		Если НЕ РезультатРезюме.Успех И РезультатРезюме.Причина <> "already_running" Тогда
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
				СтрШаблон(НСтр("ru='Не удалось возобновить запуск: %1'; en='Failed to resume run: %1'"),
					РезультатРезюме.Причина),
				ТекущийRunId, "");
		КонецЕсли;
	КонецЕсли;

	ОбновитьСтатусИзРегистра();
	ПерерисоватьHTML();

КонецПроцедуры

// Отклонить действие (Отклонить сам возобновляет запуск с rejection-observation).
//
&НаСервере
Процедура RejectНаСервере(Знач ApprovalId, Знач Причина)

	Результат = ar_Approval.Отклонить(ApprovalId, Пользователи.ТекущийПользователь(), Причина);

	Если Результат.Успех Тогда
		ТекстЛенты = НСтр("ru='Действие отклонено оператором.'; en='Action rejected by operator.'");
		Если НЕ ПустаяСтрока(Причина) Тогда
			ТекстЛенты = ТекстЛенты + " " + СтрШаблон(
				НСтр("ru='Причина: %1'; en='Reason: %1'"), Причина);
		КонецЕсли;
	Иначе
		ТекстЛенты = СтрШаблон(
			НСтр("ru='Не удалось отклонить действие: %1'; en='Failed to reject action: %1'"),
			Результат.Причина);
	КонецЕсли;

	ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system", ТекстЛенты, ТекущийRunId, ApprovalId);

	ОбновитьСтатусИзРегистра();
	ПерерисоватьHTML();

КонецПроцедуры

// Ответить на вопрос ask_user: вариант по индексу из AskChoicesJSON либо
// свободный текст. Немедленный resume - обходит минутный тик регламентного
// задания ar_ВозобновлениеПослеApproval.
//
&НаСервере
Процедура ОтветитьНаСервере(Знач ApprovalId, Знач ИндексВарианта, Знач ТекстСвободный)

	ТекстОтвета = ТекстСвободный;
	Если ИндексВарианта >= 0 Тогда
		Варианты = ar_JSON.ИзJSON(AskChoicesJSON);
		Если ТипЗнч(Варианты) = Тип("Массив") И ИндексВарианта < Варианты.Количество() Тогда
			ТекстОтвета = "" + Варианты[ИндексВарианта];
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(ТекстОтвета) Тогда
		Возврат;
	КонецЕсли;

	Успех = ar_Approval.ОтветитьНаВопрос(ApprovalId,
		Пользователи.ТекущийПользователь(), ТекстОтвета);

	Если Успех = Истина Тогда

		ЗаписатьСообщениеЛенты(ТекущийЯкорь, "user", ТекстОтвета, ТекущийRunId, ApprovalId);

		ТекущийApprovalId = "";
		AskChoicesJSON    = "";

		// Немедленное возобновление с контекстом ответа (TOOL-19).
		КонтекстРезюме = Новый Структура;
		КонтекстРезюме.Вставить("approval_id", ApprovalId);
		КонтекстРезюме.Вставить("user_answer", ТекстОтвета);
		РезультатРезюме = ar_RuntimeЗапуск.Возобновить(ТекущийRunId,
			Неопределено, "input_resume", КонтекстРезюме);

		Если РезультатРезюме.Успех ИЛИ РезультатРезюме.Причина = "already_running" Тогда
			СтатусЗапуска = "Running";
		Иначе
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
				СтрШаблон(НСтр("ru='Не удалось возобновить запуск: %1'; en='Failed to resume run: %1'"),
					РезультатРезюме.Причина),
				ТекущийRunId, ApprovalId);
		КонецЕсли;

	КонецЕсли;

	ПерерисоватьHTML();

КонецПроцедуры

// Начать новый пустой диалог (текущий остаётся в сайдбаре).
//
&НаСервере
Процедура НовыйДиалогНаСервере()

	ТекущийДиалог     = Справочники.ar_Диалоги.ПустаяСсылка();
	ТекущийЯкорь      = "";
	ТекущийRunId      = "";
	СтатусЗапуска     = "";
	ТекущийApprovalId = "";
	AskChoicesJSON    = "";
	ПоследнийSequence = 0;

	// UI-31 (A): наследуем набор инструментов последнего диалога, иначе новый
	// диалог всегда стартовал с нуля и в режиме "без агента" отправка падала
	// на "Отметьте хотя бы один инструмент".
	ВыбранныеToolsJSON = ToolsПоследнегоДиалога(ТекущийПользовательUUID());

	ПерерисоватьHTML();

КонецПроцедуры

// Открыть существующий диалог: восстановить контекст (агент, tools, якорь),
// досинхронизировать хвост (запуск мог завершиться при закрытой форме).
//
// Возвращаемое значение:
//  Булево - Истина, если по диалогу ещё работает активный запуск (нужен опрос).
//
&НаСервере
Функция ОткрытьДиалогНаСервере(Знач ИдСтрока)

	ДиалогСсылка = ДиалогПоИдентификатору(ИдСтрока);
	Если НЕ ЗначениеЗаполнено(ДиалогСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДиалогСсылка,
		"ar_Якорь, ar_Агент, ar_Провайдер, ar_БезАгента, ar_ПоследнийRunId");

	ТекущийДиалог     = ДиалогСсылка;
	ТекущийЯкорь      = Реквизиты.ar_Якорь;
	РежимБезАгента    = (Реквизиты.ar_БезАгента = Истина);
	ТекущийApprovalId = "";
	AskChoicesJSON    = "";
	ЧерновикКомпозера = "";

	Если РежимБезАгента Тогда
		ВыбранныйПровайдер = Реквизиты.ar_Провайдер;
	ИначеЕсли ЗначениеЗаполнено(Реквизиты.ar_Агент) Тогда
		ВыбранныйАгент = Реквизиты.ar_Агент;
	КонецЕсли;

	ВыбранныеToolsJSON = СохранённыеToolsДиалога(ДиалогСсылка);

	// Хвост: если последний запуск завершился при закрытой форме - дописать
	// финальный ответ; если ещё работает - возобновить опрос с текущего Sequence.
	ТекущийRunId      = Реквизиты.ar_ПоследнийRunId;
	СтатусЗапуска     = "";
	ПоследнийSequence = 0;

	АктивныйЗапуск = Ложь;
	Если НЕ ПустаяСтрока(ТекущийRunId) Тогда
		СтатусЗапуска = СтатусЗапускаИзРегистра(ТекущийRunId);
		Если ЭтоФинальныйСтатус(СтатусЗапуска) Тогда
			СинхронизироватьХвостДиалога();
		ИначеЕсли НЕ ПустаяСтрока(СтатусЗапуска) Тогда
			// Прошлые промежуточные события не реплеим - продолжаем с хвоста.
			ПоследнийSequence = МаксимальныйSequence(ТекущийRunId);
			АктивныйЗапуск = Истина;
		КонецЕсли;
	КонецЕсли;

	ПерерисоватьHTML();
	Возврат АктивныйЗапуск;

КонецФункции

// Удалить диалог: пометка удаления справочника + очистка ленты по якорю.
//
&НаСервере
Процедура УдалитьДиалогНаСервере(Знач ИдСтрока)

	ДиалогСсылка = ДиалогПоИдентификатору(ИдСтрока);
	Если НЕ ЗначениеЗаполнено(ДиалогСсылка) Тогда
		Возврат;
	КонецЕсли;

	Якорь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДиалогСсылка, "ar_Якорь");

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ar_Диалоги");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ДиалогСсылка);
		Блокировка.Заблокировать();

		ОбъектДиалога = ДиалогСсылка.ПолучитьОбъект();
		Если ОбъектДиалога <> Неопределено Тогда
			ОбъектДиалога.УстановитьПометкуУдаления(Истина);
		КонецЕсли;

		Если НЕ ПустаяСтрока(Якорь) Тогда
			НаборЗаписей = РегистрыСведений.ar_СообщенияДиалога.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ar_Якорь.Установить(Якорь);
			НаборЗаписей.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если ДиалогСсылка = ТекущийДиалог Тогда
		НовыйДиалогНаСервере();
	Иначе
		ПерерисоватьHTML();
	КонецЕсли;

КонецПроцедуры

// Сменить агента. Если в текущем диалоге уже есть сообщения - начинается новый
// диалог: ключ сессии ar_Сессии включает агента, история под другим агентом
// не продолжится.
//
&НаСервере
Процедура ВыбратьАгентаНаСервере(Знач ИдСтрока)

	Если ЗначениеЗаполнено(ТекущийДиалог) Тогда
		НовыйДиалогБезРендера();
	КонецЕсли;

	Если ИдСтрока = "no-agent" Тогда
		РежимБезАгента = Истина;
	Иначе
		АгентСсылка = Справочники.ar_Агенты.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ИдСтрока));
		Если ОбщегоНазначения.СсылкаСуществует(АгентСсылка) Тогда
			ВыбранныйАгент = АгентСсылка;
			РежимБезАгента = Ложь;
		КонецЕсли;
	КонецЕсли;

	// При выборе агента сбрасываем оверрайд - подхватится набор из ТЧ агента
	// (ЭффективныйНаборTools). В режиме "без агента" такого источника нет,
	// поэтому наследуем набор последнего диалога (UI-31, A), иначе список пуст.
	Если РежимБезАгента Тогда
		ВыбранныеToolsJSON = ToolsПоследнегоДиалога(ТекущийПользовательUUID());
	Иначе
		ВыбранныеToolsJSON = "";
	КонецЕсли;

	// UI-01/6: сброс провайдера-оверрайда при смене агента - у нового агента
	// свой провайдер по умолчанию, старый оверрайд к нему не относится.
	ВыбранныйПровайдер = Неопределено;

	ПопапАгентаОткрыт = Ложь;
	ПерерисоватьHTML();

КонецПроцедуры

// Выбор провайдера в попапе композера. "agent-default" (доступен только при
// выбранном агенте, UI-01/6) снимает оверрайд - агент вернётся к своему
// провайдеру по умолчанию (ar_Агенты.ar_LLMПровайдер).
//
&НаСервере
Процедура ВыбратьПровайдераНаСервере(Знач ИдСтрока)

	Если ИдСтрока = "agent-default" Тогда
		ВыбранныйПровайдер = Неопределено;
	Иначе
		ПровайдерСсылка = Справочники.ar_LLMПровайдеры.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ИдСтрока));
		Если ОбщегоНазначения.СсылкаСуществует(ПровайдерСсылка) Тогда
			ВыбранныйПровайдер = ПровайдерСсылка;
		КонецЕсли;
	КонецЕсли;

	ПопапАгентаОткрыт = Ложь;
	ПерерисоватьHTML();

КонецПроцедуры

// Переключить инструмент в попапе композера. Для агента первый клик
// инициализирует набор из ТЧ агента (дальше он считается оверрайдом).
//
// Попап остаётся открытым после клика (ПопапToolsОткрыт), иначе полная
// пересборка HTML при каждом клике схлопывала бы <details> - пользователь
// не мог отметить второй инструмент, не раскрывая список заново, и легко
// принимал закрытый попап за "клик не сработал" (UAT-2026-08-12, п.3/6).
//
&НаСервере
Процедура ПереключитьToolНаСервере(Знач ИмяTool)

	Имена = СписокВыбранныхTools();

	Если Имена.Количество() = 0 И НЕ РежимБезАгента И ЗначениеЗаполнено(ВыбранныйАгент) Тогда
		Имена = ИменаToolsАгента(ВыбранныйАгент);
	КонецЕсли;

	Индекс = Имена.Найти(ИмяTool);
	Если Индекс = Неопределено Тогда
		Имена.Добавить(ИмяTool);
	Иначе
		Имена.Удалить(Индекс);
	КонецЕсли;

	ВыбранныеToolsJSON = ar_JSON.ВЗначениеJSON(Имена);

	Если ЗначениеЗаполнено(ТекущийДиалог) Тогда
		СохранитьToolsДиалога(ТекущийДиалог, Имена);
	КонецЕсли;

	ПопапToolsОткрыт = Истина;
	ПерерисоватьHTML();

КонецПроцедуры

// Применить массовый пресет набора инструментов (UI-31, H).
//
// Параметры:
//  Вид - Строка - all (все включённые) / read (только RiskLevel = Read) /
//        none (снять все) / agent (вернуться к набору из ТЧ агента).
//
&НаСервере
Процедура ПрименитьПресетToolsНаСервере(Знач Вид)

	Если Вид = "agent" Тогда
		// Пустой оверрайд = "брать набор агента" (см. ЭффективныйНаборTools).
		// В режиме без агента этого пункта в UI нет, но защищаемся и здесь:
		// иначе пустой JSON дал бы нулевой набор и блокировку отправки.
		Если Не РежимБезАгента Тогда
			ВыбранныеToolsJSON = "";
			Если ЗначениеЗаполнено(ТекущийДиалог) Тогда
				СохранитьToolsДиалога(ТекущийДиалог, Новый Массив);
			КонецЕсли;
			ПопапToolsОткрыт = Истина;
			ПерерисоватьHTML();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Имена = Новый Массив;
	Если Вид = "all" Или Вид = "read" Тогда
		ТолькоЧтение = (Вид = "read");
		Для Каждого Тул Из СписокВсехTools() Цикл
			Если ТолькоЧтение И Тул.Риск <> "Read" Тогда
				Продолжить;
			КонецЕсли;
			Имена.Добавить(Тул.Имя);
		КонецЦикла;
	ИначеЕсли Вид <> "none" Тогда
		// Неизвестный пресет - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

	// Для "none" в режиме агента пустой массив неотличим от "набор агента":
	// ЭффективныйНаборTools вернёт ТЧ агента, и галки останутся. Это осознанный
	// компромисс - явный сброс к нулю даёт нерабочий композер, а вернуть набор
	// агента пользователь может тем же пунктом меню.
	ВыбранныеToolsJSON = ar_JSON.ВЗначениеJSON(Имена);

	Если ЗначениеЗаполнено(ТекущийДиалог) Тогда
		СохранитьToolsДиалога(ТекущийДиалог, Имена);
	КонецЕсли;

	ПопапToolsОткрыт = Истина;
	ПерерисоватьHTML();

КонецПроцедуры

// Открыть/закрыть попап инструментов по клику на его заголовок (см.
// ВыполнитьПереключениеПопапаTools).
//
&НаСервере
Процедура ПереключитьПопапToolsНаСервере()

	ПопапToolsОткрыт = НЕ ПопапToolsОткрыт;
	// Попапы взаимоисключающие: оба раскрываются вверх от композера и
	// накладываются друг на друга (ar-pop-body позиционирован абсолютно) -
	// верхний перехватывает клики по нижнему, и выбрать провайдера при
	// открытом списке инструментов невозможно.
	Если ПопапToolsОткрыт Тогда
		ПопапАгентаОткрыт = Ложь;
	КонецЕсли;
	ПерерисоватьHTML();

КонецПроцедуры

// Закрыть попап инструментов (см. ВыполнитьЗакрытиеПопапаTools).
//
&НаСервере
Процедура ЗакрытьПопапToolsНаСервере()

	ПопапToolsОткрыт = Ложь;
	ПерерисоватьHTML();

КонецПроцедуры

// Открыть/закрыть попап агента по клику на его заголовок (см.
// ВыполнитьПереключениеПопапаАгента).
//
&НаСервере
Процедура ПереключитьПопапАгентаНаСервере()

	ПопапАгентаОткрыт = НЕ ПопапАгентаОткрыт;
	// Взаимоисключение с попапом инструментов - см.
	// ПереключитьПопапToolsНаСервере.
	Если ПопапАгентаОткрыт Тогда
		ПопапToolsОткрыт = Ложь;
	КонецЕсли;
	ПерерисоватьHTML();

КонецПроцедуры

// Один тик опроса: новые события → лента, статус, ask_user, перерисовка
// (только при изменениях - бережём фокус и скролл).
//
// Возвращаемое значение:
//  Булево - Истина, если опрос нужно продолжать.
//
&НаСервере
Функция ОпроситьНаСервере()

	Если ПустаяСтрока(ТекущийRunId) Тогда
		Возврат Ложь;
	КонецЕсли;

	БылоИзменение = Ложь;

	// 1. Новые события запуска → записи ленты.
	События = НовыеСобытияЗапуска(ТекущийRunId, ПоследнийSequence);
	Для Каждого Событие Из События Цикл

		Если Событие.Sequence > ПоследнийSequence Тогда
			ПоследнийSequence = Событие.Sequence;
		КонецЕсли;

		Если Событие.ТипСобытия = "LLMCalled" Тогда
			ТекстLLM = "";
			Событие.Свойство("ТекстОтвета", ТекстLLM);
			Если НЕ ПустаяСтрока(ТекстLLM) Тогда
				ЗаписатьСообщениеЛенты(ТекущийЯкорь, "assistant", ТекстLLM, ТекущийRunId, "");
				БылоИзменение = Истина;
			КонецЕсли;

		ИначеЕсли Событие.ТипСобытия = "ToolCalled" Тогда
			ИмяТула = "";
			Событие.Свойство("ИмяТула", ИмяТула);
			Если НЕ ПустаяСтрока(ИмяТула) Тогда
				ЗаписатьСообщениеЛенты(ТекущийЯкорь, "tool", ИмяТула, ТекущийRunId, "");
				БылоИзменение = Истина;
			КонецЕсли;

		ИначеЕсли Событие.ТипСобытия = "Completed" Тогда
			ТекстФинала = "";
			Событие.Свойство("ТекстОтвета", ТекстФинала);
			Если НЕ ПустаяСтрока(ТекстФинала)
				И ТекстФинала <> ПоследнийТекстЛенты(ТекущийЯкорь, "assistant") Тогда
				ЗаписатьСообщениеЛенты(ТекущийЯкорь, "assistant", ТекстФинала, ТекущийRunId, "");
			КонецЕсли;
			БылоИзменение = Истина;

		ИначеЕсли Событие.ТипСобытия = "Failed" Тогда
			ТекстОшибки = НСтр("ru='Запуск завершился ошибкой.'; en='Run failed.'");
			ТекстИзСобытия = "";
			Событие.Свойство("ТекстОшибки", ТекстИзСобытия);
			Если НЕ ПустаяСтрока(ТекстИзСобытия) Тогда
				ТекстОшибки = ТекстОшибки + " " + ТекстИзСобытия;
			КонецЕсли;
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system", ТекстОшибки, ТекущийRunId, "");
			БылоИзменение = Истина;

		КонецЕсли;

	КонецЦикла;

	// 2. Статус запуска.
	НовыйСтатус = СтатусЗапускаИзРегистра(ТекущийRunId);
	Если НЕ ПустаяСтрока(НовыйСтатус) И НовыйСтатус <> СтатусЗапуска Тогда
		СтатусЗапуска = НовыйСтатус;
		БылоИзменение = Истина;
	КонецЕсли;

	// 3. Вопрос ask_user (карточка с вариантами).
	Если СтатусЗапуска = "PausedForInput" И ПустаяСтрока(ТекущийApprovalId) Тогда
		Если ЗаполнитьAskUser() Тогда
			БылоИзменение = Истина;
		КонецЕсли;
	КонецЕсли;

	Если БылоИзменение Тогда
		ПерерисоватьHTML();
	КонецЕсли;

	Возврат НЕ ЭтоФинальныйСтатус(СтатусЗапуска);

КонецФункции

// Полная перерисовка по запросу пользователя (кнопка «Обновить»).
//
&НаСервере
Процедура ПерерисоватьНаСервере()

	Если НЕ ПустаяСтрока(ТекущийRunId) Тогда
		ОбновитьСтатусИзРегистра();
	КонецЕсли;
	ПерерисоватьHTML();

КонецПроцедуры

&НаСервере
Функция СобратьСлужебныйЛогНаСервере()

	Возврат ar_ДиагностикаОчистка.СобратьСлужебныйЛог().ПолучитьТекст();

КонецФункции

&НаСервере
Функция ВыполнитьСамопроверкуНаСервере()

	Возврат ar_ТестыФинансыНаДанных.ВыполнитьВсе();

КонецФункции

// Очистить все служебные регистры/справочники расширения (кроме
// ar_ХранилищеСекретов), перенесено из ar_ДиалогOld (UI-22).
//
// Возвращаемое значение:
//  Структура - {Успех (Булево), ВсегоУдалено (Число), КоличествоОшибок (Число),
//               ВсегоИсточников (Число)}.
//
&НаСервере
Функция ОчиститьСлужебныеДанныеНаСервере()

	РезультатОчистки = ar_ДиагностикаОчистка.ОчиститьСлужебныеДанные();

	// Источников очистки - 9 регистров + справочник ar_ПамятьАгента
	// (см. заголовок ar_ДиагностикаОчистка). Не выводим полные тексты ошибок
	// (стек вызовов) на клиента - только счётчики; подробности - в audit-событии.
	ВсегоИсточников = 10;

	Результат = Новый Структура;
	Результат.Вставить("Успех",            РезультатОчистки.УспехОбщий);
	Результат.Вставить("ВсегоУдалено",     РезультатОчистки.ВсегоУдалено);
	Результат.Вставить("КоличествоОшибок", РезультатОчистки.Ошибки.Количество());
	Результат.Вставить("ВсегоИсточников",  ВсегоИсточников);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ДанныеДиалогов

// Создать элемент справочника ar_Диалоги при первом сообщении.
//
&НаСервере
Процедура СоздатьДиалог(Знач ПервыйТекст)

	Якорь = "chat:" + Строка(Новый УникальныйИдентификатор());

	ОбъектДиалога = Справочники.ar_Диалоги.СоздатьЭлемент();
	ОбъектДиалога.Наименование      = ЗаголовокИзТекста(ПервыйТекст);
	ОбъектДиалога.ar_Якорь          = Якорь;
	ОбъектДиалога.ar_Агент          = ?(РежимБезАгента,
		Справочники.ar_Агенты.ПустаяСсылка(), ВыбранныйАгент);
	ОбъектДиалога.ar_Провайдер      = ?(РежимБезАгента,
		ВыбранныйПровайдер, Справочники.ar_LLMПровайдеры.ПустаяСсылка());
	ОбъектДиалога.ar_БезАгента      = РежимБезАгента;
	ОбъектДиалога.ar_ПользовательUUID = ТекущийПользовательUUID();
	ОбъектДиалога.ar_Создан         = ТекущаяДатаСеанса();
	ОбъектДиалога.ar_Обновлён       = ТекущаяДатаСеанса();

	Для Каждого Имя Из СписокВыбранныхTools() Цикл
		СтрокаТЧ = ОбъектДиалога.ar_ВыбранныеTools.Добавить();
		СтрокаТЧ.ar_Имя = Имя;
	КонецЦикла;

	ОбъектДиалога.Записать();

	ТекущийДиалог = ОбъектДиалога.Ссылка;
	ТекущийЯкорь  = Якорь;

КонецПроцедуры

// Однострочный заголовок диалога из первого сообщения.
//
&НаСервереБезКонтекста
Функция ЗаголовокИзТекста(Знач Текст)

	Однострочный = СтрЗаменить(СокрЛП(Текст), Символы.ПС, " ");
	Если СтрДлина(Однострочный) > 80 Тогда
		Возврат Лев(Однострочный, 77) + "...";
	КонецЕсли;
	Возврат ?(ПустаяСтрока(Однострочный),
		НСтр("ru='Новый диалог'; en='New dialog'"), Однострочный);

КонецФункции

// Записать строку ленты. Номер = MAX+1 в рамках якоря, под блокировкой данных -
// защита от гонки при двух окнах одного диалога.
//
&НаСервереБезКонтекста
Процедура ЗаписатьСообщениеЛенты(Знач Якорь, Знач Роль, Знач Текст,
		Знач RunId, Знач ApprovalId)

	Если ПустаяСтрока(Якорь) Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_СообщенияДиалога");
		ЭлементБлокировки.УстановитьЗначение("ar_Якорь", Якорь);
		Блокировка.Заблокировать();

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Сообщения.ar_Номер), 0) КАК МаксНомер
			|ИЗ
			|	РегистрСведений.ar_СообщенияДиалога КАК Сообщения
			|ГДЕ
			|	Сообщения.ar_Якорь = &Якорь";
		Запрос.УстановитьПараметр("Якорь", Якорь);
		Выборка = Запрос.Выполнить().Выбрать();
		МаксНомер = 0;
		Если Выборка.Следующий() Тогда
			МаксНомер = Выборка.МаксНомер;
		КонецЕсли;

		МенеджерЗаписи = РегистрыСведений.ar_СообщенияДиалога.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_Якорь      = Якорь;
		МенеджерЗаписи.ar_Номер      = МаксНомер + 1;
		МенеджерЗаписи.ar_Роль       = Роль;
		МенеджерЗаписи.ar_Текст      = Текст;
		МенеджерЗаписи.ar_RunId      = RunId;
		МенеджерЗаписи.ar_ApprovalId = ApprovalId;
		МенеджерЗаписи.ar_Момент     = ТекущаяДатаСеанса();
		МенеджерЗаписи.Записать();

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Лента диалога по якорю, упорядоченная по номеру.
//
&НаСервереБезКонтекста
Функция ЛентаДиалога(Знач Якорь)

	Результат = Новый Массив;
	Если ПустаяСтрока(Якорь) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сообщения.ar_Роль   КАК Роль,
		|	Сообщения.ar_Текст  КАК Текст,
		|	Сообщения.ar_Момент КАК Момент
		|ИЗ
		|	РегистрСведений.ar_СообщенияДиалога КАК Сообщения
		|ГДЕ
		|	Сообщения.ar_Якорь = &Якорь
		|УПОРЯДОЧИТЬ ПО
		|	Сообщения.ar_Номер ВОЗР";
	Запрос.УстановитьПараметр("Якорь", Якорь);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Роль",   Выборка.Роль);
		Запись.Вставить("Текст",  Выборка.Текст);
		Запись.Вставить("Момент", Выборка.Момент);
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст последней записи ленты с заданной ролью (дедупликация финального
// ответа: Completed.content часто совпадает с последним LLMCalled-текстом).
//
&НаСервереБезКонтекста
Функция ПоследнийТекстЛенты(Знач Якорь, Знач Роль)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сообщения.ar_Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ar_СообщенияДиалога КАК Сообщения
		|ГДЕ
		|	Сообщения.ar_Якорь = &Якорь
		|	И Сообщения.ar_Роль = &Роль
		|УПОРЯДОЧИТЬ ПО
		|	Сообщения.ar_Номер УБЫВ";
	Запрос.УстановитьПараметр("Якорь", Якорь);
	Запрос.УстановитьПараметр("Роль",  Роль);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Текст;
	КонецЕсли;
	Возврат "";

КонецФункции

// Есть ли в ленте запись с заданными RunId и ролью (идемпотентность дозаписи).
//
&НаСервереБезКонтекста
Функция ЕстьЗаписьЛенты(Знач Якорь, Знач RunId, Знач Роль)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сообщения.ar_Номер КАК Номер
		|ИЗ
		|	РегистрСведений.ar_СообщенияДиалога КАК Сообщения
		|ГДЕ
		|	Сообщения.ar_Якорь = &Якорь
		|	И Сообщения.ar_RunId = &RunId
		|	И Сообщения.ar_Роль = &Роль";
	Запрос.УстановитьПараметр("Якорь", Якорь);
	Запрос.УстановитьПараметр("RunId", RunId);
	Запрос.УстановитьПараметр("Роль",  Роль);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Досинхронизация хвоста: запуск завершился, пока форма была закрыта -
// дописать финальный ответ/ошибку в ленту (идемпотентно по RunId+роли).
//
&НаСервере
Процедура СинхронизироватьХвостДиалога()

	Если ПустаяСтрока(ТекущийRunId) ИЛИ ПустаяСтрока(ТекущийЯкорь) Тогда
		Возврат;
	КонецЕсли;

	Если СтатусЗапуска = "Completed" Тогда

		Если НЕ ЕстьЗаписьЛенты(ТекущийЯкорь, ТекущийRunId, "assistant") Тогда
			ТекстФинала = ТекстСобытияCompleted(ТекущийRunId);
			Если НЕ ПустаяСтрока(ТекстФинала) Тогда
				ЗаписатьСообщениеЛенты(ТекущийЯкорь, "assistant", ТекстФинала, ТекущийRunId, "");
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли СтатусЗапуска = "Failed" ИЛИ СтатусЗапуска = "MaxStepsReached" Тогда

		Если НЕ ЕстьЗаписьЛенты(ТекущийЯкорь, ТекущийRunId, "system") Тогда
			ЗаписатьСообщениеЛенты(ТекущийЯкорь, "system",
				СтрШаблон(НСтр("ru='Запуск завершился со статусом %1.'; en='Run finished with status %1.'"),
					СтатусЗапуска),
				ТекущийRunId, "");
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Финальный текст ответа из события Completed (payload, ключ content).
//
&НаСервереБезКонтекста
Функция ТекстСобытияCompleted(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	События.ar_PayloadJSON КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК События
		|ГДЕ
		|	События.ar_RunId = &RunId
		|	И События.ar_ТипСобытия = ЗНАЧЕНИЕ(Перечисление.ar_ТипСобытия.Completed)
		|УПОРЯДОЧИТЬ ПО
		|	События.ar_Sequence УБЫВ";
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Payload = ar_JSON.ИзJSON(Выборка.PayloadJSON);
		Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
			Текст = Payload.Получить("content");
			Если Текст <> Неопределено Тогда
				Возврат "" + Текст;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Ошибки парсинга payload не критичны для отображения.
	КонецПопытки;

	Возврат "";

КонецФункции

// Новые события запуска (Sequence > курсора) с распакованным payload.
//
&НаСервереБезКонтекста
Функция НовыеСобытияЗапуска(Знач RunId, Знач ПоследнийНомер)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(События.ar_Sequence КАК ЧИСЛО(10, 0)) КАК Sequence,
		|	События.ar_ТипСобытия  КАК ТипСобытияСсылка,
		|	События.ar_PayloadJSON КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК События
		|ГДЕ
		|	События.ar_RunId = &RunId
		|	И События.ar_Sequence > &ПоследнийНомер
		|УПОРЯДОЧИТЬ ПО
		|	События.ar_Sequence ВОЗР";
	Запрос.УстановитьПараметр("RunId",          RunId);
	Запрос.УстановитьПараметр("ПоследнийНомер", ПоследнийНомер);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураСоб = Новый Структура;
		СтруктураСоб.Вставить("Sequence",   Выборка.Sequence);
		СтруктураСоб.Вставить("ТипСобытия", ИмяТипаСобытия(Выборка.ТипСобытияСсылка));
		ЗаполнитьПолезнуюНагрузкуСобытия(СтруктураСоб, Выборка.PayloadJSON);
		Результат.Добавить(СтруктураСоб);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Распаковать PayloadJSON события и добавить прикладные поля в структуру.
//
&НаСервереБезКонтекста
Процедура ЗаполнитьПолезнуюНагрузкуСобытия(СтруктураСоб, Знач PayloadJSON)

	Если ПустаяСтрока(PayloadJSON) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// ar_JSON.ИзJSON возвращает JSON-объекты как Соответствие -
		// доступ через Получить(), а не через точечную нотацию.
		Payload = ar_JSON.ИзJSON(PayloadJSON);
		Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
			Возврат;
		КонецЕсли;
		ТекстОтвета = Payload.Получить("content");
		Если ТекстОтвета = Неопределено Тогда
			ТекстОтвета = Payload.Получить("text");
		КонецЕсли;
		Если ТекстОтвета <> Неопределено Тогда
			СтруктураСоб.Вставить("ТекстОтвета", ТекстОтвета);
		КонецЕсли;
		ИмяТула = Payload.Получить("tool_name");
		Если ИмяТула <> Неопределено Тогда
			СтруктураСоб.Вставить("ИмяТула", ИмяТула);
		КонецЕсли;
		ТекстОшибки = Payload.Получить("error");
		Если ТекстОшибки <> Неопределено Тогда
			СтруктураСоб.Вставить("ТекстОшибки",
				ar_Утилиты.ОчиститьОшибкуДляLLM(ТекстОшибки));
		КонецЕсли;
	Исключение
		// Ошибки парсинга payload не критичны для отображения истории.
	КонецПопытки;

КонецПроцедуры

// Заполнить реквизиты вопроса ask_user из очереди и дописать вопрос в ленту.
//
// Возвращаемое значение:
//  Булево - Истина, если найден новый вопрос.
//
&НаСервере
Функция ЗаполнитьAskUser()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.ar_ApprovalId        КАК ApprovalId,
		|	Очередь.ar_ActionPayloadJSON КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_RunId  = &RunId
		|	И Очередь.ar_Статус = &Статус";
	Запрос.УстановитьПараметр("RunId",  ТекущийRunId);
	Запрос.УстановитьПараметр("Статус", "awaiting_input");

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущийApprovalId = Выборка.ApprovalId;
	Вопрос    = "";
	Подсказка = "";
	Варианты  = Новый Массив;

	Попытка
		Payload = ar_JSON.ИзJSON(Выборка.PayloadJSON);
		Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
			Аргументы = Payload.Получить("arguments");
			Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
				Источник = Аргументы;
			Иначе
				Источник = Payload;
			КонецЕсли;
			Значение = Источник.Получить("question");
			Если Значение <> Неопределено Тогда
				Вопрос = "" + Значение;
			КонецЕсли;
			Значение = Источник.Получить("hint");
			Если Значение <> Неопределено Тогда
				Подсказка = "" + Значение;
			КонецЕсли;
			СписокВариантов = Источник.Получить("choices");
			Если ТипЗнч(СписокВариантов) = Тип("Массив") Тогда
				МаксВариантов = Мин(СписокВариантов.Количество(), 20);
				Для Инд = 0 По МаксВариантов - 1 Цикл
					Варианты.Добавить("" + СписокВариантов[Инд]);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Ошибки парсинга payload ask_user не критичны.
	КонецПопытки;

	AskChoicesJSON = ar_JSON.ВЗначениеJSON(Варианты);

	ТекстВопроса = Вопрос;
	Если НЕ ПустаяСтрока(Подсказка) Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС
			+ НСтр("ru='Подсказка: '; en='Hint: '") + Подсказка;
	КонецЕсли;

	// Идемпотентность: вопрос уже мог попасть в ленту при прошлом опросе.
	Если НЕ ПустаяСтрока(ТекстВопроса)
		И НЕ ЕстьЗаписьЛенты(ТекущийЯкорь, ТекущийRunId, "ask_user") Тогда
		ЗаписатьСообщениеЛенты(ТекущийЯкорь, "ask_user", ТекстВопроса,
			ТекущийRunId, ТекущийApprovalId);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Ожидающие подтверждения действия текущего запуска (карточки в ленте).
//
&НаСервереБезКонтекста
Функция ОжидающиеApprovals(Знач RunId)

	Результат = Новый Массив;
	Если ПустаяСтрока(RunId) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.ar_ApprovalId        КАК ApprovalId,
		|	Очередь.ar_ActionPayloadJSON КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_RunId  = &RunId
		|	И Очередь.ar_Статус = &Статус
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ar_СозданоВ ВОЗР";
	Запрос.УстановитьПараметр("RunId",  RunId);
	Запрос.УстановитьПараметр("Статус", "pending");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Карточка = ar_ApprovalПредставление.СобратьКарточку(Выборка.ApprovalId, Выборка.PayloadJSON);
		Результат.Добавить(Карточка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Список диалогов текущего пользователя для сайдбара (последние 50).
//
&НаСервереБезКонтекста
Функция СписокДиалогов(Знач ПользовательUUID)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Диалоги.Ссылка       КАК Ссылка,
		|	Диалоги.Наименование КАК Наименование,
		|	Диалоги.ar_Обновлён  КАК Обновлён,
		|	Диалоги.ar_БезАгента КАК БезАгента,
		|	ПРЕДСТАВЛЕНИЕ(Диалоги.ar_Агент) КАК ИмяАгента
		|ИЗ
		|	Справочник.ar_Диалоги КАК Диалоги
		|ГДЕ
		|	Диалоги.ar_ПользовательUUID = &Пользователь
		|	И НЕ Диалоги.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Диалоги.ar_Обновлён УБЫВ";
	Запрос.УстановитьПараметр("Пользователь", ПользовательUUID);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Диалог = Новый Структура;
		Диалог.Вставить("Ид",           Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Диалог.Вставить("Наименование", Выборка.Наименование);
		Диалог.Вставить("Обновлён",     Выборка.Обновлён);
		Диалог.Вставить("Подпись",      ?(Выборка.БезАгента = Истина,
			НСтр("ru='Без агента'; en='No agent'"), Выборка.ИмяАгента));
		Результат.Добавить(Диалог);
	КонецЦикла;

	Возврат Результат;

КонецФункции

