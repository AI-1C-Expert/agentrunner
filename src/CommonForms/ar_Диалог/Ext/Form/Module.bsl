////////////////////////////////////////////////////////////////////////////////
// Модуль формы ar_Диалог - чат с агентом (UI-30, редизайн UI-25).
//
// Вся форма - одно поле HTML (ПолеЧата), управление - кликами по служебным
// ссылкам "1c://<действие>?<параметры>" (референс - ОбщаяФорма.ar_Настройки).
// Лейаут в духе Claude/Codex: слева сайдбар со списком диалогов, справа лента
// чата и композер с выбором агента и инструментов.
//
// Персистентность:
//   * Справочник ar_Диалоги - шапки диалогов (якорь, агент, владелец).
//   * РегистрСведений ar_СообщенияДиалога - построчная лента для UI.
//   * Якорь "chat:<uuid>" создаётся один раз на диалог и переиспользуется -
//     контекст LLM продолжается через ar_Сессии по тому же якорю (SESS-05).
//
// Взаимодействие с ядром:
//   * ar_RuntimeЗапуск.СтартоватьВФоне / СтартоватьВФонеБезАгента - старт.
//   * ar_RuntimeЗапуск.Возобновить - немедленный resume после approve/answer
//     (не ждём минутного тика регламентного задания).
//   * ar_Approval.Принять / Отклонить / ОтветитьНаВопрос - решения оператора.
//   * Прогресс - опрос ar_СобытияЗапуска по Sequence (адаптивный таймер).
//
// Ограничение: чтение полей ввода из HTML идёт через DOM
// (Элементы.ПолеЧата.Документ) - доступно в толстом и тонком клиенте;
// в веб-клиенте отправка текста недоступна (как и в ar_Настройки).
//
// Запрещено: Выполнить(), Вычислить(), привилегированный режим.
// Строки UI - только через НСтр("ru=...; en=...").
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// Инициализация: дефолтный агент, пустой новый диалог, первый рендер.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекущийRunId      = "";
	СтатусЗапуска     = "";
	ТекущийApprovalId = "";
	ИнтервалОпроса    = 1;
	ПоследнийSequence = 0;

	Если Параметры.Свойство("ar_Агент") И ЗначениеЗаполнено(Параметры.ar_Агент) Тогда
		ВыбранныйАгент = Параметры.ar_Агент;
		РежимБезАгента = Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ВыбранныйАгент) И НЕ РежимБезАгента Тогда
		ВыбранныйАгент = ПервыйАктивныйАгент();
	КонецЕсли;

	ПрерватьЗависшиеЗапуски();

	ПерерисоватьHTML();

КонецПроцедуры

// Помечает прерванными запуски, чей heartbeat давно не обновлялся (SCHED-04).
//
// В файловой ИБ цикл агента выполняется синхронно внутри серверного вызова
// (ar_RuntimeЗапуск.ФоновоеЗаданиеНужноВыполнитьСинхронно - платформа
// допускает лишь одно активное фоновое задание). Если такой вызов оборвался
// - веб-клиент разорвал соединение, сеанс завершился - цикл умирает, не
// дойдя до ЗавершитьЗапуск, и запись остаётся в статусе Running навсегда.
// Форма при этом бесконечно показывает "Агент думает...".
//
// Функция поиска зависших (ar_AuditЗащищённыйРежим.НайтиЗависшиеЗапуски-
// Привилегированно, SCHED-04) существовала, но не имела ни одного вызова -
// зависшие запуски никто не закрывал. Чистим их при открытии диалога.
//
&НаСервере
Процедура ПрерватьЗависшиеЗапуски()

	Попытка
		// Запас поверх HeartbeatПорогСек: heartbeat обновляется РАЗ В ШАГ
		// (ar_RuntimeЦикл, п.1), а один шаг включает вызов LLM с retry/fallback
		// и легко превышает 90 секунд. Без запаса зачистка убивала бы живой
		// запуск, ждущий ответа модели. Берём максимум из порога heartbeat и
		// удвоенного таймаута LLM плюс сам порог.
		// Запас с большим коэффициентом: heartbeat обновляется раз в шаг, а шаг
		// в файловой ИБ включает вызов LLM с retry/fallback и последовательное
		// выполнение всех tools этого шага. Наблюдалось прерывание живого
		// запуска при коэффициенте 2 - берём 10 таймаутов LLM.
		ЗапасСек = ar_Константы.HeartbeatПорогСек() + 10 * ar_Константы.ТаймаутLLM();

		ГраницаHeartbeat = ТекущаяДатаСеанса() - ЗапасСек;
		ГраницаApproval  = ТекущаяДатаСеанса() - ar_Константы.ПорогОжиданияApprovalСек();

		Зависшие = ar_AuditЗащищённыйРежим.НайтиЗависшиеЗапускиПривилегированно(
			ГраницаHeartbeat, ГраницаApproval);

		Для Каждого RunIdЗависший Из Зависшие Цикл
			// Запуск, открытый в этой же форме, не трогаем: в файловой ИБ цикл
			// идёт синхронно, и повторное открытие диалога во время работы
			// агента иначе прерывало бы живой запуск.
			Если RunIdЗависший = ТекущийRunId Тогда
				Продолжить;
			КонецЕсли;
			ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunIdЗависший, "Прервать");
			ar_СлужебныйЛог.Записать("ar_Диалог.ПрерватьЗависшиеЗапуски", "stale_run_interrupted",
				НСтр("ru = 'Запуск прерван: heartbeat не обновлялся дольше порога';
					|en = 'Run interrupted: heartbeat older than threshold'"),
				"Предупреждение", RunIdЗависший);
		КонецЦикла;
	Исключение
		// Зачистка не должна мешать открытию диалога.
		ar_СлужебныйЛог.Записать("ar_Диалог.ПрерватьЗависшиеЗапуски", "stale_run_cleanup_error",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

КонецПроцедуры

// Сохранённые настройки (агент/провайдер/режим) применяются после
// ПриСозданииНаСервере - перерисовываем композер с актуальными значениями.
//
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	Если РежимБезАгента И НЕ ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
		РежимБезАгента = Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ВыбранныйАгент) И НЕ РежимБезАгента Тогда
		ВыбранныйАгент = ПервыйАктивныйАгент();
	КонецЕсли;

	ПерерисоватьHTML();

КонецПроцедуры

// Предупреждение при закрытии формы с активным запуском.
// При подтверждении таймер отключается, фоновое задание продолжает работу -
// хвост диалога досинхронизируется при следующем открытии (СинхронизироватьХвост).
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ПустаяСтрока(ТекущийRunId)
		ИЛИ ЭтоФинальныйСтатус(СтатусЗапуска) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");
	ТекстПредупреждения = НСтр(
		"ru='Агент продолжит работу в фоне, ответ появится в этом диалоге позже. Закрыть форму?';
		|en='Agent will continue running in background; the reply will appear in this dialog later. Close form?'");

КонецПроцедуры

#КонецОбласти

#Область ДиспетчерHTML

// Обрабатывает клик по любому элементу внутри HTML-чата.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
&НаКлиенте
Процедура ПолеЧатаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	СтандартнаяОбработка = Ложь;

	Действие        = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	// Черновик набранного текста - до любой перерисовки, иначе он потеряется.
	// Для send текст уходит в сообщение, черновик очищается на сервере.
	Если Действие <> "send" Тогда
		ЗапомнитьЧерновикИзDOM();
		// В веб-клиенте DOM недоступен, но JS композера дублирует текущий текст
		// в href ссылки отправки - берём черновик оттуда, иначе при перерисовке
		// (переключение tools, попапы) набранный текст пропадал бы.
		Если ПустаяСтрока(ЧерновикКомпозера) Тогда
			ЗапомнитьЧерновикИзСсылкиОтправки();
		КонецЕсли;
	КонецЕсли;

	Если Действие = "send" Тогда
		ВыполнитьОтправку(ПараметрыСсылки);
	ИначеЕсли Действие = "stop" Тогда
		ВыполнитьОстановку();
	ИначеЕсли Действие = "new-dialog" Тогда
		НовыйДиалогНаСервере();
	ИначеЕсли Действие = "open-dialog" Тогда
		ВыполнитьОткрытиеДиалога(ПараметрыСсылки);
	ИначеЕсли Действие = "delete-dialog" Тогда
		ВыполнитьУдалениеДиалога(ПараметрыСсылки);
	ИначеЕсли Действие = "approve" Тогда
		ВыполнитьApprove(ПараметрыСсылки);
	ИначеЕсли Действие = "approve-all" Тогда
		ВыполнитьApproveВсе();
	ИначеЕсли Действие = "reject" Тогда
		ВыполнитьReject(ПараметрыСсылки);
	ИначеЕсли Действие = "answer" Тогда
		ВыполнитьОтвет(ПараметрыСсылки);
	ИначеЕсли Действие = "select-agent" Тогда
		ВыполнитьВыборАгента(ПараметрыСсылки);
	ИначеЕсли Действие = "select-provider" Тогда
		ВыполнитьВыборПровайдера(ПараметрыСсылки);
	ИначеЕсли Действие = "toggle-tool" Тогда
		ВыполнитьПереключениеTool(ПараметрыСсылки);
	ИначеЕсли Действие = "tools-preset" Тогда
		ВыполнитьПресетTools(ПараметрыСсылки);
	ИначеЕсли Действие = "toggle-tools-popup" Тогда
		ВыполнитьПереключениеПопапаTools();
	ИначеЕсли Действие = "close-tools-popup" Тогда
		ВыполнитьЗакрытиеПопапаTools();
	ИначеЕсли Действие = "toggle-agent-popup" Тогда
		ВыполнитьПереключениеПопапаАгента();
	ИначеЕсли Действие = "open-run" Тогда
		ОткрытьRunViewer();
	ИначеЕсли Действие = "open-queue" Тогда
		ОткрытьФорму("ОбщаяФорма.ar_ОчередьПодтверждений");
	ИначеЕсли Действие = "open-settings" Тогда
		ОткрытьФорму("ОбщаяФорма.ar_Настройки");
	ИначеЕсли Действие = "show-log" Тогда
		ПоказатьСлужебныйЛог();
	ИначеЕсли Действие = "self-check" Тогда
		ЗапуститьСамопроверку();
	ИначеЕсли Действие = "clear-log" Тогда
		ВыполнитьОчисткуЛога();
	ИначеЕсли Действие = "refresh" Тогда
		ПерерисоватьНаСервере();
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Читает значение элемента input/textarea по id из DOM HTML-документа.
// Возвращает Неопределено, если DOM недоступен (веб-клиент) или элемент не найден.
//
&НаКлиенте
Функция ПрочитатьЗначениеИзDOM(Ид)

	Попытка
		ДокументHTML = Элементы.ПолеЧата.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЭлементВвода.value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Сохранить текущий текст композера в реквизит - переживает перерисовку HTML.
//
&НаКлиенте
Процедура ЗапомнитьЧерновикИзDOM()

	Черновик = ПрочитатьЗначениеИзDOM("ar-input");
	Если Черновик <> Неопределено Тогда
		ЧерновикКомпозера = "" + Черновик;
	КонецЕсли;

КонецПроцедуры

// Читает черновик из href ссылки отправки - запасной путь для веб-клиента,
// где DOM HTML-поля недоступен. Текст туда кладёт JS композера (arSetHref).
//
&НаКлиенте
Процедура ЗапомнитьЧерновикИзСсылкиОтправки()

	Попытка
		ДокументHTML = Элементы.ПолеЧата.Документ;
		Если ДокументHTML = Неопределено Тогда
			Возврат;
		КонецЕсли;
		СсылкаОтправки = ДокументHTML.getElementById("ar-send-link");
		Если СсылкаОтправки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Href = "" + СсылкаОтправки.getAttribute("href");
	Исключение
		Возврат;
	КонецПопытки;

	// Имя переменной НЕ "Параметры": так называется свойство формы, и
	// присваивание ему даёт рантайм-ошибку "Object field is not writable
	// (Параметры)", которую валидаторы не ловят.
	ПараметрыСсылкиОтправки = ПараметрыИзСсылки(Href);
	ЗначениеИзСсылки = "";
	Если НЕ ПараметрыСсылкиОтправки.Свойство("text", ЗначениеИзСсылки)
		ИЛИ ПустаяСтрока(ЗначениеИзСсылки) Тогда
		Возврат;
	КонецЕсли;

	Раскодированный = РаскодироватьURLНаСервере(ЗначениеИзСсылки);
	Если Раскодированный <> Неопределено Тогда
		ЧерновикКомпозера = Раскодированный;
	КонецЕсли;

КонецПроцедуры

// Раскодирует URL-кодированную строку. Вынесено на сервер: СпособКодированияСтроки
// в клиентском контексте не определён.
//
// Возвращаемое значение:
//  Строка - раскодированный текст, либо Неопределено при ошибке кодировки.
//
&НаСервереБезКонтекста
Функция РаскодироватьURLНаСервере(Знач Значение)

	Попытка
		Возврат РаскодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ДействияКлиент

// Отправить сообщение: текст читается из DOM-поля композера.
//
&НаКлиенте
Процедура ВыполнитьОтправку(ПараметрыСсылки = Неопределено)

	// Приоритет - текст, пришедший в самой ссылке (его кладёт JS композера,
	// см. arSetHref): это единственный путь, работающий в веб-клиенте, где
	// Элементы.ПолеЧата.Документ недоступен и ПрочитатьЗначениеИзDOM всегда
	// возвращает Неопределено. Черновик наполняется той же DOM-функцией,
	// поэтому в вебе он не был заменой - отправка уходила с пустым текстом.
	// Раскодирование выполняется на сервере: СпособКодированияСтроки - серверный
	// тип, в клиентском контексте он не определён (проверено на веб-клиенте:
	// "Variable is not defined (СпособКодированияСтроки)").
	Текст = Неопределено;
	Если ТипЗнч(ПараметрыСсылки) = Тип("Структура") Тогда
		ЗначениеИзСсылки = "";
		Если ПараметрыСсылки.Свойство("text", ЗначениеИзСсылки)
			И НЕ ПустаяСтрока(ЗначениеИзСсылки) Тогда
			Текст = РаскодироватьURLНаСервере(ЗначениеИзСсылки);
		КонецЕсли;
	КонецЕсли;

	Если Текст = Неопределено Тогда
		Текст = ПрочитатьЗначениеИзDOM("ar-input");
	КонецЕсли;
	Если Текст = Неопределено Тогда
		// DOM недоступен (веб-клиент) - fallback на последний черновик.
		Текст = ЧерновикКомпозера;
	КонецЕсли;
	Текст = СокрЛП("" + Текст);

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Успех = ОтправитьНаСервере(Текст);
	Если Успех Тогда
		ЗапуститьТаймер(1);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОстановку()

	Если ПустаяСтрока(ТекущийRunId) Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");
	ОстановитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОткрытиеДиалога(ПараметрыСсылки)

	Ид = "";
	ПараметрыСсылки.Свойство("id", Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");
	АктивныйЗапуск = ОткрытьДиалогНаСервере(Ид);

	Если АктивныйЗапуск Тогда
		ЗапуститьТаймер(1);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУдалениеДиалога(ПараметрыСсылки)

	Ид = "";
	ПараметрыСсылки.Свойство("id", Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("УдалениеДиалогаЗавершение", ЭтотОбъект, Ид);
	ПоказатьВопрос(Оповещение,
		НСтр("ru='Удалить диалог и его сообщения?'; en='Delete this dialog and its messages?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Продолжение удаления диалога после подтверждения пользователем.
//
&НаКлиенте
Процедура УдалениеДиалогаЗавершение(РезультатВопроса, Ид) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УдалитьДиалогНаСервере(Ид);

КонецПроцедуры

// Очистить все служебные регистры/справочники расширения (UI-22, перенесено
// из ar_ДиалогOld) - необратимо, с диалогом подтверждения.
//
&НаКлиенте
Процедура ВыполнитьОчисткуЛога()

	Оповещение = Новый ОписаниеОповещения("ОчисткаЛогаЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru='Очистить все служебные данные расширения? Действие необратимо.';
			|en='Clear all extension service data? This cannot be undone.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Продолжение очистки служебного лога после подтверждения пользователем.
//
&НаКлиенте
Процедура ОчисткаЛогаЗавершение(РезультатВопроса, ДопПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ОчиститьСлужебныеДанныеНаСервере();

	Если Результат.Успех Тогда
		ТекстОповещения = СтрШаблон(
			НСтр("ru='Служебные данные очищены. Удалено записей: %1';
				|en='Service data cleared. Deleted rows: %1'"),
			Результат.ВсегоУдалено);
		ПоказатьОповещениеПользователя(ТекстОповещения);
	Иначе
		// Подробности ошибок - только в audit-событии AuditPurged (пишет сервер),
		// пользователю - краткая сводка без стека вызовов.
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru='Очистка завершена с ошибками (%1 из %2 источников). Удалено записей: %3. Подробности - в служебном логе.';
				|en='Cleanup finished with errors (%1 of %2 sources). Deleted rows: %3. See service log for details.'"),
			Результат.КоличествоОшибок,
			Результат.ВсегоИсточников,
			Результат.ВсегоУдалено);
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьApprove(ПараметрыСсылки)

	Ид = "";
	ПараметрыСсылки.Свойство("id", Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат;
	КонецЕсли;

	ApproveНаСервере(Ид);
	ЗапуститьТаймер(1);

КонецПроцедуры

// Разрешить все pending-действия текущего запуска одним кликом (см. кнопку
// «Разрешить все (N)» в HTMLЛента) - типовой сценарий, когда модель выдаёт
// несколько однотипных commit-действий подряд (например, акты сверки по
// списку контрагентов) и подтверждать их по одной оператору неудобно.
//
&НаКлиенте
Процедура ВыполнитьApproveВсе()

	ApproveВсеНаСервере();
	ЗапуститьТаймер(1);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьReject(ПараметрыСсылки)

	Ид = "";
	ПараметрыСсылки.Свойство("id", Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат;
	КонецЕсли;

	Причина = ПрочитатьЗначениеИзDOM("ar-reject-" + Ид);
	Если Причина = Неопределено Тогда
		Причина = "";
	КонецЕсли;

	RejectНаСервере(Ид, "" + Причина);
	ЗапуститьТаймер(1);

КонецПроцедуры

// Ответ на вопрос ask_user: либо клик по кнопке варианта (параметр c - индекс),
// либо свободный текст из DOM-поля карточки.
//
&НаКлиенте
Процедура ВыполнитьОтвет(ПараметрыСсылки)

	Ид = "";
	ПараметрыСсылки.Свойство("id", Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат;
	КонецЕсли;

	ИндексВарианта = -1;
	ИндексСтрока   = "";
	Если ПараметрыСсылки.Свойство("c", ИндексСтрока) Тогда
		ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
		ИндексВарианта = ОписаниеТипаЧисло.ПривестиЗначение(ИндексСтрока);
	КонецЕсли;

	ТекстСвободный = "";
	Если ИндексВарианта < 0 Тогда
		Значение = ПрочитатьЗначениеИзDOM("ar-answer-input");
		Если Значение <> Неопределено Тогда
			ТекстСвободный = СокрЛП("" + Значение);
		КонецЕсли;
		Если ПустаяСтрока(ТекстСвободный) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОтветитьНаСервере(Ид, ИндексВарианта, ТекстСвободный);
	ЗапуститьТаймер(1);

КонецПроцедуры

