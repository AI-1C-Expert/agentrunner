// Наименование провайдера LLM, назначенного агенту по умолчанию (реквизит
// ar_Агенты.ar_LLMПровайдер) - для отображения в попапе оверрайда провайдера
// (UI-01/6). Пустая строка, если у агента провайдер не задан.
//
&НаСервереБезКонтекста
Функция ПровайдерАгентаПоУмолчанию(Знач СсылкаАгент)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", СсылкаАгент);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.ar_LLMПровайдер.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
