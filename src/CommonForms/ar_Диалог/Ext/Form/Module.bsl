		+ "border-radius:8px;padding:7px 12px;font-size:12px;}"
		+ ".ar-composer-box{max-width:760px;margin:0 auto;background:#fff;border:1px solid #d8d5c8;"
		+ "border-radius:14px;padding:10px;box-shadow:0 2px 8px rgba(0,0,0,0.04);}"
