		+ ".ar-pop-item{display:block;border-radius:6px;padding:6px 8px;font-size:12px;"
		+ "white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}"
		+ ".ar-pop-item:hover{background:#f0eee6;}"
		+ ".ar-pop-item-alt{border-top:1px solid #eeece4;margin-top:4px;padding-top:8px;}"
		+ ".ar-pop-caption{font-size:11px;color:#8a8778;padding:6px 8px 2px 8px;}"
		// UI-31: попап инструментов - шире обычного, пункты двухстрочные.
		+ ".ar-pop-tools{min-width:340px;max-width:420px;max-height:380px;}"
		+ ".ar-pop-group{font-size:10px;font-weight:600;text-transform:uppercase;"
		+ "letter-spacing:.04em;color:#a3a091;padding:8px 8px 3px 8px;}"
		+ ".ar-pop-actions{display:flex;flex-wrap:wrap;gap:4px;padding:2px 4px 6px 4px;"
		+ "border-bottom:1px solid #eeece4;margin-bottom:2px;}"
		+ ".ar-pop-actions a{font-size:11px;color:#2c5faa;border:1px solid #e3e1d9;"
		+ "border-radius:12px;padding:2px 9px;}"
		+ ".ar-pop-actions a:hover{background:#e8f0fb;}"
		// Кнопка закрытия попапа инструментов прижата вправо (margin-left:auto,
		// а не спейсер: при flex-wrap пустой спейсер занимал бы отдельную строку)
		// и окрашена нейтрально, чтобы не читалась как ещё один пресет набора.
		+ ".ar-pop-close{margin-left:auto;color:#6d6a5c;}"
		+ ".ar-pop-close:hover{background:#f0eee6;}"
		+ ".ar-tool-item{display:flex;gap:7px;align-items:flex-start;border-radius:6px;"
		+ "padding:6px 8px;font-size:12px;}"
		+ ".ar-tool-item:hover{background:#f0eee6;}"
		+ ".ar-tool-on{background:#f5f8fd;}"
		+ ".ar-tool-on:hover{background:#e8f0fb;}"
		+ ".ar-tool-box{flex:none;font-size:14px;line-height:1.2;color:#2c5faa;}"
		+ ".ar-tool-body{display:block;min-width:0;flex:1;}"
		+ ".ar-tool-head{display:flex;flex-wrap:wrap;gap:5px;align-items:center;}"
		+ ".ar-tool-title{font-weight:600;color:#2f2c22;}"
		+ ".ar-tool-desc{display:block;color:#6d6a5c;line-height:1.35;margin-top:2px;}"
		+ ".ar-tool-id{display:block;font-family:Consolas,Menlo,monospace;font-size:10px;"
		+ "color:#a3a091;margin-top:2px;}"
		+ ".ar-risk-appr{background:#f0eafa;color:#6b3fa0;}"
		// Таблицы Markdown в ответах агента.
		+ ".ar-md-table{border-collapse:collapse;margin:6px 0;font-size:12px;max-width:100%;}"
		+ ".ar-md-table th,.ar-md-table td{border:1px solid #d8d5c8;padding:4px 8px;text-align:left;}"
		+ ".ar-md-table th{background:#faf9f4;font-weight:600;color:#2f2c22;}";

	JS =
		"var arFeed=document.getElementById('ar-feed');"
		+ "if(arFeed){arFeed.scrollTop=arFeed.scrollHeight;}"
		+ "var arInput=document.getElementById('ar-input');"
		// Текст композера уходит в 1С через href ссылки отправки: чтение
		// Элементы.ПолеЧата.Документ работает только в толстом клиенте, в
		// веб-клиенте оно возвращает Неопределено (см. ПрочитатьЗначениеИзDOM),
		// и без этого проброса send уходил бы с пустым текстом.
		+ "var arSetHref=function(){"
		+ "var l=document.getElementById('ar-send-link');"
		+ "if(l&&arInput){l.setAttribute('href','1c://send?text='+encodeURIComponent(arInput.value));}"
		+ "};"
		+ "if(arInput){"
		+ "arInput.focus();"
		+ "try{arInput.selectionStart=arInput.value.length;arInput.selectionEnd=arInput.value.length;}catch(e){}"
		+ "arSetHref();"
		+ "arInput.addEventListener('input',arSetHref);"
		+ "arInput.addEventListener('keydown',function(e){"
		+ "if(e.key==='Enter'&&!e.shiftKey){"
		+ "var lnk=document.getElementById('ar-send-link');"
		+ "if(lnk){e.preventDefault();arSetHref();lnk.click();}"
		+ "}});"
		+ "}";

	Возврат "<!DOCTYPE html><html><head><meta charset=""utf-8""><style>"
		+ CSS + "</style></head><body>"
		+ Содержимое
		+ "<script>" + JS + "</script>"
		+ "</body></html>";

КонецФункции

#КонецОбласти

#Область HTMLУтилиты

// Экранировать спецсимволы HTML (тот же контракт, что в ar_Настройки/ar_ДиалогOld).
//
&НаСервереБезКонтекста
Функция ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст,      "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

// Экранировать, разметить простой markdown (**жирный**, *курсив*, `код`,
// таблицы) и заменить переносы строк на <br>.
//
&НаСервереБезКонтекста
Функция ТекстВHTML(Знач Текст)

	Результат = РазметитьТаблицыMarkdown(Текст);
	Результат = ЗаменитьПарныйМаркер(Результат, "**", "<strong>", "</strong>");
	Результат = ЗаменитьПарныйМаркер(Результат, "`",  "<code>",   "</code>");
	Результат = ЗаменитьПарныйМаркер(Результат, "*",  "<em>",     "</em>");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");

	Возврат Результат;

КонецФункции

// Находит в тексте блоки markdown-таблиц (строка заголовка, строка-разделитель
// "|---|---|", строки данных - все начинающиеся и заканчивающиеся "|") и
// заменяет их на HTML-таблицу. Остальной текст экранируется как обычно.
// Ячейки экранируются отдельно, поэтому HTML внутри таблицы безопасен.
//
&НаСервереБезКонтекста
Функция РазметитьТаблицыMarkdown(Знач Текст)

	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Результат = "";
	Индекс = 0;
	Количество = Строки.Количество();

	Пока Индекс < Количество Цикл

		СтрокаТекущая = Строки[Индекс];

		Если ЭтоСтрокаТаблицыMarkdown(СтрокаТекущая)
			И Индекс + 1 < Количество
			И ЭтоРазделительТаблицыMarkdown(Строки[Индекс + 1]) Тогда

			НачалоБлока = Индекс;
			СтрокиТаблицы = Новый Массив;
			СтрокиТаблицы.Добавить(РазобратьСтрокуТаблицыMarkdown(СтрокаТекущая));
			Индекс = Индекс + 2; // пропускаем строку-разделитель

			Пока Индекс < Количество И ЭтоСтрокаТаблицыMarkdown(Строки[Индекс]) Цикл
				СтрокиТаблицы.Добавить(РазобратьСтрокуТаблицыMarkdown(Строки[Индекс]));
				Индекс = Индекс + 1;
			КонецЦикла;

			Если НачалоБлока > 0 Тогда
				Результат = Результат + "<br>";
			КонецЕсли;
			Результат = Результат + СобратьHTMLТаблицыMarkdown(СтрокиТаблицы);

		Иначе
			Если Индекс > 0 Тогда
				Результат = Результат + Символы.ПС;
			КонецЕсли;
			Результат = Результат + ЭкранироватьHTML(СтрокаТекущая);
			Индекс = Индекс + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строка похожа на строку markdown-таблицы: после обрезки пробелов начинается
// и заканчивается символом "|", и внутри есть хотя бы один разделитель.
//
&НаСервереБезКонтекста
Функция ЭтоСтрокаТаблицыMarkdown(Знач Строка)

	Обрезано = СокрЛП(Строка);
	Возврат СтрДлина(Обрезано) >= 2
		И Лев(Обрезано, 1) = "|"
		И Прав(Обрезано, 1) = "|";

КонецФункции

// Строка-разделитель заголовка таблицы: "|---|:---:|---|" и т.п. -
// только символы "|", "-", ":" и пробелы.
//
&НаСервереБезКонтекста
Функция ЭтоРазделительТаблицыMarkdown(Знач Строка)

	Обрезано = СокрЛП(Строка);
	Если НЕ ЭтоСтрокаТаблицыMarkdown(Обрезано) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Обрезано) Цикл
		Символ = Сред(Обрезано, Позиция, 1);
		Если Символ <> "|" И Символ <> "-" И Символ <> ":" И Символ <> " " Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Разбирает строку "| a | b | c |" в массив ячеек ["a", "b", "c"].
//
&НаСервереБезКонтекста
Функция РазобратьСтрокуТаблицыMarkdown(Знач Строка)

	Обрезано = СокрЛП(Строка);
	Обрезано = Сред(Обрезано, 2, СтрДлина(Обрезано) - 2); // убрать крайние "|"

	Ячейки = СтрРазделить(Обрезано, "|", Истина);
	Результат = Новый Массив;
	Для Каждого Ячейка Из Ячейки Цикл
		Результат.Добавить(СокрЛП(Ячейка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собирает HTML <table> из массива строк (каждая строка - массив строковых
// ячеек). Первая строка - заголовок (<th>), остальные - данные (<td>).
//
&НаСервереБезКонтекста
Функция СобратьHTMLТаблицыMarkdown(Знач СтрокиТаблицы)

	HTML = "<table class=""ar-md-table"">";

	Если СтрокиТаблицы.Количество() > 0 Тогда
		HTML = HTML + "<thead><tr>";
		Для Каждого Ячейка Из СтрокиТаблицы[0] Цикл
			HTML = HTML + "<th>" + ЭкранироватьHTML(Ячейка) + "</th>";
		КонецЦикла;
		HTML = HTML + "</tr></thead>";
	КонецЕсли;

	HTML = HTML + "<tbody>";
	Для Индекс = 1 По СтрокиТаблицы.Количество() - 1 Цикл
		HTML = HTML + "<tr>";
		Для Каждого Ячейка Из СтрокиТаблицы[Индекс] Цикл
			HTML = HTML + "<td>" + ЭкранироватьHTML(Ячейка) + "</td>";
		КонецЦикла;
		HTML = HTML + "</tr>";
	КонецЦикла;
	HTML = HTML + "</tbody></table>";

	Возврат HTML;

КонецФункции

// Заменить парные вхождения маркера открывающим/закрывающим HTML-тегом.
// Непарное последнее вхождение остаётся в тексте как есть.
//
&НаСервереБезКонтекста
Функция ЗаменитьПарныйМаркер(Знач Текст, Знач Маркер, Знач ТегОткрытия, Знач ТегЗакрытия)

	ДлинаМаркера = СтрДлина(Маркер);

	КоличествоВхождений = 0;
	Остаток = Текст;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, Маркер);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		КоличествоВхождений = КоличествоВхождений + 1;
		Остаток = Сред(Остаток, Позиция + ДлинаМаркера);
	КонецЦикла;

	Если КоличествоВхождений < 2 Тогда
		Возврат Текст;
	КонецЕсли;

	ВхожденийДляЗамены = КоличествоВхождений;
	Если КоличествоВхождений % 2 <> 0 Тогда
		ВхожденийДляЗамены = КоличествоВхождений - 1;
	КонецЕсли;

	Результат  = "";
	Остаток    = Текст;
	Обработано = 0;
	ОткрывающийНайден = Ложь;

	Пока Обработано < ВхожденийДляЗамены Цикл

		Позиция = СтрНайти(Остаток, Маркер);
		Результат = Результат + Лев(Остаток, Позиция - 1);

		Если ОткрывающийНайден Тогда
			Результат = Результат + ТегЗакрытия;
		Иначе
			Результат = Результат + ТегОткрытия;
		КонецЕсли;
		ОткрывающийНайден = НЕ ОткрывающийНайден;

		Остаток    = Сред(Остаток, Позиция + ДлинаМаркера);
		Обработано = Обработано + 1;

	КонецЦикла;

	Возврат Результат + Остаток;

КонецФункции

// Извлекает имя действия из служебной ссылки "1c://<действие>?<параметры>".
//
&НаКлиентеНаСервереБезКонтекста
Функция ДействиеИзСсылки(Знач Ссылка)

	Тело = Сред(Ссылка, СтрДлина("1c://") + 1);
	ПозицияВопроса = СтрНайти(Тело, "?");
	Если ПозицияВопроса > 0 Тогда
		Тело = Лев(Тело, ПозицияВопроса - 1);
	КонецЕсли;
	Возврат СокрЛП(Тело);

КонецФункции

// Разбирает query-параметры служебной ссылки в структуру { имя -> значение }.
// URL-декодирование не применяется: в ссылках только служебные идентификаторы
// (UUID, snake_case-имена, индексы) без спецсимволов - значения полей ввода
// читаются из DOM, а не из ссылки (см. ar_Настройки).
//
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыИзСсылки(Знач Ссылка)

	Результат = Новый Структура;
	ПозицияВопроса = СтрНайти(Ссылка, "?");
	Если ПозицияВопроса = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = Сред(Ссылка, ПозицияВопроса + 1);
	Пары = СтрРазделить(Хвост, "&", Ложь);
	Для Каждого Пара Из Пары Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Пара, ПозицияРавно - 1);
		Значение = Сред(Пара, ПозицияРавно + 1);
		Если НЕ ПустаяСтрока(Имя) Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
