////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_ПроизводительностьИнструментов («Производительность инструментов») - PERF-05.
//
// Автообнаружение медленных tools по фактическим вызовам за период: максимум и
// 95-й перцентиль длительности (основной ориентир - см. .docs/specs/PERF-05.md,
// "Принципиальное требование: не среднее"), медиана и среднее (справочно),
// доля вызовов, завершившихся ошибкой, и (если доступна подсистема БСП «Оценка
// производительности») среднее время на строку результата.
//
// Источник - РегистрСведений.ar_ДействияАгента (PERF-04): есть всегда, не
// зависит от включённости замеров БСП. Период определяется через связанный
// РегистрСведений.ar_Запуски.ar_СтартовалВ (у ar_ДействияАгента нет собственной
// даты - регистр непериодический). Записи с ar_ДлительностьМС = 0 ("не
// измерено", PERF-04) исключаются из выборки - иначе они смещают перцентиль
// и среднее в сторону заниженных значений, скрывая реальные выбросы.
//
// 95-й перцентиль считается по фактическим записям (метод ближайшего ранга по
// отсортированной выборке), а не аппроксимацией по среднему/дисперсии -
// выборка вызовов невелика (тысячи записей на tool), точный расчёт дешевле и
// честнее приближения.
//
// Вызовы dry_run (маркер " (dry_run)" в ar_ИмяTool, DISP-03) учитываются
// вместе с обычными вызовами того же tool: реализация исполняется реально и
// длительность измерена по-настоящему, разница лишь в том, коммитится ли
// результат - выбрасывать их из статистики производительности нет причины.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ПериодПоУмолчаниюДней = 7;
	СекундВСутках = 24 * 60 * 60;

	ДатаОкончания = ТекущаяДатаСеанса();
	ДатаНачала = НачалоДня(ДатаОкончания - ПериодПоУмолчаниюДней * СекундВСутках);

	ОбновитьСтатистикуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	ОбновитьСтатистикуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	ОбновитьСтатистикуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьВыполнить(Команда)
	ОбновитьСтатистикуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пересчитывает таблицу статистики за текущий период формы (ДатаНачала/
// ДатаОкончания) и заполняет реквизит формы Статистика.
//
&НаСервере
Процедура ОбновитьСтатистикуНаСервере()

	ГраницаНачала = НачалоДня(ДатаНачала);
	ГраницаОкончания = КонецДня(ДатаОкончания);

	СырыеДанные = ПрочитатьСырыеДействия(ГраницаНачала, ГраницаОкончания);
	СредниеНаСтроку = ПрочитатьСреднееНаСтрокуИзБСП(ГраницаНачала, ГраницаОкончания);

	Статистика.Очистить();

	Для Каждого ГруппаTool Из СгруппироватьПоИнструменту(СырыеДанные) Цикл

		ДлительностиОтсортированные = НовыйМассивОтсортированныхЗначений(ГруппаTool.Значение.Длительности);
		Если ДлительностиОтсортированные.Количество() = 0 Тогда
			Продолжить; // все вызовы tool за период - "не измерено" (ДлительностьМС = 0)
		КонецЕсли;

		ДоляПерцентиля95 = 0.95;
		ДоляМедианы = 0.5;

		МаксМС = ДлительностиОтсортированные[ДлительностиОтсортированные.Количество() - 1];
		Перцентиль95МС = ЗначениеПерцентиля(ДлительностиОтсортированные, ДоляПерцентиля95);
		МедианаМС = ЗначениеПерцентиля(ДлительностиОтсортированные, ДоляМедианы);
		СреднееМС = СреднееАрифметическое(ДлительностиОтсортированные);

		ВызовВсего = ГруппаTool.Значение.Длительности.Количество();
		ПроцентовВЕдинице = 100;
		ЗнаковПослеЗапятойДоли = 1;
		ДоляОшибочныхПроцент = ?(ВызовВсего = 0, 0,
			Окр(ПроцентовВЕдинице * ГруппаTool.Значение.ОшибочныхВызовов / ВызовВсего, ЗнаковПослеЗапятойДоли));

		ПорогСек = ar_Константы.ПорогМедленногоToolСек();
		МиллисекундВСекунде = 1000;

		НоваяСтрока = Статистика.Добавить();
		НоваяСтрока.Инструмент = ГруппаTool.Ключ;
		НоваяСтрока.Источник = ГруппаTool.Значение.Источник;
		НоваяСтрока.Вызовов = ВызовВсего;
		НоваяСтрока.МаксМС = МаксМС;
		НоваяСтрока.Перцентиль95МС = Перцентиль95МС;
		НоваяСтрока.МедианаМС = МедианаМС;
		НоваяСтрока.СреднееМС = СреднееМС;
		НоваяСтрока.ДоляОшибочныхПроцент = ДоляОшибочныхПроцент;
		НоваяСтрока.СреднееНаСтрокуМС = ПредставлениеСреднегоНаСтроку(СредниеНаСтроку, ГруппаTool.Ключ);
		НоваяСтрока.Медленный = (ПорогСек > 0) И (МаксМС > ПорогСек * МиллисекундВСекунде);

	КонецЦикла;

	// DoD: инструмент с выбросом виден первым - сортировка по максимуму убыв.
	Статистика.Сортировать("МаксМС Убыв");

	ИнформацияОБСП = ?(ar_ToolDispatcherПовтИсп.ПодсистемаОценкаПроизводительностиЕсть(),
		НСтр("ru='Ср. время на строку доступно (подсистема «Оценка производительности» найдена).';
			|en='Avg time per row available (""Performance evaluation"" subsystem found).'"),
		НСтр("ru='Подсистема «Оценка производительности» не найдена, колонка недоступна.';
			|en='""Performance evaluation"" subsystem not found, column unavailable.'"));

КонецПроцедуры

// Читает сырые записи ar_ДействияАгента за период, присоединяя момент запуска
// из ar_Запуски (у ar_ДействияАгента нет собственной даты). Записи с
// ar_ДлительностьМС = 0 ("не измерено", PERF-04) исключаются в самом запросе -
// они не должны попадать ни в один из последующих расчётов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяTool, ДлительностьМС, ЗавершёнСОшибкой.
//
&НаСервереБезКонтекста
Функция ПрочитатьСырыеДействия(Знач ГраницаНачала, Знач ГраницаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДействияАгента.ar_ИмяTool КАК ИмяTool,
		|	ДействияАгента.ar_ДлительностьМС КАК ДлительностьМС,
		|	ДействияАгента.ar_ЗавершёнСОшибкой КАК ЗавершёнСОшибкой
		|ИЗ
		|	РегистрСведений.ar_ДействияАгента КАК ДействияАгента
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
		|		ПО ДействияАгента.ar_RunId = Запуски.ar_RunId
		|ГДЕ
		|	ДействияАгента.ar_ДлительностьМС > 0
		|	И Запуски.ar_СтартовалВ МЕЖДУ &ГраницаНачала И &ГраницаОкончания";
	Запрос.УстановитьПараметр("ГраницаНачала", ГраницаНачала);
	Запрос.УстановитьПараметр("ГраницаОкончания", ГраницаОкончания);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Группирует сырые записи по нормализованному имени tool (без маркера
// " (dry_run)", DISP-03 - dry_run и обычные вызовы одного tool считаются
// вместе, см. шапку модуля) и определяет "Источник" (Ядро / Пакет <ns>) по
// Справочник.ar_Tools.
//
// Возвращаемое значение:
//  Соответствие - Ключ: имя tool (Строка), Значение: Структура
//  {Длительности: Массив из Число, ОшибочныхВызовов: Число, Источник: Строка}.
//
&НаСервереБезКонтекста
Функция СгруппироватьПоИнструменту(Знач СырыеДанные)

	Группы = Новый Соответствие;

	Для Каждого Строка Из СырыеДанные Цикл

		ИмяTool = НормализованноеИмяTool(Строка.ИмяTool);
		Если ПустаяСтрока(ИмяTool) Тогда
			Продолжить;
		КонецЕсли;

		Группа = Группы.Получить(ИмяTool);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Длительности, ОшибочныхВызовов, Источник",
				Новый Массив, 0, "");
			Группы.Вставить(ИмяTool, Группа);
		КонецЕсли;

		Группа.Длительности.Добавить(Строка.ДлительностьМС);
		Если Строка.ЗавершёнСОшибкой = Истина Тогда
			Группа.ОшибочныхВызовов = Группа.ОшибочныхВызовов + 1;
		КонецЕсли;

	КонецЦикла;

	// Источник (Ядро / Пакет <ns>) - отдельным пакетным запросом по всем
	// именам сразу, не по одному на группу.
	ЗаполнитьИсточникиГрупп(Группы);

	Возврат Группы;

КонецФункции

// Отрезает маркер " (dry_run)" (см. ar_ToolDispatcher.ЗаписатьДействиеЖурнал),
// которым помечается ar_ИмяTool чистых dry_run-вызовов.
//
&НаСервереБезКонтекста
Функция НормализованноеИмяTool(Знач ИмяИзЖурнала)

	Имя = СокрЛП(ИмяИзЖурнала);
	Суффикс = " (dry_run)";
	Если СтрЗаканчиваетсяНа(Имя, Суффикс) Тогда
		Имя = Сред(Имя, 1, СтрДлина(Имя) - СтрДлина(Суффикс));
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Дозаполняет поле "Источник" каждой группы по Справочник.ar_Tools одним
// запросом (без цикла запросов по группам).
//
&НаСервереБезКонтекста
Процедура ЗаполнитьИсточникиГрупп(Знач Группы)

	Имена = Новый Массив;
	Для Каждого Элемент Из Группы Цикл
		Имена.Добавить(Элемент.Ключ);
	КонецЦикла;
	Если Имена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_ИсточникТип КАК ИсточникТип,
		|	Tools.ar_Namespace КАК Namespace
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя В (&Имена)";
	Запрос.УстановитьПараметр("Имена", Имена);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ИсточникТип = СокрЛП(Выборка.ИсточникТип);
		Namespace = СокрЛП(Выборка.Namespace);
		Источник = ?(ИсточникТип = "Пакет" И Не ПустаяСтрока(Namespace), "Пакет " + Namespace, "Ядро");

		Группа = Группы.Получить(СокрЛП(Выборка.Имя));
		Если Группа <> Неопределено Тогда
			Группа.Источник = Источник;
		КонецЕсли;

	КонецЦикла;

	// tool, отсутствующий в справочнике (например удалённая карточка, но
	// действия в журнале остались) - источник по умолчанию "Ядро", чтобы
	// колонка не оставалась пустой.
	Для Каждого Элемент Из Группы Цикл
		Если ПустаяСтрока(Элемент.Значение.Источник) Тогда
			Элемент.Значение.Источник = "Ядро";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Копирует массив чисел во временную ТаблицаЗначений с одной числовой
// колонкой и сортирует по возрастанию - платформенный Сортировать() коллекции
// сравнивает фактические значения колонки (а не строковое представление),
// поэтому числовой порядок корректен без написания функции сравнения.
//
// Возвращаемое значение:
//  Массив из Число - значения по возрастанию.
//
&НаСервереБезКонтекста
Функция НовыйМассивОтсортированныхЗначений(Знач Значения)

	Если Значения.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Временная = Новый ТаблицаЗначений;
	Временная.Колонки.Добавить("Мс");
	Для Каждого Значение Из Значения Цикл
		Временная.Добавить().Мс = Значение;
	КонецЦикла;
	Временная.Сортировать("Мс Возр");

	Результат = Новый Массив;
	Для Каждого Строка Из Временная Цикл
		Результат.Добавить(Строка.Мс);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Значение перцентиля по отсортированной по возрастанию выборке - метод
// ближайшего ранга (nearest rank): индекс = Окр((N-1) * Доля), 0-индексация.
// Для Доля = 0.95 - 95-й перцентиль, для 0.5 - медиана.
//
// Параметры:
//  ОтсортированныеЗначения - Массив из Число - непустой, по возрастанию.
//  Доля                    - Число - от 0 до 1.
//
&НаСервереБезКонтекста
Функция ЗначениеПерцентиля(Знач ОтсортированныеЗначения, Знач Доля)

	Количество = ОтсортированныеЗначения.Количество();
	Если Количество = 1 Тогда
		Возврат ОтсортированныеЗначения[0];
	КонецЕсли;

	Индекс = Окр((Количество - 1) * Доля);
	Индекс = Макс(0, Мин(Индекс, Количество - 1));
	Возврат ОтсортированныеЗначения[Индекс];

КонецФункции

// Среднее арифметическое непустого массива чисел.
//
&НаСервереБезКонтекста
Функция СреднееАрифметическое(Знач Значения)

	Сумма = 0;
	Для Каждого Значение Из Значения Цикл
		Сумма = Сумма + Значение;
	КонецЦикла;
	Возврат Окр(Сумма / Значения.Количество());

КонецФункции

// PERF-05, "Что делаем" п.2: если подсистема БСП «Оценка производительности»
// доступна - читает РегистрСведений.ЗамерыВремениТехнологические за период и
// считает среднее время на строку (Сумма(ВремяВыполнения) / Сумма(ВесЗамера))
// по КлючеваяОперация = "ar_Tool_<ИмяTool>" (см. ar_ToolDispatcher.Вызвать,
// шаг 5/8). Текст запроса собран строкой (не статическая ссылка на объект
// метаданных): на конфигурациях без этой подсистемы регистр физически
// отсутствует в целевой метамодели, и статическая ссылка не скомпилировалась
// бы при загрузке расширения в такую базу.
//
// Best-effort и не участвует в DoD-обязательных колонках (максимум/перцентиль/
// медиана/доля ошибочных) - при любой ошибке возвращает пустое соответствие,
// колонка "Ср. время на строку" останется прочерком.
//
// Возвращаемое значение:
//  Соответствие - Ключ: имя tool (Строка), Значение: Число (мс на строку).
//
&НаСервереБезКонтекста
Функция ПрочитатьСреднееНаСтрокуИзБСП(Знач ГраницаНачала, Знач ГраницаОкончания)

	Результат = Новый Соответствие;

	Если Не ar_ToolDispatcherПовтИсп.ПодсистемаОценкаПроизводительностиЕсть() Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	Замеры.КлючеваяОперация КАК КлючеваяОперация,
			|	СУММА(Замеры.ВремяВыполнения) КАК СуммаВремени,
			|	СУММА(Замеры.ВесЗамера) КАК СуммаВеса
			|ИЗ
			|	РегистрСведений.ЗамерыВремениТехнологические КАК Замеры
			|ГДЕ
			|	Замеры.ДатаНачалаЗамера МЕЖДУ &ГраницаНачала И &ГраницаОкончания
			|	И Замеры.КлючеваяОперация ПОДОБНО ""ar_Tool_%""
			|	И Замеры.ВесЗамера > 0
			|
			|СГРУППИРОВАТЬ ПО
			|	Замеры.КлючеваяОперация";

		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ГраницаНачала", ГраницаНачала);
		Запрос.УстановитьПараметр("ГраницаОкончания", ГраницаОкончания);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл

			СуммаВеса = ?(ТипЗнч(Выборка.СуммаВеса) = Тип("Число"), Выборка.СуммаВеса, 0);
			СуммаВремени = ?(ТипЗнч(Выборка.СуммаВремени) = Тип("Число"), Выборка.СуммаВремени, 0);
			Если СуммаВеса = 0 Тогда
				Продолжить;
			КонецЕсли;

			ИмяTool = Сред(Выборка.КлючеваяОперация, СтрДлина("ar_Tool_") + 1);
			Результат.Вставить(ИмяTool, Окр(СуммаВремени / СуммаВеса, 1));

		КонецЦикла;

	Исключение
		// Best-effort (см. комментарий к функции) - сбой не должен ронять
		// отчёт, работающий и без подсистемы БСП.
		ЗаписьЖурналаРегистрации(
			"AgentRunner.ar_ПроизводительностьИнструментов.ПрочитатьСреднееНаСтрокуИзБСП",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Соответствие;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Текстовое представление среднего времени на строку для колонки таблицы -
// прочерк, если данных БСП по этому tool за период нет.
//
&НаСервереБезКонтекста
Функция ПредставлениеСреднегоНаСтроку(Знач СредниеНаСтроку, Знач ИмяTool)

	Значение = СредниеНаСтроку.Получить(ИмяTool);
	Если Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Возврат Формат(Значение, "ЧЦ=0; ЧДД=1; ЧГ=0");

КонецФункции

#КонецОбласти
