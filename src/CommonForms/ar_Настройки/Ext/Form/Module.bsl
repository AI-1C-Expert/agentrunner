////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_Настройки («Настройки AgentRunner») - SCHED-06 + панель настроек.
//
// Единая HTML-панель настроек расширения AgentRunner. Вся форма - одно поле
// ПолеHTMLДокумента (ПолеHTMLНастройки), в котором сервер собирает четыре секции:
//   1) баннер обновления (если доступна новая версия);
//   2) диагностику планировщика (статусы регламентных заданий AgentRunner);
//   3) редактируемые настройки-константы (18 шт.), сгруппированные по разделам;
//   4) кнопки-переходы к спискам реестров (провайдеры, tools, skills и т.д.).
//
// Обратная связь HTML -> BSL реализована штатным событием поля ПриНажатии:
// каждый интерактивный элемент - это ссылка вида "1c://<действие>?<параметры>".
// При клике href приходит в ДанныеСобытия.Href (эталон БСП
// ВзаимодействияКлиент.ПолеHTMLПриНажатии), стандартная обработка подавляется,
// а BSL разбирает схему и выполняет действие (сохранить константу, открыть список,
// обновить диагностику и т.п.). Значения полей ввода читаются из DOM
// (Элементы.ПолеHTMLНастройки.Документ.getElementById) - это работает в толстом
// клиенте; в веб-клиенте DOM-доступ деградирует, поэтому чтение обёрнуто в Попытку.
//
// Логика SCHED-06 (диагностика планировщика, проверка обновлений, снуз) сохранена -
// изменился только способ отрисовки (BSL-поля -> HTML-секции).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ветка автотеста: при программном открытии формы тестами пропускаем
	// инициализацию (единый паттерн форм расширения).
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ПерерисоватьПанельНастроек();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Обрабатывает клик по любому элементу внутри HTML-панели настроек.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент             - ПолеФормы - поле ПолеHTMLНастройки.
//  ДанныеСобытия       - ФиксированнаяСтруктура - данные DOM-события клика
//                        (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                        открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLНастройкиПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	// Дальше ссылку обрабатываем сами.
	СтандартнаяОбработка = Ложь;

	Действие = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	Если Действие = "save" Тогда
		ОбработатьСохранениеПоля(ПараметрыСсылки);
	ИначеЕсли Действие = "toggle" Тогда
		ОбработатьПереключение(ПараметрыСсылки);
	ИначеЕсли Действие = "open" Тогда
		ОткрытьСписокРеестра(ПараметрыСсылки);
	ИначеЕсли Действие = "pick-user" Тогда
		ВыбратьСлужебногоПользователя();
	ИначеЕсли Действие = "refresh" Тогда
		ПерерисоватьПанельНастроекНаСервере();
	ИначеЕсли Действие = "open-url" Тогда
		ОткрытьСайтОбновления();
	ИначеЕсли Действие = "snooze" Тогда
		ОтложитьУведомлениеОбОбновлении();
	ИначеЕсли Действие = "packages-open" Тогда
		ОткрытьПакетыTools();
	ИначеЕсли Действие = "tool-perf-open" Тогда
		ОткрытьПроизводительностьИнструментов();
	ИначеЕсли Действие = "code-tools-log-open" Тогда
		ОткрытьЛогОтключенияCodeTools();
	ИначеЕсли Действие = "access-rules-log-open" Тогда
		ОткрытьЛогРасширенияПравToolAccessRules();
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаДействийКлиента

// Считывает значение поля ввода из DOM HTML-документа и сохраняет константу.
// Ключ (имя константы) передан в ссылке, значение читается из элемента input/textarea
// с id, равным ключу.
//
&НаКлиенте
Процедура ОбработатьСохранениеПоля(ПараметрыСсылки)

	Ключ = "";
	ПараметрыСсылки.Свойство("key", Ключ);
	Если ПустаяСтрока(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Значение = ПрочитатьЗначениеИзDOM(Ключ);
	Если Значение = Неопределено Тогда
		// DOM недоступен (веб-клиент) - значение могло прийти прямо в ссылке.
		ПараметрыСсылки.Свойство("value", Значение);
	КонецЕсли;

	СтатусСохранения = СохранитьНастройкуНаСервере(Ключ, "" + Значение);
	ПерерисоватьПанельНастроекНаСервере(СтатусСохранения);

КонецПроцедуры

// Переключает булеву константу (инвертирует текущее значение) и перерисовывает панель.
//
&НаКлиенте
Процедура ОбработатьПереключение(ПараметрыСсылки)

	Ключ = "";
	ПараметрыСсылки.Свойство("key", Ключ);
	Если ПустаяСтрока(Ключ) Тогда
		Возврат;
	КонецЕсли;

	СтатусСохранения = ПереключитьБулевуНастройкуНаСервере(Ключ);
	ПерерисоватьПанельНастроекНаСервере(СтатусСохранения);

КонецПроцедуры

// Читает значение элемента input/textarea/select по id из DOM HTML-документа.
// Возвращает Неопределено, если DOM-доступ недоступен (веб-клиент) или элемент не найден.
//
&НаКлиенте
Функция ПрочитатьЗначениеИзDOM(Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLНастройки.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЭлементВвода.value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Открывает штатную форму списка реестра по логическому имени из ссылки.
//
&НаКлиенте
Процедура ОткрытьСписокРеестра(ПараметрыСсылки)

	Список = "";
	ПараметрыСсылки.Свойство("list", Список);
	Если ПустаяСтрока(Список) Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяФормы = ИмяФормыСпискаРеестра(Список);
	Если ПустаяСтрока(ПолноеИмяФормы) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФорму(ПолноеИмяФормы, , ЭтотОбъект);

КонецПроцедуры

// Открывает общую форму управления пакетами инструментов (PKG-06).
//
&НаКлиенте
Процедура ОткрытьПакетыTools()

	ОткрытьФорму("ОбщаяФорма.ar_ПакетыTools", , ЭтотОбъект);

КонецПроцедуры

// Открывает общую форму «Производительность инструментов» (PERF-05).
//
&НаКлиенте
Процедура ОткрытьПроизводительностьИнструментов()

	ОткрытьФорму("ОбщаяФорма.ar_ПроизводительностьИнструментов", , ЭтотОбъект);

КонецПроцедуры

// Открывает список служебного лога (SEC-TOOL-02) - переход из баннера
// «Отключено N tools в режиме «Код»» к записям события code_tools_disabled.
// Штатная форма списка регистра, без дополнительного отбора: администратор
// находит нужные записи по колонке ar_Событие самостоятельно (тот же уровень
// навигации, что и у остальных переходов панели настроек - открыть список,
// без предфильтрации).
//
&НаКлиенте
Процедура ОткрытьЛогОтключенияCodeTools()

	ОткрытьФорму("РегистрСведений.ar_СлужебныйЛог.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

// Открывает список служебного лога (SCALE-07) - переход из баннера «Права
// агентов расширены» к записям события tool_access_rules_widened. Штатная
// форма списка регистра, без дополнительного отбора - тот же уровень
// навигации, что и у ОткрытьЛогОтключенияCodeTools выше (прямой прецедент).
//
&НаКлиенте
Процедура ОткрытьЛогРасширенияПравToolAccessRules()

	ОткрытьФорму("РегистрСведений.ar_СлужебныйЛог.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

// Выбор служебного пользователя агентов через стандартный диалог выбора,
// с записью выбранной ссылки в константу.
//
&НаКлиенте
Процедура ВыбратьСлужебногоПользователя()

	Оповещение = Новый ОписаниеОповещения("ВыборСлужебногоПользователяЗавершение", ЭтотОбъект);

	// РежимВыбора + ЗакрытьПриВыборе обязательны, иначе форма списка открывается
	// в обычном режиме просмотра и не возвращает выбранное значение в оповещение.
	// Имя переменной не должно совпадать со свойством формы ПараметрыВыбора -
	// присваивание ему падает с "Type mismatch".
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрытьПриВыборе", Истина);

	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборСлужебногоПользователяЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтатусСохранения = ЗаписатьСлужебногоПользователяНаСервере(ВыбранноеЗначение);
	ПерерисоватьПанельНастроекНаСервере(СтатусСохранения);

КонецПроцедуры

// Открывает браузер на странице релизов AgentRunner.
//
&НаКлиенте
Процедура ОткрытьСайтОбновления()

	Если Не ПустаяСтрока(ХранилищеURL)
		И (СтрНачинаетсяС(ХранилищеURL, "https://") Или СтрНачинаетсяС(ХранилищеURL, "http://")) Тогда
		// ЗапуститьПриложение синхронный и запрещён без модальности.
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ХранилищеURL);
	КонецЕсли;

КонецПроцедуры

// Откладывает показ уведомления об обновлении на 7 дней и перерисовывает панель.
//
&НаКлиенте
Процедура ОтложитьУведомлениеОбОбновлении()

	ЗаписатьСнузНаСервере();
	ПерерисоватьПанельНастроекНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СерверныеДействияЗаписи

// Записывает значение настройки-константы в БД с приведением типа и валидацией.
//
// Параметры:
//  Ключ     - Строка - имя константы ar_* (совпадает с id поля в HTML).
//  Значение - Строка - строковое представление нового значения (из DOM/ссылки).
//
// Возвращаемое значение:
//  Строка - человекочитаемый статус («Сохранено ✓» / текст ошибки валидации).
//
&НаСервереБезКонтекста
Функция СохранитьНастройкуНаСервере(Знач Ключ, Знач Значение)

	КартаТипов = КартаТиповКонстант();
	Если Не КартаТипов.Свойство(Ключ) Тогда
		Возврат НСтр("ru='Неизвестная настройка'; en='Unknown setting'");
	КонецЕсли;

	ТипНастройки = КартаТипов[Ключ];

	Попытка
		Если ТипНастройки = "Число" Тогда
			Число = ПривестиКЧислу(Значение);
			Если Число < 0 Тогда
				Возврат НСтр("ru='Значение не может быть отрицательным'; en='Value cannot be negative'");
			КонецЕсли;
			Константы[Ключ].Установить(Число);
		ИначеЕсли ТипНастройки = "Строка" Тогда
			Если Ключ = "ar_LLM_AllowList_URL" Тогда
				Значение = ОчиститьСхемуURLАллоуЛиста(Значение);
			КонецЕсли;
			Константы[Ключ].Установить(Значение);
		Иначе
			Возврат НСтр("ru='Тип настройки не редактируется здесь'; en='Setting type is not editable here'");
		КонецЕсли;
	Исключение
		ar_СлужебныйЛог.Записать("ar_Настройки", "save_error",
			СтрШаблон("Ключ=%1: %2", Ключ, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())), "Ошибка");
		Возврат НСтр("ru='Ошибка сохранения'; en='Save failed'");
	КонецПопытки;

	ar_СлужебныйЛог.Записать("ar_Настройки", "save_ok", СтрШаблон("Ключ=%1 сохранён", Ключ));

	Возврат НСтр("ru='Сохранено ✓'; en='Saved ✓'");

КонецФункции

// Убирает схему "https://"/"http://" в каждой строке allowlist-хостов перед сохранением.
//
// Параметры:
//  Значение - Строка - многострочный список хостов, как введён пользователем.
//
// Возвращаемое значение:
//  Строка - тот же список с очищенными от схемы строками.
//
&НаСервереБезКонтекста
Функция ОчиститьСхемуURLАллоуЛиста(Знач Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Строки = СтрРазделить(Значение, Символы.ПС, Истина);
	Результат = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Хост = СокрЛП(Строка);
		Если СтрНачинаетсяС(НРег(Хост), "https://") Тогда
			Хост = Сред(Хост, СтрДлина("https://") + 1);
		ИначеЕсли СтрНачинаетсяС(НРег(Хост), "http://") Тогда
			Хост = Сред(Хост, СтрДлина("http://") + 1);
		КонецЕсли;
		Результат.Добавить(Хост);
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

// Инвертирует булеву константу и записывает новое значение.
//
// Параметры:
//  Ключ - Строка - имя булевой константы ar_*.
//
// Возвращаемое значение:
//  Строка - статус сохранения.
//
&НаСервереБезКонтекста
Функция ПереключитьБулевуНастройкуНаСервере(Знач Ключ)

	КартаТипов = КартаТиповКонстант();
	Если Не КартаТипов.Свойство(Ключ) Или КартаТипов[Ключ] <> "Булево" Тогда
		Возврат НСтр("ru='Неизвестная настройка'; en='Unknown setting'");
	КонецЕсли;

	Попытка
		Текущее = Константы[Ключ].Получить();
		НовоеЗначение = Не Текущее;
		Константы[Ключ].Установить(НовоеЗначение);
	Исключение
		ar_СлужебныйЛог.Записать("ar_Настройки", "toggle_error",
			СтрШаблон("Ключ=%1: %2", Ключ, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())), "Ошибка");
		Возврат НСтр("ru='Ошибка сохранения'; en='Save failed'");
	КонецПопытки;

	ar_СлужебныйЛог.Записать("ar_Настройки", "toggle_ok", СтрШаблон("Ключ=%1 переключён", Ключ));

	Возврат НСтр("ru='Сохранено ✓'; en='Saved ✓'");

КонецФункции

// Записывает служебного пользователя агентов (ссылочная константа).
//
&НаСервереБезКонтекста
Функция ЗаписатьСлужебногоПользователяНаСервере(Знач Пользователь)

	Попытка
		Константы.ar_СлужебныйПользовательАгентов.Установить(Пользователь);
	Исключение
		Возврат НСтр("ru='Ошибка сохранения'; en='Save failed'");
	КонецПопытки;

	Возврат НСтр("ru='Сохранено ✓'; en='Saved ✓'");

КонецФункции

// Откладывает уведомление об обновлении на 7 дней (снуз, SCHED-06).
//
&НаСервереБезКонтекста
Процедура ЗаписатьСнузНаСервере()
	ДнейСнузла    = 7;
	СекундВСутках = 86400;
	Константы.ar_ОбновлениеНеНапоминатьДо.Установить(ТекущаяДатаСеанса() + ДнейСнузла * СекундВСутках);
КонецПроцедуры

#КонецОбласти

#Область ПерерисовкаПанели

// Клиентская обёртка перерисовки: перечитывает данные на сервере и обновляет HTML.
//
// Параметры:
//  СтатусСохранения - Строка - необязательный статус последнего действия для показа
//                     в шапке панели (например «Сохранено ✓»).
//
&НаКлиенте
Процедура ПерерисоватьПанельНастроекНаСервере(СтатусСохранения = "")
	ПерерисоватьПанельНастроек(СтатусСохранения);
КонецПроцедуры

// Собирает HTML всех секций панели и кладёт его в реквизит СтрокаHTMLНастройки.
// Здесь же читаются данные диагностики и обновления (как в исходной SCHED-06).
//
&НаСервере
Процедура ПерерисоватьПанельНастроек(СтатусСохранения = "")

	ДанныеОбновления = ПолучитьДанныеОбновления();

	// Кнопка «Перейти на сайт» всегда ведёт на главную страницу сайта,
	// а не на URL релизов из version.json.
	ХранилищеURL = "https://" + ar_Константы.ВерсионныйХост() + "/";

	СтрокаHTMLНастройки = СобратьHTMLНастроек(ДанныеОбновления, СтатусСохранения);

КонецПроцедуры

#КонецОбласти

#Область СборкаHTML

// Собирает полный HTML-документ панели настроек из четырёх секций.
//
// Параметры:
//  ДанныеОбновления - Структура, Неопределено - данные баннера обновления.
//  СтатусСохранения - Строка - статус последнего действия для шапки.
//
// Возвращаемое значение:
//  Строка - готовый HTML-документ для поля ПолеHTMLНастройки.
//
&НаСервере
Функция СобратьHTMLНастроек(Знач ДанныеОбновления, Знач СтатусСохранения)

	Содержимое = "";

	Содержимое = Содержимое + HTMLСекцияШапки(СтатусСохранения);
	Содержимое = Содержимое + HTMLСекцияОбновления(ДанныеОбновления);
	Содержимое = Содержимое + HTMLСекцияДиагностики();
	Содержимое = Содержимое + HTMLСекцияПрофиляКонфигурации();
	Содержимое = Содержимое + HTMLСекцияПакетыTools();
	Содержимое = Содержимое + HTMLСекцияПроизводительностьИнструментов();
	Содержимое = Содержимое + HTMLСекцияCodeToolsОтключены();
	Содержимое = Содержимое + HTMLСекцияToolAccessRulesРасширены();
	Содержимое = Содержимое + HTMLСекцияНастроек();
	Содержимое = Содержимое + HTMLСекцияРеестров();

	Возврат HTMLКаркасНастроек(Содержимое);

КонецФункции

// Секция-шапка: заголовок панели + статус последнего действия.
//
&НаСервере
Функция HTMLСекцияШапки(Знач СтатусСохранения)

	СтатусHTML = "";
	Если Не ПустаяСтрока(СтатусСохранения) Тогда
		СтатусHTML = "<span class=""ar-status"">" + ar_ЭкранироватьHTML(СтатусСохранения) + "</span>";
	КонецЕсли;

	Возврат
		"<div class=""ar-head"">"
		+ "<h1>" + ar_ЭкранироватьHTML(НСтр("ru='Настройки AgentRunner'; en='AgentRunner Settings'")) + "</h1>"
		+ СтатусHTML
		+ "</div>";

КонецФункции

// Секция баннера обновления (показывается только при наличии новой версии).
//
&НаСервере
Функция HTMLСекцияОбновления(Знач ДанныеОбновления)

	Если ДанныеОбновления = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Текст = СтрШаблон(
		НСтр("ru='Доступна новая версия %1.'; en='New version %1 is available.'"),
		ДанныеОбновления.ПоследняяВерсия);

	Возврат
		"<div class=""ar-card ar-banner"">"
		+ "<div class=""ar-banner-text"">🔔 " + ar_ЭкранироватьHTML(Текст) + "</div>"
		+ "<div class=""ar-banner-actions"">"
		+ ССылкаДействие("open-url", "", НСтр("ru='Перейти на сайт'; en='Open website'"), "ar-btn ar-btn-primary")
		+ ССылкаДействие("snooze", "", НСтр("ru='Не напоминать 7 дней'; en='Remind in 7 days'"), "ar-btn")
		+ "</div></div>";

КонецФункции

// Секция диагностики планировщика: карточки статусов регламентных заданий.
// Переиспользует ar_Scheduler.ДиагностикаПланировщика и хелперы представления.
//
&НаСервере
Функция HTMLСекцияДиагностики()

	ДанныеДиагностики = ar_Scheduler.ДиагностикаПланировщика();

	ХудшийСтатус = "ok";
	КоличествоПроблем = 0;
	Карточки = "";

	Для Каждого ЭлементРЗ Из ДанныеДиагностики Цикл

		Если ЭлементРЗ.Статус = "error" Тогда
			ХудшийСтатус = "error";
			КоличествоПроблем = КоличествоПроблем + 1;
		КонецЕсли;
		Если ЭлементРЗ.Статус = "warning" Тогда
			Если ХудшийСтатус <> "error" Тогда
				ХудшийСтатус = "warning";
			КонецЕсли;
			КоличествоПроблем = КоличествоПроблем + 1;
		КонецЕсли;

		Карточки = Карточки
			+ "<div class=""ar-diag-row"">"
			+ "<span class=""ar-badge ar-badge-" + ЭлементРЗ.Статус + """>" + ЗначокСтатуса(ЭлементРЗ.Статус) + "</span>"
			+ "<span class=""ar-diag-text"">" + ar_ЭкранироватьHTML(СтрокаСостоянияРЗ(ЭлементРЗ)) + "</span>"
			+ "</div>";

	КонецЦикла;

	ФайловаяПлашка = "";
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		ФайловаяПлашка =
			"<div class=""ar-note"">"
			+ ar_ЭкранироватьHTML(НСтр("ru='Файловый режим: регламентные задания проверяются раз в 60 секунд и только при открытом клиенте, поэтому статус может отставать от факта.';
				|en='File mode: scheduled jobs are checked every 60 seconds and only while a client is open, so the status may lag behind reality.'"))
			+ "</div>";
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Диагностика планировщика'; en='Scheduler diagnostics'")) + "</h2>"
		+ ССылкаДействие("refresh", "", НСтр("ru='Обновить'; en='Refresh'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ "<div class=""ar-summary ar-summary-" + ХудшийСтатус + """>"
		+ ar_ЭкранироватьHTML(ИтоговоеПредставлениеСтатуса(ХудшийСтатус, КоличествоПроблем)) + "</div>"
		+ ФайловаяПлашка
		+ Карточки
		+ "</div>";

КонецФункции

// Секция профиля целевой конфигурации (UNIV-01): показывает Имя/Версия/Тип
// конфигурации, на которую установлено расширение. Читает
// ar_ПрофильКонфигурации.ОпределитьКонфигурацию() напрямую (не из кэша
// ar_ПрофильКонфигурацииПовтИсп) - секция отрисовывается один раз при сборке
// панели, а не на каждый tool-вызов, кэш здесь неприменим и не нужен на
// границе интерактивной формы.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент карточки профиля конфигурации.
//
&НаСервере
Функция HTMLСекцияПрофиляКонфигурации()

	Конфигурация = ar_ПрофильКонфигурации.ОпределитьКонфигурацию();

	ТекстПредупрежденияНеизвестногоТипа = НСтр(
		"ru='Тип конфигурации не распознан - универсальный слой tools работает,
		|предметные тулы могут быть недоступны.';
		|en='Configuration type not recognized - the universal tools layer works,
		|domain-specific tools may be unavailable.'");

	ПредупреждениеНеизвестногоТипа = "";
	Если Конфигурация.Тип = "Неизвестно" Тогда
		ПредупреждениеНеизвестногоТипа =
			"<div class=""ar-note"">"
			+ ar_ЭкранироватьHTML(ТекстПредупрежденияНеизвестногоТипа)
			+ "</div>";
	КонецЕсли;

	СтрокаПрофиля = СтрШаблон("%1 %2 (%3)",
		?(ЗначениеЗаполнено(Конфигурация.Имя), Конфигурация.Имя, НСтр("ru='?'; en='?'")),
		Конфигурация.Версия,
		Конфигурация.Тип);

	ЗакрывающийТегБлока = "</div>";

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Профиль конфигурации'; en='Configuration profile'")) + "</h2>"
		+ ЗакрывающийТегБлока
		+ "<div class=""ar-diag-row"">"
		+ "<span class=""ar-diag-text"">" + ar_ЭкранироватьHTML(СтрокаПрофиля) + "</span>"
		+ ЗакрывающийТегБлока
		+ ПредупреждениеНеизвестногоТипа
		+ ЗакрывающийТегБлока;

КонецФункции

// Секция «Пакеты инструментов» (PKG-06): статус механизма пакетов
// (Справочник.ДополнительныеОтчетыИОбработки, БСП «Дополнительные отчёты и
// обработки») + ссылка на отдельную форму управления. Сама таблица
// зарегистрированных пакетов и все операции над ними (найти/установить/
// отключить/переподтвердить/проверить изменения) живут в ОбщаяФорма.
// ar_ПакетыTools - здесь только счётчик и переход, чтобы не раздувать и без
// того большую HTML-панель настроек ещё одной интерактивной таблицей.
//
// Если механизм недоступен - показывается причина текстом вместо счётчика,
// действие "packages-open" не предлагается (открывать пока нечего).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент секции «Пакеты инструментов».
//
&НаСервере
Функция HTMLСекцияПакетыTools()

	// Имя переменной не совпадает со свойством формы "Доступность" (Enabled) -
	// присваивание структуры туда падает Type mismatch без диагностики
	// компилятора/валидаторов, обнаружено только при живой загрузке (PKG-06).
	ДоступностьМеханизмаПакетов = ar_ToolПакеты.МеханизмПакетовДоступен();

	Если Не ДоступностьМеханизмаПакетов.Доступен Тогда
		Возврат
			"<div class=""ar-card"">"
			+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Пакеты инструментов'; en='Tool packages'")) + "</h2>"
			+ "<div class=""ar-note"">"
			+ ar_ЭкранироватьHTML(ТекстПричиныНедоступностиПакетов(ДоступностьМеханизмаПакетов.Причина))
			+ "</div>"
			+ "</div>";
	КонецЕсли;

	Сводка = СводкаПакетовTools();

	ТекстСводки = СтрШаблон(
		НСтр("ru='Пакетов зарегистрировано: %1, требуют внимания: %2.';
			|en='Packages registered: %1, need attention: %2.'"),
		Сводка.Зарегистрировано,
		Сводка.ТребуютВнимания);

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Пакеты инструментов'; en='Tool packages'")) + "</h2>"
		+ ССылкаДействие("packages-open", "", НСтр("ru='Открыть'; en='Open'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ "<div class=""ar-diag-row"">"
		+ "<span class=""ar-diag-text"">" + ar_ЭкранироватьHTML(ТекстСводки) + "</span>"
		+ "</div>"
		+ "</div>";

КонецФункции

// Человекочитаемый текст причины недоступности механизма пакетов (PKG-06 D1) -
// те же коды причин, что ar_ToolПакеты.МеханизмПакетовДоступен().Причина.
//
// Параметры:
//  Причина - Строка - код причины: "subsystem_missing" / "functional_option_disabled".
//
// Возвращаемое значение:
//  Строка - человекочитаемый текст.
//
&НаСервереБезКонтекста
Функция ТекстПричиныНедоступностиПакетов(Знач Причина)

	Если Причина = "subsystem_missing" Тогда
		Возврат НСтр(
			"ru='В этой конфигурации нет подсистемы «Дополнительные отчёты и обработки». Механизм
				|пакетов недоступен, остальные инструменты работают.';
			|en='This configuration has no ""Additional reports and data processors"" subsystem. The
				|package mechanism is unavailable, other tools keep working.'");
	ИначеЕсли Причина = "functional_option_disabled" Тогда
		Возврат НСтр(
			"ru='Функциональная опция «Использовать дополнительные отчёты и обработки» выключена.
				|Включите её в настройках программы, чтобы устанавливать пакеты.';
			|en='The ""Use additional reports and data processors"" functional option is disabled.
				|Enable it in the application settings to install packages.'");
	Иначе
		Возврат НСтр("ru='Механизм пакетов недоступен.'; en='Package mechanism unavailable.'");
	КонецЕсли;

КонецФункции

// Секция «Производительность инструментов» (PERF-05): соседний пункт с
// «Пакетами инструментов» - счётчик tools, превысивших порог ar_ПорогМедленногоTool
// за последние 24 часа (по ar_СлужебныйЛог, событие "slow_tool"), и переход к
// полному отчёту ОбщаяФорма.ar_ПроизводительностьИнструментов. Сама статистика
// (максимум/перцентиль/медиана/доля ошибочных) живёт в отдельной форме -
// здесь только сводка, чтобы не раздувать HTML-панель настроек.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент секции «Производительность инструментов».
//
&НаСервере
Функция HTMLСекцияПроизводительностьИнструментов()

	ПорогСек = ar_Константы.ПорогМедленногоToolСек();

	Если ПорогСек <= 0 Тогда
		ТекстСводки = НСтр(
			"ru='Автообнаружение медленных вызовов отключено (порог = 0).';
			|en='Slow call autodetection is disabled (threshold = 0).'");
	Иначе
		КоличествоМедленных = КоличествоПредупрежденийSlowToolЗаСутки();
		ТекстСводки = СтрШаблон(
			НСтр("ru='Порог: %1 сек. Предупреждений за последние 24 часа: %2.';
				|en='Threshold: %1 sec. Warnings in the last 24 hours: %2.'"),
			ПорогСек, КоличествоМедленных);
	КонецЕсли;

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Производительность инструментов'; en='Tool performance'")) + "</h2>"
		+ ССылкаДействие("tool-perf-open", "", НСтр("ru='Открыть'; en='Open'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ "<div class=""ar-diag-row"">"
		+ "<span class=""ar-diag-text"">" + ar_ЭкранироватьHTML(ТекстСводки) + "</span>"
		+ "</div>"
		+ "</div>";

КонецФункции

// Секция «Tools в режиме «Код» отключены» (SEC-TOOL-02): показывается только
// если обработчик обновления CodeToolsDisabled реально отключил хотя бы один
// tool на этой базе - секция не занимает место на базах, где режима «Код»
// никогда не было. Тот же приём "счётчик + переход к логу", что в
// HTMLСекцияПроизводительностьИнструментов (PERF-05) - см. риск в
// .docs/specs/SEC-TOOL-02.md о том, что отключение не должно остаться
// незамеченным, если карточки были в реальном использовании.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент секции, "" если отключений не было.
//
&НаСервере
Функция HTMLСекцияCodeToolsОтключены()

	Количество = КоличествоCodeToolsОтключённых();
	Если Количество = 0 Тогда
		Возврат "";
	КонецЕсли;

	ТекстСводки = СтрШаблон(
		НСтр("ru='Отключено %1 tool(s) в режиме «Код» при удалении механизма (SEC-TOOL-02).
			|Переоформите нужные как пакет инструментов - см. .docs/Tutorial-свой-tool.md.';
			|en='%1 tool(s) in ""Code"" mode were disabled when the mechanism was removed (SEC-TOOL-02).
			|Re-implement the needed ones as a tool package - see .docs/Tutorial-свой-tool.md.'"),
		Количество);

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Tools в режиме «Код» отключены'; en='""Code"" mode tools disabled'")) + "</h2>"
		+ ССылкаДействие("code-tools-log-open", "", НСтр("ru='Открыть лог'; en='Open log'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ "<div class=""ar-banner"">"
		+ "<span class=""ar-diag-text"">" + ar_ЭкранироватьHTML(ТекстСводки) + "</span>"
		+ "</div>"
		+ "</div>";

КонецФункции

// Считает записи ar_СлужебныйЛог с событием "code_tools_disabled" (SEC-TOOL-02,
// обработчик обновления ar_ОбновлениеРасширения) - лёгкий агрегатный запрос,
// без ограничения по времени: разовое историческое событие миграции, а не
// суточная метрика (в отличие от slow_tool ниже).
//
// Возвращаемое значение:
//  Число - суммарное количество отключённых tools по всем записям события.
//
&НаСервереБезКонтекста
Функция КоличествоCodeToolsОтключённых()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Событие = ""code_tools_disabled""";

	// Привилегированный режим по тому же обоснованию, что и
	// КоличествоПредупрежденийSlowToolЗаСутки ниже - право Read на
	// РегистрСведений.ar_СлужебныйЛог есть только у ar_РольАдмин, форма
	// настроек открывается и Читателю, и Оператору.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Возврат ?(ТипЗнч(Выборка.Количество) = Тип("Число"), Выборка.Количество, 0);
	КонецЕсли;
	Возврат 0;

КонецФункции

// SCALE-07: секция-баннер «расширены права по умолчанию» - прямой прецедент
// HTMLСекцияCodeToolsОтключены (SEC-TOOL-02): та же карточка ar-card/ar-banner,
// тот же способ подсчёта (привилегированный агрегатный запрос к
// ar_СлужебныйЛог по коду события, без ограничения по времени - разовое
// событие миграции, не суточная метрика), та же ссылка-действие «Открыть лог».
//
// Показывается только когда счётчик > 0 (обработчик обновления
// ar_ОбновлениеРасширения.ЗафиксироватьРасширениеПравToolAccessRules нашёл
// хотя бы одного агента с пустыми ar_ДоступныеTools и ar_ПравилаДоступаTools) -
// типичный случай (все агенты уже имели непустую ar_ДоступныеTools) секцию
// не показывает вовсе (пустая строка, не пустая карточка).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент секции, "" если расширений прав не было.
//
&НаСервере
Функция HTMLСекцияToolAccessRulesРасширены()

	Количество = КоличествоАгентовСРасширеннымиПравами();
	Если Количество = 0 Тогда
		Возврат "";
	КонецЕсли;

	ТекстСводки = СтрШаблон(
		НСтр("ru='При обновлении расширения %1 агент(ов) получили доступ ко всему реестру инструментов
			|вместо прежнего пустого набора - это изменение поведения (SCALE-07). Проверьте карточки
			|агентов и, если нужно, заведите правила доступа или явный список.';
			|en='%1 agent(s) got access to the whole tool registry instead of the previous empty set on
			|extension update - this is a behavior change (SCALE-07). Review the agent cards and, if
			|needed, set up access rules or an explicit tool list.'"),
		Количество);

	Возврат
		"<div class=""ar-card"">"
		+ "<div class=""ar-card-head"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Права агентов расширены (SCALE-07)'; en='Agent access widened (SCALE-07)'")) + "</h2>"
		+ ССылкаДействие("access-rules-log-open", "", НСтр("ru='Открыть лог'; en='Open log'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ "<div class=""ar-banner"">"
		+ "<span class=""ar-diag-text"">" + ar_ЭкранироватьHTML(ТекстСводки) + "</span>"
		+ "</div>"
		+ "</div>";

КонецФункции

// Считает записи ar_СлужебныйЛог с событием "tool_access_rules_widened"
// (SCALE-07, обработчик обновления ar_ОбновлениеРасширения) - по одной записи
// на агента (см. ЗафиксироватьРасширениеПравToolAccessRules, идемпотентность
// по ar_ОбъектСсылка) - лёгкий агрегатный запрос, без ограничения по времени:
// разовое историческое событие миграции, а не суточная метрика.
//
// Возвращаемое значение:
//  Число - количество агентов, у которых обработчик обновления обнаружил
//          расширение прав.
//
&НаСервереБезКонтекста
Функция КоличествоАгентовСРасширеннымиПравами()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Событие = ""tool_access_rules_widened""";

	// Привилегированный режим по тому же обоснованию, что и
	// КоличествоCodeToolsОтключённых выше - право Read на
	// РегистрСведений.ar_СлужебныйЛог есть только у ar_РольАдмин, форма
	// настроек открывается и Читателю, и Оператору.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Возврат ?(ТипЗнч(Выборка.Количество) = Тип("Число"), Выборка.Количество, 0);
	КонецЕсли;
	Возврат 0;

КонецФункции

// Считает записи ar_СлужебныйЛог с событием "slow_tool" за последние 24 часа -
// лёгкий агрегатный запрос для сводки на панели настроек (PERF-05).
//
// Возвращаемое значение:
//  Число - количество предупреждений slow_tool за последние сутки.
//
&НаСервереБезКонтекста
Функция КоличествоПредупрежденийSlowToolЗаСутки()

	ЧасовВСутках = 24;
	СекундВЧасе = 60 * 60;
	ГраницаНачала = ТекущаяДатаСеанса() - ЧасовВСутках * СекундВЧасе;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ar_СлужебныйЛог КАК Лог
		|ГДЕ
		|	Лог.ar_Событие = ""slow_tool""
		|	И Лог.ar_Момент >= &ГраницаНачала";
	Запрос.УстановитьПараметр("ГраницаНачала", ГраницаНачала);

	// Привилегированный режим: право Read на РегистрСведений.ar_СлужебныйЛог
	// есть только у ar_РольАдмин, а форма настроек открывается и Читателю, и
	// Оператору (общие формы правами ролей не ограничиваются). Без подъёма
	// привилегий сводка роняла бы всю панель настроек этим ролям с ошибкой
	// прав. Показывается только счётчик предупреждений, не содержимое лога.
	// [Реф: ar_СлужебныйЛог.Записать - та же схема со снятием в обеих ветках]
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Возврат ?(ТипЗнч(Выборка.Количество) = Тип("Число"), Выборка.Количество, 0);
	КонецЕсли;
	Возврат 0;

КонецФункции

// Считает зарегистрированные пакеты и те, что требуют внимания администратора
// (статусы "ТребуетПереподтверждения"/"Отклонён") - лёгкий агрегатный запрос
// по РегистрСведений.ar_ПакетыTools, без чтения бинарников пакетов.
//
// Возвращаемое значение:
//  Структура { Зарегистрировано - Число, ТребуютВнимания - Число }.
//
&НаСервереБезКонтекста
Функция СводкаПакетовTools()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты";

	Зарегистрировано = 0;
	ТребуютВнимания = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Статус = "Зарегистрирован" Тогда
			Зарегистрировано = Зарегистрировано + 1;
		ИначеЕсли Выборка.Статус = "ТребуетПереподтверждения" Или Выборка.Статус = "Отклонён" Тогда
			ТребуютВнимания = ТребуютВнимания + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Зарегистрировано, ТребуютВнимания", Зарегистрировано, ТребуютВнимания);

КонецФункции

// Секция настроек-констант: карточки по разделам с редакторами.
//
&НаСервере
Функция HTMLСекцияНастроек()

	Разделы = ОписаниеНастроек();
	HTMLРазделов = "";

	Для Каждого Раздел Из Разделы Цикл
		СтрокиНастроек = "";
		Для Каждого Настройка Из Раздел.Настройки Цикл
			СтрокиНастроек = СтрокиНастроек + HTMLСтрокаНастройки(Настройка);
		КонецЦикла;
		HTMLРазделов = HTMLРазделов
			+ "<div class=""ar-card"">"
			+ "<h2>" + ar_ЭкранироватьHTML(Раздел.Заголовок) + "</h2>"
			+ СтрокиНастроек
			+ "</div>";
	КонецЦикла;

	Возврат HTMLРазделов;

КонецФункции

// Строит HTML одной строки настройки: подпись, описание, редактор по типу.
//
&НаСервере
Функция HTMLСтрокаНастройки(Знач Настройка)

	Подпись  = ar_ЭкранироватьHTML(Настройка.Подпись);
	Описание = ar_ЭкранироватьHTML(Настройка.Описание);
	Ключ     = Настройка.Ключ;

	Возврат
		"<div class=""ar-setting"">"
		+ "<div class=""ar-setting-info"">"
		+ "<div class=""ar-setting-label"">" + Подпись + "</div>"
		+ "<div class=""ar-setting-desc"">" + Описание + "</div>"
		+ "</div>"
		+ "<div class=""ar-setting-editor"">" + HTMLРедактор(Настройка) + "</div>"
		+ "</div>";

КонецФункции

// Строит редактор для настройки в зависимости от её типа.
//
&НаСервере
Функция HTMLРедактор(Знач Настройка)

	Ключ = Настройка.Ключ;
	Тип  = Настройка.Тип;

	Если Тип = "Булево" Тогда
		Состояние = ?(Настройка.Значение = Истина, "on", "off");
		Метка = ?(Настройка.Значение = Истина,
			НСтр("ru='Вкл'; en='On'"), НСтр("ru='Выкл'; en='Off'"));
		Возврат ССылкаДействие("toggle", "key=" + Ключ,
			Метка, "ar-toggle ar-toggle-" + Состояние);

	ИначеЕсли Тип = "Ссылка" Тогда
		Представление = ?(ПустаяСтрока(Настройка.Представление),
			НСтр("ru='(не выбран)'; en='(not set)'"), Настройка.Представление);
		Возврат
			"<span class=""ar-refval"">" + ar_ЭкранироватьHTML(Представление) + "</span>"
			+ ССылкаДействие("pick-user", "", НСтр("ru='Выбрать…'; en='Select…'"), "ar-btn ar-btn-small");

	ИначеЕсли Тип = "Многострочная" Тогда
		Возврат
			"<textarea id=""" + Ключ + """ class=""ar-textarea"" rows=""6"">"
			+ ar_ЭкранироватьHTML(Настройка.Значение) + "</textarea>"
			+ ССылкаДействие("save", "key=" + Ключ, НСтр("ru='Сохранить'; en='Save'"), "ar-btn ar-btn-small");

	Иначе // Число / Строка
		ТипInput = ?(Тип = "Число", "number", "text");
		Возврат
			"<input id=""" + Ключ + """ class=""ar-input"" type=""" + ТипInput + """ value=""" + ar_ЭкранироватьHTML(Настройка.Значение) + """>"
			+ ССылкаДействие("save", "key=" + Ключ, НСтр("ru='Сохранить'; en='Save'"), "ar-btn ar-btn-small");
	КонецЕсли;

КонецФункции

// Секция переходов к спискам реестров.
//
&НаСервере
Функция HTMLСекцияРеестров()

	Реестры = СпискиРеестров();
	Кнопки = "";
	Для Каждого Реестр Из Реестры Цикл
		Кнопки = Кнопки + ССылкаДействие("open", "list=" + Реестр.Ключ,
			Реестр.Заголовок, "ar-btn ar-btn-reg");
	КонецЦикла;

	Возврат
		"<div class=""ar-card"">"
		+ "<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Реестры и правила'; en='Registries and rules'")) + "</h2>"
		+ "<div class=""ar-reg-grid"">" + Кнопки + "</div>"
		+ "</div>";

КонецФункции

// Формирует HTML-ссылку-действие с href схемы "1c://".
//
// Параметры:
//  Действие   - Строка - имя действия (save/toggle/open/refresh/...).
//  Параметры  - Строка - строка query-параметров ("key=..." или "").
//  Текст      - Строка - видимый текст ссылки.
//  КлассCSS   - Строка - CSS-классы.
//
&НаСервере
Функция ССылкаДействие(Знач Действие, Знач ПараметрыЗапроса, Знач Текст, Знач КлассCSS)

	Href = "1c://" + Действие;
	Если Не ПустаяСтрока(ПараметрыЗапроса) Тогда
		Href = Href + "?" + ПараметрыЗапроса;
	КонецЕсли;

	Возврат "<a href=""" + Href + """ class=""" + КлассCSS + """>" + ar_ЭкранироватьHTML(Текст) + "</a>";

КонецФункции

// Обёртка HTML-каркаса со встроенными стилями (офлайн-first, без внешних CDN).
// JS минимален: только защита от отправки формы; вся навигация - через <a href="1c://">.
//
&НаКлиентеНаСервереБезКонтекста
Функция HTMLКаркасНастроек(Знач Содержимое)

	Возврат
		"<!DOCTYPE html><html><head><meta charset=""utf-8""><style>"
		+ "html,body{margin:0;padding:0;background:#f4f6f8;color:#1b1f23;"
		+ "font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:13px;}"
		+ ".ar-wrap{max-width:900px;margin:0 auto;padding:12px;}"
		+ ".ar-head{display:flex;align-items:baseline;justify-content:space-between;margin:6px 4px 10px;}"
		+ ".ar-head h1{font-size:18px;margin:0;}"
		+ ".ar-status{color:#1a7f37;font-weight:600;}"
		+ ".ar-card{background:#fff;border:1px solid #e1e6eb;border-radius:10px;"
		+ "padding:14px 16px;margin-bottom:12px;box-shadow:0 1px 2px rgba(0,0,0,0.04);}"
		+ ".ar-card h2{font-size:14px;margin:0 0 10px;color:#3a4a5b;}"
		+ ".ar-card-head{display:flex;align-items:center;justify-content:space-between;}"
		+ ".ar-card-head h2{margin:0;}"
		+ ".ar-banner{background:#fff8e1;border-color:#f0d778;display:flex;"
		+ "align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}"
		+ ".ar-banner-actions{display:flex;gap:8px;}"
		+ ".ar-summary{padding:6px 10px;border-radius:6px;margin-bottom:8px;font-weight:600;}"
		+ ".ar-summary-ok{background:#e6f4ea;color:#1a7f37;}"
		+ ".ar-summary-warning{background:#fff4e5;color:#9a6700;}"
		+ ".ar-summary-error{background:#fde8e8;color:#b42318;}"
		+ ".ar-diag-row{display:flex;align-items:center;gap:8px;padding:3px 0;}"
		+ ".ar-badge{width:20px;text-align:center;}"
		+ ".ar-note{background:#eef1f5;color:#5b6b7c;border-radius:6px;padding:6px 10px;"
		+ "margin-bottom:8px;font-size:12px;}"
		+ ".ar-setting{display:flex;align-items:center;justify-content:space-between;"
		+ "gap:14px;padding:8px 0;border-top:1px solid #eef1f5;}"
		+ ".ar-setting:first-of-type{border-top:none;}"
		+ ".ar-setting-info{flex:1;min-width:0;}"
		+ ".ar-setting-label{font-weight:600;}"
		+ ".ar-setting-desc{color:#6b7a8f;font-size:12px;margin-top:2px;}"
		+ ".ar-setting-editor{display:flex;align-items:center;gap:6px;flex-shrink:0;}"
		+ ".ar-input{width:120px;padding:4px 6px;border:1px solid #cdd5de;border-radius:6px;font-size:13px;}"
		+ ".ar-textarea{width:360px;max-width:52vw;padding:6px;border:1px solid #cdd5de;"
		+ "border-radius:6px;font-family:Consolas,Menlo,monospace;font-size:12px;}"
		+ ".ar-refval{color:#3a4a5b;}"
		+ "a.ar-btn{display:inline-block;padding:4px 10px;border-radius:6px;background:#eef1f5;"
		+ "color:#3a5ba0;text-decoration:none;font-size:12px;border:1px solid #dfe4ea;}"
		+ "a.ar-btn:hover{background:#e2e8f0;}"
		+ "a.ar-btn-primary{background:#3a5ba0;color:#fff;border-color:#3a5ba0;}"
		+ "a.ar-btn-small{padding:3px 8px;}"
		+ "a.ar-toggle{display:inline-block;padding:4px 14px;border-radius:12px;text-decoration:none;"
		+ "font-size:12px;font-weight:600;}"
		+ "a.ar-toggle-on{background:#1a7f37;color:#fff;}"
		+ "a.ar-toggle-off{background:#d0d7de;color:#57606a;}"
		+ ".ar-reg-grid{display:flex;flex-wrap:wrap;gap:8px;}"
		+ "a.ar-btn-reg{background:#f0f4fb;}"
		+ "</style></head><body><div class=""ar-wrap"">"
		+ Содержимое
		+ "</div></body></html>";

КонецФункции

// Экранирует спецсимволы HTML (тот же контракт, что в ar_Диалог).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст,    "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

// Значок статуса РЗ для бейджа диагностики.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЗначокСтатуса(Знач Статус)
	Если Статус = "ok" Тогда
		Возврат "✓";
	ИначеЕсли Статус = "warning" Тогда
		Возврат "⚠";
	Иначе
		Возврат "✕";
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область ОписаниеНастроек

// Описание всех редактируемых настроек-констант, сгруппированных по разделам.
// Значения читаются здесь же через геттеры ar_Константы.
//
// Возвращаемое значение:
//  Массив из Структур { Заголовок - Строка, Настройки - Массив } - разделы панели.
//
&НаСервере
Функция ОписаниеНастроек()

	Разделы = Новый Массив;

	// --- LLM и таймауты ---
	НастройкиLLM = Новый Массив;
	НастройкиLLM.Добавить(НастройкаЧисло("ar_ТаймаутLLMПоУмолчанию",
		НСтр("ru='Таймаут LLM (сек)'; en='LLM timeout (sec)'"),
		НСтр("ru='Сколько ждать ответа LLM по HTTP, прежде чем оборвать запрос.';
			|en='How long to wait for an LLM response before aborting the request.'"),
		ar_Константы.ТаймаутLLM()));
	НастройкиLLM.Добавить(НастройкаЧисло("ar_МаксРазмерОтветаHTTP",
		НСтр("ru='Макс. размер HTTP-ответа (байт)'; en='Max HTTP response size (bytes)'"),
		НСтр("ru='Верхний предел размера ответа LLM/tools; защита от переполнения памяти.';
			|en='Upper limit on LLM/tool response size; guards against memory overflow.'"),
		ar_Константы.МаксРазмерОтветаHTTP()));
	НастройкиLLM.Добавить(НастройкаМногострочная("ar_LLM_AllowList_URL",
		НСтр("ru='Allowlist хостов LLM'; en='LLM host allowlist'"),
		НСтр("ru='Разрешённые хосты LLM, по одному в строке. Пусто — стандартный список.';
			|en='Allowed LLM hosts, one per line. Empty — default list.'"),
		Константы.ar_LLM_AllowList_URL.Получить()));
	Разделы.Добавить(Раздел(НСтр("ru='LLM и таймауты'; en='LLM and timeouts'"), НастройкиLLM));

