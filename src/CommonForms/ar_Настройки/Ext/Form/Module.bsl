#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает имя действия из служебной ссылки "1c://<действие>?<параметры>".
//
&НаКлиентеНаСервереБезКонтекста
Функция ДействиеИзСсылки(Знач Ссылка)
	Тело = Сред(Ссылка, СтрДлина("1c://") + 1);
	ПозицияВопроса = СтрНайти(Тело, "?");
	Если ПозицияВопроса > 0 Тогда
		Тело = Лев(Тело, ПозицияВопроса - 1);
	КонецЕсли;
	Возврат СокрЛП(Тело);
КонецФункции

// Разбирает query-параметры служебной ссылки в структуру { имя -> значение }.
// URL-декодирование не применяется: в ссылках передаются только служебные
// идентификаторы (имена констант, логические имена реестров) без спецсимволов,
// пробелов и %-последовательностей. Само значение настройки через ссылку не
// передаётся - оно читается из DOM в ОбработатьСохранениеПоля. Это позволяет
// оставить функцию клиент-серверной (ДекодироватьСтроку/СпособКодированияСтроки
// недоступны в контексте модуля формы на тонком клиенте).
//
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыИзСсылки(Знач Ссылка)
	Результат = Новый Структура;
	ПозицияВопроса = СтрНайти(Ссылка, "?");
	Если ПозицияВопроса = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = Сред(Ссылка, ПозицияВопроса + 1);
	Пары = СтрРазделить(Хвост, "&", Ложь);
	Для Каждого Пара Из Пары Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Пара, ПозицияРавно - 1);
		Значение = Сред(Пара, ПозицияРавно + 1);
		Если Не ПустаяСтрока(Имя) Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Приводит строковое значение к числу (терпимо к пробелам, запятой, пустоте).
//
&НаСервереБезКонтекста
Функция ПривестиКЧислу(Знач Значение)
	Строка = СокрЛП("" + Значение);
	Строка = СтрЗаменить(Строка, " ", "");
	Строка = СтрЗаменить(Строка, ",", ".");
	Если ПустаяСтрока(Строка) Тогда
		Возврат 0;
	КонецЕсли;
	ОписаниеТипов = Новый ОписаниеТипов("Число");
	Возврат ОписаниеТипов.ПривестиЗначение(Строка);
КонецФункции

// Получает данные об обновлении с сервера agentrunner.ru.
// Возвращает Неопределено, если снузл активен, ошибка сети или обновления нет.
//
// Возвращаемое значение:
//  Структура (ПоследняяВерсия, URL, ...), или Неопределено.
//
&НаСервере
Функция ПолучитьДанныеОбновления()

	Если ТекущаяДатаСеанса() <= ar_Константы.ОбновлениеНеНапоминатьДо() Тогда
		Возврат Неопределено; // снузл активен
	КонецЕсли;

	Результат = ar_ПроверкаОбновлений.ПроверитьВерсию();
	Если Не ПустаяСтрока(Результат.ОшибкаПолучения) Или Не Результат.ЕстьОбновление Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Формирует строку состояния одного регламентного задания для карточки диагностики.
//
// Параметры:
//   ЭлементРЗ - Структура {Имя, Синоним, ПоследнийЗапуск, СекундНазад, Статус}.
//
// Возвращаемое значение:
//   Строка - человекочитаемая строка состояния задания.
//
&НаСервере
Функция СтрокаСостоянияРЗ(Знач ЭлементРЗ)

	Если ЭлементРЗ.Статус = "ok" Тогда
		Возврат СтрШаблон(
			НСтр("ru='«%1» — работает штатно (последний запуск %2 назад).';
				|en='""%1"" — running normally (last run %2 ago).'"),
			ЭлементРЗ.Синоним,
			ПредставлениеДавности(ЭлементРЗ.СекундНазад));
	КонецЕсли;

	Если ЭлементРЗ.Статус = "warning" Тогда
		Если ЭлементРЗ.СекундНазад = -1 Тогда
			Возврат СтрШаблон(
				НСтр("ru='«%1» включено, но ещё ни разу не запускалось. Ожидается первый тик.';
					|en='""%1"" is enabled but has never run yet. Awaiting the first tick.'"),
				ЭлементРЗ.Синоним);
		КонецЕсли;
		Возврат СтрШаблон(
			НСтр("ru='«%1» не запускалось %2. Проверьте настройки кластера и регламентные задания.';
				|en='""%1"" has not run for %2. Check cluster settings and scheduled jobs.'"),
			ЭлементРЗ.Синоним,
			ПредставлениеДавности(ЭлементРЗ.СекундНазад));
	КонецЕсли;

	// Статус "error".
	Если ЭлементРЗ.Имя = "diagnostic_error" Тогда
		Возврат СтрШаблон(
			НСтр("ru='%1'; en='%1'"),
			ЭлементРЗ.Синоним);
	Иначе
		Возврат СтрШаблон(
			НСтр("ru='«%1» выключено. Включите его в форме «Регламентные и фоновые задания».';
				|en='""%1"" is disabled. Enable it in the ""Scheduled and background jobs"" form.'"),
			ЭлементРЗ.Синоним);
	КонецЕсли;

КонецФункции

// Формирует итоговое представление статуса панели диагностики.
//
&НаСервере
Функция ИтоговоеПредставлениеСтатуса(Знач ХудшийСтатус, Знач КоличествоПроблем)

	Если ХудшийСтатус = "ok" Тогда
		Возврат НСтр("ru='Планировщики работают штатно.'; en='Schedulers are running normally.'");
	ИначеЕсли ХудшийСтатус = "warning" Тогда
		Возврат СтрШаблон(
			НСтр("ru='Найдено предупреждений: %1. Регламентные задания давно не срабатывали.';
				|en='Warnings found: %1. Scheduled jobs have not run for a while.'"),
			КоличествоПроблем);
	Иначе
		Возврат СтрШаблон(
			НСтр("ru='Найдено проблем: %1. Часть регламентных заданий отключена.';
				|en='Issues found: %1. Some scheduled jobs are disabled.'"),
			КоличествоПроблем);
	КонецЕсли;

КонецФункции

// Человекочитаемое представление давности последнего запуска.
//
&НаСервере
Функция ПредставлениеДавности(Знач СекундНазад)

	СекундВМинуте = 60;
	СекундВЧасе   = 3600;
	СекундВСутках = 86400;

	Если СекундНазад < 0 Тогда
		Возврат НСтр("ru='нет данных'; en='no data'");
	ИначеЕсли СекундНазад < СекундВМинуте Тогда
		Возврат СтрШаблон(НСтр("ru='%1 сек'; en='%1 sec'"), Формат(СекундНазад, "ЧГ=0; ЧДЦ=0"));
	ИначеЕсли СекундНазад < СекундВЧасе Тогда
		Возврат СтрШаблон(НСтр("ru='%1 мин'; en='%1 min'"), Формат(Цел(СекундНазад / СекундВМинуте), "ЧГ=0; ЧДЦ=0"));
	ИначеЕсли СекундНазад < СекундВСутках Тогда
		Возврат СтрШаблон(НСтр("ru='%1 ч'; en='%1 h'"), Формат(Цел(СекундНазад / СекундВЧасе), "ЧГ=0; ЧДЦ=0"));
	Иначе
		Возврат СтрШаблон(НСтр("ru='%1 сут'; en='%1 d'"), Формат(Цел(СекундНазад / СекундВСутках), "ЧГ=0; ЧДЦ=0"));
	КонецЕсли;

КонецФункции

#КонецОбласти
