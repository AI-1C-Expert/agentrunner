////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_ПакетыTools (PKG-06) — список зарегистрированных пакетов tools
// с командами управления. Обычная управляемая форма с динамическим списком по
// РегистрСведений.ar_ПакетыTools (не HTML-панель, в отличие от ar_Настройки) -
// решение спеки: список пакетов дешевле разрабатывать и валидировать штатно
// Skill(form-validate) на обычной форме.
//
// Открывается из ar_Настройки действием "packages-open".
//
// Все операции над пакетами - синхронные серверные вызовы поверх готового
// бэкенда ar_ToolПакеты (PKG-03/05): НайтиКандидатов, ПрочитатьМанифестКандидата,
// ВалидироватьМанифест, ЗарегистрироватьПакет, ОтключитьПакет,
// ПроверитьХешиПакетов, ToolsПакета. Никаких фоновых заданий/длительных
// операций - в проекте нет ни одного вызова ДлительныеОперации.*, а объём
// данных (единицы-десятки пакетов, ручная установка администратором) не
// оправдывает новый инфраструктурный паттерн (см. .docs/specs/PKG-06.md §2).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ОбновитьДоступностьМеханизма();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// «Найти пакеты инструментов»: синхронный серверный вызов
// ar_ToolПакеты.НайтиКандидатов() + чтение/валидация манифеста каждого
// найденного кандидата, ещё не зарегистрированного. Результат показывается
// одним сообщением-сводкой (детали по каждому кандидату - в тексте).
//
&НаКлиенте
Процедура ar_НайтиПакеты(Команда)

	Результат = НайтиКандидатовНаСервере();

	Если Результат.МеханизмНедоступен Тогда
		ПоказатьПредупреждение(, Результат.ТекстСообщения);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru='Поиск пакетов завершён'; en='Package scan finished'"),
		,
		Результат.ТекстСообщения);

	ОбновитьСписокПакетов();

КонецПроцедуры

// «Установить»: регистрирует пакет-кандидат через ar_ToolПакеты.ЗарегистрироватьПакет.
// Источник идентификатора - ДВА варианта, т.к. до первой установки строки в
// Списке (регистр ar_ПакетыTools) физически нет:
//  1. Текущая строка Списка - для уже зарегистрированного, но требующего
//     переустановки пакета (например, после ручной правки регистра).
//  2. Если строка не выбрана - берём кандидатов из НайтиКандидатов() напрямую
//     (ещё не зарегистрированные): один кандидат - устанавливаем сразу, больше
//     одного - предлагаем выбрать через ВыбратьИзСписка, ни одного - предупреждение.
// Для пакета с БезопасныйРежим = Ложь - обязательное подтверждение ПоказатьВопрос
// с текстом риска (PKG-05 §3); отказ не идёт на сервер и не оставляет записей.
// Тот же метод используется для повторной регистрации ("Переподтвердить") -
// см. ar_ПереподтвердитьПакет.
//
&НаКлиенте
Процедура ar_УстановитьПакет(Команда)

	ИдентификаторОбработки = ТекущийИдентификаторПакета();
	Если ПустаяСтрока(ИдентификаторОбработки) Тогда
		НекандидатыИдентификаторы = НезарегистрированныеКандидатыНаСервере();

		Если НекандидатыИдентификаторы.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр("ru='Нет незарегистрированных пакетов-кандидатов. Нажмите
				|«Найти пакеты инструментов», затем выберите пакет в списке.';
				|en='No unregistered candidate packages. Click ""Find tool packages"", then select a
				|package in the list.'"));
			Возврат;
		ИначеЕсли НекандидатыИдентификаторы.Количество() = 1 Тогда
			ПродолжитьУстановкуПакета(НекандидатыИдентификаторы[0].Значение);
			Возврат;
		Иначе
			СписокВыбора = Новый СписокЗначений;
			Для Каждого Элемент Из НекандидатыИдентификаторы Цикл
				СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
			КонецЦикла;
			Оповещение = Новый ОписаниеОповещения("ВыбратьКандидатаЗавершение", ЭтотОбъект);
			СписокВыбора.ПоказатьВыборЭлемента(Оповещение,
				НСтр("ru='Выберите пакет для установки'; en='Select a package to install'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПродолжитьУстановкуПакета(ИдентификаторОбработки);

КонецПроцедуры

// Продолжение ar_УстановитьПакет после выбора кандидата из диалога
// ПоказатьВыборЭлемента (ветка "несколько незарегистрированных кандидатов").
//
&НаКлиенте
Процедура ВыбратьКандидатаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат; // отмена выбора
	КонецЕсли;

	ПродолжитьУстановкуПакета(ВыбранныйЭлемент.Значение);

КонецПроцедуры

// Общее начало установки для обеих веток ar_УстановитьПакет (строка списка /
// незарегистрированный кандидат): готовит текст подтверждения и уходит в
// ПоказатьВопрос, дальше - как раньше, через ЗавершитьУстановкуПакета.
//
&НаКлиенте
Процедура ПродолжитьУстановкуПакета(Знач ИдентификаторОбработки)

	ПодготовкаУстановки = ПодготовитьУстановкуПакетаНаСервере(ИдентификаторОбработки);

	Если Не ПодготовкаУстановки.Успех Тогда
		ПоказатьПредупреждение(, ПодготовкаУстановки.ТекстСообщения);
		Возврат;
	КонецЕсли;

	Если Не ПодготовкаУстановки.БезопасныйРежим Тогда
		ТекстВопроса = СтрШаблон(
			НСтр("ru='Пакет «%1» работает в небезопасном режиме: его код получит доступ к файловой
				|системе, внешним компонентам и сети. AgentRunner не проверяет подпись пакета -
				|ответственность за источник несёт администратор базы. Установить?';
				|en='Package ""%1"" runs in unsafe mode: its code gets access to the file system,
				|external components and network. AgentRunner does not verify the package signature -
				|the database administrator is responsible for the source. Install anyway?'"),
			ПодготовкаУстановки.ИмяОбъекта);

		Оповещение = Новый ОписаниеОповещения("УстановитьПакетНебезопасныйЗавершение", ЭтотОбъект, ИдентификаторОбработки);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	ТекстВопросаБезопасный = СтрШаблон(
		НСтр("ru='Установить пакет «%1»? Будет зарегистрировано инструментов: %2 (%3).';
			|en='Install package ""%1""? Tools to be registered: %2 (%3).'"),
		ПодготовкаУстановки.ИмяОбъекта,
		ПодготовкаУстановки.КоличествоTools,
		ПодготовкаУстановки.СписокTools);

	ОповещениеБезопасный = Новый ОписаниеОповещения("УстановитьПакетЗавершение", ЭтотОбъект, ИдентификаторОбработки);
	ПоказатьВопрос(ОповещениеБезопасный, ТекстВопросаБезопасный, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Продолжение установки небезопасного пакета после подтверждения администратора.
//
&НаКлиенте
Процедура УстановитьПакетНебезопасныйЗавершение(РезультатВопроса, ИдентификаторОбработки) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат; // отказ - ЗарегистрироватьПакет не вызывается, записей не остаётся
	КонецЕсли;

	ЗавершитьУстановкуПакета(ИдентификаторОбработки);

КонецПроцедуры

// Продолжение установки безопасного пакета после подтверждения администратора.
//
&НаКлиенте
Процедура УстановитьПакетЗавершение(РезультатВопроса, ИдентификаторОбработки) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьУстановкуПакета(ИдентификаторОбработки);

КонецПроцедуры

// Общий хвост установки/переподтверждения: вызов ЗарегистрироватьПакет и показ результата.
//
&НаКлиенте
Процедура ЗавершитьУстановкуПакета(Знач ИдентификаторОбработки)

	Результат = ЗарегистрироватьПакетНаСервере(ИдентификаторОбработки);

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru='Пакет зарегистрирован'; en='Package registered'"),
			,
			СтрШаблон(НСтр("ru='Зарегистрировано инструментов: %1'; en='Tools registered: %1'"), Результат.КоличествоTools));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru='Пакет отклонён: %1'; en='Package rejected: %1'"),
			Результат.ТекстСообщения));
	КонецЕсли;

	ОбновитьСписокПакетов();

КонецПроцедуры

// «Отключить»: переводит пакет (текущую строку списка) в статус "Отключён" и
// гасит ar_Включён у всех его tools через ar_ToolПакеты.ОтключитьПакет. Запись
// регистра остаётся - история регистрации не удаляется.
//
&НаКлиенте
Процедура ar_ОтключитьПакет(Команда)

	ИдентификаторОбработки = ТекущийИдентификаторПакета();
	Если ПустаяСтрока(ИдентификаторОбработки) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите пакет в списке'; en='Select a package in the list'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ОтключитьПакетЗавершение", ЭтотОбъект, ИдентификаторОбработки);
	ПоказатьВопрос(Оповещение,
		НСтр("ru='Отключить пакет? Его инструменты перестанут передаваться агентам.';
			|en='Disable the package? Its tools will stop being sent to agents.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьПакетЗавершение(РезультатВопроса, Знач ИдентификаторОбработки) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Успех = ОтключитьПакетНаСервере(ИдентификаторОбработки);

	Если Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru='Пакет отключён'; en='Package disabled'"));
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='Не удалось отключить пакет'; en='Failed to disable the package'"));
	КонецЕсли;

	ОбновитьСписокПакетов();

КонецПроцедуры

// «Переподтвердить»: отдельного серверного метода нет (PKG-06 §4) - повторный
// вызов ЗарегистрироватьПакет с тем же идентификатором перечитывает манифест,
// валидирует и перезаписывает запись регистра, снимая статус
// "ТребуетПереподтверждения". Подтверждение показываем всегда (в т.ч. для
// безопасных пакетов) - переподтверждение так же вносит изменения в реестр,
// как и первичная установка.
//
&НаКлиенте
Процедура ar_ПереподтвердитьПакет(Команда)

	ИдентификаторОбработки = ТекущийИдентификаторПакета();
	Если ПустаяСтрока(ИдентификаторОбработки) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите пакет в списке'; en='Select a package in the list'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПереподтвердитьПакетЗавершение", ЭтотОбъект, ИдентификаторОбработки);
	ПоказатьВопрос(Оповещение,
		НСтр("ru='Переподтвердить пакет? Манифест будет перечитан и провалидирован заново.';
			|en='Reconfirm the package? The manifest will be re-read and re-validated.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПереподтвердитьПакетЗавершение(РезультатВопроса, Знач ИдентификаторОбработки) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьУстановкуПакета(ИдентификаторОбработки);

КонецПроцедуры

// «Проверить изменения»: сверка хешей манифестов ВСЕХ зарегистрированных
// пакетов - только по явной команде пользователя (PKG-06 §6, D7), не при
// каждом открытии формы. Дорогая операция - грузит бинарник каждого пакета.
//
&НаКлиенте
Процедура ar_ПроверитьИзменения(Команда)

	Результат = ПроверитьХешиПакетовНаСервере();

	ПоказатьОповещениеПользователя(
		НСтр("ru='Проверка изменений завершена'; en='Change check finished'"),
		,
		СтрШаблон(
			НСтр("ru='Проверено пакетов: %1, изменилось: %2'; en='Checked: %1, changed: %2'"),
			Результат.Проверено,
			Результат.Изменилось));

	ОбновитьСписокПакетов();

КонецПроцедуры

// «Показать инструменты»: открывает ФормаСписка ar_Tools с отбором по
// текущему пакету (ar_ИдентификаторПакета) - проще и надёжнее для UI, чем
// показывать ToolsПакета() отдельным немодифицируемым списком.
//
&НаКлиенте
Процедура ar_ПоказатьTools(Команда)

	ИдентификаторОбработки = ТекущийИдентификаторПакета();
	Если ПустаяСтрока(ИдентификаторОбработки) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите пакет в списке'; en='Select a package in the list'"));
		Возврат;
	КонецЕсли;

	// Имя переменной не совпадает со свойством формы ПараметрыВыбора -
	// присваивание ему падает с "Type mismatch" (память reference_form_property_name_collision).
	ПараметрыОтбора = Новый Структура;
	ОтборСписка = Новый Структура;
	ОтборСписка.Вставить("ar_ИдентификаторПакета", ИдентификаторОбработки);
	ПараметрыОтбора.Вставить("Отбор", ОтборСписка);

	ОткрытьФорму("Справочник.ar_Tools.ФормаСписка", ПараметрыОтбора, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СерверныеДействия

// Проверяет доступность механизма пакетов и настраивает видимость таблицы/сообщения.
//
&НаСервере
Процедура ОбновитьДоступностьМеханизма()

	// Имя переменной не совпадает со свойством формы "Доступность" (Enabled) -
	// присваивание структуры туда падает Type mismatch, обнаруживается только
	// при живой загрузке (валидаторы это не ловят, см. PKG-06).
	ДоступностьМеханизма = ar_ToolПакеты.МеханизмПакетовДоступен();
	МеханизмДоступен = ДоступностьМеханизма.Доступен;

	Если Не МеханизмДоступен Тогда
		СообщениеНедоступности = ТекстПричиныНедоступности(ДоступностьМеханизма.Причина);
	Иначе
		СообщениеНедоступности = "";
	КонецЕсли;

	Элементы.ДекорацияНедоступности.Заголовок = СообщениеНедоступности;
	Элементы.ДекорацияНедоступности.Видимость = Не МеханизмДоступен;
	Элементы.Список.Видимость = МеханизмДоступен;

	Элементы.КнопкаНайтиПакеты.Доступность = МеханизмДоступен;
	Элементы.КнопкаУстановитьПакет.Доступность = МеханизмДоступен;
	Элементы.КнопкаОтключитьПакет.Доступность = МеханизмДоступен;
	Элементы.КнопкаПереподтвердитьПакет.Доступность = МеханизмДоступен;
	Элементы.КнопкаПроверитьИзменения.Доступность = МеханизмДоступен;
	Элементы.КнопкаПоказатьTools.Доступность = МеханизмДоступен;

КонецПроцедуры

// Человекочитаемый текст причины недоступности механизма пакетов (PKG-06 D1).
//
&НаСервереБезКонтекста
Функция ТекстПричиныНедоступности(Знач Причина)

	Если Причина = "subsystem_missing" Тогда
		Возврат НСтр(
			"ru='В этой конфигурации нет подсистемы «Дополнительные отчёты и обработки». Механизм
				|пакетов недоступен, остальные инструменты работают.';
			|en='This configuration has no ""Additional reports and data processors"" subsystem. The
				|package mechanism is unavailable, other tools keep working.'");
	ИначеЕсли Причина = "functional_option_disabled" Тогда
		Возврат НСтр(
			"ru='Функциональная опция «Использовать дополнительные отчёты и обработки» выключена.
				|Включите её в настройках программы, чтобы устанавливать пакеты.';
			|en='The ""Use additional reports and data processors"" functional option is disabled.
				|Enable it in the application settings to install packages.'");
	Иначе
		Возврат НСтр("ru='Механизм пакетов недоступен.'; en='Package mechanism unavailable.'");
	КонецЕсли;

КонецФункции

// Кандидаты НайтиКандидатов(), для которых ЕЩЁ НЕТ записи в регистре
// ar_ПакетыTools - только их можно установить без выбора строки в Списке
// (сам Список - динамический список ПО этому регистру, см. шапку модуля).
// Используется командой "Установить", когда строка Списка не выбрана.
//
// Возвращаемое значение:
//  Массив СтруктурКлючЗначение - Значение = ИдентификаторОбработки (Строка),
//  Представление = "ИмяОбъекта (версия Версия)" для диалога выбора.
//
&НаСервере
Функция НезарегистрированныеКандидатыНаСервере()

	Результат = Новый Массив;

	ДоступностьМеханизма = ar_ToolПакеты.МеханизмПакетовДоступен();
	Если Не ДоступностьМеханизма.Доступен Тогда
		Возврат Результат;
	КонецЕсли;

	Кандидаты = ar_ToolПакеты.НайтиКандидатов();
	Если Кандидаты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Идентификаторы.Добавить(Строка(Кандидат.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_ИдентификаторОбработки В (&Идентификаторы)";
	УжеЗарегистрированы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УжеЗарегистрированы.Вставить(Выборка.ИдентификаторОбработки, Истина);
	КонецЦикла;

	Для Каждого Кандидат Из Кандидаты Цикл
		ИдентификаторОбработки = Строка(Кандидат.Ссылка.УникальныйИдентификатор());
		Если УжеЗарегистрированы[ИдентификаторОбработки] = Истина Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Значение, Представление",
			ИдентификаторОбработки,
			СтрШаблон("%1 (%2)", Кандидат.ИмяОбъекта, Кандидат.Версия)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обёртка НайтиКандидатов() + чтение/валидация манифеста для кандидатов,
// которые ещё не зарегистрированы (нет записи в ar_ПакетыTools). Результат -
// человекочитаемая сводка по каждому кандидату (PKG-06 D2/D3).
//
&НаСервере
Функция НайтиКандидатовНаСервере()

	Результат = Новый Структура("МеханизмНедоступен, ТекстСообщения", Ложь, "");

	ДоступностьМеханизма = ar_ToolПакеты.МеханизмПакетовДоступен();
	ОбновитьДоступностьМеханизма();
	Если Не ДоступностьМеханизма.Доступен Тогда
		Результат.МеханизмНедоступен = Истина;
		Результат.ТекстСообщения = ТекстПричиныНедоступности(ДоступностьМеханизма.Причина);
		Возврат Результат;
	КонецЕсли;

	Кандидаты = ar_ToolПакеты.НайтиКандидатов();

	Если Кандидаты.Количество() = 0 Тогда
		Результат.ТекстСообщения = НСтр("ru='Кандидатов не найдено.'; en='No candidates found.'");
		Возврат Результат;
	КонецЕсли;

	СтрокиОтчёта = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл

		ИдентификаторОбработки = Строка(Кандидат.Ссылка.УникальныйИдентификатор());
		ЧтениеМанифеста = ar_ToolПакеты.ПрочитатьМанифестКандидата(ИдентификаторОбработки);

		Если Не ЧтениеМанифеста.Успех Тогда
			СтрокиОтчёта.Добавить(СтрШаблон(
				НСтр("ru='%1 (версия %2, %3): манифест не читается — %4';
					|en='%1 (version %2, %3): manifest cannot be read — %4'"),
				Кандидат.ИмяОбъекта, Кандидат.Версия, РежимБезопасностиТекст(Кандидат.БезопасныйРежим),
				ЧтениеМанифеста.Причина));
			Продолжить;
		КонецЕсли;

		Валидация = ar_ToolПакеты.ВалидироватьМанифест(ЧтениеМанифеста.Манифест, ИдентификаторОбработки);

		Если Валидация.Корректно Тогда
			КоличествоTools = 0;
			Если ТипЗнч(ЧтениеМанифеста.Манифест.Tools) = Тип("Массив") Тогда
				КоличествоTools = ЧтениеМанифеста.Манифест.Tools.Количество();
			КонецЕсли;
			СтрокиОтчёта.Добавить(СтрШаблон(
				НСтр("ru='%1 (версия %2, %3): готов к установке, инструментов: %4';
					|en='%1 (version %2, %3): ready to install, tools: %4'"),
				Кандидат.ИмяОбъекта, Кандидат.Версия, РежимБезопасностиТекст(Кандидат.БезопасныйРежим),
				КоличествоTools));
		Иначе
			СтрокиОтчёта.Добавить(СтрШаблон(
				НСтр("ru='%1 (версия %2, %3): ошибки валидации — %4';
					|en='%1 (version %2, %3): validation errors — %4'"),
				Кандидат.ИмяОбъекта, Кандидат.Версия, РежимБезопасностиТекст(Кандидат.БезопасныйРежим),
				ТекстОшибокВалидации(Валидация.Ошибки)));
		КонецЕсли;

	КонецЦикла;

	Результат.ТекстСообщения = СтрСоединить(СтрокиОтчёта, Символы.ПС);
	Возврат Результат;

КонецФункции

// Готовит данные для диалога подтверждения установки: перечитывает манифест
// текущего кандидата и возвращает сведения, нужные клиенту для текста вопроса.
//
&НаСервере
Функция ПодготовитьУстановкуПакетаНаСервере(Знач ИдентификаторОбработки)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстСообщения", "");
	Результат.Вставить("БезопасныйРежим", Истина);
	Результат.Вставить("ИмяОбъекта", "");
	Результат.Вставить("КоличествоTools", 0);
	Результат.Вставить("СписокTools", "");

	ЧтениеМанифеста = ar_ToolПакеты.ПрочитатьМанифестКандидата(ИдентификаторОбработки);
	Если Не ЧтениеМанифеста.Успех Тогда
		Результат.ТекстСообщения = СтрШаблон(
			НСтр("ru='Манифест не читается: %1'; en='Manifest cannot be read: %1'"),
			ЧтениеМанифеста.Причина);
		Возврат Результат;
	КонецЕсли;

	Валидация = ar_ToolПакеты.ВалидироватьМанифест(ЧтениеМанифеста.Манифест, ИдентификаторОбработки);
	Если Не Валидация.Корректно Тогда
		Результат.ТекстСообщения = ТекстОшибокВалидации(Валидация.Ошибки);
		Возврат Результат;
	КонецЕсли;

	Кандидаты = ar_ToolПакеты.НайтиКандидатов();
	БезопасныйРежим = Истина;
	ИмяОбъекта = "";
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Строка(Кандидат.Ссылка.УникальныйИдентификатор()) = ИдентификаторОбработки Тогда
			БезопасныйРежим = Кандидат.БезопасныйРежим;
			ИмяОбъекта = Кандидат.ИмяОбъекта;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ИменаTools = Новый Массив;
	Если ТипЗнч(ЧтениеМанифеста.Манифест.Tools) = Тип("Массив") Тогда
		Для Каждого ОписаниеTool Из ЧтениеМанифеста.Манифест.Tools Цикл
			ИмяTool = "";
			Если ТипЗнч(ОписаниеTool) = Тип("Структура") Тогда
				ОписаниеTool.Свойство("Имя", ИмяTool);
			КонецЕсли;
			Если Не ПустаяСтрока(ИмяTool) Тогда
				ИменаTools.Добавить(ИмяTool);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.БезопасныйРежим = БезопасныйРежим;
	Результат.ИмяОбъекта = ИмяОбъекта;
	Результат.КоличествоTools = ИменаTools.Количество();
	Результат.СписокTools = СтрСоединить(ИменаTools, ", ");
	Возврат Результат;

КонецФункции

// Обёртка ar_ToolПакеты.ЗарегистрироватьПакет() для клиента.
//
&НаСервере
Функция ЗарегистрироватьПакетНаСервере(Знач ИдентификаторОбработки)

	Результат = ar_ToolПакеты.ЗарегистрироватьПакет(ИдентификаторОбработки);
	Возврат Новый Структура(
		"Успех, КоличествоTools, ТекстСообщения",
		Результат.Успех, Результат.КоличествоTools, Результат.ПричинаОтказа);

КонецФункции

// Обёртка ar_ToolПакеты.ОтключитьПакет() для клиента.
//
&НаСервере
Функция ОтключитьПакетНаСервере(Знач ИдентификаторОбработки)

	Возврат ar_ToolПакеты.ОтключитьПакет(ИдентификаторОбработки);

КонецФункции

// Обёртка ar_ToolПакеты.ПроверитьХешиПакетов() для клиента.
//
&НаСервере
Функция ПроверитьХешиПакетовНаСервере()

	Возврат ar_ToolПакеты.ПроверитьХешиПакетов();

КонецФункции

// Единая точка обновления динамического списка после любой операции над
// пакетами - устраняет дублирование Элементы.Список.Обновить() по всем
// обработчикам команд формы.
//
&НаКлиенте
Процедура ОбновитьСписокПакетов()

	Элементы.Список.Обновить();

КонецПроцедуры

// Идентификатор пакета текущей строки списка (dimension регистра
// ar_ИдентификаторОбработки - тот же формат UUID, что использует ar_ToolПакеты).
//
&НаКлиенте
Функция ТекущийИдентификаторПакета()

	СтрокаТекущая = Элементы.Список.ТекущиеДанные;
	Если СтрокаТекущая = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат "" + СтрокаТекущая.ar_ИдентификаторОбработки;

КонецФункции

// Человекочитаемый список ошибок валидации манифеста (PKG-06 D3): коды из
// ar_ToolПакеты.ВалидироватьМанифест(...).Ошибки переводятся в текст, не
// показываются как есть.
//
&НаСервереБезКонтекста
Функция ТекстОшибокВалидации(Знач Ошибки)

	Тексты = Новый Массив;
	Для Каждого Код Из Ошибки Цикл
		Тексты.Добавить(ТекстОднойОшибкиВалидации(Код));
	КонецЦикла;
	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

// Переводит один код ошибки ar_ToolПакеты.ВалидироватьМанифест(...).Ошибки
// в человекочитаемый текст (PKG-06 D3). Коды вида "код:параметр" - параметр
// подставляется в шаблон текста; неизвестный код показывается как есть,
// чтобы новые коды валидации не терялись молча.
//
&НаСервереБезКонтекста
Функция ТекстОднойОшибкиВалидации(Знач Код)

	ПозицияДвоеточия = СтрНайти(Код, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Мнемоника = Лев(Код, ПозицияДвоеточия - 1);
		Параметр   = Сред(Код, ПозицияДвоеточия + 1);
	Иначе
		Мнемоника = Код;
		Параметр   = "";
	КонецЕсли;

	Если Мнемоника = "unsupported_schema_version" Тогда
		Возврат СтрШаблон(НСтр("ru='Неподдерживаемая версия схемы манифеста: %1'; en='Unsupported manifest schema version: %1'"), Параметр);
	ИначеЕсли Мнемоника = "invalid_namespace" Тогда
		Возврат СтрШаблон(НСтр("ru='Некорректный namespace пакета: %1'; en='Invalid package namespace: %1'"), Параметр);
	ИначеЕсли Мнемоника = "namespace_collision" Тогда
		Возврат СтрШаблон(НСтр("ru='Namespace «%1» уже занят другим пакетом'; en='Namespace ""%1"" is already used by another package'"), Параметр);
	ИначеЕсли Мнемоника = "invalid_package_version" Тогда
		Возврат НСтр("ru='Не заполнена или некорректна версия пакета'; en='Package version is missing or invalid'");
	ИначеЕсли Мнемоника = "package_has_no_tools" Тогда
		Возврат НСтр("ru='В манифесте нет ни одного инструмента (Tools)'; en='The manifest has no tools'");
	ИначеЕсли Мнемоника = "name_not_namespaced" Тогда
		Возврат СтрШаблон(НСтр("ru='Имя инструмента «%1» не начинается с namespace пакета'; en='Tool name ""%1"" is not prefixed with the package namespace'"), Параметр);
	ИначеЕсли Мнемоника = "name_collision" Тогда
		Возврат СтрШаблон(НСтр("ru='Инструмент «%1» уже существует в ядре или другом пакете'; en='Tool ""%1"" already exists in the core or another package'"), Параметр);
	ИначеЕсли Мнемоника = "invalid_risk_level" Тогда
		Возврат СтрШаблон(НСтр("ru='Некорректный уровень риска инструмента «%1»'; en='Invalid risk level for tool ""%1""'"), Параметр);
	ИначеЕсли Мнемоника = "approval_required_for_risk" Тогда
		Возврат СтрШаблон(НСтр("ru='Инструмент «%1» с уровнем риска Write/Commit обязан требовать подтверждения'; en='Tool ""%1"" with Write/Commit risk level must require approval'"), Параметр);
	ИначеЕсли Мнемоника = "contradictory_risk_declaration" Тогда
		Возврат СтрШаблон(НСтр("ru='Инструмент «%1» уровня Read не может требовать подтверждения'; en='Read-level tool ""%1"" cannot require approval'"), Параметр);
	ИначеЕсли Мнемоника = "invalid_required_objects" Тогда
		Возврат СтрШаблон(НСтр("ru='Некорректный список требуемых объектов/подсистем у «%1»'; en='Invalid required objects/subsystems list for ""%1""'"), Параметр);
	ИначеЕсли Мнемоника = "invalid_tool_description" Тогда
		Возврат СтрШаблон(НСтр("ru='Не заполнено описание инструмента «%1»'; en='Tool ""%1"" description is missing'"), Параметр);
	ИначеЕсли Мнемоника = "invalid_tool_version" Тогда
		Возврат СтрШаблон(НСтр("ru='Не заполнена версия инструмента «%1»'; en='Tool ""%1"" version is missing'"), Параметр);
	ИначеЕсли Мнемоника = "manifest_name_mismatch" Тогда
		Возврат СтрШаблон(НСтр("ru='Имя в JSON-манифесте инструмента «%1» не совпадает с именем инструмента'; en='JSON manifest name for tool ""%1"" does not match the tool name'"), Параметр);
	ИначеЕсли Мнемоника = "invalid_tool_manifest" Тогда
		Возврат СтрШаблон(НСтр("ru='Некорректный JSON-манифест инструмента: %1'; en='Invalid tool JSON manifest: %1'"), Параметр);
	ИначеЕсли Мнемоника = "manifest_not_structure" Тогда
		Возврат НСтр("ru='Манифест пакета не является структурой'; en='Package manifest is not a structure'");
	Иначе
		// Неизвестный код - показываем как есть, чтобы новые коды валидации
		// не терялись молча.
		Возврат Код;
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Функция РежимБезопасностиТекст(Знач БезопасныйРежим)
	Если БезопасныйРежим Тогда
		Возврат НСтр("ru='безопасный режим'; en='safe mode'");
	Иначе
		Возврат НСтр("ru='НЕБЕЗОПАСНЫЙ режим'; en='UNSAFE mode'");
	КонецЕсли;
КонецФункции

#КонецОбласти
