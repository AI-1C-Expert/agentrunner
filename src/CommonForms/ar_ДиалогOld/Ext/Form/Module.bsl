////////////////////////////////////////////////////////////////////////////////
// Модуль формы ar_Диалог - Диалог с агентом (UI-22).
//
// Форма предоставляет пользователю интерфейс чата с агентом:
//   * Режим «с агентом»: выбрать агента, ввести задачу, получить ответ в истории.
//   * Режим «без агента»: выбрать tools + провайдер, запустить анонимно.
//
// Взаимодействие:
//   * ar_RuntimeЗапуск.СтартоватьВФоне / СтартоватьВФонеБезАгента - старт.
//   * ar_Approval.ОтветитьНаВопрос - ответ на ask_user.
//   * Адаптивный таймер: ПодключитьОбработчикОжидания (1→2→3→5→8→12→15 сек).
//
// Отображение истории диалога (UI-25):
//   * ar_ИсторияДиалога (ТаблицаЗначений) остаётся источником данных - скрыта на форме.
//   * Реквизит СтрокаHTML + элемент ПоказHTML (ПолеHTMLДокумента) - визуальный чат:
//     пузыри «сообщение отправлено/получено», статусы, вызовы tools, время.
//     Односторонний вывод - обратная связь из HTML/JS в BSL не используется.
//
// Запрещено: Выполнить(), Вычислить(), привилегированный режим.
// Строки UI - только через НСтр("ru=...; en=...").
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// Инициализация формы: реквизиты, видимость блоков, параметр ar_Агент.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Значения реквизитов по умолчанию.
	ТекущийRunId      = "";
	СтатусЗапуска     = "";
	ТекущийApprovalId = "";
	РежимБезАгента    = Ложь;
	ИнтервалОпроса    = 1;
	ПоследнийSequence = 0;

	// Подстановка агента из параметра открытия формы.
	Если Параметры.Свойство("ar_Агент") И ЗначениеЗаполнено(Параметры.ar_Агент) Тогда
		ВыбранныйАгент = Параметры.ar_Агент;
	КонецЕсли;

	// Управление видимостью блоков по режиму.
	УстановитьВидимостьБлоковНаСервере();

	// Начальная разметка чата - пустая история.
	СтрокаHTML = ar_СформироватьHTMLЧата(ar_ИсторияДиалога);

	// Уникальный ключ диалога на окно формы (SESS-05) - заполняется один раз,
	// используется как строковый якорь сессии (ar_Сессии.ar_Якорь) вместо
	// Пользователи.ТекущийПользователь() (справочник Пользователи не заимствован
	// в расширение). Собственный УникальныйИдентификатор(), не платформенный
	// Форма.УникальныйИдентификатор - последний переживает пересоздание формы
	// не всегда предсказуемо и не предназначен для бизнес-ключа.
	УникальныйКлючДиалога = "chat:" + Строка(Новый УникальныйИдентификатор());

	// SESS-Debug (диагностика в разработке, оставлено намеренно - см. SESS-05/
	// SESS-07/SESS-08): фиксируем каждое (пере)создание формы на сервере - если
	// ПриСозданииНаСервере срабатывает повторно для визуально одного и того же
	// открытого окна (веб-клиент, разрыв/восстановление соединения), Якорь
	// будет новым при каждом вызове, и история сессии перестанет находиться
	// при следующем сообщении.
	ar_СлужебныйЛог.Записать("ar_Диалог.ПриСозданииНаСервере", "form_created",
		СтрШаблон("НовыйЯкорь='%1'", УникальныйКлючДиалога));

КонецПроцедуры

// Предупреждение при закрытии формы с активным запуском.
// При подтверждении - таймер отключается, фоновое задание продолжает работу.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ПустаяСтрока(ТекущийRunId)
		ИЛИ ar_ЭтоФинальныйСтатус(СтатусЗапуска) Тогда
		Возврат;
	КонецЕсли;

	// Установить Отказ = Истина, чтобы платформа показала диалог подтверждения.
	Отказ = Истина;
	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");
	ТекстПредупреждения = НСтр(
		"ru='Агент продолжит работу в фоне. Закрыть форму?';
		|en='Agent will continue running in background. Close form?'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

// Отправить запрос агенту.
//
&НаКлиенте
Процедура ar_Отправить(Команда)

	// Валидация в зависимости от режима.
	Если РежимБезАгента Тогда
		Если НЕ ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
			ПоказатьПредупреждение(, НСтр(
				"ru='Выберите провайдера LLM.';
				|en='Please select an LLM provider.'"));
			Возврат;
		КонецЕсли;
		Если ar_ВыбранныеTools.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр(
				"ru='Добавьте хотя бы один tool.';
				|en='Please add at least one tool.'"));
			Возврат;
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ВыбранныйАгент) Тогда
			ПоказатьПредупреждение(, НСтр(
				"ru='Выберите агента или включите режим без агента.';
				|en='Please select an agent or enable no-agent mode.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		// Не отправлять пустой запрос - фокус на поле ввода.
		ТекущийЭлемент = Элементы.ar_ТекстЗапроса;
		Возврат;
	КонецЕсли;

	ТекстПользователя = ТекстЗапроса;
	ТекстЗапроса = "";

	// Добавить сообщение пользователя и строку-статус в историю.
	ar_ДобавитьСтрокуИстории("user", ТекстПользователя, ТекущаяДата(), Ложь);
	ar_ДобавитьСтрокуИстории("status",
		НСтр("ru='Агент думает...'; en='Agent is thinking...'"),
		ТекущаяДата(), Ложь);

	// Запустить агента на сервере.
	ar_НачатьЗапускНаСервере(ТекстПользователя);

	// Активировать таймер и обновить доступность кнопок.
	ar_ЗапуститьТаймер(1);
	ar_ОбновитьДоступностьКнопок();

КонецПроцедуры

// Остановить текущий запуск.
//
&НаКлиенте
Процедура ar_Остановить(Команда)

	Если ПустаяСтрока(ТекущийRunId) Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");
	ar_ОстановитьНаСервере(ТекущийRunId);

	ar_ДобавитьСтрокуИстории("status",
		НСтр("ru='Остановлено пользователем.'; en='Stopped by user.'"),
		ТекущаяДата(), Ложь);

	СтатусЗапуска = "cancelled";
	ar_ОбновитьДоступностьКнопок();

КонецПроцедуры

// Ответить на вопрос ask_user.
//
&НаКлиенте
Процедура ar_Ответить(Команда)

	Если ПустаяСтрока(ТекущийApprovalId) Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ОтветПользователя) Тогда
		ТекущийЭлемент = Элементы.ar_ОтветПользователя;
		Возврат;
	КонецЕсли;

	ТекстОтвета    = ОтветПользователя;
	IDApproval     = ТекущийApprovalId;
	ОтветПользователя = "";
	ТекущийApprovalId = "";

	ar_ОтветитьНаВопросНаСервере(IDApproval, ТекстОтвета);

	Элементы.ГруппаAskUser.Видимость  = Ложь;
	Элементы.НадписьВопроса.Заголовок = "";

	ar_ДобавитьСтрокуИстории("user", ТекстОтвета, ТекущаяДата(), Ложь);

	// Перезапустить таймер с минимальным интервалом - ждём возобновления.
	ИнтервалОпроса = 1;
	ПодключитьОбработчикОжидания("ar_ОпросСтатуса", 1);

КонецПроцедуры

// Открыть Run Viewer для текущего запуска.
//
&НаКлиенте
Процедура ar_ОткрытьRunViewer(Команда)

	Если ПустаяСтрока(ТекущийRunId) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФорму("ОбщаяФорма.ar_ПросмотрЗапуска",
		Новый Структура("RunId", ТекущийRunId));

КонецПроцедуры

// Открыть форму очереди подтверждений.
//
&НаКлиенте
Процедура ar_ОткрытьОчередь(Команда)

	ОткрытьФорму("ОбщаяФорма.ar_ОчередьПодтверждений");

КонецПроцедуры

// Собрать служебный лог по всем audit-объектам расширения и показать в
// текстовом документе (UI-22: диагностика служебных данных).
//
&НаКлиенте
Процедура ar_ПоказатьЛог(Команда)

	ТекстЛога = ar_СобратьСлужебныйЛогНаСервере();

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ТекстЛога);
	Документ.Показать(НСтр("ru='Служебный лог AgentRunner'; en='AgentRunner service log'"));

КонецПроцедуры

// Очистить все служебные регистры/справочники расширения (кроме
// ar_ХранилищеСекретов). Необратимо, без диалога подтверждения (UI-22).
//
&НаКлиенте
Процедура ar_ОчиститьЛог(Команда)

	Результат = ar_ОчиститьСлужебныеДанныеНаСервере();

	Если Результат.Успех Тогда
		ТекстОповещения = СтрШаблон(
			НСтр("ru='Служебные данные очищены. Удалено записей: %1';
				|en='Service data cleared. Deleted rows: %1'"),
			Результат.ВсегоУдалено);
		ПоказатьОповещениеПользователя(ТекстОповещения);
	Иначе
		// Подробности ошибок - только в audit-событии AuditPurged (пишет сервер),
		// пользователю - краткая сводка без стека вызовов.
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru='Очистка завершена с ошибками (%1 из %2 источников). Удалено записей: %3. Подробности - в служебном логе.';
				|en='Cleanup finished with errors (%1 of %2 sources). Deleted rows: %3. See service log for details.'"),
			Результат.КоличествоОшибок,
			Результат.ВсегоИсточников,
			Результат.ВсегоУдалено);
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Переключение режима «без агента» / «с агентом».
//
&НаКлиенте
Процедура ar_ПереключитьРежим(Элемент)

	Элементы.ГруппаРежим.Видимость     = НЕ РежимБезАгента;
	Элементы.ГруппаБезАгента.Видимость = РежимБезАгента;

КонецПроцедуры

#КонецОбласти

#Область ТаймерОпроса

// Обработчик ожидания - опрос статуса запуска.
// Вызывается платформой по истечении интервала.
//
&НаКлиенте
Процедура ar_ОпросСтатуса()

	// Отключаем таймер перед серверным вызовом, чтобы не накапливались вызовы.
	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");

	Если ПустаяСтрока(ТекущийRunId) Тогда
		Возврат;
	КонецЕсли;

	Результат = ar_ПолучитьОбновленияНаСервере(ТекущийRunId, ПоследнийSequence);

	// Сначала обрабатываем обновления - чтобы финальные события не пропустились.
	ar_ОбработатьОбновления(Результат);

	// Если статус нефинальный - перезапустить таймер с увеличенным интервалом.
	Если НЕ ar_ЭтоФинальныйСтатус(Результат.СтатусЗапуска) Тогда
		ИнтервалОпроса = ar_СледующийИнтервал(ИнтервалОпроса);
		ПодключитьОбработчикОжидания("ar_ОпросСтатуса", ИнтервалОпроса);
	КонецЕсли;

КонецПроцедуры

// Обработать пакет обновлений, полученных с сервера.
//
&НаКлиенте
Процедура ar_ОбработатьОбновления(Результат)

	// Обновить статус запуска из ответа сервера.
	Если ЗначениеЗаполнено(Результат.СтатусЗапуска) Тогда
		СтатусЗапуска = Результат.СтатусЗапуска;
	КонецЕсли;

	// Обработать ask_user, если сервер вернул AskUserApprovalId.
	Если ЗначениеЗаполнено(Результат.AskUserApprovalId)
		И ТекущийApprovalId <> Результат.AskUserApprovalId Тогда
		ТекущийApprovalId = Результат.AskUserApprovalId;
		ТекстВопроса      = Результат.AskUserВопрос;
		ar_ДобавитьСтрокуИстории("ask_user", ТекстВопроса, ТекущаяДата(), Ложь);
		Элементы.НадписьВопроса.Заголовок = ТекстВопроса;
		Элементы.ГруппаAskUser.Видимость  = Истина;
	КонецЕсли;

	// Обработать новые события.
	Для Каждого Событие Из Результат.НовыеСобытия Цикл

		ТипСобытия = Событие.ТипСобытия;
		ВремяСоб   = Событие.Время;

		Если ТипСобытия = "LLMCalled" Тогда
			ТекстLLM = "";
			Если Событие.Свойство("ТекстОтвета") Тогда
				ТекстLLM = Событие.ТекстОтвета;
			КонецЕсли;
			Если НЕ ПустаяСтрока(ТекстLLM) Тогда
				ar_ДобавитьСтрокуИстории("assistant", ТекстLLM, ВремяСоб, Ложь);
			КонецЕсли;

		ИначеЕсли ТипСобытия = "ToolCalled" Тогда
			ТекстТула = "";
			Если Событие.Свойство("ИмяТула") Тогда
				ТекстТула = Событие.ИмяТула;
			КонецЕсли;
			// tool_result скрыт по умолчанию (Скрытый = Истина).
			ar_ДобавитьСтрокуИстории("tool_result",
				НСтр("ru='Вызван tool: '; en='Tool called: '") + ТекстТула,
				ВремяСоб, Истина);

		ИначеЕсли ТипСобытия = "Completed" Тогда
			ТекстОтветаЗавершено = "";
			Если Событие.Свойство("ТекстОтвета") Тогда
				ТекстОтветаЗавершено = Событие.ТекстОтвета;
			КонецЕсли;
			Если НЕ ПустаяСтрока(ТекстОтветаЗавершено) Тогда
				ar_ДобавитьСтрокуИстории("assistant", ТекстОтветаЗавершено, ВремяСоб, Ложь);
			КонецЕсли;
			ar_ДобавитьСтрокуИстории("status",
				НСтр("ru='Завершено.'; en='Completed.'"), ВремяСоб, Ложь);

		ИначеЕсли ТипСобытия = "Failed" Тогда
			ТекстОш = "";
			Если Событие.Свойство("ТекстОшибки") Тогда
				ТекстОш = Событие.ТекстОшибки;
			КонецЕсли;
			ar_ДобавитьСтрокуИстории("status",
				НСтр("ru='Ошибка: '; en='Error: '") + ТекстОш, ВремяСоб, Ложь);

		Иначе
			// Прочие типы событий не отображаем в истории диалога.
			Продолжить;

		КонецЕсли;

		// Сдвинуть указатель прочитанных событий.
		СиквенсСобытия = 0;
		Если Событие.Свойство("Sequence") Тогда
			СиквенсСобытия = Событие.Sequence;
		КонецЕсли;
		Если СиквенсСобытия > ПоследнийSequence Тогда
			ПоследнийSequence = СиквенсСобытия;
		КонецЕсли;

	КонецЦикла;

	// Обработка статуса paused_for_approval (не ask_user).
	Если СтатусЗапуска = "PausedForApproval"
		И ПустаяСтрока(ТекущийApprovalId) Тогда
		ar_ДобавитьСтрокуИстории("status",
			НСтр("ru='Ожидает подтверждения оператором.';
			|en='Waiting for operator approval.'"),
			ТекущаяДата(), Ложь);
	КонецЕсли;

	// Обновить доступность кнопок - единая точка управления.
	ar_ОбновитьДоступностьКнопок();

КонецПроцедуры

#КонецОбласти

#Область СерверныеМетоды

// Запустить агента в фоновом задании.
//
&НаСервере
Процедура ar_НачатьЗапускНаСервере(Знач ТекстПользователя)

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("ЗапросПользователя", ТекстПользователя);
	// Якорь сессии (SESS-02/04/05) - без него ar_RuntimeЦикл.ПодмешатьИсториюСессии
	// не находит запись ar_Сессии, и каждое сообщение чата стартует без контекста
	// предыдущих сообщений этого же диалога. УникальныйКлючДиалога генерируется
	// один раз на окно формы (ПриСозданииНаСервере) - формат "chat:<uuid>",
	// что даёт многосессийность (разные окна = разные сессии), в отличие от
	// прежнего Пользователи.ТекущийПользователь() (справочник не заимствован,
	// платформа тихо превращала ссылку в Undefined при записи в регистр).
	КонтекстТриггера.Вставить("ЯкорьСсылка", УникальныйКлючДиалога);
	// UUID пользователя ИБ - инициатора диалога (SESS-05), для ресурса
	// ar_Сессии.ar_Пользователь (отбор "мои сессии", не входит в ключ записи).
	КонтекстТриггера.Вставить("ПользовательUUID",
		Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор));

	Если РежимБезАгента Тогда

		// Собрать список имён tools из табличной части. Имя берётся из
		// справочника (СтрокаТула.Tool.ar_Имя), а не из ручной колонки Имя -
		// последняя не заполняется автоматически при выборе Tool и может
		// остаться пустой, из-за чего ОпределенияOverrideTools не находит
		// манифест и LLM получает пустой список tools.
		СписокTools = Новый Массив;
		Для Каждого СтрокаТула Из ar_ВыбранныеTools Цикл
			Если ЗначениеЗаполнено(СтрокаТула.Tool) Тогда
				СписокTools.Добавить(СтрокаТула.Tool.ar_Имя);
			КонецЕсли;
		КонецЦикла;

		КонтекстТриггера.Вставить("БезАгента",         Истина);
		КонтекстТриггера.Вставить("ОверрайдTools",     СписокTools);
		КонтекстТриггера.Вставить("ОверрайдПровайдер", ВыбранныйПровайдер);
		КонтекстТриггера.Вставить("Триггер",            "manual_chat_no_agent");

		РезЗапуска = ar_RuntimeЗапуск.СтартоватьВФонеБезАгента(КонтекстТриггера);

	Иначе

		КонтекстТриггера.Вставить("Триггер", "manual_chat");
		РезЗапуска = ar_RuntimeЗапуск.СтартоватьВФоне(ВыбранныйАгент, КонтекстТриггера);

	КонецЕсли;

	Если РезЗапуска.Успех Тогда
		ТекущийRunId  = РезЗапуска.RunId;
		СтатусЗапуска = "Running";
		// Sequence нумеруется заново для каждого RunId (см. ar_СобытияЗапуска) -
		// без сброса опрос нового запуска фильтрует все его события условием
		// ar_Sequence > &ПоследнийSequence, унаследованным от предыдущего запуска.
		ПоследнийSequence = 0;
	Иначе
		ТекущийRunId  = "";
		СтатусЗапуска = "Failed";
		// ВРЕМЕННО (диагностика UI-22): постановка фонового задания не удалась
		// ДО входа в ar_RuntimeЦикл - РезЗапуска.Причина содержит очищенный
		// текст исходного исключения (см. ar_RuntimeЗапуск.ПричинаПоИсключению).
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("ar_RuntimeЗапуск: не удалось поставить задание. Причина: %1",
				РезЗапуска.Причина));
	КонецЕсли;

КонецПроцедуры

// Получить новые события и текущий статус запуска.
//
// Параметры:
//  RunId             - Строка(36) - идентификатор запуска.
//  ПоследнийSequence - Число - последний прочитанный sequence.
//
// Возвращаемое значение:
//  Структура:
//    * НовыеСобытия      - Массив структур {Sequence, ТипСобытия, Время, ...}
//    * СтатусЗапуска     - Строка (имя значения перечисления ar_СтатусЗапуска)
//    * AskUserApprovalId - Строка(36) - заполнен при PausedForInput
//    * AskUserВопрос     - Строка - текст вопроса агента
//    * AskUserChoices    - Массив - варианты ответа (макс. 20)
//
&НаСервере
Функция ar_ПолучитьОбновленияНаСервере(Знач RunId, Знач ПоследнийSequence)

	Результат = Новый Структура;
	Результат.Вставить("НовыеСобытия",      Новый Массив);
	Результат.Вставить("СтатусЗапуска",     "");
	Результат.Вставить("AskUserApprovalId", "");
	Результат.Вставить("AskUserВопрос",     "");
	Результат.Вставить("AskUserChoices",    Новый Массив);

	Если ПустаяСтрока(RunId) Тогда
		Возврат Результат;
	КонецЕсли;

	// 1. Читаем статус и новые события единым запросом.
	ЗапросСобытий = Новый Запрос;
	ЗапросСобытий.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СобытияЗапуска.ar_Sequence КАК ЧИСЛО(10, 0)) КАК Sequence,
		|	СобытияЗапуска.ar_МоментВремени КАК Время,
		|	СобытияЗапуска.ar_ТипСобытия   КАК ТипСобытияСсылка,
		|	СобытияЗапуска.ar_PayloadJSON  КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК СобытияЗапуска
		|ГДЕ
		|	СобытияЗапуска.ar_RunId = &RunId
		|	И СобытияЗапуска.ar_Sequence > &ПоследнийSequence
		|УПОРЯДОЧИТЬ ПО
		|	СобытияЗапуска.ar_Sequence ВОЗР";

	ЗапросСобытий.УстановитьПараметр("RunId",             RunId);
	ЗапросСобытий.УстановитьПараметр("ПоследнийSequence", ПоследнийSequence);

	ВыборкаСобытий = ЗапросСобытий.Выполнить().Выбрать();
	Пока ВыборкаСобытий.Следующий() Цикл
		СтруктураСоб = Новый Структура;
		СтруктураСоб.Вставить("Sequence", ВыборкаСобытий.Sequence);
		СтруктураСоб.Вставить("Время",    ВыборкаСобытий.Время);

		СтруктураСоб.Вставить("ТипСобытия", ar_ИмяТипаСобытия(ВыборкаСобытий.ТипСобытияСсылка));

		// Распаковать PayloadJSON для отображения в истории.
		ЗаполнитьПолезнуюНагрузкуСобытия(СтруктураСоб, ВыборкаСобытий.PayloadJSON);

		Результат.НовыеСобытия.Добавить(СтруктураСоб);
	КонецЦикла;

	// 2. Читаем статус из ar_Запуски.
	ЗапросЗапуска = Новый Запрос;
	ЗапросЗапуска.Текст =
		"ВЫБРАТЬ
		|	Запуски.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_RunId = &RunId";
	ЗапросЗапуска.УстановитьПараметр("RunId", RunId);

	ВыборкаЗапуска = ЗапросЗапуска.Выполнить().Выбрать();
	Если ВыборкаЗапуска.Следующий() Тогда
		Результат.СтатусЗапуска = ar_ИмяСтатусаЗапуска(ВыборкаЗапуска.Статус);
	КонецЕсли;

	// 3. При PausedForInput - ищем запись ask_user в очереди Approval.
	Если Результат.СтатусЗапуска = "PausedForInput" Тогда
		ЗаполнитьДанныеAskUser(Результат, RunId);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Отправить ответ на вопрос ask_user.
//
&НаСервере
Процедура ar_ОтветитьНаВопросНаСервере(Знач ApprovalId, Знач ТекстОтвета)

	ТекущийПользователь = Пользователи.ТекущийПользователь();
	ar_Approval.ОтветитьНаВопрос(ApprovalId, ТекущийПользователь, ТекстОтвета);

КонецПроцедуры

// Отменить текущий запуск на сервере.
//
&НаСервере
Процедура ar_ОстановитьНаСервере(Знач RunId)

	ar_RuntimeЗапуск.Отменить(RunId);

КонецПроцедуры

// Собрать служебный лог всех audit-объектов расширения в виде текста
// (UI-22). ТекстовыйДокумент не передаётся между клиентом и сервером напрямую -
// возвращаем его содержимое строкой, документ на клиенте создаётся заново.
//
// Возвращаемое значение:
//  Строка - готовый текст лога.
//
&НаСервере
Функция ar_СобратьСлужебныйЛогНаСервере()

	Возврат ar_ДиагностикаОчистка.СобратьСлужебныйЛог().ПолучитьТекст();

КонецФункции

// Очистить все служебные регистры/справочники расширения (UI-22).
//
// Возвращаемое значение:
//  Структура - {Успех (Булево), ВсегоУдалено (Число), ТекстОшибок (Строка)}.
//
&НаСервере
Функция ar_ОчиститьСлужебныеДанныеНаСервере()

	РезультатОчистки = ar_ДиагностикаОчистка.ОчиститьСлужебныеДанные();

	// Источников очистки - 9 регистров + справочник ar_ПамятьАгента
	// (см. заголовок ar_ДиагностикаОчистка). Не выводим полные тексты ошибок
	// (стек вызовов) на клиента - только счётчики; подробности - в audit-событии.
	ВсегоИсточников = 10;

	Результат = Новый Структура;
	Результат.Вставить("Успех",           РезультатОчистки.УспехОбщий);
	Результат.Вставить("ВсегоУдалено",    РезультатОчистки.ВсегоУдалено);
	Результат.Вставить("КоличествоОшибок", РезультатОчистки.Ошибки.Количество());
	Результат.Вставить("ВсегоИсточников", ВсегоИсточников);

	Возврат Результат;

КонецФункции

// Установить начальную видимость и доступность элементов формы.
//
&НаСервере
Процедура УстановитьВидимостьБлоковНаСервере()

	Элементы.ГруппаРежим.Видимость     = НЕ РежимБезАгента;
	Элементы.ГруппаБезАгента.Видимость = РежимБезАгента;
	Элементы.ГруппаAskUser.Видимость   = Ложь;

	// Интерактивные кнопки - начальное состояние.
	Элементы.ar_Остановить.Доступность        = Ложь;
	Элементы.ar_ОткрытьRunViewer.Доступность  = Ложь;
	Элементы.ar_ОткрытьОчередь.Доступность    = Ложь;

КонецПроцедуры

// Сопоставить значение перечисления ar_СтатусЗапуска с его именем для передачи на клиент.
//
// Параметры:
//  Статус - ПеречислениеСсылка.ar_СтатусЗапуска - значение перечисления.
//
// Возвращаемое значение:
//  Строка - имя значения перечисления.
//
&НаСервере
Функция ar_ИмяСтатусаЗапуска(Знач Статус)

	Если Статус = Перечисления.ar_СтатусЗапуска.Running Тогда
		Возврат "Running";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.PausedForApproval Тогда
		Возврат "PausedForApproval";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.PausedForInput Тогда
		Возврат "PausedForInput";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Completed Тогда
		Возврат "Completed";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Failed Тогда
		Возврат "Failed";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Cancelled Тогда
		Возврат "cancelled";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.MaxStepsReached Тогда
		Возврат "MaxStepsReached";
	ИначеЕсли Статус = Перечисления.ar_СтатусЗапуска.Interrupted Тогда
		Возврат "Interrupted";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Сопоставить значение перечисления ar_ТипСобытия с его именем для передачи на клиент.
//
// Параметры:
//  ТипСобытияСсылка - ПеречислениеСсылка.ar_ТипСобытия - значение перечисления.
//
// Возвращаемое значение:
//  Строка - имя значения перечисления, либо пустая строка для незначимых типов.
//
&НаСервере
Функция ar_ИмяТипаСобытия(Знач ТипСобытияСсылка)

	Если ТипСобытияСсылка = Перечисления.ar_ТипСобытия.LLMCalled Тогда
		Возврат "LLMCalled";
	ИначеЕсли ТипСобытияСсылка = Перечисления.ar_ТипСобытия.ToolCalled Тогда
		Возврат "ToolCalled";
	ИначеЕсли ТипСобытияСсылка = Перечисления.ar_ТипСобытия.Completed Тогда
		Возврат "Completed";
	ИначеЕсли ТипСобытияСсылка = Перечисления.ar_ТипСобытия.Failed Тогда
		Возврат "Failed";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Распаковать PayloadJSON события и добавить прикладные поля в структуру.
//
&НаСервере
Процедура ЗаполнитьПолезнуюНагрузкуСобытия(СтруктураСоб, Знач PayloadJSON)

	Если ПустаяСтрока(PayloadJSON) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// ar_JSON.ИзJSON возвращает JSON-объекты как Соответствие (не Структуру) -
		// доступ через Получить(), а не через точечную нотацию/Свойство().
		Payload = ar_JSON.ИзJSON(PayloadJSON);
		Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
			Возврат;
		КонецЕсли;
		// Текст ответа LLM.
		ТекстОтвета = Payload.Получить("content");
		Если ТекстОтвета = Неопределено Тогда
			ТекстОтвета = Payload.Получить("text");
		КонецЕсли;
		Если ТекстОтвета <> Неопределено Тогда
			СтруктураСоб.Вставить("ТекстОтвета", ТекстОтвета);
		КонецЕсли;
		// Имя вызванного tool.
		ИмяТула = Payload.Получить("tool_name");
		Если ИмяТула <> Неопределено Тогда
			СтруктураСоб.Вставить("ИмяТула", ИмяТула);
		КонецЕсли;
		// Текст ошибки (санированный).
		ТекстОшибки = Payload.Получить("error");
		Если ТекстОшибки <> Неопределено Тогда
			СтруктураСоб.Вставить("ТекстОшибки",
				ar_Утилиты.ОчиститьОшибкуДляLLM(ТекстОшибки));
		КонецЕсли;
	Исключение
		// Ошибки парсинга payload не критичны для отображения истории.
	КонецПопытки;

КонецПроцедуры

// Заполнить данные ask_user из ar_ОчередьApproval.
//
&НаСервере
Процедура ЗаполнитьДанныеAskUser(Результат, Знач RunId)

	// Константа 20 - максимум вариантов ответа согласно TOOL-19.
	МаксВариантов = 20;

	ЗапросApproval = Новый Запрос;
	ЗапросApproval.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.ar_ApprovalId        КАК ApprovalId,
		|	Очередь.ar_ActionPayloadJSON КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_RunId   = &RunId
		|	И Очередь.ar_Статус = &Статус";

	ЗапросApproval.УстановитьПараметр("RunId",  RunId);
	ЗапросApproval.УстановитьПараметр("Статус", "awaiting_input");

	ВыборкаApproval = ЗапросApproval.Выполнить().Выбрать();
	Если НЕ ВыборкаApproval.Следующий() Тогда
		Возврат;
	КонецЕсли;

	Результат.AskUserApprovalId = ВыборкаApproval.ApprovalId;

	Если ПустаяСтрока(ВыборкаApproval.PayloadJSON) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// ar_JSON.ИзJSON возвращает JSON-объекты как Соответствие (не Структуру) -
		// доступ через Получить(), а не через точечную нотацию/Свойство().
		AskPayload = ar_JSON.ИзJSON(ВыборкаApproval.PayloadJSON);
		Если ТипЗнч(AskPayload) <> Тип("Соответствие") Тогда
			Возврат;
		КонецЕсли;
		Вопрос = AskPayload.Получить("question");
		Если Вопрос <> Неопределено Тогда
			Результат.AskUserВопрос = Вопрос;
		КонецЕсли;
		Варианты = AskPayload.Получить("choices");
		Если ТипЗнч(Варианты) = Тип("Массив") Тогда
			КолВоВариантов = Мин(Варианты.Количество(), МаксВариантов);
			Для Инд = 0 По КолВоВариантов - 1 Цикл
				Результат.AskUserChoices.Добавить(Варианты[Инд]);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Ошибки парсинга payload ask_user не критичны.
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОтображениеЧата

// Сформировать HTML-разметку истории диалога в виде чата (пузыри сообщений).
//
// Параметры:
//  История - ТаблицаЗначений - ar_ИсторияДиалога (Роль, Текст, Время, Скрытый, ApprovalId).
//
// Возвращаемое значение:
//  Строка - готовый HTML-документ для элемента ПоказHTML (ПолеHTMLДокумента).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_СформироватьHTMLЧата(Знач История)

	ТекстСообщений = "";
	Для Каждого СтрокаИстории Из История Цикл

		Если СтрокаИстории.Скрытый Тогда
			Продолжить;
		КонецЕсли;

		ТекстСообщений = ТекстСообщений + ar_HTMLПузыряСообщения(
			СтрокаИстории.Роль, СтрокаИстории.Текст, СтрокаИстории.Время);

	КонецЦикла;

	Возврат ar_HTMLКаркасЧата(ТекстСообщений);

КонецФункции

// Собрать HTML-пузырь одного сообщения чата в зависимости от роли.
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_HTMLПузыряСообщения(Знач Роль, Знач Текст, Знач Время)

	ВремяHTML = ar_ЭкранироватьHTML(Формат(Время, "ДФ=чч:мм:сс"));
	ТекстHTML = ar_ТекстВHTML(Текст);

	Если Роль = "user" Тогда

		Возврат
			"<div class=""ar-row ar-row-user"">"
			 + "<div class=""ar-bubble ar-bubble-user"">"
			 + "<div class=""ar-meta"">" + НСтр("ru='Вы'; en='You'") + "</div>"
			 + "<div class=""ar-text"">" + ТекстHTML + "</div>"
			 + "<div class=""ar-time"">" + ВремяHTML + " ✓✓</div>"
			 + "</div></div>";

	ИначеЕсли Роль = "assistant" Тогда

		Возврат
			"<div class=""ar-row ar-row-assistant"">"
			 + "<div class=""ar-bubble ar-bubble-assistant"">"
			 + "<div class=""ar-meta"">" + НСтр("ru='Агент'; en='Agent'") + "</div>"
			 + "<div class=""ar-text"">" + ТекстHTML + "</div>"
			 + "<div class=""ar-time"">" + ВремяHTML + "</div>"
			 + "</div></div>";

	ИначеЕсли Роль = "tool_result" Тогда

		Возврат
			"<div class=""ar-row ar-row-system"">"
			 + "<div class=""ar-chip ar-chip-tool"">🛠 " + ТекстHTML
			 + " <span class=""ar-time-inline"">" + ВремяHTML + "</span></div>"
			 + "</div>";

	ИначеЕсли Роль = "ask_user" Тогда

		Возврат
			"<div class=""ar-row ar-row-assistant"">"
			 + "<div class=""ar-bubble ar-bubble-ask"">"
			 + "<div class=""ar-meta"">❓ "
			 + НСтр("ru='Вопрос агента'; en='Agent question'") + "</div>"
			 + "<div class=""ar-text"">" + ТекстHTML + "</div>"
			 + "<div class=""ar-time"">" + ВремяHTML + "</div>"
			 + "</div></div>";

	Иначе // "status" и прочие технические записи.

		Возврат
			"<div class=""ar-row ar-row-system"">"
			 + "<div class=""ar-chip ar-chip-status"">" + ТекстHTML
			 + " <span class=""ar-time-inline"">" + ВремяHTML + "</span></div>"
			 + "</div>";

	КонецЕсли;

КонецФункции

// Обернуть содержимое чата в HTML-документ со встроенными стилями.
// Стили и разметка - без внешних CDN и JS-зависимостей (офлайн-first).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_HTMLКаркасЧата(Знач ТекстСообщений)

	Возврат
		"<!DOCTYPE html><html><head><meta charset=""utf-8""><style>"
		 + "html,body{margin:0;padding:0;height:100%;background:#eef2f5;"
		 + "font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:13px;}"
		 + ".ar-chat{display:flex;flex-direction:column;padding:10px;box-sizing:border-box;}"
		 + ".ar-row{display:flex;margin-bottom:8px;}"
		 + ".ar-row-user{justify-content:flex-end;}"
		 + ".ar-row-assistant{justify-content:flex-start;}"
		 + ".ar-row-system{justify-content:center;}"
		 + ".ar-bubble{max-width:70%;padding:8px 12px;border-radius:12px;"
		 + "box-shadow:0 1px 1px rgba(0,0,0,0.08);word-wrap:break-word;}"
		 + ".ar-bubble-user{background:#d9fdd3;border-bottom-right-radius:2px;}"
		 + ".ar-bubble-assistant{background:#ffffff;border-bottom-left-radius:2px;}"
		 + ".ar-bubble-ask{background:#fff6d9;border:1px solid #f0d778;border-bottom-left-radius:2px;}"
		 + ".ar-meta{font-size:11px;font-weight:600;color:#6b7a8f;margin-bottom:2px;}"
		 + ".ar-text{white-space:pre-wrap;color:#1b1f23;line-height:1.4;}"
		 + ".ar-text strong{font-weight:600;}"
		 + ".ar-text em{font-style:italic;}"
		 + ".ar-text code{background:#eef1f5;border-radius:3px;padding:1px 4px;"
		 + "font-family:Consolas,Menlo,monospace;font-size:12px;}"
		 + ".ar-time{font-size:10px;color:#93a1ad;text-align:right;margin-top:3px;}"
		 + ".ar-chip{background:#e4e9ef;color:#5b6b7c;border-radius:10px;"
		 + "padding:3px 10px;font-size:11px;}"
		 + ".ar-chip-tool{background:#e8eefc;color:#3a5ba0;}"
		 + ".ar-chip-status{font-style:italic;}"
		 + ".ar-time-inline{color:#93a1ad;}"
		 + "</style></head><body><div class=""ar-chat"">"
		 + ТекстСообщений
		 + "<div id=""ar-anchor-end""></div>"
		 + "</div>"
		 + "<script>"
		 + "function ar_ПрокрутитьВниз(){"
		 + "window.scrollTo(0, document.body.scrollHeight);"
		 + "}"
		 + "window.onload = ar_ПрокрутитьВниз;"
		 + "setTimeout(ar_ПрокрутитьВниз, 50);"
		 + "</script>"
		 + "</body></html>";

КонецФункции

// Экранировать спецсимволы HTML в тексте (без изменения читаемости для пользователя).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	РезультатЭкранирования = СтрЗаменить(Текст,    "&", "&amp;");
	РезультатЭкранирования = СтрЗаменить(РезультатЭкранирования, "<", "&lt;");
	РезультатЭкранирования = СтрЗаменить(РезультатЭкранирования, ">", "&gt;");
	РезультатЭкранирования = СтрЗаменить(РезультатЭкранирования, """", "&quot;");
	РезультатЭкранирования = СтрЗаменить(РезультатЭкранирования, "'", "&#39;");

	Возврат РезультатЭкранирования;

КонецФункции

// Заменить простую markdown-разметку в уже HTML-экранированной строке на теги
// <strong>/<em>/<code>. Работает по парам маркеров слева направо; текст без
// парного маркера остаётся как есть (маркеры не вырезаются).
//
// Параметры:
//  Текст - Строка - HTML-экранированный текст (после ar_ЭкранироватьHTML).
//
// Возвращаемое значение:
//  Строка - текст с markdown-разметкой, преобразованной в HTML-теги.
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_РазметитьMarkdown(Знач Текст)

	Результат = ar_ЗаменитьПарныйМаркер(Текст,  "**", "<strong>", "</strong>");
	Результат = ar_ЗаменитьПарныйМаркер(Результат, "`",  "<code>",   "</code>");
	Результат = ar_ЗаменитьПарныйМаркер(Результат, "*",  "<em>",     "</em>");

	Возврат Результат;

КонецФункции

// Заменить парные вхождения маркера (например "**") открывающим и закрывающим
// HTML-тегом. Если количество вхождений маркера нечётное, последнее вхождение
// считается непарным и остаётся в тексте как есть (не заменяется).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ЗаменитьПарныйМаркер(Знач Текст, Знач Маркер, Знач ТегОткрытия, Знач ТегЗакрытия)

	ДлинаМаркера = СтрДлина(Маркер);

	// Сколько раз маркер встречается в тексте - определяет, сколько вхождений
	// участвует в парной замене (последнее нечётное - не трогаем).
	КоличествоВхождений = 0;
	Остаток = Текст;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, Маркер);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		КоличествоВхождений = КоличествоВхождений + 1;
		Остаток = Сред(Остаток, Позиция + ДлинаМаркера);
	КонецЦикла;

	Если КоличествоВхождений < 2 Тогда
		Возврат Текст;
	КонецЕсли;

	ВхожденийДляЗамены = КоличествоВхождений;
	Если КоличествоВхождений % 2 <> 0 Тогда
		ВхожденийДляЗамены = КоличествоВхождений - 1;
	КонецЕсли;

	Результат  = "";
	Остаток    = Текст;
	Обработано = 0;
	ОткрывающийНайден = Ложь;

	Пока Обработано < ВхожденийДляЗамены Цикл

		Позиция = СтрНайти(Остаток, Маркер);
		Результат = Результат + Лев(Остаток, Позиция - 1);

		Если ОткрывающийНайден Тогда
			Результат = Результат + ТегЗакрытия;
		Иначе
			Результат = Результат + ТегОткрытия;
		КонецЕсли;
		ОткрывающийНайден = НЕ ОткрывающийНайден;

		Остаток    = Сред(Остаток, Позиция + ДлинаМаркера);
		Обработано = Обработано + 1;

	КонецЦикла;

	Результат = Результат + Остаток;

	Возврат Результат;

КонецФункции

// Экранировать текст сообщения, разметить простой markdown (**жирный**,
// *курсив*, `код`) и заменить переносы строк на <br> для отображения в HTML.
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ТекстВHTML(Знач Текст)

	ЭкранированныйТекст = ar_ЭкранироватьHTML(Текст);
	ЭкранированныйТекст = ar_РазметитьMarkdown(ЭкранированныйТекст);
	ЭкранированныйТекст = СтрЗаменить(ЭкранированныйТекст, Символы.ПС, "<br>");

	Возврат ЭкранированныйТекст;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыКлиент

// Добавить строку в таблицу истории диалога.
//
// Параметры:
//  Роль       - Строка(20) - "user"/"assistant"/"tool_result"/"ask_user"/"status".
//  Текст      - Строка - текст сообщения.
//  Время      - Дата - момент события.
//  Скрытый    - Булево - признак скрытой технической записи.
//  ApprovalId - Строка(36) - заполнен для Роль="ask_user".
//
&НаКлиенте
Процедура ar_ДобавитьСтрокуИстории(
		Знач Роль,
		Знач Текст,
		Знач Время,
		Знач Скрытый,
		Знач ApprovalId = "")

	НоваяСтрока            = ar_ИсторияДиалога.Добавить();
	НоваяСтрока.Роль       = Роль;
	НоваяСтрока.Текст      = Текст;
	НоваяСтрока.Время      = Время;
	НоваяСтрока.Скрытый    = Скрытый;
	НоваяСтрока.ApprovalId = ApprovalId;

	СтрокаHTML = ar_СформироватьHTMLЧата(ar_ИсторияДиалога);

КонецПроцедуры

// Запустить или перезапустить таймер опроса.
//
&НаКлиенте
Процедура ar_ЗапуститьТаймер(Знач Интервал)

	ОтключитьОбработчикОжидания("ar_ОпросСтатуса");
	ИнтервалОпроса = Интервал;
	ПодключитьОбработчикОжидания("ar_ОпросСтатуса", Интервал);

КонецПроцедуры

// Обновить доступность кнопок по текущему состоянию формы.
// Единственная точка управления доступностью - вызывается из ar_ОбработатьОбновления
// и из ar_Отправить / ar_Остановить.
//
&НаКлиенте
Процедура ar_ОбновитьДоступностьКнопок()

	ЕстьАктивный = НЕ ПустаяСтрока(ТекущийRunId)
		И НЕ ar_ЭтоФинальныйСтатус(СтатусЗапуска);

	Элементы.ar_Отправить.Доступность       = НЕ ЕстьАктивный;
	Элементы.ar_Остановить.Доступность       = ЕстьАктивный;
	Элементы.ar_ОткрытьRunViewer.Доступность = НЕ ПустаяСтрока(ТекущийRunId);
	Элементы.ar_ОткрытьОчередь.Доступность   = (СтатусЗапуска = "PausedForApproval");

КонецПроцедуры

// Является ли статус запуска финальным (цикл завершён, опрос не нужен).
//
// Параметры:
//  Статус - Строка - имя значения перечисления ar_СтатусЗапуска.
//
// Возвращаемое значение:
//  Булево - Истина если статус финальный.
//
&НаКлиенте
Функция ar_ЭтоФинальныйСтатус(Знач Статус)

	Возврат Статус = "Completed"
		ИЛИ Статус = "Failed"
		ИЛИ Статус = "cancelled"
		ИЛИ Статус = "Interrupted"
		ИЛИ Статус = "MaxStepsReached";

КонецФункции

// Вычислить следующий интервал адаптивного таймера.
// Последовательность: 1→2→3→5→8→12→15→15→...
//
// Параметры:
//  ТекущийИнтервал - Число - текущий интервал в секундах.
//
// Возвращаемое значение:
//  Число - следующий интервал в секундах (не более 15).
//
&НаКлиенте
Функция ar_СледующийИнтервал(Знач ТекущийИнтервал)

	Если ТекущийИнтервал <= 1 Тогда
		Возврат 2;
	ИначеЕсли ТекущийИнтервал <= 2 Тогда
		Возврат 3;
	ИначеЕсли ТекущийИнтервал <= 3 Тогда
		Возврат 5;
	ИначеЕсли ТекущийИнтервал <= 5 Тогда
		Возврат 8;
	ИначеЕсли ТекущийИнтервал <= 8 Тогда
		Возврат 12;
	ИначеЕсли ТекущийИнтервал <= 12 Тогда
		Возврат 15;
	Иначе
		Возврат 15;
	КонецЕсли;

КонецФункции

#КонецОбласти
