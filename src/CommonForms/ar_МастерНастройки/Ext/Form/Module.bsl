		+ "</div><a id=""ar-nav"" href=""#"" style=""display:none""></a></body></html>";

КонецФункции

// Экранирует спецсимволы HTML (тот же контракт, что в ar_Настройки/ar_Диалог).
//
&НаКлиентеНаСервереБезКонтекста
Функция ar_ЭкранироватьHTML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст,    "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает имя действия из служебной ссылки "1c://<действие>?<параметры>".
//
&НаКлиентеНаСервереБезКонтекста
Функция ДействиеИзСсылки(Знач Ссылка)
	Тело = Сред(Ссылка, СтрДлина("1c://") + 1);
	ПозицияВопроса = СтрНайти(Тело, "?");
	Если ПозицияВопроса > 0 Тогда
		Тело = Лев(Тело, ПозицияВопроса - 1);
	КонецЕсли;
	Возврат СокрЛП(Тело);
КонецФункции

// Разбирает query-параметры служебной ссылки в структуру { имя -> значение }.
// URL-декодирование не применяется: в ссылках передаются только служебные
// идентификаторы (имена действий, режимы, ключи настроек) без спецсимволов,
// пробелов и %-последовательностей. Пароли/API-ключ через ссылку никогда не
// передаются - они читаются из DOM непосредственно перед серверным вызовом.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыИзСсылки(Знач Ссылка)
	Результат = Новый Структура;
	ПозицияВопроса = СтрНайти(Ссылка, "?");
	Если ПозицияВопроса = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = Сред(Ссылка, ПозицияВопроса + 1);
	Пары = СтрРазделить(Хвост, "&", Ложь);
	Для Каждого Пара Из Пары Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Пара, ПозицияРавно - 1);
		Значение = Сред(Пара, ПозицияРавно + 1);
		Если Не ПустаяСтрока(Имя) Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

#КонецОбласти
