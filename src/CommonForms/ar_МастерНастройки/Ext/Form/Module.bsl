////////////////////////////////////////////////////////////////////////////////
// Модуль формы ar_МастерНастройки - Мастер первичной настройки AgentRunner.
//
// Единая HTML-панель мастера (по образцу ar_Настройки, SCHED-06 UI-подход).
// Вся форма - одно поле ПолеHTMLДокумента (ПолеHTMLМастера), в котором сервер
// собирает контент одного из 6 шагов мастера в зависимости от реквизита
// ТекущаяСтраница: Приветствие -> Пользователь -> Провайдер -> APIКлюч ->
// Пресет -> Готово.
//
// Обратная связь HTML -> BSL реализована штатным событием поля ПриНажатии:
// каждый интерактивный элемент - это ссылка вида "1c://<действие>?<параметры>".
// При клике href приходит в ДанныеСобытия.Href (эталон БСП
// ВзаимодействияКлиент.ПолеHTMLПриНажатии), стандартная обработка подавляется,
// а BSL разбирает схему и выполняет действие. Значения полей ввода (включая
// пароли) читаются из DOM (Элементы.ПолеHTMLМастера.Документ.getElementById) -
// это работает в толстом клиенте; в веб-клиенте DOM-доступ деградирует.
//
// Безопасность (DoD D9): пароль пользователя ИБ и API-ключ НИКОГДА не
// сохраняются в реквизиты формы и не попадают в HTML-разметку в открытом виде -
// только как <input type="password"> в момент ввода, значение читается из DOM
// непосредственно перед серверным вызовом и не возвращается обратно в HTML.
//
// Условие запуска: автоматически при ПриНачалеРаботыСистемы, если:
//   - пользователь имеет роль ar_РольАдмин;
//   - константа ar_МастерНастройкиВыполнен = Ложь.
//
// Спека: .docs/specs/UI-21.md
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Единый паттерн пропуска инициализации для автотестов.
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	// Если мастер уже выполнен - немедленно закрыть (параллельный запуск, DoD D12).
	Если Константы.ar_МастерНастройкиВыполнен.Получить() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Резюме мастера: если есть сохранённый незавершённый шаг - продолжить с него,
	// иначе (первое открытие, шаг сброшен/некорректен) начать с шага 1.
	СохраненныйШаг = Константы.ar_МастерНастройкиШаг.Получить();
	Если СохраненныйШаг > 0 И СохраненныйШаг <= 6 Тогда
		ТекущаяСтраница = СохраненныйШаг;
	Иначе
		ТекущаяСтраница = 1;
	КонецЕсли;

	ИмяПользователяИБ      = "ar_AgentRunner";
	НовыйПользовательРежим = Истина;
	НовыйПровайдерРежим    = Истина;

	// AgentRunner.ru - выбор по умолчанию для нового провайдера (готовый шлюз,
	// не требует стороннего API-ключа для старта).
	ИмяНовогоПровайдера     = "AgentRunner.ru";
	ТипНовогоПровайдера     = Перечисления.ar_ТипПровайдера.AgentRunnerCloud;
	BaseURLНовогоПровайдера = "https://agentrunner.ru";
	МодельНовогоПровайдера  = МодельПоУмолчаниюДляТипа(ТипНовогоПровайдера);

	ПерерисоватьМастер();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

// Обрабатывает клик по любому элементу внутри HTML-панели мастера.
// href интерактивных ссылок имеет схему "1c://<действие>?<параметры>".
//
// Параметры:
//  Элемент             - ПолеФормы - поле ПолеHTMLМастера.
//  ДанныеСобытия       - ФиксированнаяСтруктура - данные DOM-события клика
//                        (свойство Href - навигационная ссылка кликнутого якоря).
//  СтандартнаяОбработка - Булево - сбрасываем в Ложь, чтобы платформа не пыталась
//                        открыть служебную ссылку "1c://" как обычный URL.
//
&НаКлиенте
Процедура ПолеHTMLМастераПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = "" + ДанныеСобытия.Href;
	Поз = СтрНайти(Ссылка, "1c://");
	Если Поз = 0 Тогда
		Возврат; // не наша служебная ссылка - оставляем платформе
	КонецЕсли;
	Ссылка = Сред(Ссылка, Поз); // веб-клиент нормализует href в абсолютный URL, отрезаем префикс

	СтандартнаяОбработка = Ложь;

	Действие = ДействиеИзСсылки(Ссылка);
	ПараметрыСсылки = ПараметрыИзСсылки(Ссылка);

	Если Действие = "next" Тогда
		ОбработатьДалее();
	ИначеЕсли Действие = "back" Тогда
		ОбработатьНазад();
	ИначеЕсли Действие = "skip" Тогда
		ОбработатьПропустить();
	ИначеЕсли Действие = "finish" Тогда
		ОбработатьЗавершить();
	ИначеЕсли Действие = "cancel" Тогда
		Закрыть(Ложь);
	ИначеЕсли Действие = "create-user" Тогда
		ОбработатьСоздатьПользователя();
	ИначеЕсли Действие = "user-mode" Тогда
		ОбработатьРежимПользователя(ПараметрыСсылки);
	ИначеЕсли Действие = "pick-user" Тогда
		ВыбратьСлужебногоПользователя();
	ИначеЕсли Действие = "provider-mode" Тогда
		ОбработатьРежимПровайдера(ПараметрыСсылки);
	ИначеЕсли Действие = "provider-type" Тогда
		ОбработатьТипПровайдера();
	ИначеЕсли Действие = "select-provider" Тогда
		ОбработатьВыборПровайдера();
	ИначеЕсли Действие = "test-connection" Тогда
		ОбработатьПроверитьСоединение();
	ИначеЕсли Действие = "toggle" Тогда
		ОбработатьПереключение(ПараметрыСсылки);
	ИначеЕсли Действие = "toggle-preset" Тогда
		ОбработатьПереключениеПресета(ПараметрыСсылки);
	ИначеЕсли Действие = "open-agents" Тогда
		ОткрытьФорму("Справочник.ar_Агенты.ФормаСписка");
	ИначеЕсли Действие = "open-settings" Тогда
		ОткрытьФорму("ОбщаяФорма.ar_Настройки");
	ИначеЕсли Действие = "open-docs" Тогда
		ОткрытьДокументацию();
	ИначеЕсли Действие = "open-account" Тогда
		ОткрытьЛичныйКабинет();
	ИначеЕсли Действие = "apply-mapping-profile" Тогда
		ОбработатьПрименитьПрофильМаппинга();
	Иначе
		// Неизвестное действие - молча игнорируем (защита от опечаток в ссылке).
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаДействийКлиента

// Шаг "Далее": читает данные текущего шага из DOM, выполняет серверные
// действия шага (валидация + запись) и, при успехе, переходит на следующий шаг.
//
&НаКлиенте
Процедура ОбработатьДалее()

	ДанныеШага = СобратьДанныеШагаИзDOM(ТекущаяСтраница);

	РезультатШага = ВыполнитьДалееНаСервере(ТекущаяСтраница, ДанныеШага);

	Если Не РезультатШага.Успех Тогда
		ПерерисоватьМастерНаСервере(РезультатШага.Статус, РезультатШага.Текст);
		Возврат;
	КонецЕсли;

	Если ТекущаяСтраница < 6 Тогда
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЕсли;

	// Шаг API-ключа пропускается, если у провайдера ключ уже задан (см. КлючВведен).
	Если ТекущаяСтраница = 4 И КлючВведен И ТекущаяСтраница < 6 Тогда
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЕсли;

	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Шаг "Назад": переход на предыдущую страницу без валидации и побочных действий.
//
&НаКлиенте
Процедура ОбработатьНазад()

	Если ТекущаяСтраница > 1 Тогда
		ТекущаяСтраница = ТекущаяСтраница - 1;
	КонецЕсли;

	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Шаг "Пропустить" - доступен на страницах 4 (ключ) и 5 (пресет), переход
// вперёд без валидации и без вызова сохраняющих серверных функций.
//
&НаКлиенте
Процедура ОбработатьПропустить()

	Если ТекущаяСтраница < 6 Тогда
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЕсли;

	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Кнопка "Завершить" - записать константу и закрыть форму.
//
&НаКлиенте
Процедура ОбработатьЗавершить()

	ЗавершитьМастерНаСервере();
	Закрыть(Истина);

КонецПроцедуры

// Кнопка "Создать пользователя" - шаг 2. Пароль/подтверждение читаются из DOM
// непосредственно перед вызовом сервера и никогда не сохраняются в реквизиты формы.
//
&НаКлиенте
Процедура ОбработатьСоздатьПользователя()

	Пароль = ПрочитатьЗначениеИзDOM("ПарольПользователяИБ");
	Подтверждение = ПрочитатьЗначениеИзDOM("ПодтверждениеПароля");

	Если Пароль = Неопределено Или Подтверждение = Неопределено Тогда
		ПерерисоватьМастерНаСервере("error",
			НСтр("ru='Не удалось прочитать пароль в этом режиме клиента'; en='Could not read password in this client mode'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИмяПользователяИБ) Тогда
		ПерерисоватьМастерНаСервере("error",
			НСтр("ru='Укажите имя пользователя ИБ'; en='Please specify IB username'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Пароль) Тогда
		ПерерисоватьМастерНаСервере("error",
			НСтр("ru='Укажите пароль'; en='Please specify password'"));
		Возврат;
	КонецЕсли;

	Если Пароль <> Подтверждение Тогда
		ПерерисоватьМастерНаСервере("error",
			НСтр("ru='Пароль и подтверждение не совпадают'; en='Password and confirmation do not match'"));
		Возврат;
	КонецЕсли;

	РезультатСоздания = СоздатьПользователяНаСервере(ИмяПользователяИБ, Пароль);

	Если РезультатСоздания.Успех Тогда
		ПользовательСоздан = Истина;
		ПерерисоватьМастерНаСервере("ok", РезультатСоздания.Сообщение);
	Иначе
		ПерерисоватьМастерНаСервере("error", РезультатСоздания.Сообщение);
	КонецЕсли;

КонецПроцедуры

// Переключатель "существующий пользователь" / "новый пользователь" - шаг 2.
//
&НаКлиенте
Процедура ОбработатьРежимПользователя(ПараметрыСсылки)

	Режим = "";
	ПараметрыСсылки.Свойство("mode", Режим);
	НовыйПользовательРежим = (Режим = "new");

	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Выбор существующего служебного пользователя через стандартный диалог выбора
// (тот же паттерн, что и в ОбщаяФорма.ar_Настройки), с немедленной записью
// выбранной ссылки в константу ar_СлужебныйПользовательАгентов.
//
&НаКлиенте
Процедура ВыбратьСлужебногоПользователя()

	Оповещение = Новый ОписаниеОповещения("ВыборСлужебногоПользователяЗавершение", ЭтотОбъект);

	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрытьПриВыборе", Истина);

	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборСлужебногоПользователяЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РезультатЗаписи = ЗаписатьСлужебногоПользователяНаСервере(ВыбранноеЗначение);

	Если РезультатЗаписи.Успех Тогда
		ПользовательСоздан = Истина;
		ПредставлениеСлужебногоПользователя = РезультатЗаписи.Представление;
		ПерерисоватьМастерНаСервере("ok", РезультатЗаписи.Сообщение);
	Иначе
		ПерерисоватьМастерНаСервере("error", РезультатЗаписи.Сообщение);
	КонецЕсли;

КонецПроцедуры

// Переключатель "существующий провайдер" / "новый провайдер" - шаг 3.
//
&НаКлиенте
Процедура ОбработатьРежимПровайдера(ПараметрыСсылки)

	Режим = "";
	ПараметрыСсылки.Свойство("mode", Режим);
	НовыйПровайдерРежим = (Режим = "new");

	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Изменение типа нового провайдера - подставить дефолтный URL (шаг 3).
//
&НаКлиенте
Процедура ОбработатьТипПровайдера()

	ТипСтрока = ПрочитатьЗначениеИзDOM("ТипНовогоПровайдера");
	Если ТипСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Перерисовка строит поля из реквизитов формы, поэтому уже введённое
	// наименование нужно сохранить - иначе оно будет потеряно при смене типа.
	// BaseURL и модель намеренно не сохраняем: они переподставляются под новый тип.
	ИмяИзDOM = ПрочитатьЗначениеИзDOM("ИмяНовогоПровайдера");
	Если ИмяИзDOM <> Неопределено Тогда
		ЗапомнитьИмяПровайдераНаСервере(ИмяИзDOM);
	КонецЕсли;

	ЗаполнитьURLПоТипуНаСервере(ТипСтрока);
	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Выбор существующего провайдера из списка (шаг 3).
//
&НаКлиенте
Процедура ОбработатьВыборПровайдера()

	СсылкаСтрока = ПрочитатьЗначениеИзDOM("ПолеВыбораПровайдера");
	Если СсылкаСтрока = Неопределено Или ПустаяСтрока(СсылкаСтрока) Тогда
		Возврат;
	КонецЕсли;

	ВыбранныйПровайдер = ПровайдерПоСтрокеСсылкиНаСервере(СсылкаСтрока);
	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Кнопка "Проверить соединение" - тест API-ключа (шаг 4). Ключ читается
// из DOM непосредственно перед вызовом и не сохраняется в реквизиты формы.
//
&НаКлиенте
Процедура ОбработатьПроверитьСоединение()

	Ключ = ПрочитатьЗначениеИзDOM("APIКлюч");

	Если Ключ = Неопределено Тогда
		ПерерисоватьМастерНаСервере("error",
			НСтр("ru='Не удалось прочитать ключ в этом режиме клиента'; en='Could not read key in this client mode'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ключ) Тогда
		ПерерисоватьМастерНаСервере("error",
			НСтр("ru='Введите API-ключ перед проверкой'; en='Enter API key before testing'"));
		Возврат;
	КонецЕсли;

	РезультатПроверки = ПроверитьСоединениеНаСервере(ВыбранныйПровайдер, Ключ);

	Если РезультатПроверки.Успех Тогда
		Статус = "ok";
		Текст  = НСтр("ru='Соединение установлено'; en='Connection successful'");
	Иначе
		Статус = "error";
		Текст  = СтрШаблон(НСтр("ru='Ошибка: %1'; en='Error: %1'"), РезультатПроверки.Ошибка);
	КонецЕсли;

	// LLM-14 (часть Б): отдельное предупреждение о низком балансе шлюза,
	// не блокирует и не подменяет обычное сообщение об успехе/неуспехе теста.
	ТекстБаланса = "";
	Если РезультатПроверки.БалансНизкий = Истина Тогда
		ТекстБаланса = НСтр("ru='Баланс шлюза AgentRunner Cloud приближается к нулю. Пополните счёт в личном кабинете agentrunner.ru.';
			|en='AgentRunner Cloud gateway balance is running low. Top up your account at agentrunner.ru.'");
	КонецЕсли;

	ПерерисоватьМастерНаСервере(Статус, Текст, ТекстБаланса);

КонецПроцедуры

// Переключает отметку встроенного пресета в списке чекбоксов (шаг 5).
// Ключ - имя макета (ar_Пресет_*). Состояние копится в реквизите формы
// ОтмеченныеПресеты (CSV имён через запятую) - клик сразу обновляет реквизит
// на сервере, не полагаясь на отложенное чтение DOM при "Далее".
//
&НаКлиенте
Процедура ОбработатьПереключениеПресета(ПараметрыСсылки)

	ИмяМакета = "";
	ПараметрыСсылки.Свойство("key", ИмяМакета);
	Если ПустаяСтрока(ИмяМакета) Тогда
		Возврат;
	КонецЕсли;

	Список = СтрРазделить(ОтмеченныеПресеты, ",", Ложь);
	Индекс = Список.Найти(ИмяМакета);
	Если Индекс = Неопределено Тогда
		Список.Добавить(ИмяМакета);
	Иначе
		Список.Удалить(Индекс);
	КонецЕсли;
	ОтмеченныеПресеты = СтрСоединить(Список, ",");

	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Переключает флажок "Активировать агента" (шаг 5).
//
&НаКлиенте
Процедура ОбработатьПереключение(ПараметрыСсылки)

	Ключ = "";
	ПараметрыСсылки.Свойство("key", Ключ);
	Если Ключ = "АктивироватьАгента" Тогда
		АктивироватьАгента = Не АктивироватьАгента;
	КонецЕсли;

	ПерерисоватьМастерНаСервере();

КонецПроцедуры

// Открывает браузер на странице документации мастера (шаг 1).
//
&НаКлиенте
Процедура ОткрытьДокументацию()

	УрлДокументации = УрлДокументацииНаСервере();
	Если Не ПустаяСтрока(УрлДокументации) Тогда
		// ЗапуститьПриложение синхронный и запрещён без модальности - открываем
		// ссылку штатной точкой БСП [Реф: БСП/ФайловаяСистемаКлиент].
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(УрлДокументации);
	КонецЕсли;

КонецПроцедуры

// Открывает браузер на странице входа в личный кабинет AgentRunner Cloud (шаг 3).
//
&НаКлиенте
Процедура ОткрытьЛичныйКабинет()

	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://agentrunner.ru/account/login");

КонецПроцедуры

// UNIV-04: кнопка "Применить профиль <Имя>?" на шаге 6 "Готово" - читает
// текст встроенного макета-заготовки профиля маппинга по определённому типу
// конфигурации и передаёт в ar_ПрофилиИмпорт.Импортировать() на сервере.
// Результат (сколько записей применено/отброшено, ПерезаписаныеРучные)
// сохраняется в реквизит РезультатИмпортаПрофиляJSON и отображается в
// перерисованной сводке (СтрокаПрофиляКонфигурацииДляСводки).
//
&НаКлиенте
Процедура ОбработатьПрименитьПрофильМаппинга()

	РезультатПрименения = ПрименитьПрофильМаппингаНаСервере();

	Если РезультатПрименения.Успех Тогда
		ПерерисоватьМастерНаСервере("ok", РезультатПрименения.Сообщение);
	Иначе
		ПерерисоватьМастерНаСервере("error", РезультатПрименения.Сообщение);
	КонецЕсли;

КонецПроцедуры

// Клиентская обёртка перерисовки: перечитывает данные на сервере и обновляет HTML.
//
// Параметры:
//  Статус       - Строка - "ok" / "error" / "" - статус последнего действия.
//  Текст        - Строка - текст статуса.
//  ТекстБаланса - Строка - опциональное отдельное предупреждение (LLM-14).
//
&НаКлиенте
Процедура ПерерисоватьМастерНаСервере(Статус = "", Текст = "", ТекстБаланса = "")
	ПерерисоватьМастер(Статус, Текст, ТекстБаланса);
КонецПроцедуры

// Собирает данные полей текущего шага из DOM (только те, что относятся к шагу).
// Пароли/ключи не хранятся в структуре дольше одного клиент-серверного вызова.
//
// Возвращаемое значение:
//  Структура - набор строковых значений полей DOM, специфичных для шага.
//
&НаКлиенте
Функция СобратьДанныеШагаИзDOM(Знач НомерШага)

	Данные = Новый Структура;

	Если НомерШага = 3 Тогда
		Данные.Вставить("ИмяНовогоПровайдера", ПрочитатьЗначениеИзDOM("ИмяНовогоПровайдера"));
		Данные.Вставить("ПолеВыбораПровайдера", ПрочитатьЗначениеИзDOM("ПолеВыбораПровайдера"));
		// BaseURL и модель редактируются вручную, поэтому их значения тоже нужно
		// забрать из DOM - иначе введённое пользователем теряется при переходе
		// и в справочник попадает подставленное по типу значение по умолчанию.
		Данные.Вставить("BaseURLНовогоПровайдера", ПрочитатьЗначениеИзDOM("BaseURLНовогоПровайдера"));
		Данные.Вставить("МодельНовогоПровайдера", ПрочитатьЗначениеИзDOM("МодельНовогоПровайдера"));
	Иначе
		// Шаги 1, 2, 4, 5, 6 не имеют полей, которые нужно читать до похода на сервер.
		Данные.Вставить("ПустойШаг", Истина);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Читает значение элемента input/textarea/select/checkbox по id из DOM
// HTML-документа. Возвращает Неопределено, если DOM-доступ недоступен
// (веб-клиент) или элемент не найден.
//
&НаКлиенте
Функция ПрочитатьЗначениеИзDOM(Ид)

	Попытка
		ДокументHTML = Элементы.ПолеHTMLМастера.Документ;
		ЭлементВвода = ДокументHTML.getElementById(Ид);
		Если ЭлементВвода = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		// Свойство checked есть у любого <input> (не только checkbox) и для
		// текстовых полей равно Ложь, а не Неопределено - поэтому различать
		// чекбокс нужно по type, а не по наличию/типу checked.
		Если НРег("" + ЭлементВвода.type) = "checkbox" Тогда
			Возврат ?(ЭлементВвода.checked, "true", "false");
		КонецЕсли;
		Возврат ЭлементВвода.value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыСервер

// Выполняет валидацию и серверные действия текущего шага при нажатии "Далее".
//
// Параметры:
//  НомерШага - Число - текущая страница мастера (1..6).
//  ДанныеШага - Структура - значения полей DOM, специфичные для шага
//               (см. СобратьДанныеШагаИзDOM).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Статус (Строка "ok"/"error"), Текст (Строка).
//
&НаСервере
Функция ВыполнитьДалееНаСервере(Знач НомерШага, Знач ДанныеШага)

	Результат = Новый Структура("Успех, Статус, Текст", Истина, "", "");

	Если НомерШага = 1 Тогда

		// Шаг приветствия не требует валидации/сохранения.
		Результат.Статус = "";

	ИначеЕсли НомерШага = 2 Тогда

		// Пользователь создаётся отдельной кнопкой; "Далее" просто продолжает.
		Результат.Статус = "";

	ИначеЕсли НомерШага = 3 Тогда

		ar_СлужебныйЛог.Записать("ar_МастерНастройки.ВыполнитьДалееНаСервере", "SESS-Debug",
			"Шаг3: НовыйПровайдерРежим=" + Строка(НовыйПровайдерРежим)
			+ " ВыбранныйПровайдер=[" + Строка(ВыбранныйПровайдер) + "]"
			+ " ЗначениеЗаполнено=" + Строка(ЗначениеЗаполнено(ВыбранныйПровайдер)));

		Если НовыйПровайдерРежим Тогда
			ДанныеШага.Свойство("ИмяНовогоПровайдера", ИмяНовогоПровайдера);
			// Свойство() не изменяет приёмник, если значение из DOM = Неопределено
			// (веб-клиент, элемент не найден) - подставленные по типу значения сохранятся.
			ДанныеШага.Свойство("BaseURLНовогоПровайдера", BaseURLНовогоПровайдера);
			ДанныеШага.Свойство("МодельНовогоПровайдера", МодельНовогоПровайдера);

			Если Не ЗначениеЗаполнено(ИмяНовогоПровайдера) Тогда
				Результат.Успех = Ложь;
				Результат.Статус = "error";
				Результат.Текст = НСтр("ru='Укажите наименование провайдера'; en='Specify provider name'");
				Возврат Результат;
			КонецЕсли;

			// Без BaseURL провайдер нерабочий, а ошибка всплыла бы только на шаге 4
			// при проверке соединения - проверяем здесь, пока поле на экране.
			Если Не ЗначениеЗаполнено(BaseURLНовогоПровайдера) Тогда
				Результат.Успех = Ложь;
				Результат.Статус = "error";
				Результат.Текст = НСтр("ru='Укажите базовый URL (BaseURL) провайдера';
					|en='Specify the provider base URL'");
				Возврат Результат;
			КонецЕсли;

			СоздатьНовогоПровайдераНаСервере();
		Иначе
			Если Не ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
				СсылкаИзDOM = "";
				ДанныеШага.Свойство("ПолеВыбораПровайдера", СсылкаИзDOM);
				Если Не ПустаяСтрока(СсылкаИзDOM) Тогда
					ВыбранныйПровайдер = ПровайдерПоСтрокеСсылкиНаСервере(СсылкаИзDOM);
				КонецЕсли;
			КонецЕсли;

			Если Не ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
				Результат.Успех = Ложь;
				Результат.Статус = "error";
				Результат.Текст = НСтр("ru='Выберите провайдера или создайте нового'; en='Select a provider or create a new one'");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;

		// Ключ уже задан для провайдера (ar_Включён выставляется только после
		// успешного сохранения ключа - см. HTMLШагAPIКлюч) - шаг 4 будет пропущен.
		КлючВведен = ЗначениеЗаполнено(ВыбранныйПровайдер) И ВыбранныйПровайдер.ar_Включён;

	ИначеЕсли НомерШага = 4 Тогда

		// Допустимо пропустить целиком - действие "skip" не вызывает эту функцию.
		// При "Далее" ключ уже сохранён внутри ОбработатьПроверитьСоединение, если тест прошёл успешно.
		Результат.Статус = "";

	ИначеЕсли НомерШага = 5 Тогда

		ИмпортироватьОтмеченныеПресетыНаСервере();

	Иначе

		Результат.Статус = "";

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Переносит наименование провайдера из DOM в реквизит формы перед перерисовкой.
//
// Параметры:
//   Значение - Строка - наименование, введённое пользователем.
&НаСервере
Процедура ЗапомнитьИмяПровайдераНаСервере(Знач Значение)

	ИмяНовогоПровайдера = Значение;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьURLПоТипуНаСервере(Знач ТипСтрока)

	Если ПустаяСтрока(ТипСтрока) Тогда
		Возврат;
	КонецЕсли;

	БылAgentRunnerCloud = (ТипНовогоПровайдера = Перечисления.ar_ТипПровайдера.AgentRunnerCloud);

	Попытка
		ТипНовогоПровайдера = Перечисления.ar_ТипПровайдера[ТипСтрока];
	Исключение
		Возврат;
	КонецПопытки;

	// При переключении с AgentRunnerCloud на другой тип наименование "AgentRunner.ru"
	// (подставленное по умолчанию) больше не актуально - очищаем.
	Если БылAgentRunnerCloud И ТипСтрока <> "AgentRunnerCloud" Тогда
		ИмяНовогоПровайдера = "";
	КонецЕсли;

	Если ТипСтрока = "AgentRunnerCloud" Тогда
		BaseURLНовогоПровайдера = "https://agentrunner.ru";
	ИначеЕсли ТипСтрока = "LocalCompatible" Тогда
		BaseURLНовогоПровайдера = "";
	ИначеЕсли СтрНайти(ТипСтрока, "OpenAI") > 0 Тогда
		BaseURLНовогоПровайдера = "https://api.openai.com/v1";
	ИначеЕсли СтрНайти(ТипСтрока, "Anthropic") > 0 Тогда
		BaseURLНовогоПровайдера = "https://api.anthropic.com";
	ИначеЕсли СтрНайти(ТипСтрока, "YandexGPT") > 0 Тогда
		BaseURLНовогоПровайдера = "https://llm.api.cloud.yandex.net";
	ИначеЕсли СтрНайти(ТипСтрока, "GigaChat") > 0 Тогда
		BaseURLНовогоПровайдера = "https://gigachat.devices.sberbank.ru/api/v1";
	Иначе
		BaseURLНовогоПровайдера = "";
	КонецЕсли;

	МодельНовогоПровайдера = МодельПоУмолчаниюДляТипа(ТипНовогоПровайдера);

КонецПроцедуры

&НаСервере
Функция ПровайдерПоСтрокеСсылкиНаСервере(Знач СсылкаСтрока)

	ar_СлужебныйЛог.Записать("ar_МастерНастройки.ПровайдерПоСтрокеСсылкиНаСервере", "SESS-Debug",
		"СсылкаСтрока=[" + СсылкаСтрока + "]");

	Попытка
		Результат = Справочники.ar_LLMПровайдеры.ПолучитьСсылку(Новый УникальныйИдентификатор(СсылкаСтрока));
		ar_СлужебныйЛог.Записать("ar_МастерНастройки.ПровайдерПоСтрокеСсылкиНаСервере", "SESS-Debug",
			"Результат=[" + Строка(Результат) + "] ЗначениеЗаполнено=" + Строка(ЗначениеЗаполнено(Результат)));
		Возврат Результат;
	Исключение
		ar_СлужебныйЛог.Записать("ar_МастерНастройки.ПровайдерПоСтрокеСсылкиНаСервере", "SESS-Debug",
			"Исключение: " + ИнформацияОбОшибке().Описание, "Ошибка");
		Возврат Справочники.ar_LLMПровайдеры.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// Модель по умолчанию для типа провайдера - подставляется в поле "Модель"
// на шаге 3 и используется, если пользователь очистил поле.
//
// Параметры:
//   ТипПровайдера - ПеречислениеСсылка.ar_ТипПровайдера
//
// Возвращаемое значение:
//   Строка - идентификатор модели ("" - если разумного умолчания нет).
&НаСервере
Функция МодельПоУмолчаниюДляТипа(Знач ТипПровайдера)

	Если ТипПровайдера = Перечисления.ar_ТипПровайдера.AgentRunnerCloud Тогда
		// Совпадает с fallback-моделью в ar_LLMAgentRunnerCloud, если DefaultModel пуст.
		Возврат "Qwen3.6-35B-A3B";
	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.YandexGPT Тогда
		Возврат "yandexgpt-lite";
	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.GigaChat Тогда
		Возврат "GigaChat";
	КонецЕсли;

	// LocalCompatible и прочие: имя модели зависит от конкретного сервера
	// (LM Studio, Ollama и т.п.) - подставить осмысленное умолчание нельзя.
	Возврат "";

КонецФункции

&НаСервере
Процедура СоздатьНовогоПровайдераНаСервере()

	НовыйПровайдер              = Справочники.ar_LLMПровайдеры.СоздатьЭлемент();
	НовыйПровайдер.Наименование = ИмяНовогоПровайдера;
	НовыйПровайдер.ar_Тип       = ТипНовогоПровайдера;
	НовыйПровайдер.ar_BaseURL   = BaseURLНовогоПровайдера;
	НовыйПровайдер.ar_Включён   = Ложь; // Включается после сохранения ключа.

	// Новое подключение по умолчанию считается поддерживающим tool calls:
	// это верно для всех облачных провайдеров и большинства локальных серверов.
	// Снять флаг можно вручную в карточке провайдера.
	НовыйПровайдер.ar_ПоддерживаетToolCalls = Истина;

	// Модель, введённая пользователем на шаге 3, имеет приоритет над значением
	// по умолчанию для типа провайдера.
	Если ЗначениеЗаполнено(МодельНовогоПровайдера) Тогда
		НовыйПровайдер.ar_DefaultModel = СокрЛП(МодельНовогоПровайдера);
	Иначе
		НовыйПровайдер.ar_DefaultModel = МодельПоУмолчаниюДляТипа(ТипНовогоПровайдера);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		НовыйПровайдер.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ВыбранныйПровайдер = НовыйПровайдер.Ссылка;

КонецПроцедуры

// Сохраняет API-ключ в БезопасноеХранилище, если он был передан.
//
// Параметры:
//  Ключ - Строка - значение API-ключа, прочитанное из DOM (не сохраняется).
//
// Сохраняет ключ по контракту UC-2/UC-3 ar_LLMПровайдеры.ФормаЭлемента: ключ
// хранится в ar_Secrets под отдельным UUID (не УникальныйИдентификатор ссылки
// провайдера!), который записан в реквизит ar_APIKeyИдентификатор - именно по
// нему ar_LLMТест и все ar_LLM*-модули читают ключ. Если ar_APIKeyИдентификатор
// уже заполнен (провайдер выбран существующий, ключ ротируется) - переиспользуем
// его (UC-3), иначе генерируем новый (UC-2).
&НаСервере
Процедура СохранитьAPIКлючЕслиЗаполнен(Знач Ключ)

	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
		Возврат;
	КонецЕсли;

	УИДСуществующий = СокрЛП(Строка(ВыбранныйПровайдер.ar_APIKeyИдентификатор));
	УИД = ?(ПустаяСтрока(УИДСуществующий), ar_Утилиты.НовыйUUID(), УИДСуществующий);

	КлючВведен = Ложь;
	Попытка
		ar_Secrets.Сохранить(ar_Secrets.КлючПровайдера(УИД), Ключ);
		КлючВведен = Истина;
	Исключение
		КлючВведен = Ложь;
	КонецПопытки;

	Если КлючВведен Тогда
		ОбъектПровайдера = ВыбранныйПровайдер.ПолучитьОбъект();
		ОбъектПровайдера.ar_APIKeyИдентификатор = УИД;
		ОбъектПровайдера.ar_Включён = Истина;
		НачатьТранзакцию();
		Попытка
			ОбъектПровайдера.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Импортирует все отмеченные на шаге 5 встроенные пресеты (по одному агенту
// на каждый), накапливая результаты в реквизите РезультатыИмпортаJSON для
// последующего отображения на шаге 6 "Готово".
//
&НаСервере
Процедура ИмпортироватьОтмеченныеПресетыНаСервере()

	Результаты = Новый Массив;

	Если Не ПустаяСтрока(ОтмеченныеПресеты) Тогда
		Для Каждого ИмяМакета Из СтрРазделить(ОтмеченныеПресеты, ",", Ложь) Цикл

			ТекстJSON = "";
			Попытка
				ТекстJSON = Обработки.ar_ПресетыВстроенные.ПолучитьМакет(ИмяМакета).ПолучитьТекст();
			Исключение
				Продолжить; // макет исчез между отрисовкой и "Далее" - пропускаем, не роняем мастер
			КонецПопытки;

			РезультатИмпорта = ar_ПресетыИмпорт.ИмпортироватьПресетИзТекста(ТекстJSON, "");

			Если РезультатИмпорта.Успех И АктивироватьАгента И ЗначениеЗаполнено(РезультатИмпорта.АгентСсылка) Тогда
				ОбъектАгента = РезультатИмпорта.АгентСсылка.ПолучитьОбъект();
				ОбъектАгента.ar_Активен = Истина;
				НачатьТранзакцию();
				Попытка
					ОбъектАгента.Записать();
					ЗафиксироватьТранзакцию();
				Исключение
					ОтменитьТранзакцию();
					ВызватьИсключение;
				КонецПопытки;
			КонецЕсли;

			СтрокаРезультата = Новый Структура;
			СтрокаРезультата.Вставить("ИмяМакета", ИмяМакета);
			СтрокаРезультата.Вставить("Успех", РезультатИмпорта.Успех);
			СтрокаРезультата.Вставить("ИмяАгента", ?(РезультатИмпорта.Успех, Строка(РезультатИмпорта.АгентСсылка), ""));
			СтрокаРезультата.Вставить("Причина", РезультатИмпорта.Причина);
			Результаты.Добавить(СтрокаРезультата);

		КонецЦикла;
	КонецЕсли;

	РезультатыИмпортаJSON = ar_JSON.ВЗначениеJSON(Результаты);

КонецПроцедуры

// Устанавливает константу ar_МастерНастройкиВыполнен = Истина.
// Требует привилегированного режима для записи константы (Plan §1.3).
//
// UNIV-01: перед завершением мастера автозаполняет профиль конфигурации
// (ar_ПрофильКонфигурации.ЗаполнитьАвтоматически()) - служебные ключи
// configuration.* (и, на БП, четыре content-ключа invoice.*) должны быть
// в регистре сразу после первого прохождения мастера, до того как
// UNIV-02/UNIV-03 впервые обратятся к профилю. Best-effort: ошибка
// автозаполнения не должна мешать завершению мастера (Установить()/
// ЗаполнитьАвтоматически() не бросают исключений наружу по контракту
// ar_ПрофильКонфигурации, но вызов на всякий случай обёрнут в Попытку).
&НаСервере
Процедура ЗавершитьМастерНаСервере()

	Попытка
		ar_ПрофильКонфигурации.ЗаполнитьАвтоматически();
	Исключение
		// Best-effort - профиль не заполнился, но мастер всё равно завершается.
		// ar_Настройки/следующий запуск мастера смогут заполнить профиль позже.
		ar_СлужебныйЛог.Записать(
			"ar_МастерНастройки.ЗавершитьМастерНаСервере",
			"profile_auto_fill_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение");
	КонецПопытки;

	МастерЗавершен = Ложь;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.ar_МастерНастройкиВыполнен.Установить(Истина);
		// Шаг больше не нужен - мастер завершён, резюмировать нечего.
		Константы.ar_МастерНастройкиШаг.Установить(0);
		МастерЗавершен = Истина;
	Исключение
		// Ошибка записи константы - форма всё равно закрывается.
		// Следующий запуск системы снова покажет мастер.
		МастерЗавершен = Ложь;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Сохраняет номер текущего шага мастера в константу ar_МастерНастройкиШаг -
// для резюме при повторном открытии формы в незавершённой попытке (в этой
// же сессии). Ошибка записи не прерывает работу мастера - при следующем
// открытии он просто стартует заново с шага 1.
//
&НаСервере
Процедура СохранитьТекущийШагМастера()

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.ar_МастерНастройкиШаг.Установить(ТекущаяСтраница);
	Исключение
		// Best-effort: резюме - удобство, а не критичная функция мастера,
		// но привилегированный режим обязан быть снят в любом случае.
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Создаёт пользователя ИБ под привилегированным режимом.
//
// Параметры:
//   ИмяПользователя - Строка - имя создаваемого пользователя ИБ.
//   Пароль          - Строка - пароль (не сохраняется вызывающим кодом).
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Сообщение (Строка).
&НаСервере
Функция СоздатьПользователяНаСервере(Знач ИмяПользователя, Знач Пароль)

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		// Служебному пользователю агента НЕ выдаются ПолныеПрава/АдминистраторСистемы,
		// поэтому Пользователи.СоздатьАдминистратора неприменим - он предназначен только
		// для первого администратора и требует наличия этих ролей [Реф: БСП/Пользователи.СоздатьАдминистратора].
		// Штатный способ - запись СправочникОбъект.Пользователи с ДополнительныеСвойства.ОписаниеПользователяИБ:
		// пользователь ИБ создаётся (или сопоставляется) самой БСП
		// [Реф: БСП/Справочники.Пользователи.МодульОбъекта, БСП/АвтономнаяРаботаСлужебный].
		СуществующийПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);

		Роли = Новый Массив;
		Если Метаданные.Роли.Найти("ar_РольАдмин") <> Неопределено Тогда
			Роли.Добавить("ar_РольАдмин");
		КонецЕсли;
		Если Метаданные.Роли.Найти("ar_РольСлужебный") <> Неопределено Тогда
			Роли.Добавить("ar_РольСлужебный");
		КонецЕсли;

		ОписаниеПользователяИБ = Новый Структура;
		ОписаниеПользователяИБ.Вставить("Действие",                  "Записать");
		ОписаниеПользователяИБ.Вставить("Имя",                       ИмяПользователя);
		ОписаниеПользователяИБ.Вставить("Роли",                      Роли);
		ОписаниеПользователяИБ.Вставить("АутентификацияСтандартная", Истина);
		ОписаниеПользователяИБ.Вставить("АутентификацияОС",          Ложь);
		ОписаниеПользователяИБ.Вставить("ПоказыватьВСпискеВыбора",   Ложь);

		Если СуществующийПользовательИБ = Неопределено Тогда
			ОписаниеПользователяИБ.Вставить("Пароль", Пароль);
		Иначе
			// Сопоставление уже существующего свободного пользователя ИБ с элементом
			// справочника выполняется через свойство УникальныйИдентификатор;
			// пароль существующего пользователя не перезаписываем.
			ОписаниеПользователяИБ.Вставить("УникальныйИдентификатор",
				СуществующийПользовательИБ.УникальныйИдентификатор);
		КонецЕсли;

		ЭлементСправочника = ЭлементСправочникаПользователи(СуществующийПользовательИБ, ИмяПользователя);

		ЭлементСправочника.Наименование = ИмяПользователя;
		// Служебный = Ложь: элементы со Служебный = Истина скрыты стандартным отбором
		// формы выбора справочника Пользователи [Реф: БСП/Справочники.Пользователи.МодульМенеджера],
		// а шаг 2 мастера выбирает служебного пользователя именно через неё.
		ЭлементСправочника.Служебный    = Ложь;
		ЭлементСправочника.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);
		ЭлементСправочника.Записать();

		Константы.ar_СлужебныйПользовательАгентов.Установить(ЭлементСправочника.Ссылка);

		Результат.Успех = Истина;
		Если СуществующийПользовательИБ = Неопределено Тогда
			Результат.Сообщение = СтрШаблон(
				НСтр("ru='Пользователь ""%1"" успешно создан'; en='User ""%1"" successfully created'"),
				ИмяПользователя);
		Иначе
			Результат.Сообщение = СтрШаблон(
				НСтр("ru='Пользователь ИБ ""%1"" уже существует, выполнено сопоставление со справочником';
					|en='IB user ""%1"" already exists, mapped to the catalog'"),
				ИмяПользователя);
		КонецЕсли;

	Исключение
		ТекстОшибки        = ИнформацияОбОшибке().Описание;
		Результат.Успех    = Ложь;
		Результат.Сообщение = СтрШаблон(
			НСтр("ru='Ошибка создания пользователя: %1. Создайте вручную.';
				|en='Error creating user: %1. Please create manually.'"),
			ТекстОшибки);
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Возвращает СправочникОбъект.Пользователи для служебного пользователя: уже
// сопоставленный с пользователем ИБ элемент, элемент с совпадающим наименованием
// либо новый.
//
// Параметры:
//   ПользовательИБ  - ПользовательИнформационнойБазы - существующий пользователь ИБ.
//                   - Неопределено - пользователь ИБ ещё не создан.
//   ИмяПользователя - Строка - имя пользователя ИБ / наименование элемента справочника.
//
// Возвращаемое значение:
//   СправочникОбъект.Пользователи
&НаСервере
Функция ЭлементСправочникаПользователи(Знач ПользовательИБ, Знач ИмяПользователя)

	Если ПользовательИБ <> Неопределено Тогда
		// Реквизит ИдентификаторПользователяИБ хранит связь элемента справочника
		// с пользователем ИБ [Реф: БСП/Справочники.Пользователи.МодульМенеджера].
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Пользователи.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Пользователи КАК Пользователи
			|ГДЕ
			|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторПользователяИБ";
		Запрос.УстановитьПараметр("ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка.ПолучитьОбъект();
		КонецЕсли;
	КонецЕсли;

	// Запасной вариант - элемент с тем же наименованием, но только не сопоставленный
	// с другим пользователем ИБ: иначе можно перехватить чужую учётную запись.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование = &Наименование
		|	И Пользователи.ИдентификаторПользователяИБ = &ПустойИдентификатор";
	ПустойИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Запрос.УстановитьПараметр("Наименование",        ИмяПользователя);
	Запрос.УстановитьПараметр("ПустойИдентификатор", ПустойИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Возврат Справочники.Пользователи.СоздатьЭлемент();

КонецФункции

// Записывает выбранного существующего пользователя в константу
// ar_СлужебныйПользовательАгентов (шаг 2, режим "существующий пользователь").
// Требует привилегированного режима для записи константы (Plan §1.3).
//
// Параметры:
//   Пользователь - СправочникСсылка.Пользователи - выбранный в диалоге пользователь
//                  (см. ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ...)).
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Сообщение (Строка), Представление (Строка).
&НаСервере
Функция ЗаписатьСлужебногоПользователяНаСервере(Знач Пользователь)

	Результат = Новый Структура("Успех, Сообщение, Представление", Ложь, "", "");
	Представление = Строка(Пользователь);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.ar_СлужебныйПользовательАгентов.Установить(Пользователь);
		Результат.Успех        = Истина;
		Результат.Представление = Представление;
		Результат.Сообщение    = СтрШаблон(
			НСтр("ru='Служебный пользователь ""%1"" выбран'; en='Service user ""%1"" selected'"),
			Представление);
	Исключение
		Результат.Успех     = Ложь;
		Результат.Сообщение = СтрШаблон(
			НСтр("ru='Ошибка сохранения служебного пользователя: %1'; en='Failed to save service user: %1'"),
			ИнформацияОбОшибке().Описание);
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Проверяет соединение с LLM-провайдером тестовым запросом.
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры - ссылка на провайдера.
//   Ключ      - Строка - API-ключ для теста (не сохраняется вызывающим кодом).
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Ошибка (Строка),
//               БалансНизкий (Булево, LLM-14 - ar_LLMТест его не возвращает,
//               всегда Ложь; см. ar_LLMAgentRunnerCloud.Чат для реального парсинга баланса).
&НаСервере
Функция ПроверитьСоединениеНаСервере(Знач Провайдер, Знач Ключ)

	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	Результат.Вставить("БалансНизкий", Ложь);

	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		Результат.Ошибка = НСтр("ru='Провайдер не выбран'; en='Provider not selected'");
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Результат.Ошибка = НСтр("ru='API-ключ не задан'; en='API key not set'");
		Возврат Результат;
	КонецЕсли;

	// ar_LLMТест читает ключ из БД по реквизиту ar_APIKeyИдентификатор провайдера
	// (не по УникальныйИдентификатор() ссылки!) - см. контракт UC-2/UC-3 в
	// ar_LLMПровайдеры.ФормаЭлемента. Для проверки ЕЩЁ НЕ сохранённого ключа
	// временно проставляем этот реквизит в БД, тестируем, откатываем при неудаче.
	УИДСуществующий = СокрЛП(Строка(Провайдер.ar_APIKeyИдентификатор));
	КлючУжеЕсть      = Не ПустаяСтрока(УИДСуществующий);
	УИД              = ?(КлючУжеЕсть, УИДСуществующий, ar_Утилиты.НовыйUUID());

	Попытка
		ar_Secrets.Сохранить(ar_Secrets.КлючПровайдера(УИД), Ключ);
	Исключение
		Результат.Ошибка = НСтр("ru='Не удалось сохранить ключ для теста'; en='Failed to save key for testing'");
		Возврат Результат;
	КонецПопытки;

	Если Не КлючУжеЕсть Тогда
		Попытка
			ОбъектДляТеста = Провайдер.ПолучитьОбъект();
			ОбъектДляТеста.ar_APIKeyИдентификатор = УИД;
			ОбъектДляТеста.Записать();
		Исключение
			Результат.Ошибка = НСтр("ru='Не удалось подготовить провайдера для теста'; en='Failed to prepare provider for testing'");
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;

	// ar_LLMТест - специализированный, уже проверенный инструмент проверки
	// соединения (та же логика, что у кнопки "Тест соединения" в форме элемента
	// ar_LLMПровайдеры): различает 2xx/401/403/сетевые ошибки по HTTP-коду,
	// сам читает ключ из ar_Secrets. Не полагаемся на диспетчер с fallback/retry -
	// он не предназначен для теста единственного конкретного провайдера.
	Попытка
		РезультатТеста = ar_LLMТест.ПроверитьСоединение(Провайдер);
		Результат.Успех = РезультатТеста.Успех;
		Если Не Результат.Успех Тогда
			Результат.Ошибка = РезультатТеста.Сообщение;
		КонецЕсли;
	Исключение
		Результат.Ошибка = ИнформацияОбОшибке().Описание;
	КонецПопытки;

	Если Не КлючУжеЕсть И Не Результат.Успех Тогда
		Попытка
			ar_Secrets.Удалить(ar_Secrets.КлючПровайдера(УИД));
			ОбъектОткат = Провайдер.ПолучитьОбъект();
			ОбъектОткат.ar_APIKeyИдентификатор = "";
			ОбъектОткат.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru='AgentRunner: удаление временного ключа'; en='AgentRunner: delete temp key'"),
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;

	// Если ключ прошёл проверку и провайдер выбран, сохраняем его окончательно
	// на этом же шаге - пользователь не обязан повторно нажимать "Далее" ради
	// сохранения; при "Далее"/"Пропустить" ключ уже сохранён либо остаётся пуст.
	Если Результат.Успех Тогда
		СохранитьAPIКлючЕслиЗаполнен(Ключ);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция УрлДокументацииНаСервере()
	Возврат "https://" + ar_Константы.ВерсионныйХост() + "/docs";
КонецФункции

#КонецОбласти

#Область ПерерисовкаМастера

// Собирает HTML текущего шага мастера и кладёт его в реквизит СтрокаHTMLМастера.
//
// Параметры:
//  Статус       - Строка - "ok"/"error"/"" - статус последнего действия.
//  Текст        - Строка - текст статуса.
//  ТекстБаланса - Строка - опциональное отдельное предупреждение (LLM-14).
//
&НаСервере
Процедура ПерерисоватьМастер(Знач Статус = "", Знач Текст = "", Знач ТекстБаланса = "")

	// Обработка "Далее" при попадании на шаг 4 с уже заполненным ключом
	// (например, пользователь ввёл ключ, нажал "Проверить", затем "Далее") -
	// сохранение выполняется в СохранитьAPIКлючЕслиЗаполнен внутри соответствующих
	// обработчиков клика, отдельного вызова здесь не требуется.

	// Резюме мастера: сохраняем текущий шаг, чтобы при повторном открытии формы
	// (в этой же сессии, до завершения мастера) продолжить с места остановки.
	СохранитьТекущийШагМастера();

	Если ТекущаяСтраница = 6 Тогда
		СводкаHTML = СобратьСводкуHTML();
	Иначе
		СводкаHTML = "";
	КонецЕсли;

	СтрокаHTMLМастера = СобратьHTMLМастера(Статус, Текст, ТекстБаланса, СводкаHTML);

КонецПроцедуры

#КонецОбласти

#Область СборкаHTML

// Собирает полный HTML-документ текущего шага мастера.
//
&НаСервере
Функция СобратьHTMLМастера(Знач Статус, Знач Текст, Знач ТекстБаланса, Знач СводкаHTML)

	Содержимое = "";
	Содержимое = Содержимое + HTMLПрогрессМастера(ТекущаяСтраница);
	Содержимое = Содержимое + "<div class=""ar-card ar-wizard-body"">";
	Содержимое = Содержимое + HTMLБаннерСтатуса(Статус, Текст);

	Если ТекущаяСтраница = 1 Тогда
		Содержимое = Содержимое + HTMLШагПриветствие();
	ИначеЕсли ТекущаяСтраница = 2 Тогда
		Содержимое = Содержимое + HTMLШагПользователь();
	ИначеЕсли ТекущаяСтраница = 3 Тогда
		Содержимое = Содержимое + HTMLШагПровайдер();
	ИначеЕсли ТекущаяСтраница = 4 Тогда
		Содержимое = Содержимое + HTMLШагAPIКлюч(ТекстБаланса);
	ИначеЕсли ТекущаяСтраница = 5 Тогда
		Содержимое = Содержимое + HTMLШагПресет();
	ИначеЕсли ТекущаяСтраница = 6 Тогда
		Содержимое = Содержимое + HTMLШагГотово(СводкаHTML);
	Иначе
		Содержимое = Содержимое + HTMLШагПриветствие();
	КонецЕсли;

	Содержимое = Содержимое + "</div>";
	Содержимое = Содержимое + HTMLПанельНавигации(ТекущаяСтраница);

	Возврат HTMLКаркасМастера(Содержимое);

КонецФункции

// Баннер статуса последнего действия (успех/ошибка), встраивается в верх шага.
//
&НаСервере
Функция HTMLБаннерСтатуса(Знач Статус, Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	КлассСтатуса = ?(Статус = "error", "ar-summary-error", "ar-summary-ok");

	Возврат "<div class=""ar-summary " + КлассСтатуса + """>" + ar_ЭкранироватьHTML(Текст) + "</div>";

КонецФункции

// Прогресс-полоса шагов 1..6.
//
&НаКлиентеНаСервереБезКонтекста
Функция HTMLПрогрессМастера(Знач Номер)

	Подписи = Новый Массив;
	Подписи.Добавить(НСтр("ru='Приветствие'; en='Welcome'"));
	Подписи.Добавить(НСтр("ru='Пользователь'; en='User'"));
	Подписи.Добавить(НСтр("ru='Провайдер'; en='Provider'"));
	Подписи.Добавить(НСтр("ru='API-ключ'; en='API key'"));
	Подписи.Добавить(НСтр("ru='Пресет'; en='Preset'"));
	Подписи.Добавить(НСтр("ru='Готово'; en='Done'"));

	Шаги = "";
	Для Индекс = 1 По 6 Цикл
		Если Индекс < Номер Тогда
			Класс = "ar-wizard-step-done";
		ИначеЕсли Индекс = Номер Тогда
			Класс = "ar-wizard-step-active";
		Иначе
			Класс = "ar-wizard-step-pending";
		КонецЕсли;
		Шаги = Шаги
			+ "<div class=""ar-wizard-step " + Класс + """>"
			+ "<span class=""ar-wizard-step-num"">" + Формат(Индекс, "ЧГ=0; ЧДЦ=0") + "</span>"
			+ "<span class=""ar-wizard-step-label"">" + ar_ЭкранироватьHTML(Подписи[Индекс - 1]) + "</span>"
			+ "</div>";
	КонецЦикла;

	Возврат "<div class=""ar-wizard-steps"">" + Шаги + "</div>";

КонецФункции

// Шаг 1: приветствие.
//
&НаСервере
Функция HTMLШагПриветствие()

	Возврат
		"<h1>" + ar_ЭкранироватьHTML(НСтр("ru='AgentRunner - ваш помощник для работы с ИИ в 1С'; en='AgentRunner - your agent runtime inside 1C'")) + "</h1>"
		+ "<p>" + ar_ЭкранироватьHTML(НСтр(
			"ru='Этот мастер поможет сделать первоначальную настройку за несколько минут. Вы создадите служебного пользователя, выберете LLM-провайдера, введёте API-ключ и импортируете первый пресет агента.';
			|en='This wizard will guide you through initial setup in a few minutes. You will create a service user, choose an LLM provider, enter an API key, and import your first agent preset.'"))
		+ "</p>"
		+ "<p>" + ССылкаДействие("open-docs", "", НСтр("ru='Открыть документацию'; en='Open documentation'"), "ar-btn") + "</p>";

КонецФункции

// Шаг 2: служебный пользователь ИБ.
//
&НаСервере
Функция HTMLШагПользователь()

	ТабСуществующий = ?(НовыйПользовательРежим, "", "ar-radio-tab-active");
	ТабНовый        = ?(НовыйПользовательРежим, "ar-radio-tab-active", "");

	Табы =
		"<div class=""ar-radio-tabs"">"
		+ "<a href=""1c://user-mode?mode=new"" class=""ar-radio-tab " + ТабНовый + """>"
		+ ar_ЭкранироватьHTML(НСтр("ru='Создать нового'; en='Create new'")) + "</a>"
		+ "<a href=""1c://user-mode?mode=existing"" class=""ar-radio-tab " + ТабСуществующий + """>"
		+ ar_ЭкранироватьHTML(НСтр("ru='Использовать существующего'; en='Use existing'")) + "</a>"
		+ "</div>";

	Если НовыйПользовательРежим Тогда
		Блок = HTMLБлокНовогоПользователя();
	Иначе
		Блок = HTMLБлокВыбораПользователя();
	КонецЕсли;

	Возврат
		"<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Служебный пользователь ИБ'; en='IB service user'")) + "</h2>"
		+ Табы
		+ Блок;

КонецФункции

&НаСервере
Функция HTMLБлокНовогоПользователя()

	СтатусПользователя = "";
	Если ПользовательСоздан И НовыйПользовательРежим Тогда
		СтатусПользователя = "<div class=""ar-summary ar-summary-ok"">"
			+ ar_ЭкранироватьHTML(НСтр("ru='Пользователь создан/уже существует'; en='User created/already exists'"))
			+ "</div>";
	КонецЕсли;

	Возврат
		"<p class=""ar-hint"">" + ar_ЭкранироватьHTML(НСтр(
			"ru='Пользователь будет добавлен с ролями ar_РольАдмин и ar_РольСлужебный без интерактивного входа.';
			|en='The user will be added with ar_РольАдмин and ar_РольСлужебный roles, without interactive login.'"))
		+ "</p>"
		+ HTMLПолеВвода("ИмяПользователяИБ", НСтр("ru='Имя пользователя ИБ'; en='IB username'"), ИмяПользователяИБ, "text")
		+ HTMLПолеВвода("ПарольПользователяИБ", НСтр("ru='Пароль'; en='Password'"), "", "password")
		+ HTMLПолеВвода("ПодтверждениеПароля", НСтр("ru='Подтверждение пароля'; en='Confirm password'"), "", "password")
		+ "<p>" + ССылкаДействие("create-user", "", НСтр("ru='Создать пользователя'; en='Create user'"), "ar-btn ar-btn-primary") + "</p>"
		+ СтатусПользователя;

КонецФункции

&НаСервере
Функция HTMLБлокВыбораПользователя()

	Представление = ?(ПустаяСтрока(ПредставлениеСлужебногоПользователя),
		НСтр("ru='(не выбран)'; en='(not set)'"), ПредставлениеСлужебногоПользователя);

	СтатусПользователя = "";
	Если ПользовательСоздан И Не НовыйПользовательРежим И Не ПустаяСтрока(ПредставлениеСлужебногоПользователя) Тогда
		СтатусПользователя = "<div class=""ar-summary ar-summary-ok"">"
			+ ar_ЭкранироватьHTML(НСтр("ru='Служебный пользователь выбран'; en='Service user selected'"))
			+ "</div>";
	КонецЕсли;

	Возврат
		"<p class=""ar-hint"">" + ar_ЭкранироватьHTML(НСтр(
			"ru='Выберите пользователя ИБ, от имени которого будет исполняться планировщик агентов.';
			|en='Select the IB user under whose identity the agent scheduler will run.'"))
		+ "</p>"
		+ "<div class=""ar-setting-editor-block"">"
		+ "<span class=""ar-refval"">" + ar_ЭкранироватьHTML(Представление) + "</span>"
		+ ССылкаДействие("pick-user", "", НСтр("ru='Выбрать…'; en='Select…'"), "ar-btn ar-btn-small")
		+ "</div>"
		+ СтатусПользователя;

КонецФункции

// Шаг 3: LLM-провайдер.
//
&НаСервере
Функция HTMLШагПровайдер()

	// Вкладка "Использовать существующий" показывается только если в справочнике
	// уже есть хотя бы одна запись - иначе выбирать нечего, и вкладка вводит в
	// заблуждение. Режим по умолчанию (см. ПриСозданииНаСервере) - "новый".
	ЕстьСуществующиеПровайдеры = ЕстьЗаписиСправочникаПровайдеров();

	Если ЕстьСуществующиеПровайдеры Тогда
		ТабСуществующий = ?(НовыйПровайдерРежим, "", "ar-radio-tab-active");
		ТабНовый        = ?(НовыйПровайдерРежим, "ar-radio-tab-active", "");

		Табы =
			"<div class=""ar-radio-tabs"">"
			+ "<a href=""1c://provider-mode?mode=new"" class=""ar-radio-tab " + ТабНовый + """>"
			+ ar_ЭкранироватьHTML(НСтр("ru='Создать новый'; en='Create new'")) + "</a>"
			+ "<a href=""1c://provider-mode?mode=existing"" class=""ar-radio-tab " + ТабСуществующий + """>"
			+ ar_ЭкранироватьHTML(НСтр("ru='Использовать существующий'; en='Use existing'")) + "</a>"
			+ "</div>";
	Иначе
		Табы = "";
	КонецЕсли;

	Если НовыйПровайдерРежим Или Не ЕстьСуществующиеПровайдеры Тогда
		Блок = HTMLБлокНовогоПровайдера();
	Иначе
		Блок = HTMLБлокВыбораПровайдера();
	КонецЕсли;

	Возврат
		"<h2>" + ar_ЭкранироватьHTML(НСтр("ru='LLM-провайдер'; en='LLM provider'")) + "</h2>"
		+ "<p class=""ar-hint"">" + ar_ЭкранироватьHTML(НСтр(
			"ru='LLM-провайдер - это сервис, который будет обрабатывать запросы агентов (генерировать ответы, вызывать инструменты). Можно использовать облачный шлюз AgentRunner.ru, подключить свой ключ OpenAI/Anthropic/YandexGPT/GigaChat, либо указать локальную OpenAI-совместимую модель в вашем контуре.';
			|en='The LLM provider is the service that processes agent requests (generates responses, calls tools). You can use the AgentRunner.ru cloud gateway, connect your own OpenAI/Anthropic/YandexGPT/GigaChat key, or point to a local OpenAI-compatible model in your own environment.'"))
		+ "</p>"
		+ Табы
		+ Блок;

КонецФункции

// Проверяет наличие хотя бы одной незапомеченной на удаление записи справочника
// провайдеров - используется для решения, показывать ли вкладку "существующий".
//
&НаСервере
Функция ЕстьЗаписиСправочникаПровайдеров()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ar_LLMПровайдеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ar_LLMПровайдеры КАК ar_LLMПровайдеры
	|ГДЕ
	|	НЕ ar_LLMПровайдеры.ПометкаУдаления";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

&НаСервере
Функция HTMLБлокВыбораПровайдера()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ar_LLMПровайдеры.Ссылка КАК Ссылка,
	|	ar_LLMПровайдеры.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ar_LLMПровайдеры КАК ar_LLMПровайдеры
	|ГДЕ
	|	ar_LLMПровайдеры.ar_Включён = ИСТИНА
	|	И НЕ ar_LLMПровайдеры.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();

	Опции = "";
	Пока Выборка.Следующий() Цикл
		Выбран = ?(Выборка.Ссылка = ВыбранныйПровайдер, " selected", "");
		Опции = Опции
			+ "<option value=""" + ar_ЭкранироватьHTML(Строка(Выборка.Ссылка.УникальныйИдентификатор())) + """" + Выбран + ">"
			+ ar_ЭкранироватьHTML(Выборка.Наименование) + "</option>";
	КонецЦикла;

	Если ПустаяСтрока(Опции) Тогда
		Возврат "<div class=""ar-note"">" + ar_ЭкранироватьHTML(НСтр(
			"ru='Активных провайдеров пока нет. Создайте нового.'; en='No active providers yet. Create a new one.'")) + "</div>";
	КонецЕсли;

	Возврат
		"<select id=""ПолеВыбораПровайдера"" class=""ar-input"" onchange=""arNav('1c://select-provider')"">"
		+ Опции + "</select>";

КонецФункции

&НаСервере
Функция HTMLБлокНовогоПровайдера()

	// Мастер предлагает только эти 4 типа в заданном порядке (не весь перечень
	// ar_ТипПровайдера). Тот же список теперь ограничивает и карточку справочника
	// ar_LLMПровайдеры, так что остальные значения (OpenAI, Anthropic, Mock)
	// в UI не выбираются - только программно. AgentRunnerCloud - выбор по
	// умолчанию (готовый шлюз без своего ключа у стороннего провайдера).
	ТипыДляВыбора = ТипыПровайдераДляМастера();

	ОпцииТипов = "";
	Для Каждого ОписаниеТипа Из ТипыДляВыбора Цикл
		Выбран = ?(ОписаниеТипа.Ссылка = ТипНовогоПровайдера, " selected", "");
		ОпцииТипов = ОпцииТипов
			+ "<option value=""" + ОписаниеТипа.Имя + """" + Выбран + ">" + ar_ЭкранироватьHTML(ОписаниеТипа.Подпись) + "</option>";
	КонецЦикла;

	Реклама = "";
	Если ТипНовогоПровайдера = Перечисления.ar_ТипПровайдера.AgentRunnerCloud Тогда
		Реклама = HTMLРекламаAgentRunnerCloud();
	КонецЕсли;

	Возврат
		HTMLПолеВвода("ИмяНовогоПровайдера", НСтр("ru='Наименование'; en='Name'"), ИмяНовогоПровайдера, "text")
		+ "<div class=""ar-setting-editor-block"">"
		+ "<div class=""ar-setting-label"">" + ar_ЭкранироватьHTML(НСтр("ru='Тип провайдера'; en='Provider type'")) + "</div>"
		+ "<select id=""ТипНовогоПровайдера"" class=""ar-input"" onchange=""arNav('1c://provider-type')"">"
		+ ОпцииТипов + "</select></div>"
		+ HTMLПолеВвода("BaseURLНовогоПровайдера", НСтр("ru='BaseURL'; en='BaseURL'"), BaseURLНовогоПровайдера, "text")
		+ HTMLПолеВвода("МодельНовогоПровайдера", НСтр("ru='Модель'; en='Model'"), МодельНовогоПровайдера, "text")
		+ ПодсказкаМодели()
		+ Реклама;

КонецФункции

// Подсказка к полю "Модель" (шаг 3). Для локального сервера имя модели задать
// за пользователя нельзя - оно зависит от того, что загружено в LM Studio/Ollama.
&НаСервере
Функция ПодсказкаМодели()

	Если ТипНовогоПровайдера = Перечисления.ar_ТипПровайдера.LocalCompatible Тогда
		Текст = НСтр("ru='Идентификатор модели так, как её отдаёт локальный сервер
			|(например, в LM Studio - имя загруженной модели).';
			|en='Model identifier as reported by the local server
			|(in LM Studio - the name of the loaded model).'");
	Иначе
		Текст = НСтр("ru='Модель по умолчанию для новых чатов. Можно изменить позже в карточке провайдера.';
			|en='Default model for new chats. Can be changed later in the provider card.'");
	КонецЕсли;

	Возврат "<p class=""ar-hint"">" + ar_ЭкранироватьHTML(Текст) + "</p>";

КонецФункции

// Рекламный блок шлюза AgentRunner Cloud - показывается, когда выбран тип
// провайдера AgentRunnerCloud (шаг 3).
//
&НаСервере
Функция HTMLРекламаAgentRunnerCloud()

	Возврат
		"<div class=""ar-note ar-note-promo"">"
		+ "<p>" + ar_ЭкранироватьHTML(НСтр(
			"ru='Доступ к нейросетям за рубли. Российский шлюз к открытым моделям, YandexGPT, ГигаЧат. Оплата в рублях российскому юрлицу, закрывающие документы, баланс как жёсткий потолок расходов.';
			|en='Access to neural networks, paid in rubles. Russian gateway to open models, YandexGPT, GigaChat. Payment in rubles to a Russian legal entity, closing documents, balance as a hard spending cap.'"))
		+ "</p>"
		+ "<p>" + ССылкаДействие("open-account", "", НСтр("ru='Подключить'; en='Connect'"), "ar-btn ar-btn-primary") + "</p>"
		+ "</div>";

КонецФункции

// Список типов провайдера, предлагаемых мастером, в фиксированном порядке.
// Список общий с карточкой справочника ar_LLMПровайдеры - см. описание в
// ar_LLMДиспетчер.ТипыПровайдераДляВыбора().
//
// Возвращаемое значение:
//  Массив из Структура - Имя (Строка, имя значения enum),
//                         Ссылка (ПеречислениеСсылка.ar_ТипПровайдера),
//                         Подпись (Строка, отображаемый текст в <option>).
//
&НаСервере
Функция ТипыПровайдераДляМастера()

	Возврат ar_LLMДиспетчер.ТипыПровайдераДляВыбора();

КонецФункции

// Шаг 4: API-ключ.
//
&НаСервере
Функция HTMLШагAPIКлюч(Знач ТекстБаланса)

	ЗаголовокПровайдера = "";
	Если ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
		ЗаголовокПровайдера = "<p class=""ar-hint"">" + СтрШаблон(
			НСтр("ru='Настраивается провайдер: %1'; en='Configuring provider: %1'"),
			ar_ЭкранироватьHTML(ВыбранныйПровайдер.Наименование)) + "</p>";
	КонецЕсли;

	КнопкаПолучитьКлюч = "";
	Если ЗначениеЗаполнено(ВыбранныйПровайдер)
		И ВыбранныйПровайдер.ar_Тип = Перечисления.ar_ТипПровайдера.AgentRunnerCloud Тогда
		КнопкаПолучитьКлюч = "<p>" + ССылкаДействие("open-account", "",
			НСтр("ru='Получить ключ'; en='Get key'"), "ar-btn") + "</p>";
	КонецЕсли;

	СтатусКлюча = "";
	Если КлючВведен Тогда
		СтатусКлюча = "<div class=""ar-summary ar-summary-ok"">"
			+ ar_ЭкранироватьHTML(НСтр("ru='API-ключ сохранён'; en='API key saved'")) + "</div>";
	КонецЕсли;

	БаннерБаланса = "";
	Если Не ПустаяСтрока(ТекстБаланса) Тогда
		БаннерБаланса = "<div class=""ar-summary ar-summary-warning"">" + ar_ЭкранироватьHTML(ТекстБаланса) + "</div>";
	КонецЕсли;

	Возврат
		"<h2>" + ar_ЭкранироватьHTML(НСтр("ru='API-ключ'; en='API key'")) + "</h2>"
		+ ЗаголовокПровайдера
		+ КнопкаПолучитьКлюч
		+ HTMLПолеВвода("APIКлюч", НСтр("ru='API-ключ'; en='API key'"), "", "password")
		+ "<p>" + ССылкаДействие("test-connection", "", НСтр("ru='Проверить соединение'; en='Test connection'"), "ar-btn ar-btn-primary") + "</p>"
		+ СтатусКлюча
		+ БаннерБаланса;

КонецФункции

// Шаг 5: импорт пресетов.
//
// Пресеты - готовые шаблоны агентов (инструкция, LLM-провайдер, модель,
// набор tools/skills). Мастер предлагает встроенные пресеты, поставляемые
// вместе с расширением (макеты ar_Пресет_* обработки ar_ПресетыВстроенные) -
// можно отметить несколько, каждый отмеченный создаст отдельного агента.
//
&НаСервере
Функция HTMLШагПресет()

	СписокПресетов = ПолучитьСписокВстроенныхПресетовНаСервере();

	Подсказка =
		"<p class=""ar-hint"">" + ar_ЭкранироватьHTML(НСтр(
			"ru='Пресет - это готовый шаблон агента: инструкция, LLM-провайдер, модель и набор инструментов. Отметьте один или несколько пресетов - для каждого будет создан отдельный агент. Шаг можно пропустить и настроить агента позже вручную.';
			|en='A preset is a ready-made agent template: instruction, LLM provider, model and toolset. Check one or more presets - each checked preset creates a separate agent. This step can be skipped and the agent configured manually later.'"))
		+ "</p>";

	ЕстьВалидныеПресеты = Ложь;
	Для Каждого Пресет Из СписокПресетов Цикл
		Если Пресет.JSONВалиден Тогда
			ЕстьВалидныеПресеты = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьВалидныеПресеты Тогда
		Возврат
			"<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Импорт пресетов'; en='Import presets'")) + "</h2>"
			+ Подсказка
			+ "<div class=""ar-note"">" + ar_ЭкранироватьHTML(НСтр(
				"ru='Встроенные пресеты не найдены. Пропустите этот шаг - агента можно будет создать вручную в разделе «Агенты».';
				|en='No built-in presets found. Skip this step - an agent can be created manually in the Agents section.'")) + "</div>";
	КонецЕсли;

	ОтмеченныеСписком = СтрРазделить(ОтмеченныеПресеты, ",", Ложь);

	СтрокиЧекбоксов = "";
	Для Каждого Пресет Из СписокПресетов Цикл
		Если Не Пресет.JSONВалиден Тогда
			Продолжить; // битые макеты не показываем пользователю
		КонецЕсли;

		Отмечен = ?(ОтмеченныеСписком.Найти(Пресет.ИмяМакета) <> Неопределено, " checked", "");

		ПредупреждениеСовместимости = "";
		Если Пресет.НесовместимаяКонфигурация Тогда
			ПредупреждениеСовместимости = "<div class=""ar-summary ar-summary-warning"">"
				+ ar_ЭкранироватьHTML(НСтр(
					"ru='Пресет мог быть рассчитан на другую конфигурацию - проверьте инструменты после импорта.';
					|en='This preset may target a different configuration - review tools after import.'"))
				+ "</div>";
		КонецЕсли;

		СтрокиЧекбоксов = СтрокиЧекбоксов
			+ "<div class=""ar-setting"">"
			+ "<label class=""ar-checkbox-label"">"
			+ "<input type=""checkbox"" id=""" + ar_ЭкранироватьHTML(Пресет.ИмяМакета) + """" + Отмечен
			+ " onchange=""arNav('1c://toggle-preset?key=" + ar_ЭкранироватьHTML(Пресет.ИмяМакета) + "')"">"
			+ ar_ЭкранироватьHTML(Пресет.Наименование)
			+ "</label>"
			+ "<p class=""ar-hint"">" + ar_ЭкранироватьHTML(Пресет.Описание) + "</p>"
			+ ПредупреждениеСовместимости
			+ "</div>";
	КонецЦикла;

	СостояниеАктиватора = ?(АктивироватьАгента, " checked", "");

	Возврат
		"<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Импорт пресетов'; en='Import presets'")) + "</h2>"
		+ Подсказка
		+ СтрокиЧекбоксов
		+ "<div class=""ar-setting"">"
		+ "<label class=""ar-checkbox-label"">"
		+ "<input type=""checkbox""" + СостояниеАктиватора + " onchange=""arNav('1c://toggle?key=АктивироватьАгента')"">"
		+ ar_ЭкранироватьHTML(НСтр("ru='Сразу активировать агента(ов)'; en='Activate agent(s) immediately'"))
		+ "</label></div>";

КонецФункции

// Возвращает описания всех встроенных пресетов (макетов ar_Пресет_* обработки
// ar_ПресетыВстроенные), готовые для отрисовки списка чекбоксов на шаге 5.
// Битые/невалидные макеты не пропадают из списка молча - помечаются
// JSONВалиден = Ложь, вызывающий код их не отрисовывает.
//
// Возвращаемое значение:
//   Массив из Структура - ИмяМакета (Строка), Наименование (Строка),
//     Описание (Строка), JSONВалиден (Булево), НесовместимаяКонфигурация (Булево).
//
&НаСервере
Функция ПолучитьСписокВстроенныхПресетовНаСервере()

	Результат = Новый Массив;

	МетаОбработки = Метаданные.Обработки.Найти("ar_ПресетыВстроенные");
	Если МетаОбработки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого МетаМакета Из МетаОбработки.Макеты Цикл

		Если Не СтрНачинаетсяС(МетаМакета.Имя, "ar_Пресет_") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("ИмяМакета", МетаМакета.Имя);
		Элемент.Вставить("Наименование", МетаМакета.Синоним);
		Элемент.Вставить("Описание", "");
		Элемент.Вставить("JSONВалиден", Ложь);
		Элемент.Вставить("НесовместимаяКонфигурация", Ложь);

		Попытка
			ТекстJSON = Обработки.ar_ПресетыВстроенные.ПолучитьМакет(МетаМакета.Имя).ПолучитьТекст();
			Данные = ar_JSON.ИзJSON(ТекстJSON);
			Если Данные <> Неопределено Тогда
				Если Данные.Получить("description") <> Неопределено Тогда
					Элемент.Описание = Данные.Получить("description");
				КонецЕсли;
				БлокАгента = Данные.Получить("agent");
				Если ТипЗнч(БлокАгента) = Тип("Соответствие") И Не ПустаяСтрока(БлокАгента.Получить("name")) Тогда
					Элемент.Наименование = БлокАгента.Получить("name");
				КонецЕсли;
				Элемент.НесовместимаяКонфигурация = Не ПресетСовместимСКонфигурациейНаСервере(Данные);
				Элемент.JSONВалиден = Истина;
			КонецЕсли;
		Исключение
			// Битый макет - пропускаем молча, не роняем мастер.
			Элемент.JSONВалиден = Ложь;
		КонецПопытки;

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет совместимость пресета с текущей конфигурацией по полю
// compatible_configs (та же логика, что в ar_ПресетыИмпорт.КонфигурацияСовместима,
// продублирована здесь т.к. это внутренняя функция другого модуля - используется
// только для варнинга в списке до фактического импорта).
//
&НаСервере
Функция ПресетСовместимСКонфигурациейНаСервере(Знач Данные)

	СписокКонфигураций = Данные.Получить("compatible_configs");
	Если ТипЗнч(СписокКонфигураций) <> Тип("Массив") Или СписокКонфигураций.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяТекущейКонфигурации = НРег(Метаданные.Имя);

	Для Каждого Элемент Из СписокКонфигураций Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(Элемент) = "universal" Или НРег(Элемент) = ИмяТекущейКонфигурации Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Шаг 6: готово, сводка.
//
&НаСервере
Функция HTMLШагГотово(Знач СводкаHTML)

	Возврат
		"<h2>" + ar_ЭкранироватьHTML(НСтр("ru='Настройка завершена!'; en='Setup Complete!'")) + "</h2>"
		+ СводкаHTML
		+ "<p>"
		+ ССылкаДействие("open-agents", "", НСтр("ru='Открыть агентов'; en='Open agents'"), "ar-btn")
		+ ССылкаДействие("open-settings", "", НСтр("ru='Открыть настройки'; en='Open settings'"), "ar-btn")
		+ "</p>";

КонецФункции

// Формирует сводку выполненных шагов для страницы "Готово".
//
&НаСервере
Функция СобратьСводкуHTML()

	Строки = Новый Массив;

	Если ПользовательСоздан И НовыйПользовательРежим Тогда
		Строки.Добавить(СтрШаблон(
			НСтр("ru='Пользователь ""%1"" создан/существует'; en='User ""%1"" created/exists'"), ИмяПользователяИБ));
	ИначеЕсли ПользовательСоздан И Не ПустаяСтрока(ПредставлениеСлужебногоПользователя) Тогда
		Строки.Добавить(СтрШаблон(
			НСтр("ru='Служебный пользователь ""%1"" выбран'; en='Service user ""%1"" selected'"), ПредставлениеСлужебногоПользователя));
	Иначе
		Строки.Добавить(НСтр("ru='Шаг «Пользователь» пропущен'; en='User step skipped'"));
	КонецЕсли;

	Если ЗначениеЗаполнено(ВыбранныйПровайдер) Тогда
		Строки.Добавить(СтрШаблон(
			НСтр("ru='Провайдер ""%1"" настроен'; en='Provider ""%1"" configured'"), Строка(ВыбранныйПровайдер)));
	Иначе
		Строки.Добавить(НСтр("ru='Шаг «Провайдер» пропущен'; en='Provider step skipped'"));
	КонецЕсли;

	Если КлючВведен Тогда
		Строки.Добавить(НСтр("ru='API-ключ сохранён'; en='API key saved'"));
	Иначе
		Строки.Добавить(НСтр("ru='API-ключ не введён (добавьте позже)'; en='API key not entered (add later)'"));
	КонецЕсли;

	РезультатыИмпорта = ar_JSON.ИзJSON(РезультатыИмпортаJSON);
	Если ТипЗнч(РезультатыИмпорта) <> Тип("Массив") Или РезультатыИмпорта.Количество() = 0 Тогда
		Строки.Добавить(НСтр("ru='Шаг «Пресеты» пропущен'; en='Presets step skipped'"));
	Иначе
		Для Каждого СтрокаРезультата Из РезультатыИмпорта Цикл
			Если СтрокаРезультата.Получить("Успех") = Истина Тогда
				Строки.Добавить(СтрШаблон(
					НСтр("ru='Агент ""%1"" импортирован'; en='Agent ""%1"" imported'"),
					СтрокаРезультата.Получить("ИмяАгента")));
			Иначе
				Строки.Добавить(СтрШаблон(
					НСтр("ru='Пресет ""%1"" не импортирован (%2)'; en='Preset ""%1"" not imported (%2)'"),
					СтрокаРезультата.Получить("ИмяМакета"), СтрокаРезультата.Получить("Причина")));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// UNIV-01: карточка профиля конфигурации - "на чём стоим" видно уже на
	// финальном шаге мастера. ЗаполнитьАвтоматически() уже выполнена в
	// ЗавершитьМастерНаСервере() до сборки сводки (см. вызов там же).
	Строки.Добавить(СтрокаПрофиляКонфигурацииДляСводки());

	// UNIV-04: результат последнего применения профиля маппинга (если кнопка
	// уже была нажата в этой же сессии мастера) - показываем сразу под
	// карточкой профиля, до предложения применить снова.
	Если ЗначениеЗаполнено(РезультатИмпортаПрофиляJSON) Тогда
		Строки.Добавить(СтрокаРезультатаИмпортаПрофиляДляСводки());
	КонецЕсли;

	HTMLСтрок = "";
	Для Каждого Строка Из Строки Цикл
		HTMLСтрок = HTMLСтрок + "<div class=""ar-diag-row"">" + ar_ЭкранироватьHTML(Строка) + "</div>";
	КонецЦикла;

	// UNIV-04: блок предложения "Обнаружена конфигурация X - применить профиль
	// маппинга Y?" - вне общего списка Строки (собственная HTML-разметка с
	// кнопкой-действием, не просто текстовая строка сводки).
	HTMLСтрок = HTMLСтрок + HTMLБлокПредложенияПрофиляМаппинга();

	Возврат "<div class=""ar-card"">" + HTMLСтрок + "</div>";

КонецФункции

// UNIV-01: формирует строку сводки вида "Конфигурация: <Имя> <Версия> (<Тип>)"
// для карточки на шаге "Готово". Читает
// ar_ПрофильКонфигурации.ОпределитьКонфигурацию() напрямую - вызывается один
// раз при сборке сводки, не на каждый tool-вызов, кэш ПовтИсп неприменим.
//
// Возвращаемое значение:
//  Строка - текст строки сводки о профиле конфигурации.
//
&НаСервере
Функция СтрокаПрофиляКонфигурацииДляСводки()

	Конфигурация = ar_ПрофильКонфигурации.ОпределитьКонфигурацию();

	Возврат СтрШаблон(
		НСтр("ru='Конфигурация: %1 %2 (%3)'; en='Configuration: %1 %2 (%3)'"),
		?(ЗначениеЗаполнено(Конфигурация.Имя), Конфигурация.Имя, НСтр("ru='?'; en='?'")),
		Конфигурация.Версия,
		Конфигурация.Тип);

КонецФункции

// UNIV-04: таблица соответствия "Тип конфигурации (ar_ПрофильКонфигурации.
// ОпределитьКонфигурацию().Тип) -> имя общего макета-заготовки профиля
// маппинга". Константа в теле модуля формы (по аналогии с whitelist-
// таблицами в ar_ПрофилиИмпорт) - расширяется вручную при появлении новых
// заготовок (КА, УНФ).
//
// Возвращаемое значение:
//  Соответствие - Строка(Тип) -> Строка(ИмяОбщегоМакета).
//
&НаСервере
Функция ИмяМакетаПрофиляПоТипуКонфигурации()
	Результат = Новый Соответствие;
	Результат.Вставить("БП", "ar_Профиль_БП30");
	Результат.Вставить("УТ", "ar_Профиль_УТ11");
	Результат.Вставить("ERP", "ar_Профиль_ERP2");
	Возврат Результат;
КонецФункции

// UNIV-04: определяет по содержимому макета-заготовки профиля, помечен ли он
// как непроверенный ("verified": false). Best-effort: любая проблема чтения/
// разбора (макет недоступен, битый JSON, поле отсутствует) трактуется как
// "проверено" не считается - т.е. плашка не показывается по умолчанию
// только если явно доказано verified=true; при неопределённости (ошибка
// чтения) возвращается Ложь, чтобы не скрыть предупреждение по сбою чтения -
// см. .docs/specs/UNIV-04.md, замечания ревью 1, DoD D4.
//
// Параметры:
//  ИмяМакета - Строка - имя общего макета-заготовки профиля.
//
// Возвращаемое значение:
//  Булево - Истина, если поле "verified" в JSON макета явно равно Ложь.
//
&НаСервере
Функция ПрофильМаппингаНеПроверен(Знач ИмяМакета)

	Попытка
		Макет = ПолучитьОбщийМакет(ИмяМакета);
		ТекстJSON = СокрЛП(Макет.ПолучитьТекст());
	Исключение
		ar_СлужебныйЛог.Записать(
			"ar_МастерНастройки.ПрофильМаппингаНеПроверен",
			"mapping_profile_template_read_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение");
		Возврат Ложь;
	КонецПопытки;

	ДанныеПрофиля = ar_JSON.ИзJSON(ТекстJSON);
	Если ТипЗнч(ДанныеПрофиля) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Verified = ДанныеПрофиля.Получить("verified");
	Возврат ТипЗнч(Verified) = Тип("Булево") И Verified = Ложь;

КонецФункции

// UNIV-04: формирует блок "Обнаружена конфигурация X - применить профиль
// маппинга Y?" для карточки шага 6 "Готово". Показывается только если тип
// конфигурации распознан (Тип <> "Неизвестно") и для него есть заготовка в
// ИмяМакетаПрофиляПоТипуКонфигурации(). Действие необязательное (кнопка,
// не автоприменение) - соответствует общему принципу "предложил, не
// навязал" (см. .docs/specs/UNIV-04.md, раздел 6, обоснование выбора места).
// Для профилей с "verified": false (УТ 11 / ERP 2) добавляет
// предупреждающую плашку ar-note - поле verified читается из содержимого
// макета ДО показа карточки (ПрофильМаппингаНеПроверен), см. .docs/specs/
// UNIV-04.md, замечания ревью 1, DoD D4.
//
// Возвращаемое значение:
//  Строка - HTML-разметка блока предложения или "" если тип не распознан/
//           заготовки для него нет.
//
&НаСервере
Функция HTMLБлокПредложенияПрофиляМаппинга()

	Конфигурация = ar_ПрофильКонфигурации.ОпределитьКонфигурацию();
	ТаблицаМакетов = ИмяМакетаПрофиляПоТипуКонфигурации();
	ИмяМакета = ТаблицаМакетов.Получить(Конфигурация.Тип);

	Если ИмяМакета = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Обнаружена конфигурация %1. Применить профиль маппинга %2?';
			|en = 'Detected configuration %1. Apply mapping profile %2?'"),
		Конфигурация.Тип, ИмяМакета);

	КнопкаПрименить = ССылкаДействие(
		"apply-mapping-profile", "", НСтр("ru='Применить профиль'; en='Apply profile'"), "ar-btn");

	ПлашкаНеПроверено = "";
	Если ПрофильМаппингаНеПроверен(ИмяМакета) Тогда
		ТекстПредупрежденияНеПроверено = НСтр(
			"ru = 'Имена реквизитов для этой конфигурации не проверены сообществом
			|на реальной базе - импорт применит их как black-box, некорректные
			|будут автоматически отброшены при импорте. Профиль стоит проверить
			|или дополнить.';
			|en = 'Attribute names for this configuration are not verified by the
			|community on a real infobase - the import will apply them as a
			|black box, incorrect ones will be automatically discarded on
			|import. Consider reviewing or extending the profile.'");
		ПлашкаНеПроверено =
			"<div class=""ar-note"">"
			+ ar_ЭкранироватьHTML(ТекстПредупрежденияНеПроверено)
			+ "</div>";
	КонецЕсли;

	Возврат
		"<div class=""ar-card ar-setting-editor-block"">"
		+ "<div class=""ar-setting-label"">" + ar_ЭкранироватьHTML(ТекстВопроса) + "</div>"
		+ ПлашкаНеПроверено
		+ КнопкаПрименить
		+ "</div>";

КонецФункции

// UNIV-04: читает результат последнего Импортировать() (сохранённый в
// реквизите РезультатИмпортаПрофиляJSON клиентским обработчиком через
// ПрименитьПрофильМаппингаНаСервере) и формирует строку для сводки.
//
// Возвращаемое значение:
//  Строка - человекочитаемое сообщение результата импорта профиля.
//
&НаСервере
Функция СтрокаРезультатаИмпортаПрофиляДляСводки()

	Результат = ar_JSON.ИзJSON(РезультатИмпортаПрофиляJSON);
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Сообщение = Результат.Получить("Сообщение");
	Если ТипЗнч(Сообщение) <> Тип("Строка") Или ПустаяСтрока(Сообщение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Профиль маппинга: %1'; en = 'Mapping profile: %1'"), Сообщение);

КонецФункции

// UNIV-04: серверная точка входа кнопки "Применить профиль" - читает текст
// заготовки профиля по типу текущей конфигурации, вызывает
// ar_ПрофилиИмпорт.Импортировать(), сохраняет результат (для повторного
// отображения при перерисовке сводки) в реквизит РезультатИмпортаПрофиляJSON.
//
// Возвращаемое значение:
//  Структура - {Успех - Булево, Сообщение - Строка} - для клиентского
//              баннера статуса (ПерерисоватьМастерНаСервере).
//
&НаСервере
Функция ПрименитьПрофильМаппингаНаСервере()

	Конфигурация = ar_ПрофильКонфигурации.ОпределитьКонфигурацию();
	ТаблицаМакетов = ИмяМакетаПрофиляПоТипуКонфигурации();
	ИмяМакета = ТаблицаМакетов.Получить(Конфигурация.Тип);

	РезультатДляКлиента = Новый Структура("Успех, Сообщение", Ложь, "");

	Если ИмяМакета = Неопределено Тогда
		РезультатДляКлиента.Сообщение = НСтр(
			"ru = 'Для этой конфигурации нет встроенной заготовки профиля';
			|en = 'No built-in profile template for this configuration'");
		Возврат РезультатДляКлиента;
	КонецЕсли;

	Попытка
		Макет = ПолучитьОбщийМакет(ИмяМакета);
		ТекстJSON = СокрЛП(Макет.ПолучитьТекст());
	Исключение
		// Best-effort: макет недоступен/повреждён - Импортировать("") штатно
		// вернёт Причина="invalid_json", мастер не падает (см. .docs/specs/UNIV-04.md,
		// раздел "Механика чтения"). Логируем для диагностики - тихое
		// поглощение ошибки без следа затруднило бы отладку в проде.
		ТекстJSON = "";
		ar_СлужебныйЛог.Записать(
			"ar_МастерНастройки.ПрименитьПрофильМаппингаНаСервере",
			"mapping_profile_template_read_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение");
	КонецПопытки;

	РезультатИмпорта = ar_ПрофилиИмпорт.Импортировать(ТекстJSON);

	РезультатИмпортаПрофиляJSON = ar_JSON.ВЗначениеJSON(РезультатИмпорта);

	РезультатДляКлиента.Успех = РезультатИмпорта.Успех;
	РезультатДляКлиента.Сообщение = РезультатИмпорта.Сообщение;

	Возврат РезультатДляКлиента;

КонецФункции

// Панель кнопок навигации снизу (Назад / Далее / Пропустить / Завершить / Отмена).
//
&НаКлиентеНаСервереБезКонтекста
Функция HTMLПанельНавигации(Знач Номер)

	Кнопки = "";

	Если Номер > 1 Тогда
		Кнопки = Кнопки + ССылкаДействие("back", "", НСтр("ru='< Назад'; en='< Back'"), "ar-btn");
	КонецЕсли;

	Если Номер = 1 Тогда
		Кнопки = Кнопки + ССылкаДействие("cancel", "", НСтр("ru='Отмена'; en='Cancel'"), "ar-btn");
	КонецЕсли;

	Если Номер = 4 Или Номер = 5 Тогда
		Кнопки = Кнопки + ССылкаДействие("skip", "", НСтр("ru='Пропустить'; en='Skip'"), "ar-btn");
	КонецЕсли;

	Если Номер < 6 Тогда
		Кнопки = Кнопки + ССылкаДействие("next", "", НСтр("ru='Далее >'; en='Next >'"), "ar-btn ar-btn-primary");
	Иначе
		Кнопки = Кнопки + ССылкаДействие("finish", "", НСтр("ru='Завершить'; en='Finish'"), "ar-btn ar-btn-primary");
	КонецЕсли;

	Возврат "<div class=""ar-wizard-nav"">" + Кнопки + "</div>";

КонецФункции

// Формирует HTML для текстового/парольного поля ввода с подписью.
//
&НаКлиентеНаСервереБезКонтекста
Функция HTMLПолеВвода(Знач Ид, Знач Подпись, Знач Значение, Знач ТипInput)

	Возврат
		"<div class=""ar-setting-editor-block"">"
		+ "<div class=""ar-setting-label"">" + ar_ЭкранироватьHTML(Подпись) + "</div>"
		+ "<input id=""" + Ид + """ class=""ar-input"" type=""" + ТипInput + """ value=""" + ar_ЭкранироватьHTML(Значение) + """>"
		+ "</div>";

КонецФункции

// Формирует HTML-ссылку-действие с href схемы "1c://".
//
&НаКлиентеНаСервереБезКонтекста
Функция ССылкаДействие(Знач Действие, Знач ПараметрыЗапроса, Знач Текст, Знач КлассCSS)

	Href = "1c://" + Действие;
	Если Не ПустаяСтрока(ПараметрыЗапроса) Тогда
		Href = Href + "?" + ПараметрыЗапроса;
	КонецЕсли;

	Возврат "<a href=""" + Href + """ class=""" + КлассCSS + """>" + ar_ЭкранироватьHTML(Текст) + "</a>";

КонецФункции

// Обёртка HTML-каркаса со встроенными стилями (офлайн-first, без внешних CDN).
// Стилистически идентичен HTMLКаркасНастроек из ar_Настройки (единый визуальный
// язык расширения) плюс классы для прогресс-полосы и панели навигации мастера.
