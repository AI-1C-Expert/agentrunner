////////////////////////////////////////////////////////////////////////////////
// Общая форма ar_ФормаПросмотраPrompt («Что увидит LLM») — UI-03/UI-11.
//
// UI-03: показывает финальный сборный prompt после всех слоёв контекста,
// разложенный по вкладкам: системный prompt из константы, инструкция агента
// и итоговый STABLE-слой (то, что реально отправится в LLM). Над вкладками —
// оценка числа токенов итогового слоя. Все поля только для чтения.
//
// UI-11: переиспользуется (ОткрытьФорму, БлокироватьОкноВладельца) для показа полного
// массива сообщений prompt конкретного LLM-вызова (CommonForm.ar_ПросмотрЗапуска,
// кнопка «Показать prompt»). В этом случае вызывающий код передаёт
// СкрытьСистемныйИИнструкцию = Истина (вкладки «Системный»/«Инструкция»
// неприменимы к фактическому массиву сообщений) и опционально ЗаголовокФормы.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Ветка автотеста: при программном открытии формы тестами пропускаем
	// инициализацию (единый паттерн форм расширения).
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ТекстPrompt = СтрокаПараметра("ТекстPrompt");
	СистемныйPrompt = СтрокаПараметра("СистемныйPrompt");
	ИнструкцияPrompt = СтрокаПараметра("ИнструкцияPrompt");
	ИмяМодели = СтрокаПараметра("ИмяМодели");

	ОценкаТокенов = ar_Токены.Оценить(ТекстPrompt, ИмяМодели);

	Если ОценкаТокенов = 0 Тогда
		Элементы.ДекорацияТокены.Заголовок = НСтр(
			"ru = 'Оценка: ~0 токенов (инструкция пуста)';
			|en = 'Estimate: ~0 tokens (no instruction)'");
	Иначе
		Элементы.ДекорацияТокены.Заголовок = СтрШаблон(
			НСтр("ru = 'Оценка: ~%1 токенов'; en = 'Estimate: ~%1 tokens'"),
			Формат(ОценкаТокенов, "ЧГ=0; ЧДЦ=0"));
	КонецЕсли;

	Элементы.ГруппаСекции.ТекущаяСтраница = Элементы.СтраницаИтог;

	// UI-11: при просмотре фактического массива messages LLM-вызова вкладки
	// «Системный»/«Инструкция» (сборка prompt агента, UI-03) скрываются —
	// для UI-03 параметр не передаётся, поведение не меняется (D5).
	Если СкрытьСистемныйИИнструкциюПараметр() Тогда
		Элементы.СтраницаСистемный.Видимость = Ложь;
		Элементы.СтраницаИнструкция.Видимость = Ложь;
	КонецЕсли;

	// UI-11: опциональный заголовок окна («Prompt запуска N, шаг K»).
	// Если не передан — заголовок по умолчанию («Что увидит LLM», UI-03).
	НовыйЗаголовок = СтрокаПараметра("ЗаголовокФормы");
	Если Не ПустаяСтрока(НовыйЗаголовок) Тогда
		Заголовок = НовыйЗаголовок;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ar_СкопироватьPrompt(Команда)

	ТекстДляКопирования = ТекстАктивнойСтраницы();

	Попытка
		ПоместитьВБуферОбмена(ТекстДляКопирования);
	Исключение
		ПоказатьПредупреждение(, НСтр(
			"ru = 'Копирование недоступно в данном режиме.';
			|en = 'Copying is not available in this mode.'"));
		Возврат;
	КонецПопытки;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Скопировано'; en = 'Copied'"),
		,
		НСтр("ru = 'Текст помещён в буфер обмена'; en = 'Text copied to clipboard'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ТекстАктивнойСтраницы()

	ТекущаяСтраница = Элементы.ГруппаСекции.ТекущаяСтраница;

	Если ТекущаяСтраница = Элементы.СтраницаСистемный Тогда
		Возврат СистемныйPrompt;
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаИнструкция Тогда
		Возврат ИнструкцияPrompt;
	Иначе
		// Страница «Итог» (STABLE-слой) — по умолчанию.
		Возврат ТекстPrompt;
	КонецЕсли;

КонецФункции

// Безопасно читает строковый параметр формы: если не передан, возвращает "".
//
// Параметры:
//   ИмяПараметра - Строка - имя параметра формы (см. Параметры формы в Form.xml).
//
// Возвращаемое значение:
//   Строка - значение параметра, если передан и имеет тип Строка; иначе "".
//
&НаСервере
Функция СтрокаПараметра(Знач ИмяПараметра)

	Значение = "";
	Если Параметры.Свойство(ИмяПараметра, Значение) И ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат "";

КонецФункции

// UI-11: безопасно читает булев параметр "СкрытьСистемныйИИнструкцию".
// Если не передан (UI-03) или передан не-Булево — возвращает Ложь (поведение
// по умолчанию не меняется, D5).
//
// Возвращаемое значение:
//   Булево - значение параметра "СкрытьСистемныйИИнструкцию", если передан
//            и имеет тип Булево; иначе Ложь.
//
&НаСервере
Функция СкрытьСистемныйИИнструкциюПараметр()

	Значение = Ложь;
	Если Параметры.Свойство("СкрытьСистемныйИИнструкцию", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
