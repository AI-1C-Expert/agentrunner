// Заполняет список выбора поля "ПолеЛогическоеИмя" (ar_ЛогическоеИмя)
// известными логическими именами объектов метаданных - общий метод
// ar_ИнструментыДиспетчер.СписокИзвестныхЛогическихИмен() (единый источник списка,
// используемый также самими tool-модулями). Значение элемента списка и
// представление совпадают - логическое имя вводится как есть.
//
&НаСервере
Процедура ЗаполнитьСписокВыбораЛогическогоИмениНаСервере()

	СписокЛогическихИмен = Элементы.ПолеЛогическоеИмя.СписокВыбора;
	СписокЛогическихИмен.Очистить();

	Для Каждого ЛогическоеИмя Из ar_ИнструментыДиспетчер.СписокИзвестныхЛогическихИмен() Цикл
		СписокЛогическихИмен.Добавить(ЛогическоеИмя);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти