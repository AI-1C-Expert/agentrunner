// Регистр сведений ar_ПравилаМаскированияПДн - пользовательские правила полного
// сокрытия полей для LLM-контекста (PII-01). Проверяется геттером
// aosPersonalData.ЕстьПравилоПолногоСокрытия, применяется в
// ar_Утилиты.ОчиститьЗначениеПоля (PII-04). Результат проверки кэшируется на
// время серверного вызова модулем aosPersonalDataПовтИсп (PII-05) -
// ПередЗаписью ниже сбрасывает этот кэш как дополнительную подстраховку.
//
// PII-06: этот же обработчик фиксирует audit-событие "pii_rule_changed" в
// ar_СобытияЗапуска через ar_AuditСобытия.Зафиксировать - создание/включение/
// выключение/изменение способа маскирования/удаление правила является
// административной операцией, управляющей тем, какие поля попадают в
// LLM-контекст, и должно быть прослеживаемо в audit-логе наравне с ротацией
// секретов (SEC-06, "secret_rotated"). Payload события НЕ содержит значения
// защищаемого поля объекта (в этом регистре его в принципе нет - хранятся
// только метаданные правила) и намеренно не включает "Причина" (см. PII-06.md,
// раздел Payload) - чтобы не расширять поверхность утечки текстом произвольного
// описания администратора без явной необходимости.

Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// PII-06: удаление набора записей (замещение пустым набором через форму
	// списка) не порождает событий изменения правил - удаление отдельной
	// записи регистра сведений через управляемую форму штатно всегда идёт
	// заменой набора той же комбинации измерений на пустой набор с
	// Замещение = Истина. ОбщегоНазначения (БСП) не заимствован в это
	// расширение ради единственной проверки ЭтоУдалениеНабораЗаписей -
	// эквивалентная проверка выполнена вручную (см. риск в PII-06.md).
	ТекущийПользователь = Пользователи.ТекущийПользователь();

	ЭтоУдалениеНабора = Замещение И ЭтотОбъект.Количество() = 0;

	Если ЭтоУдалениеНабора Тогда
		ЗафиксироватьУдалениеПравила(ЭтотОбъект, Строка(ТекущийПользователь));
		Возврат;
	КонецЕсли;

	// PII-09: поддерживается только способ «Полностью скрыть» — правила с иным
	// (или незаполненным) способом кодом не применяются (запрос в
	// aosPersonalData.ЕстьПравилоПолногоСокрытияЗапрос фильтрует строго по
	// ПолностьюСкрыть), поэтому их запись отклоняется, а не сохраняется молча
	// неработающей. «Частично»/«ПоШаблону» остаются в перечислении как
	// зарезервированные. Проверка на уровне набора записей работает и для
	// программной записи, не только для формы.
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.СпособМаскирования
			<> Перечисления.ar_СпособМаскированияПДн.ПолностьюСкрыть Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				НСтр("ru='Способ маскирования ""%1"" пока не реализован. Доступен только способ ""Полностью скрыть"".';
				|en='Masking method ""%1"" is not implemented yet. Only ""Полностью скрыть"" (hide completely) is available.'"),
				Строка(Запись.СпособМаскирования));
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ДатаСеанса = ТекущаяДатаСеанса();

	// PII-06: changed_by для audit-события формируется из того же
	// ТекущийПользователь, что и реквизит Автор регистра (Пользователи.
	// ТекущийПользователь()), а не из ПараметрыСеанса.ТекущийПользователь -
	// это гарантирует согласованность "кто изменил правило" между самим
	// регистром и audit-логом в рамках одной и той же записи (устраняет
	// риск расхождения при программных вызовах, где сеансовый пользователь
	// может отличаться от пользователя-инициатора действия).
	СтрокаТекущегоПользователя = Строка(ТекущийПользователь);

	Для Каждого Запись Из ЭтотОбъект Цикл
		// Автор всегда актуализируется на пользователя, вносящего правку
		// (аналогично Автор в форме "кто добавил/изменил правило").
		Запись.Автор = ТекущийПользователь;

		// Создано заполняется только один раз - при первой записи; при
		// последующих правках существующей записи не перезаписывается.
		Если Не ЗначениеЗаполнено(Запись.Создано) Тогда
			Запись.Создано = ДатаСеанса;
		КонецЕсли;

		ЗафиксироватьИзменениеПравила(Запись, СтрокаТекущегоПользователя);
	КонецЦикла;

	// PII-05: кэш aosPersonalDataПовтИсп живёт "на время вызова" и сам по себе
	// автоматически исчезает на границе серверного вызова - следующий отдельный
	// вызов read_object/query всегда увидит актуальные правила без этого сброса.
	// Явный ОбновитьПовторноИспользуемыеЗначения() здесь - подстраховка на редкий
	// edge case, когда запись правила и последующее чтение данных происходят в
	// рамках ОДНОГО серверного вызова (например, программное создание правила из
	// HTTP-сервиса администрирования с немедленным read_object в том же
	// обработчике). Сбрасывает весь кэш ПовтИсп текущего сеанса (в т.ч. ar_Константы) -
	// безопасно, эти кэши лишь один раз пересчитаются заново при следующем обращении.
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// PII-06: прочитать "старое" (до текущей транзакции записи) состояние
// правила по измерениям Объект/ИмяПоля, определить action и зафиксировать
// audit-событие "pii_rule_changed" для одной изменённой/созданной записи.
//
// Fail-open: если чтение старого состояния завершилось ошибкой (например,
// лок-тайм-аут), событие всё равно фиксируется с action = "updated" по
// умолчанию - неточная классификация лучше полного отсутствия audit-записи
// об изменении правила (см. PII-06.md, "Граничные случаи").
//
// Параметры:
//  Запись                     - РегистрСведенийЗапись.ar_ПравилаМаскированияПДн - новая
//                                (ещё не записанная в СУБД) запись набора из ЭтотОбъект.
//  СтрокаТекущегоПользователя - Строка - строковое представление пользователя,
//                                вносящего правку (согласовано с реквизитом Автор,
//                                см. вызывающий код в ПередЗаписью).
//
Процедура ЗафиксироватьИзменениеПравила(Знач Запись, Знач СтрокаТекущегоПользователя)

	СтароеСостояние = ПрочитатьСтароеСостояние(Запись.Объект, Запись.ИмяПоля);

	Если СтароеСостояние = Неопределено Тогда
		// Записи не было в БД до этой транзакции - новое правило.
		ДействиеСобытия = "created";
	Иначе
		Если СтароеСостояние.Ошибка Тогда
			// Fail-open: не удалось определить старое состояние - фиксируем
			// событие всё равно, с action по умолчанию.
			ДействиеСобытия = "updated";
		ИначеЕсли Не СтароеСостояние.Включён И Запись.Включён Тогда
			ДействиеСобытия = "enabled";
		ИначеЕсли СтароеСостояние.Включён И Не Запись.Включён Тогда
			ДействиеСобытия = "disabled";
		ИначеЕсли СтароеСостояние.СпособМаскирования <> Запись.СпособМаскирования Тогда
			ДействиеСобытия = "updated";
		Иначе
			// Включён и СпособМаскирования не изменились (пересохранение формы
			// без реальных правок или правка только поля Причина, которое не
			// триггерит событие) - событие не пишется, чтобы не плодить шум
			// в audit-логе (см. PII-06.md, таблица классификации action).
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("action", ДействиеСобытия);
	ДанныеСобытия.Вставить("object", Запись.Объект);
	ДанныеСобытия.Вставить("field_name", Запись.ИмяПоля);
	ДанныеСобытия.Вставить("masking_method", Строка(Запись.СпособМаскирования));
	ДанныеСобытия.Вставить("enabled", Запись.Включён);
	ДанныеСобытия.Вставить("changed_by", СтрокаТекущегоПользователя);

	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", Перечисления.ar_ТипСобытия.PiiRuleChanged, ДанныеСобытия);

КонецПроцедуры

// PII-06: зафиксировать audit-событие "pii_rule_changed" (action = "removed")
// для каждого правила, удалённого целиком через замещение набора записей
// пустым набором (Замещение = Истина, ЭтотОбъект.Количество() = 0).
//
// Параметры:
//  НаборЗаписей               - РегистрСведенийНаборЗаписей.ar_ПравилаМаскированияПДн - пустой
//                                набор с установленным отбором Объект/ИмяПоля (Отбор задаёт
//                                форма списка при удалении строки).
//  СтрокаТекущегоПользователя - Строка - строковое представление пользователя,
//                                выполняющего удаление.
//
Процедура ЗафиксироватьУдалениеПравила(Знач НаборЗаписей, Знач СтрокаТекущегоПользователя)

	ОбъектОтбора = НаборЗаписей.Отбор.Объект.Значение;
	ИмяПоляОтбора = НаборЗаписей.Отбор.ИмяПоля.Значение;

	Если Не ЗначениеЗаполнено(ОбъектОтбора) Или Не ЗначениеЗаполнено(ИмяПоляОтбора) Тогда
		// Отбор не задаёт обе части ключа (Объект+ИмяПоля) конкретного правила
		// (например программное замещение пустым набором без отбора по
		// измерениям, либо только по одному из измерений) - нельзя однозначно
		// идентифицировать удаляемое правило, нечего логировать.
		Возврат;
	КонецЕсли;

	СтароеСостояние = ПрочитатьСтароеСостояние(ОбъектОтбора, ИмяПоляОтбора);
	Если СтароеСостояние = Неопределено Тогда
		// Записи и так не было в БД - удалять нечего.
		Возврат;
	КонецЕсли;

	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("action", "removed");
	ДанныеСобытия.Вставить("object", ОбъектОтбора);
	ДанныеСобытия.Вставить("field_name", ИмяПоляОтбора);
	Если СтароеСостояние.Ошибка Тогда
		ДанныеСобытия.Вставить("masking_method", "");
		ДанныеСобытия.Вставить("enabled", Ложь);
	Иначе
		ДанныеСобытия.Вставить("masking_method", Строка(СтароеСостояние.СпособМаскирования));
		ДанныеСобытия.Вставить("enabled", СтароеСостояние.Включён);
	КонецЕсли;
	ДанныеСобытия.Вставить("changed_by", СтрокаТекущегоПользователя);

	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", Перечисления.ar_ТипСобытия.PiiRuleChanged, ДанныеСобытия);

КонецПроцедуры

// PII-06: прочитать текущее (до применения изменений в этой транзакции)
// состояние записи регистра по измерениям Объект/ИмяПоля через отдельный
// менеджер записи. Кэширование не требуется - правила меняются редко
// (административная операция), в отличие от геттера чтения правил
// (aosPersonalData/PII-05), обслуживающего каждый tool-вызов агента.
//
// Параметры:
//  Объект  - Строка - значение измерения "Объект".
//  ИмяПоля - Строка - значение измерения "ИмяПоля".
//
// Возвращаемое значение:
//  Структура - со свойствами Включён (Булево), СпособМаскирования
//              (ПеречислениеСсылка.ar_СпособМаскированияПДн), Ошибка (Булево,
//              Истина при сбое чтения - fail-open, см. ЗафиксироватьИзменениеПравила);
//  Неопределено - если записи с такими измерениями в БД до этой транзакции нет.
//
Функция ПрочитатьСтароеСостояние(Знач Объект, Знач ИмяПоля)

	Попытка
		МенеджерЗаписи = РегистрыСведений.ar_ПравилаМаскированияПДн.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = Объект;
		МенеджерЗаписи.ИмяПоля = ИмяПоля;
		МенеджерЗаписи.Прочитать();

		Если Не МенеджерЗаписи.Выбран() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Результат = Новый Структура;
		Результат.Вставить("Включён", МенеджерЗаписи.Включён);
		Результат.Вставить("СпособМаскирования", МенеджерЗаписи.СпособМаскирования);
		Результат.Вставить("Ошибка", Ложь);
		Возврат Результат;

	Исключение
		// Fail-open (см. PII-06.md, "Граничные случаи"): не удалось прочитать
		// старое состояние - вызывающий код зафиксирует событие с action по
		// умолчанию, не прерывая сохранение правила. Причина ошибки не
		// теряется - фиксируется в журнале регистрации для последующего
		// разбора (аналогично ЗаписатьВЖурнал в ar_AuditСобытия).
		ШаблонОшибкиЧтения = НСтр("ru = 'Не удалось прочитать старое состояние правила маскирования
			|(Объект=%1, ИмяПоля=%2): %3';
			|en = 'Failed to read previous PII masking rule state
			|(Объект=%1, ИмяПоля=%2): %3'");
		ПредставлениеОшибкиЧтения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСобытияЖурнала = НСтр("ru = 'ar_ПравилаМаскированияПДн.ПрочитатьСтароеСостояние';
			|en = 'ar_ПравилаМаскированияПДн.ПрочитатьСтароеСостояние'");
		ЗаписьЖурналаРегистрации(
			ТекстСобытияЖурнала,
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегистрыСведений.ar_ПравилаМаскированияПДн,
			,
			СтрШаблон(ШаблонОшибкиЧтения, Объект, ИмяПоля, ПредставлениеОшибкиЧтения));

		Результат = Новый Структура;
		Результат.Вставить("Включён", Ложь);
		Результат.Вставить("СпособМаскирования", Неопределено);
		Результат.Вставить("Ошибка", Истина);
		Возврат Результат;
	КонецПопытки;

КонецФункции
