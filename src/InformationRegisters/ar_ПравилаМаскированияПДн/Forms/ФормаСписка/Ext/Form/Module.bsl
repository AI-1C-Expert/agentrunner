// Форма списка регистра сведений ar_ПравилаМаскированияПДн (PII-01).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// PII-10: правила действуют только при включённом compliance-режиме
	// (ar_Константы.ComplianceРежим, константа ar_ComplianceРежим) — если он
	// выключен, честно предупреждаем, что настройка сейчас ни на что не влияет.
	Элементы.ПредупреждениеРежим.Видимость = Не ar_Константы.ComplianceРежим();

	НастроитьОформлениеНеподдерживаемыхСпособов();

КонецПроцедуры

// PII-09: правила со способом, отличным от «Полностью скрыть», кодом не
// применяются (aosPersonalData.ЕстьПравилоПолногоСокрытияЗапрос фильтрует
// строго по ПолностьюСкрыть) — существующие такие записи выделяем серым,
// чтобы было видно, что они неактивны. Новые записи с такими способами
// отклоняются в ПередЗаписью (RecordSetModule.bsl).
&НаСервере
Процедура НастроитьОформлениеНеподдерживаемыхСпособов()

	Элемент = УсловноеОформление.Элементы.Добавить();

	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.СпособМаскирования");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	Отбор.ПравоеЗначение = Перечисления.ar_СпособМаскированияПДн.ПолностьюСкрыть;
	Отбор.Использование = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);

	ИменаКолонок = СтрРазделить("Объект,ИмяПоля,Включён,СпособМаскирования,Причина,Автор,Создано", ",");
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
		Поле.Использование = Истина;
	КонецЦикла;

КонецПроцедуры
