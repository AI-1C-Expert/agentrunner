// Форма записи регистра сведений ar_ПравилаМаскированияПДн (PII-01).
// Автозаполнение Автор/Создано выполняется на уровне RecordSetModule.bsl
// (событие ПередЗаписью набора записей) - работает независимо от способа
// записи (форма или программно), поэтому дублирующая логика в форме не нужна.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// PII-09: из перечисления ar_СпособМаскированияПДн реализован только
	// «Полностью скрыть» (см. aosPersonalData.ЕстьПравилоПолногоСокрытияЗапрос);
	// «Частично» и «По шаблону» зарезервированы и в форме не предлагаются,
	// чтобы пользователь не создал молча неработающее правило. Контроль на
	// уровне данных - в ПередЗаписью набора записей (RecordSetModule.bsl).
	ЭлементСпособ = Элементы.СпособМаскирования;
	ЭлементСпособ.РежимВыбораИзСписка = Истина;
	ЭлементСпособ.СписокВыбора.Очистить();
	ЭлементСпособ.СписокВыбора.Добавить(Перечисления.ar_СпособМаскированияПДн.ПолностьюСкрыть);

	// Новая запись: подставляем единственный поддерживаемый способ по умолчанию.
	Если Не ЗначениеЗаполнено(Запись.СпособМаскирования) Тогда
		Запись.СпособМаскирования = Перечисления.ar_СпособМаскированияПДн.ПолностьюСкрыть;
	КонецЕсли;

КонецПроцедуры
