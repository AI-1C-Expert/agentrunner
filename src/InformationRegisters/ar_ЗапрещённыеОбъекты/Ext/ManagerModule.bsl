// Модуль менеджера регистра сведений ar_ЗапрещённыеОбъекты
// Deny-list объектов базы данных, недоступных для изменения агентом.
// Проверяется L3.5 Guard в ar_PermissionEngine (задача PERM-05).

#Область ПрограммныйИнтерфейс

// Записывает начальную запись самозащиты реестра запрещённых объектов.
// Идемпотентна: повторный вызов не создает дублей.
// Вызывается из ar_ToolDispatcher.ЗарегистрироватьВсеTools() (TOOL-17)
// или вручную при первом развертывании расширения.
//
// Формат ТипОбъекта: полное имя метаданных, например "Справочник.Контрагенты".
// Значение "*" означает "все типы".
//
// Пример:
//   РегистрыСведений.ar_ЗапрещённыеОбъекты.ЗаполнитьНачальноеЗаполнение();
//
Процедура ЗаполнитьНачальноеЗаполнение() Экспорт

	ЗащищенныйТипОбъекта = "РегистрСведений.ar_ЗапрещённыеОбъекты";
	РежимЗапретаЗначение = Перечисления.ar_РежимЗапретаЗаписи.Любое;

	// Привилегированный режим обязателен: запись выполняется от имени
	// сервисного кода без прав пользователя агента (std485).
	// Сохраняем исходное состояние для гарантированного восстановления.
	ИсходноеСостояниеПривРежима = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗаписатьЗащитнуюЗапись(ЗащищенныйТипОбъекта, РежимЗапретаЗначение);
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходноеСостояниеПривРежима);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает защитную запись в регистр в транзакции с блокировкой.
// Параметры:
//   ТипОбъекта    - Строка - полное имя метаданных защищаемого объекта.
//                    Формат: "КлассМетаданных.ИмяОбъекта", напр. "Справочник.Контрагенты".
//   РежимЗапрета  - ПеречислениеСсылка.ar_РежимЗапретаЗаписи - режим блокировки.
//
Процедура ЗаписатьЗащитнуюЗапись(ТипОбъекта, РежимЗапрета)

	НачатьТранзакцию();
	Попытка

		// Ответственное чтение: блокируем конкретную запись перед чтением (std648).
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_ЗапрещённыеОбъекты");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ТипОбъекта", ТипОбъекта);
		ЭлементБлокировки.УстановитьЗначение("РежимЗапрета", РежимЗапрета);
		Блокировка.Заблокировать();

		// Проверка идемпотентности через запрос
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	1 КАК Признак
			|ИЗ
			|	РегистрСведений.ar_ЗапрещённыеОбъекты КАК ЗапрещённыеОбъекты
			|ГДЕ
			|	ЗапрещённыеОбъекты.ТипОбъекта = &ТипОбъекта
			|	И ЗапрещённыеОбъекты.РежимЗапрета = &РежимЗапрета";
		Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
		Запрос.УстановитьПараметр("РежимЗапрета", РежимЗапрета);

		Если Запрос.Выполнить().Пустой() Тогда
			// Запись не найдена - создаём новую через менеджер записи
			МенеджерЗаписи = РегистрыСведений.ar_ЗапрещённыеОбъекты.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ТипОбъекта   = ТипОбъекта;
			МенеджерЗаписи.РежимЗапрета = РежимЗапрета;
			МенеджерЗаписи.Включен  = Истина;
			МенеджерЗаписи.Причина  = НСтр(
				"ru = 'Системный объект AgentRunner: изменение агентами запрещено';
				|en = 'AgentRunner system object: modification by agents is prohibited'");
			МенеджерЗаписи.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
