#Область ОбработчикиСобытий

// SEC-TOOL-01/D4: единственная точка аудита политики диспетчеризации code-тулов.
//
// Обработчик перехватывает ЛЮБУЮ запись константы, включая переключение мимо
// формы ar_Настройки - из консоли администратора, конфигуратора или стороннего
// кода. Именно этот сценарий (обход UI) и есть та угроза, ради которой вводится
// ограничение режима «Код»: без обработчика включение code-тулов не оставляет
// следа. Аудит в форме ar_Настройки намеренно НЕ дублируется - запись значения
// из формы идёт через этот же менеджер значения.
//
// Событие пишется только при фактической смене значения: повторная запись того
// же значения (Установить(Ложь) при уже выключенной политике) событием
// безопасности не является и аудит не засоряет.
//
// Обработчик вызывается после начала транзакции записи, но до самой записи
// [Платформа: КонстантаМенеджерЗначения.<Имя>.ПередЗаписью]. Поэтому при отказе
// от записи (исключение ниже по стеку, Отказ = Истина) транзакция откатится
// вместе с audit-записью - зафиксированным окажется только реально применённое
// изменение.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи (не устанавливается: аудит не
//          является основанием запретить администратору менять политику).
//
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СтароеЗначение = Константы.ar_РазрешитьТулыВРежимеКод.Получить();
	Если СтароеЗначение = Значение Тогда
		Возврат;
	КонецЕсли;

	ЗафиксироватьИзменениеПолитики(СтароеЗначение, Значение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пишет событие безопасности ToolCodePolicyChanged - в отличие от
// ToolCodeChanged (правка кода конкретного tool), изменение политики
// затрагивает диспетчеризацию всех code-тулов сразу.
//
// Сбой аудита не должен мешать администратору переключить политику, поэтому
// исключение подавляется и уходит в служебный лог.
//
// Параметры:
//  СтароеЗначение - Булево - значение константы до записи.
//  НовоеЗначение  - Булево - записываемое значение.
//
Процедура ЗафиксироватьИзменениеПолитики(Знач СтароеЗначение, Знач НовоеЗначение)

	Попытка
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("old_value", СтароеЗначение);
		ДанныеСобытия.Вставить("new_value", НовоеЗначение);
		ДанныеСобытия.Вставить("actor", Строка(Пользователи.ТекущийПользователь()));

		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(
			"", Перечисления.ar_ТипСобытия.ToolCodePolicyChanged, ДанныеСобытия);

		ar_СлужебныйЛог.Записать("ar_РазрешитьТулыВРежимеКод", "policy_changed",
			СтрШаблон("Политика режима «Код»: %1 -> %2", СтароеЗначение, НовоеЗначение));
	Исключение
		ar_СлужебныйЛог.Записать("ar_РазрешитьТулыВРежимеКод", "policy_audit_error",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
