////////////////////////////////////////////////////////////////////////////////
// Форма обработки ar_ТестЦикла (RT-01, этап 0).
//
// Связывает ar_RuntimeЦиклПрото с UI: пользователь задаёт промпт и выбирает
// провайдера, по нажатию «Запустить цикл» сервер вызывает прото-цикл и
// записывает запуск в регистр ar_Запуски через ar_AuditЗапуски.
//
// На этапе 0 цикл выполняется синхронно (в спеке допускается). При переходе
// к этапу 1 (RT-02) запуск будет в фоне через ДлительныеОперации.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если МаксШагов = 0 Тогда
		МаксШагов = 5;
	КонецЕсли;
	ОбновитьДоступностьКомандыНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗапросПользователяПриИзменении(Элемент)
	ОбновитьДоступностьКоманды();
КонецПроцедуры

&НаКлиенте
Процедура ПровайдерСсылкаПриИзменении(Элемент)
	ОбновитьДоступностьКоманды();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьЦикл(Команда)

	Если ПустаяСтрока(ЗапросПользователя) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите запрос для агента'; en = 'Enter the prompt'"));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПровайдерСсылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите LLM-провайдера'; en = 'Select LLM provider'"));
		Возврат;
	КонецЕсли;

	РезультатЦикла = НСтр("ru = 'Выполняется...'; en = 'Running...'");
	ЖурналРаботы = "";

	ЗапуститьЦиклНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗапуститьЦиклНаСервере()

	RunId = Строка(Новый УникальныйИдентификатор);

	// 1. Стартовая запись аудита.
	Попытка
		ДанныеСтарт = Новый Структура;
		ДанныеСтарт.Вставить("Статус", "running");
		ar_AuditЗащищённыйРежим.СоздатьЗапускПривилегированно(RunId, ДанныеСтарт);
	Исключение
		// Не блокируем цикл, если аудит недоступен — фиксируем в журнале.
		ЖурналРаботы = НСтр("ru = 'Предупреждение: не удалось записать стартовый аудит: '; en = 'Warning: audit start failed: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// 2. Выполнение цикла.
	ИтогЦикла = ar_RuntimeЦиклПрото.ВыполнитьЦикл(
		RunId, ПровайдерСсылка, ЗапросПользователя, МаксШагов);

	// 3. Завершающая запись аудита.
	СтатусИтог = "failed";
	ИтогЦикла.Свойство("Статус", СтатусИтог);
	ТекстОтветаLLM = "";
	ИтогЦикла.Свойство("ОтветLLM", ТекстОтветаLLM);

	Попытка
		ДанныеФиниш = Новый Структура;
		ДанныеФиниш.Вставить("Статус", СтатусИтог);
		ДанныеФиниш.Вставить("ОтветLLM", ТекстОтветаLLM);
		ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunId, "Завершить", ДанныеФиниш);
	Исключение
		ЖурналРаботы = ?(ПустаяСтрока(ЖурналРаботы), "", ЖурналРаботы + Символы.ПС)
			+ НСтр("ru = 'Предупреждение: не удалось записать финальный аудит: '; en = 'Warning: audit finish failed: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// 4. Вывод в форму.
	РезультатЦикла = НСтр("ru = '[RunId: '; en = '[RunId: '") + RunId + "] "
		+ НСтр("ru = 'Статус: '; en = 'Status: '") + СтатусИтог + Символы.ПС
		+ ИтогЦикла.Результат;

	ТекстЖурнала = "";
	ИтогЦикла.Свойство("ЖурналТекст", ТекстЖурнала);
	Если НЕ ПустаяСтрока(ТекстЖурнала) Тогда
		ЖурналРаботы = ?(ПустаяСтрока(ЖурналРаботы), ТекстЖурнала, ЖурналРаботы + Символы.ПС + ТекстЖурнала);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьКоманды()
	Элементы.ЗапуститьЦикл.Доступность = (НЕ ПустаяСтрока(ЗапросПользователя))
		И ЗначениеЗаполнено(ПровайдерСсылка);
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКомандыНаСервере()
	Элементы.ЗапуститьЦикл.Доступность = (НЕ ПустаяСтрока(ЗапросПользователя))
		И ЗначениеЗаполнено(ПровайдерСсылка);
КонецПроцедуры

#КонецОбласти
