////////////////////////////////////////////////////////////////////////////////
// Обработка ar_ТестТулов (Tool Test Harness).
//
// Диагностическая обработка: перебирает все включённые tools из справочника
// ar_Tools, для каждого генерирует пример аргументов из JSON-схемы манифеста
// (ar_JSONManifest → function.parameters), вызывает tool ИСКЛЮЧИТЕЛЬНО через
// центральный диспетчер ar_ToolDispatcher.Вызвать (тот же путь, что и Runtime-
// цикл) и распознаёт ошибочные observation ({"error":...}).
//
// Цель — быстро проверить, что каждый tool доступен и корректно отрабатывает,
// и собрать список упавших tools для последующего исправления.
//
// Режим вызова: боевой (DryRun = Ложь). Permission-слой (ar_PermissionEngine)
// обходится намеренно — тестируются сами реализации tools, а не разрешения
// агента. Контекст запуска строится с пустым RunId, поэтому запись действия в
// аудит (ar_ДействияАгента) пропускается (см. ar_ToolDispatcher.ЗаписатьДействиеЖурнал),
// а idempotency_key для commit-tools получает случайный UUID (не сталкивается
// с реальными запусками).
//
// Свойства модуля объекта: серверные вызовы; привилегированный режим НЕ
// поднимается — tools исполняются в правах пользователя сессии (как в бою).
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

// Кэш разведки базы (РазведатьБазу) на время жизни объекта обработки.
Перем РазведкаКэш;

// Кэш RunId тестового запуска (ОбеспечитьТестовыйЗапуск) — commit-tools требуют
// непустой RunId (APPR-01), создаём легитимную запись ar_Запуски один раз.
Перем ТестовыйRunIdКэш;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Диагностика разыменования навигационной ссылки (SESS-Debug).
//
// На первом доступном справочнике проверяет все пути «ссылка → строка → ссылка»
// и возвращает текстовый отчёт: какой формат round-trip рабочий, а какой нет.
// Цель — точно локализовать баг ar_Утилиты.ОбъектИзНавигационнойСсылки
// (object_not_found на валидной навигационной ссылке).
//
// Возвращаемое значение:
//  Строка - многострочный диагностический отчёт.
//
Функция ДиагностикаНавигационнойСсылки() Экспорт

	Строки = Новый Массив;
	СправочникРеф = ПервыйДоступныйСправочник();
	Если СправочникРеф = Неопределено Тогда
		Возврат НСтр("ru = 'Нет ни одного справочника с данными для диагностики.';
			|en = 'No catalog with data to diagnose.'");
	КонецЕсли;

	Ссылка = СправочникРеф.Ссылка;
	Строки.Добавить("Тип: " + СправочникРеф.ИмяТипаОбъекта);
	Строки.Добавить("UUID (строковый): " + СправочникРеф.UUID);

	// 1. Навигационная ссылка от платформы.
	НавСсылка = ПолучитьНавигационнуюСсылку(Ссылка);
	Строки.Добавить("НавСсылка: " + НавСсылка);

	// 2. XML-GUID (плоский, 32 симв.) из ?ref=.
	ПозицияRef = СтрНайти(НавСсылка, "?ref=");
	XMLGuid = ?(ПозицияRef > 0, Сред(НавСсылка, ПозицияRef + 5), "");
	Строки.Добавить("XML-GUID (?ref=): " + XMLGuid);

	// 3. Round-trip A: через ar_Утилиты.ОбъектИзНавигационнойСсылки (текущий код).
	Строки.Добавить(ПроверитьRoundTrip("A. ar_Утилиты.ОбъектИзНавигационнойСсылки", Ссылка,
		Новый Структура("Режим, Аргумент", "утилита", НавСсылка)));

	// 4. Round-trip B: XMLЗначение(Тип, XML-GUID) напрямую (как в утилите, стр.291).
	Строки.Добавить(ПроверитьRoundTrip("B. XMLЗначение(Тип, XML-GUID)", Ссылка,
		Новый Структура("Режим, Аргумент", "xml_flat", XMLGuid)));

	// 5. Round-trip C: XMLЗначение(Тип, строковый UUID с дефисами).
	Строки.Добавить(ПроверитьRoundTrip("C. XMLЗначение(Тип, UUID с дефисами)", Ссылка,
		Новый Структура("Режим, Аргумент", "xml_uuid", СправочникРеф.UUID)));

	// 6. Round-trip D: Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(UUID)).
	Строки.Добавить(ПроверитьRoundTrip("D. Менеджер.ПолучитьСсылку(UUID)", Ссылка,
		Новый Структура("Режим, Аргумент", "менеджер", СправочникРеф.UUID),
		СправочникРеф.ИмяТипаОбъекта));

	// 7. Разведка базы: что выбрано под профильные кейсы (маппинг, счёт, контрагент,
	//    отчёт) + реальный текст исключения при чтении счёта (диагностика access_denied).
	Строки.Добавить("");
	Строки.Добавить("=== РАЗВЕДКА БАЗЫ ===");
	Разведка = РазведатьБазу();
	// Профиль конфигурации (UNIV-01) и доступность tools (UNIV-03).
	Конфигурация = ar_ПрофильКонфигурации.ОпределитьКонфигурацию();
	Строки.Добавить(СтрШаблон("Конфигурация: %1 (тип %2, версия %3)",
		Конфигурация.Имя, Конфигурация.Тип, Конфигурация.Версия));
	Строки.Добавить("Недоступные tools (ar_Доступен = Ложь):");
	Строки.Добавить(СписокНедоступныхTools());
	Строки.Добавить("Контрагенты (маппинг): "
		+ ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты"));
	Строки.Добавить("СчетНаОплатуПокупателю (маппинг): "
		+ ar_ToolDispatcher.ИмяОбъектаМетаданных("СчетНаОплатуПокупателю", "СчетНаОплатуПокупателю"));
	Строки.Добавить("КонтрагентNavRef: " + Разведка.КонтрагентNavRef);
	Строки.Добавить("ДокументNavRef: " + Разведка.ДокументNavRef);
	Строки.Добавить("НомерСчёта: " + Разведка.НомерСчёта);
	Строки.Добавить("ИмяОтчёта (выбран): " + Разведка.ИмяОтчёта);
	Строки.Добавить("ОтслеживаемыйТип: " + Разведка.ОтслеживаемыйТип);
	Строки.Добавить(ДиагностикаЧтенияСчёта(Разведка.ДокументNavRef));
	Строки.Добавить(ДиагностикаОтчёта(Разведка.ИмяОтчёта));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Собрать все включённые (ar_Включён) и непомеченные tools из ar_Tools.
//
// Читает также поля доступности UNIV-03/UNIV-06 (ar_Доступен,
// ar_ПричинаНедоступности, ar_ТребуетАдаптер): недоступные tools скрыты от LLM
// фильтром манифеста, но в тестовой таблице показываются с причиной — чтобы
// было видно, ЧТО и ПОЧЕМУ отфильтровано (и можно было прогнать осознанно).
//
// Возвращаемое значение:
//  Массив из Структура - по одной на tool:
//    { Ссылка, Имя, Модуль, Процедура, RiskLevel, ТребуетApproval,
//      ТипРеализации, JSONManifest, Описание, Доступен, ПричинаНедоступности,
//      ТребуетАдаптер }.
//
Функция СобратьTools() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_Описание КАК Описание,
		|	Tools.ar_ОбщийМодуль КАК Модуль,
		|	Tools.ar_ИмяПроцедуры КАК Процедура,
		|	Tools.ar_RiskLevel КАК RiskLevel,
		|	Tools.ar_ТребуетApproval КАК ТребуетApproval,
		|	Tools.ar_ТипРеализации КАК ТипРеализации,
		|	Tools.ar_JSONManifest КАК JSONManifest,
		|	Tools.ar_Доступен КАК Доступен,
		|	Tools.ar_ПричинаНедоступности КАК ПричинаНедоступности,
		|	Tools.ar_ТребуетАдаптер КАК ТребуетАдаптер
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Включён
		|	И НЕ Tools.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Tools.ar_ОбщийМодуль,
		|	Tools.ar_Имя";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Ссылка",          Выборка.Ссылка);
		Элемент.Вставить("Имя",             СокрЛП(Выборка.Имя));
		Элемент.Вставить("Описание",        Выборка.Описание);
		Элемент.Вставить("Модуль",          СокрЛП(Выборка.Модуль));
		Элемент.Вставить("Процедура",       СокрЛП(Выборка.Процедура));
		Элемент.Вставить("RiskLevel",       Строка(Выборка.RiskLevel));
		Элемент.Вставить("ТребуетApproval", Выборка.ТребуетApproval = Истина);
		Элемент.Вставить("ТипРеализации",   СокрЛП(Выборка.ТипРеализации));
		Элемент.Вставить("JSONManifest",    Выборка.JSONManifest);
		Элемент.Вставить("Доступен",        Выборка.Доступен = Истина);
		Элемент.Вставить("ПричинаНедоступности", СокрЛП(Строка(Выборка.ПричинаНедоступности)));
		Элемент.Вставить("ТребуетАдаптер",  Выборка.ТребуетАдаптер = Истина);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подготовить среду перед прогоном (UNIV-01/UNIV-03): заполнить профиль
// конфигурации автоматически и пересчитать доступность всех tools. Вызывается
// формой перед загрузкой списка tools и после настройки маппинга (маппинг
// меняет разрешение логических имён — доступность может измениться).
//
// Возвращаемое значение:
//  Строка - сводка: конфигурация (Имя/Тип/Версия) и число недоступных tools.
//
Функция ПодготовитьСреду() Экспорт

	Конфигурация = ar_ПрофильКонфигурации.ОпределитьКонфигурацию();

	Попытка
		ar_ПрофильКонфигурации.ЗаполнитьАвтоматически();
	Исключение
		// Профиль не критичен для прогона — фиксируем и продолжаем.
		ar_СлужебныйЛог.Записать("ar_ТестТулов.ПодготовитьСреду", "profile_fill_error",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

	НедоступныхTools = 0;
	Попытка
		НедоступныхTools = ar_ToolDispatcher.ПересчитатьДоступностьВсехTools();
	Исключение
		НедоступныхTools = -1; // Пересчёт не удался — увидим в сводке.
		ar_СлужебныйЛог.Записать("ar_ТестТулов.ПодготовитьСреду", "availability_recalc_error",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

	Возврат СтрШаблон(
		НСтр("ru = 'Конфигурация: %1 (тип %2, версия %3). Недоступных tools: %4.';
		|en = 'Configuration: %1 (type %2, version %3). Unavailable tools: %4.'"),
		Конфигурация.Имя, Конфигурация.Тип, Конфигурация.Версия,
		?(НедоступныхTools < 0, "?", Строка(НедоступныхTools)));

КонецФункции

// Сгенерировать пример аргументов (строка JSON) из манифеста tool.
//
// Разбирает ar_JSONManifest, извлекает function.parameters (JSON Schema),
// и для каждого свойства подставляет правдоподобное значение по type / enum /
// default / minimum. Обязательные (required) свойства заполняются всегда,
// необязательные — только если БезОпциональных = Ложь.
//
// Параметры:
//  JSONManifest    - Строка - значение ar_JSONManifest tool.
//  ТолькоОбязательные - Булево - заполнять только required-поля (по умолчанию Истина).
//
// Возвращаемое значение:
//  Строка - JSON-объект аргументов (например "{""query"":""demo""}"). При
//           отсутствии/невалидности схемы возвращает "{}".
//
Функция СгенерироватьПримерАргументов(Знач JSONManifest, Знач ТолькоОбязательные = Истина) Экспорт

	Параметры = ИзвлечьСхемуПараметров(JSONManifest);
	Если Параметры = Неопределено Тогда
		Возврат "{}";
	КонецЕсли;

	Свойства = ЗначениеСоответствия(Параметры, "properties");
	Если ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		Возврат "{}";
	КонецЕсли;

	ОбязательныеИмена = МножествоОбязательных(Параметры);

	Аргументы = Новый Соответствие;
	Для Каждого КлючЗначение Из Свойства Цикл
		ИмяСвойства = КлючЗначение.Ключ;
		СхемаСвойства = КлючЗначение.Значение;

		Обязательное = ОбязательныеИмена.Получить(ИмяСвойства) <> Неопределено;
		Если ТолькоОбязательные И НЕ Обязательное Тогда
			Продолжить;
		КонецЕсли;

		Аргументы.Вставить(ИмяСвойства, ЗначениеПоСхеме(СхемаСвойства, ИмяСвойства));
	КонецЦикла;

	Результат = ar_JSON.ВЗначениеJSON(Аргументы);
	Возврат ?(ПустаяСтрока(Результат), "{}", Результат);

КонецФункции

// Профильный вход для конкретного tool по его ИМЕНИ (а не только по схеме).
//
// Разные tools требуют разных типов объектов: CRM — контрагента, document-tools
// — документ, run_report — отчёт, get_print_form — печатаемый объект. Универсальная
// генерация по схеме этого не учитывает (подставляет любой справочник), из-за чего
// tool уходит в ошибку не по своей вине. Здесь подбирается корректный профильный
// вход из разведанных данных базы (РазведатьБазу).
//
// Параметры:
//  ИмяTool - Строка - имя tool (ar_Имя).
//
// Возвращаемое значение:
//  Строка (готовый JSON аргументов) либо Неопределено, если профиль не задан —
//  тогда вызывающий код использует генерацию по схеме.
//
// Единая точка выбора аргументов для tool: сначала профильный вход по имени
// (реальные документ/отчёт/контрагент из базы), при его отсутствии — умная
// генерация по JSON-схеме манифеста. Используется формой при заполнении таблицы.
//
// Параметры:
//  ИмяTool      - Строка - имя tool (ar_Имя).
//  JSONManifest - Строка - манифест tool.
//
// Возвращаемое значение:
//  Строка - JSON аргументов.
//
Функция АргументыДляTool(Знач ИмяTool, Знач JSONManifest) Экспорт
	Профиль = ПрофильныйВходДляTool(ИмяTool);
	Если Профиль <> Неопределено Тогда
		Возврат Профиль;
	КонецЕсли;
	Возврат СгенерироватьУмныеАргументы(JSONManifest);
КонецФункции

Функция ПрофильныйВходДляTool(Знач ИмяTool) Экспорт

	Разведка = РазведатьБазу();
	Имя = НРег(СокрЛП(ИмяTool));

	// PKG-09: 10 предметных tools вынесены в пакет "AgentRunner Бухгалтерия"
	// и получили namespace-префикс buh_ (buh_search_clients и т.д.). Профили
	// ниже заведены по исходным именам - снимаем префикс один раз здесь,
	// чтобы обработка одинаково подбирала аргументы и для ядровых tools, и
	// для их пакетных двойников (см. .docs/specs/PKG-09.md).
	Если СтрНачинаетсяС(Имя, "buh_") Тогда
		Имя = Сред(Имя, СтрДлина("buh_") + 1);
	КонецЕсли;

	Если Имя = "search_clients" Тогда
		Возврат ?(ПустаяСтрока(Разведка.ФрагментКонтрагента), Неопределено,
			ar_JSON.ВЗначениеJSON(Новый Структура("query", Разведка.ФрагментКонтрагента)));

	ИначеЕсли Имя = "update_client_contact" Тогда
		Если ПустаяСтрока(Разведка.КонтрагентNavRef) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("client_ref", Разведка.КонтрагентNavRef);
		Стр.Вставить("email", "test@example.com");
		Возврат ar_JSON.ВЗначениеJSON(Стр);

	ИначеЕсли Имя = "create_invoice_draft" Тогда
		// client_ref — КОНТРАГЕНТ (через маппинг «Контрагенты»); items требует
		// минимум одну позицию (quantity>0, price>=0), номенклатура опциональна.
		Если ПустаяСтрока(Разведка.КонтрагентNavRef) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Позиция = Новый Структура;
		Позиция.Вставить("quantity", 1);
		Позиция.Вставить("price", 100);
		Если НЕ ПустаяСтрока(Разведка.НоменклатураNavRef) Тогда
			Позиция.Вставить("nomenclature_ref", Разведка.НоменклатураNavRef);
		КонецЕсли;
		Позиции = Новый Массив;
		Позиции.Добавить(Позиция);
		Стр = Новый Структура;
		Стр.Вставить("client_ref", Разведка.КонтрагентNavRef);
		Стр.Вставить("items", Позиции);
		Возврат ar_JSON.ВЗначениеJSON(Стр);

	ИначеЕсли Имя = "validate_document" Тогда
		Возврат ?(ПустаяСтрока(Разведка.ДокументNavRef), Неопределено,
			ar_JSON.ВЗначениеJSON(Новый Структура("document_ref", Разведка.ДокументNavRef)));

	ИначеЕсли Имя = "get_invoice" Тогда
		// get_invoice ждёт invoice_ref или invoice_number (не "number"!).
		Возврат ?(ПустаяСтрока(Разведка.НомерСчёта), Неопределено,
			ar_JSON.ВЗначениеJSON(Новый Структура("invoice_number", Разведка.НомерСчёта)));

	ИначеЕсли Имя = "get_print_form" Тогда
		НавРеф = ?(НЕ ПустаяСтрока(Разведка.ДокументNavRef), Разведка.ДокументNavRef, Разведка.СправочникNavRef);
		Возврат ?(ПустаяСтрока(НавРеф), Неопределено,
			ar_JSON.ВЗначениеJSON(Новый Структура("ref", НавРеф)));

	ИначеЕсли Имя = "run_report" Тогда
		Возврат ?(ПустаяСтрока(Разведка.ИмяОтчёта), Неопределено,
			ar_JSON.ВЗначениеJSON(Новый Структура("report_name", Разведка.ИмяОтчёта)));

	ИначеЕсли Имя = "save_object" Тогда
		Если ПустаяСтрока(Разведка.СправочникТип) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Поля = Новый Структура("Наименование", "AR_ТестСоздания");
		Возврат ar_JSON.ВЗначениеJSON(Новый Структура("object_type, fields", Разведка.СправочникТип, Поля));

	ИначеЕсли Имя = "get_object_history" И НЕ ПустаяСтрока(Разведка.ВерсионируемыйUUID) Тогда
		Стр = Новый Структура;
		Стр.Вставить("ref", Разведка.ВерсионируемыйUUID);
		Стр.Вставить("object_type", Разведка.ВерсионируемыйТип);
		Возврат ar_JSON.ВЗначениеJSON(Стр);

	ИначеЕсли Имя = "get_recent_changes" И НЕ ПустаяСтрока(Разведка.ОтслеживаемыйТип) Тогда
		Возврат ar_JSON.ВЗначениеJSON(Новый Структура("object_type", Разведка.ОтслеживаемыйТип));

	// aggregate (UNIV-07): source = реальный справочник, один агрегат COUNT по
	// стандартному полю Ссылка (гарантированно в whitelist любого источника).
	ИначеЕсли Имя = "aggregate" Тогда
		Если ПустаяСтрока(Разведка.СправочникТип) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Агрегат = Новый Структура;
		Агрегат.Вставить("func", "COUNT");
		Агрегат.Вставить("field", "Ссылка");
		Агрегат.Вставить("as", "total");
		Агрегаты = Новый Массив;
		Агрегаты.Добавить(Агрегат);
		Стр = Новый Структура;
		Стр.Вставить("source", Разведка.СправочникТип);
		Стр.Вставить("filters", Новый Соответствие);
		Стр.Вставить("aggregates", Агрегаты);
		Возврат ar_JSON.ВЗначениеJSON(Стр);

	// get_account_balance (RECON-01): required-полей нет (account по умолчанию "62"),
	// но профиль задаёт only_debit=Истина — содержательный путь «отбор должников».
	ИначеЕсли Имя = "get_account_balance" Тогда
		Стр = Новый Структура;
		Стр.Вставить("account", "62");
		Стр.Вставить("only_debit", Истина);
		Возврат ar_JSON.ВЗначениеJSON(Стр);

	// create_reconciliation_act (RECON-01): required client_ref — контрагент.
	// force=Истина, чтобы тест не упирался в порог свежести последнего акта
	// (без force повторный прогон дал бы status=skipped, а не created).
	ИначеЕсли Имя = "create_reconciliation_act" Тогда
		Если ПустаяСтрока(Разведка.КонтрагентNavRef) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("client_ref", Разведка.КонтрагентNavRef);
		Стр.Вставить("force", Истина);
		Возврат ar_JSON.ВЗначениеJSON(Стр);

	// prepare_reconciliation_email (RECON-01): required act_ref — существующий
	// акт сверки. Профиль пропускается (Неопределено), если актов в базе нет.
	ИначеЕсли Имя = "prepare_reconciliation_email" Тогда
		Возврат ?(ПустаяСтрока(Разведка.АктСверкиNavRef), Неопределено,
			ar_JSON.ВЗначениеJSON(Новый Структура("act_ref", Разведка.АктСверкиNavRef)));

	КонецЕсли;

	// get_constants / get_functional_options / get_current_context (UNIV-07):
	// профиль не нужен — у схем нет required-полей, автогенерация даст "{}".

	Возврат Неопределено;

КонецФункции

// Разведать базу: подобрать реальные объекты под профильные кейсы tools.
// Кэшируется в переменной модуля объекта на время жизни обработки.
//
// Возвращаемое значение:
//  Структура: СправочникТип/NavRef, КонтрагентNavRef, ФрагментКонтрагента,
//   ДокументNavRef, НомерСчёта, ИмяОтчёта, Версионируемый*, ОтслеживаемыйТип.
//
Функция РазведатьБазу() Экспорт

	Если РазведкаКэш <> Неопределено Тогда
		Возврат РазведкаКэш;
	КонецЕсли;

	Р = Новый Структура;
	Р.Вставить("СправочникТип", "");
	Р.Вставить("СправочникNavRef", "");
	Р.Вставить("КонтрагентNavRef", "");
	Р.Вставить("ФрагментКонтрагента", "");
	Р.Вставить("ДокументNavRef", "");
	Р.Вставить("НомерСчёта", "");
	Р.Вставить("НоменклатураNavRef", "");
	Р.Вставить("ИмяОтчёта", "");
	Р.Вставить("ВерсионируемыйТип", "");
	Р.Вставить("ВерсионируемыйUUID", "");
	Р.Вставить("ОтслеживаемыйТип", "");
	Р.Вставить("АктСверкиNavRef", "");

	СпрРеф = ПервыйДоступныйСправочник();
	Если СпрРеф <> Неопределено Тогда
		Р.СправочникТип    = СпрРеф.ИмяТипаОбъекта;
		Р.СправочникNavRef = СпрРеф.НавСсылка;
	КонецЕсли;

	// Контрагент — через маппинг «Контрагенты» (согласованно с CRM/invoice-tools).
	// Если маппинг не задан, ИмяОбъектаМетаданных вернёт "Контрагенты"; если такого
	// нет — падаем на подбор по ключевым словам.
	ИмяКонтр = ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");
	ДанныеКонтр = ПервыйЭлементСправочника(ИмяКонтр);
	Если ДанныеКонтр = Неопределено Тогда
		ДанныеКонтр = ПодобратьКонтрагента();
	КонецЕсли;
	Если ДанныеКонтр <> Неопределено Тогда
		Р.КонтрагентNavRef    = ДанныеКонтр.НавСсылка;
		Р.ФрагментКонтрагента = ДанныеКонтр.Фрагмент;
	КонецЕсли;

	// Документ-счёт — через маппинг «СчетНаОплатуПокупателю» (для get_invoice/
	// validate_document/get_print_form). Иначе — первый любой документ.
	ИмяСчёта = ar_ToolDispatcher.ИмяОбъектаМетаданных("СчетНаОплатуПокупателю", "СчетНаОплатуПокупателю");
	ДанныеДок = ПервыйЭлементДокумента(ИмяСчёта);
	Если ДанныеДок = Неопределено Тогда
		ДанныеДок = ПервыйДоступныйДокумент();
	КонецЕсли;
	Если ДанныеДок <> Неопределено Тогда
		Р.ДокументNavRef = ДанныеДок.НавСсылка;
		Р.НомерСчёта     = ДанныеДок.Номер;
	КонецЕсли;

	// Номенклатура — через маппинг (для позиций create_invoice_draft).
	ИмяНоменклатуры = ar_ToolDispatcher.ИмяОбъектаМетаданных("Номенклатура", "Номенклатура");
	ДанныеНом = ПервыйЭлементСправочника(ИмяНоменклатуры);
	Если ДанныеНом <> Неопределено Тогда
		Р.НоменклатураNavRef = ДанныеНом.НавСсылка;
	КонецЕсли;

	Р.ИмяОтчёта = ПодобратьОтчётСоСхемой();

	// Акт сверки взаиморасчётов — для prepare_reconciliation_email (RECON-01):
	// нужен существующий акт как основание письма и источник печатной формы-вложения.
	// Пусто, если актов в базе нет — профиль вернёт Неопределено, tool не тестируется.
	ИмяАкта = ar_ToolDispatcher.ИмяОбъектаМетаданных("АктСверкиВзаиморасчетов", "АктСверкиВзаиморасчетов");
	ДанныеАкта = ПервыйЭлементДокумента(ИмяАкта);
	Если ДанныеАкта <> Неопределено Тогда
		Р.АктСверкиNavRef = ДанныеАкта.НавСсылка;
	КонецЕсли;

	// Объект с версионированием / отслеживанием изменений — если есть в базе.
	ЗаполнитьВерсионируемыйИОтслеживаемый(Р);

	РазведкаКэш = Р;
	Возврат Р;

КонецФункции

// Сгенерировать «умный» пример аргументов из реальных данных ИБ.
//
// В отличие от СгенерироватьПримерАргументов (заглушки demo_*), пытается
// подставить существующие значения, чтобы tool пошёл по успешному пути:
//  * поля-ссылки (ref, client_ref, document_ref, object_ref) → навигационная
//    ссылка первого доступного объекта подходящего класса;
//  * object_type / source → реальный "Класс.Имя" (первый непустой справочник
//    или документ, не из расширения ar_);
//  * report_name → имя первого доступного отчёта;
//  * остальные поля — как в базовой генерации (default/enum/type).
// Если реального значения не нашлось — падает обратно на заглушку.
//
// Параметры:
//  JSONManifest       - Строка - манифест tool (ar_JSONManifest).
//  ТолькоОбязательные - Булево - заполнять только required-поля (по умолчанию Истина).
//
// Возвращаемое значение:
//  Строка - JSON-объект аргументов. При отсутствии/невалидности схемы → "{}".
//
Функция СгенерироватьУмныеАргументы(Знач JSONManifest, Знач ТолькоОбязательные = Истина) Экспорт

	Параметры = ИзвлечьСхемуПараметров(JSONManifest);
	Если Параметры = Неопределено Тогда
		Возврат "{}";
	КонецЕсли;

	Свойства = ЗначениеСоответствия(Параметры, "properties");
	Если ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		Возврат "{}";
	КонецЕсли;

	ОбязательныеИмена = МножествоОбязательных(Параметры);
	СправочникРеф = ПервыйДоступныйСправочник();

	// Есть ли в схеме поле object_type — тогда ref-поля отдаём «голым» UUID и
	// заполняем object_type в паре (обход парсера навигационной ссылки: ветка
	// СсылкаПоUUID в read_object/find_references/get_object_history надёжнее).
	ЕстьObjectType = (Свойства.Получить("object_type") <> Неопределено);

	Аргументы = Новый Соответствие;
	Для Каждого КлючЗначение Из Свойства Цикл
		ИмяСвойства = КлючЗначение.Ключ;
		СхемаСвойства = КлючЗначение.Значение;

		Обязательное = ОбязательныеИмена.Получить(ИмяСвойства) <> Неопределено;
		// object_type заполняем всегда, если есть реальный справочник (нужен в паре
		// к ref-полю), даже когда он необязательный.
		ЗаполнитьВсёРавно = (НРег(ИмяСвойства) = "object_type" И СправочникРеф <> Неопределено);
		Если ТолькоОбязательные И НЕ Обязательное И НЕ ЗаполнитьВсёРавно Тогда
			Продолжить;
		КонецЕсли;

		УмноеЗначение = УмноеЗначениеПоля(ИмяСвойства, СправочникРеф, ЕстьObjectType);
		Если УмноеЗначение <> Неопределено Тогда
			Аргументы.Вставить(ИмяСвойства, УмноеЗначение);
		Иначе
			Аргументы.Вставить(ИмяСвойства, ЗначениеПоСхеме(СхемаСвойства, ИмяСвойства));
		КонецЕсли;
	КонецЦикла;

	Результат = ar_JSON.ВЗначениеJSON(Аргументы);
	Возврат ?(ПустаяСтрока(Результат), "{}", Результат);

КонецФункции

// Выполнить один tool через диспетчер и распознать результат.
//
// Формирует боевой контекст запуска (DryRun = Ложь, RunId = ""), вызывает
// ar_ToolDispatcher.Вызвать и анализирует observation: наличие ключа "error"
// трактуется как ошибка tool. В контекст кладётся ПользовательUUID текущего
// сеанса — чтобы memory-tools (remember/recall_memory) не падали с
// "agent context missing" в анонимном (без агента) режиме теста.
//
// Параметры:
//  ИмяTool       - Строка - имя tool (ar_Имя).
//  АргументыJSON - Строка - JSON-аргументы (может быть пустым → "{}").
//
// Возвращаемое значение:
//  Структура:
//    Успех       - Булево - Ложь, если observation содержит "error" или вызов
//                  завершился исключением диспетчера;
//    Observation - Строка - сырой JSON-ответ tool;
//    ТекстОшибки - Строка - значение "error" из observation (или текст сбоя);
//    RiskLevel   - Строка - уровень риска из результата диспетчера;
//    ResultRef   - Строка - ссылка на результат (если tool её вернул).
//
Функция ВыполнитьТест(Знач ИмяTool, Знач АргументыJSON) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех",       Ложь);
	Результат.Вставить("Observation", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("RiskLevel",   "");
	Результат.Вставить("ResultRef",   "");

	Аргументы = ?(ПустаяСтрока(АргументыJSON), "{}", АргументыJSON);

	// Реальный RunId (запись ar_Запуски в статусе Running) — commit-tools ставят
	// действие в очередь approval, которая требует непустой RunId (APPR-01).
	// Для read-tools RunId тоже безвреден (включит аудит действия).
	RunId = ОбеспечитьТестовыйЗапуск();

	// Прогон всех tools длится дольше порога heartbeat (90 сек), поэтому
	// «пингуем» запуск перед каждым вызовом - иначе sweeper прервёт его
	// в середине прогона.
	ОбновитьHeartbeatТестовогоЗапуска(RunId);

	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("RunId",          RunId);
	КонтекстЗапуска.Вставить("Агент",          Справочники.ar_Агенты.ПустаяСсылка());
	КонтекстЗапуска.Вставить("РежимАвтономии", Перечисления.ar_РежимАвтономии.Manual);
	КонтекстЗапуска.Вставить("DryRun",         Ложь);
	КонтекстЗапуска.Вставить("Sequence",       0);
	// UUID текущего пользователя ИБ — владелец контекста для memory-tools в
	// режиме «без агента» (иначе remember/recall_memory → agent context missing).
	КонтекстЗапуска.Вставить("ПользовательUUID", Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор));

	Попытка
		ОтветДиспетчера = ar_ToolDispatcher.Вызвать(ИмяTool, Аргументы, КонтекстЗапуска);
	Исключение
		// Диспетчер не должен выбрасывать наружу — но на всякий случай ловим.
		Результат.ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Результат.Observation = ЗначениеСтруктуры(ОтветДиспетчера, "Результат", "");
	Результат.RiskLevel   = ЗначениеСтруктуры(ОтветДиспетчера, "RiskLevel", "");
	Результат.ResultRef   = ЗначениеСтруктуры(ОтветДиспетчера, "ResultRef", "");

	ТекстОшибки = ИзвлечьОшибкуObservation(Результат.Observation);
	Если ПустаяСтрока(ТекстОшибки) Тогда
		Результат.Успех = Истина;
	Иначе
		Результат.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлечь Соответствие function.parameters из строки манифеста.
// Возвращает Неопределено, если манифест невалиден или схемы нет.
//
Функция ИзвлечьСхемуПараметров(Знач JSONManifest)

	Если ТипЗнч(JSONManifest) <> Тип("Строка") Или ПустаяСтрока(JSONManifest) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Разобранное = ar_JSON.ИзJSON(JSONManifest);
	Если ТипЗнч(Разобранное) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// OpenAI tool-format: { type, function: { name, description, parameters } }.
	// Допускаем также плоский вариант { name, parameters } на случай иных схем.
	БлокФункции = ЗначениеСоответствия(Разобранное, "function");
	ИсточникПараметров = ?(ТипЗнч(БлокФункции) = Тип("Соответствие"), БлокФункции, Разобранное);

	Параметры = ЗначениеСоответствия(ИсточникПараметров, "parameters");
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Параметры;

КонецФункции

// Множество имён обязательных свойств (required) как Соответствие Имя→Истина.
//
Функция МножествоОбязательных(Знач Параметры)

	Итог = Новый Соответствие;
	Обязательные = ЗначениеСоответствия(Параметры, "required");
	Если ТипЗнч(Обязательные) = Тип("Массив") Тогда
		Для Каждого Имя Из Обязательные Цикл
			Если ТипЗнч(Имя) = Тип("Строка") Тогда
				Итог.Вставить(Имя, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Подобрать правдоподобное значение по JSON-схеме одного свойства.
// Учитывает enum, default, type, minimum. Незнакомые типы → строка-заглушка.
//
Функция ЗначениеПоСхеме(Знач СхемаСвойства, Знач ИмяСвойства)

	Если ТипЗнч(СхемаСвойства) <> Тип("Соответствие") Тогда
		Возврат "demo";
	КонецЕсли;

	// 1. Явный default из схемы — самый безопасный выбор.
	Значение = Неопределено;
	Если СхемаСвойства.Получить("default") <> Неопределено Тогда
		Возврат СхемаСвойства.Получить("default");
	КонецЕсли;

	// 2. enum — берём первое допустимое значение.
	Перечень = ЗначениеСоответствия(СхемаСвойства, "enum");
	Если ТипЗнч(Перечень) = Тип("Массив") И Перечень.Количество() > 0 Тогда
		Возврат Перечень[0];
	КонецЕсли;

	Тип = ЗначениеСоответствия(СхемаСвойства, "type");
	Тип = ?(ТипЗнч(Тип) = Тип("Строка"), НРег(Тип), "string");

	Если Тип = "integer" Или Тип = "number" Тогда
		Минимум = ЗначениеСоответствия(СхемаСвойства, "minimum");
		Если ТипЗнч(Минимум) = Тип("Число") Тогда
			Возврат Минимум;
		КонецЕсли;
		Возврат 1;

	ИначеЕсли Тип = "boolean" Тогда
		Возврат Ложь;

	ИначеЕсли Тип = "array" Тогда
		Возврат Новый Массив;

	ИначеЕсли Тип = "object" Тогда
		Возврат Новый Соответствие;

	Иначе
		// string и всё прочее.
		Возврат "demo_" + ИмяСвойства;
	КонецЕсли;

КонецФункции

// Извлечь текст ошибки из observation tool. Ошибкой считается JSON-объект с
// непустым ключом "error". Возвращает "" если ошибки нет.
//
Функция ИзвлечьОшибкуObservation(Знач Observation)

	Если ТипЗнч(Observation) <> Тип("Строка") Или ПустаяСтрока(Observation) Тогда
		Возврат "";
	КонецЕсли;

	Разобранное = ar_JSON.ИзJSON(Observation);
	Если ТипЗнч(Разобранное) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Ошибка = Разобранное.Получить("error");
	Если Ошибка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТекстОшибки = ?(ТипЗнч(Ошибка) = Тип("Строка"), Ошибка, ar_JSON.ВЗначениеJSON(Ошибка));
	Возврат ?(ПустаяСтрока(ТекстОшибки), "unknown_error", СокрЛП(ТекстОшибки));

КонецФункции

// Найти первый пользовательский справочник (не из расширения ar_) с хотя бы
// одним элементом. Возвращает структуру для подстановки в аргументы tools:
//   { ПолноеИмя - "Справочник.XXX", НавСсылка - навигационная ссылка первого
//     элемента, Ссылка - сама ссылка }.
// Если ничего не нашлось — Неопределено (умный подбор не сработает, будет
// использована заглушка).
//
Функция ПервыйДоступныйСправочник()

	Для Каждого МД Из Метаданные.Справочники Цикл
		// Пропускаем объекты расширения (ar_) — они инкапсулированы ядром и
		// недоступны для универсальных tools (query/read_object).
		Если Лев(ВРег(МД.Имя), 3) = "AR_" Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник." + МД.Имя + " КАК Т";
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Продолжить;
		КонецЕсли;

		НавСсылка = "";
		Попытка
			НавСсылка = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
		Исключение
			НавСсылка = "";
		КонецПопытки;

		Результат = Новый Структура;
		Результат.Вставить("ПолноеИмя", "Справочник." + МД.Имя);
		Результат.Вставить("ИмяТипаОбъекта", "Справочник." + МД.Имя);
		Результат.Вставить("НавСсылка", НавСсылка);
		Результат.Вставить("UUID", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Результат.Вставить("Ссылка", Выборка.Ссылка);
		Возврат Результат;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Настроить маппинг логических имён объектов на реальные объекты целевой
// конфигурации (регистр ar_ПереопределенияОбъектов). CRM-tools ищут справочник
// "Контрагенты", invoice-tools — документ "СчетНаОплатуПокупателю"; в демо-
// конфигурации эти объекты называются иначе (_ДемоКонтрагенты и т.п.), поэтому
// без маппинга tools дают client_not_found / document_type_not_found.
//
// Подбирает по ключевым словам в имени/синониме и пишет переопределения. Это
// конфигурационное действие (влияет на боевые tools), поэтому вынесено в
// отдельную команду формы, а не в автопрогон.
//
// Возвращаемое значение:
//  Строка - текстовый отчёт о выставленных переопределениях.
//
Функция НастроитьМаппингДемо() Экспорт

	Строки = Новый Массив;

	// Для каждого логического имени: сначала пробуем ТОЧНЫЕ имена демо-конфигурации
	// (надёжнее эвристики), затем — подбор по словам с отсевом «служебных» объектов
	// (группы/виды/статусы/типы/настройки — не сущности, а справочники-классификаторы).

	// Контрагенты — справочник контрагентов.
	ИмяКонтрагентов = ПодобратьОбъект(Метаданные.Справочники,
		"_ДемоКонтрагенты,Контрагенты,Клиенты", "контрагент,клиент,заказчик");
	Строки.Добавить(ЗаписатьПереопределение("Контрагенты", ИмяКонтрагентов));

	// Счёт на оплату покупателю — именно СЧЁТ, не заказ/реализация.
	ИмяСчёта = ПодобратьОбъект(Метаданные.Документы,
		"_ДемоСчетНаОплатуПокупателю,СчетНаОплатуПокупателю,СчётНаОплатуПокупателю", "счет,счёт");
	Строки.Добавить(ЗаписатьПереопределение("СчетНаОплатуПокупателю", ИмяСчёта));

	// Номенклатура — сам справочник номенклатуры (не «Виды номенклатуры»).
	ИмяНоменклатуры = ПодобратьОбъект(Метаданные.Справочники,
		"_ДемоНоменклатура,Номенклатура,Товары", "номенклатур,товар,продукц");
	Строки.Добавить(ЗаписатьПереопределение("Номенклатура", ИмяНоменклатуры));

	// Организации.
	ИмяОрганизаций = ПодобратьОбъект(Метаданные.Справочники,
		"_ДемоОрганизации,Организации", "организац,фирм,компан");
	Строки.Добавить(ЗаписатьПереопределение("Организации", ИмяОрганизаций));

	// Маппинг влияет на разрешение логических имён → доступность tools (UNIV-03)
	// могла измениться. Пересчитываем и заполняем профиль конфигурации (UNIV-01),
	// чтобы прогон шёл в актуальном состоянии среды.
	Строки.Добавить("");
	Строки.Добавить(ПодготовитьСреду());

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Подобрать имя объекта: приоритет точным именам-кандидатам (через запятую),
// затем — подбор по ключевым словам с отсевом служебных справочников-
// классификаторов (группы/виды/статусы/типы/настройки/доступ). "" если ничего.
//
// Параметры:
//  Коллекция     - объект метаданных-коллекция (Метаданные.Справочники/Документы).
//  ТочныеИмена   - Строка - имена-кандидаты через запятую (проверяются по порядку).
//  КлючевыеСлова - Строка - слова для эвристического подбора через запятую.
//
Функция ПодобратьОбъект(Знач Коллекция, Знач ТочныеИмена, Знач КлючевыеСлова)

	// 1. Точное имя — самый надёжный путь.
	Для Каждого Кандидат Из СтрРазделить(ТочныеИмена, ",") Цикл
		Если НЕ ПустаяСтрока(Кандидат) И Коллекция.Найти(СокрЛП(Кандидат)) <> Неопределено Тогда
			Возврат СокрЛП(Кандидат);
		КонецЕсли;
	КонецЦикла;

	// 2. Эвристика с отсевом служебных объектов.
	СтопСлова = "групп,вид,статус,тип,настройк,доступ,шаблон,вариант,класс,категор";
	Слова = СтрРазделить(КлючевыеСлова, ",");
	Для Каждого МД Из Коллекция Цикл
		Если Лев(ВРег(МД.Имя), 3) = "AR_" Тогда
			Продолжить;
		КонецЕсли;
		ИмяСин = НРег(МД.Имя + " " + Строка(МД.Синоним));

		Если СодержитОдноИзСлов(ИмяСин, СтопСлова) Тогда
			Продолжить;
		КонецЕсли;
		Если СодержитОдноИзСлов(ИмяСин, КлючевыеСлова) Тогда
			Возврат МД.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Истина, если строка содержит хотя бы одно из слов (через запятую).
Функция СодержитОдноИзСлов(Знач Строка, Знач СписокСлов)
	Для Каждого Слово Из СтрРазделить(СписокСлов, ",") Цикл
		Если НЕ ПустаяСтрока(СокрЛП(Слово)) И СтрНайти(Строка, НРег(СокрЛП(Слово))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Записать одно переопределение логическое→реальное в ar_ПереопределенияОбъектов.
// Возвращает строку-отчёт. Пустое реальное имя → переопределение не пишется.
//
Функция ЗаписатьПереопределение(Знач ЛогическоеИмя, Знач ИмяВМетаданных)

	Если ПустаяСтрока(ИмяВМетаданных) Тогда
		Возврат СтрШаблон("%1 → (не найдено, пропущено)", ЛогическоеИмя);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи = РегистрыСведений.ar_ПереопределенияОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_ЛогическоеИмя  = ЛогическоеИмя;
		МенеджерЗаписи.ar_ИмяВМетаданных = ИмяВМетаданных;
		МенеджерЗаписи.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Возврат СтрШаблон("%1 → %2 (ОШИБКА записи: %3)", ЛогическоеИмя, ИмяВМетаданных,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат СтрШаблон("%1 → %2 (записано)", ЛогическоеИмя, ИмяВМетаданных);

КонецФункции

// Обеспечить наличие тестового запуска (запись ar_Запуски в статусе Running) и
// вернуть его RunId. Commit-tools (save_object, create_invoice_draft) ставят
// действие в очередь approval, которая требует непустой RunId (APPR-01) с не-
// финальным статусом. Создаём легитимную запись один раз за сеанс обработки.
//
// Привилегированный режим: запись служебного регистра ar_Запуски недоступна в
// правах пользователя (та же причина, что и в ar_Approval — запуск/аудит). Режим
// поднимается точечно и сбрасывается через try/finally.
//
// Возвращаемое значение:
//  Строка - RunId созданного (или ранее созданного) тестового запуска.
//
// Продлевает heartbeat тестового запуска, чтобы sweeper (SCHED-04) не прервал
// его в середине прогона. Тестовая обработка не крутит цикл агента
// (ar_RuntimeЦикл), который в норме шлёт heartbeat сам, поэтому делаем это тут.
//
// Ошибки подавляются: неудачный «пинг» не должен ронять тест инструмента.
//
// Параметры:
//  RunId - Строка - идентификатор тестового запуска.
//
Процедура ОбновитьHeartbeatТестовогоЗапуска(Знач RunId)

	Если ПустаяСтрока(RunId) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ar_AuditЗапуски.Heartbeat(RunId);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
	КонецПопытки;

КонецПроцедуры

Функция ОбеспечитьТестовыйЗапуск()

	Если НЕ ПустаяСтрока(ТестовыйRunIdКэш) Тогда
		Возврат ТестовыйRunIdКэш;
	КонецЕсли;

	RunId = Строка(Новый УникальныйИдентификатор);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_RunId      = RunId;
		МенеджерЗаписи.ar_Статус     = Перечисления.ar_СтатусЗапуска.Running;
		МенеджерЗаписи.ar_СтартовалВ = ТекущаяДатаСеанса();
		// Без ar_LastHeartbeat запись выглядит «зависшей» с момента создания:
		// sweeper (SCHED-04) через ar_Константы.HeartbeatПорогСек() (90 сек)
		// переводит запуск в Interrupted, и последующий approve уже не может
		// возобновить агента (snapshot_missing_or_incompatible).
		МенеджерЗаписи.ar_LastHeartbeat = ТекущаяДатаСеанса();
		МенеджерЗаписи.ar_Триггер    = "ar_ТестТулов";
		МенеджерЗаписи.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		// Не удалось создать запуск — вернём пусто, commit-tools дадут свою ошибку.
		Возврат "";
	КонецПопытки;

	ТестовыйRunIdКэш = RunId;
	Возврат RunId;

КонецФункции

// Подобрать справочник-контрагентов: приоритет объектам, у которых в имени или
// синониме есть «контрагент»/«клиент»/«поставщик»/«покупатель». Возвращает
// { НавСсылка, Фрагмент } первого элемента (Фрагмент — первые буквы наименования
// для search_clients) либо Неопределено.
//
Функция ПодобратьКонтрагента()

	КлючевыеСлова = "контрагент,клиент,поставщик,покупатель,партнер,партнёр";

	// Проход 1 — только «профильные» справочники; проход 2 — любой с данными.
	Для Прохода = 1 По 2 Цикл
		Для Каждого МД Из Метаданные.Справочники Цикл
			Если Лев(ВРег(МД.Имя), 3) = "AR_" Тогда
				Продолжить;
			КонецЕсли;

			Если Прохода = 1 Тогда
				Профильный = Ложь;
				ИмяСин = НРег(МД.Имя + " " + Строка(МД.Синоним));
				Для Каждого Слово Из СтрРазделить(КлючевыеСлова, ",") Цикл
					Если СтрНайти(ИмяСин, Слово) > 0 Тогда
						Профильный = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ Профильный Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка, Т.Наименование КАК Наименование
				|ИЗ Справочник." + МД.Имя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления";
			Выборка = Запрос.Выполнить().Выбрать();
			Если НЕ Выборка.Следующий() Тогда
				Продолжить;
			КонецЕсли;

			НавСсылка = "";
			Попытка
				НавСсылка = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
			Исключение
				НавСсылка = "";
			КонецПопытки;

			Результат = Новый Структура;
			Результат.Вставить("НавСсылка", НавСсылка);
			Результат.Вставить("Фрагмент", Лев(СокрЛП(Выборка.Наименование), 3));
			Возврат Результат;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Подобрать отчёт конфигурации с основной схемой компоновки данных (СКД).
// run_report требует именно СКД-отчёт (ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных")),
// поэтому первый попавшийся отчёт без СКД даёт no_dcs_schema. Возвращает имя или "".
//
Функция ПодобратьОтчётСоСхемой()

	// Приоритет — известные рабочие СКД-отчёты демо-конфигурации (проверенные
	// вручную). Берём первый существующий, чтобы не зависеть от порядка перебора.
	ПриоритетныеОтчёты = "_ДемоСтатусыЗаказовПокупателей,_ДемоОстаткиТоваровКомпании,_ДемоПродажи";
	Для Каждого ИмяПрио Из СтрРазделить(ПриоритетныеОтчёты, ",") Цикл
		Если Метаданные.Отчеты.Найти(СокрЛП(ИмяПрио)) <> Неопределено Тогда
			Возврат СокрЛП(ИмяПрио);
		КонецЕсли;
	КонецЦикла;

	ПервыйЛюбой = "";
	Для Каждого МД Из Метаданные.Отчеты Цикл
		Если Лев(ВРег(МД.Имя), 3) = "AR_" Или Лев(ВРег(МД.Имя), 4) = "AOS_" Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(ПервыйЛюбой) Тогда
			ПервыйЛюбой = МД.Имя;
		КонецЕсли;

		// Надёжный документированный признак СКД-отчёта — заполненное свойство
		// объекта метаданных ОсновнаяСхемаКомпоновкиДанных (ссылка на макет-СКД),
		// а не ПолучитьМакет в try/catch. [Платформа: ОбъектМетаданных.Отчет]
		Если ОтчётНаСКД(МД) Тогда
			Возврат МД.Имя;
		КонецЕсли;
	КонецЦикла;

	// Ни одного СКД-отчёта — вернём первый любой (tool даст no_dcs_schema, но
	// хотя бы имя реального отчёта, а не заглушку).
	Возврат ПервыйЛюбой;

КонецФункции

// Истина, если отчёт построен на СКД: у объекта метаданных отчёта заполнено
// свойство ОсновнаяСхемаКомпоновкиДанных (ссылка на макет-схему компоновки).
// Документированный способ, не требует ПолучитьМакет/try-catch.
//
Функция ОтчётНаСКД(Знач МДОтчёта)
	Попытка
		Возврат МДОтчёта.ОсновнаяСхемаКомпоновкиДанных <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Первый документ с данными: { НавСсылка, Номер } или Неопределено.
//
Функция ПервыйДоступныйДокумент()

	Для Каждого МД Из Метаданные.Документы Цикл
		Если Лев(ВРег(МД.Имя), 3) = "AR_" Тогда
			Продолжить;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка, Т.Номер КАК Номер
			|ИЗ Документ." + МД.Имя + " КАК Т";
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Продолжить;
		КонецЕсли;

		НавСсылка = "";
		Попытка
			НавСсылка = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
		Исключение
			НавСсылка = "";
		КонецПопытки;

		Результат = Новый Структура;
		Результат.Вставить("НавСсылка", НавСсылка);
		Результат.Вставить("Номер", СокрЛП(Строка(Выборка.Номер)));
		Возврат Результат;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Первый непомеченный элемент КОНКРЕТНОГО справочника по имени: { НавСсылка,
// Фрагмент } или Неопределено (справочник не существует / пуст).
//
Функция ПервыйЭлементСправочника(Знач ИмяСправочника)

	Если ПустаяСтрока(ИмяСправочника) Или Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка, Т.Наименование КАК Наименование
		|ИЗ Справочник." + ИмяСправочника + " КАК Т ГДЕ НЕ Т.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	НавСсылка = "";
	Попытка
		НавСсылка = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
	Исключение
		НавСсылка = "";
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("НавСсылка", НавСсылка);
	Результат.Вставить("Фрагмент", Лев(СокрЛП(Выборка.Наименование), 3));
	Возврат Результат;

КонецФункции

// Первый элемент КОНКРЕТНОГО документа по имени: { НавСсылка, Номер } или
// Неопределено (документ не существует / пуст).
//
Функция ПервыйЭлементДокумента(Знач ИмяДокумента)

	Если ПустаяСтрока(ИмяДокумента) Или Метаданные.Документы.Найти(ИмяДокумента) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка, Т.Номер КАК Номер
		|ИЗ Документ." + ИмяДокумента + " КАК Т";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	НавСсылка = "";
	Попытка
		НавСсылка = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
	Исключение
		НавСсылка = "";
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("НавСсылка", НавСсылка);
	Результат.Вставить("Номер", СокрЛП(Строка(Выборка.Номер)));
	Возврат Результат;

КонецФункции

// Подобрать объект с версионированием (БСП) и с отслеживанием изменений
// (реквизит ДатаИзменения) — заполняет поля Р.Версионируемый*/Отслеживаемый*.
// Отслеживаемый: справочник с непустым реквизитом ДатаИзменения (как проверяет
// get_recent_changes). Версионируемый оставляем пустым, если БСП-версионирование
// не настроено (tool корректно вернёт no_version_history — это не баг).
//
Процедура ЗаполнитьВерсионируемыйИОтслеживаемый(Р)

	Для Каждого МД Из Метаданные.Справочники Цикл
		Если Лев(ВРег(МД.Имя), 3) = "AR_" Тогда
			Продолжить;
		КонецЕсли;
		Если МД.Реквизиты.Найти("ДатаИзменения") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Есть данные?
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник." + МД.Имя + " КАК Т";
		Если Запрос.Выполнить().Пустой() Тогда
			Продолжить;
		КонецЕсли;

		Р.ОтслеживаемыйТип = "Справочник." + МД.Имя;
		Прервать;
	КонецЦикла;

	ЗаполнитьВерсионируемыйДляИстории(Р);

КонецПроцедуры

// Подобрать объект с РЕАЛЬНО включённым версионированием БСП (для get_object_history).
// Признак — не наличие реквизита, а факт из регистра НастройкиВерсионированияОбъектов
// (ВерсионированиеОбъектов.ВключеноВерсионированиеОбъекта, [Реф: БСП/ВерсионированиеОбъектов]).
// Приоритет — конкретный элемент "_ДемоКонтрагенты" (подтверждено вручную: версия
// есть в истории), иначе первый элемент "_ДемоКонтрагенты", иначе перебор всех
// справочников с проверкой через БСП.
//
Процедура ЗаполнитьВерсионируемыйДляИстории(Р)

	// Известный рабочий элемент (подтверждено вручную: 2026-07-20).
	ИзвестныйUUID = "a1ba0050-56c0-0008-11de-8d7fb63d5144";
	Если Метаданные.Справочники.Найти("_ДемоКонтрагенты") <> Неопределено
		И ВерсионированиеВключеноБезопасно("Справочник._ДемоКонтрагенты")
		И ЭлементСправочникаСуществует("_ДемоКонтрагенты", ИзвестныйUUID) Тогда
		Р.ВерсионируемыйТип  = "Справочник._ДемоКонтрагенты";
		Р.ВерсионируемыйUUID = ИзвестныйUUID;
		Возврат;
	КонецЕсли;

	ПриоритетныеСправочники = "_ДемоКонтрагенты,Контрагенты";
	Для Каждого ИмяПрио Из СтрРазделить(ПриоритетныеСправочники, ",") Цикл
		ИмяПрио = СокрЛП(ИмяПрио);
		Если Метаданные.Справочники.Найти(ИмяПрио) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ВерсионированиеВключеноБезопасно("Справочник." + ИмяПрио) Тогда
			Продолжить;
		КонецЕсли;

		UUIDЭлемента = UUIDПервогоЭлемента(ИмяПрио);
		Если ПустаяСтрока(UUIDЭлемента) Тогда
			Продолжить;
		КонецЕсли;

		Р.ВерсионируемыйТип  = "Справочник." + ИмяПрио;
		Р.ВерсионируемыйUUID = UUIDЭлемента;
		Возврат;
	КонецЦикла;

	// Фолбэк: перебор всех пользовательских справочников с данными.
	Для Каждого МД Из Метаданные.Справочники Цикл
		Если Лев(ВРег(МД.Имя), 3) = "AR_" Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ВерсионированиеВключеноБезопасно("Справочник." + МД.Имя) Тогда
			Продолжить;
		КонецЕсли;

		UUIDЭлемента = UUIDПервогоЭлемента(МД.Имя);
		Если ПустаяСтрока(UUIDЭлемента) Тогда
			Продолжить;
		КонецЕсли;

		Р.ВерсионируемыйТип  = "Справочник." + МД.Имя;
		Р.ВерсионируемыйUUID = UUIDЭлемента;
		Прервать;
	КонецЦикла;

КонецПроцедуры

// UUID первого непомеченного элемента справочника по имени, либо "".
//
Функция UUIDПервогоЭлемента(Знач ИмяСправочника)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ Справочник." + ИмяСправочника + " КАК Т ГДЕ НЕ Т.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Выборка.Ссылка.УникальныйИдентификатор());
КонецФункции

// Истина, если элемент справочника с указанным UUID существует и не помечен
// на удаление. Не выбрасывает исключений (некорректный UUID → Ложь).
//
Функция ЭлементСправочникаСуществует(Знач ИмяСправочника, Знач СтрокаUUID)
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СтрокаUUID);
		Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Идентификатор);
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
			|ИЗ Справочник." + ИмяСправочника + " КАК Т
			|ГДЕ Т.Ссылка = &Ссылка И НЕ Т.ПометкаУдаления";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Возврат НЕ Запрос.Выполнить().Пустой();
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Обёртка ВерсионированиеОбъектов.ВключеноВерсионированиеОбъекта с перехватом
// исключений (подсистема версионирования может быть недоступна/не настроена).
//
Функция ВерсионированиеВключеноБезопасно(Знач ПолноеИмяОбъекта)
	Попытка
		Возврат ВерсионированиеОбъектов.ВключеноВерсионированиеОбъекта(ПолноеИмяОбъекта) = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Подобрать реальное значение аргумента по имени поля схемы. Возвращает
// Неопределено, если для поля нет «умной» подстановки (тогда вызывающий код
// использует заглушку из ЗначениеПоСхеме).
//
// Параметры:
//  ИмяПоля          - Строка - имя свойства из JSON-схемы (ref, source, ...).
//  СправочникРеф    - Структура или Неопределено - результат ПервыйДоступныйСправочник.
//  ПредпочитатьUUID - Булево - если Истина, для ref-полей отдаётся «голый» UUID
//                     (а не навигационная ссылка) — рассчитано на то, что в
//                     аргументах есть парный object_type.
//
Функция УмноеЗначениеПоля(Знач ИмяПоля, Знач СправочникРеф, Знач ПредпочитатьUUID = Ложь)

	Если СправочникРеф = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНРег = НРег(ИмяПоля);

	// Поля-ссылки → UUID (если есть парный object_type) либо навигационная ссылка.
	Ссылочные = "ref,client_ref,document_ref,object_ref,contractor_ref,invoice_ref";
	Если СтрНайти("," + Ссылочные + ",", "," + ИмяНРег + ",") > 0 Тогда
		Если ПредпочитатьUUID И НЕ ПустаяСтрока(СправочникРеф.UUID) Тогда
			Возврат СправочникРеф.UUID;
		КонецЕсли;
		Возврат ?(ПустаяСтрока(СправочникРеф.НавСсылка), Неопределено, СправочникРеф.НавСсылка);
	КонецЕсли;

	// Тип/источник → реальное "Справочник.XXX".
	Если ИмяНРег = "object_type" Или ИмяНРег = "source" Или ИмяНРег = "type_name" Тогда
		Возврат СправочникРеф.ИмяТипаОбъекта;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Список недоступных tools (ar_Доступен = Ложь) с причинами — одна строка на
// tool, "  (нет)" если все доступны. Для блока «РАЗВЕДКА БАЗЫ» диагностики.
//
Функция СписокНедоступныхTools()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_ПричинаНедоступности КАК Причина
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Включён
		|	И НЕ Tools.ПометкаУдаления
		|	И НЕ Tools.ar_Доступен
		|УПОРЯДОЧИТЬ ПО
		|	Tools.ar_Имя";

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить("  - " + СокрЛП(Выборка.Имя) + ": " + СокрЛП(Строка(Выборка.Причина)));
	КонецЦикла;

	Возврат ?(Строки.Количество() = 0, "  (нет)", СтрСоединить(Строки, Символы.ПС));

КонецФункции

// Диагностика чтения документа-счёта: показывает реальный текст исключения,
// который document-tools маскируют под access_denied. Отделяет «нет прав» от
// структурной/иной ошибки чтения.
//
Функция ДиагностикаЧтенияСчёта(Знач НавСсылкаДок)

	Если ПустаяСтрока(НавСсылкаДок) Тогда
		Возврат "Чтение счёта: нет документа для проверки";
	КонецЕсли;

	Ссылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(НавСсылкаДок);
	Если Ссылка = Неопределено Тогда
		Возврат "Чтение счёта: ссылка не разыменована";
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат "Чтение счёта: ПолучитьОбъект вернул Неопределено (нет прав/удалён)";
		КонецЕсли;
		// Пробуем прочитать пару типовых реквизитов счёта.
		Инфо = "Наименование объекта: " + Строка(Объект);
		Возврат "Чтение счёта: OK (" + Инфо + ")";
	Исключение
		Возврат "Чтение счёта: ИСКЛЮЧЕНИЕ (реальная причина access_denied): "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Диагностика отчёта: перечисляет макеты отчёта и их типы, проверяет доступность
// схемы под именем "ОсновнаяСхемаКомпоновкиДанных" (которую ищет run_report).
// Показывает реальное имя СКД-макета, если оно отличается — это отделяет баг
// run_report (жёсткое имя макета) от свойства отчёта.
//
Функция ДиагностикаОтчёта(Знач ИмяОтчёта)

	Если ПустаяСтрока(ИмяОтчёта) Тогда
		Возврат "Отчёт: не выбран";
	КонецЕсли;

	МД = Метаданные.Отчеты.Найти(ИмяОтчёта);
	Если МД = Неопределено Тогда
		Возврат "Отчёт " + ИмяОтчёта + ": не найден в метаданных";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Отчёт " + ИмяОтчёта + ": макеты и типы:");
	ЕстьСКД = Ложь;
	Для Каждого МакетМД Из МД.Макеты Цикл
		ТипМакета = "?";
		Попытка
			Макет = МД.ПолучитьМакет(МакетМД.Имя);
			ТипМакета = Строка(ТипЗнч(Макет));
			Если ТипЗнч(Макет) = Тип("СхемаКомпоновкиДанных") Тогда
				ЕстьСКД = Истина;
			КонецЕсли;
		Исключение
			ТипМакета = "ошибка получения";
		КонецПопытки;
		Строки.Добавить("  - " + МакетМД.Имя + " : " + ТипМакета);
	КонецЦикла;

	// Как ищет run_report — жёстко по имени ОсновнаяСхемаКомпоновкиДанных.
	ЕстьОсновная = (МД.Макеты.Найти("ОсновнаяСхемаКомпоновкиДанных") <> Неопределено);
	Строки.Добавить("  Есть макет 'ОсновнаяСхемаКомпоновкиДанных': " + ?(ЕстьОсновная, "да", "НЕТ"));
	Строки.Добавить("  Есть хоть одна СКД среди макетов: " + ?(ЕстьСКД, "да", "нет"));
	// Ключевой признак — свойство ОсновнаяСхемаКомпоновкиДанных объекта метаданных.
	Строки.Добавить("  Свойство МД.ОсновнаяСхемаКомпоновкиДанных заполнено: " + ?(ОтчётНаСКД(МД), "да", "НЕТ"));
	// Как ведёт себя ПолучитьМакет (то, что использует run_report).
	Попытка
		МакетRR = МД.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		Строки.Добавить("  ПолучитьМакет('ОсновнаяСхемаКомпоновкиДанных'): " + Строка(ТипЗнч(МакетRR)));
	Исключение
		Строки.Добавить("  ПолучитьМакет('ОсновнаяСхемаКомпоновкиДанных'): ИСКЛЮЧЕНИЕ: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Проверить один способ разыменования и сравнить результат с эталонной ссылкой.
// Возвращает строку "<Метка>: OK | НЕ СОВПАЛО | Неопределено | Исключение: ...".
//
Функция ПроверитьRoundTrip(Знач Метка, Знач ЭталоннаяСсылка, Знач Параметры, Знач ИмяТипа = "")

	Попытка
		Результат = Неопределено;

		Если Параметры.Режим = "утилита" Тогда
			Результат = ar_Утилиты.ОбъектИзНавигационнойСсылки(Параметры.Аргумент);

		ИначеЕсли Параметры.Режим = "xml_flat" Или Параметры.Режим = "xml_uuid" Тогда
			ИмяТипаСсылки = "СправочникСсылка." + СтрРазделить(ЭталоннаяСсылка.Метаданные().ПолноеИмя(), ".")[1];
			Результат = XMLЗначение(Тип(ИмяТипаСсылки), Параметры.Аргумент);

		ИначеЕсли Параметры.Режим = "менеджер" Тогда
			ИмяСправочника = СтрРазделить(ИмяТипа, ".")[1];
			Менеджер = Справочники[ИмяСправочника];
			Результат = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Параметры.Аргумент));
		КонецЕсли;

		Если Результат = Неопределено Тогда
			Возврат Метка + ": Неопределено";
		КонецЕсли;

		Если Результат = ЭталоннаяСсылка Тогда
			Возврат Метка + ": OK (совпало с эталоном)";
		КонецЕсли;

		// Ссылка построена, но указывает на другой/несуществующий объект.
		Существует = НЕ Результат.ПолучитьОбъект() = Неопределено;
		Возврат Метка + ": НЕ СОВПАЛО (существует=" + ?(Существует, "да", "нет")
			+ ", ссылка=" + Строка(Результат.УникальныйИдентификатор()) + ")";

	Исключение
		Возврат Метка + ": Исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Безопасное чтение значения Соответствия по ключу.
Функция ЗначениеСоответствия(Знач Соответствие, Знач Ключ)
	Если ТипЗнч(Соответствие) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Соответствие.Получить(Ключ);
КонецФункции

// Безопасное чтение значения Структуры по ключу с дефолтом.
Функция ЗначениеСтруктуры(Знач Структура, Знач Ключ, Знач Дефолт)
	Значение = Дефолт;
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		Структура.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

#КонецОбласти
