////////////////////////////////////////////////////////////////////////////////
// Форма обработки ar_ТестТулов (Tool Test Harness).
//
// Загружает список включённых tools, для каждого генерирует пример аргументов
// из JSON-схемы манифеста, вызывает через ar_ИнструментыДиспетчер (боевой режим) и
// собирает результаты. Упавшие tools ({"error":...}) сводятся в текстовый отчёт
// для передачи разработчику.
//
// Вся серверная логика — в модуле объекта ar_ТестТулов; форма лишь оркеструет.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуИнструменты();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТаблицаРезультатовПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРезультатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ТекущееНаблюдение = "";
	Иначе
		ТекущееНаблюдение = ТекущиеДанные.Наблюдение;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьИнструменты(Команда)
	СводкаСреды = ЗаполнитьТаблицуИнструменты();
	ПоказатьПредупреждение(, СтрШаблон(
		НСтр("ru = 'Загружено tools: %1.
		|%2
		|Недоступные (ar_Доступен = Ложь) исключены из прогона по умолчанию — включи галкой, чтобы прогнать осознанно.';
		|en = 'Tools loaded: %1.
		|%2
		|Unavailable tools are excluded from the run by default.'"),
		ТаблицаИнструменты.Количество(), СводкаСреды));
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАргументыАвто(Команда)
	ЗаполнитьАргументыАвтоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВыбранные(Команда)
	ВыполнитьТесты(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВсе(Команда)
	ВыполнитьТесты(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ДиагностикаНавСсылки(Команда)
	ОтчётПоОшибкам = ДиагностикаНавСсылкиНаСервере();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОтчёт;
КонецПроцедуры

&НаКлиенте
Процедура НастроитьМаппинг(Команда)
	Результат = НастроитьМаппингНаСервере();
	ОтчётПоОшибкам = Результат;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОтчёт;
	ПоказатьПредупреждение(,
		НСтр("ru = 'Маппинг демо-объектов настроен. Перезаполните аргументы и запустите тесты.';
		|en = 'Demo object mapping configured. Refill arguments and run tests.'"));
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьОтчёт(Команда)
	СформироватьОтчётНаСервере();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОтчёт;
	Если ПустаяСтрока(ОтчётПоОшибкам) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Ошибок не обнаружено — отчёт пуст.'; en = 'No errors found — report is empty.'"));
	Иначе
		ПоказатьПредупреждение(,
			НСтр("ru = 'Отчёт по ошибкам сформирован на вкладке «Отчёт по ошибкам». Скопируйте текст поля.';
			|en = 'Error report is ready on the «Error report» tab. Copy the field text.'"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьТесты(Знач ТолькоВыбранные)
	Если ТаблицаИнструменты.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Сначала загрузите tools.'; en = 'Load tools first.'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Выполнение tools…'; en = 'Running tools…'"));
	ИтогиТекст = ВыполнитьТестыНаСервере(ТолькоВыбранные);
	Состояние();

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРезультаты;
	ПоказатьПредупреждение(, ИтогиТекст);
КонецПроцедуры

&НаСервере
Функция ДиагностикаНавСсылкиНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ДиагностикаНавигационнойСсылки();
КонецФункции

&НаСервере
Функция НастроитьМаппингНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.НастроитьМаппингДемо();
КонецФункции

&НаСервере
Функция ЗаполнитьТаблицуИнструменты()
	Обработка = РеквизитФормыВЗначение("Объект");

	// UNIV-01/UNIV-03: профиль конфигурации + пересчёт ar_Доступен ДО чтения
	// списка — таблица показывает актуальную доступность.
	СводкаСреды = Обработка.ПодготовитьСреду();

	СписокTools = Обработка.СобратьTools();

	ТаблицаИнструменты.Очистить();
	Для Каждого Элемент Из СписокTools Цикл
		Строка = ТаблицаИнструменты.Добавить();
		// Недоступные (UNIV-03) по умолчанию не прогоняются — LLM их тоже не
		// видит; галку можно включить вручную для осознанного теста.
		Строка.Выполнять            = Элемент.Доступен;
		Строка.Имя                  = Элемент.Имя;
		Строка.Модуль               = Элемент.Модуль;
		Строка.Процедура            = Элемент.Процедура;
		Строка.УровеньРиска         = Элемент.RiskLevel;
		Строка.ТребуетПодтверждения = Элемент.ТребуетApproval;
		Строка.Доступен             = Элемент.Доступен;
		Строка.ПричинаНедоступности = Элемент.ПричинаНедоступности;
		Строка.JSONМанифест         = Элемент.JSONManifest;
		Строка.JSONАргументы        = Обработка.АргументыДляTool(Элемент.Имя, Элемент.JSONManifest);
	КонецЦикла;

	Возврат СводкаСреды;
КонецФункции

&НаСервере
Процедура ЗаполнитьАргументыАвтоНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Строка Из ТаблицаИнструменты Цикл
		Строка.JSONАргументы = Обработка.АргументыДляTool(Строка.Имя, Строка.JSONМанифест);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ВыполнитьТестыНаСервере(Знач ТолькоВыбранные)
	Обработка = РеквизитФормыВЗначение("Объект");

	ТаблицаРезультатов.Очистить();
	ТекущееНаблюдение = "";

	Всего   = 0;
	Успешно = 0;
	Ошибок  = 0;

	Для Каждого СтрокаTool Из ТаблицаИнструменты Цикл
		Если ТолькоВыбранные И НЕ СтрокаTool.Выполнять Тогда
			Продолжить;
		КонецЕсли;

		Всего = Всего + 1;
		РезультатТеста = Обработка.ВыполнитьТест(СтрокаTool.Имя, СтрокаTool.JSONАргументы);

		СтрокаРез = ТаблицаРезультатов.Добавить();
		СтрокаРез.Имя           = СтрокаTool.Имя;
		СтрокаРез.Успех         = РезультатТеста.Успех;
		// Для tools с ar_Доступен = Ложь (скрыты от LLM, UNIV-03) ошибка ожидаема —
		// помечаем статус, чтобы в отчёте не смешивать с реальными багами.
		Если СтрокаTool.Доступен Тогда
			СтрокаРез.Статус = ?(РезультатТеста.Успех,
				НСтр("ru = 'OK'; en = 'OK'"), НСтр("ru = 'ОШИБКА'; en = 'ERROR'"));
		Иначе
			СтрокаРез.Статус = ?(РезультатТеста.Успех,
				НСтр("ru = 'OK (недоступен)'; en = 'OK (unavailable)'"),
				НСтр("ru = 'ОШИБКА (недоступен, скрыт от LLM)'; en = 'ERROR (unavailable, hidden from LLM)'"));
		КонецЕсли;
		СтрокаРез.УровеньРиска  = РезультатТеста.RiskLevel;
		СтрокаРез.ТекстОшибки   = РезультатТеста.ТекстОшибки;
		СтрокаРез.Наблюдение    = РезультатТеста.Observation;
		СтрокаРез.JSONАргументы  = СтрокаTool.JSONАргументы;

		Если РезультатТеста.Успех Тогда
			Успешно = Успешно + 1;
		Иначе
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	СформироватьОтчётНаСервере();

	Возврат СтрШаблон(
		НСтр("ru = 'Выполнено: %1. Успешно: %2. С ошибками: %3.';
		|en = 'Executed: %1. Success: %2. Errors: %3.'"),
		Всего, Успешно, Ошибок);
КонецФункции

&НаСервере
Процедура СформироватьОтчётНаСервере()
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(
		НСтр("ru = 'Отчёт по ошибкам tools (%1)'; en = 'Tool errors report (%1)'"),
		Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")));
	Строки.Добавить("=====================================");

	Ошибок = 0;
	Для Каждого СтрокаРез Из ТаблицаРезультатов Цикл
		Если СтрокаРез.Успех Тогда
			Продолжить;
		КонецЕсли;
		Ошибок = Ошибок + 1;
		Строки.Добавить("");
		// Статус содержит пометку «недоступен» для tools, скрытых от LLM (UNIV-03).
		Строки.Добавить(СтрШаблон(НСтр("ru = '%1. Tool: %2 [%3]'; en = '%1. Tool: %2 [%3]'"),
			Ошибок, СтрокаРез.Имя, СтрокаРез.Статус));
		Строки.Добавить(СтрШаблон(НСтр("ru = '   Аргументы:   %1'; en = '   Arguments:   %1'"), СтрокаРез.JSONАргументы));
		Строки.Добавить(СтрШаблон(НСтр("ru = '   Ошибка:      %1'; en = '   Error:       %1'"), СтрокаРез.ТекстОшибки));
		Строки.Добавить(СтрШаблон(НСтр("ru = '   Observation: %1'; en = '   Observation: %1'"), СтрокаРез.Наблюдение));
	КонецЦикла;

	Если Ошибок = 0 Тогда
		ОтчётПоОшибкам = "";
	Иначе
		ОтчётПоОшибкам = СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
