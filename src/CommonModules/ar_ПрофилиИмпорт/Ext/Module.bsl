////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПрофилиИмпорт (UNIV-04).
//
// Импорт/экспорт профилей маппинга - штатный канал доставки имён объектов и
// реквизитов целевой конфигурации (БП/УТ/ERP) в регистры UNIV-01/UNIV-02
// (ar_ПереопределенияОбъектов, ar_ПрофильКонфигурации) без хардкода этих имён
// в BSL-код (см. решение Tasks.md UNIV-02: "имена УТ 11 / ERP 2 в код не
// вносятся" - относится к исполняемому коду, не к данным профиля).
//
// Формат JSON профиля (kind = "mapping_profile", profile_version = 1):
//   { "kind": "mapping_profile", "profile_version": 1, "profile": "БП 3.0",
//     "verified": true|false,
//     "configuration": {"name": "...", "version_min": "..."},
//     "objects": {"<ЛогическоеИмя>": "<ИмяВМетаданных>", ...},
//     "attributes": {"<Ключ>": "<Значение>", ...} }
//
// "verified" - чисто информационное UI-поле (см. докстринг Импортировать) -
// не влияет на строгость валидации: каждое имя проверяется одинаково
// независимо от значения этого поля.
//
// Модуль НЕ переиспользует ar_ПресетыИмпорт (другой домен - ar_Агенты/tools/
// skills, другой JSON-контракт kind="agent_preset") - следует тому же каркасу
// (единое ядро, Результат-структура без исключений наружу, транзакция), но
// имеет собственный kind="mapping_profile" и собственную валидацию.
//
// Границы (см. .docs/specs/UNIV-04.md, раздел "Границы: что НЕ входит"):
//   - не читает/не пишет ar_Адаптеры (UNIV-06) - выбор адаптера заполнения
//     не зависит от применённого профиля маппинга;
//   - не переносит ar_ТребуемыеОбъекты/ar_ПоддерживаемыеКонфигурации (UNIV-03);
//   - принимает любой валидный текст (не только три встроенных заготовки) -
//     механизм пригоден и для community-обмена профилями.
//
// Публичный интерфейс:
//   Импортировать(ТекстJSON)  - Структура (см. НовыйРезультатИмпорта).
//   Экспортировать()          - Строка (JSON текущих настроек профиля).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь -
// запись в ar_ПереопределенияОбъектов/ar_ПрофильКонфигурации не требует
// привилегий (симметрично ar_ПрофильКонфигурации.Установить, ar_ПресетыИмпорт).
//
// Запрещено: Выполнить(), Вычислить().
// См. спеку: .docs/specs/UNIV-04.md
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Импортирует профиль маппинга из текста JSON в регистры
// ar_ПереопределенияОбъектов (objects) и ar_ПрофильКонфигурации (attributes).
// Не пробрасывает исключений наружу - все внутренние ошибки конвертируются
// в результат. Операция выполняется от имени текущего пользователя: при
// недостаточных правах запись завершится ошибкой => Успех = Ложь,
// Причина = "access_denied".
//
// Импорт профиля - явное целенаправленное действие администратора: в отличие
// от ar_ПрофильКонфигурации.ЗаполнитьАвтоматически(), значения ПЕРЕЗАПИСЫВАЮТ
// записи с текущим ar_Источник = "manual" (не использует
// УстановитьЕслиНеРучной) - список перезаписанных ключей возвращается в
// Результат.ПерезаписаныеРучные для постфактум-уведомления пользователя
// (не блокировки).
//
// Недоверенный ввод - см. .docs/specs/UNIV-04.md, раздел 7, восемь проверок
// выполняются до любой записи в регистры: размер текста, типизация верхнего
// уровня, лимит числа пар, длины значений (отбрасываются, не обрезаются),
// SEC-TOOL-01 defense-in-depth guard, транзакция, права пользователя.
//
// Параметры:
//   ТекстJSON - Строка - сырой текст JSON профиля маппинга.
//
// Возвращаемое значение:
//   Структура - с ключами:
//     * Успех                - Булево
//     * ОбъектовПрименено    - Число (записей objects успешно записано)
//     * АтрибутовПрименено   - Число (записей attributes успешно записано)
//     * НеНайденныеОбъекты   - Массив строк ("<ЛогическоеИмя>:<ИмяВМетаданных>")
//     * НеНайденныеАтрибуты  - Массив строк ("<Ключ>:<Значение>")
//     * ПерезаписаныеРучные  - Массив строк (ключи attributes, у которых
//                              ar_Источник до импорта был "manual")
//     * Причина              - Строка ("invalid_json","wrong_kind",
//                               "unsupported_version","profile_too_large",
//                               "reserved_key_forbidden","access_denied","error")
//     * Сообщение            - Строка (человекочитаемая сводка для UI)
//
Функция Импортировать(Знач ТекстJSON) Экспорт

	Результат = НовыйРезультатИмпорта();

	// 1. Размер текста JSON (недоверенный ввод, проверка 1) - до парсинга.
	Если ТипЗнч(ТекстJSON) <> Тип("Строка") Тогда
		Результат.Причина = КодОшибкиНекорректныйJSON();
		Возврат Результат;
	КонецЕсли;

	Если СтрДлина(ТекстJSON) > МаксимальныйРазмерJSON() Тогда
		Результат.Причина = "profile_too_large";
		Результат.Сообщение = НСтр("ru = 'Текст профиля превышает допустимый размер'; en = 'Profile text exceeds allowed size'");
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		Результат.Причина = КодОшибкиНекорректныйJSON();
		Возврат Результат;
	КонецЕсли;

	// 2. Десериализация. ar_JSON.ИзJSON не бросает исключений по контракту -
	// любая ошибка парсера возвращает Неопределено (см. докстринг ar_JSON.ИзJSON).
	Данные = ar_JSON.ИзJSON(ТекстJSON);
	Если Данные = Неопределено Тогда
		Результат.Причина = КодОшибкиНекорректныйJSON();
		Возврат Результат;
	КонецЕсли;

	// 3. Валидация структуры верхнего уровня (проверки 2, 6).
	ОшибкаВалидации = ВалидироватьСтруктуруПрофиля(Данные);
	Если Не ПустаяСтрока(ОшибкаВалидации) Тогда
		Результат.Причина = ОшибкаВалидации;
		Возврат Результат;
	КонецЕсли;

	БлокОбъектов = ПолучитьСоответствиеИлиПусто(Данные, "objects");
	БлокАтрибутов = ПолучитьСоответствиеИлиПусто(Данные, "attributes");

	БылиНепустыеСекции = (БлокОбъектов.Количество() > 0) Или (БлокАтрибутов.Количество() > 0);

	// 4-7. Применение objects/attributes в одной транзакции (проверка 7).
	НачатьТранзакцию();
	Попытка

		ПрименитьObjects(БлокОбъектов, Результат);
		ПрименитьAttributes(БлокАтрибутов, БлокОбъектов, Результат);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		Если СтрНайти(НРег(ТекстОшибки), "доступ") > 0
			Или СтрНайти(НРег(ТекстОшибки), "право") > 0
			Или СтрНайти(НРег(ТекстОшибки), "недостаточно") > 0 Тогда
			Результат.Причина = "access_denied";
		Иначе
			Результат.Причина = "error";
		КонецЕсли;
		ar_СлужебныйЛог.Записать(
			"ar_ПрофилиИмпорт.Импортировать",
			"mapping_profile_import_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Ошибка");
		Возврат Результат;
	КонецПопытки;

	// Успех = Истина если хотя бы одна пара применена, либо секции изначально
	// пустые (пустой валидный профиль - не ошибка). Если секции были непустые,
	// но ни одна пара не применилась - сигнал "профиль не подходит для базы".
	Если Не БылиНепустыеСекции Тогда
		Результат.Успех = Истина;
	ИначеЕсли (Результат.ОбъектовПрименено > 0) Или (Результат.АтрибутовПрименено > 0) Тогда
		Результат.Успех = Истина;
	Иначе
		Результат.Успех = Ложь;
	КонецЕсли;

	Результат.Сообщение = СформироватьСообщениеРезультата(Результат);

	Возврат Результат;

КонецФункции

// Экспортирует текущие настройки профиля (ar_ПереопределенияОбъектов целиком +
// ar_ПрофильКонфигурации с доменными ключами и ar_Источник ∈ {"manual","preset"})
// в текст JSON того же формата, что и Импортировать() принимает - для
// round-trip и community-обмена профилями между внедренцами.
//
// "auto"-записи ar_ПрофильКонфигурации (результат ЗаполнитьАвтоматически() на
// текущей базе) намеренно исключаются - экспорт auto-значений на другую базу
// либо бессмысленен (та же авто-функция даст тот же результат без импорта),
// либо вреден (заблокирует локальное автозаполнение получателя, см.
// .docs/specs/UNIV-04.md, раздел "Round-trip: что именно экспортируется").
// Служебные ключи "configuration.*" не входят в экспорт - они про
// идентификацию источника, не про маппинг.
//
// Возвращаемое значение:
//   Строка - текст JSON профиля (kind="mapping_profile"). Не бросает исключений -
//            при внутренней ошибке возвращает пустую строку.
//
Функция Экспортировать() Экспорт

	Попытка

		Результат = Новый Соответствие;
		Результат.Вставить("kind", "mapping_profile");
		Результат.Вставить("profile_version", 1);
		Результат.Вставить("profile", НСтр("ru = 'Экспорт'; en = 'Export'"));
		Результат.Вставить("verified", Истина);
		Результат.Вставить("configuration", Новый Соответствие);

		Результат.Вставить("objects", ЭкспортироватьObjects());
		Результат.Вставить("attributes", ЭкспортироватьAttributes());

		Возврат ar_JSON.ВЗначениеJSON(Результат);

	Исключение
		ar_СлужебныйЛог.Записать(
			"ar_ПрофилиИмпорт.Экспортировать",
			"mapping_profile_export_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение");
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Код ошибки для некорректного/неразбираемого JSON - единая точка, чтобы не
// дублировать строковый литерал "invalid_json" по модулю (DuplicateStringLiteral).
//
// Возвращаемое значение:
//   Строка
//
Функция КодОшибкиНекорректныйJSON()
	Возврат "invalid_json";
КонецФункции

// Единственная поддерживаемая версия формата профиля на сегодня. Отдельная
// именованная константа (не литерал "1" в сравнении) - см. комментарий
// в ВалидироватьСтруктуруПрофиля.
//
// Возвращаемое значение:
//   Число
//
Функция ТекущаяВерсияПрофиля()
	Возврат 1;
КонецФункции

// Максимальный допустимый размер текста JSON профиля в символах (недоверенный
// ввод, проверка 1: типовой профиль - единицы КБ, лимит на два порядка больше
// защищает от DoS через раздутый JSON без блокировки легитимных профилей).
//
// Возвращаемое значение:
//   Число
//
Функция МаксимальныйРазмерJSON()
	Возврат 200000;
КонецФункции

// Максимальное число пар в каждой из секций objects/attributes (недоверенный
// ввод, проверка 3). Легитимный профиль содержит десятки пар.
//
// Возвращаемое значение:
//   Число
//
Функция МаксимальноеЧислоПар()
	Возврат 200;
КонецФункции

// Максимальная длина ключа objects (ar_ЛогическоеИмя) и attributes-значения
// (ar_ИмяВМетаданных) - точное совпадение с длиной ресурсов регистра
// ar_ПереопределенияОбъектов (Строка(150) для обоих полей).
//
// Возвращаемое значение:
//   Число
//
Функция МаксимальнаяДлинаИмениОбъекта()
	Возврат 150;
КонецФункции

// Максимальная длина ключа attributes (ar_Ключ) - точное совпадение с длиной
// измерения ar_Ключ регистра ar_ПрофильКонфигурации (Строка(100)).
//
// Возвращаемое значение:
//   Число
//
Функция МаксимальнаяДлинаКлючаАтрибута()
	Возврат 100;
КонецФункции

// Максимальная длина значения attributes (ar_Значение) - точное совпадение
// с длиной ресурса ar_Значение регистра ar_ПрофильКонфигурации (Строка(200)).
//
// Возвращаемое значение:
//   Число
//
Функция МаксимальнаяДлинаЗначенияАтрибута()
	Возврат 200;
КонецФункции

// Whitelist допустимых доменных префиксов ключей attributes (см.
// .docs/specs/UNIV-04.md, раздел "Точный алгоритм", пункт 6) - принадлежит
// коду UNIV-02, не данным, поэтому список констант в теле модуля, не регистр.
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция ДопустимыеПрефиксыАтрибутов()
	Результат = Новый Массив;
	Результат.Добавить("invoice.");
	Результат.Добавить("client.");
	Возврат Результат;
КонецФункции

// Таблица соответствия "префикс ключа attributes -> логическое имя объекта
// objects, на котором проверяется наличие реквизита". Константа в теле
// модуля (см. .docs/specs/UNIV-04.md, раздел "Точный алгоритм", пункт 6,
// риск 5 - известное ограничение, расширяется вручную при появлении новых
// доменных префиксов).
//
// Возвращаемое значение:
//   Соответствие - Строка(префикс) -> Строка(логическое имя объекта).
//
Функция ЛогическоеИмяОбъектаПоПрефиксу()
	Результат = Новый Соответствие;
	Результат.Вставить("invoice.", "СчетНаОплатуПокупателю");
	Результат.Вставить("client.", "Контрагенты");
	Возврат Результат;
КонецФункции

// Классы метаданных, применимые к tool-слою для проверки objects (см.
// .docs/specs/UNIV-04.md, раздел "Точный алгоритм", пункт 5).
//
// Параметры:
//   ИмяВМетаданных - Строка - имя объекта метаданных для поиска.
//
// Возвращаемое значение:
//   Булево - Истина, если объект с таким именем найден среди Справочников,
//            Документов, РегистровСведений или РегистровНакопления.
//
Функция ОбъектМетаданныхСуществует(Знач ИмяВМетаданных)

	Если Метаданные.Справочники.Найти(ИмяВМетаданных) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.Документы.Найти(ИмяВМетаданных) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.РегистрыСведений.Найти(ИмяВМетаданных) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти(ИмяВМетаданных) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Проверяет наличие конкретного реквизита на объекте метаданных по его имени
// в метаданных (перебор классов - Справочники/Документы/РегистрыСведений/
// РегистрыНакопления, тот же набор, что ОбъектМетаданныхСуществует).
//
// Ищет не только в Реквизитах: значением пары attributes может быть табличная
// часть (ключи вида "*_table" - например invoice.items_table = "Товары") либо
// измерение/ресурс регистра. Коллекции ТабличныеЧасти/Измерения/Ресурсы есть
// не у всех классов метаданных, поэтому наличие коллекции проверяется до
// обращения к ней.
//
// Параметры:
//   ИмяОбъекта    - Строка - имя объекта метаданных.
//   ИмяРеквизита  - Строка - имя реквизита/табличной части/ресурса/измерения.
//
// Возвращаемое значение:
//   Булево
//
Функция РеквизитОбъектаСуществует(Знач ИмяОбъекта, Знач ИмяРеквизита)

	Если ПустаяСтрока(ИмяОбъекта) Или ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат Ложь;
	КонецЕсли;

	МД = Метаданные.Справочники.Найти(ИмяОбъекта);
	Если МД = Неопределено Тогда
		МД = Метаданные.Документы.Найти(ИмяОбъекта);
	КонецЕсли;
	Если МД = Неопределено Тогда
		МД = Метаданные.РегистрыСведений.Найти(ИмяОбъекта);
	КонецЕсли;
	Если МД = Неопределено Тогда
		МД = Метаданные.РегистрыНакопления.Найти(ИмяОбъекта);
	КонецЕсли;
	Если МД = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если МД.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// Наличие коллекции проверяется по самому объекту метаданных, а не по классу,
	// в котором он найден - обращение к отсутствующей коллекции вызвало бы
	// исключение (у регистров нет ТабличныеЧасти, у справочников - Измерения).
	Если ЕстьКоллекцияМетаданных(МД, "Измерения")
		И МД.Измерения.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЕстьКоллекцияМетаданных(МД, "Ресурсы")
		И МД.Ресурсы.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЕстьКоллекцияМетаданных(МД, "ТабличныеЧасти")
		И МД.ТабличныеЧасти.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверяет, есть ли у объекта метаданных коллекция с указанным именем
// (Измерения/Ресурсы/ТабличныеЧасти есть не у всех классов метаданных, а
// обращение к отсутствующей коллекции вызывает исключение).
//
// Параметры:
//   МД          - ОбъектМетаданных - проверяемый объект.
//   ИмяСвойства - Строка - имя коллекции ("Измерения", "ТабличныеЧасти", ...).
//
// Возвращаемое значение:
//   Булево
//
Функция ЕстьКоллекцияМетаданных(Знач МД, Знач ИмяСвойства)

	Попытка
		Возврат МД[ИмяСвойства] <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Проверяет структуру JSON-профиля на корректность (недоверенный ввод,
// проверки 2, 6). Не проверяет содержимое пар objects/attributes - это
// делают ПрименитьObjects/ПрименитьAttributes при записи.
//
// Параметры:
//   Данные - Соответствие - разобранный JSON (корень).
//
// Возвращаемое значение:
//   Строка - код ошибки или "" если структура корректна.
//
Функция ВалидироватьСтруктуруПрофиля(Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат КодОшибкиНекорректныйJSON();
	КонецЕсли;

	КлючKind = Данные.Получить("kind");
	Если КлючKind <> "mapping_profile" Тогда
		Если КлючKind = Неопределено Тогда
			Возврат КодОшибкиНекорректныйJSON();
		КонецЕсли;
		Возврат "wrong_kind";
	КонецЕсли;

	Версия = Данные.Получить("profile_version");
	Если ТипЗнч(Версия) <> Тип("Число") Тогда
		Возврат КодОшибкиНекорректныйJSON();
	КонецЕсли;
	// Единственная поддерживаемая версия формата сейчас - 1. Сравнение ">1"
	// (не "<>1") намеренно допускает будущее расширение вверх по числу без
	// немедленной правки этой функции - только по ТекущаяВерсияПрофиля() ниже.
	Если Версия > ТекущаяВерсияПрофиля() Тогда
		Возврат "unsupported_version";
	КонецЕсли;

	// objects/attributes - строго Тип("Соответствие") либо отсутствуют.
	Если Не ТипСоответствиеИлиОтсутствует(Данные, "objects") Тогда
		Возврат КодОшибкиНекорректныйJSON();
	КонецЕсли;
	Если Не ТипСоответствиеИлиОтсутствует(Данные, "attributes") Тогда
		Возврат КодОшибкиНекорректныйJSON();
	КонецЕсли;

	// SEC-TOOL-01 defense-in-depth guard (недоверенный ввод, проверка 6) -
	// см. докстринг ЕстьЗапрещённыйКлюч.
	Если ЕстьЗапрещённыйКлюч(Данные) Тогда
		Возврат "reserved_key_forbidden";
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет, что значение по ключу либо отсутствует, либо имеет
// Тип("Соответствие") - используется для objects/attributes верхнего уровня.
//
// Параметры:
//   Данные - Соответствие
//   Ключ   - Строка
//
// Возвращаемое значение:
//   Булево
//
Функция ТипСоответствиеИлиОтсутствует(Знач Данные, Знач Ключ)

	Значение = Данные.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ТипЗнч(Значение) = Тип("Соответствие");

КонецФункции

// Возвращает значение по ключу как Соответствие, либо пустое Соответствие,
// если ключ отсутствует/имеет иной тип (структура уже провалидирована
// ВалидироватьСтруктуруПрофиля до вызова этой функции).
//
// Параметры:
//   Данные - Соответствие
//   Ключ   - Строка
//
// Возвращаемое значение:
//   Соответствие
//
Функция ПолучитьСоответствиеИлиПусто(Знач Данные, Знач Ключ)

	Значение = Данные.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Новый Соответствие;

КонецФункции

// SEC-TOOL-01 defense-in-depth guard: рекурсивно проверяет всю структуру JSON
// (верхний уровень и вложенные Соответствия) на присутствие ключа
// "code_implementation" или "ar_КодРеализации" с непустым строковым значением.
// Формат профиля структурно не может нести исполняемый код (только плоские
// строки в objects/attributes), но ключи Соответствий objects/attributes
// берутся из пользовательского JSON без ограничения на состав - теоретически
// ключ objects мог бы называться "code_implementation". Guard превентивный,
// не потому что доказан реальный вектор исполнения (значение всё равно
// проходит только Метаданные.*.Найти(), никогда не исполняется) - см.
// .docs/specs/UNIV-04.md, раздел 7, проверка 6, и паттерн
// ar_ПресетыИмпорт.ar_ПресетСодержитЗапрещенныйКодTool.
//
// Параметры:
//   Данные - Соответствие - разобранный JSON (корень или вложенный узел).
//
// Возвращаемое значение:
//   Булево - Истина, если запрещённый ключ найден где бы то ни было.
//
Функция ЕстьЗапрещённыйКлюч(Знач Данные)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из Данные Цикл
		Ключ = Элемент.Ключ;
		Значение = Элемент.Значение;

		Если (Ключ = "code_implementation" Или Ключ = "ar_КодРеализации")
			И ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
			Возврат Истина;
		КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Если ЕстьЗапрещённыйКлюч(Значение) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Применяет пары objects[ЛогическоеИмя] = ИмяВМетаданных в регистр
// ar_ПереопределенияОбъектов. Первый программный писатель этого регистра
// (ранее - только через форму записи) - обязателен канонический порядок
// присвоения измерения ДО и ПОСЛЕ Прочитать() (project_empty_ref_dimension_bug,
// см. ar_ПрофильКонфигурации.Установить).
//
// Параметры:
//   БлокОбъектов - Соответствие - секция "objects" разобранного JSON.
//   Результат   - Структура - накапливает ОбъектовПрименено, НеНайденныеОбъекты.
//
Процедура ПрименитьObjects(Знач БлокОбъектов, Результат)

	Счётчик = 0;
	Для Каждого Элемент Из БлокОбъектов Цикл

		Если Счётчик >= МаксимальноеЧислоПар() Тогда
			ar_СлужебныйЛог.Записать(
				"ar_ПрофилиИмпорт.ПрименитьObjects",
				"mapping_profile_truncated_by_limit",
				"Число пар objects превышает лимит - лишние пары отброшены",
				"Предупреждение");
			Прервать;
		КонецЕсли;
		Счётчик = Счётчик + 1;

		ЛогическоеИмя = Элемент.Ключ;
		ИмяВМетаданных = Элемент.Значение;

		// Проверка 5: тип значения - только Строка.
		Если ТипЗнч(ЛогическоеИмя) <> Тип("Строка") Или ТипЗнч(ИмяВМетаданных) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;

		// Проверка 4: длины (отбрасываем, не обрезаем).
		Если СтрДлина(ЛогическоеИмя) > МаксимальнаяДлинаИмениОбъекта()
			Или СтрДлина(ИмяВМетаданных) > МаксимальнаяДлинаИмениОбъекта() Тогда
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(ЛогическоеИмя) Или ПустаяСтрока(ИмяВМетаданных) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ОбъектМетаданныхСуществует(ИмяВМетаданных) Тогда
			Результат.НеНайденныеОбъекты.Добавить(ЛогическоеИмя + ":" + ИмяВМетаданных);
			Продолжить;
		КонецЕсли;

		МенеджерЗаписи = РегистрыСведений.ar_ПереопределенияОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_ЛогическоеИмя = ЛогическоеИмя;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.ar_ЛогическоеИмя = ЛогическоеИмя; // Переустановка ОБЯЗАТЕЛЬНА - см. докстринг процедуры.
		МенеджерЗаписи.ar_ИмяВМетаданных = ИмяВМетаданных;
		МенеджерЗаписи.Записать(Истина);

		Результат.ОбъектовПрименено = Результат.ОбъектовПрименено + 1;

	КонецЦикла;

КонецПроцедуры

// Применяет пары attributes[Ключ] = Значение в регистр ar_ПрофильКонфигурации
// (Источник = "preset", всегда - через ar_ПрофильКонфигурации.Установить).
// Валидация наличия реквизита выводит целевой объект из уже применённых
// записей objects этого же импорта по whitelist-таблице префиксов; при
// отсутствии соответствующей записи - fallback через
// ar_ToolDispatcher.ИмяОбъектаМетаданных с тем же логическим именем и
// дефолтом (текущее фактическое переопределение или дефолт tool-модуля).
//
// Параметры:
//   БлокАтрибутов - Соответствие - секция "attributes" разобранного JSON.
//   БлокОбъектов    - Соответствие - секция "objects" того же JSON (для вывода
//                    целевого объекта проверки реквизита).
//   Результат      - Структура - накапливает АтрибутовПрименено,
//                    НеНайденныеАтрибуты, ПерезаписаныеРучные.
//
Процедура ПрименитьAttributes(Знач БлокАтрибутов, Знач БлокОбъектов, Результат)

	ДопустимыеПрефиксы = ДопустимыеПрефиксыАтрибутов();
	ТаблицаПрефиксов = ЛогическоеИмяОбъектаПоПрефиксу();

	Счётчик = 0;
	Для Каждого Элемент Из БлокАтрибутов Цикл

		Если Счётчик >= МаксимальноеЧислоПар() Тогда
			ar_СлужебныйЛог.Записать(
				"ar_ПрофилиИмпорт.ПрименитьAttributes",
				"mapping_profile_truncated_by_limit",
				"Число пар attributes превышает лимит - лишние пары отброшены",
				"Предупреждение");
			Прервать;
		КонецЕсли;
		Счётчик = Счётчик + 1;

		Ключ = Элемент.Ключ;
		Значение = Элемент.Значение;

		// Проверки 4-5 (тип, длина, непустота) вынесены в отдельную функцию -
		// снижение когнитивной сложности цикла (CognitiveComplexity).
		Если Не ПараАтрибутаКорректнаПоТипуИДлине(Ключ, Значение) Тогда
			Продолжить;
		КонецЕсли;

		// Whitelist доменных префиксов.
		Префикс = НайтиДопустимыйПрефикс(Ключ, ДопустимыеПрефиксы);
		Если Префикс = Неопределено Тогда
			Результат.НеНайденныеАтрибуты.Добавить(Ключ + ":" + Значение);
			Продолжить;
		КонецЕсли;

		ЛогическоеИмяОбъекта = ТаблицаПрефиксов.Получить(Префикс);
		ИмяОбъектаПроверки = ИмяОбъектаДляПроверкиРеквизита(ЛогическоеИмяОбъекта, БлокОбъектов);

		Если Не РеквизитОбъектаСуществует(ИмяОбъектаПроверки, Значение) Тогда
			Результат.НеНайденныеАтрибуты.Добавить(Ключ + ":" + Значение);
			Продолжить;
		КонецЕсли;

		Если ИсточникЗначенияАтрибута(Ключ) = "manual" Тогда
			Результат.ПерезаписаныеРучные.Добавить(Ключ);
		КонецЕсли;

		ar_ПрофильКонфигурации.Установить(Ключ, Значение, "preset");
		Результат.АтрибутовПрименено = Результат.АтрибутовПрименено + 1;

	КонецЦикла;

КонецПроцедуры

// Проверяет пару attributes[Ключ]=Значение по типу (Проверка 5: обе части
// строго Строка) и длине (Проверка 4: в пределах длин ресурсов регистра
// ar_ПрофильКонфигурации, отбрасываем - не обрезаем) - вынесено из
// ПрименитьAttributes для снижения когнитивной сложности цикла.
//
// Параметры:
//   Ключ      - Произвольный - "ключ" пары attributes из JSON (ожидается Строка).
//   Значение  - Произвольный - "значение" пары attributes из JSON (ожидается Строка).
//
// Возвращаемое значение:
//   Булево - Истина, если пара корректна по типу/длине/непустоте.
//
Функция ПараАтрибутаКорректнаПоТипуИДлине(Знач Ключ, Знач Значение)

	Если ТипЗнч(Ключ) <> Тип("Строка") Или ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(Ключ) > МаксимальнаяДлинаКлючаАтрибута()
		Или СтрДлина(Значение) > МаксимальнаяДлинаЗначенияАтрибута() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(Ключ) Или ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Ищет доменный префикс ключа attributes среди допустимых (whitelist).
//
// Параметры:
//   Ключ                - Строка - ключ attributes (например "invoice.client_attribute").
//   ДопустимыеПрефиксы  - Массив из Строка.
//
// Возвращаемое значение:
//   Строка, Неопределено - найденный префикс или Неопределено.
//
Функция НайтиДопустимыйПрефикс(Знач Ключ, Знач ДопустимыеПрефиксы)

	Для Каждого Префикс Из ДопустимыеПрефиксы Цикл
		Если СтрНачинаетсяС(Ключ, Префикс) Тогда
			Возврат Префикс;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Определяет имя объекта метаданных, на котором нужно проверить наличие
// реквизита attributes-ключа: приоритет - запись objects этого же импорта,
// fallback - ar_ToolDispatcher.ИмяОбъектаМетаданных (текущее фактическое
// переопределение/дефолт tool-модуля), что не блокирует валидацию attributes
// отсутствием соответствующей строки в objects (см. .docs/specs/UNIV-04.md,
// раздел "Точный алгоритм", пункт 6).
//
// Параметры:
//   ЛогическоеИмя - Строка - логическое имя объекта ("СчетНаОплатуПокупателю"/"Контрагенты").
//   БлокОбъектов   - Соответствие - секция "objects" того же импортируемого JSON.
//
// Возвращаемое значение:
//   Строка - имя объекта метаданных для проверки Реквизиты.Найти().
//
Функция ИмяОбъектаДляПроверкиРеквизита(Знач ЛогическоеИмя, Знач БлокОбъектов)

	ИзБлокаОбъектов = БлокОбъектов.Получить(ЛогическоеИмя);
	Если ТипЗнч(ИзБлокаОбъектов) = Тип("Строка") И Не ПустаяСтрока(ИзБлокаОбъектов) Тогда
		Возврат ИзБлокаОбъектов;
	КонецЕсли;

	Возврат ar_ToolDispatcher.ИмяОбъектаМетаданных(ЛогическоеИмя, ЛогическоеИмя);

КонецФункции

// Возвращает текущее значение ar_Источник для ключа ar_ПрофильКонфигурации
// (используется только чтобы заполнить Результат.ПерезаписаныеРучные ПЕРЕД
// перезаписью значения - сам факт перезаписи manual-значений намеренный,
// см. докстринг ПрименитьAttributes/Импортировать).
//
// Параметры:
//   Ключ - Строка
//
// Возвращаемое значение:
//   Строка - "" если записи нет или чтение завершилось ошибкой.
//
Функция ИсточникЗначенияАтрибута(Знач Ключ)

	Попытка
		МенеджерЗаписи = РегистрыСведений.ar_ПрофильКонфигурации.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_Ключ = Ключ;
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			Возврат "";
		КонецЕсли;
		Возврат МенеджерЗаписи.ar_Источник;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Экспортирует весь регистр ar_ПереопределенияОбъектов в Соответствие
// "ЛогическоеИмя -> ИмяВМетаданных" (регистр не имеет ресурса ar_Источник -
// любая запись в нём уже осознанное действие, экспортируется целиком).
//
// Возвращаемое значение:
//   Соответствие
//
Функция ЭкспортироватьObjects()

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переопределения.ar_ЛогическоеИмя КАК ЛогическоеИмя,
	|	Переопределения.ar_ИмяВМетаданных КАК ИмяВМетаданных
	|ИЗ
	|	РегистрСведений.ar_ПереопределенияОбъектов КАК Переопределения";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ЛогическоеИмя, Выборка.ИмяВМетаданных);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Экспортирует записи ar_ПрофильКонфигурации с доменными ключами
// (invoice.*/client.*) и ar_Источник ∈ {"manual","preset"} в Соответствие
// "Ключ -> Значение". Служебные ключи "configuration.*" и записи с
// ar_Источник = "auto" намеренно исключены - см. докстринг Экспортировать().
//
// Возвращаемое значение:
//   Соответствие
//
Функция ЭкспортироватьAttributes()

	Результат = Новый Соответствие;
	ДопустимыеПрефиксы = ДопустимыеПрефиксыАтрибутов();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Профиль.ar_Ключ КАК Ключ,
	|	Профиль.ar_Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ar_ПрофильКонфигурации КАК Профиль
	|ГДЕ
	|	Профиль.ar_Источник В (""manual"", ""preset"")";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НайтиДопустимыйПрефикс(Выборка.Ключ, ДопустимыеПрефиксы) <> Неопределено Тогда
			Результат.Вставить(Выборка.Ключ, Выборка.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт заготовку результата импорта с пустыми полями.
//
// Возвращаемое значение:
//   Структура
//
Функция НовыйРезультатИмпорта()

	Рез = Новый Структура;
	Рез.Вставить("Успех", Ложь);
	Рез.Вставить("ОбъектовПрименено", 0);
	Рез.Вставить("АтрибутовПрименено", 0);
	Рез.Вставить("НеНайденныеОбъекты", Новый Массив);
	Рез.Вставить("НеНайденныеАтрибуты", Новый Массив);
	Рез.Вставить("ПерезаписаныеРучные", Новый Массив);
	Рез.Вставить("Причина", "");
	Рез.Вставить("Сообщение", "");
	Возврат Рез;

КонецФункции

// Формирует человекочитаемую сводку результата для UI (мастер настройки).
//
// Параметры:
//   Результат - Структура - см. НовыйРезультатИмпорта.
//
// Возвращаемое значение:
//   Строка
//
Функция СформироватьСообщениеРезультата(Знач Результат)

	Если Не Результат.Успех Тогда
		Возврат НСтр("ru = 'Профиль не подходит для этой базы - ни одна пара не применена'; en = 'Profile is not applicable to this base - no pair applied'");
	КонецЕсли;

	Части = Новый Массив;

	ТекстОбъектовПрименено = СтрШаблон(
		НСтр("ru = 'Применено объектов: %1'; en = 'Objects applied: %1'"), Результат.ОбъектовПрименено);
	Части.Добавить(ТекстОбъектовПрименено);

	ТекстАтрибутовПрименено = СтрШаблон(
		НСтр("ru = 'Применено атрибутов: %1'; en = 'Attributes applied: %1'"), Результат.АтрибутовПрименено);
	Части.Добавить(ТекстАтрибутовПрименено);

	Если Результат.НеНайденныеОбъекты.Количество() > 0 Тогда
		СписокНеНайденныхОбъектов = СтрСоединить(Результат.НеНайденныеОбъекты, ", ");
		ТекстНеНайденныхОбъектов = СтрШаблон(
			НСтр("ru = 'Не найдены объекты: %1'; en = 'Objects not found: %1'"), СписокНеНайденныхОбъектов);
		Части.Добавить(ТекстНеНайденныхОбъектов);
	КонецЕсли;

	Если Результат.НеНайденныеАтрибуты.Количество() > 0 Тогда
		СписокНеНайденныхАтрибутов = СтрСоединить(Результат.НеНайденныеАтрибуты, ", ");
		ТекстНеНайденныхАтрибутов = СтрШаблон(
			НСтр("ru = 'Не найдены атрибуты: %1'; en = 'Attributes not found: %1'"), СписокНеНайденныхАтрибутов);
		Части.Добавить(ТекстНеНайденныхАтрибутов);
	КонецЕсли;

	Если Результат.ПерезаписаныеРучные.Количество() > 0 Тогда
		СписокПерезаписанныхРучных = СтрСоединить(Результат.ПерезаписаныеРучные, ", ");
		ТекстПерезаписанныхРучных = СтрШаблон(
			НСтр("ru = 'Перезаписаны вручную заданные значения: %1'; en = 'Manually set values overwritten: %1'"),
			СписокПерезаписанныхРучных);
		Части.Добавить(ТекстПерезаписанныхРучных);
	КонецЕсли;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

#КонецОбласти
