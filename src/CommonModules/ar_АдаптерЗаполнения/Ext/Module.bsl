// Общий модуль ar_АдаптерЗаполнения (Fill Adapter).
//
// UNIV-06: контракт адаптера заполнения типовых документов целевой конфигурации +
// маршрутизация вызова к конкретной реализации по типу конфигурации. Ключевой
// вывод первоисточника (.docs/Ревью-универсальность-тулов.md, Разрыв №3):
// заполнение типовых документов НЕ может быть универсальным механизмом - ядро
// (этот модуль, ar_ToolДокументы) остаётся неизменным для любой конфигурации,
// вся конфигурация-специфичная логика живёт в отдельных модулях-адаптерах
// (ar_АдаптерБП - референсная реализация под БП 3.0, будущие ar_АдаптерУТ и т.д.).
//
// RECON-01: добавлен второй контракт - СоздатьАктСверки (акт сверки
// взаиморасчётов, родное Заполнить(), период не дублируется - см.
// ar_АдаптерБП.СоздатьАктСверки). Маршрутизация - тот же паттерн двухуровневого
// ветвления, что и у СоздатьЧерновикСчёта.
//
// Контракт адаптера (каждый адаптер обязан реализовать РОВНО этот набор
// экспортных функций с этими сигнатурами - область КонтрактАдаптера ниже
// документирует его, но САМ не реализует, это чистый интерфейс):
//   Функция ПоддерживаемыеКонфигурации() Экспорт -> Массив из Строка.
//   Функция ТребуемыеОбъекты() Экспорт -> Массив из Строка.
//   Функция СоздатьЧерновикСчёта(Знач Payload, Отказ, Сообщения) Экспорт
//       -> ДокументОбъект.<Счёт> (незаписанный) | Неопределено при Отказ=Истина.
//   Функция СоздатьАктСверки(Знач Payload, Отказ, Сообщения) Экспорт
//       -> ДокументОбъект.<АктСверкиВзаиморасчетов> (незаписанный, проверенный
//          ПроверитьЗаполнение()) | Неопределено при Отказ=Истина.
//
// Маршрутизация - двухуровневое ветвление (ВызватьАдаптер), точная копия
// паттерна ar_ToolDispatcher.ВыполнитьЯдровойМодуль. НИ ОДНОГО Выполнить()/
// Вычислить() (Plan §1.3, DoD D5). Ядро НЕ содержит ветвлений по типу
// конфигурации (Если ЭтоERP Тогда и т.п., DoD D6) - только по имени модуля,
// прочитанному из регистра ar_Адаптеры.
//
// Регистрация адаптеров - регистр сведений ar_Адаптеры (независимый,
// непериодический, измерение ar_Конфигурация Строка(50), ресурсы
// ar_ОбщийМодуль/ar_ИсточникРасширение/ar_Включён). Заполняется программно
// ЗарегистрироватьВсеАдаптеры() из того же жизненного цикла запуска, что и
// ar_ToolDispatcher.АвтоЗаполнитьРеестрToolsПриЗапуске (см.
// ar_ToolDispatcher.ИнициализироватьПриЗапускеСистемы).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь -
// сам контракт маршрутизации не требует привилегий; привилегии, если нужны,
// точечно поднимаются внутри конкретного адаптера или в
// ЗарегистрироватьВсеАдаптеры (запись служебного регистра).
//
// См. спеку: .docs/specs/UNIV-06.md, Plan §1.3.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Создать НЕЗАПИСАННЫЙ черновик документа «Счёт на оплату» родными механизмами
// активной конфигурации. Верхнеуровневая точка входа для потребителей
// (ar_ToolДокументы) - сама определяет, какой адаптер вызвать, по текущему типу
// конфигурации (ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип) и записи
// регистра ar_Адаптеры.
//
// Не бросает исключений наружу при отсутствии адаптера - тот же fail-safe
// контракт, что у ar_ToolDispatcher (симметрично: «диспетчер не выбрасывает
// исключений наружу»).
//
// Параметры:
//  Payload   - Структура - {client_ref (СправочникСсылка), items (Массив структур
//                          {nomenclature_ref, quantity, price, vat_rate}),
//                          organization_ref (СправочникСсылка, может быть
//                          Неопределено), comment (Строка)} - уже разыменованные
//                          ссылки, не строки навигации (разыменование -
//                          ответственность вызывающего tool-кода).
//  Отказ     - Булево    - выходной параметр: Истина при невозможности создать
//                          черновик (нет адаптера / провалилась ПроверитьЗаполнение()).
//  Сообщения - Массив из Строка - выходной параметр: причины отказа/предупреждения,
//                          уходят в observation для LLM.
//
// Возвращаемое значение:
//  ДокументОбъект.<Счёт конкретной конфигурации> - заполненный, но НЕ ЗАПИСАННЫЙ
//                          объект, при Отказ = Ложь.
//  Неопределено           - при Отказ = Истина.
//
Функция СоздатьЧерновикСчёта(Знач Payload, Отказ, Сообщения) Экспорт

	Отказ = Ложь;
	Если Сообщения = Неопределено Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	ТипКонфигурации = ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип;

	ИмяМодуля = ИмяАдаптераДляКонфигурации(ТипКонфигурации);
	Если ПустаяСтрока(ИмяМодуля) Тогда
		Отказ = Истина;
		Сообщения.Добавить("no_fill_adapter:" + ТипКонфигурации);
		Возврат Неопределено;
	КонецЕсли;

	Возврат ВызватьАдаптер(ИмяМодуля, Payload, Отказ, Сообщения);

КонецФункции

// RECON-01: создать НЕЗАПИСАННЫЙ акт сверки взаиморасчётов родными механизмами
// активной конфигурации. Верхнеуровневая точка входа для потребителей
// (ar_ToolДокументы.СоздатьАктСверки) - определяет адаптер тем же способом,
// что и СоздатьЧерновикСчёта (регистр ar_Адаптеры по текущему типу
// конфигурации). Не бросает исключений наружу при отсутствии адаптера.
//
// Параметры:
//  Payload   - Структура - {client_ref (СправочникСсылка.Контрагенты),
//                          organization_ref (СправочникСсылка.Организации,
//                          может быть Неопределено), accounts (Массив из
//                          Строка - коды счетов, может быть пустым)} - уже
//                          разыменованные ссылки.
//  Отказ     - Булево    - выходной параметр: Истина при невозможности создать
//                          акт (нет адаптера / провалилась ПроверитьЗаполнение()).
//  Сообщения - Массив из Строка - выходной параметр: причины отказа/предупреждения.
//
// Возвращаемое значение:
//  ДокументОбъект.<АктСверкиВзаиморасчетов конкретной конфигурации> -
//                          заполненный, но НЕ ЗАПИСАННЫЙ объект, при Отказ = Ложь.
//  Неопределено           - при Отказ = Истина.
//
Функция СоздатьАктСверки(Знач Payload, Отказ, Сообщения) Экспорт

	Отказ = Ложь;
	Если Сообщения = Неопределено Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	ТипКонфигурации = ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип;

	ИмяМодуля = ИмяАдаптераДляКонфигурации(ТипКонфигурации);
	Если ПустаяСтрока(ИмяМодуля) Тогда
		Отказ = Истина;
		Сообщения.Добавить("no_fill_adapter:" + ТипКонфигурации);
		Возврат Неопределено;
	КонецЕсли;

	Возврат ВызватьАдаптерАктСверки(ИмяМодуля, Payload, Отказ, Сообщения);

КонецФункции

// UNIV-06, п.2 «Как ar_Доступен для create_invoke_draft узнаёт про наличие
// адаптера»: проверяет, есть ли зарегистрированный и включённый адаптер для
// текущего типа конфигурации. Не бросает исключений - fail-safe (тот же
// контракт, что у остальной части ar_ToolDispatcher).
//
// Возвращаемое значение:
//  Булево - Истина, если для текущего ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип
//           есть запись ar_Адаптеры с ar_Включён = Истина.
//
Функция ЕстьАдаптерДляТекущейКонфигурации() Экспорт

	Попытка
		ТипКонфигурации = ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип;
		Возврат Не ПустаяСтрока(ИмяАдаптераДляКонфигурации(ТипКонфигурации));
	Исключение
		ar_СлужебныйЛог.Записать(
			"ar_АдаптерЗаполнения.ЕстьАдаптерДляТекущейКонфигурации",
			"adapter_availability_check_error",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение");
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Идемпотентно регистрирует ядровые адаптеры (поставляемые с самим AgentRunner)
// в регистре ar_Адаптеры. Безопасно вызывать повторно: существующие записи
// обновляются (ar_ОбщийМодуль/ar_Включён), записи с другим ar_Конфигурация,
// внесённые вручную или через Expert Pack, не затрагиваются и не удаляются.
//
// !!! ДОБАВЛЯТЬ НОВЫЙ ЯДРОВОЙ АДАПТЕР ЗДЕСЬ: новая пара {Тип конфигурации,
// имя модуля} в списке ЯдровыеАдаптеры ниже.
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } - статистика регистрации.
//
Функция ЗарегистрироватьВсеАдаптеры() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	ЯдровыеАдаптеры = Новый Соответствие;
	ЯдровыеАдаптеры.Вставить("БП", "ar_АдаптерБП");
	// !!! ДОБАВЛЯТЬ НОВЫЙ ЯДРОВОЙ АДАПТЕР ЗДЕСЬ: ЯдровыеАдаптеры.Вставить("УТ", "ar_АдаптерУТ");

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Для Каждого Элемент Из ЯдровыеАдаптеры Цикл
			ЗарегистрироватьОдинАдаптер(Элемент.Ключ, Элемент.Значение, Статистика);
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

#КонецОбласти

#Область ДвухуровневоеВетвление

// Уровень 1: ветвление по имени общего модуля-адаптера. БЕЗ Выполнить()/
// Вычислить() (Plan §1.3, DoD D5). Точная копия паттерна
// ar_ToolDispatcher.ВыполнитьЯдровойМодуль [Реф:
// src/CommonModules/ar_ToolDispatcher/Ext/Module.bsl].
//
// Параметры:
//  ИмяМодуля - Строка - значение ar_ОбщийМодуль (например "ar_АдаптерБП").
//  Payload   - Структура - см. СоздатьЧерновикСчёта.
//  Отказ     - Булево - выходной параметр.
//  Сообщения - Массив из Строка - выходной параметр.
//
// Возвращаемое значение:
//  ДокументОбъект.<Счёт> | Неопределено - см. контракт адаптера выше.
//
Функция ВызватьАдаптер(Знач ИмяМодуля, Знач Payload, Отказ, Сообщения) Экспорт

	Если ИмяМодуля = "ar_АдаптерБП" Тогда
		Возврат ar_АдаптерБП.СоздатьЧерновикСчёта(Payload, Отказ, Сообщения);

	// !!! ДОБАВЛЯТЬ НОВЫЙ АДАПТЕР ЗДЕСЬ: новая ветвь ИначеЕсли, имя модуля
	// ОБЯЗАНО совпадать с именем файла в src/CommonModules/ и со значением
	// ar_ОбщийМодуль в регистре ar_Адаптеры.

	Иначе
		// Expert Pack (EXT-01, аналог ВызватьРасширение в ar_ToolDispatcher).
		Отказ = Истина;
		Сообщения.Добавить("adapter_module_not_found:" + ИмяМодуля);
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// RECON-01: уровень 1 маршрутизации для СоздатьАктСверки - точная копия
// паттерна ВызватьАдаптер (см. выше), отдельная функция, т.к. второй
// контракт адаптера (СоздатьАктСверки) не пересекается по сигнатуре с
// первым (СоздатьЧерновикСчёта). БЕЗ Выполнить()/Вычислить() (Plan §1.3).
//
// Параметры:
//  ИмяМодуля - Строка - значение ar_ОбщийМодуль (например "ar_АдаптерБП").
//  Payload   - Структура - см. СоздатьАктСверки.
//  Отказ     - Булево - выходной параметр.
//  Сообщения - Массив из Строка - выходной параметр.
//
// Возвращаемое значение:
//  ДокументОбъект.<АктСверкиВзаиморасчетов> | Неопределено - см. контракт адаптера.
//
Функция ВызватьАдаптерАктСверки(Знач ИмяМодуля, Знач Payload, Отказ, Сообщения) Экспорт

	Если ИмяМодуля = "ar_АдаптерБП" Тогда
		Возврат ar_АдаптерБП.СоздатьАктСверки(Payload, Отказ, Сообщения);

	// !!! ДОБАВЛЯТЬ НОВЫЙ АДАПТЕР ЗДЕСЬ: новая ветвь ИначеЕсли (см. ВызватьАдаптер).

	Иначе
		Отказ = Истина;
		Сообщения.Добавить("adapter_module_not_found:" + ИмяМодуля);
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ищет имя общего модуля-адаптера для типа конфигурации в регистре ar_Адаптеры.
// Возвращает "" при отсутствии включённой записи (не бросает исключений -
// вызывающий код трактует "" как «адаптер отсутствует»).
//
// Параметры:
//  ТипКонфигурации - Строка - значение ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип.
//
// Возвращаемое значение:
//  Строка - имя общего модуля (ar_ОбщийМодуль) либо "".
//
Функция ИмяАдаптераДляКонфигурации(Знач ТипКонфигурации)

	ТипКонфигурации = СокрЛП(?(ТипЗнч(ТипКонфигурации) = Тип("Строка"), ТипКонфигурации, ""));
	Если ПустаяСтрока(ТипКонфигурации) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Адаптеры.ar_ОбщийМодуль КАК ОбщийМодуль
		|ИЗ
		|	РегистрСведений.ar_Адаптеры КАК Адаптеры
		|ГДЕ
		|	Адаптеры.ar_Конфигурация = &ТипКонфигурации
		|	И Адаптеры.ar_Включён = ИСТИНА";
	Запрос.УстановитьПараметр("ТипКонфигурации", ТипКонфигурации);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.ОбщийМодуль));
	КонецЕсли;

	Возврат "";

КонецФункции

// Идемпотентно создаёт/обновляет одну запись регистра ar_Адаптеры. Выполняется
// в уже поднятом привилегированном режиме (см. ЗарегистрироватьВсеАдаптеры).
// ar_ИсточникРасширение = "" - ядровой адаптер (поставляется с самим AgentRunner,
// не Expert Pack).
//
// Параметры:
//  ТипКонфигурации - Строка - значение измерения ar_Конфигурация.
//  ИмяМодуля       - Строка - значение ресурса ar_ОбщийМодуль.
//  Статистика      - Структура - {Создано, Обновлено}, мутируется по ссылке.
//
Процедура ЗарегистрироватьОдинАдаптер(Знач ТипКонфигурации, Знач ИмяМодуля, Статистика)

	МенеджерЗаписи = РегистрыСведений.ar_Адаптеры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_Конфигурация = ТипКонфигурации;
	МенеджерЗаписи.Прочитать();

	Существовала = МенеджерЗаписи.Выбран();

	МенеджерЗаписи.ar_Конфигурация = ТипКонфигурации;
	МенеджерЗаписи.ar_ОбщийМодуль = ИмяМодуля;
	Если Не Существовала Тогда
		// ar_ИсточникРасширение/ar_Включён не трогаем при обновлении уже
		// существующей записи, если администратор вручную выключил адаптер
		// (ar_Включён = Ложь) - повторный запуск ЗарегистрироватьВсеАдаптеры
		// не должен молча снова включать его.
		МенеджерЗаписи.ar_ИсточникРасширение = "";
		МенеджерЗаписи.ar_Включён = Истина;
	КонецЕсли;
	МенеджерЗаписи.Записать(Истина);

	Если Существовала Тогда
		Статистика.Обновлено = Статистика.Обновлено + 1;
	Иначе
		Статистика.Создано = Статистика.Создано + 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
