////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_JSON (AOS JSON-утилиты).
//
// Инкапсулирует единые настройки сериализации/десериализации JSON для всего
// ядра AgentRunner: LLM-провайдеры, tool-диспетчер, audit-регистры, StateSnapshot.
// Назначение — устранить риск рассинхронизации настроек ЗаписьJSON/ЧтениеJSON
// между модулями и предоставить безопасные обёртки, которые не выбрасывают
// исключений наружу (могут вызываться в т.ч. из блоков Исключение).
//
// Ключевые настройки (Plan §3.3, §1.1):
//   * ИспользоватьДвойныеКавычки = Истина — обязательно для совместимости
//     с JSON-парсерами LLM-API.
//   * ФорматСериализацииДаты = ФорматДатыJSON.ISO — ISO 8601, унифицированный
//     формат, корректно интерпретируемый моделями.
//   * Неопределено сериализуется как JSON null платформой по умолчанию, без
//     отдельной настройки (свойства СохранятьNull у объекта не существует).
//   * ПереносСтрок = ПереносСтрокJSON.Авто — компактная запись для регистров;
//     для отладки/UI используется КрасивыйФорматJSON с Пробелы.
//   * ЧитатьВСоответствие = Истина — поддержка JSON-ключей с дефисами/точками
//     (tool_call.id, x-request-id и пр.) через Соответствие вместо Структуры.
//
// Свойства модуля: Сервер + Клиент (управляемое приложение), без вызова сервера,
// без привилегий, без повторного использования возвращаемых значений.
// Логика чистая: без обращений к ИБ, без состояния — безопасна на клиенте.
//
// Ограничения:
//   * ХранилищеЗначений нативно не сериализуется в JSON — для таких данных
//     используется отдельный путь хранения, а не ar_JSON.
//
// См. спеку: .docs/specs/UTIL-01.md, Plan §3.3.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Сериализует произвольное значение в строку JSON с едиными настройками AgentRunner.
//
// Поддерживаемые типы: Структура, Соответствие, Массив, Строка, Число, Булево,
// Дата, Неопределено, Null. Объекты ИБ и ХранилищеЗначений не поддерживаются.
//
// Параметры:
//   Значение - Произвольный - сериализуемое значение. Неопределено → "null".
//
// Возвращаемое значение:
//   Строка - валидный JSON в кодировке UTF-8. При ошибке сериализации
//            возвращает "" и пишет событие в журнал регистрации (Ошибка).
//            Не выбрасывает исключений.
//
Функция ВЗначениеJSON(Знач Значение) Экспорт

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку(ПараметрыЗаписиКомпакт());

		Настройки = НастройкиСериализации();
		ЗаписатьJSON(Запись, Значение, Настройки);

		Возврат Запись.Закрыть();
	Исключение
		ЗаписатьОшибку(
			НСтр("ru = 'Ошибка сериализации значения в JSON'; en = 'JSON serialization error'"),
			ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Десериализует строку JSON в значение (Соответствие / Массив / примитив).
//
// JSON-объекты возвращаются как Соответствие (а не Структура), что позволяет
// корректно читать ключи с дефисами, точками и зарезервированными словами
// (tool_call.id, x-request-id, x-api-version и т.п.).
//
// Параметры:
//   Текст - Строка - JSON-текст для разбора.
//
// Возвращаемое значение:
//   Соответствие, Массив, Строка, Число, Булево, Дата или Неопределено.
//   При пустой/некорректной строке или иной ошибке парсера возвращает
//   Неопределено и пишет событие в журнал (Предупреждение).
//   Текст ошибки маскируется через ar_Утилиты.МаскироватьСекреты
//   (на случай попадания payload с секретами в сообщение об ошибке).
//   Не выбрасывает исключений.
//
Функция ИзJSON(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		ЗаписатьПредупреждение(
			НСтр("ru = 'Ошибка разбора JSON'; en = 'JSON parse error'"),
			ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Возвращает «красиво» отформатированный JSON: с переносами строк и отступами.
// Предназначен только для UI/отладки (отображение payload в формах
// «Показать, что увидит LLM»). Для хранения в регистрах используйте ВЗначениеJSON.
//
// Параметры:
//   Значение - Произвольный - сериализуемое значение.
//
// Возвращаемое значение:
//   Строка - отформатированный JSON. При ошибке возвращает ""
//            и пишет в журнал (Ошибка). Не выбрасывает исключений.
//
Функция КрасивыйФорматJSON(Знач Значение) Экспорт

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку(ПараметрыЗаписиКрасиво());

		Настройки = НастройкиСериализации();
		ЗаписатьJSON(Запись, Значение, Настройки);

		Возврат Запись.Закрыть();
	Исключение
		ЗаписатьОшибку(
			НСтр("ru = 'Ошибка форматирования JSON для отображения'; en = 'JSON pretty-print error'"),
			ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Валидирует значение по схеме (подмножество JSON Schema Draft 2020-12).
//
// Минимальный валидатор, достаточный для описания tool arguments AgentRunner
// (Plan §3.6). Используется tool-диспетчером для проверки аргументов вызова
// до передачи их в имплементацию tool: невалидный вызов возвращается наружу
// как observation "invalid arguments: <причина>", и LLM исправляет его на
// следующем шаге цикла без падения run-а.
//
// Поддерживаемые ключевые слова: type, required, properties,
// additionalProperties, items, minItems, maxItems, minimum, maximum,
// exclusiveMinimum, exclusiveMaximum, minLength, maxLength, enum,
// oneOf, anyOf, allOf.
//
// Явно не поддерживается: $ref (возвращает ошибку), if/then/else (игнор),
// pattern (игнор). Ключи $schema, $defs, $id, $anchor игнорируются без ошибки.
//
// Параметры:
//   Значение - Произвольный - уже десериализованное значение (Соответствие,
//              Массив, примитив). Если на входе JSON-строка — вызывающий код
//              обязан предварительно вызвать ar_JSON.ИзJSON().
//   Схема    - Соответствие - JSON Schema как Соответствие (например, получена
//              через ar_JSON.ИзJSON(Манифест["parameters"])). Неопределено или
//              не-Соответствие трактуется как «нет ограничений».
//
// Возвращаемое значение:
//   Структура:
//     * Корректно - Булево - Истина, если значение соответствует схеме.
//     * Ошибки    - Массив Строк - человекочитаемые описания нарушений с путём
//                   к проблемному полю в точечной нотации. Пустой при Корректно.
//   Никогда не выбрасывает исключений наружу: при внутренней ошибке валидатора
//   пишет событие в журнал (Ошибка) и возвращает Корректно = Ложь.
//
Функция ВалидироватьПоСхеме(Знач Значение, Знач Схема) Экспорт

	Результат = Новый Структура("Корректно, Ошибки", Истина, Новый Массив);

	// Нет схемы (или схема не Соответствие) — нет ограничений.
	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ВалидироватьРекурсивно(Значение, Схема, "", Результат.Ошибки, 0);
	Исключение
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьОшибку(
			НСтр("ru = 'Внутренняя ошибка валидатора JSON Schema'; en = 'JSON Schema validator internal error'"),
			ИнформацияОбОшибке());
		Результат.Ошибки.Очистить();
		Результат.Ошибки.Добавить(
			НСтр("ru = 'внутренняя ошибка валидатора: '; en = 'internal validator error: '") + ТекстОшибки);
	КонецПопытки;

	Результат.Корректно = (Результат.Ошибки.Количество() = 0);
	Возврат Результат;

КонецФункции

// Проверяет, что размер JSON-строки аргументов tool не превышает лимит (Plan §3.6).
//
// Защита от патологически больших аргументов, генерируемых LLM (мегабайтные
// payload-ы, рекурсивный мусор и т.п.): такие аргументы перегружают регистр
// ar_ДействияАгента, замедляют JSON-парсер и валидатор схемы, создают вектор
// injection. Проверка выполняется tool-диспетчером ДО ИзJSON и ВалидироватьПоСхеме:
// при превышении лимита диспетчер не парсит аргументы, формирует observation
// "invalid arguments: ..." и LLM исправляет запрос на следующем шаге цикла.
//
// Размер считается в байтах UTF-8 (а не в символах: кириллица в UTF-8 — 2 байта,
// ASCII — 1 байт, соотношение в реальном JSON непредсказуемо).
//
// Назначение: серверная логика диспетчера. Служебная РазмерСтрокиВБайтах
// использует ПолучитьДвоичныеДанныеИзСтроки — на тонком клиенте недоступна;
// функцию следует вызывать на сервере.
//
// Параметры:
//   АргументыJSON  - Строка - JSON-строка аргументов tool (как пришла от LLM,
//                    до вызова ИзJSON). Неопределено / не-строка трактуется как
//                    пустые аргументы (размер 0, корректно).
//   МаксРазмерБайт - Число  - максимально допустимый размер в байтах UTF-8.
//                    По умолчанию 65536 (64 KB). Значение 0 отключает проверку
//                    (режим «без ограничения», всегда Корректно = Истина).
//
// Возвращаемое значение:
//   Структура:
//     * Корректно  - Булево - Истина, если размер в норме.
//     * РазмерБайт - Число  - фактический размер в байтах UTF-8 (0 для пустой
//                    строки; -1 при внутренней ошибке).
//     * Сообщение  - Строка - человекочитаемое сообщение для observation LLM
//                    при Корректно = Ложь; пустая строка при Корректно = Истина.
//   Никогда не выбрасывает исключений наружу.
//
Функция ПроверитьРазмерАргументов(Знач АргументыJSON, Знач МаксРазмерБайт = 65536) Экспорт

	Результат = Новый Структура("Корректно, РазмерБайт, Сообщение", Истина, 0, "");

	Попытка
		// Защита от некорректного отрицательного лимита: трактуем как дефолт
		// МаксРазмерАргументовToolПоУмолчанию() (см. именованную константу).
		Если ТипЗнч(МаксРазмерБайт) <> Тип("Число") Или МаксРазмерБайт < 0 Тогда
			МаксРазмерБайт = МаксРазмерАргументовToolПоУмолчанию();
		КонецЕсли;

		// Режим «без ограничения»: размер не вычисляем.
		Если МаксРазмерБайт = 0 Тогда
			Возврат Результат;
		КонецЕсли;

		// Неопределено / не-строка → пустые аргументы (размер 0, корректно):
		// схема позже поймает отсутствие обязательных полей.
		Если ТипЗнч(АргументыJSON) <> Тип("Строка") Тогда
			Возврат Результат;
		КонецЕсли;

		РазмерБайт = РазмерСтрокиВБайтах(АргументыJSON);
		Результат.РазмерБайт = РазмерБайт;

		// Граница включающая: ровно МаксРазмерБайт байт — корректно.
		Если РазмерБайт <= МаксРазмерБайт Тогда
			Возврат Результат;
		КонецЕсли;

		Результат.Корректно = Ложь;
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'аргументы tool превышают лимит %1: %2'; en = 'tool arguments exceed the %1 limit: %2'"),
			ПредставлениеРазмераKB(МаксРазмерБайт),
			ПредставлениеРазмераKB(РазмерБайт));
		Возврат Результат;
	Исключение
		ЗаписатьОшибку(
			НСтр("ru = 'Внутренняя ошибка проверки размера аргументов tool'; en = 'Internal error checking tool arguments size'"),
			ИнформацияОбОшибке());
		Результат.Корректно = Ложь;
		Результат.РазмерБайт = -1;
		Результат.Сообщение = НСтр(
			"ru = 'внутренняя ошибка проверки размера'; en = 'internal size-check error'");
		Возврат Результат;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает ПараметрыЗаписиJSON для компактной записи (хранение в регистрах).
//
// Аргументы конструктора:
//   ПереносСтрокJSON.Авто, Отступ = "", ИспользоватьДвойныеКавычки = Истина.
Функция ПараметрыЗаписиКомпакт()
	Возврат Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "", Истина);
КонецФункции

// Возвращает ПараметрыЗаписиJSON для читаемого вывода (UI/отладка):
// перенос строк Авто, отступ 4 пробела, двойные кавычки.
//
// Перечисление ПереносСтрокJSON имеет только 4 значения: Windows, Unix, Авто,
// Нет (значения "Пробелы" не существует - проверено по реальному коду БП/БСП,
// нигде не встречается). "Красота" вывода обеспечивается вторым параметром
// конструктора (Отступ = "    "), а не выбором варианта переноса строки.
Функция ПараметрыЗаписиКрасиво()
	Возврат Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "    ", Истина);
КонецФункции

// Возвращает НастройкиСериализацииJSON с едиными для AgentRunner параметрами:
// ФорматСериализацииДаты = ФорматДатыJSON.ISO.
//
// Свойства СохранятьNull у объекта НастройкиСериализацииJSON не существует
// (проверено по реальному использованию в прикладном коде — см. также
// БП/DataProcessors/МенеджерКонвертацииУправлениеПерсоналом): платформа
// сериализует Неопределено как JSON null без отдельной настройки.
Функция НастройкиСериализации()

	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Возврат Настройки;

КонецФункции

// Пишет событие уровня Ошибка с маскировкой секретов в тексте ошибки.
Процедура ЗаписатьОшибку(Знач Сообщение, Знач ИнфоОбОшибке)

	ТекстОшибки = ar_Утилиты.МаскироватьСекреты(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
	ЗаписьЖурналаРегистрации(
		"ar_JSON",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Сообщение + ": " + ТекстОшибки);

КонецПроцедуры

// Пишет событие уровня Предупреждение с маскировкой секретов в тексте ошибки.
Процедура ЗаписатьПредупреждение(Знач Сообщение, Знач ИнфоОбОшибке)

	ТекстОшибки = ar_Утилиты.МаскироватьСекреты(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
	ЗаписьЖурналаРегистрации(
		"ar_JSON",
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		Сообщение + ": " + ТекстОшибки);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Валидатор JSON Schema (UTIL-02).

// Максимально допустимая глубина рекурсии при обходе схемы (защита от
// циклических / патологически глубоких схем). См. граничный случай D11.
Функция МаксимальнаяГлубинаСхемы()
	Возврат 20;
КонецФункции

// Рекурсивно валидирует Значение по Схема, накапливая ошибки в МассивОшибок.
//
// Параметры:
//   Значение     - Произвольный  - проверяемое значение.
//   Схема        - Соответствие  - схема для текущего узла.
//   Путь         - Строка        - путь к узлу в точечной нотации (для сообщений).
//   МассивОшибок - Массив        - аккумулятор строк-ошибок (изменяется).
//   Глубина      - Число         - текущий уровень вложенности.
Процедура ВалидироватьРекурсивно(Знач Значение, Знач Схема, Знач Путь, МассивОшибок, Знач Глубина)

	Если Глубина > МаксимальнаяГлубинаСхемы() Тогда
		МассивОшибок.Добавить(СтрШаблон(
			НСтр("ru = '%1: превышена максимальная глубина вложенности схемы (%2)'; en = '%1: maximum schema nesting depth exceeded (%2)'"),
			ПредставлениеПути(Путь),
			МаксимальнаяГлубинаСхемы()));
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		// Схема в этом узле не объект — игнорируем (нет ограничений).
		Возврат;
	КонецЕсли;

	// $ref не поддерживается — явная ошибка (D10).
	Если Схема.Получить("$ref") <> Неопределено Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь)
			+ НСтр("ru = '$ref не поддерживается'; en = '$ref is not supported'"));
		Возврат;
	КонецЕсли;

	// Комбинаторы: oneOf / anyOf / allOf.
	ПроверитьOneOf(Значение, Схема, Путь, МассивОшибок, Глубина);
	ПроверитьAnyOf(Значение, Схема, Путь, МассивОшибок, Глубина);
	ПроверитьAllOf(Значение, Схема, Путь, МассивОшибок, Глубина);

	// type.
	ПроверитьТип(Значение, Схема, Путь, МассивОшибок);

	// enum.
	ПроверитьПеречень(Значение, Схема, Путь, МассивОшибок);

	// Ограничения по конкретным категориям типов.
	ПроверитьОграниченияЧисла(Значение, Схема, Путь, МассивОшибок);
	ПроверитьОграниченияСтроки(Значение, Схема, Путь, МассивОшибок);
	ПроверитьОграниченияМассива(Значение, Схема, Путь, МассивОшибок, Глубина);
	ПроверитьОграниченияОбъекта(Значение, Схема, Путь, МассивОшибок, Глубина);

КонецПроцедуры

// Возвращает Истина, если Значение соответствует Схема (без накопления ошибок).
// Используется комбинаторами oneOf/anyOf/allOf для подсчёта подходящих схем.
Функция СоответствуетСхеме(Знач Значение, Знач Схема, Знач Глубина)
	ВременныеОшибки = Новый Массив;
	ВалидироватьРекурсивно(Значение, Схема, "", ВременныеОшибки, Глубина);
	Возврат ВременныеОшибки.Количество() = 0;
КонецФункции

// Проверяет ключевое слово oneOf: ровно одна вложенная схема должна подойти.
Процедура ПроверитьOneOf(Знач Значение, Знач Схема, Знач Путь, МассивОшибок, Знач Глубина)

	Схемы = Схема.Получить("oneOf");
	Если ТипЗнч(Схемы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	КоличествоПодходящих = 0;
	Для Каждого ВложеннаяСхема Из Схемы Цикл
		Если СоответствуетСхеме(Значение, ВложеннаяСхема, Глубина + 1) Тогда
			КоличествоПодходящих = КоличествоПодходящих + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоПодходящих <> 1 Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'должно соответствовать ровно одной схеме из oneOf, подошло %1'; en = 'must match exactly one schema in oneOf, matched %1'"),
			КоличествоПодходящих));
	КонецЕсли;

КонецПроцедуры

// Проверяет ключевое слово anyOf: хотя бы одна вложенная схема должна подойти.
Процедура ПроверитьAnyOf(Знач Значение, Знач Схема, Знач Путь, МассивОшибок, Знач Глубина)

	Схемы = Схема.Получить("anyOf");
	Если ТипЗнч(Схемы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ВложеннаяСхема Из Схемы Цикл
		Если СоответствуетСхеме(Значение, ВложеннаяСхема, Глубина + 1) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если Схемы.Количество() > 0 Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь)
			+ НСтр("ru = 'не соответствует ни одной схеме из anyOf'; en = 'does not match any schema in anyOf'"));
	КонецЕсли;

КонецПроцедуры

// Проверяет ключевое слово allOf: все вложенные схемы должны подойти.
Процедура ПроверитьAllOf(Знач Значение, Знач Схема, Знач Путь, МассивОшибок, Знач Глубина)

	Схемы = Схема.Получить("allOf");
	Если ТипЗнч(Схемы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ВложеннаяСхема Из Схемы Цикл
		ВалидироватьРекурсивно(Значение, ВложеннаяСхема, Путь, МассивОшибок, Глубина + 1);
	КонецЦикла;

КонецПроцедуры

// Проверяет ключевое слово type (строка или массив строк — OR-логика).
Процедура ПроверитьТип(Знач Значение, Знач Схема, Знач Путь, МассивОшибок)

	ОжидаемыйТип = Схема.Получить("type");
	Если ОжидаемыйТип = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ФактическийТип = JSONТипЗначения(Значение);

	ДопустимыеТипы = Новый Массив;
	Если ТипЗнч(ОжидаемыйТип) = Тип("Массив") Тогда
		Для Каждого Элемент Из ОжидаемыйТип Цикл
			ДопустимыеТипы.Добавить(Элемент);
		КонецЦикла;
	Иначе
		ДопустимыеТипы.Добавить(ОжидаемыйТип);
	КонецЕсли;

	Если ТипДопустим(ФактическийТип, ДопустимыеТипы) Тогда
		Возврат;
	КонецЕсли;

	МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
		НСтр("ru = 'ожидалось %1, получено %2'; en = 'expected %1, got %2'"),
		СтрСоединить(ДопустимыеТипы, " | "),
		ФактическийТип));

КонецПроцедуры

// Возвращает Истина, если фактический тип входит в список допустимых
// (с учётом того, что integer-значение удовлетворяет и number).
Функция ТипДопустим(Знач ФактическийТип, Знач ДопустимыеТипы)

	Для Каждого Тип Из ДопустимыеТипы Цикл
		Если Тип = ФактическийТип Тогда
			Возврат Истина;
		КонецЕсли;
		// Целое число удовлетворяет требованию number.
		Если Тип = "number" И ФактическийТип = "integer" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет ключевое слово enum: значение должно быть в списке допустимых.
Процедура ПроверитьПеречень(Знач Значение, Знач Схема, Знач Путь, МассивОшибок)

	Перечень = Схема.Получить("enum");
	Если ТипЗнч(Перечень) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ДопустимоеЗначение Из Перечень Цикл
		Если ЗначенияРавны(Значение, ДопустимоеЗначение) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
		НСтр("ru = 'значение %1 не входит в перечень допустимых'; en = 'value %1 is not in the allowed enum'"),
		ПредставлениеЗначения(Значение)));

КонецПроцедуры

// Проверяет числовые ограничения: minimum / maximum /
// exclusiveMinimum / exclusiveMaximum.
Процедура ПроверитьОграниченияЧисла(Знач Значение, Знач Схема, Знач Путь, МассивОшибок)

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат;
	КонецЕсли;

	Минимум = Схема.Получить("minimum");
	Если ТипЗнч(Минимум) = Тип("Число") И Значение < Минимум Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'значение %1 меньше минимума %2'; en = 'value %1 is less than minimum %2'"),
			ПредставлениеЗначения(Значение), ПредставлениеЗначения(Минимум)));
	КонецЕсли;

	Максимум = Схема.Получить("maximum");
	Если ТипЗнч(Максимум) = Тип("Число") И Значение > Максимум Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'значение %1 больше максимума %2'; en = 'value %1 is greater than maximum %2'"),
			ПредставлениеЗначения(Значение), ПредставлениеЗначения(Максимум)));
	КонецЕсли;

	// exclusiveMinimum / exclusiveMaximum — Draft 2020-12: число (не булево).
	ИсклМинимум = Схема.Получить("exclusiveMinimum");
	Если ТипЗнч(ИсклМинимум) = Тип("Число") И Значение <= ИсклМинимум Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'значение %1 не больше исключающего минимума %2'; en = 'value %1 is not greater than exclusiveMinimum %2'"),
			ПредставлениеЗначения(Значение), ПредставлениеЗначения(ИсклМинимум)));
	КонецЕсли;

	ИсклМаксимум = Схема.Получить("exclusiveMaximum");
	Если ТипЗнч(ИсклМаксимум) = Тип("Число") И Значение >= ИсклМаксимум Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'значение %1 не меньше исключающего максимума %2'; en = 'value %1 is not less than exclusiveMaximum %2'"),
			ПредставлениеЗначения(Значение), ПредставлениеЗначения(ИсклМаксимум)));
	КонецЕсли;

КонецПроцедуры

// Проверяет строковые ограничения: minLength / maxLength (длина в символах).
Процедура ПроверитьОграниченияСтроки(Знач Значение, Знач Схема, Знач Путь, МассивОшибок)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;

	Длина = СтрДлина(Значение);

	МинДлина = Схема.Получить("minLength");
	Если ТипЗнч(МинДлина) = Тип("Число") И Длина < МинДлина Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'длина строки %1 меньше минимальной %2'; en = 'string length %1 is less than minLength %2'"),
			Длина, МинДлина));
	КонецЕсли;

	МаксДлина = Схема.Получить("maxLength");
	Если ТипЗнч(МаксДлина) = Тип("Число") И Длина > МаксДлина Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'длина строки %1 больше максимальной %2'; en = 'string length %1 is greater than maxLength %2'"),
			Длина, МаксДлина));
	КонецЕсли;

КонецПроцедуры

// Проверяет ограничения массива: minItems / maxItems и рекурсивный items.
Процедура ПроверитьОграниченияМассива(Знач Значение, Знач Схема, Знач Путь, МассивОшибок, Знач Глубина)

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Количество = Значение.Количество();

	МинЭлементов = Схема.Получить("minItems");
	Если ТипЗнч(МинЭлементов) = Тип("Число") И Количество < МинЭлементов Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'элементов %1 меньше минимума minItems %2'; en = 'items count %1 is less than minItems %2'"),
			Количество, МинЭлементов));
	КонецЕсли;

	МаксЭлементов = Схема.Получить("maxItems");
	Если ТипЗнч(МаксЭлементов) = Тип("Число") И Количество > МаксЭлементов Тогда
		МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
			НСтр("ru = 'элементов %1 больше максимума maxItems %2'; en = 'items count %1 is greater than maxItems %2'"),
			Количество, МаксЭлементов));
	КонецЕсли;

	СхемаЭлементов = Схема.Получить("items");
	Если ТипЗнч(СхемаЭлементов) = Тип("Соответствие") Тогда
		Индекс = 0;
		Для Каждого Элемент Из Значение Цикл
			ПутьЭлемента = Путь + "[" + Индекс + "]";
			ВалидироватьРекурсивно(Элемент, СхемаЭлементов, ПутьЭлемента, МассивОшибок, Глубина + 1);
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Проверяет ограничения объекта: required, properties, additionalProperties.
Процедура ПроверитьОграниченияОбъекта(Знач Значение, Знач Схема, Знач Путь, МассивОшибок, Знач Глубина)

	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	// Индекс присутствующих ключей объекта (имя → Истина). Строится один раз,
	// обеспечивает O(1)-проверку наличия поля и корректно учитывает ключи со
	// значением Неопределено (явный JSON null также считается присутствием).
	ИндексКлючей = ИндексКлючейСоответствия(Значение);

	// required.
	ОбязательныеПоля = Схема.Получить("required");
	Если ТипЗнч(ОбязательныеПоля) = Тип("Массив") Тогда
		Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
			Если ИндексКлючей.Получить(ИмяПоля) = Неопределено Тогда
				МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
					НСтр("ru = 'обязательное поле %1 отсутствует'; en = 'required field %1 is missing'"),
					ИмяПоля));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Свойства = Схема.Получить("properties");
	ЕстьСвойства = (ТипЗнч(Свойства) = Тип("Соответствие"));

	// properties — рекурсивная валидация присутствующих полей.
	Если ЕстьСвойства Тогда
		Для Каждого КлючИЗначение Из Свойства Цикл
			ИмяПоля = КлючИЗначение.Ключ;
			Если ИндексКлючей.Получить(ИмяПоля) <> Неопределено Тогда
				ПутьПоля = ?(ПустаяСтрока(Путь), ИмяПоля, Путь + "." + ИмяПоля);
				ВалидироватьРекурсивно(
					Значение.Получить(ИмяПоля),
					КлючИЗначение.Значение,
					ПутьПоля,
					МассивОшибок,
					Глубина + 1);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// additionalProperties.
	ДопСвойства = Схема.Получить("additionalProperties");
	Если ДопСвойства = Истина Или ДопСвойства = Неопределено Тогда
		// Разрешены любые поля — ничего не делаем.
	Иначе
		ЗапрещеныДопПоля = (ДопСвойства = Ложь);
		СхемаДопПолей = ?(ТипЗнч(ДопСвойства) = Тип("Соответствие"), ДопСвойства, Неопределено);

		Если ЗапрещеныДопПоля Или СхемаДопПолей <> Неопределено Тогда
			Для Каждого КлючИЗначение Из Значение Цикл
				ИмяПоля = КлючИЗначение.Ключ;
				Если ЕстьСвойства И Свойства.Получить(ИмяПоля) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

				Если ЗапрещеныДопПоля Тогда
					МассивОшибок.Добавить(ПрефиксПути(Путь) + СтрШаблон(
						НСтр("ru = 'дополнительное поле %1 запрещено'; en = 'additional field %1 is not allowed'"),
						ИмяПоля));
				ИначеЕсли СхемаДопПолей <> Неопределено Тогда
					ПутьПоля = ?(ПустаяСтрока(Путь), ИмяПоля, Путь + "." + ИмяПоля);
					ВалидироватьРекурсивно(
						КлючИЗначение.Значение,
						СхемаДопПолей,
						ПутьПоля,
						МассивОшибок,
						Глубина + 1);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Строит индекс ключей Соответствие (имя ключа → Истина) за один проход.
// Позволяет проверять наличие поля за O(1) даже когда значение по ключу равно
// Неопределено (явный JSON null), что неотличимо от отсутствия ключа при
// использовании Соответствие.Получить().
Функция ИндексКлючейСоответствия(Знач ИсходноеСоответствие)

	Индекс = Новый Соответствие;
	Для Каждого КлючИЗначение Из ИсходноеСоответствие Цикл
		Индекс.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Определяет JSON Schema type значения по типу 1С (маппинг из спеки UTIL-02).
Функция JSONТипЗначения(Знач Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено Или ТипЗначения = Тип("Null") Тогда
		Возврат "null";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "string";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ?(ЭтоЦелоеЧисло(Значение), "integer", "number");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "boolean";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "array";
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Возврат "object";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		// Дата на входе уже строка ISO из ar_JSON; одиночная Дата → string.
		Возврат "string";
	Иначе
		Возврат "unknown";
	КонецЕсли;

КонецФункции

// Возвращает Истина, если число не имеет дробной части (является целым).
// Сравнение дробной части с нулём корректнее, чем Цел(Значение) = Значение,
// для значений у границ точности представления чисел платформы.
Функция ЭтоЦелоеЧисло(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат (Значение - Цел(Значение)) = 0;
КонецФункции

// Сравнивает два значения на равенство для нужд enum (примитивы через "=").
Функция ЗначенияРавны(Знач Значение1, Знач Значение2)

	Если ТипЗнч(Значение1) <> ТипЗнч(Значение2) Тогда
		// Допускаем сравнение Неопределено/Null между собой.
		Если (Значение1 = Неопределено Или ТипЗнч(Значение1) = Тип("Null"))
			И (Значение2 = Неопределено Или ТипЗнч(Значение2) = Тип("Null")) Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	Возврат Значение1 = Значение2;

КонецФункции

// Возвращает короткое строковое представление значения для текстов ошибок.
Функция ПредставлениеЗначения(Знач Значение)

	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "null";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Строка(Значение);
	Иначе
		Возврат JSONТипЗначения(Значение);
	КонецЕсли;

КонецФункции

// Возвращает путь для подстановки в начало сообщения, если он не пуст;
// иначе условный корень "(корень)".
Функция ПредставлениеПути(Знач Путь)
	Возврат ?(ПустаяСтрока(Путь), НСтр("ru = '(корень)'; en = '(root)'"), Путь);
КонецФункции

// Возвращает префикс "<путь>: " для сообщения об ошибке (пустой для корня).
Функция ПрефиксПути(Знач Путь)
	Возврат ?(ПустаяСтрока(Путь), "", Путь + ": ");
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Проверка размера аргументов tool (UTIL-03).

// Возвращает лимит размера аргументов tool по умолчанию: 65536 байт (64 KB).
// Именованная функция документирует смысл магического числа и упрощает его
// изменение в одном месте.
Функция МаксРазмерАргументовToolПоУмолчанию()
	Возврат 65536; // 64 KB
КонецФункции

// Точный подсчёт размера строки в байтах кодировки UTF-8.
//
// СтрДлина возвращает число символов, а не байт; эвристика «символы * N»
// ненадёжна для смешанного ASCII + кириллица. ПолучитьДвоичныеДанныеИзСтроки
// с третьим параметром Ложь (без BOM) даёт точный размер. Доступна на сервере.
//
// Параметры:
//   Строка - Строка - исходная строка.
//
// Возвращаемое значение:
//   Число - размер в байтах UTF-8 (0 для незаполненной строки).
Функция РазмерСтрокиВБайтах(Знач Строка)

	Если НЕ ЗначениеЗаполнено(Строка) Тогда
		Возврат 0;
	КонецЕсли;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, КодировкаТекста.UTF8, Ложь);
	Возврат ДвоичныеДанные.Размер();

КонецФункции

// Возвращает человекочитаемое представление размера в KB с точностью 0.1 KB.
// Используется только для текста сообщения observation (не для сравнения).
Функция ПредставлениеРазмераKB(Знач РазмерБайт)
	Возврат СтрШаблон(
		НСтр("ru = '%1 KB'; en = '%1 KB'"),
		Формат(РазмерБайт / 1024, "ЧДЦ=1; ЧРД=.; ЧГ=0"));
КонецФункции

#КонецОбласти
