////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolРеестрПоиск (Tool - Реестр и поиск).
//
// Реализует tools:
//   find_tools    — скоринговый поиск по реестру ar_Tools (SCALE-03).
//   describe_tool — получение полных JSONManifest по списку имён (SCALE-03).
//
// Контракт tool-функций:
//   Вход:  Аргументы (Строка) — JSON-объект аргументов от LLM.
//          Контекст (Структура) — КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//   Выход: Строка JSON — observation для добавления в контекст как role:tool.
//          Никогда не пустая; при ошибке — {"error":"<код>"}.
//
// Обе операции read-only: побочных эффектов нет, DryRun игнорируется без
// ошибки (тот же паттерн, что и у ar_ToolUniversal/ar_ToolОтчёты).
// Привилегированный режим используется ТОЛЬКО в ЗарегистрироватьTools (запись
// в служебный реестр ar_Tools) — сама выдача читает данные в правах
// пользователя сессии (Plan §3.3).
//
// Скоринг по подстрокам (см. .docs/specs/SCALE-03.md, раздел «Алгоритм
// скоринга»): без полнотекстового индекса платформы — план прямо запрещает
// зависимость выдачи tools от состояния индекса прикладной базы. Известные
// ограничения платформенного СтрНайти (посимвольный, без word-boundary,
// «счет»/«счёт» — разные подстроки) — принятый компромисс, не дефект этого
// модуля: см. риски в спеке, попытки «починить» точечным патчем избыточны.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/SCALE-03.md, План-гибкие-tools.md §3.3, §3.4.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня модуля ar_ToolРеестрПоиск. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolРеестрПоиск.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры ("НайтиTools" / "ОписатьTools").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "НайтиTools" Тогда
		Возврат НайтиTools(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ОписатьTools" Тогда
		Возврат ОписатьTools(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Идемпотентно создаёт/обновляет записи реестра ar_Tools для tools
// find_tools и describe_tool (SCALE-03). Вызывается из
// ar_ToolDispatcher.ЗарегистрироватьВсеTools() и из обработчика обновления
// расширения. Привилегированный режим включается локально только для записи
// в служебный реестр ядра, с парным сбросом в блоке Исключение (Plan §1.3).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } — статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинИнструмент(ОписаниеToolFindTools(), Статистика);
		ЗарегистрироватьОдинИнструмент(ОписаниеToolDescribeTool(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

// Tool find_tools: скоринговый поиск по реестру ar_Tools (подстроки, без
// полнотекстового индекса платформы).
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM. Поля:
//    query    (обяз.) - строка поиска, разбивается на слова по пробелу.
//    category (опц.)  - код категории (ar_КатегорииTools), точный предфильтр.
//    limit    (опц.)  - макс. строк в выдаче, 1..20, деф. 5.
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//
// Возвращаемое значение:
//  Строка - JSON {"items":[{name,short_description,category,risk_level}],
//                 "total_found":N,"limit":N} либо {"error":"<код>"}.
//
Функция НайтиTools(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Возврат НайтиToolsВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool describe_tool: полный JSONManifest по списку имён tools.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM. Поля:
//    names (обяз.) - массив строк, 1..10 элементов.
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//
// Возвращаемое значение:
//  Строка - JSON {"tools":[{name,manifest:{...}}],"not_found":[...]}
//           либо {"error":"<код>"[,"max":N]}.
//
Функция ОписатьTools(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Возврат ОписатьToolsВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// find_tools: скоринг по подстрокам.

// Основная логика tool find_tools. Выделена из НайтиTools, чтобы внешний
// Попытка/Исключение ловил любые непредвиденные ошибки.
//
// Алгоритм (см. .docs/specs/SCALE-03.md, раздел «Алгоритм скоринга»):
//  1. Нормализация query: ВРег(СокрЛП(...)), разбивка на слова по пробелу
//     (СтрРазделить с исключением пустых). Пустой query → query_required.
//  2. Предфильтр по category (если задан) — точное сравнение кода, ДО скоринга.
//  3. Скоринг каждой оставшейся записи: сумма весов полей, в которых найдена
//     подстрокой каждая нормализованная словоформа (вес не ограничивается и
//     не отнимается при совпадении в нескольких полях сразу).
//  4. Отсечка записей с итоговым баллом 0.
//  5. Сортировка: по убыванию балла, при равенстве — по возрастанию ar_Имя.
//  6. Обрезка до limit, total_found — количество прошедших отсечку/предфильтр.
//
Функция НайтиToolsВнутр(Знач Аргументы, Знач Контекст)

	ДанныеJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	СтрокаЗапроса = СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "query", "")));
	Если ПустаяСтрока(СтрокаЗапроса) Тогда
		Возврат ОшибочныйJSON("query_required");
	КонецЕсли;

	// ВключатьПустые = Ложь: при двойном пробеле в запросе иначе попадёт пустая
	// строка, а СтрНайти(ЛюбоеПоле, "") истинно всегда - каждый кандидат получил
	// бы полный бонус по всем полям (5+3+2+1), и отсечка по нулевому баллу
	// перестала бы отсекать нерелевантное. [Реф: БСП/ОбщегоНазначенияКлиентСервер
	// - там для той же цели передаётся Ложь]
	СловаЗапроса = СтрРазделить(ВРег(СтрокаЗапроса), " ", Ложь);
	Если СловаЗапроса.Количество() = 0 Тогда
		Возврат ОшибочныйJSON("query_required");
	КонецЕсли;

	Категория = СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "category", "")));
	Лимит = НормализоватьЛимитПоиска(ЗначениеПоКлючу(ДанныеJSON, "limit", ЛимитПоискаПоУмолчанию()));

	Кандидаты = ЗагрузитьКандидатовДляПоиска(Категория);

	СПоказателями = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Балл = ВычислитьБаллСкоринга(Кандидат, СловаЗапроса);
		Если Балл > 0 Тогда
			Запись = Новый Структура;
			Запись.Вставить("Кандидат", Кандидат);
			Запись.Вставить("Балл", Балл);
			СПоказателями.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	ОтсортироватьПоБаллуИИмени(СПоказателями);

	Элементы = Новый Массив;
	Для Каждого Запись Из СПоказателями Цикл
		Если Элементы.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Элементы.Добавить(ЭлементОтветаFindTools(Запись.Кандидат));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("total_found", СПоказателями.Количество());
	Результат.Вставить("limit", Лимит);

	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Приводит значение параметра limit к диапазону [1..МаксимумЛимитаПоиска()],
// дефолт ЛимитПоискаПоУмолчанию() (find_tools — инструмент навигации, не
// выгрузки, см. спеку §3).
//
Функция НормализоватьЛимитПоиска(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат ЛимитПоискаПоУмолчанию();
	КонецЕсли;
	Цел = Цел(Значение);
	Если Цел < 1 ИЛИ Цел > МаксимумЛимитаПоиска() Тогда
		Возврат ЛимитПоискаПоУмолчанию();
	КонецЕсли;
	Возврат Цел;
КонецФункции

// Значение limit по умолчанию для find_tools, если параметр не передан
// или некорректен (см. спеку §3).
Функция ЛимитПоискаПоУмолчанию()
	Возврат 5;
КонецФункции

// Верхняя граница параметра limit для find_tools (см. спеку §3: реестр
// tools на порядок меньше метаданных конфигурации, цель - не заливать
// контекст десятками манифестов).
Функция МаксимумЛимитаПоиска()
	Возврат 20;
КонецФункции

// Загружает кандидатов для скоринга: только ar_Включён/ar_Доступен = Истина,
// без пометки удаления (те же условия, что у СобратьОпределенияTools,
// Module.bsl:454-455). Category, если задана — точный предфильтр ДО скоринга.
// ar_Описание (500-символьный технический текст) НЕ читается вообще — он не
// участвует в скоринге (см. спеку §2).
//
// Каждая строка выборки конвертируется в Структуру со значениями полей —
// ВЫБОРКА ИЗ РЕЗУЛЬТАТА ЗАПРОСА НЕ СОХРАНЯЕТСЯ В МАССИВЕ КАК ЕСТЬ: это курсор,
// а не значение, после цикла все элементы указывали бы на один и тот же
// объект в последнем состоянии (задокументированный дефект проекта, уже
// дважды пойманный в этой сессии).
//
// Параметры:
//  Категория - Строка - код категории (ar_Категория) для точного предфильтра;
//              пустая строка - без фильтра по категории.
//
// Возвращаемое значение:
//  Массив(Структура{Имя,КраткоеОписание,КлючевыеСловаПараметров,Категория,RiskLevel}).
//
Функция ЗагрузитьКандидатовДляПоиска(Знач Категория)

	// Два разных текста запроса вместо "ИЛИ" в ГДЕ (условие по категории
	// либо есть, либо его нет вообще) - тот же приём, что уже принят в
	// aosPersonalData.ЕстьПравилоПолногоСокрытияЗапрос: не приводит к
	// предупреждению статического анализа LogicalOrInTheWhereSectionOfQuery.
	Запрос = Новый Запрос;
	Если ПустаяСтрока(Категория) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Tools.ar_Имя КАК Имя,
			|	Tools.ar_КраткоеОписание КАК КраткоеОписание,
			|	Tools.ar_КлючевыеСловаПараметров КАК КлючевыеСловаПараметров,
			|	Tools.ar_Категория КАК Категория,
			|	Tools.ar_RiskLevel КАК RiskLevel
			|ИЗ
			|	Справочник.ar_Tools КАК Tools
			|ГДЕ
			|	НЕ Tools.ПометкаУдаления
			|	И Tools.ar_Включён
			|	И Tools.ar_Доступен";
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Tools.ar_Имя КАК Имя,
			|	Tools.ar_КраткоеОписание КАК КраткоеОписание,
			|	Tools.ar_КлючевыеСловаПараметров КАК КлючевыеСловаПараметров,
			|	Tools.ar_Категория КАК Категория,
			|	Tools.ar_RiskLevel КАК RiskLevel
			|ИЗ
			|	Справочник.ar_Tools КАК Tools
			|ГДЕ
			|	НЕ Tools.ПометкаУдаления
			|	И Tools.ar_Включён
			|	И Tools.ar_Доступен
			|	И Tools.ar_Категория = &Категория";
		Запрос.УстановитьПараметр("Категория", Категория);
	КонецЕсли;

	Кандидаты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кандидат = Новый Структура;
		Кандидат.Вставить("Имя", Выборка.Имя);
		Кандидат.Вставить("КраткоеОписание", СокрЛП(Выборка.КраткоеОписание));
		Кандидат.Вставить("КлючевыеСловаПараметров", СокрЛП(Выборка.КлючевыеСловаПараметров));
		Кандидат.Вставить("Категория", Выборка.Категория);
		Кандидат.Вставить("RiskLevel", Строка(Выборка.RiskLevel));
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

// Вычисляет итоговый балл скоринга одного кандидата: сумма весов полей, в
// которых найдена подстрокой хотя бы одна словоформа запроса (по каждой
// словоформе отдельно — совпадение в нескольких полях не ограничивается).
// Веса — см. .docs/specs/SCALE-03.md, таблица «Поля скоринга и веса»:
//   ar_Имя (5), ar_КраткоеОписание (3), ar_КлючевыеСловаПараметров (2),
//   ar_Категория (1). Поиск регистронезависимый — поля кандидата приводятся
//   к верхнему регистру здесь же, слова запроса уже в ВРег (см. вызывающий код).
//
// Параметры:
//  Кандидат     - Структура - {Имя,КраткоеОписание,КлючевыеСловаПараметров,Категория,RiskLevel}.
//  СловаЗапроса - Массив(Строка) - нормализованные (ВРег) словоформы запроса.
//
// Возвращаемое значение:
//  Число - суммарный балл (0, если ни одно слово не найдено ни в одном поле).
//
Функция ВычислитьБаллСкоринга(Знач Кандидат, Знач СловаЗапроса)

	ИмяВРег              = ВРег(Кандидат.Имя);
	КраткоеОписаниеВРег  = ВРег(Кандидат.КраткоеОписание);
	КлючевыеСловаВРег    = ВРег(Кандидат.КлючевыеСловаПараметров);
	КатегорияВРег        = ВРег(Кандидат.Категория);

	Балл = 0;
	Для Каждого Слово Из СловаЗапроса Цикл
		Если СтрНайти(ИмяВРег, Слово) > 0 Тогда
			Балл = Балл + ВесПоляИмя();
		КонецЕсли;
		Если СтрНайти(КраткоеОписаниеВРег, Слово) > 0 Тогда
			Балл = Балл + ВесПоляКраткоеОписание();
		КонецЕсли;
		Если СтрНайти(КлючевыеСловаВРег, Слово) > 0 Тогда
			Балл = Балл + ВесПоляКлючевыеСлова();
		КонецЕсли;
		Если СтрНайти(КатегорияВРег, Слово) > 0 Тогда
			Балл = Балл + ВесПоляКатегория();
		КонецЕсли;
	КонецЦикла;

	Возврат Балл;

КонецФункции

// Веса полей скоринга find_tools (см. .docs/specs/SCALE-03.md, таблица
// «Поля скоринга и веса»). ar_Имя — самый надёжный сигнал (точный
// технический идентификатор), ar_Категория — самый слабый (короткий код,
// может случайно совпасть частью другого слова).
Функция ВесПоляИмя()
	Возврат 5;
КонецФункции

Функция ВесПоляКраткоеОписание()
	Возврат 3;
КонецФункции

Функция ВесПоляКлючевыеСлова()
	Возврат 2;
КонецФункции

Функция ВесПоляКатегория()
	Возврат 1;
КонецФункции

// Сортирует массив записей {Кандидат, Балл} по убыванию балла, при равенстве
// баллов - по возрастанию ar_Имя (детерминизм между вызовами, спека §2).
// Простая сортировка вставками - объём (сотни записей максимум) не требует
// более сложного алгоритма.
//
Процедура ОтсортироватьПоБаллуИИмени(МассивЗаписей)

	Всего = МассивЗаписей.Количество();
	Если Всего < 2 Тогда
		Возврат;
	КонецЕсли;

	Для Индекс = 1 По Всего - 1 Цикл
		Текущая = МассивЗаписей[Индекс];
		Позиция = Индекс;
		Пока Позиция > 0
			И ЗаписьДолжнаБытьРанее(Текущая, МассивЗаписей[Позиция - 1]) Цикл
			МассивЗаписей[Позиция] = МассивЗаписей[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		МассивЗаписей[Позиция] = Текущая;
	КонецЦикла;

КонецПроцедуры

// Компаратор для ОтсортироватьПоБаллуИИмени: Истина, если ЗаписьА должна
// стоять СТРОГО РАНЬШЕ ЗаписьБ в итоговой выдаче (больший балл, либо равный
// балл и лексикографически меньшее имя). Имя переопределено сознательно -
// это не числовое "меньше", а порядок в отсортированном списке (спека §2,
// «Порядок сортировки»).
//
Функция ЗаписьДолжнаБытьРанее(Знач ЗаписьА, Знач ЗаписьБ)
	Если ЗаписьА.Балл <> ЗаписьБ.Балл Тогда
		Возврат ЗаписьА.Балл > ЗаписьБ.Балл;
	КонецЕсли;
	Возврат ЗаписьА.Кандидат.Имя < ЗаписьБ.Кандидат.Имя;
КонецФункции

// Собирает один элемент ответа find_tools по кандидату.
//
Функция ЭлементОтветаFindTools(Знач Кандидат)
	Элемент = Новый Структура;
	Элемент.Вставить("name", Кандидат.Имя);
	Элемент.Вставить("short_description", Кандидат.КраткоеОписание);
	Элемент.Вставить("category", Кандидат.Категория);
	Элемент.Вставить("risk_level", Кандидат.RiskLevel);
	Возврат Элемент;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// describe_tool: полный манифест по списку имён.

// Основная логика tool describe_tool. Выделена из ОписатьTools, чтобы внешний
// Попытка/Исключение ловил любые непредвиденные ошибки.
//
// Алгоритм (см. .docs/specs/SCALE-03.md, раздел «Что возвращает describe_tool»):
//  1. Десериализация + валидация names (обязательный массив строк,
//     1..МаксимумИмёнDescribeTool()).
//  2. Для каждого имени - поиск в ar_Tools с тем же отбором доступности, что
//     и в find_tools (ar_Включён/ar_Доступен=Истина, без пометки удаления).
//     Не найдено -> в массив not_found, остальные обрабатываются штатно
//     (graceful degradation, не ошибка всего вызова).
//  3. Для найденных - полный ar_JSONManifest, распарсенный ar_JSON.ИзJSON
//     (JSON-объект, не строка).
//
Функция ОписатьToolsВнутр(Знач Аргументы, Знач Контекст)

	ДанныеJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	Имена = ЗначениеПоКлючу(ДанныеJSON, "names", Неопределено);
	Если ТипЗнч(Имена) <> Тип("Массив") ИЛИ Имена.Количество() = 0 Тогда
		Возврат ОшибочныйJSON("invalid arguments: names is required (non-empty array)");
	КонецЕсли;
	Если Имена.Количество() > МаксимумИмёнDescribeTool() Тогда
		Возврат ОшибочныйJSONСМаксимумом("too_many_names", МаксимумИмёнDescribeTool());
	КонецЕсли;

	// Нормализация входных имён ДО запроса - пустые элементы пропускаются,
	// дубликаты не мешают (Соответствие ниже естественно схлопнет повторы).
	НормализованныеИмена = Новый Массив;
	Для Каждого ИмяЭлемента Из Имена Цикл
		ИмяTool = СокрЛП(Строка(ИмяЭлемента));
		Если Не ПустаяСтрока(ИмяTool) Тогда
			НормализованныеИмена.Добавить(ИмяTool);
		КонецЕсли;
	КонецЦикла;

	// Один batch-запрос вместо запроса в цикле по каждому имени - тот же
	// приём, что и ar_RuntimeЦикл.ОпределенияToolsПоИменам ("ar_Имя В (&Имена)").
	МанифестыПоИмени = ЗагрузитьДоступныеМанифестыПоИменам(НормализованныеИмена);

	НайденныеTools = Новый Массив;
	НеНайденныеИмена = Новый Массив;

	Для Каждого ИмяTool Из НормализованныеИмена Цикл
		МанифестJSON = МанифестыПоИмени.Получить(ИмяTool);
		Если МанифестJSON = Неопределено Тогда
			НеНайденныеИмена.Добавить(ИмяTool);
			Продолжить;
		КонецЕсли;

		// Защита от повреждённого ar_JSONManifest (не должно происходить в
		// норме - манифест пишется тем же ar_JSON.ВЗначениеJSON при
		// регистрации, но graceful degradation дешевле необработанного
		// исключения на середине цикла, паттерн ar_RuntimeЦикл.ОпределенияToolsПоИменам).
		РазобранныйМанифест = ar_JSON.ИзJSON(МанифестJSON);
		Если РазобранныйМанифест = Неопределено Тогда
			НеНайденныеИмена.Добавить(ИмяTool);
			Продолжить;
		КонецЕсли;

		ЭлементОтвета = Новый Структура;
		ЭлементОтвета.Вставить("name", ИмяTool);
		ЭлементОтвета.Вставить("manifest", РазобранныйМанифест);
		НайденныеTools.Добавить(ЭлементОтвета);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("tools", НайденныеTools);
	Результат.Вставить("not_found", НеНайденныеИмена);

	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Ищет ar_JSONManifest доступных tools по списку имён ЗА ОДИН ЗАПРОС (не в
// цикле). Тот же отбор доступности, что у find_tools и у
// СобратьОпределенияTools (Module.bsl:454-455): ar_Включён=Истина,
// ar_Доступен=Истина, без пометки удаления.
//
// Параметры:
//  ИменаTools - Массив(Строка) - нормализованные (СокрЛП, непустые) имена ar_Имя.
//
// Возвращаемое значение:
//  Соответствие - Ключ(Строка, ar_Имя) → Значение(Строка, ar_JSONManifest).
//                 Имена, не найденные либо не доступные, в Соответствии отсутствуют.
//
Функция ЗагрузитьДоступныеМанифестыПоИменам(Знач ИменаTools)

	МанифестыПоИмени = Новый Соответствие;
	Если ИменаTools.Количество() = 0 Тогда
		Возврат МанифестыПоИмени;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имена", ИменаTools);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_JSONManifest КАК JSONManifest
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления
		|	И Tools.ar_Включён
		|	И Tools.ar_Доступен
		|	И Tools.ar_Имя В (&Имена)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Значение поля выборки - строка, не курсор: кладём именно её, не саму
		// Выборку (курсор перезаписывается на каждой итерации цикла).
		МанифестыПоИмени.Вставить(Выборка.Имя, Выборка.JSONManifest);
	КонецЦикла;

	Возврат МанифестыПоИмени;

КонецФункции

// Верхняя граница размера массива names у describe_tool (защита от
// раздувания ответа за один вызов, спека §4 - план явных границ не задаёт,
// решение аналитика).
Функция МаксимумИмёнDescribeTool()
	Возврат 10;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Общие служебные функции модуля.

// Безопасно получить значение из Соответствия по ключу с дефолтом.
//
Функция ЗначениеПоКлючу(Знач Соответствие, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(Соответствие) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Соответствие.Получить(Ключ);
	Возврат ?(Значение = Неопределено, Дефолт, Значение);
КонецФункции

// JSON-строка ошибки-observation: {"error":"<текст>"}.
//
Функция ОшибочныйJSON(Знач ТекстОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""tool_error""}", Результат);
КонецФункции

// JSON-строка ошибки-observation с максимальным допустимым значением:
// {"error":"<код>","max":N}. Используется describe_tool при превышении
// лимита размера массива names (спека §4, DoD D9).
//
Функция ОшибочныйJSONСМаксимумом(Знач КодОшибки, Знач Максимум)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(КодОшибки) = Тип("Строка"), КодОшибки, ""));
	Объект.Вставить("max", Максимум);
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""tool_error""}", Результат);
КонецФункции

// Описание tool find_tools для регистрации в ar_Tools.
//
Функция ОписаниеToolFindTools()

	// OpenAI tool-format (parameters, не Anthropic input_schema) - единый
	// контракт для всех LLM-провайдеров, включая OpenAI-совместимые локальные
	// (LM Studio и т.п.). Без него провайдер возвращает 400 на список tools
	// (см. ar_ToolUniversal.МанифестTool - образец контракта).
	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""find_tools"",
	|    ""description"": ""Ищет доступные tools по запросу на естественном языке или по имени параметра. Используй, когда нужный tool не входит в текущий набор доступных инструментов - опиши, что нужно сделать, словами."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""query""],
	|      ""properties"": {
	|        ""query"": {
	|          ""type"": ""string"",
	|          ""description"": ""Запрос на естественном языке или ключевое слово (например имя параметра). Разбивается на отдельные слова, каждое ищется подстрокой.""
	|        },
	|        ""category"": {
	|          ""type"": ""string"",
	|          ""description"": ""Опциональный код категории для точного предфильтра (например finance, documents, crm).""
	|        },
	|        ""limit"": {
	|          ""type"": ""number"",
	|          ""description"": ""Максимум записей в выдаче. Диапазон 1..20, по умолчанию 5."",
	|          ""default"": 5
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя",              "find_tools");
	Описание.Вставить("Описание",
		НСтр("ru = 'Поиск доступных tools по запросу на естественном языке или по имени параметра, скоринг по подстрокам.';
		|en = 'Search available tools by natural-language query or parameter name, substring scoring.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Найти подходящий инструмент по описанию задачи';
		|en = 'Find a matching tool by task description'"));
	Описание.Вставить("ОбщийМодуль",      "ar_ToolРеестрПоиск");
	Описание.Вставить("ИмяПроцедуры",     "НайтиTools");
	Описание.Вставить("RiskLevel",        "Read");
	Описание.Вставить("ТребуетApproval",  Ложь);
	Описание.Вставить("Включён",          Истина);
	Описание.Вставить("Категория",        "platform");
	Описание.Вставить("Версия",           "1.0.0");
	Описание.Вставить("JSONManifest",     МанифестJSON);
	Возврат Описание;

КонецФункции

// Описание tool describe_tool для регистрации в ar_Tools.
//
Функция ОписаниеToolDescribeTool()

	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""describe_tool"",
	|    ""description"": ""Возвращает полное описание (JSON-манифест) одного или нескольких tools по их именам. Используй после find_tools, чтобы получить точные параметры перед вызовом."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""names""],
	|      ""properties"": {
	|        ""names"": {
	|          ""type"": ""array"",
	|          ""items"": { ""type"": ""string"" },
	|          ""description"": ""Имена tools для описания. От 1 до 10 элементов за один вызов."",
	|          ""minItems"": 1,
	|          ""maxItems"": 10
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя",              "describe_tool");
	Описание.Вставить("Описание",
		НСтр("ru = 'Получить полный JSON-манифест одного или нескольких tools по именам.';
		|en = 'Get the full JSON manifest of one or more tools by name.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Получить полное описание найденного инструмента';
		|en = 'Get the full description of a found tool'"));
	Описание.Вставить("ОбщийМодуль",      "ar_ToolРеестрПоиск");
	Описание.Вставить("ИмяПроцедуры",     "ОписатьTools");
	Описание.Вставить("RiskLevel",        "Read");
	Описание.Вставить("ТребуетApproval",  Ложь);
	Описание.Вставить("Включён",          Истина);
	Описание.Вставить("Категория",        "platform");
	Описание.Вставить("Версия",           "1.0.0");
	Описание.Вставить("JSONManifest",     МанифестJSON);
	Возврат Описание;

КонецФункции

// Создать или обновить одну запись в ar_Tools по описанию.
// Ищет по ar_Имя среди непомеченных. При нахождении — обновляет, иначе создаёт.
// ar_Категория проставляется отдельным полем (SCALE-01: технический код,
// не русский текст) — образец ar_ToolПамять.ЗарегистрироватьОдинИнструмент
// не заполняет её (модуль памяти не относится ни к одной прикладной
// категории), здесь заполняем явно кодом "platform".
//
Процедура ЗарегистрироватьОдинИнструмент(Знач Описание, Статистика)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", Описание.Имя);

	Выборка = Запрос.Выполнить().Выбрать();

	НачатьТранзакцию();
	Попытка
		Если Выборка.Следующий() Тогда
			ОбъектИнструмент = Выборка.Ссылка.ПолучитьОбъект();
			Статистика.Обновлено = Статистика.Обновлено + 1;
		Иначе
			ОбъектИнструмент = Справочники.ar_Tools.СоздатьЭлемент();
			Статистика.Создано = Статистика.Создано + 1;
		КонецЕсли;

		ОбъектИнструмент.Наименование        = Описание.Имя;
		ОбъектИнструмент.ar_Имя              = Описание.Имя;
		ОбъектИнструмент.ar_Описание         = Описание.Описание;
		ОбъектИнструмент.ar_КраткоеОписание  = Описание.КраткоеОписание;
		ОбъектИнструмент.ar_ОбщийМодуль      = Описание.ОбщийМодуль;
		ОбъектИнструмент.ar_ИмяПроцедуры     = Описание.ИмяПроцедуры;
		ОбъектИнструмент.ar_ТребуетApproval  = Описание.ТребуетApproval;
		ОбъектИнструмент.ar_Включён          = Описание.Включён;
		ОбъектИнструмент.ar_Категория        = Описание.Категория;
		ОбъектИнструмент.ar_Версия           = Описание.Версия;
		ОбъектИнструмент.ar_JSONManifest     = Описание.JSONManifest;

		// Установка RiskLevel через перечисление (образец: ar_ToolПамять.ПолучитьУровеньРиска).
		ОбъектИнструмент.ar_RiskLevel = ПолучитьУровеньРиска(Описание.RiskLevel);

		// Справочник записывается без параметров.
		ОбъектИнструмент.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Получить ссылку перечисления ar_RiskLevel по строковому имени.
// При неизвестном имени возвращает Read (безопасный дефолт).
//
Функция ПолучитьУровеньРиска(Знач ИмяЗначения)
	Если ТипЗнч(ИмяЗначения) <> Тип("Строка") Тогда
		Возврат Перечисления.ar_RiskLevel.Read;
	КонецЕсли;
	Для Каждого ЗначМД Из Метаданные.Перечисления.ar_RiskLevel.ЗначенияПеречисления Цикл
		Если ЗначМД.Имя = ИмяЗначения Тогда
			Возврат Перечисления.ar_RiskLevel[ЗначМД.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Перечисления.ar_RiskLevel.Read;
КонецФункции

#КонецОбласти
