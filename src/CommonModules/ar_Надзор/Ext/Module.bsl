////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Надзор (CONS-10: надзор за достижением цели).
//
// Проверяет, действительно ли агент достиг цели своего запуска, в момент
// завершения ReAct-цикла (ar_RuntimeЦикл.ВыполнитьАгентаВнутр, ветки
// run_completed и max_steps_reached). Единственная экспортная функция -
// ПроверитьДостижениеЦели - вызывается ПЕРЕД ЗавершитьЗапуск и НИКОГДА не
// меняет итоговый статус запуска (Completed/MaxStepsReached остаются как
// есть) - вердикт пишется отдельно в ar_Запуски.ar_ПоследнееРешениеНадзора.
//
// Включен по умолчанию, без константы-выключателя (решение 9/10) - это
// часть контракта автономной системы, а не опция.
//
// БЕЗОПАСНОСТЬ (D7): любая ошибка внутри модуля (исключение, недоступность
// LLM, мусор в JSON-ответе) перехватывается и не пробрасывается наружу -
// надзор врезан в общий путь завершения ЛЮБОГО запуска расширения.
//
// Рекурсия (D10): обращение к LLM идет напрямую через ar_LLMДиспетчер.Вызвать,
// без ar_RuntimeЦикл.ВыполнитьАгента/ar_RuntimeЗапуск.Стартовать* - надзор не
// может запустить новый агентный цикл.
//
// Свойства модуля: Сервер, НеГлобальный, Привилегированный = Ложь. Запись
// событий/вердикта делегируется привилегированным фасадам
// ar_AuditЗащищённыйРежим/ar_AuditЗапуски, как это уже сделано в
// ar_RuntimeЦикл.
//
// См. спеку: .docs/specs/CONS-10.md, План-консоль-автономных-агентов.md §3.1,
// §3.2, §3.4.
////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверить, действительно ли агент достиг цели своего запуска (CONS-10,
// Plan §3.2, §3.4). Вызывается ИСКЛЮЧИТЕЛЬНО из ar_RuntimeЦикл.ВыполнитьАгентаВнутр
// в двух точках - ветка run_completed и ветка max_steps_reached, ПЕРЕД вызовом
// ЗавершитьЗапуск. Не вызывается для Cancelled/DeniedGlobally/PausedForApproval/
// PausedForInput/FailedIncompatibleState/Failed - для этих статусов нет
// финального текстового ответа, который можно классифицировать.
//
// КОНТРАКТ БЕЗОПАСНОСТИ (важнее самой логики надзора, D7): функция НЕ
// пробрасывает исключения наружу ни при каких обстоятельствах - недоступность
// LLM, некорректный JSON, любая ошибка внутри классификации перехватывается
// и превращается в вердикт "Продолжить" (безопасный default: не выдаем
// ложноположительный "ЦельДостигнута" при сбое надзора, но и не роняем
// запуск). Надзор врезан в ОБЩИЙ путь завершения цикла - любой необработанный
// сбой здесь заденет каждый штатный запуск расширения.
//
// Рекурсия: функция обращается к LLM ТОЛЬКО напрямую через
// ar_LLMДиспетчер.Вызвать - не вызывает ar_RuntimeЦикл.ВыполнитьАгента и не
// планирует новых запусков (RunId) ни в одной ветке.
//
// Параметры:
//  RunId            - Строка(36) - идентификатор текущего запуска.
//  Состояние        - Структура - состояние цикла на момент завершения (см.
//                     ar_RuntimeЦикл, шапка модуля); читаются Результат,
//                     Сообщения, ИнструкцияДобавка.
//  ДанныеАгента     - Структура - данные агента (ПрочитатьДанныеАгента):
//                     Ссылка, Инструкция, LLMПровайдер, Модель.
//  КонтекстТриггера - Структура, Неопределено - {Триггер - Строка}.
//
// Возвращаемое значение:
//  Строка - имя значения ar_ВердиктНадзора ("ЦельДостигнута"/"Продолжить"/
//  "Эскалировать"). При любом внутреннем сбое - "Продолжить".
//
Функция ПроверитьДостижениеЦели(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач КонтекстТриггера) Экспорт

	Попытка
		Возврат ПроверитьДостижениеЦелиВнутр(RunId, Состояние, ДанныеАгента, КонтекстТриггера);
	Исключение
		// D7: сбой надзора не должен уронить запуск и не должен пролезть наружу.
		// Best-effort лог, best-effort событие - обе попытки в собственных Try,
		// чтобы даже ошибка логирования не сломала контракт "не бросать наружу".
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;

		Попытка
			ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_failed",
				"Сбой надзора, вердикт по умолчанию Продолжить. " + ТекстОшибки,
				"Ошибка", RunId);
		Исключение
			// Проглатываем - логирование не является критичным путем, но пишем
			// в системный журнал как последний рубеж диагностики.
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Supervisor.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Надзор: не удалось записать supervisor_failed в ar_СлужебныйЛог");
		КонецПопытки;

		Возврат "Продолжить";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика без внешнего перехвата исключений (он в ПроверитьДостижениеЦели).
//
// Параметры:
//  RunId            - Строка(36) - идентификатор текущего запуска.
//  Состояние        - Структура - состояние цикла на момент завершения.
//  ДанныеАгента     - Структура - данные агента (ПрочитатьДанныеАгента).
//  КонтекстТриггера - Структура, Неопределено - {Триггер - Строка}.
//
// Возвращаемое значение:
//  Строка - имя значения ar_ВердиктНадзора.
//
Функция ПроверитьДостижениеЦелиВнутр(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач КонтекстТриггера)

	ФинальныйОтвет = "";
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("Результат", ФинальныйОтвет);
	КонецЕсли;
	ФинальныйОтвет = ?(ТипЗнч(ФинальныйОтвет) = Тип("Строка"), ФинальныйОтвет, "");

	Триггер = "manual";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("Триггер", Триггер);
	КонецЕсли;

	PayloadInvoked = Новый Структура;
	PayloadInvoked.Вставить("code", "supervisor_invoked");
	PayloadInvoked.Вставить("trigger", Триггер);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "SupervisorInvoked", PayloadInvoked);

	// Список фактически выполненных действий за RunId - тот же запрос-образец,
	// что уже используется формой ar_ПросмотрЗапуска для секции «Созданные
	// объекты 1С» (см. .docs/specs/CONS-10.md, «Платформенные API и БСП»).
	Действия = ВыбратьДействияЗапуска(RunId);

	// 1. Дешевая проверка без LLM (D4) - строго ДО обращения к LLM.
	ДешеваяПроверка = ПроверитьБезLLM(ФинальныйОтвет, Действия);
	Если ДешеваяПроверка.Сработала Тогда
		Вердикт = "Продолжить";
		ЗафиксироватьРешение(RunId, Вердикт, Истина);
		Возврат Вердикт;
	КонецЕсли;

	// 2. Обращение к LLM с отдельным, изолированным контекстом (D5, D6).
	Цель = СформироватьЦель(Триггер, Состояние, ДанныеАгента);
	Сводка = СформироватьСводку(Цель, ФинальныйОтвет, Действия);

	Контекст = Новый Структура;
	Контекст.Вставить("Сообщения", Новый Массив);
	Контекст.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольSystem(), СистемныйПромптНадзора()));
	Контекст.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), Сводка));
	Контекст.Вставить("Провайдер", ДанныеАгента.LLMПровайдер);
	МодельАгента = "";
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("Модель", МодельАгента);
	КонецЕсли;
	МодельАгентаЗадана = (ТипЗнч(МодельАгента) = Тип("Строка") И Не ПустаяСтрока(МодельАгента));
	Если МодельАгентаЗадана Тогда
		Контекст.Вставить("Модель", МодельАгента);
	КонецЕсли;

	ОтветLLM = ar_LLMДиспетчер.Вызвать(Контекст);

	Вердикт = РазобратьОтветНадзора(ОтветLLM);
	ЗафиксироватьРешение(RunId, Вердикт, Ложь);
	Возврат Вердикт;

КонецФункции

// Дешевая проверка без обращения к LLM (D4): отсекает очевидный случай, когда
// агент текстуально заявляет о созданном/измененном объекте, но ни одно
// действие с мутирующим RiskLevel (Draft/Write/Commit) не завершилось
// непустым ar_ResultRef - фактически ничего не создано/не изменено.
//
// Параметры:
//  ФинальныйОтвет - Строка - итоговый текст ответа агента.
//  Действия       - ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef
//                    (см. ВыбратьДействияЗапуска).
//
// Возвращаемое значение:
//  Структура {Сработала - Булево} - Истина, если дешевая проверка дала
//  однозначное «не выполнено» без обращения к LLM.
//
Функция ПроверитьБезLLM(Знач ФинальныйОтвет, Знач Действия)

	Результат = Новый Структура("Сработала", Ложь);

	ЗаявляетОСозданном = ТекстЗаявляетОСозданномОбъекте(ФинальныйОтвет);
	Если Не ЗаявляетОСозданном Тогда
		Возврат Результат;
	КонецЕсли;

	// Есть хотя бы одно мутирующее действие с непустым ResultRef -
	// заявление правдоподобно, дешевая проверка не отсекает без LLM.
	ЕстьМутирующийРезультат = Ложь;
	Для Каждого СтрокаДействия Из Действия Цикл
		RiskLevelИмя = "";
		Если ЗначениеЗаполнено(СтрокаДействия.RiskLevel) Тогда
			RiskLevelИмя = Строка(СтрокаДействия.RiskLevel);
		КонецЕсли;
		RiskLevelМутирующий = (RiskLevelИмя = "Draft" ИЛИ RiskLevelИмя = "Write" ИЛИ RiskLevelИмя = "Commit");
		РезультатПолучен = Не ПустаяСтрока(СтрокаДействия.ResultRef);
		Если RiskLevelМутирующий И РезультатПолучен Тогда
			ЕстьМутирующийРезультат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьМутирующийРезультат Тогда
		Результат.Сработала = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Эвристика: содержит ли текст финального ответа ключевые слова о созданном/
// измененном объекте (§3.2 контракта завершения, D4).
//
// Параметры:
//  Текст - Строка - итоговый текст ответа агента.
//
// Возвращаемое значение:
//  Булево - Истина, если текст содержит ключевое слово о созданном объекте.
//
Функция ТекстЗаявляетОСозданномОбъекте(Знач Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстНижнийРегистр = НРег(Текст);

	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("создал");
	КлючевыеСлова.Добавить("создан");
	КлючевыеСлова.Добавить("создано");
	КлючевыеСлова.Добавить("оформил");
	КлючевыеСлова.Добавить("оформлен");
	КлючевыеСлова.Добавить("записал");
	КлючевыеСлова.Добавить("записан");
	КлючевыеСлова.Добавить("сформировал");
	КлючевыеСлова.Добавить("сформирован");
	КлючевыеСлова.Добавить("добавил");
	КлючевыеСлова.Добавить("добавлен");
	КлючевыеСлова.Добавить("created");
	КлючевыеСлова.Добавить("added");
	КлючевыеСлова.Добавить("generated");
	КлючевыеСлова.Добавить("recorded");

	Для Каждого Слово Из КлючевыеСлова Цикл
		Если СтрНайти(ТекстНижнийРегистр, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Выбрать действия текущего запуска - имя tool, уровень риска, ResultRef.
// Паттерн запроса - CommonForms/ar_ПросмотрЗапуска/Ext/Form/Module.bsl,
// процедура ЗаполнитьСозданныеОбъекты (CONS-06 D1).
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef.
//
Функция ВыбратьДействияЗапуска(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", RunId);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Действия.ar_ИмяTool КАК ИмяTool,
	|	Действия.ar_RiskLevel КАК RiskLevel,
	|	Действия.ar_ResultRef КАК ResultRef
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_RunId = &RunId
	|УПОРЯДОЧИТЬ ПО
	|	Действия.ar_Sequence";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Источник формулировки цели (см. .docs/specs/CONS-10.md, «Источник формулировки
// цели», решение аналитика - переопределяет буквальную формулировку задачи).
//
// Параметры:
//  Триггер      - Строка - код триггера запуска ("manual"/"cron"/... ).
//  Состояние    - Структура - состояние цикла (используется ИнструкцияДобавка).
//  ДанныеАгента - Структура - данные агента (используется Инструкция).
//
// Возвращаемое значение:
//  Строка - формулировка цели для надзорного вызова LLM.
//
Функция СформироватьЦель(Знач Триггер, Знач Состояние, Знач ДанныеАгента)

	Если Триггер = "manual" ИЛИ СтрНайти(Триггер, "manual_chat") = 1 Тогда
		Возврат ПервоеСообщениеПользователя(Состояние);
	КонецЕсли;

	// cron/schedule, subscription/webhook, mention (рутина-триггер) - та же
	// комбинация, что видел агент в промпте: инструкция агента + (если
	// непусто) добавка рутины, уже посчитанная в Состояние.ИнструкцияДобавка.
	ИнструкцияАгента = "";
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("Инструкция", ИнструкцияАгента);
	КонецЕсли;
	ИнструкцияАгента = ?(ТипЗнч(ИнструкцияАгента) = Тип("Строка"), ИнструкцияАгента, "");

	ИнструкцияДобавка = "";
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("ИнструкцияДобавка", ИнструкцияДобавка);
	КонецЕсли;
	ИнструкцияДобавка = ?(ТипЗнч(ИнструкцияДобавка) = Тип("Строка"), ИнструкцияДобавка, "");

	Если Не ПустаяСтрока(ИнструкцияДобавка) Тогда
		Возврат СокрЛП(ИнструкцияАгента) + Символы.ПС + Символы.ПС + СокрЛП(ИнструкцияДобавка);
	КонецЕсли;

	Возврат СокрЛП(ИнструкцияАгента);

КонецФункции

// Первое сообщение role=user в Состояние.Сообщения - исходный запрос
// пользователя (manual/manual_chat*).
//
// Параметры:
//  Состояние - Структура - состояние цикла (используется Сообщения).
//
// Возвращаемое значение:
//  Строка - текст первого пользовательского сообщения либо пустая строка.
//
Функция ПервоеСообщениеПользователя(Знач Состояние)

	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Сообщения = Неопределено;
	Если Не Состояние.Свойство("Сообщения", Сообщения) ИЛИ ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Роль = "";
		Сообщение.Свойство("role", Роль);
		Если Роль = ar_LLMКонтракт.РольUser() Тогда
			Содержание = "";
			Сообщение.Свойство("content", Содержание);
			Возврат ?(ТипЗнч(Содержание) = Тип("Строка"), Содержание, "");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Системный промпт надзора (решение 9) - отдельный от системного промпта
// основного агента, не читается из ar_Агенты.
//
// Возвращаемое значение:
//  Строка - текст системного промпта надзорного LLM-вызова.
//
Функция СистемныйПромптНадзора()

	Возврат НСтр("ru = 'Ты - модуль надзора AgentRunner. Тебе дана цель, которую
		|должен был выполнить AI-агент, его финальный текстовый ответ и список
		|фактически выполненных действий (инструмент + признак, был ли получен
		|результат). Классифицируй исход СТРОГО одним JSON-объектом без пояснений
		|снаружи JSON: {""class"": ""выполнено""} - цель полностью достигнута
		|фактическими действиями или ответом; {""class"": ""нечего_делать"",
		|""reason"": ""<причина>""} - агент обоснованно определил, что действие
		|не требовалось; {""class"": ""не_выполнено""} - во всех остальных
		|случаях, включая расплывчатый ответ, отчет о намерениях без
		|подтвержденного результата, или явное расхождение между тем, что
		|заявлено в ответе, и тем, что реально сделано. Не выполняй никаких
		|действий сам, не предлагай продолжение - только классификация.';
		|en = 'You are the AgentRunner supervisor module. You are given the goal
		|an AI agent was supposed to accomplish, its final text answer, and the
		|list of actions it actually performed (tool name + whether a result was
		|produced). Classify the outcome as STRICTLY one JSON object with no text
		|outside the JSON: {""class"": ""выполнено""} - the goal was fully
		|achieved by actual actions or the answer; {""class"": ""нечего_делать"",
		|""reason"": ""<reason>""} - the agent correctly determined no action was
		|needed; {""class"": ""не_выполнено""} - all other cases, including vague
		|answers, reports of intent without a confirmed result, or a clear
		|mismatch between what is claimed and what was actually done. Do not take
		|any action yourself, do not propose continuation - classification only.'");

КонецФункции

// Сводка для user-сообщения надзорного вызова: цель, финальный ответ,
// список действий.
//
// Параметры:
//  Цель           - Строка - формулировка цели (СформироватьЦель).
//  ФинальныйОтвет - Строка - итоговый текст ответа агента.
//  Действия       - ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef.
//
// Возвращаемое значение:
//  Строка - текст user-сообщения для надзорного LLM-вызова.
//
Функция СформироватьСводку(Знач Цель, Знач ФинальныйОтвет, Знач Действия)

	СтрокиДействий = Новый Массив;
	Для Каждого СтрокаДействия Из Действия Цикл
		ИмяTool = Строка(СтрокаДействия.ИмяTool);
		ЕстьРезультат = Не ПустаяСтрока(СтрокаДействия.ResultRef);
		СтрокиДействий.Добавить(ИмяTool + " -> " + ?(ЕстьРезультат, "результат получен", "результата нет"));
	КонецЦикла;

	СпособДействий = ?(СтрокиДействий.Количество() = 0,
		НСтр("ru = '(действий не было)'; en = '(no actions)'"),
		СтрСоединить(СтрокиДействий, Символы.ПС));

	ЗаголовокЦель = НСтр("ru = 'Цель:'; en = 'Goal:'");
	ЗаголовокОтвет = НСтр("ru = 'Финальный ответ агента:'; en = 'Agent final answer:'");
	ЗаголовокДействия = НСтр("ru = 'Фактически выполненные действия:'; en = 'Actually performed actions:'");

	Возврат ЗаголовокЦель + Символы.ПС + Цель + Символы.ПС + Символы.ПС
		+ ЗаголовокОтвет + Символы.ПС + ФинальныйОтвет + Символы.ПС + Символы.ПС
		+ ЗаголовокДействия + Символы.ПС + СпособДействий;

КонецФункции

// Разобрать JSON-ответ LLM надзора и смэппить в ar_ВердиктНадзора (§3.2):
// "выполнено" -> ЦельДостигнута; "нечего_делать" (с непустым reason) ->
// ЦельДостигнута; все остальное (включая ошибку разбора/недоступность LLM) ->
// Продолжить. "Эскалировать" контракт завершения не производит (см. спеку,
// «Контракт завершения»).
//
Функция РазобратьОтветНадзора(Знач ОтветLLM)

	Если ТипЗнч(ОтветLLM) <> Тип("Структура") ИЛИ ОтветLLM.Успех <> Истина Тогда
		Возврат "Продолжить";
	КонецЕсли;

	СообщениеОтвета = Неопределено;
	ОтветLLM.Свойство("Сообщение", СообщениеОтвета);
	КонтентОтвета = "";
	Если ТипЗнч(СообщениеОтвета) = Тип("Структура") Тогда
		СообщениеОтвета.Свойство("content", КонтентОтвета);
	КонецЕсли;
	КонтентОтвета = ?(ТипЗнч(КонтентОтвета) = Тип("Строка"), КонтентОтвета, "");

	Разобрано = ar_JSON.ИзJSON(КонтентОтвета);
	Если Разобрано = Неопределено Тогда
		Возврат "Продолжить";
	КонецЕсли;

	Класс = "";
	Причина = "";
	Если ТипЗнч(Разобрано) = Тип("Соответствие") Тогда
		Класс = Строка(Разобрано.Получить("class"));
		Причина = Строка(Разобрано.Получить("reason"));
	ИначеЕсли ТипЗнч(Разобрано) = Тип("Структура") Тогда
		ЗначениеКласса = "";
		Разобрано.Свойство("class", ЗначениеКласса);
		Класс = Строка(ЗначениеКласса);
		ЗначениеПричины = "";
		Разобрано.Свойство("reason", ЗначениеПричины);
		Причина = Строка(ЗначениеПричины);
	Иначе
		Возврат "Продолжить";
	КонецЕсли;

	// §3.2: "выполнено" и "нечего_делать" (с непустой причиной) - оба класса
	// приравниваются к достижению цели, остальное - "Продолжить".
	КлассВыполнено = (Класс = "выполнено");
	КлассНечегоДелатьСПричиной = (Класс = "нечего_делать" И Не ПустаяСтрока(СокрЛП(Причина)));

	Если КлассВыполнено ИЛИ КлассНечегоДелатьСПричиной Тогда
		Возврат "ЦельДостигнута";
	Иначе
		Возврат "Продолжить";
	КонецЕсли;

КонецФункции

// Зафиксировать событие SupervisorDecision (для читаемости вызова из
// ПроверитьДостижениеЦелиВнутр).
//
// Параметры:
//  RunId                       - Строка(36) - идентификатор запуска.
//  Вердикт                     - Строка - имя значения ar_ВердиктНадзора.
//  ДешеваяПроверкаСработала    - Булево - сработала ли дешевая проверка без LLM.
//
Процедура ЗафиксироватьРешение(Знач RunId, Знач Вердикт, Знач ДешеваяПроверкаСработала)

	Payload = Новый Структура;
	Payload.Вставить("code", "supervisor_decision");
	Payload.Вставить("verdict", Вердикт);
	Payload.Вставить("cheap_check", ДешеваяПроверкаСработала);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "SupervisorDecision", Payload);

КонецПроцедуры

#КонецОбласти
