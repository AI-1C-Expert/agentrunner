////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Надзор (CONS-10: надзор за достижением цели).
//
// Проверяет, действительно ли агент достиг цели своего запуска, в момент
// завершения ReAct-цикла (ar_RuntimeЦикл.ВыполнитьАгентаВнутр, ветки
// run_completed и max_steps_reached). Единственная экспортная функция -
// ПроверитьДостижениеЦели - вызывается ПЕРЕД ЗавершитьЗапуск и НИКОГДА не
// меняет итоговый статус запуска (Completed/MaxStepsReached остаются как
// есть) - вердикт пишется отдельно в ar_Запуски.ar_ПоследнееРешениеНадзора.
//
// Включен по умолчанию, без константы-выключателя (решение 9/10) - это
// часть контракта автономной системы, а не опция.
//
// БЕЗОПАСНОСТЬ (D7): любая ошибка внутри модуля (исключение, недоступность
// LLM, мусор в JSON-ответе) перехватывается и не пробрасывается наружу -
// надзор врезан в общий путь завершения ЛЮБОГО запуска расширения.
//
// Рекурсия (D10): обращение к LLM идет напрямую через ar_LLMДиспетчер.Вызвать,
// без ar_RuntimeЦикл.ВыполнитьАгента/ar_RuntimeЗапуск.Стартовать* - надзор не
// может запустить новый агентный цикл.
//
// Свойства модуля: Сервер, НеГлобальный, Привилегированный = Ложь. Запись
// событий/вердикта делегируется привилегированным фасадам
// ar_AuditЗащищённыйРежим/ar_AuditЗапуски, как это уже сделано в
// ar_RuntimeЦикл.
//
// CONS-11 (детекция отсутствия прогресса, §3.3): расширяет модуль функцией
// РешитьПродолжатьЛи - вызывается ПОСЛЕ ПроверитьДостижениеЦели, когда та
// вернула "Продолжить", и решает, можно ли физически продолжить цикл тем же
// RunId (три независимых слоя - бюджет / result-aware отпечаток прохода /
// потолок 10 продолжений) или нужно эскалировать.
//
// БЕЗОПАСНЫЙ DEFAULT ПРИ СБОЕ ДЕТЕКТОРА (D10) - в ЭТУ сторону, а НЕ как D7
// выше: при сбое слоёв 1/2 default - ПРОДОЛЖАТЬ (Продолжать = Истина), не
// эскалировать и не останавливать. Обоснование (спека, «Риски», «Какая ошибка
// дороже»): ложный стоп ТЕРМИНАЛЕН и необратим - эскалация останавливает
// агента навсегда, автопопыток больше нет (решение 8). Ложное продолжение
// ограничено потолком 10 (слой 3) и стоит только денег на лишние LLM-вызовы.
// Поэтому единственный слой, которому разрешено остановить цикл при сбое
// СВОЕЙ проверки, - слой 3 (потолок): его чтение/инкремент выполняются
// НЕЗАВИСИМО от слоёв 1/2 и ДО них (см. РешитьПродолжатьЛиВнутр) - иначе
// систематический отказ слоёв 1/2 (например, регистр ar_ДействияАгента
// стабильно недоступен) обходил бы предохранитель и давал бесконечный цикл.
//
// См. спеку: .docs/specs/CONS-10.md, .docs/specs/CONS-11.md,
// План-консоль-автономных-агентов.md §3.1, §3.2, §3.3, §3.4.
////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверить, действительно ли агент достиг цели своего запуска (CONS-10,
// Plan §3.2, §3.4). Вызывается ИСКЛЮЧИТЕЛЬНО из ar_RuntimeЦикл.ВыполнитьАгентаВнутр
// в двух точках - ветка run_completed и ветка max_steps_reached, ПЕРЕД вызовом
// ЗавершитьЗапуск. Не вызывается для Cancelled/DeniedGlobally/PausedForApproval/
// PausedForInput/FailedIncompatibleState/Failed - для этих статусов нет
// финального текстового ответа, который можно классифицировать.
//
// КОНТРАКТ БЕЗОПАСНОСТИ (важнее самой логики надзора, D7): функция НЕ
// пробрасывает исключения наружу ни при каких обстоятельствах - недоступность
// LLM, некорректный JSON, любая ошибка внутри классификации перехватывается
// и превращается в вердикт "Продолжить" (безопасный default: не выдаем
// ложноположительный "ЦельДостигнута" при сбое надзора, но и не роняем
// запуск). Надзор врезан в ОБЩИЙ путь завершения цикла - любой необработанный
// сбой здесь заденет каждый штатный запуск расширения.
//
// Рекурсия: функция обращается к LLM ТОЛЬКО напрямую через
// ar_LLMДиспетчер.Вызвать - не вызывает ar_RuntimeЦикл.ВыполнитьАгента и не
// планирует новых запусков (RunId) ни в одной ветке.
//
// Параметры:
//  RunId            - Строка(36) - идентификатор текущего запуска.
//  Состояние        - Структура - состояние цикла на момент завершения (см.
//                     ar_RuntimeЦикл, шапка модуля); читаются Результат,
//                     Сообщения, ИнструкцияДобавка.
//  ДанныеАгента     - Структура - данные агента (ПрочитатьДанныеАгента):
//                     Ссылка, Инструкция, LLMПровайдер, Модель.
//  КонтекстТриггера - Структура, Неопределено - {Триггер - Строка}.
//
// Возвращаемое значение:
//  Строка - имя значения ar_ВердиктНадзора ("ЦельДостигнута"/"Продолжить"/
//  "Эскалировать"). При любом внутреннем сбое - "Продолжить".
//
Функция ПроверитьДостижениеЦели(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач КонтекстТриггера) Экспорт

	Попытка
		Возврат ПроверитьДостижениеЦелиВнутр(RunId, Состояние, ДанныеАгента, КонтекстТриггера);
	Исключение
		// D7: сбой надзора не должен уронить запуск и не должен пролезть наружу.
		// Best-effort лог, best-effort событие - обе попытки в собственных Try,
		// чтобы даже ошибка логирования не сломала контракт "не бросать наружу".
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;

		Попытка
			ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьДостижениеЦели", "supervisor_failed",
				"Сбой надзора, вердикт по умолчанию Продолжить. " + ТекстОшибки,
				"Ошибка", RunId);
		Исключение
			// Проглатываем - логирование не является критичным путем, но пишем
			// в системный журнал как последний рубеж диагностики.
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Supervisor.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Надзор: не удалось записать supervisor_failed в ar_СлужебныйЛог");
		КонецПопытки;

		Возврат "Продолжить";
	КонецПопытки;

КонецФункции

// CONS-11: три слоя детекции отсутствия прогресса. Вызывается ИСКЛЮЧИТЕЛЬНО
// из ar_RuntimeЦикл.ВыполнитьАгентаВнутр, ветка run_completed, СРАЗУ после
// ПроверитьДостижениеЦели, и только если та вернула "Продолжить" (для
// max_steps_reached слои 2/3 не применяются - см. .docs/specs/CONS-11.md,
// «Точка вызова трёх слоёв»; ar_RuntimeЦикл сам решает budget-эскалацию через
// ЗафиксироватьЭскалациюБюджета в этой ветке).
//
// Порядок (дешёвое сначала): 1) бюджет (ШаговВсего/ДействийВсего накопительно
// за RunId, не продлевается) 2) result-aware отпечаток прохода (2 подряд без
// изменений → эскалация) 3) потолок 10 продолжений (предохранитель,
// независимый от 1/2).
//
// БЕЗОПАСНОСТЬ (D10) - ВАЖНО, направление default ОБРАТНОЕ по сравнению с D7
// ar_Надзор.ПроверитьДостижениеЦели: при сбое слоёв 1 (бюджет) или 2
// (отпечаток) безопасный default - ПРОДОЛЖАТЬ (Продолжать = Истина), вердикт
// НЕ переписывается на "Эскалировать". Обоснование (спека, «Риски», «Какая
// ошибка дороже»): ложный стоп терминален и необратим (эскалация = остановка
// агента навсегда, решение 8), а ложное продолжение ограничено сверху
// потолком 10 (слой 3) и стоит лишь денег на лишние LLM-вызовы - это дешевле,
// чем оборвать честный многопроходный запуск на случайном транзиентном сбое.
// Единственное исключение - сбой САМОГО слоя 3 (не удалось прочитать/
// инкрементировать счётчик потолка): это единственный случай, когда функция
// возвращает Продолжать = Ложь, потому что тогда не остаётся вообще никакой
// защиты от бесконечного цикла. Чтение и инкремент счётчика потолка выполняются
// ДО слоёв 1/2 (см. РешитьПродолжатьЛиВнутр) и в собственном защищённом блоке -
// именно поэтому потолок остаётся жёстким пределом независимо от того,
// упадёт ли остальная логика детекции. Исключение НЕ пробрасывается наружу ни
// при каких обстоятельствах.
//
// Параметры:
//  RunId        - Строка(36) - идентификатор запуска.
//  Состояние    - Структура - состояние цикла на момент run_completed (читаются
//                 ШаговВсего, ДействийВсего, ДействийВсегоНаНачалоПрохода,
//                 Результат).
//  ДанныеАгента - Структура - данные агента (МаксШагов/МаксДействий читаются
//                 из ДанныеАгента.Ссылка при непустой ссылке; для БезАгента-
//                 режима бюджет считается неограниченным - см. «Риски»).
//  Вердикт      - Строка - вердикт ar_Надзор.ПроверитьДостижениеЦели ("Продолжить"
//                 ожидается вызывающим кодом; иные значения возвращают
//                 Продолжать=Ложь без изменения ВердиктДляЗаписи).
//
// Возвращаемое значение:
//  Структура {
//    Продолжать      - Булево - Истина, если ни один из трёх слоёв не
//                       остановил цикл (в т.ч. при сбое слоёв 1/2 - см.
//                       БЕЗОПАСНОСТЬ выше, D10).
//    ВердиктДляЗаписи - Строка - Вердикт как есть, либо "Эскалировать", если
//                       сработал слой 2 или 3.
//  }
//
Функция РешитьПродолжатьЛи(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач Вердикт) Экспорт

	РезультатНеПродолжать = Новый Структура;
	РезультатНеПродолжать.Вставить("Продолжать", Ложь);
	РезультатНеПродолжать.Вставить("ВердиктДляЗаписи", Вердикт);

	Если Вердикт <> "Продолжить" Тогда
		Возврат РезультатНеПродолжать;
	КонецЕсли;

	// D10: default при сбое слоёв 1/2 - ПРОДОЛЖАТЬ (см. doc-комментарий выше и
	// шапку модуля). РезультатПриСбоеДетектора используется ТОЛЬКО катч-блоком
	// ниже - не путать с РезультатНеПродолжать (тот - для Вердикт <> "Продолжить",
	// не про сбой).
	РезультатПриСбоеДетектора = Новый Структура;
	РезультатПриСбоеДетектора.Вставить("Продолжать", Истина);
	РезультатПриСбоеДетектора.Вставить("ВердиктДляЗаписи", Вердикт);

	Попытка
		Возврат РешитьПродолжатьЛиВнутр(RunId, Состояние, ДанныеАгента, Вердикт);
	Исключение
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;
		Попытка
			ar_СлужебныйЛог.Записать("ar_Надзор.РешитьПродолжатьЛи", "continuation_check_failed",
				"Сбой детекции прогресса (слой 1/2), продолжение ВЫПОЛНЯЕТСЯ "
					+ "(безопасный default D10 - ложный стоп терминален, "
					+ "ложное продолжение ограничено потолком слоя 3). " + ТекстОшибки,
				"Ошибка", RunId);
		Исключение
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Supervisor.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Надзор: не удалось записать continuation_check_failed в ar_СлужебныйЛог");
		КонецПопытки;
		Возврат РезультатПриСбоеДетектора;
	КонецПопытки;

КонецФункции

// CONS-11: зафиксировать эскалацию по бюджету (слой 1) для ветки
// max_steps_reached, где сама достижимость этой точки уже означает
// исчерпание накопительного лимита ШаговВсего/ДействийВсего. Вызывается
// ar_RuntimeЦикл напрямую (не через РешитьПродолжатьЛи - там нет ветвления по
// причине, только Продолжать/не Продолжать для run_completed).
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  Строка - "Эскалировать" (всегда - вызывается только когда исходный вердикт
//  уже "Продолжить" и ветка max_steps_reached достигнута).
//
Функция ЗафиксироватьЭскалациюБюджета(Знач RunId) Экспорт

	Попытка
		ЗафиксироватьЭскалацию(RunId, "budget");
	Исключение
		// Best-effort - см. D7/D10: сбой записи причины эскалации не должен
		// помешать основному статусу запуска остаться MaxStepsReached.
		ar_СлужебныйЛог.Записать("ar_Надзор.ЗафиксироватьЭскалациюБюджета", "escalation_log_failed",
			"Не удалось зафиксировать событие эскалации бюджета", "Ошибка", RunId);
	КонецПопытки;

	Возврат "Эскалировать";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика без внешнего перехвата исключений (он в ПроверитьДостижениеЦели).
//
// Параметры:
//  RunId            - Строка(36) - идентификатор текущего запуска.
//  Состояние        - Структура - состояние цикла на момент завершения.
//  ДанныеАгента     - Структура - данные агента (ПрочитатьДанныеАгента).
//  КонтекстТриггера - Структура, Неопределено - {Триггер - Строка}.
//
// Возвращаемое значение:
//  Строка - имя значения ar_ВердиктНадзора.
//
Функция ПроверитьДостижениеЦелиВнутр(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач КонтекстТриггера)

	ФинальныйОтвет = "";
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("Результат", ФинальныйОтвет);
	КонецЕсли;
	ФинальныйОтвет = ?(ТипЗнч(ФинальныйОтвет) = Тип("Строка"), ФинальныйОтвет, "");

	Триггер = "manual";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("Триггер", Триггер);
	КонецЕсли;

	PayloadInvoked = Новый Структура;
	PayloadInvoked.Вставить("code", "supervisor_invoked");
	PayloadInvoked.Вставить("trigger", Триггер);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "SupervisorInvoked", PayloadInvoked);

	// Список фактически выполненных действий за RunId - тот же запрос-образец,
	// что уже используется формой ar_ПросмотрЗапуска для секции «Созданные
	// объекты 1С» (см. .docs/specs/CONS-10.md, «Платформенные API и БСП»).
	Действия = ВыбратьДействияЗапуска(RunId);

	// 1. Дешевая проверка без LLM (D4) - строго ДО обращения к LLM.
	ДешеваяПроверка = ПроверитьБезLLM(ФинальныйОтвет, Действия);
	Если ДешеваяПроверка.Сработала Тогда
		Вердикт = "Продолжить";
		ЗафиксироватьРешение(RunId, Вердикт, Истина);
		Возврат Вердикт;
	КонецЕсли;

	// 2. Обращение к LLM с отдельным, изолированным контекстом (D5, D6).
	Цель = СформироватьЦель(Триггер, Состояние, ДанныеАгента);
	Сводка = СформироватьСводку(Цель, ФинальныйОтвет, Действия);

	Контекст = Новый Структура;
	Контекст.Вставить("Сообщения", Новый Массив);
	Контекст.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольSystem(), СистемныйПромптНадзора()));
	Контекст.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), Сводка));
	Контекст.Вставить("Провайдер", ДанныеАгента.LLMПровайдер);
	МодельАгента = "";
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("Модель", МодельАгента);
	КонецЕсли;
	МодельАгентаЗадана = (ТипЗнч(МодельАгента) = Тип("Строка") И Не ПустаяСтрока(МодельАгента));
	Если МодельАгентаЗадана Тогда
		Контекст.Вставить("Модель", МодельАгента);
	КонецЕсли;

	ОтветLLM = ar_LLMДиспетчер.Вызвать(Контекст);

	Вердикт = РазобратьОтветНадзора(ОтветLLM);
	ЗафиксироватьРешение(RunId, Вердикт, Ложь);
	Возврат Вердикт;

КонецФункции

// Дешевая проверка без обращения к LLM (D4): отсекает очевидный случай, когда
// агент текстуально заявляет о созданном/измененном объекте, но ни одно
// действие с мутирующим RiskLevel (Draft/Write/Commit) не завершилось
// непустым ar_ResultRef - фактически ничего не создано/не изменено.
//
// Параметры:
//  ФинальныйОтвет - Строка - итоговый текст ответа агента.
//  Действия       - ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef
//                    (см. ВыбратьДействияЗапуска).
//
// Возвращаемое значение:
//  Структура {Сработала - Булево} - Истина, если дешевая проверка дала
//  однозначное «не выполнено» без обращения к LLM.
//
Функция ПроверитьБезLLM(Знач ФинальныйОтвет, Знач Действия)

	Результат = Новый Структура("Сработала", Ложь);

	ЗаявляетОСозданном = ТекстЗаявляетОСозданномОбъекте(ФинальныйОтвет);
	Если Не ЗаявляетОСозданном Тогда
		Возврат Результат;
	КонецЕсли;

	// Есть хотя бы одно мутирующее действие с непустым ResultRef -
	// заявление правдоподобно, дешевая проверка не отсекает без LLM.
	ЕстьМутирующийРезультат = Ложь;
	Для Каждого СтрокаДействия Из Действия Цикл
		RiskLevelИмя = "";
		Если ЗначениеЗаполнено(СтрокаДействия.RiskLevel) Тогда
			RiskLevelИмя = Строка(СтрокаДействия.RiskLevel);
		КонецЕсли;
		RiskLevelМутирующий = (RiskLevelИмя = "Draft" ИЛИ RiskLevelИмя = "Write" ИЛИ RiskLevelИмя = "Commit");
		РезультатПолучен = Не ПустаяСтрока(СтрокаДействия.ResultRef);
		Если RiskLevelМутирующий И РезультатПолучен Тогда
			ЕстьМутирующийРезультат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьМутирующийРезультат Тогда
		Результат.Сработала = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Эвристика: содержит ли текст финального ответа ключевые слова о созданном/
// измененном объекте (§3.2 контракта завершения, D4).
//
// Параметры:
//  Текст - Строка - итоговый текст ответа агента.
//
// Возвращаемое значение:
//  Булево - Истина, если текст содержит ключевое слово о созданном объекте.
//
Функция ТекстЗаявляетОСозданномОбъекте(Знач Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстНижнийРегистр = НРег(Текст);

	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("создал");
	КлючевыеСлова.Добавить("создан");
	КлючевыеСлова.Добавить("создано");
	КлючевыеСлова.Добавить("оформил");
	КлючевыеСлова.Добавить("оформлен");
	КлючевыеСлова.Добавить("записал");
	КлючевыеСлова.Добавить("записан");
	КлючевыеСлова.Добавить("сформировал");
	КлючевыеСлова.Добавить("сформирован");
	КлючевыеСлова.Добавить("добавил");
	КлючевыеСлова.Добавить("добавлен");
	КлючевыеСлова.Добавить("created");
	КлючевыеСлова.Добавить("added");
	КлючевыеСлова.Добавить("generated");
	КлючевыеСлова.Добавить("recorded");

	Для Каждого Слово Из КлючевыеСлова Цикл
		Если СтрНайти(ТекстНижнийРегистр, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Выбрать действия текущего запуска - имя tool, уровень риска, ResultRef.
// Паттерн запроса - CommonForms/ar_ПросмотрЗапуска/Ext/Form/Module.bsl,
// процедура ЗаполнитьСозданныеОбъекты (CONS-06 D1).
//
// Параметры:
//  RunId - Строка(36) - идентификатор запуска.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef.
//
Функция ВыбратьДействияЗапуска(Знач RunId)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", RunId);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Действия.ar_ИмяTool КАК ИмяTool,
	|	Действия.ar_RiskLevel КАК RiskLevel,
	|	Действия.ar_ResultRef КАК ResultRef
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_RunId = &RunId
	|УПОРЯДОЧИТЬ ПО
	|	Действия.ar_Sequence";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Источник формулировки цели (см. .docs/specs/CONS-10.md, «Источник формулировки
// цели», решение аналитика - переопределяет буквальную формулировку задачи).
//
// Параметры:
//  Триггер      - Строка - код триггера запуска ("manual"/"cron"/... ).
//  Состояние    - Структура - состояние цикла (используется ИнструкцияДобавка).
//  ДанныеАгента - Структура - данные агента (используется Инструкция).
//
// Возвращаемое значение:
//  Строка - формулировка цели для надзорного вызова LLM.
//
Функция СформироватьЦель(Знач Триггер, Знач Состояние, Знач ДанныеАгента)

	Если Триггер = "manual" ИЛИ СтрНайти(Триггер, "manual_chat") = 1 Тогда
		Возврат ПервоеСообщениеПользователя(Состояние);
	КонецЕсли;

	// cron/schedule, subscription/webhook, mention (рутина-триггер) - та же
	// комбинация, что видел агент в промпте: инструкция агента + (если
	// непусто) добавка рутины, уже посчитанная в Состояние.ИнструкцияДобавка.
	ИнструкцияАгента = "";
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("Инструкция", ИнструкцияАгента);
	КонецЕсли;
	ИнструкцияАгента = ?(ТипЗнч(ИнструкцияАгента) = Тип("Строка"), ИнструкцияАгента, "");

	ИнструкцияДобавка = "";
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("ИнструкцияДобавка", ИнструкцияДобавка);
	КонецЕсли;
	ИнструкцияДобавка = ?(ТипЗнч(ИнструкцияДобавка) = Тип("Строка"), ИнструкцияДобавка, "");

	Если Не ПустаяСтрока(ИнструкцияДобавка) Тогда
		Возврат СокрЛП(ИнструкцияАгента) + Символы.ПС + Символы.ПС + СокрЛП(ИнструкцияДобавка);
	КонецЕсли;

	Возврат СокрЛП(ИнструкцияАгента);

КонецФункции

// Первое сообщение role=user в Состояние.Сообщения - исходный запрос
// пользователя (manual/manual_chat*).
//
// Параметры:
//  Состояние - Структура - состояние цикла (используется Сообщения).
//
// Возвращаемое значение:
//  Строка - текст первого пользовательского сообщения либо пустая строка.
//
Функция ПервоеСообщениеПользователя(Знач Состояние)

	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Сообщения = Неопределено;
	Если Не Состояние.Свойство("Сообщения", Сообщения) ИЛИ ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Роль = "";
		Сообщение.Свойство("role", Роль);
		Если Роль = ar_LLMКонтракт.РольUser() Тогда
			Содержание = "";
			Сообщение.Свойство("content", Содержание);
			Возврат ?(ТипЗнч(Содержание) = Тип("Строка"), Содержание, "");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Системный промпт надзора (решение 9) - отдельный от системного промпта
// основного агента, не читается из ar_Агенты.
//
// Возвращаемое значение:
//  Строка - текст системного промпта надзорного LLM-вызова.
//
Функция СистемныйПромптНадзора()

	Возврат НСтр("ru = 'Ты - модуль надзора AgentRunner. Тебе дана цель, которую
		|должен был выполнить AI-агент, его финальный текстовый ответ и список
		|фактически выполненных действий (инструмент + признак, был ли получен
		|результат). Классифицируй исход СТРОГО одним JSON-объектом без пояснений
		|снаружи JSON: {""class"": ""выполнено""} - цель полностью достигнута
		|фактическими действиями или ответом; {""class"": ""нечего_делать"",
		|""reason"": ""<причина>""} - агент обоснованно определил, что действие
		|не требовалось; {""class"": ""не_выполнено""} - во всех остальных
		|случаях, включая расплывчатый ответ, отчет о намерениях без
		|подтвержденного результата, или явное расхождение между тем, что
		|заявлено в ответе, и тем, что реально сделано. Не выполняй никаких
		|действий сам, не предлагай продолжение - только классификация.';
		|en = 'You are the AgentRunner supervisor module. You are given the goal
		|an AI agent was supposed to accomplish, its final text answer, and the
		|list of actions it actually performed (tool name + whether a result was
		|produced). Classify the outcome as STRICTLY one JSON object with no text
		|outside the JSON: {""class"": ""выполнено""} - the goal was fully
		|achieved by actual actions or the answer; {""class"": ""нечего_делать"",
		|""reason"": ""<reason>""} - the agent correctly determined no action was
		|needed; {""class"": ""не_выполнено""} - all other cases, including vague
		|answers, reports of intent without a confirmed result, or a clear
		|mismatch between what is claimed and what was actually done. Do not take
		|any action yourself, do not propose continuation - classification only.'");

КонецФункции

// Сводка для user-сообщения надзорного вызова: цель, финальный ответ,
// список действий.
//
// Параметры:
//  Цель           - Строка - формулировка цели (СформироватьЦель).
//  ФинальныйОтвет - Строка - итоговый текст ответа агента.
//  Действия       - ТаблицаЗначений - колонки ИмяTool, RiskLevel, ResultRef.
//
// Возвращаемое значение:
//  Строка - текст user-сообщения для надзорного LLM-вызова.
//
Функция СформироватьСводку(Знач Цель, Знач ФинальныйОтвет, Знач Действия)

	СтрокиДействий = Новый Массив;
	Для Каждого СтрокаДействия Из Действия Цикл
		ИмяTool = Строка(СтрокаДействия.ИмяTool);
		ЕстьРезультат = Не ПустаяСтрока(СтрокаДействия.ResultRef);
		СтрокиДействий.Добавить(ИмяTool + " -> " + ?(ЕстьРезультат, "результат получен", "результата нет"));
	КонецЦикла;

	СпособДействий = ?(СтрокиДействий.Количество() = 0,
		НСтр("ru = '(действий не было)'; en = '(no actions)'"),
		СтрСоединить(СтрокиДействий, Символы.ПС));

	ЗаголовокЦель = НСтр("ru = 'Цель:'; en = 'Goal:'");
	ЗаголовокОтвет = НСтр("ru = 'Финальный ответ агента:'; en = 'Agent final answer:'");
	ЗаголовокДействия = НСтр("ru = 'Фактически выполненные действия:'; en = 'Actually performed actions:'");

	Возврат ЗаголовокЦель + Символы.ПС + Цель + Символы.ПС + Символы.ПС
		+ ЗаголовокОтвет + Символы.ПС + ФинальныйОтвет + Символы.ПС + Символы.ПС
		+ ЗаголовокДействия + Символы.ПС + СпособДействий;

КонецФункции

// Разобрать JSON-ответ LLM надзора и смэппить в ar_ВердиктНадзора (§3.2):
// "выполнено" -> ЦельДостигнута; "нечего_делать" (с непустым reason) ->
// ЦельДостигнута; все остальное (включая ошибку разбора/недоступность LLM) ->
// Продолжить. "Эскалировать" контракт завершения не производит (см. спеку,
// «Контракт завершения»).
//
Функция РазобратьОтветНадзора(Знач ОтветLLM)

	Если ТипЗнч(ОтветLLM) <> Тип("Структура") ИЛИ ОтветLLM.Успех <> Истина Тогда
		Возврат "Продолжить";
	КонецЕсли;

	СообщениеОтвета = Неопределено;
	ОтветLLM.Свойство("Сообщение", СообщениеОтвета);
	КонтентОтвета = "";
	Если ТипЗнч(СообщениеОтвета) = Тип("Структура") Тогда
		СообщениеОтвета.Свойство("content", КонтентОтвета);
	КонецЕсли;
	КонтентОтвета = ?(ТипЗнч(КонтентОтвета) = Тип("Строка"), КонтентОтвета, "");

	Разобрано = ar_JSON.ИзJSON(КонтентОтвета);
	Если Разобрано = Неопределено Тогда
		Возврат "Продолжить";
	КонецЕсли;

	Класс = "";
	Причина = "";
	Если ТипЗнч(Разобрано) = Тип("Соответствие") Тогда
		Класс = Строка(Разобрано.Получить("class"));
		Причина = Строка(Разобрано.Получить("reason"));
	ИначеЕсли ТипЗнч(Разобрано) = Тип("Структура") Тогда
		ЗначениеКласса = "";
		Разобрано.Свойство("class", ЗначениеКласса);
		Класс = Строка(ЗначениеКласса);
		ЗначениеПричины = "";
		Разобрано.Свойство("reason", ЗначениеПричины);
		Причина = Строка(ЗначениеПричины);
	Иначе
		Возврат "Продолжить";
	КонецЕсли;

	// §3.2: "выполнено" и "нечего_делать" (с непустой причиной) - оба класса
	// приравниваются к достижению цели, остальное - "Продолжить".
	КлассВыполнено = (Класс = "выполнено");
	КлассНечегоДелатьСПричиной = (Класс = "нечего_делать" И Не ПустаяСтрока(СокрЛП(Причина)));

	Если КлассВыполнено ИЛИ КлассНечегоДелатьСПричиной Тогда
		Возврат "ЦельДостигнута";
	Иначе
		Возврат "Продолжить";
	КонецЕсли;

КонецФункции

// Зафиксировать событие SupervisorDecision (для читаемости вызова из
// ПроверитьДостижениеЦелиВнутр).
//
// Параметры:
//  RunId                       - Строка(36) - идентификатор запуска.
//  Вердикт                     - Строка - имя значения ar_ВердиктНадзора.
//  ДешеваяПроверкаСработала    - Булево - сработала ли дешевая проверка без LLM.
//
Процедура ЗафиксироватьРешение(Знач RunId, Знач Вердикт, Знач ДешеваяПроверкаСработала)

	Payload = Новый Структура;
	Payload.Вставить("code", "supervisor_decision");
	Payload.Вставить("verdict", Вердикт);
	Payload.Вставить("cheap_check", ДешеваяПроверкаСработала);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "SupervisorDecision", Payload);

КонецПроцедуры

// ============================================================================
// CONS-11: детекция отсутствия прогресса - три слоя.
// ============================================================================

// Основная логика трёх слоёв. Порядок изменён относительно первой итерации
// (ревью 1): потолок (слой 3) проверяется и НЕЗАВИСИМО ИНКРЕМЕНТИРУЕТСЯ
// ПЕРВЫМ, в собственном защищённом блоке, ДО слоёв 1/2 - по двум причинам:
//  (1) дешевизна - одно чтение числа против запроса к ar_ДействияАгента и
//      вычисления SHA-256 по всей истории прохода (слой 2);
//  (2) ЖЁСТКОСТЬ ПРЕДОХРАНИТЕЛЯ (D6/D10, ревью 1, критичное замечание) -
//      слой 3 обязан оставаться жёстким пределом НЕЗАВИСИМО от сбоя слоёв 1/2.
//      Если бы счётчик читался/инкрементировался ТОЛЬКО в конце (как в первой
//      итерации), а слои 1/2 систематически падали бы (например, регистр
//      ar_ДействияАгента стабильно недоступен), fallback "Продолжать = Истина"
//      разрешал бы физическое продолжение БЕСКОНЕЧНО - счётчик потолка никогда
//      бы не инкрементировался и не сработал. Поэтому чтение+сравнение+запись
//      счётчика вынесены в отдельную функцию ПроверитьИИнкрементироватьПотолок,
//      которая выполняется в СВОЁМ try/catch: при успехе (счётчик прочитан и
//      обновлён) потолок гарантированно учтён на этом проходе независимо от
//      исхода слоёв 1/2 ниже; при сбое САМОГО слоя 3 (не удалось прочитать/
//      записать счётчик) - это ЕДИНСТВЕННЫЙ случай, когда функция возвращает
//      Продолжать = Ложь без эскалации (см. её doc-комментарий) - иначе не
//      остаётся вообще никакой защиты от бесконечного цикла.
//
// Слои 1 (бюджет) и 2 (отпечаток) выполняются БЕЗ внешнего перехвата здесь -
// он в РешитьПродолжатьЛи, с fallback "Продолжать = Истина" (D10, см. шапку
// модуля) - потолок уже подтверждён и инкрементирован строкой выше, поэтому
// ложное продолжение при их сбое ограничено предохранителем слоя 3.
//
// Параметры и возврат - см. РешитьПродолжатьЛи.
//
Функция РешитьПродолжатьЛиВнутр(Знач RunId, Знач Состояние, Знач ДанныеАгента, Знач Вердикт)

	// --- Слой 3 (проверяется первым - см. doc-комментарий выше, D6/D10) -----
	// Вердикт передаётся параметром - при сбое САМОГО слоя 3 функция возвращает
	// его НЕ переписанным (как пришёл от вызывающего кода, обычно "Продолжить") -
	// строковый литерал "Продолжить" внутри ПроверитьИИнкрементироватьПотолок
	// был бы семантически двусмысленным (выглядел бы как совпадение с обычным
	// успешным путём слоя 3, а не как «вердикт не менялся из-за отказа
	// детектора») - см. её doc-комментарий.
	РезультатПотолка = ПроверитьИИнкрементироватьПотолок(RunId, Вердикт);
	Если Не РезультатПотолка.Продолжать Тогда
		Возврат НовыйРезультатРешения(Ложь, РезультатПотолка.ВердиктДляЗаписи);
	КонецЕсли;

	// --- Слой 1: бюджет (накопительно за весь RunId, D1/D2) -----------------
	// Состояние.ШаговВсего/ДействийВсего НЕ обнуляются между проходами (см.
	// ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора) - Пока Состояние.ШаговВсего <
	// МаксШагов в ar_RuntimeЦикл уже проверяет накопительный бюджет естественно.
	// Здесь - предварительная проверка ПЕРЕД тем, как разрешить ещё один
	// проход: если бюджет уже исчерпан или проход, который вот-вот начнётся,
	// не сможет сделать ни одного шага - терминально, budget. Бюджет не
	// продлевается ни при каких условиях (D2) - ни ШаговВсего, ни ДействийВсего
	// нигде в этой функции не изменяются и не игнорируются.
	МаксШагов = ЗначениеБюджета(ДанныеАгента, "МаксШагов");
	МаксДействий = ЗначениеБюджета(ДанныеАгента, "МаксДействий");

	ШаговВсего = ЗначениеЧисло(Состояние, "ШаговВсего");
	ДействийВсего = ЗначениеЧисло(Состояние, "ДействийВсего");

	БюджетИсчерпан = (МаксШагов > 0 И ШаговВсего >= МаксШагов)
		ИЛИ (МаксДействий > 0 И ДействийВсего >= МаксДействий);

	Если БюджетИсчерпан Тогда
		ЗафиксироватьЭскалацию(RunId, "budget");
		Возврат НовыйРезультатРешения(Ложь, "Эскалировать");
	КонецЕсли;

	// --- Слой 2: result-aware отпечаток прохода (D3/D4/D5) -------------------
	ГраницаПрохода = ЗначениеЧисло(Состояние, "ДействийВсегоНаНачалоПрохода");
	ФинальныйТекст = ЗначениеСтрока(Состояние, "Результат");

	НовыйОтпечаток = ВычислитьОтпечатокПрохода(RunId, Состояние, ГраницаПрохода, ФинальныйТекст);
	ПредыдущийОтпечаток = ar_AuditЗапуски.ПрочитатьОтпечатокШага(RunId);

	// Первый проход запуска - ПредыдущийОтпечаток пуст (поле ещё не
	// заполнялось), сравнивать не с чем - топтание невозможно по определению,
	// это не тот же случай, что «пустой результат» (в) в спеке: там оба
	// прохода реально состоялись и дали одинаковый (пустой) результат.
	ЭтоПервыйПроходЗапуска = ПустаяСтрока(ПредыдущийОтпечаток);

	Если Не ЭтоПервыйПроходЗапуска И НовыйОтпечаток = ПредыдущийОтпечаток Тогда
		// Совпадение отпечатка ДВАЖДЫ ПОДРЯД (порог 2, D5 - на этом самом
		// сравнении, второй раз подряд) - топтание, эскалация немедленно.
		// Пропись отпечатка НЕ обновляется на эскалации - решение терминально,
		// следующего сравнения для этого RunId не будет.
		ЗафиксироватьЭскалацию(RunId, "stagnation");
		Возврат НовыйРезультатРешения(Ложь, "Эскалировать");
	КонецЕсли;

	// Ни один слой не остановил - разрешаем продолжение. Отпечаток текущего
	// прохода пишется ЗДЕСЬ (счётчик потолка уже записан выше, в
	// ПроверитьИИнкрементироватьПотолок, - НЕ дублируется здесь) - должен
	// попасть в ar_Запуски ДО того, как ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора
	// запустит следующий проход (иначе следующий вызов РешитьПродолжатьЛи
	// сравнил бы отпечаток сам с собой при сбое где-то посередине).
	ЗаписатьОтпечатокПродолжения(RunId, НовыйОтпечаток);

	Возврат НовыйРезультатРешения(Истина, Вердикт);

КонецФункции

// CONS-11 (ревью 1, критичное замечание): слой 3 (потолок 10 продолжений) как
// ЖЁСТКИЙ предохранитель, НЕЗАВИСИМЫЙ от сбоя слоёв 1/2. Чтение текущего
// значения счётчика, сравнение с потолком и немедленная запись
// инкрементированного значения выполняются здесь, в СОБСТВЕННОМ защищённом
// блоке, ДО вызова слоёв 1/2 в РешитьПродолжатьЛиВнутр - именно поэтому
// систематический отказ детекции прогресса (слой 2) или чтения бюджета
// (слой 1) не отменяет действие потолка: счётчик всё равно инкрементируется
// на КАЖДОМ проходе, прошедшем эту функцию, и рано или поздно (не позже
// 10-го продолжения) сработает.
//
// БЕЗОПАСНОСТЬ - направление ОБРАТНОЕ по сравнению со слоями 1/2 (D10): если
// не удалось даже прочитать или записать сам счётчик потолка - это
// ЕДИНСТВЕННЫЙ случай во всей детекции CONS-11, когда функция возвращает
// Продолжать = Ложь. Обоснование: fallback "продолжать" при сбое слоёв 1/2
// безопасен ИМЕННО ПОТОМУ, что слой 3 подстрахует патологию за конечное число
// шагов; если же ломается сам слой 3, эта страховка отсутствует, и
// единственный оставшийся барьер от бесконечного цикла - остановиться.
// Исключение НЕ пробрасывается наружу (перехватывается здесь же, не
// катч-блоком РешитьПродолжатьЛи, - иначе внешний catch применил бы к этому
// случаю fallback "продолжать", предназначенный только для слоёв 1/2).
//
// Параметры:
//  RunId   - Строка(36) - идентификатор запуска.
//  Вердикт - Строка - вердикт, полученный вызывающим кодом (РешитьПродолжатьЛиВнутр) -
//            возвращается НЕ переписанным при сбое чтения/записи счётчика
//            (см. ниже, «Возвращаемое значение»).
//
// Возвращаемое значение:
//  Структура {Продолжать: Булево, ВердиктДляЗаписи: Строка} - формат
//  НовыйРезультатРешения; ВердиктДляЗаписи = "Эскалировать" при достижении
//  потолка; = Вердикт (как пришёл, не переписан) при сбое чтения/записи
//  счётчика - это НЕ осмысленная эскалация, а отказ детектора, поэтому
//  вердикт не меняется (см. РешитьПродолжатьЛиВнутр, комментарий у вызова).
//
Функция ПроверитьИИнкрементироватьПотолок(Знач RunId, Знач Вердикт)

	Попытка
		ПродолженийСделано = ar_AuditЗапуски.ПрочитатьПродолженийСделано(RunId);
		Если ПродолженийСделано >= 10 Тогда
			ЗафиксироватьЭскалацию(RunId, "safety_cap");
			Возврат НовыйРезультатРешения(Ложь, "Эскалировать");
		КонецЕсли;

		// Инкремент СРАЗУ, до слоёв 1/2 - см. doc-комментарий выше: потолок
		// обязан расти на каждом проходе независимо от их исхода.
		ЗаписатьСчётчикПотолка(RunId, ПродолженийСделано + 1);
		Возврат НовыйРезультатРешения(Истина, Вердикт);
	Исключение
		// Единственный случай "не продолжать" во всей детекции CONS-11 - см.
		// doc-комментарий: без работающего слоя 3 не остаётся защиты от
		// бесконечного цикла, поэтому здесь безопаснее остановиться, чем
		// продолжить. Вердикт возвращается НЕ переписанным (параметр Вердикт
		// как есть, обычно "Продолжить") - это не осмысленное решение надзора,
		// а отказ детектора, переписывать его на "Эскалировать" здесь неверно.
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;
		Попытка
			ar_СлужебныйЛог.Записать("ar_Надзор.ПроверитьИИнкрементироватьПотолок", "safety_cap_check_failed",
				"Сбой чтения/записи счётчика потолка (слой 3) - продолжение ОСТАНОВЛЕНО "
					+ "(единственный default 'не продолжать' в детекции CONS-11, "
					+ "т.к. без слоя 3 нет защиты от бесконечного цикла). " + ТекстОшибки,
				"Ошибка", RunId);
		Исключение
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Supervisor.LogFailed",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"ar_Надзор: не удалось записать safety_cap_check_failed в ar_СлужебныйЛог");
		КонецПопытки;
		Возврат НовыйРезультатРешения(Ложь, Вердикт);
	КонецПопытки;

КонецФункции

// Собрать возвращаемую структуру РешитьПродолжатьЛи.
//
Функция НовыйРезультатРешения(Знач Продолжать, Знач ВердиктДляЗаписи)
	Результат = Новый Структура;
	Результат.Вставить("Продолжать", Продолжать);
	Результат.Вставить("ВердиктДляЗаписи", ВердиктДляЗаписи);
	Возврат Результат;
КонецФункции

// Прочитать МаксШагов/МаксДействий агента текущего прохода. И
// ar_RuntimeЦикл.ПрочитатьДанныеАгента (обычный агент, из ar_Агенты), и
// ДанныеАгентаБезАгента (режим «без агента», ar_Константы.МаксШагов/
// МаксДействий как дефолт) всегда несут оба поля числом - 0/отсутствие поля
// здесь означает сбой чтения структуры, а не «лимит не задан» бизнес-смыслом.
// При 0 проверка бюджета этим слоем пропускается (не проверяется) - слой 3
// (потолок 10 продолжений) всё равно остаётся жёстким пределом на этот случай.
//
// Параметры:
//  ДанныеАгента - Структура - данные агента (МаксШагов/МаксДействий - Число).
//  ИмяПоля      - Строка - "МаксШагов" или "МаксДействий".
//
// Возвращаемое значение:
//  Число - значение лимита; 0 - поле не удалось прочитать (защитный fallback).
//
Функция ЗначениеБюджета(Знач ДанныеАгента, Знач ИмяПоля)

	Если ТипЗнч(ДанныеАгента) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Значение = 0;
	Если Не ДанныеАгента.Свойство(ИмяПоля, Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Безопасно извлечь числовое поле из Состояния (Структура).
//
Функция ЗначениеЧисло(Знач Состояние, Знач ИмяПоля)
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;
	Значение = 0;
	Если Не Состояние.Свойство(ИмяПоля, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Безопасно извлечь строковое поле из Состояния (Структура).
//
Функция ЗначениеСтрока(Знач Состояние, Знач ИмяПоля)
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Значение = "";
	Если Не Состояние.Свойство(ИмяПоля, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Вычислить SHA-256 (hex) отпечаток прохода (D3): упорядоченная конкатенация
// «имя tool + аргументы + результат» по всем действиям ТЕКУЩЕГО прохода
// (Sequence >= ГраницаПрохода, а не всего RunId), либо, если проход не
// выполнил ни одного действия, хэш финального текста ответа (см. спеку,
// «Отпечаток шага», особый случай «проход без единого действия»).
//
// Переиспользует буквально приём ar_ToolПакеты.ХешМанифеста (та же
// последовательность ХешированиеДанных/SHA256/ПолучитьHexСтрокуИзДвоичныхДанных) -
// не отдельный хелпер (см. .docs/specs/CONS-11.md, D3).
//
// Параметры:
//  RunId          - Строка(36) - идентификатор запуска.
//  Состояние      - Структура - состояние цикла (Сообщения - источник текста
//                   observation, см. ТекстObservationПоНомеру).
//  ГраницаПрохода - Число - Sequence, с которого начинается текущий проход
//                   (Состояние.ДействийВсегоНаНачалоПрохода).
//  ФинальныйТекст - Строка - текст финального ответа агента (используется
//                   только если действий в проходе не было).
//
// Возвращаемое значение:
//  Строка - hex SHA-256, 64 символа.
//
Функция ВычислитьОтпечатокПрохода(Знач RunId, Знач Состояние, Знач ГраницаПрохода, Знач ФинальныйТекст)

	ДействияПрохода = ВыбратьДействияПрохода(RunId, ГраницаПрохода);

	Если ДействияПрохода.Количество() = 0 Тогда
		// Особый случай (спека, «Отпечаток шага»): проход без единого действия -
		// отпечаток строится из финального текста, а не из пустого списка (иначе
		// два разных расплывчатых ответа дали бы одинаковый отпечаток).
		Возврат ХешСтроки("no_actions|" + ?(ТипЗнч(ФинальныйТекст) = Тип("Строка"), ФинальныйТекст, ""));
	КонецЕсли;

	// Массив всех observation-сообщений (role=tool) Состояние.Сообщения в
	// порядке появления - N-ное по счёту (с нуля) соответствует действию с
	// Sequence=N: каждое действие (ОбработатьДействие) добавляет РОВНО одно
	// observation сразу после dispatch, в том же порядке, что и запись в
	// ar_ДействияАгента (см. .docs/specs/CONS-11.md, «Платформенные API»,
	// сопоставление по tool_call_id - здесь эквивалентно по позиции, т.к.
	// ar_ДействияАгента не хранит tool_call_id отдельным полем).
	ТекстыObservation = ТекстыObservationПоПорядку(Состояние);

	ЧастиОтпечатка = Новый Массив;
	Для Каждого СтрокаДействия Из ДействияПрохода Цикл
		Имя = ?(ЗначениеЗаполнено(СтрокаДействия.ИмяTool), Строка(СтрокаДействия.ИмяTool), "");
		Аргументы = ?(ТипЗнч(СтрокаДействия.АргументыJSON) = Тип("Строка"), СтрокаДействия.АргументыJSON, "");
		НомерДействия = Цел(СтрокаДействия.Sequence);
		Результат = "";
		Если НомерДействия >= 0 И НомерДействия < ТекстыObservation.Количество() Тогда
			Результат = ТекстыObservation[НомерДействия];
		КонецЕсли;
		// Случай (г) спеки: пустой результат - валидное значение отпечатка, НЕ
		// исключается из конкатенации и не подменяется маркером "нет данных".
		ЧастиОтпечатка.Добавить(Имя + "|" + Аргументы + "|" + Результат);
	КонецЦикла;

	Возврат ХешСтроки(СтрСоединить(ЧастиОтпечатка, Символы.ПС));

КонецФункции

// Выбрать действия ТЕКУЩЕГО прохода (Sequence >= ГраницаПрохода) - в отличие
// от ВыбратьДействияЗапуска (CONS-10), которая берёт ВЕСЬ RunId.
// Дополнительно читает ar_АргументыJSON, не читаемый CONS-10.
//
// Параметры:
//  RunId          - Строка(36) - идентификатор запуска.
//  ГраницаПрохода - Число - Sequence начала текущего прохода (включительно).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяTool, АргументыJSON, ResultRef, Sequence.
//
Функция ВыбратьДействияПрохода(Знач RunId, Знач ГраницаПрохода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("RunId", RunId);
	Запрос.УстановитьПараметр("ГраницаПрохода", ГраницаПрохода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Действия.ar_ИмяTool КАК ИмяTool,
	|	Действия.ar_АргументыJSON КАК АргументыJSON,
	|	Действия.ar_ResultRef КАК ResultRef,
	|	Действия.ar_Sequence КАК Sequence
	|ИЗ
	|	РегистрСведений.ar_ДействияАгента КАК Действия
	|ГДЕ
	|	Действия.ar_RunId = &RunId
	|	И Действия.ar_Sequence >= &ГраницаПрохода
	|УПОРЯДОЧИТЬ ПО
	|	Действия.ar_Sequence";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Извлечь тексты всех observation-сообщений (role=tool) из
// Состояние.Сообщения в порядке появления (индекс массива = Sequence
// соответствующего действия - см. ВычислитьОтпечатокПрохода).
// Источник результата - Состояние.Сообщения, НЕ ar_ResultRef (см. спеку,
// «Сущности и метаданные»: ResultRef пуст для большинства read-only tools и
// не отражает сам факт «что вернулось» - опрос состояния с разным ответом
// (pending/done, случай (а) DoD D4) иначе дал бы одинаковый пустой отпечаток
// результата на обоих проходах, что превратило бы легитимный прогресс в
// ложное топтание).
//
// Параметры:
//  Состояние - Структура - {Сообщения: Массив из Структура{role, content, ...}}.
//
// Возвращаемое значение:
//  Массив из Строка - тексты content всех сообщений с role="tool", по порядку.
//
Функция ТекстыObservationПоПорядку(Знач Состояние)

	Результат = Новый Массив;

	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Сообщения = Неопределено;
	Если Не Состояние.Свойство("Сообщения", Сообщения) ИЛИ ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Роль = "";
		Сообщение.Свойство("role", Роль);
		Если Роль <> "tool" Тогда
			Продолжить;
		КонецЕсли;
		Содержание = "";
		Сообщение.Свойство("content", Содержание);
		Результат.Добавить(?(ТипЗнч(Содержание) = Тип("Строка"), Содержание, ""));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// SHA-256 (hex) от строки в UTF-8 - тот же приём, что
// ar_ToolПакеты.ХешМанифеста (см. .docs/specs/CONS-11.md, D3): не отдельный
// хелпер по существу, копия последовательности вызовов платформенного API,
// т.к. ar_ToolПакеты.ХешМанифеста не экспортна и принимает Произвольный
// (сериализует сама через ar_JSON), а здесь на входе уже готовая строка.
//
Функция ХешСтроки(Знач ИсходнаяСтрока)

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ИсходнаяСтрока, КодировкаТекста.UTF8, Ложь);

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);

	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

// Зафиксировать событие эскалации (D11) с явным признаком сработавшего слоя -
// "budget"/"stagnation"/"safety_cap" - и переписать
// ar_ПоследнееРешениеНадзора на "Эскалировать" (единственное место, где это
// значение реально записывается - см. doc-комментарий модуля).
//
// Статус запуска (Completed/MaxStepsReached) НЕ меняется здесь - это делает
// ar_RuntimeЦикл через обычный ЗавершитьЗапуск с исходным Статус (см. спеку,
// «Эскалация»: «вердикт независим от статуса запуска»).
//
// Параметры:
//  RunId            - Строка(36) - идентификатор запуска.
//  ПричинаЭскалации - Строка - "budget"/"stagnation"/"safety_cap".
//
Процедура ЗафиксироватьЭскалацию(Знач RunId, Знач ПричинаЭскалации)

	Payload = Новый Структура;
	Payload.Вставить("code", "supervisor_decision");
	Payload.Вставить("verdict", "Эскалировать");
	Payload.Вставить("escalation_reason", ПричинаЭскалации);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "SupervisorDecision", Payload);

КонецПроцедуры

// CONS-11 (ревью 1, критичное замечание): записать ТОЛЬКО счётчик потолка
// (слой 3), отдельно от отпечатка (слой 2) - см.
// ПроверитьИИнкрементироватьПотолок, где эта запись происходит ДО слоёв 1/2
// и должна быть независима от их успеха/сбоя. Whitelist ar_AuditЗапуски.
// ЗаписатьЗапуск (ПрисвоитьЕслиЕсть) пишет только присутствующие в структуре
// ключи - отсутствие "ОтпечатокШага" здесь не затирает его текущее значение.
//
// Параметры:
//  RunId              - Строка(36) - идентификатор запуска.
//  ПродолженийСделано - Число - обновлённое значение счётчика (ПрочитатьПродолженийСделано + 1).
//
Процедура ЗаписатьСчётчикПотолка(Знач RunId, Знач ПродолженийСделано)

	ДанныеОбновления = Новый Структура;
	ДанныеОбновления.Вставить("ПродолженийСделано", ПродолженийСделано);
	ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunId, "Завершить", ДанныеОбновления);

КонецПроцедуры

// Записать в ar_Запуски отпечаток текущего прохода (слой 2) - отдельно от
// счётчика потолка (см. ЗаписатьСчётчикПотолка, ревью 1) - ДО того, как
// ar_RuntimeЦикл запустит следующий проход.
//
// Параметры:
//  RunId     - Строка(36) - идентификатор запуска.
//  Отпечаток - Строка - hex SHA-256 текущего прохода.
//
Процедура ЗаписатьОтпечатокПродолжения(Знач RunId, Знач Отпечаток)

	ДанныеОбновления = Новый Структура;
	ДанныеОбновления.Вставить("ОтпечатокШага", Отпечаток);
	ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunId, "Завершить", ДанныеОбновления);

КонецПроцедуры

#КонецОбласти
