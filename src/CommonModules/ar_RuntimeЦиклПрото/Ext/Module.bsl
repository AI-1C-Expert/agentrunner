////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_RuntimeЦиклПрото (AOS Runtime — прото-цикл).
//
// ПРОТО: удалить при реализации RT-06 (ar_RuntimeЦикл).
//
// Этап 0 / RT-01: упрощённая реализация ReAct-цикла, связывающая
// ar_LLMOpenAI.Чат и ar_ToolCRM.ПоискКлиентов. Без permission-engine,
// approval-flow и фоновых заданий — всё выполняется синхронно в серверном
// контексте формы обработки ar_ТестЦикла.
//
// Свойства модуля: Сервер, без привилегированного режима. Привилегии
// поднимаются глубже — внутри ar_Secrets и ar_AuditЗапуски.
//
// Контракт:
//   ВыполнитьЦикл(RunId, ПровайдерСсылка, ЗапросПользователя, МаксШагов)
//     → Структура{Успех, Результат, Статус, ЖурналТекст, ОтветLLM}
//
// См. спеку: .docs/specs/RT-01.md, Plan §5 этап 0, §11.9.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет упрощённый ReAct-цикл: системный промпт + пользовательский запрос
// → LLM → tool_calls → search_clients → observation → LLM → финальный ответ.
//
// Параметры:
//   RunId               - Строка    - идентификатор запуска (UUID, длина 36).
//   ПровайдерСсылка     - СправочникСсылка.ar_LLMПровайдеры - провайдер LLM.
//   ЗапросПользователя  - Строка    - пользовательский prompt.
//   МаксШагов           - Число     - лимит итераций (1..20), дефолт 5.
//
// Возвращаемое значение:
//   Структура - {
//     Успех        - Булево  - Истина, если цикл завершился штатно;
//     Результат    - Строка  - финальный ответ агента или текст ошибки;
//     Статус       - Строка  - "completed" | "failed" | "max_steps_reached";
//     ЖурналТекст  - Строка  - текстовый лог шагов;
//     ОтветLLM     - Строка  - последний content от LLM (для аудита).
//   }
//
Функция ВыполнитьЦикл(RunId, ПровайдерСсылка, ЗапросПользователя, МаксШагов) Экспорт

	Результат = НовыйРезультат();

	// --- Валидация входа ---------------------------------------------------
	Если ТипЗнч(ЗапросПользователя) <> Тип("Строка") Или ПустаяСтрока(ЗапросПользователя) Тогда
		Результат.Статус = "failed";
		Результат.Результат = НСтр("ru = 'Запрос пользователя не задан'; en = 'User prompt is empty'");
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПровайдерСсылка) Тогда
		Результат.Статус = "failed";
		Результат.Результат = НСтр("ru = 'LLM-провайдер не выбран'; en = 'LLM provider is not selected'");
		Возврат Результат;
	КонецЕсли;

	ЛимитШагов = 5;
	Если ТипЗнч(МаксШагов) = Тип("Число") И МаксШагов >= 1 И МаксШагов <= 20 Тогда
		ЛимитШагов = Цел(МаксШагов);
	КонецЕсли;

	// --- Контекст диалога --------------------------------------------------
	Сообщения = Новый Массив;
	Сообщения.Добавить(СообщениеSystem(СистемныйПромпт()));
	Сообщения.Добавить(СообщениеUser(ЗапросПользователя));

	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("ИДЗапуска", RunId);
	КонтекстЗапуска.Вставить("DryRun", Ложь);

	ОписаниеTools = ПолучитьМанифестTools();

	ЖурналТекст = "";
	ПоследнийОтветLLM = "";
	Шаг = 0;

	// --- Цикл ReAct --------------------------------------------------------
	Пока Шаг < ЛимитШагов Цикл

		Шаг = Шаг + 1;

		ПараметрыЧата = Новый Структура;
		ПараметрыЧата.Вставить("Провайдер", ПровайдерСсылка);
		ПараметрыЧата.Вставить("Tools", ОписаниеTools);

		ОтветLLM = ar_LLMOpenAI.Чат(Сообщения, ПараметрыЧата);

		Если НЕ ОтветLLM.Успех Тогда
			Результат.Статус = "failed";
			Результат.Результат = НСтр("ru = 'Ошибка LLM: '; en = 'LLM error: '") + ОтветLLM.Ошибка;
			ДобавитьВЖурнал(ЖурналТекст, Шаг, "llm_error", "", ОтветLLM.Ошибка);
			Результат.ЖурналТекст = ЖурналТекст;
			Результат.ОтветLLM = ПоследнийОтветLLM;
			Возврат Результат;
		КонецЕсли;

		СообщениеАссистента = ОтветLLM.Сообщение;
		ПоследнийОтветLLM = СтрокаЗначения(СообщениеАссистента, "content");

		// Добавляем ответ ассистента в контекст.
		Сообщения.Добавить(СообщениеAssistant(СообщениеАссистента));

		ToolCalls = Неопределено;
		СообщениеАссистента.Свойство("tool_calls", ToolCalls);

		Если ToolCalls = Неопределено Или ТипЗнч(ToolCalls) <> Тип("Массив") Или ToolCalls.Количество() = 0 Тогда
			// Финальный ответ.
			Результат.Успех = Истина;
			Результат.Статус = "completed";
			Результат.Результат = ПоследнийОтветLLM;
			ДобавитьВЖурнал(ЖурналТекст, Шаг, "final", "", ПоследнийОтветLLM);
			Результат.ЖурналТекст = ЖурналТекст;
			Результат.ОтветLLM = ПоследнийОтветLLM;
			Возврат Результат;
		КонецЕсли;

		// Выполняем каждый tool call.
		Для Каждого ToolCall Из ToolCalls Цикл

			ИмяTool = "";
			АргументыJSON = "";
			ИдВызова = "";

			ToolCall.Свойство("id", ИдВызова);
			ФункцияСтрукт = Неопределено;
			ToolCall.Свойство("function", ФункцияСтрукт);
			Если ТипЗнч(ФункцияСтрукт) = Тип("Структура") Тогда
				ФункцияСтрукт.Свойство("name", ИмяTool);
				ФункцияСтрукт.Свойство("arguments", АргументыJSON);
			КонецЕсли;

			Наблюдение = "";
			Попытка
				Если ИмяTool = "search_clients" Тогда
					Наблюдение = ar_ToolCRM.ПоискКлиентов(АргументыJSON, КонтекстЗапуска);
				Иначе
					Наблюдение = СформироватьОшибкуJSON(
						НСтр("ru = 'неизвестный tool: '; en = 'unknown tool: '") + ИмяTool);
				КонецЕсли;
			Исключение
				Наблюдение = СформироватьОшибкуJSON(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;

			Сообщения.Добавить(СообщениеTool(ИдВызова, ИмяTool, Наблюдение));
			ДобавитьВЖурнал(ЖурналТекст, Шаг, ИмяTool, СтрокаОграничено(АргументыJSON, 500), СтрокаОграничено(Наблюдение, 500));

		КонецЦикла;

	КонецЦикла;

	// Лимит исчерпан.
	Результат.Статус = "max_steps_reached";
	Результат.Результат = ?(ПустаяСтрока(ПоследнийОтветLLM),
		НСтр("ru = 'Достигнут лимит шагов'; en = 'Max steps reached'"),
		ПоследнийОтветLLM);
	Результат.ЖурналТекст = ЖурналТекст;
	Результат.ОтветLLM = ПоследнийОтветLLM;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает структуру результата по умолчанию.
Функция НовыйРезультат()
	Стр = Новый Структура;
	Стр.Вставить("Успех", Ложь);
	Стр.Вставить("Результат", "");
	Стр.Вставить("Статус", "failed");
	Стр.Вставить("ЖурналТекст", "");
	Стр.Вставить("ОтветLLM", "");
	Возврат Стр;
КонецФункции

// Фиксированный системный промпт этапа 0.
Функция СистемныйПромпт()
	Возврат НСтр(
		"ru = 'Ты — AI-ассистент, интегрированный в систему 1С:Предприятие.
		|Отвечай на русском языке. Используй доступные инструменты для
		|выполнения задачи. Когда задача выполнена, дай краткий итоговый ответ.';
		|en = 'You are an AI assistant integrated into 1C:Enterprise.
		|Answer in Russian. Use available tools to accomplish the task.
		|When done, provide a concise final answer.'");
КонецФункции

// Манифест tools для этапа 0 (только search_clients).
// Возвращает массив в формате OpenAI tools.
Функция ПолучитьМанифестTools()

	Массив = Новый Массив;

	Tool = Новый Соответствие;
	Tool.Вставить("type", "function");

	Параметры = Новый Соответствие;
	Параметры.Вставить("type", "object");

	Свойства = Новый Соответствие;

	СвойствоQuery = Новый Соответствие;
	СвойствоQuery.Вставить("type", "string");
	СвойствоQuery.Вставить("description", "Поисковая строка: часть наименования, ИНН или КПП контрагента");
	Свойства.Вставить("query", СвойствоQuery);

	СвойствоLimit = Новый Соответствие;
	СвойствоLimit.Вставить("type", "integer");
	СвойствоLimit.Вставить("description", "Максимальное число записей (1..50), по умолчанию 10");
	Свойства.Вставить("limit", СвойствоLimit);

	Параметры.Вставить("properties", Свойства);

	Обязательные = Новый Массив;
	Обязательные.Добавить("query");
	Параметры.Вставить("required", Обязательные);

	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", "search_clients");
	Функция_.Вставить("description", "Поиск контрагентов в справочнике Контрагенты по строке (наименование/ИНН/КПП)");
	Функция_.Вставить("parameters", Параметры);

	Tool.Вставить("function", Функция_);
	Массив.Добавить(Tool);

	Возврат Массив;

КонецФункции

// Конструкторы сообщений во внутреннем формате ar_LLMOpenAI.

Функция СообщениеSystem(Текст)
	С = Новый Структура;
	С.Вставить("role", "system");
	С.Вставить("content", Текст);
	Возврат С;
КонецФункции

Функция СообщениеUser(Текст)
	С = Новый Структура;
	С.Вставить("role", "user");
	С.Вставить("content", Текст);
	Возврат С;
КонецФункции

// Из ответа LLM строим запись в контексте: role=assistant, сохраняем tool_calls.
Функция СообщениеAssistant(СообщениеИзLLM)
	С = Новый Структура;
	С.Вставить("role", "assistant");
	С.Вставить("content", СтрокаЗначения(СообщениеИзLLM, "content"));
	ToolCalls = Неопределено;
	Если ТипЗнч(СообщениеИзLLM) = Тип("Структура") И СообщениеИзLLM.Свойство("tool_calls", ToolCalls) Тогда
		Если ТипЗнч(ToolCalls) = Тип("Массив") И ToolCalls.Количество() > 0 Тогда
			С.Вставить("tool_calls", ToolCalls);
		КонецЕсли;
	КонецЕсли;
	Возврат С;
КонецФункции

Функция СообщениеTool(ИдВызова, ИмяTool, Наблюдение)
	С = Новый Структура;
	С.Вставить("role", "tool");
	С.Вставить("content", ?(ТипЗнч(Наблюдение) = Тип("Строка"), Наблюдение, ""));
	С.Вставить("tool_call_id", ?(ТипЗнч(ИдВызова) = Тип("Строка"), ИдВызова, ""));
	Если ТипЗнч(ИмяTool) = Тип("Строка") И НЕ ПустаяСтрока(ИмяTool) Тогда
		С.Вставить("name", ИмяTool);
	КонецЕсли;
	Возврат С;
КонецФункции

// Безопасно достаёт строковое значение по ключу из Структуры/Соответствия.
Функция СтрокаЗначения(Источник, Ключ)
	Значение = Неопределено;
	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Источник.Свойство(Ключ, Значение);
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Значение = Источник.Получить(Ключ);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Формирует JSON-наблюдение об ошибке для возврата LLM.
Функция СформироватьОшибкуJSON(Текст)
	Соотв = Новый Соответствие;
	Соотв.Вставить("error", ?(ТипЗнч(Текст) = Тип("Строка"), Текст, Строка(Текст)));
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Соотв);
	Возврат Запись.Закрыть();
КонецФункции

// Дописывает строку шага в журнал.
Процедура ДобавитьВЖурнал(ЖурналТекст, Шаг, ИмяTool, Аргументы, Наблюдение)
	Строка_ = "[Шаг " + Формат(Шаг, "ЧГ=") + "] " + ИмяTool;
	Если НЕ ПустаяСтрока(Аргументы) Тогда
		Строка_ = Строка_ + " args=" + Аргументы;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Наблюдение) Тогда
		Строка_ = Строка_ + " → " + Наблюдение;
	КонецЕсли;
	Если ПустаяСтрока(ЖурналТекст) Тогда
		ЖурналТекст = Строка_;
	Иначе
		ЖурналТекст = ЖурналТекст + Символы.ПС + Строка_;
	КонецЕсли;
КонецПроцедуры

// Безопасное ограничение длины строки (для журнала).
Функция СтрокаОграничено(Текст, МаксДлина)
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(Текст) <= МаксДлина Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, МаксДлина) + "...";
КонецФункции

#КонецОбласти
