////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_RuntimeПарсер (Парсер ответа агента - Runtime).
//
// Единственный компонент ядра AgentRunner, отвечающий за извлечение структурированных
// действий агента (tool calls) и текста ответа из единого внутреннего формата
// ответа LLM-диспетчера. Парсер - клиент контракта ar_LLMКонтракт: все провайдеры
// (OpenAI, YandexGPT, GigaChat, Mock, LocalCompatible) приводят ответ к одному
// формату, поэтому парсер не знает, от какого провайдера пришёл ответ.
//
// Модуль чистый: не читает и не пишет ИБ, не делает HTTP, не устанавливает
// привилегированный режим, не вызывает Выполнить/Вычислить. Единственный побочный
// эффект - запись предупреждений в журнал регистрации при пропуске невалидных
// вызовов.
//
// Контракт входа (ОтветLLM от ar_LLMДиспетчер.Вызвать):
//   Структура { Успех, Сообщение { role, content, [tool_calls] }, ... }.
// Контракт выхода (РазобратьОтвет):
//   Структура { Действия - Массив { Имя, ИдВызова, Аргументы }, ТекстОтвета,
//   ЕстьОшибки }.
//
// Что парсер НЕ делает: не проверяет существование tool в ar_Tools, не валидирует
// аргументы по JSON Schema, не добавляет сообщения в состояние, не формирует
// observation - это задачи ar_ToolDispatcher и ar_RuntimeЦикл.
//
// См. спеку: .docs/specs/RT-05.md, Plan §2.8, §3.14.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Разбирает ответ LLM в массив действий агента (tool calls) и текст ответа.
//
// Основной путь - нативные tool_calls из сообщения ассистента (OpenAI-формат
// после приведения контрактом). Резервный путь - тег-формат
// <tool_call>...</tool_call> в тексте для LocalCompatible-провайдеров без native
// function calling. Резервный путь включается только при отсутствии нативных
// tool_calls - двойного парсинга не происходит.
//
// Каждый вызов проходит базовую валидацию: тип элемента, тип "function", непустое
// имя tool, размер аргументов (лимит 64 KB через ar_JSON.ПроверитьРазмерАргументов),
// валидность JSON аргументов (через ar_JSON.ИзJSON). Невалидные вызовы
// пропускаются, признак ЕстьОшибки выставляется в Истина, в журнал пишется
// предупреждение. Валидные вызовы добавляются в Действия. Пустой массив Действия -
// нормальное завершение цикла (финальный текстовый ответ без tool calls).
//
// Параметры:
//   ОтветLLM - Структура - ответ ar_LLMДиспетчер.Вызвать. Любой другой тип, а
//              также Успех = Ложь или отсутствие Сообщения трактуются как пустой
//              результат без ошибки (ошибка LLM обрабатывается в цикле до парсинга).
//
// Возвращаемое значение:
//   Структура:
//     * Действия    - Массив - элементы Структур { Имя - Строка, ИдВызова - Строка,
//                     Аргументы - Строка JSON }. Может быть пустым.
//     * ТекстОтвета - Строка - content из сообщения ассистента ("" если нет).
//     * ЕстьОшибки  - Булево - Истина, если хотя бы один вызов был пропущен из-за
//                     невалидности (частичный парсинг).
//   Не выбрасывает исключений наружу.
//
Функция РазобратьОтвет(Знач ОтветLLM) Экспорт

	Результат = НовыйРезультат();

	// Проверка входа: не Структура, неуспешный ответ или отсутствие сообщения -
	// пустой результат без ошибки (ошибка LLM уже обработана циклом до парсинга).
	Если ТипЗнч(ОтветLLM) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	// Контракт диспетчера всегда содержит поле Успех. Если по какой-то причине
	// поле отсутствует - продолжаем парсинг (дефолт Истина): неуспешный ответ
	// LLM перехватывается циклом до вызова парсера, поэтому Успех = Ложь здесь -
	// это страховка, а не основной путь.
	Успех = Истина;
	ОтветLLM.Свойство("Успех", Успех);
	Если Успех = Ложь Тогда
		Возврат Результат;
	КонецЕсли;

	Сообщение = Неопределено;
	ОтветLLM.Свойство("Сообщение", Сообщение);
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	// Текст ответа (content): пустая строка, если поля нет или оно не строка.
	Результат.ТекстОтвета = ТекстСообщения(Сообщение);

	// Основной путь: нативные tool_calls из сообщения.
	ToolCalls = Неопределено;
	Сообщение.Свойство("tool_calls", ToolCalls);
	Если ТипЗнч(ToolCalls) <> Тип("Массив") Тогда
		ToolCalls = Неопределено;
	КонецЕсли;

	// Резервный путь: тег-формат в тексте (LocalCompatible без native tool_calls).
	Если ToolCalls = Неопределено
		И СтрНайти(Результат.ТекстОтвета, ТегНачала()) > 0 Тогда
		ToolCalls = ИзвлечьToolCallsИзТекста(Результат.ТекстОтвета);
	КонецЕсли;

	// Нет вызовов - финальный текстовый ответ, не ошибка.
	Если ToolCalls = Неопределено Или ToolCalls.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ToolCall Из ToolCalls Цикл
		ОбработатьToolCall(ToolCall, Результат);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт пустую структуру результата парсинга с дефолтными значениями.
Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Действия", Новый Массив);
	Результат.Вставить("ТекстОтвета", "");
	Результат.Вставить("ЕстьОшибки", Ложь);
	Возврат Результат;

КонецФункции

// Обрабатывает один элемент tool_calls: валидирует и при успехе добавляет
// действие в Результат.Действия. При невалидности пропускает вызов, выставляет
// Результат.ЕстьОшибки и пишет предупреждение в журнал.
//
// Параметры:
//   ToolCall  - Произвольный - элемент массива tool_calls (Структура / Соответствие
//               из контракта или Соответствие из ИзJSON в тег-пути).
//   Результат - Структура - аккумулятор результата парсинга (изменяется).
Процедура ОбработатьToolCall(Знач ToolCall, Результат)

	// Элемент должен быть Структурой или Соответствием.
	Если ТипЗнч(ToolCall) <> Тип("Структура") И ТипЗнч(ToolCall) <> Тип("Соответствие") Тогда
		Результат.ЕстьОшибки = Истина;
		ЗаписатьПредупреждение(
			НСтр("ru = 'tool_call пропущен: элемент не является структурой';
				|en = 'tool_call skipped: element is not a structure'"));
		Возврат;
	КонецЕсли;

	// Тип вызова: допускаем "function" или пустой; иное - неизвестный тип,
	// пропускаем без ошибки (расширяемость на будущие типы).
	ТипВызова = ПолеОбъекта(ToolCall, "type");
	Если ЗначениеЗаполнено(ТипВызова) И ТипВызова <> "function" Тогда
		Возврат;
	КонецЕсли;

	ИдВызова = ПолеОбъекта(ToolCall, "id");

	ФункцияСтрукт = ПолеОбъектаЗначение(ToolCall, "function");
	Если ТипЗнч(ФункцияСтрукт) <> Тип("Структура") И ТипЗнч(ФункцияСтрукт) <> Тип("Соответствие") Тогда
		Результат.ЕстьОшибки = Истина;
		ЗаписатьПредупреждение(
			НСтр("ru = 'tool_call пропущен: поле function отсутствует или некорректно';
				|en = 'tool_call skipped: function field is missing or invalid'"));
		Возврат;
	КонецЕсли;

	Имя = ПолеОбъекта(ФункцияСтрукт, "name");
	Если ПустаяСтрока(Имя) Тогда
		Результат.ЕстьОшибки = Истина;
		ЗаписатьПредупреждение(
			НСтр("ru = 'tool_call пропущен: пустое имя tool';
				|en = 'tool_call skipped: empty tool name'"));
		Возврат;
	КонецЕсли;

	АргументыСтрока = ПолеОбъекта(ФункцияСтрукт, "arguments");
	Если ПустаяСтрока(АргументыСтрока) Тогда
		АргументыСтрока = "{}";
	КонецЕсли;

	// Проверка размера аргументов (UTIL-03, лимит 64 KB).
	ПроверкаРазмера = ar_JSON.ПроверитьРазмерАргументов(АргументыСтрока);
	Если НЕ ПроверкаРазмера.Корректно Тогда
		Результат.ЕстьОшибки = Истина;
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'tool_call ""%1"" пропущен: %2 (размер %3 байт)';
				|en = 'tool_call ""%1"" skipped: %2 (size %3 bytes)'"),
			Имя, ПроверкаРазмера.Сообщение, Формат(ПроверкаРазмера.РазмерБайт, "ЧГ=0")));
		Возврат;
	КонецЕсли;

	// Валидация JSON аргументов. Пустой объект "{}" валиден. ar_JSON.ИзJSON
	// возвращает Неопределено для невалидного JSON и сам инкапсулирует Попытку.
	Если ar_JSON.ИзJSON(АргументыСтрока) = Неопределено Тогда
		Результат.ЕстьОшибки = Истина;
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'tool_call ""%1"" пропущен: невалидный JSON в аргументах';
				|en = 'tool_call ""%1"" skipped: invalid JSON in arguments'"),
			Имя));
		Возврат;
	КонецЕсли;

	Действие = Новый Структура;
	Действие.Вставить("Имя", Имя);
	Действие.Вставить("ИдВызова", ИдВызова);
	Действие.Вставить("Аргументы", АргументыСтрока);
	Результат.Действия.Добавить(Действие);

КонецПроцедуры

// Извлекает tool calls из текста в тег-формате LocalCompatible:
//   <tool_call>{"tool": "имя_tool", "args": {...}}</tool_call>
//
// Каждый фрагмент десериализуется через ar_JSON.ИзJSON. Поле "tool" -> name,
// "args" сериализуется обратно через ar_JSON.ВЗначениеJSON -> arguments.
// Собирается стандартная структура { id, type, function { name, arguments } },
// id генерируется как UUID-строка. Невалидные фрагменты пропускаются, поиск
// продолжается со следующего тега.
//
// Параметры:
//   Текст - Строка - текст ответа ассистента.
//
// Возвращаемое значение:
//   Массив - массив Структур формата контракта tool_call. Может быть пустым.
Функция ИзвлечьToolCallsИзТекста(Знач Текст)

	Результат = Новый Массив;

	ТегНач = ТегНачала();
	ТегКон = ТегКонца();
	ПозицияПоиска = 1;

	Пока Истина Цикл

		НачалоТега = СтрНайти(Текст, ТегНач, НаправлениеПоиска.СНачала, ПозицияПоиска);
		Если НачалоТега = 0 Тогда
			Прервать;
		КонецЕсли;

		НачалоСодержимого = НачалоТега + СтрДлина(ТегНач);
		КонецТега = СтрНайти(Текст, ТегКон, НаправлениеПоиска.СНачала, НачалоСодержимого);
		Если КонецТега = 0 Тогда
			Прервать;
		КонецЕсли;

		Фрагмент = Сред(Текст, НачалоСодержимого, КонецТега - НачалоСодержимого);
		ПозицияПоиска = КонецТега + СтрДлина(ТегКон);

		ToolCall = ToolCallИзФрагмента(Фрагмент);
		Если ToolCall <> Неопределено Тогда
			Результат.Добавить(ToolCall);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует один JSON-фрагмент тега в структуру tool_call контракта.
//
// Параметры:
//   Фрагмент - Строка - JSON-содержимое тега <tool_call>...</tool_call>.
//
// Возвращаемое значение:
//   Структура - { id, type, function { name, arguments } } или Неопределено,
//   если фрагмент невалиден / нет имени tool.
Функция ToolCallИзФрагмента(Знач Фрагмент)

	Объект = ar_JSON.ИзJSON(Фрагмент);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = ПолеОбъекта(Объект, "tool");
	Если ПустаяСтрока(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	АргументыЗначение = Объект.Получить("args");
	Если АргументыЗначение = Неопределено Тогда
		АргументыСтрока = "{}";
	Иначе
		АргументыСтрока = ar_JSON.ВЗначениеJSON(АргументыЗначение);
		Если ПустаяСтрока(АргументыСтрока) Тогда
			АргументыСтрока = "{}";
		КонецЕсли;
	КонецЕсли;

	ФункцияСтрукт = Новый Структура;
	ФункцияСтрукт.Вставить("name", Имя);
	ФункцияСтрукт.Вставить("arguments", АргументыСтрока);

	ToolCall = Новый Структура;
	ToolCall.Вставить("id", Строка(Новый УникальныйИдентификатор));
	ToolCall.Вставить("type", "function");
	ToolCall.Вставить("function", ФункцияСтрукт);
	Возврат ToolCall;

КонецФункции

// Извлекает текст (content) из сообщения ассистента как Строку.
// Пустая строка, если поля нет или оно не строка.
Функция ТекстСообщения(Знач Сообщение)

	Значение = Неопределено;
	Сообщение.Свойство("content", Значение);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращает значение поля объекта (Структура или Соответствие), приведённое
// к Строке. Дефолт - пустая строка.
//
// Параметры:
//   Объект - Структура, Соответствие - источник.
//   Имя    - Строка - имя поля.
//
// Возвращаемое значение:
//   Строка - значение поля как Строка или "" при отсутствии / не-строковом типе.
Функция ПолеОбъекта(Знач Объект, Знач Имя)

	Значение = ПолеОбъектаЗначение(Объект, Имя);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращает значение поля объекта (Структура или Соответствие) без приведения
// типа. Неопределено при отсутствии поля или неподдерживаемом типе объекта.
//
// Параметры:
//   Объект - Структура, Соответствие - источник.
//   Имя    - Строка - имя поля.
//
// Возвращаемое значение:
//   Произвольный - значение поля или Неопределено.
Функция ПолеОбъектаЗначение(Знач Объект, Знач Имя)

	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Значение = Неопределено;
		Объект.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект.Получить(Имя);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Открывающий тег tool-вызова для LocalCompatible-формата.
Функция ТегНачала()
	Возврат "<tool_call>";
КонецФункции

// Закрывающий тег tool-вызова для LocalCompatible-формата.
Функция ТегКонца()
	Возврат "</tool_call>";
КонецФункции

// Пишет предупреждение в журнал регистрации от имени модуля-парсера.
Процедура ЗаписатьПредупреждение(Знач Сообщение)

	ЗаписьЖурналаРегистрации(
		"ar_RuntimeПарсер",
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		Сообщение);

КонецПроцедуры

#КонецОбласти
