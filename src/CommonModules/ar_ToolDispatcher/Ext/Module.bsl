// EXT-10: маршрутизация к пользовательским tool-модулям вынесена в отдельный
// переопределяемый общий модуль ar_ToolПереопределяемый.ВызватьПользовательскийТул
// (вызывается напрямую из ВыполнитьЯдровойМодуль, ветвь Иначе, см. выше).
// Прежний stub ВызватьРасширение (Expert Pack, EXT-01) удалён - схема
// "расширение поверх расширения" физически нереализуема в 1С.

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызвать ЗарегистрироватьTools() одного модуля с перехватом ошибок.
// Агрегирует статистику в структуру Итог {Создано, Обновлено}.
// При ошибке - пишет в ЖурналРегистрации (Предупреждение) и продолжает.
//
// Параметры:
//  ИмяМодуля - Строка    - имя общего модуля (например "ar_ToolПамять").
//  Итог      - Структура - {Создано, Обновлено} - счётчик обновляется по ссылке.
//
Процедура ЗарегистрироватьМодуль(Знач ИмяМодуля, Итог)

	Попытка
		Результат = Неопределено;

		Если ИмяМодуля = "ar_ToolUniversal" Тогда
			Результат = ar_ToolUniversal.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolОтчёты" Тогда
			Результат = ar_ToolОтчёты.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolInteraction" Тогда
			// ar_ToolInteraction.ЗарегистрироватьTools() - Процедура, возвращаемого значения нет (TOOL-19).
			// Вызов без присвоения; статистика не меняется.
			ar_ToolInteraction.ЗарегистрироватьTools();
			Результат = Неопределено;
		ИначеЕсли ИмяМодуля = "ar_ToolПамять" Тогда
			Результат = ar_ToolПамять.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolКоммуникации" Тогда
			Результат = ar_ToolКоммуникации.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolАварийный" Тогда
			// ar_ToolАварийный.ЗарегистрироватьTools() пишет в ar_Tools - выполняем
			// в привилегированном режиме здесь (DoD D13 TOOL-18: УстановитьПривилегированныйРежим
			// запрещен внутри самого tool-модуля ar_ToolАварийный).
			// Канонический паттерн std485: сброс в ветви Исключение, затем после КонецПопытки.
			УстановитьПривилегированныйРежим(Истина);
			Попытка
				Результат = ar_ToolАварийный.ЗарегистрироватьTools();
			Исключение
				УстановитьПривилегированныйРежим(Ложь);
				ВызватьИсключение;
			КонецПопытки;
			УстановитьПривилегированныйРежим(Ложь);
		ИначеЕсли ИмяМодуля = "ar_ToolРеестрПоиск" Тогда
			// SCALE-03: find_tools/describe_tool.
			Результат = ar_ToolРеестрПоиск.ЗарегистрироватьTools();
		Иначе
			ЗаписьЖурналаРегистрации(
				"AgentRunner.ЗарегистрироватьВсеTools",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				НСтр("ru='Неизвестный модуль: '; en='Unknown module: '") + ИмяМодуля);
			Возврат;
		КонецЕсли;

		НормализоватьСтатистику(Результат, Итог);

	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"AgentRunner.ЗарегистрироватьВсеTools",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			НСтр("ru='Ошибка регистрации модуля '; en='Error registering module '")
				+ ИмяМодуля + ": " + ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Привести разнотипный результат ЗарегистрироватьTools() к {Создано, Обновлено}
// и добавить значения к накопленному итогу. Нормализация нужна из-за разных
// контрактов модулей: Число (только Создано), Структура {Создано, Обновлено}
// или Неопределено (Процедура без возврата).
//
// Параметры:
//  Результат - Произвольный - значение, возвращённое ЗарегистрироватьTools().
//  Итог      - Структура    - {Создано, Обновлено} - модифицируется по ссылке.
//
Процедура НормализоватьСтатистику(Знач Результат, Итог)

	ТипРезультата = ТипЗнч(Результат);

	Если ТипРезультата = Тип("Структура") Тогда
		Создано = 0;
		Обновлено = 0;
		Результат.Свойство("Создано", Создано);
		Результат.Свойство("Обновлено", Обновлено);
		ДельтаСоздано   = ?(ТипЗнч(Создано)   = Тип("Число"), Создано,   0);
		ДельтаОбновлено = ?(ТипЗнч(Обновлено) = Тип("Число"), Обновлено, 0);
		Итог.Создано   = Итог.Создано   + ДельтаСоздано;
		Итог.Обновлено = Итог.Обновлено + ДельтаОбновлено;
	ИначеЕсли ТипРезультата = Тип("Число") Тогда
		// ar_ToolUniversal возвращает только Создано (без Обновлено).
		Итог.Создано = Итог.Создано + Результат;
	КонецЕсли;
	// Неопределено или неожиданный тип: ar_ToolInteraction (Процедура) - итог не меняется.

КонецПроцедуры

// Подсчитать количество записей в справочнике ar_Tools (без пометки удаления).
// Используется в ПриНачалеРаботыСистемы для проверки пустоты реестра.
//
// Возвращаемое значение:
//  Число - количество активных записей.
//
Функция КоличествоЗаписейTools()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Tools.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;

КонецФункции

// 4 базовых логических имени, зашитых по умолчанию в tool-модулях (ar_ToolCRM,
// ar_ToolДокументы и т.п.) - fallback-часть СписокИзвестныхЛогическихИмен для
// пустой базы (нет ни одной записи в ar_ПереопределенияОбъектов).
//
// Возвращаемое значение:
//  Массив из Строка - 4 фиксированных логических имени.
//
Функция ФоллбэкЛогическиеИмена()

	Результат = Новый Массив;
	Результат.Добавить("Контрагенты");
	Результат.Добавить("Номенклатура");
	Результат.Добавить("Организации");
	Результат.Добавить("СчетНаОплатуПокупателю");
	Возврат Результат;

КонецФункции

// Добавляет строку в таблицу ПредставленияTools (UI-31).
//
Процедура ДобавитьПредставление(Таблица, Знач ИмяTool, Знач Представление, Знач Категория)

	СтрокаТаблицы = Новый Структура;
	СтрокаТаблицы.Вставить("Представление", Представление);
	СтрокаТаблицы.Вставить("Категория",     Категория);
	Таблица.Вставить(ИмяTool, СтрокаТаблицы);

КонецПроцедуры

// Технические коды категорий tools для группировки в попапе композера (UI-31)
// и карты категорий в системном промпте (SCALE-05, ar_КатегорииTools).
//
// SCALE-01: раньше эти функции возвращали готовый локализованный текст
// (НСтр) - теперь возвращают СТАБИЛЬНЫЙ КОД (латиница, snake_case), тот же,
