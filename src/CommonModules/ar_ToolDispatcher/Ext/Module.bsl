		90, НСтр("ru='Взаимодействие'; en='Interaction'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияСлужебные(),
		НСтр("ru='Служебные'; en='Utility'"),
		НСтр("ru='аварийная запись объекта'; en='fallback object save'"),
		100, НСтр("ru='Служебные'; en='Utility'")));

	Возврат Список;

КонецФункции

// Строка таблицы СписокЯдровыхКатегорий - см. описание полей там.
//
Функция НоваяКатегорияРегистрации(Знач Код, Знач Наименование, Знач ОписаниеДляLLM, Знач Порядок, Знач СтароеПредставление)
	Возврат Новый Структура("Код, Наименование, ОписаниеДляLLM, Порядок, СтароеПредставление",
		Код, Наименование, ОписаниеДляLLM, Порядок, СтароеПредставление);
КонецФункции

// Вызвать hook AfterToolCall (HOOK-03, точка 6). Единая точка для всех
// return-путей диспетчера (успех + ошибки). Не выбрасывает исключений.
//
// Параметры:
//  КонтекстЗапуска - Структура - контекст запуска.
//  RunId           - Строка - идентификатор запуска.
//  Действие        - Структура - {Имя, Аргументы, ИдВызова}.
//  РезультатВызова - Структура - {Успех, Результат, ResultRef, RiskLevel}.
//
Процедура ВызватьHookAfterToolCall(Знач КонтекстЗапуска, Знач RunId, Знач Действие, Знач РезультатВызова)

	КонтекстСобытияAfter = Новый Структура;
	КонтекстСобытияAfter.Вставить("RunId", RunId);
	КонтекстСобытияAfter.Вставить("Событие", Перечисления.ar_СобытиеHook.AfterToolCall);
	КонтекстСобытияAfter.Вставить("Действие", Действие);
	КонтекстСобытияAfter.Вставить("РезультатTool", РезультатВызова);
	КонтекстСобытияAfter.Вставить("Sequence", ЗначениеКонтекста(КонтекстЗапуска, "Sequence", 0));
	КонтекстСобытияAfter.Вставить("DryRun", ЗначениеКонтекста(КонтекстЗапуска, "DryRun", Ложь));
	АгентHook = Неопределено;
	КонтекстЗапуска.Свойство("Агент", АгентHook);
	Если АгентHook <> Неопределено Тогда
		КонтекстСобытияAfter.Вставить("Агент", АгентHook);
	КонецЕсли;
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.AfterToolCall, КонтекстСобытияAfter);

КонецПроцедуры

// Прочитать данные tool одним запросом. Возвращает Неопределено, если tool
// помечен на удаление, выключен или его реализация не заполнена: при
// ИсточникТип = «Ядро» - не заполнены модуль/процедура, при ИсточникТип =
// «Пакет» (PKG-04) - не заполнен ИдентификаторПакета. Режим «Код» удалён
// (SEC-TOOL-02).
//
// Параметры:
//  СсылкаTool - СправочникСсылка.ar_Tools - tool, данные которого читаются.
//
// Возвращаемое значение:
//  Структура { Имя, ОбщийМодуль, ИмяПроцедуры, RiskLevel, ИсточникТип,
//              ИдентификаторПакета, Namespace, ТребуетApproval } - либо
//  Неопределено, если tool не найден, помечен на удаление, выключен или
//  реализация не заполнена (см. выше).
//
Функция ПрочитатьДанныеTool(Знач СсылкаTool)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_ОбщийМодуль КАК ОбщийМодуль,
		|	Tools.ar_ИмяПроцедуры КАК ИмяПроцедуры,
		|	Tools.ar_RiskLevel КАК RiskLevel,
		|	Tools.ar_ТребуетApproval КАК ТребуетApproval,
		|	Tools.ar_Включён КАК Активен,
		|	Tools.ПометкаУдаления КАК ПометкаУдаления,
		|	Tools.ar_ИсточникТип КАК ИсточникТип,
		|	Tools.ar_ИдентификаторПакета КАК ИдентификаторПакета,
		|	Tools.ar_Namespace КАК Namespace,
		|	Tools.ar_ЗамерПроизводительности КАК ЗамерПроизводительности
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаTool);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Выборка.ПометкаУдаления Или Выборка.Активен <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбщийМодуль = СокрЛП(Выборка.ОбщийМодуль);
	ИмяПроцедуры = СокрЛП(Выборка.ИмяПроцедуры);

	// ИсточникТип: пусто - "Ядро" (обратная совместимость для всех записей,
	// заведённых до PKG-03 - см. комментарий к реквизиту ar_ИсточникТип).
	ИсточникТип = СокрЛП(Выборка.ИсточникТип);
	Если ПустаяСтрока(ИсточникТип) Тогда
		ИсточникТип = "Ядро";
	КонецЕсли;
	ИдентификаторПакета = СокрЛП(Выборка.ИдентификаторПакета);
	Namespace = СокрЛП(Выборка.Namespace);

	// Требование заполненности реализации зависит от ИсточникТип (PKG-04):
	// "Ядро" - обязательны ОбщийМодуль+ИмяПроцедуры; "Пакет" - обязателен
	// непустой ИдентификаторПакета, ОбщийМодуль/ИмяПроцедуры для пакетных
	// tools не заполняются (см. .docs/specs/PKG-04.md). Режим «Код» удалён
	// (SEC-TOOL-02) - двухуровневое ветвление вместо трёхуровневого.
	Если ИсточникТип = "Пакет" Тогда
		Если ПустаяСтрока(ИдентификаторПакета) Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(ОбщийМодуль) Или ПустаяСтрока(ИмяПроцедуры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Имя",                 СокрЛП(Выборка.Имя));
	Данные.Вставить("ОбщийМодуль",         ОбщийМодуль);
	Данные.Вставить("ИмяПроцедуры",        ИмяПроцедуры);
	Данные.Вставить("RiskLevel",           ИмяRiskLevel(Выборка.RiskLevel));
	Данные.Вставить("ИсточникТип",         ИсточникТип);
	Данные.Вставить("ИдентификаторПакета", ИдентификаторПакета);
	Данные.Вставить("Namespace",           Namespace);
	Данные.Вставить("ТребуетApproval", Выборка.ТребуетApproval = Истина);
	Данные.Вставить("ЗамерПроизводительности", Выборка.ЗамерПроизводительности = Истина);
	Возврат Данные;

КонецФункции

// Имя значения перечисления RiskLevel ("Read"/"Draft"/"Write"/"Commit").
// Пустая/неверная ссылка → "Read" (безопасный дефолт).
//
Функция ИмяRiskLevel(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("ПеречислениеСсылка.ar_RiskLevel")
		Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "Read";
	КонецЕсли;
	Для Каждого ЗначениеМД Из Метаданные.Перечисления.ar_RiskLevel.ЗначенияПеречисления Цикл
		Если Перечисления.ar_RiskLevel[ЗначениеМД.Имя] = Значение Тогда
			Возврат ЗначениеМД.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "Read";
КонецФункции

// Вес замера производительности (PERF-01) из JSON-observation tool: число
// возвращённых строк, где применимо. Вызывается ТОЛЬКО когда замер фактически
// включён (см. ЗамерВключён в Вызвать) - разбор ответа ради метрики не должен
// быть безусловной операцией горячего пути.
//
// Приоритет: числовое поле верхнего уровня "count" → длина массива
// "items"/"rows"/"results" → 1 (tool без табличного ответа, либо битый JSON).
// Вся функция в Попытка - сбой разбора не имеет права уронить вызов tool.
//
// Параметры:
//  ОтветTool - Строка - JSON-observation, возвращённый реализацией tool.
//
// Возвращаемое значение:
//  Число - вес замера, минимум 1.
//
Функция ВесЗамераИзОтвета(Знач ОтветTool)

	Попытка
		Объект = ar_JSON.ИзJSON(ОтветTool);
		Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
			Возврат 1;
		КонецЕсли;

		Количество = Объект.Получить("count");
		Если ТипЗнч(Количество) = Тип("Число") Тогда
			Возврат Количество;
		КонецЕсли;

		Для Каждого ИмяПоля Из НовыйМассивИмёнКоллекций() Цикл
			Коллекция = Объект.Получить(ИмяПоля);
			Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
				Возврат Коллекция.Количество();
			КонецЕсли;
		КонецЦикла;

		Возврат 1;
	Исключение
		Возврат 1;
	КонецПопытки;

КонецФункции

// Имена полей-массивов верхнего уровня JSON-observation, проверяемых как
// fallback-источник ВесЗамераИзОтвета, если поле "count" отсутствует/не число.
//
Функция НовыйМассивИмёнКоллекций()
	Массив = Новый Массив;
	Массив.Добавить("items");
	Массив.Добавить("rows");
	Массив.Добавить("results");
	Возврат Массив;
КонецФункции

// Обогатить JSON-аргументы системными полями: _dry_run и (для commit-tools)
// _idempotency_key. Поля кладутся диспетчером, не LLM. При сбое разбора JSON
// возвращаются исходные аргументы (tool сам обработает невалидный JSON).
//
Функция ОбогатитьАргументы(Знач Аргументы, Знач ДанныеTool, Знач КонтекстЗапуска, Знач DryRun)

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		// Невалидный/не объектный JSON - не обогащаем, отдаём как есть.
		Возврат Аргументы;
	КонецЕсли;

	Объект.Вставить("_dry_run", DryRun);

	Если ДанныеTool.ТребуетApproval Тогда
		Объект.Вставить("_idempotency_key", СформироватьIdempotencyKey(КонтекстЗапуска));
	КонецЕсли;

	JSONРезультат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(JSONРезультат), Аргументы, JSONРезультат);

КонецФункции

// Детерминированный IdempotencyKey для commit-tools: RunId + "_" + Sequence.
// Если RunId пуст - генерируется UUID (запуск вне стандартного потока).
//
Функция СформироватьIdempotencyKey(Знач КонтекстЗапуска)
	RunId = ЗначениеКонтекста(КонтекстЗапуска, "RunId", "");
	Если ПустаяСтрока(RunId) Тогда
		Возврат ar_Утилиты.НовыйUUID();
	КонецЕсли;
	Sequence = ЗначениеКонтекста(КонтекстЗапуска, "Sequence", 0);
	НомерДействия = ?(ТипЗнч(Sequence) = Тип("Число"), Цел(Sequence), 0);
	Возврат RunId + "_" + Формат(НомерДействия, "ЧГ=0; ЧН=0");
КонецФункции

// Записать действие в журнал ar_ДействияАгента. При чистом DryRun действие
// записывается с маркером dry_run в имени tool (для трассировки симуляций).
//
// ДлительностьМС/ЗавершёнСОшибкой (PERF-04) - последние параметры со значениями
// по умолчанию: существующий вызов на ветке arguments_too_large (вызова ещё не
// было) остаётся корректным без правки, записывая ar_ДлительностьМС = 0.
// Передаются в ar_AuditЗащищённыйРежим.ЗаписатьДействиеПривилегированно через
// её существующий параметр ДопДанные - расширения сигнатуры фасада не требуется.
//
// Параметры:
//  КонтекстЗапуска  - Структура - {RunId, Sequence, ...}.
//  ДанныеTool       - Структура - данные tool (ПрочитатьДанныеTool).
//  Аргументы        - Строка - JSON-аргументы вызова.
//  РезультатВызова  - Структура - Результат(...) диспетчера.
//  DryRun           - Булево - маркер симулированного вызова.
//  ДлительностьМС   - Число - результат ТекущаяУниверсальнаяДатаВМиллисекундах() минус
//                     ВремяНачалаРезервное (PERF-02), то же значение, что пишется в
//                     ar_СлужебныйЛог. Второго независимого измерения быть не должно.
//  ЗавершёнСОшибкой - Булево - Истина на ветке Исключение либо при наличии ключа
//                     "error" в observation (та же проверка, что и в СтрокаНаблюдения/
//                     ИзвлечьResultRef).
//
Процедура ЗаписатьДействиеЖурнал(Знач КонтекстЗапуска, Знач ДанныеTool, Знач Аргументы,
		Знач РезультатВызова, Знач DryRun = Ложь, Знач ДлительностьМС = 0,
		Знач ЗавершёнСОшибкой = Ложь)

	RunId = ЗначениеКонтекста(КонтекстЗапуска, "RunId", "");
	Если ПустаяСтрока(RunId) Тогда
		Возврат;
	КонецЕсли;

	Sequence = ЗначениеКонтекста(КонтекстЗапуска, "Sequence", 0);
	ИмяДляЖурнала = ?(DryRun, ДанныеTool.Имя + " (dry_run)", ДанныеTool.Имя);

	ДопДанные = Новый Структура;
	ДопДанные.Вставить("ДлительностьМС", ДлительностьМС);
	ДопДанные.Вставить("ЗавершёнСОшибкой", ЗавершёнСОшибкой);

	ar_AuditЗащищённыйРежим.ЗаписатьДействиеПривилегированно(
		RunId, Sequence, ИмяДляЖурнала, Аргументы,
		РезультатВызова.RiskLevel, РезультатВызова.ResultRef, ДопДанные);

КонецПроцедуры

// Определяет признак ar_ЗавершёнСОшибкой (PERF-04) по наличию ключа "error"
// верхнего уровня в JSON-observation успешного вызова. Тот же паттерн разбора,
// что ИзвлечьResultRef/СтрокаНаблюдения - невалидный JSON или отсутствие ключа
// трактуются как "без ошибки" (ошибка исполнения уже покрыта веткой Исключение).
//
// Параметры:
//  ОтветTool - Строка, Произвольный - ответ tool (ещё не приведённый к строке).
//
// Возвращаемое значение:
//  Булево - Истина, если JSON-observation содержит непустой ключ "error".
//
Функция ОтветСодержитОшибку(Знач ОтветTool)

	Если ТипЗнч(ОтветTool) <> Тип("Строка") Или ПустаяСтрока(ОтветTool) Тогда
		Возврат Ложь;
	КонецЕсли;

	Объект = ar_JSON.ИзJSON(ОтветTool);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Значение = Объект.Получить("error");
	Возврат Значение <> Неопределено И Не (ТипЗнч(Значение) = Тип("Строка") И ПустаяСтрока(Значение));

КонецФункции

// Резервный путь замера длительности tool (PERF-02): пишет компактную запись
// в ar_СлужебныйЛог БЕЗУСЛОВНО - независимо от ЗамерВключён и наличия
// подсистемы БСП "Оценка производительности" (в этом весь смысл резервного
// пути диагностики).
//
// ДлительностьМС (PERF-04): принимается готовым числом, а не вычисляется внутри
// функции - вызывающий код (Вызвать) считает её ОДИН раз от ВремяНачалаРезервное
// (ТекущаяУниверсальнаяДатаВМиллисекундах(), поставленного безусловно перед
// Попыткой) и передаёт то же значение сюда и в ЗаписатьДействиеЖурнал
// (ar_ДлительностьМС регистра ar_ДействияАгента). Так гарантируется, что лог и
// регистр несут идентичное число - второго независимого замера времени нет.
//
// Аргументы вызова tool в текст НЕ включаются (требование PERF-02) - лог несёт
// только служебный контекст. КодОшибки (если передан) маскируется через
// ar_Утилиты.МаскироватьСекреты - на случай, если в будущем в код ошибки
// попадёт фрагмент текста стороннего API с токеном.
//
// Запись обёрнута в Попытку: ошибка самого логирования (например, временная
// проблема с БД) не должна ронять результат tool, который уже вычислен и
// готов к возврату модели - диспетчер по контракту не выбрасывает исключений.
// Сама ошибка логирования не теряется молча - фиксируется отдельной строкой
// в системный журнал регистрации (не в ar_СлужебныйЛог - если проблема именно
// в записи в регистр, повторная попытка записи туда же бессмысленна).
//
// PERF-05: та же точка (единственная, где резервная длительность известна
// безусловно) используется для автообнаружения медленных tools - при
// превышении ar_Константы.ПорогМедленногоToolСек() пишется вторая запись
// ar_СлужебныйЛог с событием "slow_tool" уровня "Предупреждение". Отдельная
// запись, а не переиспользование tool_duration - "slow_tool" фильтруется в
// логе по Событию независимо от штатной диагностики длительности.
//
// Параметры:
//  ИмяTool         - Строка - ar_Имя вызванного tool.
//  ДлительностьМС  - Число - готовая длительность (ТекущаяУниверсальнаяДатаВМиллисекундах()
//                    минус ВремяНачалаРезервное), вычисленная один раз в Вызвать.
//  Implementation  - Строка - "package" / "procedure".
//  Вес             - Число - вес замера (ВесЗамераИзОтвета на успехе; 1 на
//                    ветке Исключение - ОтветTool там не существует).
//  DryRun          - Булево - флаг симулированного вызова.
//  ЕстьОшибка      - Булево - Истина на ветке Исключение.
//  КодОшибки       - Строка - короткий код (например "tool_exception") при
//                    ЕстьОшибка = Истина; иначе "".
//  RunId           - Строка - идентификатор запуска для группировки в логе.
//  Namespace       - Строка - ar_Namespace карточки tool (заполнен только для
//                    ИсточникТип = "Пакет"); используется в тексте "slow_tool"
//                    для указания источника ("Ядро" / "Пакет <ns>"). Значение
//                    по умолчанию "" соответствует источнику "Ядро".
//
Процедура ЗаписатьРезервныйЛогДлительности(Знач ИмяTool, Знач ДлительностьМС,
	Знач Implementation, Знач Вес, Знач DryRun, Знач ЕстьОшибка, Знач КодОшибки, Знач RunId,
	Знач Namespace = "")

	ВесБезопасный = ?(ТипЗнч(Вес) = Тип("Число"), Вес, 1);
	ДлительностьМСБезопасная = ?(ТипЗнч(ДлительностьМС) = Тип("Число"), ДлительностьМС, 0);

	Попытка
		ФорматЧисла = "ЧЦ=0; ЧГ=0";

		ТекстЛога = "tool=" + ?(ТипЗнч(ИмяTool) = Тип("Строка"), ИмяTool, "")
			+ "; ms=" + Формат(ДлительностьМСБезопасная, ФорматЧисла)
			+ "; implementation=" + ?(ТипЗнч(Implementation) = Тип("Строка"), Implementation, "")
			+ "; weight=" + Формат(ВесБезопасный, ФорматЧисла)
			+ "; dry_run=" + Строка(DryRun = Истина)
			+ "; error=" + Строка(ЕстьОшибка = Истина);

		Если ЕстьОшибка Тогда
			ТекстЛога = ТекстЛога + "; error_code=" + ar_Утилиты.МаскироватьСекреты(КодОшибки);
		КонецЕсли;

		ar_СлужебныйЛог.Записать("ar_ToolDispatcher.Вызвать", "tool_duration", ТекстЛога,
			?(ЕстьОшибка, "Предупреждение", "Информация"), RunId);
	Исключение
		// Резервный путь диагностики не должен ронять результат tool (fail-safe,
		// см. комментарий выше) - но сам факт сбоя логирования фиксируем в
		// системный журнал, а не глотаем молча.
		ЗаписьЖурналаРегистрации(
			"AgentRunner.ЗаписатьРезервныйЛогДлительности",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			НСтр("ru='Ошибка резервного лога tool (RunId='; en='Tool fallback log error (RunId='")
				+ RunId + "): "
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ПроверитьПорогМедленногоTool(ИмяTool, ДлительностьМСБезопасная, ВесБезопасный, RunId, Namespace);

КонецПроцедуры

// PERF-05: автообнаружение медленных tools. При превышении длительностью
// вызова порога ar_Константы.ПорогМедленногоToolСек() пишет в ar_СлужебныйЛог
// предупреждение "slow_tool" - так медленный инструмент заявляет о себе сам,
// без регулярного открытия отчёта «Производительность инструментов».
//
// Порог = 0 отключает автообнаружение (явное решение администратора, не
// "не настроено" - см. ar_Константы.ПорогМедленногоToolСек). Сравнение строго
// больше порога, а не "больше либо равно" - вызов, укладывающийся ровно в
// порог, не считается медленным.
//
// Обёрнута в Попытку по тому же fail-safe принципу, что и вызывающая
// процедура: сбой проверки/записи не должен ронять результат tool.
//
// Параметры:
//  ИмяTool        - Строка - ar_Имя вызванного tool.
//  ДлительностьМС - Число - резервная длительность вызова, мс.
//  Вес            - Число - вес замера (см. ВесЗамераИзОтвета).
//  RunId          - Строка - идентификатор запуска.
//  Namespace      - Строка - ar_Namespace карточки tool, "" для tools ядра.
//
Процедура ПроверитьПорогМедленногоTool(Знач ИмяTool, Знач ДлительностьМС, Знач Вес, Знач RunId,
	Знач Namespace)

	Попытка
		ПорогСек = ar_Константы.ПорогМедленногоToolСек();
		Если ПорогСек <= 0 Тогда
			Возврат; // автообнаружение отключено администратором
		КонецЕсли;

		МиллисекундВСекунде = 1000;
		ПорогМС = ПорогСек * МиллисекундВСекунде;
		Если ДлительностьМС <= ПорогМС Тогда
			Возврат;
		КонецЕсли;

		Источник = ?(ПустаяСтрока(Namespace), "Ядро", "Пакет " + Namespace);
		ВесБезопасный = Макс(Вес, 1);
		СреднееНаСтрокуМС = Окр(ДлительностьМС / ВесБезопасный, 1);

		ФорматЧисла = "ЧЦ=0; ЧГ=0";
		ТекстЛога = "tool=" + ?(ТипЗнч(ИмяTool) = Тип("Строка"), ИмяTool, "")
			+ "; ms=" + Формат(ДлительностьМС, ФорматЧисла)
			+ "; threshold_sec=" + Формат(ПорогСек, ФорматЧисла)
			+ "; weight=" + Формат(ВесБезопасный, ФорматЧисла)
			+ "; ms_per_row=" + Формат(СреднееНаСтрокуМС, "ЧЦ=0; ЧДД=1; ЧГ=0")
			+ "; source=" + Источник;

		ar_СлужебныйЛог.Записать("ar_ToolDispatcher.Вызвать", "slow_tool", ТекстЛога, "Предупреждение", RunId);
	Исключение
		ЗаписьЖурналаРегистрации(
			"AgentRunner.ПроверитьПорогМедленногоTool",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			НСтр("ru='Ошибка проверки порога медленного tool (RunId='; en='Slow tool threshold check error (RunId='")
				+ RunId + "): "
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Зафиксировать служебное событие ошибки диспетчеризации.
//
Процедура ЗафиксироватьОшибкуДиспетчера(Знач RunId, Знач Код, Знач ИмяTool)
	Если ПустаяСтрока(RunId) Тогда
		Возврат;
	КонецЕсли;
	ПолезнаяНагрузка = Новый Структура;
	ПолезнаяНагрузка.Вставить("code", Код);
	ПолезнаяНагрузка.Вставить("tool", ИмяTool);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "Failed", ПолезнаяНагрузка);
КонецПроцедуры

// Сформировать структуру результата диспетчера.
//
Функция Результат(Знач СтрокаРезультата, Знач RiskLevel)
	Стр = Новый Структура;
	Стр.Вставить("Успех", Истина);
	Стр.Вставить("Результат", СтрокаРезультата);
	Стр.Вставить("ResultRef", "");
	Стр.Вставить("RiskLevel", RiskLevel);
	Возврат Стр;
КонецФункции

// JSON-строка ошибки-observation: {"error":"<очищенный текст>"}.
//
Функция ОшибочныйJSON(Знач ТекстОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""dispatch_error""}", Результат);
КонецФункции

// Привести ответ tool к строке-observation (tool-функции возвращают строку JSON).
//
Функция СтрокаНаблюдения(Знач ОтветTool)
	Если ТипЗнч(ОтветTool) = Тип("Строка") Тогда
		Возврат ОтветTool;
	КонецЕсли;
	Если ОтветTool = Неопределено Тогда
		Возврат "{}";
	КонецЕсли;
	// Tool вернул не строку - сериализуем для устойчивости контракта.
	Сериализованный = ar_JSON.ВЗначениеJSON(ОтветTool);
	Возврат ?(ПустаяСтрока(Сериализованный), "{}", Сериализованный);
КонецФункции

// Извлечь ResultRef из JSON-observation tool (поле "ref"/"result_ref"), если есть.
//
Функция ИзвлечьResultRef(Знач ОтветTool)
	Если ТипЗнч(ОтветTool) <> Тип("Строка") Или ПустаяСтрока(ОтветTool) Тогда
		Возврат "";
	КонецЕсли;
	Объект = ar_JSON.ИзJSON(ОтветTool);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Объект.Получить("result_ref");
	Если Значение = Неопределено Тогда
		Значение = Объект.Получить("ref");
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");
КонецФункции

// Безопасно получить значение из КонтекстЗапуска (Структура) с дефолтом.
//
Функция ЗначениеКонтекста(Знач КонтекстЗапуска, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(КонтекстЗапуска) <> Тип("Структура") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Дефолт;
	КонтекстЗапуска.Свойство(Ключ, Значение);
	Возврат Значение;
КонецФункции

// Найти кэшированный результат предыдущего исполнения commit-tool (DISP-04).
//
// Тонкая обёртка над ar_Approval.НайтиПредыдущийРезультат (APPR-01): чтение
// привилегированной очереди approval инкапсулировано в модуле ar_Approval.
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности.
//
// Возвращаемое значение:
//  Неопределено - нет executed-записи (выполнять штатно);
//  Строка       - кэшированный JSON-результат предыдущего вызова.
//
Функция НайтиПредыдущийРезультат(Знач IdempotencyKey)
	Возврат ar_Approval.НайтиПредыдущийРезультат(IdempotencyKey);
КонецФункции

#КонецОбласти

#Область ИнициализацияПриЗапуске

// Вызывается из модуля управляемого приложения расширения при старте системы.
// Регистрирует ядровые tools (однократно) и возвращает флаг необходимости мастера.
//
// Возвращаемое значение:
//   Структура - АдминИМастерНужен - Булево.
//
Функция ИнициализироватьПриЗапускеСистемы() Экспорт

	// UNIV-06: адаптеры заполнения регистрируются ДО tools - критерий
	// "ar_ТребуетАдаптер" (см. РезультатПроверкиДоступности) проверяется внутри
	// ЗарегистрироватьВсеTools/ПересчитатьДоступностьВсехTools ниже; если
	// адаптер зарегистрировать после, create_invoice_draft на первом же старте
	// системы окажется недоступен до следующего пересчёта.
	Попытка
		ar_АдаптерЗаполнения.ЗарегистрироватьВсеАдаптеры();
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru='AgentRunner: регистрация адаптеров заполнения'; en='AgentRunner: fill adapters registration'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Попытка
		АвтоЗаполнитьРеестрToolsПриЗапуске();
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru='AgentRunner: регистрация tools'; en='AgentRunner: tools registration'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Попытка
		ar_ОбновлениеРасширения.ВыполнитьОбновлениеПриНеобходимости();
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru='AgentRunner: обновление расширения'; en='AgentRunner: extension update'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Результат = Новый Структура("АдминИМастерНужен", Ложь);

	// Мастер выполняет привилегированные операции (создание пользователя ИБ
	// ar_AgentRunner и т.п.) - поэтому условие показа завязано на полные права,
	// а не на прикладную роль ar_РольАдмин: перебор
	// ПользователиИнформационнойБазы.ТекущийПользователь().Роли отражал бы
	// только роли, назначенные напрямую объекту пользователя ИБ, и не
	// учитывал бы фактически действующие в сеансе права.
	// [Реф: БСП/Пользователи.ЭтоПолноправныйПользователь]
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();

	Если ЭтоПолноправныйПользователь И НЕ Константы.ar_МастерНастройкиВыполнен.Получить() Тогда
		Результат.АдминИМастерНужен = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет константу ar_МастерНастройкиВыполнен.
//
// Возвращаемое значение:
//   Булево - Истина, если мастер уже выполнен.
//
Функция МастерНастройкиВыполнен() Экспорт
	Возврат Константы.ar_МастерНастройкиВыполнен.Получить();
КонецФункции

#КонецОбласти
