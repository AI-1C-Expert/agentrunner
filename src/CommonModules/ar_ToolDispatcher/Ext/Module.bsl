// SCALE-01: ядровой перечень категорий - единственный источник истины для
// ЗарегистрироватьКатегории (upsert в ar_КатегорииTools) и для миграции
// ar_ОбновлениеРасширения.МигрироватьКатегорииTools (текст -> код на уже
// существующих базах). Порядок строк = порядок появления в ПредставленияTools,
// ar_Порядок = 10, 20, 30... с шагом 10, чтобы пакеты могли вставляться между.
//
// Возвращаемое значение:
//  Массив - Структура(Код, Наименование, ОписаниеДляLLM, Порядок, СтароеПредставление):
//   * Код               - Строка - см. КатегорияПлатформа и др. выше.
//   * Наименование      - Строка - НСтр, человекочитаемое название (UI).
//   * ОписаниеДляLLM     - Строка - краткое описание группы ключевыми словами
//                          (SCALE-05, черновая формулировка - финальная ревизия
//                          в SCALE-02/SCALE-05).
//   * Порядок           - Число  - сортировка в карте категорий/попапе.
//   * СтароеПредставление - Строка - текст, который функция-геттер возвращала
//                          ДО SCALE-01 (НСтр) - используется миграцией для
//                          сопоставления уже сохранённых в ar_Tools.ar_Категория
//                          значений с новым кодом.
//
Функция СписокЯдровыхКатегорий() Экспорт

	Список = Новый Массив;

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияПлатформа(),
		НСтр("ru='Платформа и метаданные'; en='Platform & metadata'"),
		НСтр("ru='метаданные, справочники, документы, структура, константы, контекст'; en='metadata, catalogs, documents, structure, constants, context'"),
		10, НСтр("ru='Платформа и метаданные'; en='Platform & metadata'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияДанные(),
		НСтр("ru='Данные'; en='Data'"),
		НСтр("ru='запросы, поиск, история изменений, ссылки, итоги'; en='queries, search, change history, references, totals'"),
		20, НСтр("ru='Данные'; en='Data'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияCRM(),
		НСтр("ru='CRM'; en='CRM'"),
		НСтр("ru='контрагенты, контакты, клиенты'; en='counterparties, contacts, clients'"),
		30, НСтр("ru='CRM'; en='CRM'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияДокументы(),
		НСтр("ru='Документы'; en='Documents'"),
		НСтр("ru='счета, акты сверки, проверка документов'; en='invoices, reconciliation acts, document validation'"),
		40, НСтр("ru='Документы'; en='Documents'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияФинансы(),
		НСтр("ru='Финансы'; en='Finance'"),
		НСтр("ru='остатки, дебиторка, платежи, неоплаченные счета, поиск организаций'; en='balances, receivables, payments, unpaid invoices, organization search'"),
		50, НСтр("ru='Финансы'; en='Finance'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияОтчёты(),
		НСтр("ru='Отчёты и печать'; en='Reports & printing'"),
		НСтр("ru='отчёты, печатные формы'; en='reports, print forms'"),
		60, НСтр("ru='Отчёты и печать'; en='Reports & printing'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияКоммуникации(),
		НСтр("ru='Коммуникации'; en='Communications'"),
		НСтр("ru='письма, напоминания об оплате, история напоминаний'; en='emails, payment reminders, reminder history'"),
		70, НСтр("ru='Коммуникации'; en='Communications'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияПамять(),
		НСтр("ru='Память'; en='Memory'"),
		НСтр("ru='запомнить, вспомнить, настройки расширения'; en='remember, recall, extension settings'"),
		80, НСтр("ru='Память'; en='Memory'")));

	Список.Добавить(НоваяКатегорияРегистрации(КатегорияВзаимодействие(),
		НСтр("ru='Взаимодействие'; en='Interaction'"),
