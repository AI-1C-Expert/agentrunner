// Общий модуль ar_ToolDispatcher (Tool Dispatcher).
//
// Центральный gate между Runtime-циклом (ar_RuntimeЦикл) и реализациями tools.
// По архитектуре (Plan §1.3, §3.4) любой tool вызывается ИСКЛЮЧИТЕЛЬНО через
// этот диспетчер - прямой вызов процедуры tool-модуля из цикла запрещён.
//
// Два режима реализации tool (реквизит ar_ТипРеализации справочника ar_Tools):
//
//   "Процедура" (или пусто) - двухуровневое явное ветвление БЕЗ
//   Выполнить()/Вычислить():
//     уровень 1 - по реквизиту ar_ОбщийМодуль ссылки на ar_Tools (имя модуля);
//     уровень 2 - внутри ветви модуля по ar_ИмяПроцедуры (имя tool-функции).
//   Это рутинный, но статически анализируемый и безопасный шаблон (Plan §3.4).
//
//   "Код" - произвольный код 1С из реквизита ar_КодРеализации, исполняемый
//   через Выполнить() СТРОГО в безопасном режиме (УстановитьБезопасныйРежим).
//   Осознанное исключение из запрета Plan §1.3 на Выполнить() в ядре - тот же
//   компромисс, что для hook-скриптов в ar_HookDispatcher: код вводится
//   администратором в карточке tool и выполняется с правами пользователя
//   сессии, без привилегированного режима, без COM/файлов/внешних средств
//   (гарантии безопасного режима платформы). Коду доступны переменные
//   Аргументы (Строка JSON), Контекст (Структура запуска) и Результат
//   (Строка; код присваивает JSON-observation для модели).
//
//   SEC-TOOL-01: чего безопасный режим платформы НЕ гарантирует (это не
//   баг, а явная граница компромисса - не путать с полноценной песочницей):
//     * НЕ блокирует чтение любых данных, доступных пользователю текущей
//       сессии (запросы, чтение объектов, регистров - RLS сужает, но не
//       убирает риск для пользователя с широкими правами);
//     * НЕ блокирует запись в ИБ в обход очереди подтверждений
//       ar_ОчередьApproval - код с ar_ТипРеализации="Код" пишет напрямую,
//       без прохождения approval-контракта, обязательного для tools риска
//       Write/Commit в режиме "Процедура";
//     * НЕ блокирует HTTPСоединение/HTTPЗапрос - код может эксфильтровать
//       прочитанные данные на внешний адрес;
//     * НЕ проверяется deny-list ar_ЗапрещённыеОбъекты внутри самого кода -
//       этот список проверяется на уровне вызова tool в ar_PermissionEngine
//       (L0), а не на уровне обращений к данным ВНУТРИ Выполнить().
//   Технический барьер - константа ar_РазрешитьТулыВРежимеКод (по умолчанию
//   Ложь, см. ПрочитатьДанныеTool ниже): без явного включения администратором
//   code-тулы не диспетчеризуются вовсе. Подробности - .docs/Модель-угроз-режим-Код.md.
//
// Контракт результата (возврат функции Вызвать):
//   Структура { Успех - Булево, Результат - Строка(JSON observation),
//               ResultRef - Строка, RiskLevel - Строка }.
// Диспетчер НЕ выбрасывает исключений наружу: любая ошибка tool превращается
// в observation вида {"error":"..."} и уходит модели для самокоррекции.
//
// Обязанности диспетчера (DISP-01 .. DISP-04):
//   * lookup tool по имени (НайтиToolПоИмени) - структура Действие из парсера
//     содержит только имя, без ссылки на ar_Tools;
//   * повторная защита: tool найден и Включён (PERM-01 уже проверял на L0);
//   * проверка размера АргументыJSON <= 64 KB (ar_JSON.ПроверитьРазмерАргументов);
//   * передача флага DryRun в аргументы tool (_dry_run);
//   * генерация IdempotencyKey для commit-tools (ТребуетApproval = Истина) -
//     передаётся в аргументы как _idempotency_key;
//   * идемпотентность commit-tools (DISP-04): до выполнения проверяет кэш
//     по _idempotency_key (НайтиПредыдущийРезультат) и возвращает прежний
//     результат без повтора, если действие уже исполнено (executed);
//   * двухуровневое ветвление вызова tool-функции;
//   * перехват исключений с очисткой текста через ar_Утилиты.ОчиститьОшибкуДляLLM;
//   * запись действия в ar_ДействияАгента через фасад
//     ar_AuditЗащищённыйРежим.ЗаписатьДействиеПривилегированно (AUD-06);
//   * регистрация служебных событий через фасад
//     ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно (AUD-06).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Tools выполняются в правах пользователя сессии, чтобы RLS целевой
// конфигурации работал естественно (Plan §2.8, §3.1). Привилегированные операции
// с очередью approval (ПометитьApprovalВыполненным, НайтиПредыдущийРезультат)
// инкапсулированы в модуле ar_Approval (APPR-01); диспетчер делегирует их туда
// тонкими обёртками, локальный подъём привилегий из диспетчера убран.
//
// См. спеку: .docs/specs/DISP-01.md, .docs/specs/DISP-04.md, Plan §1.3, §2.8, §3.4.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполнить tool. Единственная точка вызова tool-реализаций из ядра.
//
// Параметры:
//  СсылкаTool     - СправочникСсылка.ar_Tools - tool для вызова. Если передана
//                   строка (имя tool) - выполняется lookup по имени. Неопределено /
//                   незаполненная ссылка → observation tool_ref_missing.
//  АргументыJSON  - Строка - JSON-объект аргументов от LLM. Пустая строка → "{}".
//  КонтекстЗапуска - Структура - {RunId, Агент, РежимАвтономии, DryRun, [Sequence]}.
//
// Возвращаемое значение:
//  Структура { Успех, Результат, ResultRef, RiskLevel } - см. шапку модуля.
//
Функция Вызвать(Знач СсылкаTool, Знач АргументыJSON, Знач КонтекстЗапуска) Экспорт

	RunId = ЗначениеКонтекста(КонтекстЗапуска, "RunId", "");

	// HOOK: BeforeToolCall (HOOK-03, точка 5).
	ДействиеHook = Новый Структура;
	ДействиеHook.Вставить("Имя", ?(ТипЗнч(СсылкаTool) = Тип("Строка"), СсылкаTool, ""));
	ДействиеHook.Вставить("Аргументы", АргументыJSON);
	ДействиеHook.Вставить("ИдВызова", "");
	КонтекстСобытияBefore = Новый Структура;
	КонтекстСобытияBefore.Вставить("RunId", RunId);
	КонтекстСобытияBefore.Вставить("Событие", Перечисления.ar_СобытиеHook.BeforeToolCall);
	КонтекстСобытияBefore.Вставить("Действие", ДействиеHook);
	КонтекстСобытияBefore.Вставить("Sequence", ЗначениеКонтекста(КонтекстЗапуска, "Sequence", 0));
	КонтекстСобытияBefore.Вставить("DryRun", ЗначениеКонтекста(КонтекстЗапуска, "DryRun", Ложь));
	АгентHook = Неопределено;
	КонтекстЗапуска.Свойство("Агент", АгентHook);
	Если АгентHook <> Неопределено Тогда
		КонтекстСобытияBefore.Вставить("Агент", АгентHook);
	КонецЕсли;
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.BeforeToolCall, КонтекстСобытияBefore);
	ЗначениеПрервать = Неопределено;
	КонтекстСобытияBefore.Свойство("Прервать", ЗначениеПрервать);
	// Защита типа: хук может не выставить ключ или положить не-Булево значение
	// (см. аналогичный паттерн в ar_RuntimeЦикл, "Cannot convert value to Boolean").
	ПрерватьTool = (ТипЗнч(ЗначениеПрервать) = Тип("Булево") И ЗначениеПрервать = Истина);
	Если ПрерватьTool Тогда
		РезультатБлок = Результат(ОшибочныйJSON("blocked_by_hook"), "Read");
		ВызватьHookAfterToolCall(КонтекстЗапуска, RunId, ДействиеHook, РезультатБлок);
		Возврат РезультатБлок;
	КонецЕсли;

	// 1. Разрешение ссылки на tool (поддержка вызова по имени).
	Если ТипЗнч(СсылкаTool) = Тип("Строка") Тогда
		СсылкаTool = НайтиToolПоИмени(СсылкаTool);
	КонецЕсли;

	Если СсылкаTool = Неопределено Или Не ЗначениеЗаполнено(СсылкаTool)
		Или ТипЗнч(СсылкаTool) <> Тип("СправочникСсылка.ar_Tools") Тогда
		ЗафиксироватьОшибкуДиспетчера(RunId, "tool_ref_missing", "");
		РезультатОшибки = Результат(ОшибочныйJSON("tool_ref_missing"), "Read");
		ВызватьHookAfterToolCall(КонтекстЗапуска, RunId, ДействиеHook, РезультатОшибки);
		Возврат РезультатОшибки;
	КонецЕсли;

	// 2. Данные tool одним запросом (имя, модуль, процедура, риск, флаги).
	ДанныеTool = ПрочитатьДанныеTool(СсылкаTool);
	Если ДанныеTool = Неопределено Тогда
		ЗафиксироватьОшибкуДиспетчера(RunId, "tool_disabled_or_not_found", "");
		РезультатОшибки = Результат(ОшибочныйJSON("tool_disabled_or_not_found"), "Read");
		Если ДанныеTool <> Неопределено Тогда
			ДействиеHook.Вставить("Имя", ДанныеTool.Имя);
		КонецЕсли;
		ВызватьHookAfterToolCall(КонтекстЗапуска, RunId, ДействиеHook, РезультатОшибки);
		Возврат РезультатОшибки;
	КонецЕсли;

	RiskLevel = ДанныеTool.RiskLevel;

	// 3. Нормализация и проверка размера аргументов (<= 64 KB).
	Аргументы = ?(ТипЗнч(АргументыJSON) = Тип("Строка") И Не ПустаяСтрока(АргументыJSON),
		АргументыJSON, "{}");

	ПроверкаРазмера = ar_JSON.ПроверитьРазмерАргументов(Аргументы);
	Если Не ПроверкаРазмера.Корректно Тогда
		ЗафиксироватьОшибкуДиспетчера(RunId, "arguments_too_large", ДанныеTool.Имя);
		РезультатОшибки = Результат(ОшибочныйJSON("arguments_too_large"), RiskLevel);
		ЗаписатьДействиеЖурнал(КонтекстЗапуска, ДанныеTool, Аргументы, РезультатОшибки);
		ДействиеHook.Вставить("Имя", ДанныеTool.Имя);
		ВызватьHookAfterToolCall(КонтекстЗапуска, RunId, ДействиеHook, РезультатОшибки);
		Возврат РезультатОшибки;
	КонецЕсли;

	DryRun = (ЗначениеКонтекста(КонтекстЗапуска, "DryRun", Ложь) = Истина);

	// 4. Обогащение аргументов системными полями (DryRun + IdempotencyKey).
	АргументыСистемные = ОбогатитьАргументы(Аргументы, ДанныеTool, КонтекстЗапуска, DryRun);

	// 4б. Идемпотентность для commit-tools (DISP-04). До фактического выполнения
	// проверяем кэш: если действие с тем же _idempotency_key уже исполнено
	// (запись очереди в статусе executed) - возвращаем прежний результат без
	// повтора (защита от двойной записи при resume/retry). DryRun пропускает шаг.
	Если Не DryRun И ДанныеTool.ТребуетApproval Тогда
		КлючИдемп = ИзвлечьIdempotencyKey(АргументыСистемные);
		Если Не ПустаяСтрока(КлючИдемп) Тогда
			КэшРезультат = ar_Approval.НайтиПредыдущийРезультат(КлючИдемп);
			Если КэшРезультат <> Неопределено Тогда
				ПолезнаяНагрузкаReplay = Новый Структура;
				ПолезнаяНагрузкаReplay.Вставить("code", "idempotent_replay");
				ПолезнаяНагрузкаReplay.Вставить("tool", ДанныеTool.Имя);
				ПолезнаяНагрузкаReplay.Вставить("idempotency_key", КлючИдемп);
				ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "ToolCalled", ПолезнаяНагрузкаReplay);
				Возврат Результат(СтрокаНаблюдения(КэшРезультат), RiskLevel);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 5. Вызов tool с перехватом исключений. Режим «Код» - выполнение
	// произвольного кода 1С из карточки tool в безопасном режиме; иначе -
	// двухуровневое ветвление по модулю/процедуре.
	Попытка
		Если ДанныеTool.РежимКод Тогда
			ОтветTool = ВыполнитьКодTool(ДанныеTool.КодРеализации, АргументыСистемные, КонтекстЗапуска);
		Иначе
			ОтветTool = ВыполнитьЯдровойМодуль(
				ДанныеTool.ОбщийМодуль, ДанныеTool.ИмяПроцедуры, АргументыСистемные, КонтекстЗапуска);
		КонецЕсли;
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗафиксироватьОшибкуДиспетчера(RunId, "tool_exception", ДанныеTool.Имя);
		РезультатИскл = Результат(ОшибочныйJSON(ТекстОшибки), RiskLevel);
		ЗаписатьДействиеЖурнал(КонтекстЗапуска, ДанныеTool, Аргументы, РезультатИскл, DryRun);
		ДействиеHook.Вставить("Имя", ДанныеTool.Имя);
		ВызватьHookAfterToolCall(КонтекстЗапуска, RunId, ДействиеHook, РезультатИскл);
		Возврат РезультатИскл;
	КонецПопытки;

	// 6. Формирование результата. Tool возвращает строку JSON-observation.
	РезультатВызова = Результат(СтрокаНаблюдения(ОтветTool), RiskLevel);
	РезультатВызова.ResultRef = ИзвлечьResultRef(ОтветTool);

	// 7. Аудит действия (кроме чистого DryRun - пишется с маркером).
	ЗаписатьДействиеЖурнал(КонтекстЗапуска, ДанныеTool, Аргументы, РезультатВызова, DryRun);

	// 8. Служебное событие успешной диспетчеризации.
	ПолезнаяНагрузка = Новый Структура;
	ПолезнаяНагрузка.Вставить("code", "tool_dispatched");
	ПолезнаяНагрузка.Вставить("tool", ДанныеTool.Имя);
	ПолезнаяНагрузка.Вставить("module", ДанныеTool.ОбщийМодуль);
	ПолезнаяНагрузка.Вставить("implementation", ?(ДанныеTool.РежимКод, "code", "procedure"));
	ПолезнаяНагрузка.Вставить("risk_level", RiskLevel);
	ПолезнаяНагрузка.Вставить("dry_run", DryRun);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "ToolCalled", ПолезнаяНагрузка);

	ДействиеHook.Вставить("Имя", ДанныеTool.Имя);
	ВызватьHookAfterToolCall(КонтекстЗапуска, RunId, ДействиеHook, РезультатВызова);
	Возврат РезультатВызова;

КонецФункции

// Найти tool по имени (реквизит ar_Имя) среди включённых tools.
//
// Параметры:
//  ИмяTool - Строка - имя tool из tool call (например "search_clients").
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Tools - ссылка либо Неопределено, если не найден / выключен.
//
Функция НайтиToolПоИмени(Знач ИмяTool) Экспорт

	Если ТипЗнч(ИмяTool) <> Тип("Строка") Или ПустаяСтрока(ИмяTool) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И Tools.ar_Включён
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", СокрЛП(ИмяTool));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Извлечь флаг DryRun из обогащённых аргументов tool (DISP-03).
//
// Диспетчер (ОбогатитьАргументы) проставляет _dry_run как булево значение в
// JSON-аргументы каждого tool. Эта функция - единая точка consistent-разбора
// флага для tool-имплементаций: защищает от нюансов JSON-типизации
// (true vs "true" vs 1) - Истина возвращается ТОЛЬКО для булева true.
//
// Контракт: каждая mutating-функция (RiskLevel = Draft/Write/Commit) обязана
// вызвать эту функцию и при Истина вернуть симулированный ответ
// (СформироватьDryRunJSON) без записи в данные ИБ. Read-only функции флаг
// игнорируют.
//
// Параметры:
//  АргументыJSON - Строка - те же JSON-аргументы, что получает tool-функция.
//
// Возвращаемое значение:
//  Булево - Истина, только если поле _dry_run равно булеву true. При отсутствии
//           поля, невалидном JSON или небулевом значении → Ложь (защитный
//           дефолт: безопаснее выполнить реально, чем пропустить операцию).
//
Функция ИзвлечьDryRun(Знач АргументыJSON) Экспорт

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Ложь;
	КонецЕсли;

	Объект = ar_JSON.ИзJSON(АргументыJSON);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Значение = Объект.Получить("_dry_run");
	Возврат ТипЗнч(Значение) = Тип("Булево") И Значение = Истина;

КонецФункции

// Сформировать стандартный JSON симулированного (dry-run) ответа tool (DISP-03).
//
// Единый формат позволяет UI (Run Viewer, Approval Queue) отличать dry-run
// observations от боевых без парсинга произвольного текста.
//
// Параметры:
//  ИмяTool             - Строка - имя tool (например "create_invoice_draft").
//  СимулированныеДанные - Произвольный - данные симуляции (Структура/Соответствие/
//                        Массив/примитив) либо Неопределено. По умолчанию
//                        Неопределено → simulated: null.
//
// Возвращаемое значение:
//  Строка - JSON вида {"dry_run": true, "tool": "<имя>", "simulated": <данные>}.
//
Функция СформироватьDryRunJSON(Знач ИмяTool, Знач СимулированныеДанные = Неопределено) Экспорт

	Объект = Новый Структура;
	Объект.Вставить("dry_run", Истина);
	Объект.Вставить("tool", ?(ТипЗнч(ИмяTool) = Тип("Строка"), ИмяTool, ""));
	Объект.Вставить("simulated", СимулированныеДанные);

	JSONРезультат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(JSONРезультат), "{""dry_run"":true,""tool"":"""",""simulated"":null}", JSONРезультат);

КонецФункции

// Извлечь _idempotency_key из JSON-аргументов tool (DISP-04).
//
// Диспетчер (ОбогатитьАргументы) проставляет _idempotency_key как строку в
// JSON-аргументы каждого commit-tool (ТребуетApproval = Истина). Эта функция -
// единая точка consistent-разбора ключа для tool-имплементаций и для самого
// диспетчера (защита первой линии в Вызвать). Аналог ИзвлечьDryRun (DISP-03).
//
// Параметры:
//  АргументыJSON - Строка - те же JSON-аргументы, что получает tool-функция.
//
// Возвращаемое значение:
//  Строка - значение поля _idempotency_key, только если оно является строкой.
//           При отсутствии поля, невалидном JSON или нестроковом значении →
//           пустая строка (защитный дефолт: idempotency-проверка пропускается,
//           tool выполняется штатно).
//
Функция ИзвлечьIdempotencyKey(Знач АргументыJSON) Экспорт

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат "";
	КонецЕсли;

	Объект = ar_JSON.ИзJSON(АргументыJSON);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Объект.Получить("_idempotency_key");
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

// Зарегистрировать все ядровые tools в справочнике ar_Tools (TOOL-17).
//
// Вызывается при первом развёртывании расширения (из ПриНачалеРаботыСистемы)
// или вручную через кнопку «Заполнить реестр tools» в форме ar_Настройки.
// Идемпотентен - повторные вызовы безопасны (обновляет существующие записи).
// Каждый ядровой tool-модуль отвечает за собственную регистрацию.
// Ошибка одного модуля не останавливает регистрацию остальных.
//
// После регистрации всех модулей (UNIV-03) выполняется отдельный проход по
// всему справочнику ar_Tools, пересчитывающий ar_Доступен/ar_ПричинаНедоступности
// через ПересчитатьДоступностьВсехTools - общая точка со сценарием обновления
// версии расширения.
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число, Недоступно - Число } -
//  суммарная статистика.
//
Функция ЗарегистрироватьВсеTools() Экспорт

	Итог = Новый Структура("Создано, Обновлено, Недоступно", 0, 0, 0);

	// Универсальные tools (search_*, get_object, TOOL-02).
	ЗарегистрироватьМодуль("ar_ToolUniversal", Итог);

	// CRM: search_clients, update_client_contact (TOOL-04).
	ЗарегистрироватьМодуль("ar_ToolCRM", Итог);

	// Документы: create_invoice_draft, get_invoice, validate_document (TOOL-05).
	ЗарегистрироватьМодуль("ar_ToolДокументы", Итог);

	// Отчёты: run_report, get_print_form (TOOL-13).
	ЗарегистрироватьМодуль("ar_ToolОтчёты", Итог);

	// Взаимодействие с пользователем: ask_user (TOOL-19).
	ЗарегистрироватьМодуль("ar_ToolInteraction", Итог);

	// Память: store_memory, recall_memory (MEM-01/02).
	ЗарегистрироватьМодуль("ar_ToolПамять", Итог);

	// Финансы: заглушка, полная реализация в TOOL-06.
	ЗарегистрироватьМодуль("ar_ToolФинансы", Итог);

	// Коммуникации: заглушка, полная реализация в TOOL-07.
	ЗарегистрироватьМодуль("ar_ToolКоммуникации", Итог);

	// Аварийный примитив: save_object (TOOL-18).
	ЗарегистрироватьМодуль("ar_ToolАварийный", Итог);

	// При добавлении нового ядрового tool-модуля - добавить вызов ЗарегистрироватьМодуль здесь.

	// UI-31: человекочитаемые названия и категории для попапа композера.
	// Отдельным проходом по той же причине, что и пересчёт доступности ниже -
	// процедура регистрации продублирована по модулям, а таблица названий одна.
	ЗаполнитьПредставленияВсехTools();

	// UNIV-03: пересчёт доступности после того, как все модули зарегистрировали
	// свои описания (ar_ТребуемыеОбъекты уже записаны в справочник на этом шаге).
	Итог.Недоступно = ПересчитатьДоступностьВсехTools();

	Возврат Итог;

КонецФункции

// Заполнить реестр tools при первом старте системы (D7, TOOL-17).
//
// Вызывается из модуля управляемого приложения расширения в ПриНачалеРаботыСистемы.
// Если в справочнике ar_Tools уже есть хотя бы одна запись - вызов пропускается
// (предотвращение повторной регистрации при каждом запуске системы).
// При регистрации статистика пишется в системный журнал.
//
Процедура АвтоЗаполнитьРеестрToolsПриЗапуске() Экспорт

	Попытка
		Если КоличествоЗаписейTools() > 0 Тогда
			Возврат; // Реестр уже заполнен - пропускаем.
		КонецЕсли;

		Итог = ЗарегистрироватьВсеTools();

		ЗаписьЖурналаРегистрации(
			"AgentRunner.ЗарегистрироватьВсеTools",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			НСтр("ru='Реестр tools заполнен автоматически при запуске системы. Создано: '; en='Tool registry populated on system start. Created: '")
				+ Итог.Создано
				+ НСтр("ru=', Обновлено: '; en=', Updated: '")
				+ Итог.Обновлено);
	Исключение
		ЗаписьЖурналаРегистрации(
			"AgentRunner.ЗарегистрироватьВсеTools",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			НСтр("ru='Ошибка автозаполнения реестра tools при запуске: '; en='Error auto-populating tool registry on start: '")
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Пометить запись очереди approval как выполненную (executed) после успешного
// выполнения commit-tool (DISP-04). Вызывается tool-имплементацией по окончании
// действия, чтобы НайтиПредыдущийРезультат вернул кэш при повторном вызове, а
// SCHED-03 не возобновлял уже исполненное действие.
//
// Тонкая обёртка над ar_Approval.ПометитьApprovalВыполненным (APPR-01): вся
// привилегированная запись в очередь инкапсулирована в модуле ar_Approval.
// Обёртка сохранена для обратной совместимости вызовов из tool-модулей.
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности (RunId + "_" + Sequence).
//  РезультатJSON  - Строка - JSON-результат выполнения tool для кэширования.
//
// Возвращаемое значение:
//  Булево - Истина при успешном переводе в executed; Ложь иначе. Не выбрасывает.
//
Функция ПометитьApprovalВыполненным(Знач IdempotencyKey, Знач РезультатJSON = "") Экспорт
	Возврат ar_Approval.ПометитьApprovalВыполненным(IdempotencyKey, РезультатJSON);
КонецФункции

// Получить реальное имя объекта метаданных с учётом переопределения (регистр
// ar_ПереопределенияОбъектов). Tool-модули (ar_ToolCRM, ar_ToolДокументы и т.п.)
// содержат зашитые в код имена объектов типовых конфигураций (например,
// "Контрагенты") - для целевой конфигурации с другими именами (например,
// демо-конфигурация со справочником "_ДемоКонтрагенты") без этой функции
// пришлось бы править BSL. Приоритет: если для ЛогическоеИмя есть запись в
// регистре - используется она, иначе - ИмяПоУмолчанию из кода.
//
// Параметры:
//  ЛогическоеИмя  - Строка - стабильный псевдоним объекта, используемый в коде
//                   tool-модулей (например "Контрагенты", "Номенклатура").
//  ИмяПоУмолчанию - Строка - имя объекта метаданных, зашитое в коде вызывающего
//                   tool-модуля - применяется, если переопределение не задано.
//
// Возвращаемое значение:
//  Строка - имя объекта метаданных для использования в Метаданные.Справочники.
//           Найти(...) / Метаданные.Документы.Найти(...).
//
Функция ИмяОбъектаМетаданных(Знач ЛогическоеИмя, Знач ИмяПоУмолчанию) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛогическоеИмя", ЛогическоеИмя);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Переопределения.ar_ИмяВМетаданных КАК ИмяВМетаданных
		|ИЗ
		|	РегистрСведений.ar_ПереопределенияОбъектов КАК Переопределения
		|ГДЕ
		|	Переопределения.ar_ЛогическоеИмя = &ЛогическоеИмя";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Не ПустаяСтрока(Выборка.ИмяВМетаданных) Тогда
		Возврат СокрЛП(Выборка.ИмяВМетаданных);
	КонецЕсли;

	Возврат ИмяПоУмолчанию;

КонецФункции

// Возвращает список логических имён объектов метаданных, известных на данный
// момент коду tool-модулей (ar_ToolCRM, ar_ToolДокументы и т.п.) - те же
// значения, что передаются первым параметром в ИмяОбъектаМетаданных(...) по
// всей кодовой базе. Используется формой записи регистра
// ar_ПереопределенияОбъектов для заполнения списка выбора поля
// ar_ЛогическоеИмя - без этого списка пользователь должен был бы знать
// точное написание псевдонима, зашитого в BSL.
//
// Источник - объединение без дублей: все значения ar_ЛогическоеИмя, реально
// присутствующие в РегистрСведений.ar_ПереопределенияОбъектов (в т.ч.
// добавленные импортом профиля UNIV-04), и 4 базовых значения, зашитых в
// tool-модулях по умолчанию - как fallback для пустой базы.
//
// Возвращаемое значение:
//  Массив из Строка - логические имена, отсортированные по алфавиту (по кодам
//  символов, без учёта локали - для смешанного регистра порядок может
//  отличаться от словарного).
//
Функция СписокИзвестныхЛогическихИмен() Экспорт

	УжеДобавлены = Новый Соответствие;
	СписокУникальных = Новый СписокЗначений;

	Для Каждого ИмяFallback Из ФоллбэкЛогическиеИмена() Цикл
		УжеДобавлены.Вставить(ИмяFallback, Истина);
		СписокУникальных.Добавить(ИмяFallback);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Переопределения.ar_ЛогическоеИмя КАК ЛогическоеИмя
		|ИЗ
		|	РегистрСведений.ar_ПереопределенияОбъектов КАК Переопределения";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если УжеДобавлены.Получить(Выборка.ЛогическоеИмя) = Неопределено Тогда
			УжеДобавлены.Вставить(Выборка.ЛогическоеИмя, Истина);
			СписокУникальных.Добавить(Выборка.ЛогическоеИмя);
		КонецЕсли;
	КонецЦикла;

	СписокУникальных.СортироватьПоЗначению();

	Возврат СписокУникальных.ВыгрузитьЗначения();

КонецФункции

// Проверяет, может ли tool физически отработать на текущей конфигурации
// (UNIV-03): все логические имена объектов метаданных из ar_ТребуемыеОбъекты
// ссылки tool должны существовать среди Документов/Справочников целевой
// конфигурации. Вычисляемый результат кэшируется в ar_Доступен -
// см. ЗарегистрироватьВсеTools/ПересчитатьДоступностьВсехTools.
//
// Функция не выбрасывает исключений наружу (общий контракт диспетчера) -
// любая внутренняя ошибка трактуется как "недоступен" (fail-safe: лучше
// скрыть tool из каталога LLM, чем показать заведомо неработающий).
//
// Параметры:
//  СсылкаTool - СправочникСсылка.ar_Tools - проверяемый tool.
//
// Возвращаемое значение:
//  Булево - Истина, если все требуемые объекты метаданных найдены (или
//           ar_ТребуемыеОбъекты пуст - универсальный tool); Ложь иначе.
//
Функция ПроверитьДоступностьTool(Знач СсылкаTool) Экспорт

	Если СсылкаTool = Неопределено Или Не ЗначениеЗаполнено(СсылкаTool) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТребуемыеОбъектыJSON = Неопределено;
	ПоддерживаемыеКонфигурации = Неопределено;
	ТребуетАдаптер = Ложь;
	Попытка
		ТребуемыеОбъектыJSON = СсылкаTool.ar_ТребуемыеОбъекты;
		ПоддерживаемыеКонфигурации = СсылкаTool.ar_ПоддерживаемыеКонфигурации;
		ТребуетАдаптер = СсылкаTool.ar_ТребуетАдаптер;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат РезультатПроверкиДоступности(ТребуемыеОбъектыJSON, ПоддерживаемыеКонфигурации, ТребуетАдаптер).Доступен;

КонецФункции

// Вычисляет доступность tool и причину недоступности одним проходом по уже
// прочитанным значениям ar_ТребуемыеОбъекты/ar_ПоддерживаемыеКонфигурации -
// используется и ПроверитьДоступностьTool (читает реквизиты сама через точку
// для однократного tool), и проходом пересчёта (ПересчитатьДоступностьВсехTools,
// читает значения одним запросом для всех записей - без повторного обращения
// через точку в цикле).
//
// UNIV-01: критерий "поддерживаемая конфигурация" - И-условие, применяется
// В ОБЕИХ ветках (универсальный tool с пустым ar_ТребуемыеОбъекты и tool с
// непустым списком объектов) - иначе tool с заполненными обоими реквизитами
// был бы проверен только по объектам метаданных, оставляя лазейку.
//
// UNIV-06: третий, независимый критерий - ТребуетАдаптер. Применяется ПОСЛЕ
// первых двух (см. .docs/specs/UNIV-06.md, раздел «Как ar_Доступен для
// create_invoice_draft узнаёт про наличие адаптера»): если Истина, tool
// дополнительно требует зарегистрированный и включённый адаптер заполнения
// для текущего типа конфигурации (ar_АдаптерЗаполнения.
// ЕстьАдаптерДляТекущейКонфигурации). Ядро (этот модуль) не содержит ни одного
// ветвления по типу конфигурации - вся конфигурация-специфика инкапсулирована
// внутри ar_АдаптерЗаполнения/конкретных адаптеров (DoD D6).
//
// Параметры:
//  ТребуемыеОбъектыJSON        - Строка - значение ar_ТребуемыеОбъекты (JSON-массив
//                                логических имён либо пусто/"[]").
//  ПоддерживаемыеКонфигурации  - Строка - значение ar_ПоддерживаемыеКонфигурации
//                                (типы конфигурации через запятую, например
//                                "БП,УТ"; пусто - любая конфигурация).
//  ТребуетАдаптер              - Булево - значение ar_ТребуетАдаптер (UNIV-06).
//                                По умолчанию Ложь (обратная совместимость для
//                                вызовов без этого параметра).
//
// Возвращаемое значение:
//  Структура { Доступен - Булево, Причина - Строка } - Причина пуста, если
//  Доступен = Истина.
//
Функция РезультатПроверкиДоступности(Знач ТребуемыеОбъектыJSON, Знач ПоддерживаемыеКонфигурации = "", Знач ТребуетАдаптер = Ложь)

	Попытка

		ТребуемыеОбъектыJSON = СокрЛП(?(ТипЗнч(ТребуемыеОбъектыJSON) = Тип("Строка"), ТребуемыеОбъектыJSON, ""));

		// UNIV-01: проверка ar_ПоддерживаемыеКонфигурации применяется до
		// разбора ТребуемыеОбъектыJSON - если конфигурация не поддерживается,
		// нет смысла проверять наличие объектов метаданных.
		ПричинаНеподдерживаемойКонфигурации = ПричинаЕслиКонфигурацияНеПоддерживается(ПоддерживаемыеКонфигурации);
		Если Не ПустаяСтрока(ПричинаНеподдерживаемойКонфигурации) Тогда
			Возврат НовыйРезультатДоступности(Ложь, ПричинаНеподдерживаемойКонфигурации);
		КонецЕсли;

		// Шаг 2: пусто или "[]" - универсальный tool по критерию объектов
		// метаданных (критерий конфигурации уже пройден выше). Критерий
		// адаптера (шаг 4, UNIV-06) проверяется в любом случае - применяется
		// И к универсальным, и к привязанным к объектам tools.
		ЕстьТребуемыеОбъекты = Не (ПустаяСтрока(ТребуемыеОбъектыJSON) Или ТребуемыеОбъектыJSON = "[]");

		Если ЕстьТребуемыеОбъекты Тогда

			// Шаг 3: разбор JSON-массива. Невалидный/не-массив - конфигурационная
			// ошибка данных: логируем и трактуем как недоступен (fail-safe).
			РазобранныйМассив = ar_JSON.ИзJSON(ТребуемыеОбъектыJSON);
			Если ТипЗнч(РазобранныйМассив) <> Тип("Массив") Тогда
				ar_СлужебныйЛог.Записать(
					"ar_ToolDispatcher.ПроверитьДоступностьTool",
					"invalid_required_objects_json",
					"ar_ТребуемыеОбъекты не является JSON-массивом: " + ТребуемыеОбъектыJSON,
					"Предупреждение");
				Возврат НовыйРезультатДоступности(Ложь, "invalid_required_objects_json");
			КонецЕсли;

			// Каждое логическое имя должно резолвиться в существующий
			// Документ либо Справочник целевой конфигурации (вынесено в
			// отдельную функцию - снижает когнитивную сложность текущей).
			ОтсутствующийОбъект = НайтиПервыйОтсутствующийОбъект(РазобранныйМассив);
			Если Не ПустаяСтрока(ОтсутствующийОбъект) Тогда
				Возврат НовыйРезультатДоступности(Ложь, "missing_object:" + ОтсутствующийОбъект);
			КонецЕсли;

		КонецЕсли;

		// Шаг 4 (UNIV-06): критерий адаптера - применяется после первых двух,
		// только для tools с ar_ТребуетАдаптер = Истина.
		Если ТипЗнч(ТребуетАдаптер) = Тип("Булево") И ТребуетАдаптер Тогда
			Если Не ar_АдаптерЗаполнения.ЕстьАдаптерДляТекущейКонфигурации() Тогда
				ТипКонфигурацииТекущей = ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип;
				Возврат НовыйРезультатДоступности(Ложь, "no_fill_adapter:" + ТипКонфигурацииТекущей);
			КонецЕсли;
		КонецЕсли;

		Возврат НовыйРезультатДоступности(Истина, "");

	Исключение
		Возврат НовыйРезультатДоступности(Ложь, "availability_check_error");
	КонецПопытки;

КонецФункции

// UNIV-01: проверяет, входит ли текущий Тип конфигурации (по
// ar_ПрофильКонфигурации.ОпределитьКонфигурацию()) в список
// ar_ПоддерживаемыеКонфигурации tool. Пустой список - любая конфигурация
// подходит (нет ограничения). Сравнение элементов списка с текущим Типом -
// без учёта регистра и пробелов вокруг элементов.
//
// Параметры:
//  ПоддерживаемыеКонфигурации - Строка - значение ar_ПоддерживаемыеКонфигурации
//                                (типы через запятую, например "БП,УТ", либо
//                                пусто/Неопределено).
//
// Возвращаемое значение:
//  Строка - причина недоступности вида "unsupported_configuration:<Тип>",
//           если текущий Тип не входит в список; пустая строка, если
//           конфигурация поддерживается (или ограничение не задано).
//
Функция ПричинаЕслиКонфигурацияНеПоддерживается(Знач ПоддерживаемыеКонфигурации)

	СписокСтрокой = СокрЛП(?(ТипЗнч(ПоддерживаемыеКонфигурации) = Тип("Строка"), ПоддерживаемыеКонфигурации, ""));
	Если ПустаяСтрока(СписокСтрокой) Тогда
		Возврат "";
	КонецЕсли;

	ТекущийТип = ar_ПрофильКонфигурации.ОпределитьКонфигурацию().Тип;
	ТекущийТипВВерхнемРегистре = ВРег(СокрЛП(ТекущийТип));

	МассивТипов = СтрРазделить(СписокСтрокой, ",", Ложь);
	Для Каждого ЭлементТипа Из МассивТипов Цикл
		Если ВРег(СокрЛП(ЭлементТипа)) = ТекущийТипВВерхнемРегистре Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат "unsupported_configuration:" + ТекущийТип;

КонецФункции

// Ищет первое логическое имя из массива ar_ТребуемыеОбъекты, для которого нет
// объекта метаданных с соответствующим реальным именем (после
// ИмяОбъектаМетаданных). Проверяются коллекции, на которые опираются
// реализованные tools: Документы, Справочники, ПланыСчетов, РегистрыБухгалтерии,
// РегистрыСведений, РегистрыНакопления, ПланыВидовХарактеристик, Перечисления.
//
// Раньше проверка была ограничена Документами/Справочниками (UNIV-03), из-за
// чего финансовые tools с ar_ТребуемыеОбъекты = ["Хозрасчетный"] всегда
// помечались missing_object, хотя план счетов в конфигурации есть и вызов
// фактически отрабатывал - реестр доступности расходился с диспетчером.
//
// Параметры:
//  РазобранныйМассив - Массив - элементы ar_ТребуемыеОбъекты после ar_JSON.ИзJSON.
//
// Возвращаемое значение:
//  Строка - реальное имя первого не найденного объекта метаданных, либо ""
//           если все объекты найдены.
//
Функция НайтиПервыйОтсутствующийОбъект(Знач РазобранныйМассив)

	Для Каждого ЛогическоеИмя Из РазобранныйМассив Цикл

		ЛогическоеИмяСтрока = СокрЛП(?(ТипЗнч(ЛогическоеИмя) = Тип("Строка"), ЛогическоеИмя, Строка(ЛогическоеИмя)));
		Если ПустаяСтрока(ЛогическоеИмяСтрока) Тогда
			Продолжить;
		КонецЕсли;

		РеальноеИмя = ИмяОбъектаМетаданных(ЛогическоеИмяСтрока, ЛогическоеИмяСтрока);

		Если Не ОбъектМетаданныхНайден(РеальноеИмя) Тогда
			Возврат РеальноеИмя;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Истина, если объект метаданных с указанным именем есть хотя бы в одной из
// коллекций, используемых tool-слоем (см. НайтиПервыйОтсутствующийОбъект).
//
// Параметры:
//  РеальноеИмя - Строка - имя объекта метаданных в текущей конфигурации.
//
// Возвращаемое значение:
//  Булево - Истина, если объект найден.
//
Функция ОбъектМетаданныхНайден(Знач РеальноеИмя)

	Возврат Метаданные.Документы.Найти(РеальноеИмя) <> Неопределено
		Или Метаданные.Справочники.Найти(РеальноеИмя) <> Неопределено
		Или Метаданные.ПланыСчетов.Найти(РеальноеИмя) <> Неопределено
		Или Метаданные.РегистрыБухгалтерии.Найти(РеальноеИмя) <> Неопределено
		Или Метаданные.РегистрыСведений.Найти(РеальноеИмя) <> Неопределено
		Или Метаданные.РегистрыНакопления.Найти(РеальноеИмя) <> Неопределено
		Или Метаданные.ПланыВидовХарактеристик.Найти(РеальноеИмя) <> Неопределено
		Или Метаданные.Перечисления.Найти(РеальноеИмя) <> Неопределено;

КонецФункции

// Конструктор результата проверки доступности.
//
Функция НовыйРезультатДоступности(Знач Доступен, Знач Причина)
	Возврат Новый Структура("Доступен, Причина", Доступен, Причина);
КонецФункции

// Вычисляет и записывает ar_Доступен/ar_ПричинаНедоступности для всех записей
// ar_Tools (без пометки удаления). Общая процедура для ЗарегистрироватьВсеTools
// (шаг 3) и для обработчика обновления версии расширения
// (ar_ОбновлениеРасширения, идентификатор "ПересчитатьДоступностьTools") -
// UNIV-03.
//
// Пишет только записи, у которых изменился ar_Доступен или ar_ПричинаНедоступности,
// в привилегированном режиме (парой Истина/Ложь в try/finally). По завершении -
// одна структурированная запись в ar_СлужебныйЛог со списком недоступных tools.
//
// Возвращаемое значение:
//  Число - количество записей с ar_Доступен = Ложь после пересчёта.
//
Функция ПересчитатьДоступностьВсехTools() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_ТребуемыеОбъекты КАК ТребуемыеОбъекты,
		|	Tools.ar_ПоддерживаемыеКонфигурации КАК ПоддерживаемыеКонфигурации,
		|	Tools.ar_ТребуетАдаптер КАК ТребуетАдаптер,
		|	Tools.ar_Доступен КАК Доступен,
		|	Tools.ar_ПричинаНедоступности КАК ПричинаНедоступности
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";

	НедоступныеИмена = Новый Массив;
	СчётчикНедоступно = 0;

	// ar_ТребуемыеОбъекты/ar_ПоддерживаемыеКонфигурации/ar_ТребуетАдаптер уже
	// прочитаны одним запросом для всех записей - РезультатПроверкиДоступности
	// не обращается к Выборка.Ссылка через точку (нет лишней загрузки объекта
	// на каждую итерацию, см. std487).
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		РезультатПроверки = РезультатПроверкиДоступности(Выборка.ТребуемыеОбъекты, Выборка.ПоддерживаемыеКонфигурации, Выборка.ТребуетАдаптер);

		Если Не РезультатПроверки.Доступен Тогда
			СчётчикНедоступно = СчётчикНедоступно + 1;
			НедоступныеИмена.Добавить(СокрЛП(Строка(Выборка.Имя)) + " (" + РезультатПроверки.Причина + ")");
		КонецЕсли;

		ТекущаяПричина = СокрЛП(?(ТипЗнч(Выборка.ПричинаНедоступности) = Тип("Строка"), Выборка.ПричинаНедоступности, ""));
		НужнаЗапись = (Выборка.Доступен <> РезультатПроверки.Доступен) Или (ТекущаяПричина <> РезультатПроверки.Причина);

		Если Не НужнаЗапись Тогда
			Продолжить;
		КонецЕсли;

		// Длина поля ar_ПричинаНедоступности (Строка(500), см. Catalogs/ar_Tools.xml) -
		// Лев() защищает от переполнения записи, если Причина окажется длиннее.
		ДлинаПоляПричина = 500;

		УстановитьПривилегированныйРежим(Истина);
		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Объект.ar_Доступен = РезультатПроверки.Доступен;
				Объект.ar_ПричинаНедоступности = Лев(РезультатПроверки.Причина, ДлинаПоляПричина);
				Объект.Записать();
			КонецЕсли;
			УстановитьПривилегированныйРежим(Ложь);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ar_СлужебныйЛог.Записать(
				"ar_ToolDispatcher.ПересчитатьДоступностьВсехTools",
				"availability_write_error",
				СокрЛП(Строка(Выборка.Имя)) + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
				"Предупреждение");
		КонецПопытки;

	КонецЦикла;

	ТекстСписка = ?(НедоступныеИмена.Количество() = 0, "-", СтрСоединить(НедоступныеИмена, "; "));
	ar_СлужебныйЛог.Записать(
		"ar_ToolDispatcher.ЗарегистрироватьВсеTools",
		"tools_availability_recalculated",
		"Недоступно: " + СчётчикНедоступно + ". Список: " + ТекстСписка,
		"Информация");

	Возврат СчётчикНедоступно;

КонецФункции

// Человекочитаемые названия и категории tools для UI (UI-31).
//
// Ядровые tool-модули регистрируют только техническое ar_Имя (search_clients)
// и длинное ar_Описание - в попапе композера это нечитаемо. Названия собраны
// здесь, а не в каждом модуле, потому что процедура регистрации продублирована
// по восьми модулям: один пост-проход после ЗарегистрироватьМодуль заполняет
// ar_Представление/ar_Категория сразу для всех записей реестра.
//
// Записи, которых нет в таблице (tools из сторонних расширений), не трогаются -
// для них UI показывает ar_Имя, как и раньше.
//
// Возвращаемое значение:
//  Соответствие - Ключ: Строка - техническое имя tool;
//                 Значение: Структура (Представление, Категория).
//
Функция ПредставленияTools() Экспорт

	Таблица = Новый Соответствие;

	// Универсальные (ar_ToolUniversal).
	ДобавитьПредставление(Таблица, "search_metadata",       НСтр("ru='Поиск по метаданным'; en='Search metadata'"),           КатегорияПлатформа());
	ДобавитьПредставление(Таблица, "list_catalogs",         НСтр("ru='Список справочников'; en='List catalogs'"),             КатегорияПлатформа());
	ДобавитьПредставление(Таблица, "list_documents",        НСтр("ru='Список документов'; en='List documents'"),              КатегорияПлатформа());
	ДобавитьПредставление(Таблица, "read_object",           НСтр("ru='Прочитать объект'; en='Read object'"),                  КатегорияДанные());
	ДобавитьПредставление(Таблица, "query",                 НСтр("ru='Произвольный запрос'; en='Custom query'"),              КатегорияДанные());
	ДобавитьПредставление(Таблица, "get_recent_changes",    НСтр("ru='Последние изменения'; en='Recent changes'"),            КатегорияДанные());
	ДобавитьПредставление(Таблица, "search_text",           НСтр("ru='Полнотекстовый поиск'; en='Full-text search'"),         КатегорияДанные());
	ДобавитьПредставление(Таблица, "get_object_structure",  НСтр("ru='Структура объекта'; en='Object structure'"),            КатегорияПлатформа());
	ДобавитьПредставление(Таблица, "find_references",       НСтр("ru='Найти ссылки на объект'; en='Find references'"),        КатегорияДанные());
	ДобавитьПредставление(Таблица, "get_object_history",    НСтр("ru='История версий объекта'; en='Object history'"),         КатегорияДанные());
	ДобавитьПредставление(Таблица, "aggregate",             НСтр("ru='Агрегация и итоги'; en='Aggregate'"),                   КатегорияДанные());
	ДобавитьПредставление(Таблица, "get_functional_options", НСтр("ru='Функциональные опции'; en='Functional options'"),      КатегорияПлатформа());
	ДобавитьПредставление(Таблица, "get_constants",         НСтр("ru='Константы'; en='Constants'"),                           КатегорияПлатформа());
	ДобавитьПредставление(Таблица, "get_current_context",   НСтр("ru='Текущий контекст'; en='Current context'"),              КатегорияПлатформа());

	// CRM (ar_ToolCRM).
	ДобавитьПредставление(Таблица, "search_clients",        НСтр("ru='Поиск контрагентов'; en='Search clients'"),             КатегорияCRM());
	ДобавитьПредставление(Таблица, "update_client_contact", НСтр("ru='Изменить контакты контрагента'; en='Update client contact'"), КатегорияCRM());

	// Документы (ar_ToolДокументы).
	ДобавитьПредставление(Таблица, "create_invoice_draft",  НСтр("ru='Создать счёт (черновик)'; en='Create invoice draft'"),  КатегорияДокументы());
	ДобавитьПредставление(Таблица, "get_invoice",           НСтр("ru='Прочитать счёт'; en='Get invoice'"),                    КатегорияДокументы());
	ДобавитьПредставление(Таблица, "validate_document",     НСтр("ru='Проверить документ'; en='Validate document'"),          КатегорияДокументы());
	ДобавитьПредставление(Таблица, "create_reconciliation_act", НСтр("ru='Создать акт сверки'; en='Create reconciliation act'"), КатегорияДокументы());

	// Финансы (ar_ToolФинансы).
	ДобавитьПредставление(Таблица, "get_account_balance",   НСтр("ru='Остаток по счёту'; en='Account balance'"),              КатегорияФинансы());
	ДобавитьПредставление(Таблица, "find_overdue_receivables", НСтр("ru='Просроченная дебиторка'; en='Overdue receivables'"), КатегорияФинансы());
	ДобавитьПредставление(Таблица, "list_unpaid_invoices",  НСтр("ru='Неоплаченные счета'; en='Unpaid invoices'"),            КатегорияФинансы());
	ДобавитьПредставление(Таблица, "search_organizations",  НСтр("ru='Поиск организаций'; en='Search organizations'"),        КатегорияФинансы());

	// Отчёты (ar_ToolОтчёты).
	ДобавитьПредставление(Таблица, "run_report",            НСтр("ru='Выполнить отчёт'; en='Run report'"),                    КатегорияОтчёты());
	ДобавитьПредставление(Таблица, "get_print_form",        НСтр("ru='Получить печатную форму'; en='Get print form'"),        КатегорияОтчёты());

	// Коммуникации (ar_ToolКоммуникации).
	ДобавитьПредставление(Таблица, "prepare_reconciliation_email", НСтр("ru='Письмо с актом сверки'; en='Reconciliation email'"), КатегорияКоммуникации());
	ДобавитьПредставление(Таблица, "get_invoice_reminder_history", НСтр("ru='История напоминаний по счёту'; en='Invoice reminder history'"), КатегорияКоммуникации());
	ДобавитьПредставление(Таблица, "prepare_payment_reminder_email", НСтр("ru='Письмо-напоминание об оплате'; en='Payment reminder email'"), КатегорияКоммуникации());

	// Память (ar_ToolПамять).
	ДобавитьПредставление(Таблица, "store_memory",          НСтр("ru='Запомнить информацию'; en='Store memory'"),             КатегорияПамять());
	ДобавитьПредставление(Таблица, "recall_memory",         НСтр("ru='Вспомнить информацию'; en='Recall memory'"),            КатегорияПамять());
	ДобавитьПредставление(Таблица, "get_settings",          НСтр("ru='Настройки расширения'; en='Extension settings'"),      КатегорияПамять());
	ДобавитьПредставление(Таблица, "set_setting",           НСтр("ru='Изменить настройку'; en='Change setting'"),            КатегорияПамять());

	// Взаимодействие (ar_ToolInteraction).
	ДобавитьПредставление(Таблица, "ask_user",              НСтр("ru='Уточняющий вопрос'; en='Ask user'"),                    КатегорияВзаимодействие());

	// Аварийный примитив (ar_ToolАварийный).
	ДобавитьПредставление(Таблица, "save_object",           НСтр("ru='Записать объект (аварийный)'; en='Save object (fallback)'"), КатегорияСлужебные());

	Возврат Таблица;

КонецФункции

// Заполняет ar_Представление/ar_Категория по таблице ПредставленияTools (UI-31).
//
// Пост-проход после регистрации всех модулей - по той же схеме, что и
// ПересчитатьДоступностьВсехTools: записываем только там, где значение
// реально изменилось (лишние Записать() дают мусор в истории данных).
//
// Возвращаемое значение:
//  Число - количество обновлённых записей реестра.
//
Функция ЗаполнитьПредставленияВсехTools() Экспорт

	Представления = ПредставленияTools();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка          КАК Ссылка,
		|	Tools.ar_Имя          КАК Имя,
		|	Tools.ar_Представление КАК Представление,
		|	Tools.ar_Категория    КАК Категория
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";

	Обновлено = 0;

	// Длины строковых полей справочника (Catalogs/ar_Tools.xml) - Лев() ниже
	// защищает от переполнения, если название окажется длиннее поля.
	ДлинаПоляПредставление = 150;
	ДлинаПоляКатегория     = 100;

	// Режим поднимается один раз на весь проход (запись в реестр tools -
	// служебная операция, права на ar_Tools у обычного пользователя нет).
	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл

			Эталон = Представления.Получить(СокрЛП(Строка(Выборка.Имя)));
			Если Эталон = Неопределено Тогда
				// Tool не из ядрового набора (стороннее расширение) - не трогаем.
				Продолжить;
			КонецЕсли;

			ТекущееПредставление = СокрЛП(?(ТипЗнч(Выборка.Представление) = Тип("Строка"), Выборка.Представление, ""));
			ТекущаяКатегория     = СокрЛП(?(ТипЗнч(Выборка.Категория) = Тип("Строка"), Выборка.Категория, ""));

			Если ТекущееПредставление = Эталон.Представление И ТекущаяКатегория = Эталон.Категория Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.ar_Представление = Лев(Эталон.Представление, ДлинаПоляПредставление);
					Объект.ar_Категория     = Лев(Эталон.Категория, ДлинаПоляКатегория);
					Объект.Записать();
					Обновлено = Обновлено + 1;
				КонецЕсли;
			Исключение
				// Сбой на одной записи не должен ронять обработку остальных.
				ar_СлужебныйЛог.Записать(
					"ar_ToolDispatcher.ЗаполнитьПредставленияВсехTools",
					"display_name_write_error",
					СокрЛП(Строка(Выборка.Имя)) + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
					"Предупреждение");
			КонецПопытки;

		КонецЦикла;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	ar_СлужебныйЛог.Записать(
		"ar_ToolDispatcher.ЗаполнитьПредставленияВсехTools",
		"tools_display_names_filled",
		"Обновлено записей: " + Обновлено,
		"Информация");

	Возврат Обновлено;

КонецФункции

#КонецОбласти

#Область ИсполнениеКода

// Выполнить произвольный код 1С tool (ar_ТипРеализации = "Код").
//
// Код исполняется через Выполнить() в безопасном режиме: без привилегированного
// режима, без COM/внешних компонент/файлов/запуска приложений (тот же паттерн,
// что ВыполнитьHookКод в ar_HookDispatcher). Исключения кода НЕ перехватываются
// здесь - их ловит Попытка в Вызвать (шаг 5) и превращает в observation
// {"error":"..."} для самокоррекции модели.
//
// Контракт для кода tool:
//  Аргументы - Строка    - JSON-аргументы от LLM (обогащённые _dry_run и,
//                          для commit-tools, _idempotency_key);
//  Контекст  - Структура - контекст запуска {RunId, Агент, РежимАвтономии,
//                          DryRun, [Sequence]};
//  Результат - Строка    - код присваивает JSON-строку observation, которая
//                          вернётся модели. Не строка/пусто → "{}".
//
// Параметры:
//  КодTool   - Строка - текст кода 1С из ar_КодРеализации.
//  Аргументы - Строка - JSON-аргументы tool.
//  Контекст  - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation, присвоенный кодом переменной Результат.
//
Функция ВыполнитьКодTool(Знач КодTool, Знач Аргументы, Знач Контекст)

	Если ПустаяСтрока(КодTool) Тогда
		ВызватьИсключение НСтр("ru = 'tool_code_empty'; en = 'tool_code_empty'");
	КонецЕсли;

	Результат = "";

	// Безопасный режим обязателен (Plan §1.3). Явно НЕ сбрасываем в Ложь:
	// платформа сама снимает его при выходе из функции, в том числе при
	// исключении внутри Выполнить().
	УстановитьБезопасныйРежим(Истина);
	Выполнить(КодTool);

	// Defensive: код мог не присвоить Результат или положить не-строку -
	// не-строковые значения сериализует СтрокаНаблюдения в Вызвать (шаг 6).
	Если ТипЗнч(Результат) = Тип("Строка") И ПустаяСтрока(Результат) Тогда
		Возврат "{}";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ДвухуровневоеВетвление

// Уровень 1: ветвление по имени общего модуля. БЕЗ Выполнить()/Вычислить().
// Точка добавления новой ветви помечена маркером внутри тела функции (см. ниже).
// Не ядровой модуль делегируется в ar_ToolПереопределяемый.ВызватьПользовательскийТул
// (EXT-10); неизвестный там модуль → unknown_module.
//
// Параметры:
//  ИмяМодуля    - Строка - значение ar_ОбщийМодуль (например "ar_ToolCRM").
//  ИмяПроцедуры - Строка - значение ar_ИмяПроцедуры (например "ПоискКлиентов").
//  Аргументы    - Строка - JSON-аргументы (обогащённые системными полями).
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation от tool-функции.
//
Функция ВыполнитьЯдровойМодуль(Знач ИмяМодуля, Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)

	Если ИмяМодуля = "ar_ToolCRM" Тогда
		Возврат ВыполнитьПроцедуруToolCRM(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolUniversal" Тогда
		Возврат ВыполнитьПроцедуруToolUniversal(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolДокументы" Тогда
		Возврат ВыполнитьПроцедуруToolДокументы(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolФинансы" Тогда
		Возврат ВыполнитьПроцедуруToolФинансы(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolКоммуникации" Тогда
		Возврат ВыполнитьПроцедуруToolКоммуникации(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolПамять" Тогда
		Возврат ВыполнитьПроцедуруToolПамять(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolInteraction" Тогда
		Возврат ВыполнитьПроцедуруToolInteraction(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolОтчёты" Тогда
		Возврат ВыполнитьПроцедуруToolОтчёты(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolАварийный" Тогда
		Возврат ВыполнитьПроцедуруToolАварийный(ИмяПроцедуры, Аргументы, Контекст);

	// !!! ДОБАВЛЯТЬ НОВЫЙ ЯДРОВОЙ TOOL-МОДУЛЬ ЗДЕСЬ: новая ветвь ИначеЕсли с
	// вызовом второго уровня ВыполнитьПроцедуру<Модуль>. Строка-имя модуля
	// ОБЯЗАНА совпадать с именем файла в src/CommonModules/ и со значением
	// ar_ОбщийМодуль в справочнике ar_Tools (DoD D13). Обязательно создать
	// парную локальную функцию ВыполнитьПроцедуру<Модуль> в области ниже.
	// Ветвь добавляется ЗДЕСЬ - перед блоком Иначе (пользовательские tools, EXT-10).

	Иначе
		// EXT-10: не ядровой модуль - маршрутизация в переопределяемый модуль
		// ядра ar_ToolПереопределяемый (БСП-паттерн "переопределяемый общий
		// модуль", см. заголовок модуля). Прикладной разработчик правит
		// ИМЕННО этот модуль в своей копии src/, дописывая ветвь под свой
		// tool-модуль (см. ar_ToolПереопределяемый.ВызватьПользовательскийТул).
		// Заменяет устаревшую, физически нереализуемую схему "Expert Pack"
		// (EXT-01: расширение поверх расширения - в 1С не работает).
		Возврат ar_ToolПереопределяемый.ВызватьПользовательскийТул(ИмяМодуля, ИмяПроцедуры, Аргументы, Контекст);
	КонецЕсли;

КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolCRM по имени.
//
Функция ВыполнитьПроцедуруToolCRM(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)

	Если ИмяПроцедуры = "ПоискКлиентов" Тогда
		Возврат ar_ToolCRM.ПоискКлиентов(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ОбновитьКонтактКлиента" Тогда
		Возврат ar_ToolCRM.ОбновитьКонтактКлиента(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolUniversal по имени.
// Делегирует в локальный диспетчер модуля (контракт второго уровня).
//
Функция ВыполнитьПроцедуруToolUniversal(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolUniversal.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolДокументы по имени.
//
Функция ВыполнитьПроцедуруToolДокументы(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolДокументы.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolФинансы по имени.
//
Функция ВыполнитьПроцедуруToolФинансы(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolФинансы.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolКоммуникации по имени.
//
Функция ВыполнитьПроцедуруToolКоммуникации(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolКоммуникации.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolПамять по имени (MEM-01).
// Делегирует в локальный диспетчер модуля (контракт второго уровня).
//
Функция ВыполнитьПроцедуруToolПамять(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolПамять.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolInteraction по имени (TOOL-19 D11).
// Делегирует в локальный диспетчер модуля (контракт второго уровня).
//
Функция ВыполнитьПроцедуруToolInteraction(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolInteraction.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolОтчёты по имени (TOOL-13).
// Делегирует в локальный диспетчер модуля (контракт второго уровня).
//
Функция ВыполнитьПроцедуруToolОтчёты(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolОтчёты.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolАварийный по имени (TOOL-18).
// Аварийный mutating-tool save_object. Делегирует в локальный диспетчер.
//
Функция ВыполнитьПроцедуруToolАварийный(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolАварийный.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// EXT-10: маршрутизация к пользовательским tool-модулям вынесена в отдельный
// переопределяемый общий модуль ar_ToolПереопределяемый.ВызватьПользовательскийТул
// (вызывается напрямую из ВыполнитьЯдровойМодуль, ветвь Иначе, см. выше).
// Прежний stub ВызватьРасширение (Expert Pack, EXT-01) удалён - схема
// "расширение поверх расширения" физически нереализуема в 1С.

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызвать ЗарегистрироватьTools() одного модуля с перехватом ошибок.
// Агрегирует статистику в структуру Итог {Создано, Обновлено}.
// При ошибке - пишет в ЖурналРегистрации (Предупреждение) и продолжает.
//
// Параметры:
//  ИмяМодуля - Строка    - имя общего модуля (например "ar_ToolCRM").
//  Итог      - Структура - {Создано, Обновлено} - счётчик обновляется по ссылке.
//
Процедура ЗарегистрироватьМодуль(Знач ИмяМодуля, Итог)

	Попытка
		Результат = Неопределено;

		Если ИмяМодуля = "ar_ToolUniversal" Тогда
			Результат = ar_ToolUniversal.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolCRM" Тогда
			Результат = ar_ToolCRM.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolДокументы" Тогда
			Результат = ar_ToolДокументы.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolОтчёты" Тогда
			Результат = ar_ToolОтчёты.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolInteraction" Тогда
			// ar_ToolInteraction.ЗарегистрироватьTools() - Процедура, возвращаемого значения нет (TOOL-19).
			// Вызов без присвоения; статистика не меняется.
			ar_ToolInteraction.ЗарегистрироватьTools();
			Результат = Неопределено;
		ИначеЕсли ИмяМодуля = "ar_ToolПамять" Тогда
			Результат = ar_ToolПамять.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolФинансы" Тогда
			Результат = ar_ToolФинансы.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolКоммуникации" Тогда
			Результат = ar_ToolКоммуникации.ЗарегистрироватьTools();
		ИначеЕсли ИмяМодуля = "ar_ToolАварийный" Тогда
			// ar_ToolАварийный.ЗарегистрироватьTools() пишет в ar_Tools - выполняем
			// в привилегированном режиме здесь (DoD D13 TOOL-18: УстановитьПривилегированныйРежим
			// запрещен внутри самого tool-модуля ar_ToolАварийный).
			// Канонический паттерн std485: сброс в ветви Исключение, затем после КонецПопытки.
			УстановитьПривилегированныйРежим(Истина);
			Попытка
				Результат = ar_ToolАварийный.ЗарегистрироватьTools();
			Исключение
				УстановитьПривилегированныйРежим(Ложь);
				ВызватьИсключение;
			КонецПопытки;
			УстановитьПривилегированныйРежим(Ложь);
		Иначе
			ЗаписьЖурналаРегистрации(
				"AgentRunner.ЗарегистрироватьВсеTools",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				НСтр("ru='Неизвестный модуль: '; en='Unknown module: '") + ИмяМодуля);
			Возврат;
		КонецЕсли;

		НормализоватьСтатистику(Результат, Итог);

	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"AgentRunner.ЗарегистрироватьВсеTools",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			НСтр("ru='Ошибка регистрации модуля '; en='Error registering module '")
				+ ИмяМодуля + ": " + ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Привести разнотипный результат ЗарегистрироватьTools() к {Создано, Обновлено}
// и добавить значения к накопленному итогу. Нормализация нужна из-за разных
// контрактов модулей: Число (только Создано), Структура {Создано, Обновлено}
// или Неопределено (Процедура без возврата).
//
// Параметры:
//  Результат - Произвольный - значение, возвращённое ЗарегистрироватьTools().
//  Итог      - Структура    - {Создано, Обновлено} - модифицируется по ссылке.
//
Процедура НормализоватьСтатистику(Знач Результат, Итог)

	ТипРезультата = ТипЗнч(Результат);

	Если ТипРезультата = Тип("Структура") Тогда
		Создано = 0;
		Обновлено = 0;
		Результат.Свойство("Создано", Создано);
		Результат.Свойство("Обновлено", Обновлено);
		ДельтаСоздано   = ?(ТипЗнч(Создано)   = Тип("Число"), Создано,   0);
		ДельтаОбновлено = ?(ТипЗнч(Обновлено) = Тип("Число"), Обновлено, 0);
		Итог.Создано   = Итог.Создано   + ДельтаСоздано;
		Итог.Обновлено = Итог.Обновлено + ДельтаОбновлено;
	ИначеЕсли ТипРезультата = Тип("Число") Тогда
		// ar_ToolUniversal возвращает только Создано (без Обновлено).
		Итог.Создано = Итог.Создано + Результат;
	КонецЕсли;
	// Неопределено или неожиданный тип: ar_ToolInteraction (Процедура) - итог не меняется.

КонецПроцедуры

// Подсчитать количество записей в справочнике ar_Tools (без пометки удаления).
// Используется в ПриНачалеРаботыСистемы для проверки пустоты реестра.
//
// Возвращаемое значение:
//  Число - количество активных записей.
//
Функция КоличествоЗаписейTools()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Tools.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;

КонецФункции

// 4 базовых логических имени, зашитых по умолчанию в tool-модулях (ar_ToolCRM,
// ar_ToolДокументы и т.п.) - fallback-часть СписокИзвестныхЛогическихИмен для
// пустой базы (нет ни одной записи в ar_ПереопределенияОбъектов).
//
// Возвращаемое значение:
//  Массив из Строка - 4 фиксированных логических имени.
//
Функция ФоллбэкЛогическиеИмена()

	Результат = Новый Массив;
	Результат.Добавить("Контрагенты");
	Результат.Добавить("Номенклатура");
	Результат.Добавить("Организации");
	Результат.Добавить("СчетНаОплатуПокупателю");
	Возврат Результат;

КонецФункции

// Добавляет строку в таблицу ПредставленияTools (UI-31).
//
Процедура ДобавитьПредставление(Таблица, Знач ИмяTool, Знач Представление, Знач Категория)

	СтрокаТаблицы = Новый Структура;
	СтрокаТаблицы.Вставить("Представление", Представление);
	СтрокаТаблицы.Вставить("Категория",     Категория);
	Таблица.Вставить(ИмяTool, СтрокаТаблицы);

КонецПроцедуры

// Названия категорий для группировки tools в попапе композера (UI-31).
// Вынесены в функции, чтобы строка НСтр была одна на категорию, а не
// повторялась в каждой строке таблицы представлений.
//
Функция КатегорияПлатформа()
	Возврат НСтр("ru='Платформа и метаданные'; en='Platform & metadata'");
КонецФункции

Функция КатегорияДанные()
	Возврат НСтр("ru='Данные'; en='Data'");
КонецФункции

Функция КатегорияCRM()
	Возврат НСтр("ru='CRM'; en='CRM'");
КонецФункции

Функция КатегорияДокументы()
	Возврат НСтр("ru='Документы'; en='Documents'");
КонецФункции

Функция КатегорияФинансы()
	Возврат НСтр("ru='Финансы'; en='Finance'");
КонецФункции

Функция КатегорияОтчёты()
	Возврат НСтр("ru='Отчёты и печать'; en='Reports & printing'");
КонецФункции

Функция КатегорияКоммуникации()
	Возврат НСтр("ru='Коммуникации'; en='Communications'");
КонецФункции

Функция КатегорияПамять()
	Возврат НСтр("ru='Память'; en='Memory'");
КонецФункции

Функция КатегорияВзаимодействие()
	Возврат НСтр("ru='Взаимодействие'; en='Interaction'");
КонецФункции

Функция КатегорияСлужебные()
	Возврат НСтр("ru='Служебные'; en='Utility'");
КонецФункции

// Вызвать hook AfterToolCall (HOOK-03, точка 6). Единая точка для всех
// return-путей диспетчера (успех + ошибки). Не выбрасывает исключений.
//
// Параметры:
//  КонтекстЗапуска - Структура - контекст запуска.
//  RunId           - Строка - идентификатор запуска.
//  Действие        - Структура - {Имя, Аргументы, ИдВызова}.
//  РезультатВызова - Структура - {Успех, Результат, ResultRef, RiskLevel}.
//
Процедура ВызватьHookAfterToolCall(Знач КонтекстЗапуска, Знач RunId, Знач Действие, Знач РезультатВызова)

	КонтекстСобытияAfter = Новый Структура;
	КонтекстСобытияAfter.Вставить("RunId", RunId);
	КонтекстСобытияAfter.Вставить("Событие", Перечисления.ar_СобытиеHook.AfterToolCall);
	КонтекстСобытияAfter.Вставить("Действие", Действие);
	КонтекстСобытияAfter.Вставить("РезультатTool", РезультатВызова);
	КонтекстСобытияAfter.Вставить("Sequence", ЗначениеКонтекста(КонтекстЗапуска, "Sequence", 0));
	КонтекстСобытияAfter.Вставить("DryRun", ЗначениеКонтекста(КонтекстЗапуска, "DryRun", Ложь));
	АгентHook = Неопределено;
	КонтекстЗапуска.Свойство("Агент", АгентHook);
	Если АгентHook <> Неопределено Тогда
		КонтекстСобытияAfter.Вставить("Агент", АгентHook);
	КонецЕсли;
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.AfterToolCall, КонтекстСобытияAfter);

КонецПроцедуры

// Прочитать данные tool одним запросом. Возвращает Неопределено, если tool
// помечен на удаление, выключен или его реализация не заполнена: в режиме
// «Процедура» - не заполнены модуль/процедура, в режиме «Код» - пуст код 1С
// или (SEC-TOOL-01) не разрешён константой ar_РазрешитьТулыВРежимеКод.
//
Функция ПрочитатьДанныеTool(Знач СсылкаTool)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_ОбщийМодуль КАК ОбщийМодуль,
		|	Tools.ar_ИмяПроцедуры КАК ИмяПроцедуры,
		|	Tools.ar_ТипРеализации КАК ТипРеализации,
		|	Tools.ar_КодРеализации КАК КодРеализации,
		|	Tools.ar_RiskLevel КАК RiskLevel,
		|	Tools.ar_ТребуетApproval КАК ТребуетApproval,
		|	Tools.ar_Включён КАК Активен,
		|	Tools.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаTool);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Выборка.ПометкаУдаления Или Выборка.Активен <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	РежимКод = (СокрЛП(Выборка.ТипРеализации) = "Код");
	ОбщийМодуль = СокрЛП(Выборка.ОбщийМодуль);
	ИмяПроцедуры = СокрЛП(Выборка.ИмяПроцедуры);

	// SEC-TOOL-01: политика диспетчеризации code-тулов проверяется ДО чтения
	// ar_КодРеализации в переменную функции - defense in depth. Безопасный
	// режим платформы (УстановитьБезопасныйРежим) НЕ гарантирует блокировку
	// чтения данных сессии/записи в обход ar_ОчередьApproval/HTTP-эксфильтрации
	// (см. шапку модуля и .docs/Модель-угроз-режим-Код.md), поэтому вызов
	// code-тула без явного разрешения администратора (константа
	// ar_РазрешитьТулыВРежимеКод) отклоняется тем же контрактом "tool не
	// найден/не диспетчеризуется", что и остальные ветки этой функции -
	// Вызвать() уже штатно превращает Неопределено в observation
	// {"error":"tool_disabled_or_not_found"} без падения ядра.
	Если РежимКод И Не ar_Константы.РазрешитьТулыВРежимеКод() Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодРеализации = Выборка.КодРеализации;

	Если РежимКод Тогда
		Если ПустаяСтрока(КодРеализации) Тогда
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(ОбщийМодуль) Или ПустаяСтрока(ИмяПроцедуры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Имя",             СокрЛП(Выборка.Имя));
	Данные.Вставить("ОбщийМодуль",     ОбщийМодуль);
	Данные.Вставить("ИмяПроцедуры",    ИмяПроцедуры);
	Данные.Вставить("РежимКод",        РежимКод);
	Данные.Вставить("КодРеализации",   КодРеализации);
	Данные.Вставить("RiskLevel",       ИмяRiskLevel(Выборка.RiskLevel));
	Данные.Вставить("ТребуетApproval", Выборка.ТребуетApproval = Истина);
	Возврат Данные;

КонецФункции

// Имя значения перечисления RiskLevel ("Read"/"Draft"/"Write"/"Commit").
// Пустая/неверная ссылка → "Read" (безопасный дефолт).
//
Функция ИмяRiskLevel(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("ПеречислениеСсылка.ar_RiskLevel")
		Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "Read";
	КонецЕсли;
	Для Каждого ЗначениеМД Из Метаданные.Перечисления.ar_RiskLevel.ЗначенияПеречисления Цикл
		Если Перечисления.ar_RiskLevel[ЗначениеМД.Имя] = Значение Тогда
			Возврат ЗначениеМД.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "Read";
КонецФункции

// Обогатить JSON-аргументы системными полями: _dry_run и (для commit-tools)
// _idempotency_key. Поля кладутся диспетчером, не LLM. При сбое разбора JSON
// возвращаются исходные аргументы (tool сам обработает невалидный JSON).
//
Функция ОбогатитьАргументы(Знач Аргументы, Знач ДанныеTool, Знач КонтекстЗапуска, Знач DryRun)

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		// Невалидный/не объектный JSON - не обогащаем, отдаём как есть.
		Возврат Аргументы;
	КонецЕсли;

	Объект.Вставить("_dry_run", DryRun);

	Если ДанныеTool.ТребуетApproval Тогда
		Объект.Вставить("_idempotency_key", СформироватьIdempotencyKey(КонтекстЗапуска));
	КонецЕсли;

	JSONРезультат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(JSONРезультат), Аргументы, JSONРезультат);

КонецФункции

// Детерминированный IdempotencyKey для commit-tools: RunId + "_" + Sequence.
// Если RunId пуст - генерируется UUID (запуск вне стандартного потока).
//
Функция СформироватьIdempotencyKey(Знач КонтекстЗапуска)
	RunId = ЗначениеКонтекста(КонтекстЗапуска, "RunId", "");
	Если ПустаяСтрока(RunId) Тогда
		Возврат ar_Утилиты.НовыйUUID();
	КонецЕсли;
	Sequence = ЗначениеКонтекста(КонтекстЗапуска, "Sequence", 0);
	НомерДействия = ?(ТипЗнч(Sequence) = Тип("Число"), Цел(Sequence), 0);
	Возврат RunId + "_" + Формат(НомерДействия, "ЧГ=0; ЧН=0");
КонецФункции

// Записать действие в журнал ar_ДействияАгента. При чистом DryRun действие
// записывается с маркером dry_run в имени tool (для трассировки симуляций).
//
Процедура ЗаписатьДействиеЖурнал(Знач КонтекстЗапуска, Знач ДанныеTool, Знач Аргументы,
		Знач РезультатВызова, Знач DryRun = Ложь)

	RunId = ЗначениеКонтекста(КонтекстЗапуска, "RunId", "");
	Если ПустаяСтрока(RunId) Тогда
		Возврат;
	КонецЕсли;

	Sequence = ЗначениеКонтекста(КонтекстЗапуска, "Sequence", 0);
	ИмяДляЖурнала = ?(DryRun, ДанныеTool.Имя + " (dry_run)", ДанныеTool.Имя);

	ar_AuditЗащищённыйРежим.ЗаписатьДействиеПривилегированно(
		RunId, Sequence, ИмяДляЖурнала, Аргументы,
		РезультатВызова.RiskLevel, РезультатВызова.ResultRef);

КонецПроцедуры

// Зафиксировать служебное событие ошибки диспетчеризации.
//
Процедура ЗафиксироватьОшибкуДиспетчера(Знач RunId, Знач Код, Знач ИмяTool)
	Если ПустаяСтрока(RunId) Тогда
		Возврат;
	КонецЕсли;
	ПолезнаяНагрузка = Новый Структура;
	ПолезнаяНагрузка.Вставить("code", Код);
	ПолезнаяНагрузка.Вставить("tool", ИмяTool);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "Failed", ПолезнаяНагрузка);
КонецПроцедуры

// Сформировать структуру результата диспетчера.
//
Функция Результат(Знач СтрокаРезультата, Знач RiskLevel)
	Стр = Новый Структура;
	Стр.Вставить("Успех", Истина);
	Стр.Вставить("Результат", СтрокаРезультата);
	Стр.Вставить("ResultRef", "");
	Стр.Вставить("RiskLevel", RiskLevel);
	Возврат Стр;
КонецФункции

// JSON-строка ошибки-observation: {"error":"<очищенный текст>"}.
//
Функция ОшибочныйJSON(Знач ТекстОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""dispatch_error""}", Результат);
КонецФункции

// Привести ответ tool к строке-observation (tool-функции возвращают строку JSON).
//
Функция СтрокаНаблюдения(Знач ОтветTool)
	Если ТипЗнч(ОтветTool) = Тип("Строка") Тогда
		Возврат ОтветTool;
	КонецЕсли;
	Если ОтветTool = Неопределено Тогда
		Возврат "{}";
	КонецЕсли;
	// Tool вернул не строку - сериализуем для устойчивости контракта.
	Сериализованный = ar_JSON.ВЗначениеJSON(ОтветTool);
	Возврат ?(ПустаяСтрока(Сериализованный), "{}", Сериализованный);
КонецФункции

// Извлечь ResultRef из JSON-observation tool (поле "ref"/"result_ref"), если есть.
//
Функция ИзвлечьResultRef(Знач ОтветTool)
	Если ТипЗнч(ОтветTool) <> Тип("Строка") Или ПустаяСтрока(ОтветTool) Тогда
		Возврат "";
	КонецЕсли;
	Объект = ar_JSON.ИзJSON(ОтветTool);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Объект.Получить("result_ref");
	Если Значение = Неопределено Тогда
		Значение = Объект.Получить("ref");
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");
КонецФункции

// Безопасно получить значение из КонтекстЗапуска (Структура) с дефолтом.
//
Функция ЗначениеКонтекста(Знач КонтекстЗапуска, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(КонтекстЗапуска) <> Тип("Структура") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Дефолт;
	КонтекстЗапуска.Свойство(Ключ, Значение);
	Возврат Значение;
КонецФункции

// Найти кэшированный результат предыдущего исполнения commit-tool (DISP-04).
//
// Тонкая обёртка над ar_Approval.НайтиПредыдущийРезультат (APPR-01): чтение
// привилегированной очереди approval инкапсулировано в модуле ar_Approval.
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности.
//
// Возвращаемое значение:
//  Неопределено - нет executed-записи (выполнять штатно);
//  Строка       - кэшированный JSON-результат предыдущего вызова.
//
Функция НайтиПредыдущийРезультат(Знач IdempotencyKey)
	Возврат ar_Approval.НайтиПредыдущийРезультат(IdempotencyKey);
КонецФункции

#КонецОбласти

#Область ИнициализацияПриЗапуске

// Вызывается из модуля управляемого приложения расширения при старте системы.
// Регистрирует ядровые tools (однократно) и возвращает флаг необходимости мастера.
//
// Возвращаемое значение:
//   Структура - АдминИМастерНужен - Булево.
//
Функция ИнициализироватьПриЗапускеСистемы() Экспорт

	// UNIV-06: адаптеры заполнения регистрируются ДО tools - критерий
	// "ar_ТребуетАдаптер" (см. РезультатПроверкиДоступности) проверяется внутри
	// ЗарегистрироватьВсеTools/ПересчитатьДоступностьВсехTools ниже; если
	// адаптер зарегистрировать после, create_invoice_draft на первом же старте
	// системы окажется недоступен до следующего пересчёта.
	Попытка
		ar_АдаптерЗаполнения.ЗарегистрироватьВсеАдаптеры();
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru='AgentRunner: регистрация адаптеров заполнения'; en='AgentRunner: fill adapters registration'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Попытка
		АвтоЗаполнитьРеестрToolsПриЗапуске();
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru='AgentRunner: регистрация tools'; en='AgentRunner: tools registration'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Попытка
		ar_ОбновлениеРасширения.ВыполнитьОбновлениеПриНеобходимости();
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru='AgentRunner: обновление расширения'; en='AgentRunner: extension update'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Результат = Новый Структура("АдминИМастерНужен", Ложь);

	// Мастер выполняет привилегированные операции (создание пользователя ИБ
	// ar_AgentRunner и т.п.) - поэтому условие показа завязано на полные права,
	// а не на прикладную роль ar_РольАдмин: перебор
	// ПользователиИнформационнойБазы.ТекущийПользователь().Роли отражал бы
	// только роли, назначенные напрямую объекту пользователя ИБ, и не
	// учитывал бы фактически действующие в сеансе права.
	// [Реф: БСП/Пользователи.ЭтоПолноправныйПользователь]
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();

	Если ЭтоПолноправныйПользователь И НЕ Константы.ar_МастерНастройкиВыполнен.Получить() Тогда
		Результат.АдминИМастерНужен = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет константу ar_МастерНастройкиВыполнен.
//
// Возвращаемое значение:
//   Булево - Истина, если мастер уже выполнен.
//
Функция МастерНастройкиВыполнен() Экспорт
	Возврат Константы.ar_МастерНастройкиВыполнен.Получить();
КонецФункции

#КонецОбласти
