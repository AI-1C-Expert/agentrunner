КонецФункции

// Заполняет ar_Представление/ar_Категория по таблице ПредставленияTools (UI-31).
//
// Пост-проход после регистрации всех модулей - по той же схеме, что и
// ПересчитатьДоступностьВсехTools: записываем только там, где значение
// реально изменилось (лишние Записать() дают мусор в истории данных).
//
// Возвращаемое значение:
//  Число - количество обновлённых записей реестра.
//
Функция ЗаполнитьПредставленияВсехTools() Экспорт

	Представления = ПредставленияTools();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка          КАК Ссылка,
		|	Tools.ar_Имя          КАК Имя,
		|	Tools.ar_Представление КАК Представление,
		|	Tools.ar_Категория    КАК Категория
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";

	Обновлено = 0;

	// Длины строковых полей справочника (Catalogs/ar_Tools.xml) - Лев() ниже
	// защищает от переполнения, если название окажется длиннее поля.
	ДлинаПоляПредставление = 150;
	ДлинаПоляКатегория     = 100;

	// Режим поднимается один раз на весь проход (запись в реестр tools -
	// служебная операция, права на ar_Tools у обычного пользователя нет).
	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл

			Эталон = Представления.Получить(СокрЛП(Строка(Выборка.Имя)));
			Если Эталон = Неопределено Тогда
				// Tool не из ядрового набора (стороннее расширение) - не трогаем.
				Продолжить;
			КонецЕсли;

			ТекущееПредставление = СокрЛП(?(ТипЗнч(Выборка.Представление) = Тип("Строка"), Выборка.Представление, ""));
			ТекущаяКатегория     = СокрЛП(?(ТипЗнч(Выборка.Категория) = Тип("Строка"), Выборка.Категория, ""));

			Если ТекущееПредставление = Эталон.Представление И ТекущаяКатегория = Эталон.Категория Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.ar_Представление = Лев(Эталон.Представление, ДлинаПоляПредставление);
					Объект.ar_Категория     = Лев(Эталон.Категория, ДлинаПоляКатегория);
					Объект.Записать();
					Обновлено = Обновлено + 1;
				КонецЕсли;
			Исключение
				// Сбой на одной записи не должен ронять обработку остальных.
				ar_СлужебныйЛог.Записать(
					"ar_ToolDispatcher.ЗаполнитьПредставленияВсехTools",
					"display_name_write_error",
					СокрЛП(Строка(Выборка.Имя)) + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
					"Предупреждение");
			КонецПопытки;

		КонецЦикла;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	ar_СлужебныйЛог.Записать(
		"ar_ToolDispatcher.ЗаполнитьПредставленияВсехTools",
		"tools_display_names_filled",
		"Обновлено записей: " + Обновлено,
		"Информация");

	Возврат Обновлено;

КонецФункции

// SCALE-02: заполняет ar_КлючевыеСловаПараметров именами параметров, извлечёнными
// из ar_JSONManifest.function.parameters.properties - постпроход по образцу
// ЗаполнитьПредставленияВсехTools (та же схема: только реальные изменения
// записываются, ошибка одной записи не прерывает остальные).
//
// В отличие от ЗаполнитьПредставленияВсехTools здесь нет whitelist по имени -
// обрабатываются ВСЕ записи ar_Tools с непустым ar_JSONManifest, включая
// сторонние (расширения, пакеты) - параметры это чисто структурные данные
// самого манифеста, ядровой список tools для их извлечения не нужен.
//
// Возвращаемое значение:
//  Число - количество обновлённых записей реестра.
//
Функция ЗаполнитьКлючевыеСловаПараметровВсехTools() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_JSONManifest КАК JSONManifest,
		|	Tools.ar_КлючевыеСловаПараметров КАК КлючевыеСловаПараметров
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";

	Обновлено = 0;

	// Длина поля ar_КлючевыеСловаПараметров (Catalogs/ar_Tools.xml) - Лев() ниже
	// защищает от переполнения на tools с необычно большим числом параметров.
	ДлинаПоляКлючевыеСлова = 300;

	// Режим поднимается один раз на весь проход (запись в реестр tools -
	// служебная операция, права на ar_Tools у обычного пользователя нет).
	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл

			ИмяTool = СокрЛП(Строка(Выборка.Имя));

			НовыеКлючевыеСлова = КлючевыеСловаПараметровИзМанифеста(Выборка.JSONManifest);
			Если НовыеКлючевыеСлова = Неопределено Тогда
				// Пустой/некорректный JSON или отсутствие properties - штатный
				// случай для tools без параметров (get_current_context и т.п.),
				// не ошибка. Предупреждение пишется только при реально некорректном
				// JSON - см. КлючевыеСловаПараметровИзМанифеста.
				Продолжить;
			КонецЕсли;

			НовыеКлючевыеСлова = Лев(НовыеКлючевыеСлова, ДлинаПоляКлючевыеСлова);
			ТекущиеКлючевыеСлова = СокрЛП(?(ТипЗнч(Выборка.КлючевыеСловаПараметров) = Тип("Строка"),
				Выборка.КлючевыеСловаПараметров, ""));

			Если ТекущиеКлючевыеСлова = НовыеКлючевыеСлова Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.ar_КлючевыеСловаПараметров = НовыеКлючевыеСлова;
					Объект.Записать();
					Обновлено = Обновлено + 1;
				КонецЕсли;
			Исключение
				// Сбой на одной записи не должен ронять обработку остальных.
				ar_СлужебныйЛог.Записать(
					"ar_ToolDispatcher.ЗаполнитьКлючевыеСловаПараметровВсехTools",
					"parameter_keywords_write_error",
					ИмяTool + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
					"Предупреждение");
			КонецПопытки;

		КонецЦикла;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	ar_СлужебныйЛог.Записать(
		"ar_ToolDispatcher.ЗаполнитьКлючевыеСловаПараметровВсехTools",
		"tool_parameter_keywords_filled",
		"Обновлено записей: " + Обновлено,
		"Информация");

	Возврат Обновлено;

КонецФункции

// Извлекает имена параметров tool из JSON-манифеста (OpenAI tool-format):
// function.parameters.properties -> ключи, склеенные через ", " в порядке
// появления (ar_JSON.ИзJSON возвращает Соответствие для JSON-объектов, порядок
// вставки в Соответствие стабилен - повторная сортировка не требуется).
//
// Параметры:
//  JSONManifest - Строка - содержимое ar_Tools.ar_JSONManifest.
//
// Возвращаемое значение:
//  Строка - "param1, param2, param3" либо "" (properties пуст/отсутствует).
//  Неопределено - JSONManifest пуст или не разбирается как JSON-объект
//  (сигнал вызывающему коду пропустить запись без записи "").
//
Функция КлючевыеСловаПараметровИзМанифеста(Знач JSONManifest)

	Если ТипЗнч(JSONManifest) <> Тип("Строка") Или ПустаяСтрока(JSONManifest) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(JSONManifest);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбъектФункция = Разобрано.Получить("function");
	Если ТипЗнч(ОбъектФункция) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Параметры = ОбъектФункция.Получить("parameters");
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Свойства = Параметры.Получить("properties");
	Если ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		// Валиден и распознан, но параметров нет (get_current_context и т.п.) -
		// штатный пустой результат, не Неопределено (это не ошибка парсинга).
		Возврат "";
	КонецЕсли;

	ИменаПараметров = Новый Массив;
	Для Каждого КлючЗначение Из Свойства Цикл
		ИменаПараметров.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Возврат СтрСоединить(ИменаПараметров, ", ");

КонецФункции

// SCALE-01: идемпотентная регистрация (upsert по Код) ядровых категорий tools
// в справочник ar_КатегорииTools - источник карты категорий (SCALE-05) и
// человекочитаемых названий для попапа композера (UI-31, ar_Диалог.СписокВсехTools).
//
// Вызывается из того же места, что и ЗарегистрироватьВсеTools (см.
// ИнициализироватьПриЗапускеСистемы), и отдельно из обработчика обновления
// ar_ОбновлениеРасширения (МигрироватьКатегорииTools) на существующих базах,
// где АвтоЗаполнитьРеестрToolsПриЗапуске не выполняется повторно.
//
// Существующие записи обновляются только если значение реально изменилось
// (Наименование/ОписаниеДляLLM/Порядок) - без лишних Записать() в истории
// данных, по той же схеме, что ЗаполнитьПредставленияВсехTools.
// ar_ИсточникРасширение для ядровых категорий не трогается повторно (остаётся
// пустым - ядро AgentRunner), если запись уже создана пакетом с тем же кодом
// (маловероятно, но не перезаписываем источник молча).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число }.
//
Функция ЗарегистрироватьКатегории() Экспорт

	Итог = Новый Структура("Создано, Обновлено", 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Категории.Ссылка КАК Ссылка,
		|	Категории.Код КАК Код,
		|	Категории.Наименование КАК Наименование,
		|	Категории.ar_ОписаниеДляLLM КАК ОписаниеДляLLM,
		|	Категории.ar_Порядок КАК Порядок
		|ИЗ
		|	Справочник.ar_КатегорииTools КАК Категории
		|ГДЕ
		|	НЕ Категории.ПометкаУдаления";

	// В соответствие кладётся СТРУКТУРА со значениями, а не сама Выборка:
	// ВыборкаИзРезультатаЗапроса - это курсор, а не строка. Сохранив его,
	// все элементы соответствия указывали бы на один объект в последнем
	// состоянии, и категории сравнивались/обновлялись бы по чужим данным
	// (проявилось живьём: "Служебные"/service показывались как
	// "Взаимодействие" с порядком 90 вместо 100).
	СуществующиеПоКоду = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСтроки = Новый Структура("Ссылка, Наименование, ОписаниеДляLLM, Порядок",
			Выборка.Ссылка, Выборка.Наименование, Выборка.ОписаниеДляLLM, Выборка.Порядок);
		СуществующиеПоКоду.Вставить(СокрЛП(Выборка.Код), ДанныеСтроки);
	КонецЦикла;

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Для Каждого Категория Из СписокЯдровыхКатегорий() Цикл

			СтрокаСуществующей = СуществующиеПоКоду.Получить(Категория.Код);

			Если СтрокаСуществующей = Неопределено Тогда

				Объект = Справочники.ar_КатегорииTools.СоздатьЭлемент();
				Объект.Код = Категория.Код;
				Объект.Наименование = Категория.Наименование;
				Объект.ar_ОписаниеДляLLM = Категория.ОписаниеДляLLM;
				Объект.ar_Порядок = Категория.Порядок;
				Объект.ar_ИсточникРасширение = "";
				Объект.Записать();
				Итог.Создано = Итог.Создано + 1;

			Иначе

				ТекущееНаименование = СокрЛП(?(ТипЗнч(СтрокаСуществующей.Наименование) = Тип("Строка"), СтрокаСуществующей.Наименование, ""));
				ТекущееОписание     = СокрЛП(?(ТипЗнч(СтрокаСуществующей.ОписаниеДляLLM) = Тип("Строка"), СтрокаСуществующей.ОписаниеДляLLM, ""));
				ТекущийПорядок      = СтрокаСуществующей.Порядок;

				НужнаЗапись = (ТекущееНаименование <> Категория.Наименование)
					Или (ТекущееОписание <> Категория.ОписаниеДляLLM)
					Или (ТекущийПорядок <> Категория.Порядок);

				Если НЕ НужнаЗапись Тогда
					Продолжить;
				КонецЕсли;

				Объект = СтрокаСуществующей.Ссылка.ПолучитьОбъект();
				Если Объект = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Объект.Наименование = Категория.Наименование;
				Объект.ar_ОписаниеДляLLM = Категория.ОписаниеДляLLM;
				Объект.ar_Порядок = Категория.Порядок;
				Объект.Записать();
				Итог.Обновлено = Итог.Обновлено + 1;

			КонецЕсли;

		КонецЦикла;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	ar_СлужебныйЛог.Записать(
		"ar_ToolDispatcher.ЗарегистрироватьКатегории",
		"tool_categories_registered",
		СтрШаблон("Создано: %1, обновлено: %2.", Итог.Создано, Итог.Обновлено),
		"Информация");

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ДвухуровневоеВетвление

// Уровень 1: ветвление по имени общего модуля. БЕЗ Выполнить()/Вычислить().
// Точка добавления новой ветви помечена маркером внутри тела функции (см. ниже).
// Не ядровой модуль делегируется в ar_ToolПереопределяемый.ВызватьПользовательскийТул
// (EXT-10); неизвестный там модуль → unknown_module.
//
// Параметры:
//  ИмяМодуля    - Строка - значение ar_ОбщийМодуль (например "ar_ToolПамять").
//  ИмяПроцедуры - Строка - значение ar_ИмяПроцедуры (например "ПоискКлиентов").
//  Аргументы    - Строка - JSON-аргументы (обогащённые системными полями).
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation от tool-функции.
//
Функция ВыполнитьЯдровойМодуль(Знач ИмяМодуля, Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)

	// PKG-09: ar_ToolCRM/ar_ToolДокументы/ar_ToolФинансы (10 tools, префикс
	// buh_) вынесены из ядра в пакет "AgentRunner Бухгалтерия"
	// (packages/ar_ПакетБухгалтерия) - маршрутизация к ним теперь идёт ДО
	// этой функции, через ветвь ИсточникТип = "Пакет" в Вызвать (см. шаг 5
	// выше), а не через ВыполнитьЯдровойМодуль. Ветви и парные функции
	// ВыполнитьПроцедуруToolCRM/ВыполнитьПроцедуруToolДокументы/
	// ВыполнитьПроцедуруToolФинансы удалены - модули больше не существуют в
	// src/. См. .docs/specs/PKG-09.md.
	Если ИмяМодуля = "ar_ToolUniversal" Тогда
		Возврат ВыполнитьПроцедуруToolUniversal(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolКоммуникации" Тогда
		Возврат ВыполнитьПроцедуруToolКоммуникации(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolПамять" Тогда
		Возврат ВыполнитьПроцедуруToolПамять(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolInteraction" Тогда
		Возврат ВыполнитьПроцедуруToolInteraction(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolОтчёты" Тогда
		Возврат ВыполнитьПроцедуруToolОтчёты(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolАварийный" Тогда
		Возврат ВыполнитьПроцедуруToolАварийный(ИмяПроцедуры, Аргументы, Контекст);

	ИначеЕсли ИмяМодуля = "ar_ToolРеестрПоиск" Тогда
		// SCALE-03: find_tools/describe_tool - седьмой ядровой tool-модуль.
		Возврат ВыполнитьПроцедуруToolРеестрПоиск(ИмяПроцедуры, Аргументы, Контекст);

	// !!! ДОБАВЛЯТЬ НОВЫЙ ЯДРОВОЙ TOOL-МОДУЛЬ ЗДЕСЬ: новая ветвь ИначеЕсли с
	// вызовом второго уровня ВыполнитьПроцедуру<Модуль>. Строка-имя модуля
	// ОБЯЗАНА совпадать с именем файла в src/CommonModules/ и со значением
	// ar_ОбщийМодуль в справочнике ar_Tools (DoD D13). Обязательно создать
	// парную локальную функцию ВыполнитьПроцедуру<Модуль> в области ниже.
	// Ветвь добавляется ЗДЕСЬ - перед блоком Иначе (пользовательские tools, EXT-10).

	Иначе
		// EXT-10: не ядровой модуль - маршрутизация в переопределяемый модуль
		// ядра ar_ToolПереопределяемый (БСП-паттерн "переопределяемый общий
		// модуль", см. заголовок модуля). Прикладной разработчик правит
		// ИМЕННО этот модуль в своей копии src/, дописывая ветвь под свой
		// tool-модуль (см. ar_ToolПереопределяемый.ВызватьПользовательскийТул).
		// Один из путей замены устаревшей, физически нереализуемой схемы
		// "Expert Pack" (EXT-01: расширение поверх расширения - в 1С не
		// работает) - путь "форк". Второй путь, "пакет" (PKG-04,
		// ar_ИсточникТип = "Пакет"), сюда НЕ попадает: он обрабатывается
		// раньше и вне этой функции - в Вызвать, шаг 5 (см. Implementation =
		// "package" выше по модулю). В эту ветвь Иначе попадают только tools
		// с заполненным ar_ОбщийМодуль, не совпадающим ни с одним ядровым
		// модулем выше по цепочке ИначеЕсли.
		Возврат ar_ToolПереопределяемый.ВызватьПользовательскийТул(ИмяМодуля, ИмяПроцедуры, Аргументы, Контекст);
	КонецЕсли;

КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolUniversal по имени.
// Делегирует в локальный диспетчер модуля (контракт второго уровня).
//
Функция ВыполнитьПроцедуруToolUniversal(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolUniversal.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolКоммуникации по имени.
//
Функция ВыполнитьПроцедуруToolКоммуникации(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolКоммуникации.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
КонецФункции

// Уровень 2: ветвление процедур модуля ar_ToolПамять по имени (MEM-01).
// Делегирует в локальный диспетчер модуля (контракт второго уровня).
//
Функция ВыполнитьПроцедуруToolПамять(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст)
	Возврат ar_ToolПамять.Диспетчер(ИмяПроцедуры, Аргументы, Контекст);
