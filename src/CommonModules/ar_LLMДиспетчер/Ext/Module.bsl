////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_LLMДиспетчер (AOS LLM — Диспетчер провайдеров).
//
// Центральная точка вызова LLM из агентского цикла. Ядро (runtime, тесты)
// никогда не обращается к конкретному провайдеру напрямую — только через
// этот диспетчер. Реализует:
//   * выбор модуля провайдера по типу справочника ar_LLMПровайдеры
//     через явное двухуровневое ветвление (без Выполнить/Вычислить);
//   * экспоненциальный backoff на транзиентные ошибки (429, 5xx, код 0);
//   * fallback на резервного провайдера (1 попытка) при исчерпании попыток
//     основного.
//
// Контракт возврата идентичен контракту провайдеров (см. ar_LLMOpenAI.Чат)
// с двумя дополнительными ключами: ПровайдерИтог, ПопытокСделано — для
// аудита и метрик (LLM-06).
//
// LLM-06: usage (ТокеновВход/ТокеновВыход) — берётся из последнего вызова
// провайдера (overwrite, без суммирования между попытками). При fallback
// usage основного провайдера затирается usage fallback-провайдера. Цикл
// агента (RT-06+) сам суммирует usage между шагами; диспетчер этого не
// делает по контракту.
//
// Контракт: см. ar_LLMКонтракт — единый набор ключей структур и валидаторы
// (ar_LLMКонтракт.ВалидироватьСообщения / ВалидироватьОтвет).
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, Client = false, ServerCall = false,
//   Privileged = false, ReturnValuesReuse = DontUse.
//
// Привилегированный режим не устанавливается — секреты читают внутри
// модулей провайдеров через ar_Secrets. Транзакции не используются.
//
// См. спеку: .docs/specs/LLM-02.md, Plan §2.8, §3.1, §16.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Вызывает LLM-провайдер с поддержкой retry (экспоненциальный backoff) и fallback.
//
// Параметры:
//   Контекст - Структура - {
//     Сообщения           - Массив - сообщения во внутреннем формате AgentRunner
//     Провайдер           - СправочникСсылка.ar_LLMПровайдеры - основной провайдер
//     Модель              - Строка - модель (опционально)
//     Температура         - Число  - 0..2 (опционально)
//     МаксТокенов         - Число  - лимит токенов (0 = не передавать)
//     Tools               - Массив - манифесты tool (опционально)
//     ФallbackПровайдер   - СправочникСсылка.ar_LLMПровайдеры - резервный (опционально)
//     МаксПопыток         - Число  - максимум попыток основного (0 = 5 по умолчанию)
//   }
//
// Возвращаемое значение:
//   Структура - {
//     Успех          - Булево
//     Сообщение      - Структура - первое сообщение (role="assistant", content, [tool_calls])
//     ТокеновВход    - Число
//     ТокеновВыход   - Число
//     Ошибка         - Строка
//     КодСостояния   - Число     - последний HTTP-код
//     ПровайдерИтог  - Строка    - наименование фактически ответившего провайдера
//     ПопытокСделано - Число     - суммарно (основной + fallback)
//     БалансРуб      - Число|Неопределено - LLM-14 (часть Б): текущий баланс
//                      шлюза после списания; заполняет только
//                      ar_LLMAgentRunnerCloud, Неопределено у остальных
//                      провайдеров (НЕ 0 - см. ar_LLMКонтракт.НовыйОтвет).
//     БалансНизкий   - Булево    - LLM-14 (часть Б): признак приближения
//                      баланса шлюза к нулю (порог настраивается на стороне
//                      шлюза); Ложь у остальных провайдеров. При fallback
//                      отражает последнего фактически ответившего
//                      провайдера, без наследования от предыдущих попыток -
//                      тот же паттерн, что уже описан для usage (см. шапку
//                      модуля).
//   }
//
Функция Вызвать(Контекст) Экспорт

	Результат = НовыйРезультат();

	// --- Валидация входа ---------------------------------------------------
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Результат.Ошибка = "Контекст не задан";
		Возврат Результат;
	КонецЕсли;

	Сообщения = Неопределено;
	Если НЕ Контекст.Свойство("Сообщения", Сообщения)
		ИЛИ ТипЗнч(Сообщения) <> Тип("Массив")
		ИЛИ Сообщения.Количество() = 0 Тогда
		Результат.Ошибка = "Сообщения не заданы";
		Возврат Результат;
	КонецЕсли;

	Провайдер = Неопределено;
	Если НЕ Контекст.Свойство("Провайдер", Провайдер)
		ИЛИ НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Результат.Ошибка = "Провайдер не задан";
		Возврат Результат;
	КонецЕсли;

	МаксПопытокВход = 0;
	Контекст.Свойство("МаксПопыток", МаксПопытокВход);
	МаксПопыток = ?(ТипЗнч(МаксПопытокВход) = Тип("Число") И МаксПопытокВход > 0,
		МаксПопытокВход, 5);

	// --- PII-07: «последний рубеж» ------------------------------------------
	// При включённом compliance-режиме маскируем ПДн/секреты во всём
	// отправляемом контексте (реплики пользователя, system prompt, история,
	// аргументы tool_calls) по паттернам значений — см.
	// ar_Утилиты.МаскироватьПДнВТексте. Контекст.Сообщения подменяется
	// маскированной копией до вызовов провайдеров (основной и fallback
	// используют один Контекст, подмена в одной точке покрывает оба);
	// исходные структуры сообщений не мутируются — на них ссылается
	// история сессии.
	Если ar_Константы.ComplianceРежим() Тогда
		РезультатМаскирования = СообщенияСМаскировкойПДн(Сообщения);
		Контекст.Сообщения = РезультатМаскирования.Сообщения;
		Если РезультатМаскирования.Изменено > 0 Тогда
			// Только счётчики, без текстов сообщений (PII).
			ar_СлужебныйЛог.Записать("ar_LLMДиспетчер.Вызвать", "pii_final_guard",
				СтрШаблон(НСтр("ru='Изменено сообщений: %1 из %2';
				|en='Messages changed: %1 of %2'"),
				Формат(РезультатМаскирования.Изменено, "ЧГ="),
				Формат(Сообщения.Количество(), "ЧГ=")));
		КонецЕсли;
	КонецЕсли;

	// --- Основной провайдер -----------------------------------------------
	Результат = ВыполнитьСПовторами(Провайдер, Контекст, МаксПопыток);
	Если Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	// --- Fallback ---------------------------------------------------------
	FallbackСсылка = Неопределено;
	Контекст.Свойство("ФallbackПровайдер", FallbackСсылка);

	ЕстьFallback = ЗначениеЗаполнено(FallbackСсылка) И FallbackСсылка <> Провайдер;

	Если ЕстьFallback Тогда

		// Логируем переход на fallback — только метаданные, без тел сообщений.
		ЛогироватьСобытие("Fallback",
			"Основной провайдер исчерпал попытки, переход на fallback."
			+ " Основной=" + Результат.ПровайдерИтог
			+ "; КодСостояния=" + Формат(Результат.КодСостояния, "ЧГ=")
			+ "; ПопытокОсновного=" + Формат(Результат.ПопытокСделано, "ЧГ="));

		РезультатFallback = ВыполнитьСПовторами(FallbackСсылка, Контекст, 1);
		// Суммарное число попыток по основному + fallback.
		РезультатFallback.ПопытокСделано = Результат.ПопытокСделано
			+ РезультатFallback.ПопытокСделано;

		Если РезультатFallback.Успех Тогда
			Возврат РезультатFallback;
		КонецЕсли;

		// Оба провайдера провалились — логируем и объединяем диагностику.
		ЛогироватьСобытие("FallbackПровален",
			"Fallback не удался. Fallback=" + РезультатFallback.ПровайдерИтог
			+ "; КодСостояния=" + Формат(РезультатFallback.КодСостояния, "ЧГ=")
			+ "; ВсегоПопыток=" + Формат(РезультатFallback.ПопытокСделано, "ЧГ="));

		ОбъединённаяОшибка = "Основной: " + Результат.Ошибка
			+ "; Fallback: " + РезультатFallback.Ошибка;

		РезультатFallback.Ошибка = ОбъединённаяОшибка;
		Возврат РезультатFallback;

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Типы провайдера, предлагаемые пользователю для выбора, в фиксированном
// порядке. Единый источник для мастера настройки (ОбщаяФорма.ar_МастерНастройки)
// и карточки справочника (Справочник.ar_LLMПровайдеры.Форма.ФормаЭлемента),
// чтобы список не расходился между двумя точками входа.
//
// Остальные значения перечисления ar_ТипПровайдера (OpenAI, Anthropic, Mock)
// остаются в метаданных и работают в рантайме, но в UI не предлагаются.
// AgentRunnerCloud идёт первым - это выбор по умолчанию (готовый шлюз, не
// требующий своего ключа у стороннего провайдера).
//
// Подпись берётся из синонима значения перечисления - единый источник истины
// с метаданными.
//
// Возвращаемое значение:
//   Массив из Структура - {
//     Имя     - Строка - имя значения перечисления
//     Ссылка  - ПеречислениеСсылка.ar_ТипПровайдера
//     Подпись - Строка - отображаемый текст
//   }
//
Функция ТипыПровайдераДляВыбора() Экспорт

	ИменаПоПорядку = Новый Массив;
	ИменаПоПорядку.Добавить("AgentRunnerCloud");
	ИменаПоПорядку.Добавить("LocalCompatible");
	ИменаПоПорядку.Добавить("YandexGPT");
	ИменаПоПорядку.Добавить("GigaChat");

	СинонимыПоИмени = Новый Соответствие;
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.ar_ТипПровайдера.ЗначенияПеречисления Цикл
		СинонимыПоИмени.Вставить(ЗначениеПеречисления.Имя, ЗначениеПеречисления.Синоним);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого ИмяЗначения Из ИменаПоПорядку Цикл
		Описание = Новый Структура("Имя, Ссылка, Подпись");
		Описание.Имя     = ИмяЗначения;
		Описание.Ссылка  = Перечисления.ar_ТипПровайдера[ИмяЗначения];
		Описание.Подпись = СинонимыПоИмени[ИмяЗначения];
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// PII-07: Строит маскированную копию массива сообщений LLM-контекста.
// Маскируются строковые content всех сообщений и arguments в tool_calls
// (через ar_Утилиты.МаскироватьПДнВТексте); прочие свойства переносятся
// как есть. Исходные структуры не мутируются.
//
// Параметры:
//   Сообщения - Массив из Структура - сообщения контракта ar_LLMКонтракт.
//
// Возвращаемое значение:
//   Структура:
//     Сообщения - Массив - маскированная копия (новые структуры)
//     Изменено  - Число  - количество сообщений, в которых маскирование
//                          что-то заменило
//
Функция СообщенияСМаскировкойПДн(Знач Сообщения)

	Итог = Новый Структура;
	Итог.Вставить("Сообщения", Новый Массив);
	Итог.Вставить("Изменено", 0);

	Для Каждого Сообщение Из Сообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Итог.Сообщения.Добавить(Сообщение);
			Продолжить;
		КонецЕсли;

		СообщениеИзменено = Ложь;
		Копия = Новый Структура;

		Для Каждого КлючИЗначение Из Сообщение Цикл

			Если НРег(КлючИЗначение.Ключ) = "content"
				И ТипЗнч(КлючИЗначение.Значение) = Тип("Строка") Тогда
				Маскированное = ar_Утилиты.МаскироватьПДнВТексте(КлючИЗначение.Значение);
				Если Маскированное <> КлючИЗначение.Значение Тогда
					СообщениеИзменено = Истина;
				КонецЕсли;
				Копия.Вставить(КлючИЗначение.Ключ, Маскированное);

			ИначеЕсли НРег(КлючИЗначение.Ключ) = "tool_calls"
				И ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
				КопияВызовов = Новый Массив;
				Для Каждого Вызов Из КлючИЗначение.Значение Цикл
					КопияВызовов.Добавить(МаскированныйToolCall(Вызов, СообщениеИзменено));
				КонецЦикла;
				Копия.Вставить(КлючИЗначение.Ключ, КопияВызовов);

			Иначе
				Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;

		КонецЦикла;

		Если СообщениеИзменено Тогда
			Итог.Изменено = Итог.Изменено + 1;
		КонецЕсли;
		Итог.Сообщения.Добавить(Копия);

	КонецЦикла;

	Возврат Итог;

КонецФункции

// PII-07: Копия одного tool_call с маскировкой function.arguments.
//
// Параметры:
//   Вызов    - Структура - элемент tool_calls ({id, type, function}).
//   Изменено - Булево    - выходной флаг (по ссылке): Истина, если
//              маскирование заменило хоть что-то.
//
// Возвращаемое значение:
//   Структура - копия вызова (или исходное значение, если это не структура).
//
Функция МаскированныйToolCall(Знач Вызов, Изменено)

	Если ТипЗнч(Вызов) <> Тип("Структура") Тогда
		Возврат Вызов;
	КонецЕсли;

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Вызов Цикл
		Если НРег(КлючИЗначение.Ключ) = "function"
			И ТипЗнч(КлючИЗначение.Значение) = Тип("Структура") Тогда
			Копия.Вставить(КлючИЗначение.Ключ,
				МаскированнаяФункцияВызова(КлючИЗначение.Значение, Изменено));
		Иначе
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Копия;

КонецФункции

// PII-07: Копия структуры function из tool_call с маскировкой arguments.
//
// Параметры:
//   ФункцияВызова - Структура - {name, arguments}.
//   Изменено      - Булево    - выходной флаг (по ссылке).
//
// Возвращаемое значение:
//   Структура - копия.
//
Функция МаскированнаяФункцияВызова(Знач ФункцияВызова, Изменено)

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из ФункцияВызова Цикл
		Если НРег(КлючИЗначение.Ключ) = "arguments"
			И ТипЗнч(КлючИЗначение.Значение) = Тип("Строка") Тогда
			Маскированное = ar_Утилиты.МаскироватьПДнВТексте(КлючИЗначение.Значение);
			Если Маскированное <> КлючИЗначение.Значение Тогда
				Изменено = Истина;
			КонецЕсли;
			Копия.Вставить(КлючИЗначение.Ключ, Маскированное);
		Иначе
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Копия;

КонецФункции

// Выполняет вызов одного провайдера с циклом повторов и экспоненциальным backoff.
//
// Параметры:
//   СсылкаПровайдера - СправочникСсылка.ar_LLMПровайдеры
//   Контекст         - Структура - входной контекст диспетчера
//   МаксПопыток      - Число     - максимум попыток для этого провайдера
//
// Возвращаемое значение:
//   Структура (того же контракта, что и Вызвать).
//
Функция ВыполнитьСПовторами(СсылкаПровайдера, Контекст, МаксПопыток)

	Результат = НовыйРезультат();

	// Чтение реквизитов провайдера одним запросом (БСП).
	ДанныеПров = ДанныеПровайдера(СсылкаПровайдера);

	Если НЕ ДанныеПров.Прочитано Тогда
		Результат.Ошибка = "Не удалось прочитать провайдера: " + ДанныеПров.Имя;
		Результат.ПровайдерИтог = ДанныеПров.Имя;
		Возврат Результат;
	КонецЕсли;

	Если НЕ ДанныеПров.Включён Тогда
		Результат.Ошибка = "Провайдер отключён: " + ДанныеПров.Имя;
		Результат.ПровайдерИтог = ДанныеПров.Имя;
		Возврат Результат;
	КонецЕсли;

	ПараметрыПров = ПараметрыДляПровайдера(Контекст, ДанныеПров);

	// Перед первой попыткой задержки нет; перед попытками 2..5 — 2, 4, 8, 16 с.
	НомерПопытки = 0;

	Пока НомерПопытки < МаксПопыток Цикл

		Задержка = 0;
		Если НомерПопытки > 0 Тогда
			Задержка = ЗадержкаДляПопытки(НомерПопытки);
			ПаузаСекунд(Задержка);
		КонецЕсли;

		Шаг = ВызватьПровайдер(ДанныеПров.Тип, Контекст.Сообщения, ПараметрыПров);

		// Переносим поля шага в Результат и считаем попытку.
		// LLM-06: ТокеновВход/ТокеновВыход переносятся как есть (overwrite, не накопление).
		// Политика: usage предыдущих неуспешных попыток не суммируется — берётся usage
		// последнего вызова (победившего или последнего неуспешного).
		// При fallback (см. вызывающий код) usage основного провайдера затирается usage
		// fallback-провайдера, что соответствует требованию D8 спецификации LLM-06.
		ЗаполнитьЗначенияСвойств(Результат, Шаг);
		Результат.ПровайдерИтог = ДанныеПров.Имя;
		Результат.ПопытокСделано = НомерПопытки + 1;

		Если Результат.Успех Тогда
			Возврат Результат;
		КонецЕсли;

		Транзиентная = ЭтоТранзиентнаяОшибка(Шаг);

		// Лог попытки: только метаданные, без тел сообщений (PII).
		ЛогироватьСобытие("Retry",
			"Попытка не удалась. Провайдер=" + ДанныеПров.Имя
			+ "; Попытка=" + Формат(Результат.ПопытокСделано, "ЧГ=")
			+ "/" + Формат(МаксПопыток, "ЧГ=")
			+ "; КодСостояния=" + Формат(Результат.КодСостояния, "ЧГ=")
			+ "; Транзиентная=" + ?(Транзиентная, "Да", "Нет")
			+ "; СледующаяЗадержка=" + Формат(?(Транзиентная И НомерПопытки + 1 < МаксПопыток,
				ЗадержкаДляПопытки(НомерПопытки + 1), 0), "ЧГ=") + "с");

		Если НЕ Транзиентная Тогда
			// Нетранзиентная — retry бессмысленен.
			Возврат Результат;
		КонецЕсли;

		НомерПопытки = НомерПопытки + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вызывает конкретный модуль провайдера по типу через явное ветвление.
// При неизвестном или незарелизованном типе — нетранзиентная ошибка.
//
// Параметры:
//   ТипПровайдера       - ПеречислениеСсылка.ar_ТипПровайдера
//   Сообщения           - Массив
//   ПараметрыПровайдера - Структура
//
// Возвращаемое значение:
//   Структура - результат провайдера (Успех, Сообщение, ТокеновВход, ...).
//
Функция ВызватьПровайдер(ТипПровайдера, Сообщения, ПараметрыПровайдера)

	Если ТипПровайдера = Перечисления.ar_ТипПровайдера.OpenAI Тогда
		Возврат ar_LLMOpenAI.Чат(Сообщения, ПараметрыПровайдера);

	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.YandexGPT Тогда
		Возврат ar_LLMYandexGPT.Чат(Сообщения, ПараметрыПровайдера);

	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.GigaChat Тогда
		Возврат ar_LLMGigaChat.Чат(Сообщения, ПараметрыПровайдера);

	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.Mock Тогда
		// LLM-09: детерминированный mock-провайдер для интеграционных тестов.
		Возврат ar_LLMMock.Чат(Сообщения, ПараметрыПровайдера);

	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.Anthropic Тогда
		// LLM-10 (этап 2) — заглушка.
		Возврат ЧатЗаглушка("Anthropic");

	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.LocalCompatible Тогда
		// LLM-11: провайдер для OpenAI-совместимых локальных LLM.
		Возврат ar_LLMLocalCompatible.Чат(Сообщения, ПараметрыПровайдера);

	ИначеЕсли ТипПровайдера = Перечисления.ar_ТипПровайдера.AgentRunnerCloud Тогда
		// LLM-12: собственный облачный шлюз AgentRunner.
		Возврат ar_LLMAgentRunnerCloud.Чат(Сообщения, ПараметрыПровайдера);

	КонецЕсли;

	// Неизвестное (или пустое) значение перечисления — нетранзиентная ошибка.
	Результат = НовыйРезультатПровайдера();
	Результат.Ошибка = "Неизвестный тип провайдера: " + Строка(ТипПровайдера);
	Результат.Вставить("НеРеализован", Истина);
	Возврат Результат;

КонецФункции

// Возвращает результат-заглушку для незарелизованных провайдеров.
// КодСостояния = 0, но ошибка помечена флагом НеРеализован, чтобы
// ЭтоТранзиентнаяОшибка не запустила retry по сетевому коду 0.
//
Функция ЧатЗаглушка(ИмяТипа)
	Результат = НовыйРезультатПровайдера();
	Результат.Ошибка = "Провайдер " + ИмяТипа + " не реализован в этой версии AgentRunner";
	Результат.Вставить("НеРеализован", Истина);
	Возврат Результат;
КонецФункции

// Определяет, является ли ошибка транзиентной (допускает retry).
//
// Транзиентными считаются:
//   * сетевая ошибка (КодСостояния = 0), кроме заглушки «не реализован»;
//   * HTTP 429 (rate limit);
//   * HTTP 5xx (ошибки сервера провайдера).
//
// Параметры:
//   Результат - Структура - результат вызова провайдера.
//
// Возвращаемое значение:
//   Булево.
//
Функция ЭтоТранзиентнаяОшибка(Результат)

	// Защита от нештатного типа на входе — одной проверкой.
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Заглушка незарелизованного провайдера — нетранзиентная по определению.
	// (Иначе по КодСостояния = 0 заглушка попадала бы в retry.)
	ФлагНеРеализован = Ложь;
	Если Результат.Свойство("НеРеализован", ФлагНеРеализован) И ФлагНеРеализован Тогда
		Возврат Ложь;
	КонецЕсли;

	КодСостояния = 0;
	Результат.Свойство("КодСостояния", КодСостояния);

	Если КодСостояния = 0 Тогда
		Возврат Истина; // сетевая ошибка (timeout/DNS/connection reset)
	КонецЕсли;

	Если КодСостояния = 429 Тогда
		Возврат Истина; // rate limit
	КонецЕсли;

	Если КодСостояния >= 500 И КодСостояния <= 599 Тогда
		Возврат Истина; // ошибки сервера провайдера
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Возвращает задержку (секунды) перед заданной попыткой.
// Перед попыткой 1 — 2 с; перед 2 — 4 с; перед 3 — 8 с; перед 4 — 16 с;
// далее — 32 с. Совокупный wait <= 62 секунды при 5 попытках.
//
// Параметры:
//   НомерПопытки - Число - индекс задержки (1 — перед второй попыткой, и т.д.).
//
// Возвращаемое значение:
//   Число - задержка в секундах.
//
Функция ЗадержкаДляПопытки(НомерПопытки)
	Если НомерПопытки <= 0 Тогда
		Возврат 0;
	ИначеЕсли НомерПопытки = 1 Тогда
		Возврат 2;
	ИначеЕсли НомерПопытки = 2 Тогда
		Возврат 4;
	ИначеЕсли НомерПопытки = 3 Тогда
		Возврат 8;
	ИначеЕсли НомерПопытки = 4 Тогда
		Возврат 16;
	КонецЕсли;
	Возврат 32;
КонецФункции

// Пауза в секундах через цикл ожидания.
// Используется ТекущаяУниверсальнаяДата() — монотонна относительно UTC и
// не зависит от часового пояса сеанса.
//
// Параметры:
//   Секунд - Число - длительность паузы.
//
Процедура ПаузаСекунд(Секунд)

	Если ТипЗнч(Секунд) <> Тип("Число") ИЛИ Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;

	Дедлайн = ТекущаяУниверсальнаяДата() + Секунд;

	// Активное ожидание. В фоновом задании на сервере 1С допустимо;
	// максимальная задержка 32 секунды (Plan §3.1 / §16). При появлении
	// платформенного Sleep — заменяется однострочно.
	// ОбработкаПрерыванияПользователя() исключена намеренно: это клиентский
	// метод (проверка Ctrl+Break), в серверном коде фонового задания он не
	// существует и не имеет смысла - вызов ронял компиляцию модуля
	// (Procedure or function with the specified name is not defined).
	// Отмену фонового задания (ФоновоеЗадание.Отменить()) платформа
	// обрабатывает сама, без участия кода busy-wait.
	Пока ТекущаяУниверсальнаяДата() < Дедлайн Цикл
	КонецЦикла;

КонецПроцедуры

// Читает реквизиты провайдера одним запросом через БСП.
// При ошибке чтения возвращает структуру с Прочитано = Ложь и Имя = представление ссылки.
//
// Возвращаемое значение:
//   Структура - {
//     Прочитано    - Булево
//     Имя          - Строка
//     Тип          - ПеречислениеСсылка.ar_ТипПровайдера
//     Включён      - Булево
//     Таймаут      - Число
//     DefaultModel - Строка
//   }
//
Функция ДанныеПровайдера(СсылкаПровайдера)

	Результат = Новый Структура;
	Результат.Вставить("Прочитано", Ложь);
	Результат.Вставить("Имя", "");
	Результат.Вставить("Тип", Перечисления.ar_ТипПровайдера.ПустаяСсылка());
	Результат.Вставить("Включён", Ложь);
	Результат.Вставить("Таймаут", 0);
	Результат.Вставить("DefaultModel", "");

	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			СсылкаПровайдера,
			"Наименование, ar_Тип, ar_Включён, ar_Таймаут, ar_DefaultModel");

		Результат.Имя = СокрЛП(Строка(Реквизиты.Наименование));
		Результат.Тип = Реквизиты.ar_Тип;
		Результат.Включён = Булево(Реквизиты.ar_Включён);
		Если ТипЗнч(Реквизиты.ar_Таймаут) = Тип("Число") Тогда
			Результат.Таймаут = Реквизиты.ar_Таймаут;
		КонецЕсли;
		Результат.DefaultModel = СокрЛП(Строка(Реквизиты.ar_DefaultModel));
		Результат.Прочитано = Истина;
	Исключение
		// Имя оставим как представление ссылки — пригодится в сообщении об ошибке.
		Результат.Имя = Строка(СсылкаПровайдера);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Формирует параметры для передачи в модуль провайдера из Контекста и данных провайдера.
//
// Параметры:
//   Контекст    - Структура - входной контекст диспетчера
//   ДанныеПров  - Структура - результат ДанныеПровайдера
//
// Возвращаемое значение:
//   Структура - готовый параметр для <Провайдер>.Чат(Сообщения, Параметры).
//
Функция ПараметрыДляПровайдера(Контекст, ДанныеПров)

	Параметры = Новый Структура;
	Параметры.Вставить("Провайдер", Контекст.Провайдер);

	// Модель: явная из контекста или DefaultModel провайдера.
	Модель = "";
	Контекст.Свойство("Модель", Модель);
	Если ТипЗнч(Модель) <> Тип("Строка") ИЛИ ПустаяСтрока(Модель) Тогда
		Модель = ДанныеПров.DefaultModel;
	КонецЕсли;
	Параметры.Вставить("Модель", Модель);

	// Температура — пробрасываем как есть, если задана числом.
	Температура = Неопределено;
	Если Контекст.Свойство("Температура", Температура) И ТипЗнч(Температура) = Тип("Число") Тогда
		Параметры.Вставить("Температура", Температура);
	КонецЕсли;

	// МаксТокенов — 0 трактуется провайдером как «не передавать».
	МаксТокенов = 0;
	Если Контекст.Свойство("МаксТокенов", МаксТокенов) И ТипЗнч(МаксТокенов) = Тип("Число") Тогда
		Параметры.Вставить("МаксТокенов", МаксТокенов);
	КонецЕсли;

	// Tools — массив манифестов, пробрасываем как есть.
	Tools = Неопределено;
	Если Контекст.Свойство("Tools", Tools) И ТипЗнч(Tools) = Тип("Массив") Тогда
		Параметры.Вставить("Tools", Tools);
	КонецЕсли;

	// Таймаут: реквизит провайдера → fallback на константу.
	Таймаут = ?(ДанныеПров.Таймаут > 0, ДанныеПров.Таймаут, ar_Константы.ТаймаутLLM());
	Параметры.Вставить("Таймаут", Таймаут);

	Возврат Параметры;

КонецФункции

// Формирует пустой результат-контракта провайдера (6 ключей).
// Базовая функция — используется внутри ВызватьПровайдер / ЧатЗаглушка
// и как фундамент для НовыйРезультат() (контракт диспетчера = контракт
// провайдера + ПровайдерИтог + ПопытокСделано).
//
// Возвращаемое значение:
//   Структура - {Успех=Ложь, Сообщение=Неопределено, ТокеновВход=0,
//                ТокеновВыход=0, Ошибка="", КодСостояния=0,
//                БалансРуб=Неопределено, БалансНизкий=Ложь}.
//
Функция НовыйРезультатПровайдера()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);
	// LLM-14 (часть Б): БалансРуб/БалансНизкий - опциональные поля, заполняет
	// только ar_LLMAgentRunnerCloud. У остальных провайдеров ЗаполнитьЗначенияСвойств
	// (см. ВыполнитьСПовторами) их не тронет - останутся дефолтами отсюда.
	// БалансРуб дефолтится в Неопределено (НЕ 0!) - см. ar_LLMКонтракт.НовыйОтвет.
	Результат.Вставить("БалансРуб", Неопределено);
	Результат.Вставить("БалансНизкий", Ложь);
	Возврат Результат;
КонецФункции

// Формирует пустой результат диспетчера со всеми обязательными ключами.
// Реализована через композицию: берёт 6 ключей провайдерского контракта
// из НовыйРезультатПровайдера() и добавляет 2 поля диспетчера
// (ПровайдерИтог, ПопытокСделано). Так устраняется дублирование набора
// ключей и риск рассинхронизации при будущих изменениях контракта.
//
// Возвращаемое значение:
//   Структура - провайдерский контракт + {ПровайдерИтог="", ПопытокСделано=0}.
//
Функция НовыйРезультат()
	Результат = НовыйРезультатПровайдера();
	Результат.Вставить("ПровайдерИтог", "");
	Результат.Вставить("ПопытокСделано", 0);
	Возврат Результат;
КонецФункции

// Пишет событие диспетчера в журнал регистрации (уровень Предупреждение).
// Логируются ТОЛЬКО метаданные операции: имя провайдера, попытка, задержка,
// КодСостояния, флаг транзиентности. Тела сообщений (PII) и любой
// пользовательский ввод в журнал не попадают — диспетчер их сюда не передаёт.
//
// Параметры:
//   Подсобытие - Строка - "Retry" | "Fallback" | "FallbackПровален".
//   Текст      - Строка - текст события без чувствительных данных.
//
Процедура ЛогироватьСобытие(Подсобытие, Текст)

	ИмяСобытия = НСтр("ru = 'ar_LLMДиспетчер.'; en = 'ar_LLMДиспетчер.'") + Подсобытие;

	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Предупреждение,
		Метаданные.ОбщиеМодули.ar_LLMДиспетчер,
		,
		Текст);

КонецПроцедуры

#КонецОбласти
