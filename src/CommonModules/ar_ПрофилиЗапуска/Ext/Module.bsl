////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПрофилиЗапуска (CONS-01).
//
// Справочник ar_ПрофилиЗапуска: один агент - несколько профилей (например,
// «Дебиторка - Ромашка» и «Дебиторка - Василёк»), каждый со своим списком
// ответственных (ТЧ ar_Ответственные) и своей областью данных (ТЧ
// ar_ОбластьДанных), без клонирования агента.
//
// Три обязанности модуля (спека CONS-01):
//  1. Чтение профиля - ПрофилиАгента/ПолучитьПрофиль.
//  2. Вычисление области данных - ЭффективнаяОбластьДанных (правила из ТЧ или
//     данных формы) + ТекстоваяРасшифровка для формы.
//  3. Определение ответственных - Ответственные.
//
// Логика применения allow/deny для ar_ОбластьДанных НЕ переписана заново -
// используется предметно-нейтральное ядро ar_ПравилаAllowDeny (то же ядро,
// на которое опирается и ar_ToolAccessRules, SCALE-07). См. DoD D4.
//
// ВАЖНО (спека CONS-01, «Три обязательных сценария», отличие от tools): у
// tools «база = весь реестр» - конечное перечислимое множество, поэтому
// «всё» реализуемо перебором кандидатов. У области данных «всё» - это
// ОТСУТСТВИЕ ограничения (не «перечислить все организации», а «фильтр по
// организации не применяется вообще»). Поэтому ЭффективнаяОбластьДанных не
// сводит результат к одному "эффективному набору строк", а возвращает
// структуру, различающую три состояния: без ограничений / allow-список /
// deny-список (ar_ПравилаAllowDeny.КлассификацияПравил).
//
// Эта задача (CONS-01) НЕ подключает профиль к рантайму (ar_Запуски.
// ar_ПрофильЗапуска, подмешивание в контекст, выбор в ar_Рутины - CONS-02) и
// НЕ шлёт уведомления (CONS-12).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Запрещено: Выполнить(), Вычислить().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обязанность 1 (чтение профиля). Возвращает список активных профилей
// заданного агента - как для отбора в CONS-02, так и для UI, которому нужно
// показать все профили агента.
//
// Параметры:
//  СсылкаАгент - СправочникСсылка.ar_Агенты - агент, чьи профили ищем.
//  ТолькоАктивные - Булево - Истина (по умолчанию) - отфильтровать по ar_Активен = Истина.
//
// Возвращаемое значение:
//  Массив - СправочникСсылка.ar_ПрофилиЗапуска, может быть пустым.
//
Функция ПрофилиАгента(Знач СсылкаАгент, Знач ТолькоАктивные = Истина) Экспорт

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(СсылкаАгент) Тогда
		Возврат Результат;
	КонецЕсли;

	// Запрос всегда читает все (не помеченные на удаление) профили агента, без
	// ИЛИ в секции ГДЕ (BSL LS: LogicalOrInTheWhereSectionOfQuery мешает
	// использованию индекса) - фильтр по ar_Активен применяется в памяти, т.к.
	// профилей у одного агента - единицы (спека: "несколько профилей", не
	// массовая таблица).
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", СсылкаАгент);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Профили.Ссылка КАК Ссылка,
		|	Профили.ar_Активен КАК ar_Активен
		|ИЗ
		|	Справочник.ar_ПрофилиЗапуска КАК Профили
		|ГДЕ
		|	Профили.ar_Агент = &Агент
		|	И НЕ Профили.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Профили.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТолькоАктивные И Не Выборка.ar_Активен Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обязанность 2 (вычисление области данных), серверный вызов, читающий уже
// ЗАПИСАННЫЙ профиль из базы. Для формы ДО записи объекта используйте
// ЭффективнаяОбластьДанныхПоТаблице - расшифровка должна быть актуальной ещё
// до сохранения (спека CONS-01, «Текстовая расшифровка»).
//
// Параметры:
//  СсылкаПрофиль - СправочникСсылка.ar_ПрофилиЗапуска - записанный профиль.
//
// Возвращаемое значение:
//  Соответствие - Ключ: ar_Параметр (Строка), Значение: см. ar_ПравилаAllowDeny.КлассификацияПравил.
//
Функция ЭффективнаяОбластьДанных(Знач СсылкаПрофиль) Экспорт

	ТаблицаПравил = ПрочитатьОбластьДанных(СсылкаПрофиль);
	Возврат ЭффективнаяОбластьДанныхПоТаблице(ТаблицаПравил);

КонецФункции

// Обязанность 2 (вычисление области данных) по данным ТЧ формы, БЕЗ обращения
// к базе - работает и для ещё не записанного объекта (спека CONS-01,
// «Текстовая расшифровка... логика расшифровки должна уметь работать с
// данными формы, а не только с сохранённым объектом»).
//
// Параметры:
//  ТаблицаПравил - ТаблицаЗначений - строки ar_Параметр/ar_Значение/ar_Разрешить, обычно Объект.ar_ОбластьДанных.
//
// Возвращаемое значение:
//  Соответствие - см. ЭффективнаяОбластьДанных.
//
Функция ЭффективнаяОбластьДанныхПоТаблице(Знач ТаблицаПравил) Экспорт

	ПравилаПоПараметру = СгруппироватьПоПараметру(ТаблицаПравил);

	Результат = Новый Соответствие;
	Для Каждого КлючЗначение Из ПравилаПоПараметру Цикл
		Результат.Вставить(КлючЗначение.Ключ, ar_ПравилаAllowDeny.КлассификацияПравил(КлючЗначение.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет одно фактическое значение параметра против правил профиля -
// потребитель CONS-02 (подключение к рантайму) будет вызывать по одному
// значению за раз ("разрешено ли агенту работать с этой организацией").
// В CONS-01 не используется формой, но входит в контракт модуля как часть
// обязанности 2 (спека, «Общий модуль ar_ПрофилиЗапуска», п.2).
//
// Параметры:
//  СсылкаПрофиль - СправочникСсылка.ar_ПрофилиЗапуска - записанный профиль.
//  ИмяПараметра - Строка - например, "Организация".
//  ФактическоеЗначение - Строка - сравнимое представление значения.
//
// Возвращаемое значение:
//  Булево - Истина, если значение разрешено (в т.ч. когда правил по параметру нет вовсе).
//
Функция ЗначениеРазрешеноПрофилем(Знач СсылкаПрофиль, Знач ИмяПараметра, Знач ФактическоеЗначение) Экспорт

	ТаблицаПравил = ПрочитатьОбластьДанных(СсылкаПрофиль);
	ПравилаПоПараметру = СгруппироватьПоПараметру(ТаблицаПравил);

	ИмяПараметра = СокрЛП(ИмяПараметра);
	ПравилаПараметра = ПравилаПоПараметру.Получить(ИмяПараметра);

	Если ПравилаПараметра = Неопределено Или ПравилаПараметра.Количество() = 0 Тогда
		Возврат Истина; // Правил по параметру нет вовсе - фильтр не применяется (спека, "пусто = всё").
	КонецЕсли;

	Возврат ar_ПравилаAllowDeny.ЭтоРазрешеноПоПравилам(ФактическоеЗначение, ПравилаПараметра);

КонецФункции

// Обязанность 2 (расшифровка). Строит текст, понятный пользователю без
// знания механизма правил, по образцу из задачи: «работает по всем
// организациям, кроме: Ромашка, Василёк» / «работает только по: Ромашка» /
// «работает без ограничений по данным». Группировка - по параметру, каждый
// параметр - отдельная строка (спека CONS-01, «Текстовая расшифровка»).
//
// Параметры:
//  ТаблицаПравил - ТаблицаЗначений - см. ЭффективнаяОбластьДанныхПоТаблице.
//
// Возвращаемое значение:
//  Строка - многострочный текст, одна строка на параметр, либо текст по умолчанию при отсутствии правил.
//
Функция ТекстоваяРасшифровкаПоТаблице(Знач ТаблицаПравил) Экспорт

	ПравилаПоПараметру = СгруппироватьПоПараметру(ТаблицаПравил);

	Если ПравилаПоПараметру.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Работает без ограничений по данным.'; en = 'Works without data restrictions.'");
	КонецЕсли;

	// Соответствие не гарантирует порядок обхода - сортируем имена параметров
	// через ТаблицаЗначений.Сортировать() для детерминированного вывода
	// (одинаковый текст между вызовами) - тот же приём, что и в
	// ar_ToolAccessRules.ЭффективныйНаборTools (Результат.Сортировать("ИмяTool")).
	ТаблицаИмён = Новый ТаблицаЗначений;
	ТаблицаИмён.Колонки.Добавить("ИмяПараметра");
	Для Каждого КлючЗначение Из ПравилаПоПараметру Цикл
		ТаблицаИмён.Добавить().ИмяПараметра = КлючЗначение.Ключ;
	КонецЦикла;
	ТаблицаИмён.Сортировать("ИмяПараметра");

	Строки = Новый Массив;
	Для Каждого СтрокаИмени Из ТаблицаИмён Цикл
		ИмяПараметра = СтрокаИмени.ИмяПараметра;
		Классификация = ar_ПравилаAllowDeny.КлассификацияПравил(ПравилаПоПараметру.Получить(ИмяПараметра));
		Строки.Добавить(ИмяПараметра + ": " + СтрокаКлассификации(Классификация));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Обязанность 3 (определение ответственных). Выборка ТЧ ar_Ответственные
// профиля, с необязательным фильтром по роли.
//
// Параметры:
//  СсылкаПрофиль - СправочникСсылка.ar_ПрофилиЗапуска - профиль, чьих ответственных ищем.
//  Роль - ПеречислениеСсылка.ar_РольОтветственного - Неопределено (по умолчанию) - без фильтра.
//
// Возвращаемое значение:
//  Массив - Структуры {Пользователь, Роль, Email}, Email - ar_Email строки либо пустая строка.
//
Функция Ответственные(Знач СсылкаПрофиль, Знач Роль = Неопределено) Экспорт

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(СсылкаПрофиль) Тогда
		Возврат Результат;
	КонецЕсли;

	// Фильтр по роли применяется в самом запросе (два варианта текста запроса
	// в зависимости от того, задана ли Роль), а не в цикле по выборке -
	// избегает и лишнего чтения непрофильных строк, и ИЛИ в секции ГДЕ
	// (BSL LS: LogicalOrInTheWhereSectionOfQuery), которое дал бы единый текст
	// с условием "&Роль = Неопределено ИЛИ Ответственные.ar_Роль = &Роль".
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Профиль", СсылкаПрофиль);
	Если Роль = Неопределено Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Ответственные.ar_Пользователь КАК Пользователь,
			|	Ответственные.ar_Роль КАК Роль,
			|	Ответственные.ar_Email КАК Email
			|ИЗ
			|	Справочник.ar_ПрофилиЗапуска.ar_Ответственные КАК Ответственные
			|ГДЕ
			|	Ответственные.Ссылка = &Профиль";
	Иначе
		Запрос.УстановитьПараметр("Роль", Роль);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Ответственные.ar_Пользователь КАК Пользователь,
			|	Ответственные.ar_Роль КАК Роль,
			|	Ответственные.ar_Email КАК Email
			|ИЗ
			|	Справочник.ar_ПрофилиЗапуска.ar_Ответственные КАК Ответственные
			|ГДЕ
			|	Ответственные.Ссылка = &Профиль
			|	И Ответственные.ar_Роль = &Роль";
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОтветственного = Новый Структура;
		СтрокаОтветственного.Вставить("Пользователь", Выборка.Пользователь);
		СтрокаОтветственного.Вставить("Роль", Выборка.Роль);
		СтрокаОтветственного.Вставить("Email", СокрЛП(Строка(Выборка.Email)));
		Результат.Добавить(СтрокаОтветственного);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Читает ТЧ ar_ОбластьДанных записанного профиля. Экспортная (CONS-02): единый
// источник сырых строк правил для ТекстоваяРасшифровкаПоТаблице - без этого
// подмешивание факта области данных в системный промпт (ar_RuntimeЦикл) либо
// дублировало бы тот же запрос вторым местом, либо использовало
// несогласованный с формой профиля способ показа правил (см. спеку CONS-02,
// «Точные контракты», нестыковка ЭффективнаяОбластьДанных/
// ТекстоваяРасшифровкаПоТаблице). Тело функции не менялось при переносе.
//
// Параметры:
//  СсылкаПрофиль - СправочникСсылка.ar_ПрофилиЗапуска - записанный профиль.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ar_Параметр/ar_Значение/ar_Разрешить, упорядочена по ar_Порядок.
//
Функция ПрочитатьОбластьДанных(СсылкаПрофиль) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Профиль", СсылкаПрофиль);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Область.ar_Параметр КАК ar_Параметр,
		|	Область.ar_Значение КАК ar_Значение,
		|	Область.ar_Разрешить КАК ar_Разрешить
		|ИЗ
		|	Справочник.ar_ПрофилиЗапуска.ar_ОбластьДанных КАК Область
		|ГДЕ
		|	Область.Ссылка = &Профиль
		|УПОРЯДОЧИТЬ ПО
		|	Область.ar_Порядок,
		|	Область.НомерСтроки";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Группирует строки правил по имени параметра. ТаблицаПравил - ТаблицаЗначений
// либо Массив Структур с полями ar_Параметр/ar_Значение/ar_Разрешить (оба
// варианта используются вызывающим кодом - запрос к базе и реквизит формы
// возвращают ТаблицаЗначений, тестовые вызовы могут передать Массив Структур).
//
// Возвращаемое значение:
//  Соответствие - Ключ: ar_Параметр (Строка), Значение: Массив Структур {Значение, Разрешить}.
//
Функция СгруппироватьПоПараметру(ТаблицаПравил)

	Результат = Новый Соответствие;

	Для Каждого СтрокаПравила Из ТаблицаПравил Цикл
		ИмяПараметра = СокрЛП(СтрокаПравила.ar_Параметр);
		Если ПустаяСтрока(ИмяПараметра) Тогда
			Продолжить; // Незаполненный параметр - строка не относится ни к какому измерению.
		КонецЕсли;

		СписокПравил = Результат.Получить(ИмяПараметра);
		Если СписокПравил = Неопределено Тогда
			СписокПравил = Новый Массив;
			Результат.Вставить(ИмяПараметра, СписокПравил);
		КонецЕсли;

		Правило = Новый Структура;
		Правило.Вставить("Значение", СокрЛП(СтрокаПравила.ar_Значение));
		Правило.Вставить("Разрешить", СтрокаПравила.ar_Разрешить = Истина);
		СписокПравил.Добавить(Правило);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строит фразу для одного параметра по его классификации
// (ar_ПравилаAllowDeny.КлассификацияПравил).
//
Функция СтрокаКлассификации(Классификация)

	Если Классификация.Состояние = ar_ПравилаAllowDeny.СостояниеБезОграничений() Тогда
		Возврат НСтр("ru = 'без ограничений'; en = 'no restrictions'");
	ИначеЕсли Классификация.Состояние = ar_ПравилаAllowDeny.СостояниеТолькоРазрешённые() Тогда
		// Граничный случай, симметричный "ВсеКромеЗапрещённых" ниже: все
		// allow-значения совпали с deny на то же значение (deny всегда
		// побеждает - ar_ПравилаAllowDeny.КлассификацияПравил уже вычитает их
		// из СписокРазрешить), поэтому эффективно разрешённых значений не
		// осталось - "ничего не разрешено", а не пустой список после
		// двоеточия (замечание оркестратора CONS-01 итерация 3, п.4).
		Если Классификация.СписокРазрешить.Количество() = 0 Тогда
			Возврат НСтр("ru = 'работает только по: (нет разрешённых значений — всё запрещено)'; en = 'works only for: (nothing allowed — all denied)'");
		КонецЕсли;
		Возврат НСтр("ru = 'работает только по:'; en = 'works only for:'")
			+ " " + СтрСоединить(Классификация.СписокРазрешить, ", ");
	Иначе // ar_ПравилаAllowDeny.СостояниеВсеКромеЗапрещённых()
		// Граничный случай: все deny-строки параметра имели пустую ar_Значение
		// (мусор в ТЧ, спека "Граничные случаи") - список пуст, хотя правила
		// формально есть. Показываем "без ограничений", т.к. эффективно ни
		// одно правило не сработало (эффект идентичен их отсутствию).
		Если Классификация.СписокЗапретить.Количество() = 0 Тогда
			Возврат НСтр("ru = 'без ограничений'; en = 'no restrictions'");
		КонецЕсли;
		Возврат НСтр("ru = 'работает по всем, кроме:'; en = 'works for all except:'")
			+ " " + СтрСоединить(Классификация.СписокЗапретить, ", ");
	КонецЕсли;

КонецФункции

#КонецОбласти
