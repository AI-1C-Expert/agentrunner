// Общий модуль ar_ToolCRM (aos Tool CRM).
//
// Tool-слой домена CRM. На этапе 0 содержит единственную read-only функцию
// search_clients — поиск контрагентов по строке (наименование, ИНН, КПП).
// Шаблон, по которому будут строиться остальные domain-tools.
//
// Контракт tool-функции:
//   Вход:  АргументыJSON (Строка) — JSON-объект аргументов от LLM
//          КонтекстЗапуска (Структура) — контекст запуска (ИДЗапуска, DryRun, ...)
//   Выход: Строка JSON — observation для добавления в контекст как role:tool.
//
// Контракт DryRun (DISP-03):
//   Каждая mutating-функция (RiskLevel = Draft/Write/Commit), например
//   ОбновитьКонтактКлиента, ОБЯЗАНА:
//   1. Вызвать ar_ToolDispatcher.ИзвлечьDryRun(Аргументы).
//   2. При Истина — вернуть ar_ToolDispatcher.СформироватьDryRunJSON(...) вида
//      {"dry_run": true, "tool": "<имя>", "simulated": {...}} БЕЗ записи в данные ИБ.
//   Read-only функции (ПоискКлиентов / search_clients) DryRun игнорируют —
//   флаг не влияет на результат, чтение данных в dry-run безопасно и ожидаемо.
//
// Контракт IdempotencyKey (DISP-04):
//   Каждая commit-функция (RiskLevel = Commit) с ТребуетApproval = Истина:
//   1. Получает _idempotency_key из аргументов (через
//      ar_ToolDispatcher.ИзвлечьIdempotencyKey или прямым разбором JSON).
//   2. После успешного выполнения действия вызывает
//      ar_ToolDispatcher.ПометитьApprovalВыполненным(_idempotency_key, РезультатJSON) —
//      запись очереди переходит в executed, результат кэшируется.
//   3. Диспетчер сам проверяет наличие кэша до вызова (НайтиПредыдущийРезультат) —
//      дублирующая проверка в tool не обязательна, но допускается (defence-in-depth).
//
// Свойства модуля: Сервер, без вызова с клиента, без привилегированного режима.
// См. спеку: .docs/specs/TOOL-01.md, Plan §5 этап 0, §2.8, §1.3.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Tool search_clients: поиск контрагентов по строковому запросу.
//
// RiskLevel = Read: read-only, DryRun не влияет на результат (флаг _dry_run не
// проверяется — чтение данных в dry-run безопасно, DISP-03).
//
// Параметры:
//   АргументыJSON   - Строка    - JSON-объект вида {"query": "...", "limit": 10}.
//   КонтекстЗапуска - Структура - контекст запуска (ИДЗапуска, DryRun, ...).
//                                 Может быть Неопределено.
//
// Возвращаемое значение:
//   Строка - JSON вида:
//     {"items":[{"ref":"...","name":"...","full_name":"...","inn":"...",
//                "kpp":"...","is_individual":false}, ...],
//      "total_found": <N>}
//   либо при ошибке:
//     {"error":"...", "items":[]}
//
Функция ПоискКлиентов(Знач АргументыJSON, Знач КонтекстЗапуска = Неопределено) Экспорт

	// 1. Десериализация аргументов.
	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат СформироватьОшибку("invalid json arguments");
	КонецЕсли;

	// 2. Валидация query.
	СтрокаПоиска = ПолучитьЗначениеИзКоллекции(Аргументы, "query", "");

	Если ТипЗнч(СтрокаПоиска) <> Тип("Строка") Или ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат СформироватьОшибку("query is required");
	КонецЕсли;

	// Обрезка длины.
	ПредупреждениеПоЗапросу = "";
	Если СтрДлина(СтрокаПоиска) > 500 Тогда
		СтрокаПоиска = Лев(СтрокаПоиска, 500);
		ПредупреждениеПоЗапросу = "query truncated to 500 chars";
	КонецЕсли;

	// 3. Валидация limit.
	Лимит = 10;
	ЗначениеЛимит = ПолучитьЗначениеИзКоллекции(Аргументы, "limit", Неопределено);
	Если ТипЗнч(ЗначениеЛимит) = Тип("Число") Тогда
		ЦелыйЛимит = Цел(ЗначениеЛимит);
		Если ЦелыйЛимит >= 1 И ЦелыйЛимит <= 50 Тогда
			Лимит = ЦелыйЛимит;
		КонецЕсли;
	КонецЕсли;

	// 4. Проверка существования справочника Контрагенты.
	МДКонтрагенты = Метаданные.Справочники.Найти(
		ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты"));
	Если МДКонтрагенты = Неопределено Тогда
		Возврат СформироватьОшибку("Контрагенты not found in metadata");
	КонецЕсли;

	// 5. Определение состава реквизитов (graceful fallback).
	ЕстьПолноеНаименование = (МДКонтрагенты.Реквизиты.Найти("НаименованиеПолное") <> Неопределено);
	ЕстьИНН = (МДКонтрагенты.Реквизиты.Найти("ИНН") <> Неопределено);
	ЕстьКПП = (МДКонтрагенты.Реквизиты.Найти("КПП") <> Неопределено);
	ЕстьЮрФизЛицо = (МДКонтрагенты.Реквизиты.Найти("ЮридическоеФизическоеЛицо") <> Неопределено);

	// 6. Выполнение запроса.
	Попытка
		ВыборкаДанных = ВыполнитьЗапросКонтрагентов(
			СтрокаПоиска, Лимит, ЕстьПолноеНаименование, ЕстьИНН, ЕстьКПП, ЕстьЮрФизЛицо);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат СформироватьОшибку("query_failed: " + ar_Утилиты.ОчиститьОшибкуДляLLM(ТекстОшибки));
	КонецПопытки;

	// 7. Сериализация результата.
	Возврат СериализоватьРезультат(ВыборкаДанных, ЕстьПолноеНаименование, ЕстьИНН, ЕстьКПП,
		ЕстьЮрФизЛицо, ПредупреждениеПоЗапросу);

КонецФункции

// Tool update_client_contact: обновить контактные данные контрагента.
//
// RiskLevel = Draft, ТребуетApproval = Истина. Этап 1 (TOOL-04) — read-only
// обёртка: tool валидирует аргументы, разыменовывает контрагента, читает текущие
// контакты и формирует proposed_changes — но НИЧЕГО не записывает в данные ИБ.
// Фактическая запись будет реализована в этапе 2 (TOOL-08), когда появится
// полноценный write-flow и approval-очередь (APPR-01).
//
// Контракт DryRun (DISP-03): при _dry_run = Истина возвращается
// ar_ToolDispatcher.СформироватьDryRunJSON(...) без чтения/записи данных.
//
// Привилегированного режима НЕ использует: выполняется в правах пользователя
// сессии, чтобы RLS целевой конфигурации работал естественно (Plan §2.8, §3.1).
//
// Параметры:
//   АргументыJSON   - Строка    - JSON-объект вида
//                                 {"client_ref":"...","phone":"...","email":"...",
//                                  "contact_person":"...","comment":"..."}.
//   КонтекстЗапуска - Структура - контекст запуска. Может быть Неопределено.
//
// Возвращаемое значение:
//   Строка - JSON-observation. При успехе:
//     {"dry_run_only":true,"client_ref":"...","client_name":"...",
//      "proposed_changes":{...},"current_values":{...},"note":"..."}.
//   При ошибке: {"error":"<код>"}.
//
Функция ОбновитьКонтактКлиента(Знач АргументыJSON, Знач КонтекстЗапуска = Неопределено) Экспорт

	Попытка
		Возврат ОбновитьКонтактКлиентаВнутр(АргументыJSON);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат СформироватьОшибкуПростую("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

// Идемпотентно создаёт/обновляет записи реестра ar_Tools для tools домена CRM
// (search_clients, update_client_contact). Безопасно вызывать повторно: запись
// ищется по реквизиту ar_Имя, при наличии — обновляется, иначе — создаётся.
//
// Привилегированный режим: запись в справочник ar_Tools требует прав; реестр —
// служебная инфраструктура AgentRunner, заполняемая при разворачивании/обновлении
// расширения. Поднятие привилегий локальное, с парным сбросом (Plan §1.3).
//
// Возвращаемое значение:
//   Структура { Создано - Число, Обновлено - Число } — статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинTool(ОписаниеToolПоискКлиентов(), Статистика);
		ЗарегистрироватьОдинTool(ОписаниеToolОбновитьКонтакт(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеКонтакта

// Основная логика update_client_contact (этап 1, read-only обёртка).
// Выделена из ОбновитьКонтактКлиента, чтобы внешний Попытка/Исключение ловил
// любые непредвиденные ошибки и очищал текст для LLM (DoD D7).
//
Функция ОбновитьКонтактКлиентаВнутр(Знач АргументыJSON)

	// 1. DryRun (DISP-03): при Истина — симулированный ответ без чтения данных.
	Если ar_ToolDispatcher.ИзвлечьDryRun(АргументыJSON) Тогда
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("update_client_contact", Неопределено);
	КонецЕсли;

	// 2. Десериализация аргументов.
	Аргументы = ДесериализоватьАргументы(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат СформироватьОшибкуПростую("invalid json arguments");
	КонецЕсли;

	// 3. Валидация client_ref.
	СтрокаСсылки = СокрЛП(Строка(ПолучитьЗначениеИзКоллекции(Аргументы, "client_ref", "")));
	Если ПустаяСтрока(СтрокаСсылки) Тогда
		Возврат СформироватьОшибкуПростую("client_ref is required");
	КонецЕсли;

	// 4. Нормализация предлагаемых значений (хотя бы одно обязательно).
	ПредлагаемыеЗначения = НормализоватьПредложения(Аргументы);
	Если ПредлагаемыеЗначения.proposed_changes.Количество() = 0 Тогда
		Возврат СформироватьОшибкуПростую("no_changes_specified");
	КонецЕсли;

	// 5. Разыменование контрагента (навигационная ссылка или UUID).
	РезультатСсылки = ПолучитьСсылкуКонтрагента(СтрокаСсылки);
	Если РезультатСсылки.Ошибка <> "" Тогда
		Возврат СформироватьОшибкуПростую(РезультатСсылки.Ошибка);
	КонецЕсли;
	СсылкаКонтрагента = РезультатСсылки.Ссылка;

	// 6. Чтение реквизитов контрагента в правах пользователя (access_denied — обработать).
	Попытка
		ДанныеШапки = ПрочитатьШапкуКонтрагента(СсылкаКонтрагента);
	Исключение
		Возврат СформироватьОшибкуПростую("access_denied");
	КонецПопытки;

	// 7. Текущие значения контактной информации (graceful, без жёсткой зависимости от БСП).
	ТекущиеКонтакты = ПолучитьТекущиеКонтакты(СсылкаКонтрагента);

	// 8. Сборка ответа.
	Результат = Новый Структура;
	Результат.Вставить("dry_run_only", Истина);
	Результат.Вставить("client_ref", ПолучитьНавигационнуюСсылку(СсылкаКонтрагента));
	Результат.Вставить("client_name", ДанныеШапки.Наименование);
	Результат.Вставить("proposed_changes", ПредлагаемыеЗначения.proposed_changes);
	Результат.Вставить("current_values", ТекущиеКонтакты.current_values);

	// Предупреждения по полям (email/phone) — на уровень ответа.
	Для Каждого КлючЗначение Из ПредлагаемыеЗначения.warnings Цикл
		Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

	Если ТекущиеКонтакты.Свойство("contact_info_unavailable") Тогда
		Результат.Вставить("contact_info_unavailable", Истина);
	КонецЕсли;

	Если ДанныеШапки.ПометкаУдаления Тогда
		Результат.Вставить("deleted", Истина);
	КонецЕсли;

	Результат.Вставить("note", "Изменения не применены. Этап 1: update_client_contact —"
		+ " read-only wrapper. Фактическая запись доступна в этапе 2.");

	Возврат СтруктуруВJSON(Результат);

КонецФункции

// Нормализует предлагаемые изменения из аргументов tool.
// Возвращает Структуру { proposed_changes - Структура (только заполненные поля),
//                        warnings - Структура (email_warning / phone_warning) }.
//
Функция НормализоватьПредложения(Знач Аргументы)

	Предложения = Новый Структура;
	Предупреждения = Новый Структура;

	// phone
	Телефон = ЗначениеСтрокойИлиПусто(ПолучитьЗначениеИзКоллекции(Аргументы, "phone", Неопределено));
	Если Телефон <> Неопределено Тогда
		Если СтрДлина(Телефон) > 50 Тогда
			Телефон = Лев(Телефон, 50);
			Предупреждения.Вставить("phone_warning", "truncated");
		КонецЕсли;
		Предложения.Вставить("phone", Телефон);
	КонецЕсли;

	// email
	Email = ЗначениеСтрокойИлиПусто(ПолучитьЗначениеИзКоллекции(Аргументы, "email", Неопределено));
	Если Email <> Неопределено Тогда
		Если СтрНайти(Email, "@") = 0 Тогда
			Предупреждения.Вставить("email_warning", "invalid format");
		КонецЕсли;
		Предложения.Вставить("email", Email);
	КонецЕсли;

	// contact_person
	КонтактноеЛицо = ЗначениеСтрокойИлиПусто(
		ПолучитьЗначениеИзКоллекции(Аргументы, "contact_person", Неопределено));
	Если КонтактноеЛицо <> Неопределено Тогда
		Предложения.Вставить("contact_person", КонтактноеЛицо);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("proposed_changes", Предложения);
	Результат.Вставить("warnings", Предупреждения);
	Возврат Результат;

КонецФункции

// Приводит значение к непустой строке либо Неопределено (если пусто/не строка).
Функция ЗначениеСтрокойИлиПусто(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Очищенное = СокрЛП(Значение);
	Возврат ?(ПустаяСтрока(Очищенное), Неопределено, Очищенное);
КонецФункции

// Разыменовывает контрагента по client_ref: навигационная ссылка (e1cib/...)
// или «голый» UUID. Возвращает Структуру { Ссылка, Ошибка }.
// Ошибка непустая → client_not_found (без исключения, DoD D4).
//
Функция ПолучитьСсылкуКонтрагента(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	// Имя объекта метаданных - с учётом переопределения (ar_ПереопределенияОбъектов,
	// см. ar_ToolDispatcher.ИмяОбъектаМетаданных). Тип("СправочникСсылка."+ИмяРеальное)
	// и Справочники[ИмяРеальное] вместо статической точечной нотации
	// Тип("СправочникСсылка.Контрагенты")/Справочники.Контрагенты - последние жёстко
	// ссылаются на конкретный объект метаданных и не работают для целевой
	// конфигурации, где справочник называется иначе (например "_ДемоКонтрагенты").
	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");

	МДКонтрагенты = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДКонтрагенты = Неопределено Тогда
		Результат.Ошибка = "Контрагенты not found in metadata";
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("СправочникСсылка." + ИмяРеальное);

	Ссылка = Неопределено;

	// Вариант 1: навигационная ссылка e1cib/...
	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Ссылка = ИзвлечьСсылкуИзРезультатаНавигации(
			ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки), ТипСсылки);
	КонецЕсли;

	// Вариант 2: «голый» UUID.
	Если Ссылка = Неопределено Тогда
		УникИдент = ПопробоватьUUID(СтрокаСсылки);
		Если УникИдент <> Неопределено Тогда
			КандидатСсылка = Справочники[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если ОбъектСуществует(КандидатСсылка) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Ссылка = Неопределено
		Или ТипЗнч(Ссылка) <> ТипСсылки
		Или Не ОбъектСуществует(Ссылка) Тогда
		Результат.Ошибка = "client_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

// Приводит результат ar_Утилиты.ОбъектИзНавигационнойСсылки к ссылке Контрагента.
// Метод может вернуть СправочникСсылку или Неопределено.
//
// Параметры:
//  Значение   - Произвольный - результат навигации (ссылка или объект).
//  ТипСсылки  - Тип - ожидаемый тип ссылки (динамический, см. ПолучитьСсылкуКонтрагента).
//
Функция ИзвлечьСсылкуИзРезультатаНавигации(Знач Значение, Знач ТипСсылки)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = ТипСсылки Тогда
		Возврат Значение;
	КонецЕсли;
	// Объект → его ссылка (через реквизит Ссылка), но только если это Контрагент.
	Попытка
		КандидатСсылка = Значение.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(КандидатСсылка) = ТипСсылки, КандидатСсылка, Неопределено);
КонецФункции

// Безопасно разбирает строку как УникальныйИдентификатор. Неопределено при ошибке.
Функция ПопробоватьUUID(Знач Строка)
	Попытка
		Возврат Новый УникальныйИдентификатор(Строка);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Проверяет существование объекта справочника по ссылке (быстрый запрос).
Функция ОбъектСуществует(Знач Ссылка)
	Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	" + ИмяТаблицыКонтрагенты() + " КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Читает наименование и пометку удаления контрагента (в правах пользователя).
Функция ПрочитатьШапкуКонтрагента(Знач Ссылка)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	" + ИмяТаблицыКонтрагенты() + " КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Данные = Новый Структура("Наименование, ПометкаУдаления", "", Ложь);
	Если Выборка.Следующий() Тогда
		Данные.Наименование = Строка(Выборка.Наименование);
		Данные.ПометкаУдаления = (Выборка.ПометкаУдаления = Истина);
	КонецЕсли;
	Возврат Данные;
КонецФункции

// Читает текущие значения контактной информации контрагента.
// Алгоритм (graceful): подсистема БСП КИ → прямые реквизиты → null-ы.
// Возвращает Структуру { current_values - Структура,
//                        [contact_info_unavailable - Истина] }.
//
// PII-03: ключ "address" заполняется только через путь БСП КИ
// (ПрочитатьКИЧерезБСП) — fallback-путь ПрочитатьКИИзРеквизитов не читает
// адрес (в справочнике Контрагенты адрес как обычный реквизит не
// рассматривается этим тикетом, см. .docs/specs/PII-03.md, «Риски»).
//
Функция ПолучитьТекущиеКонтакты(Знач Ссылка)

	Текущие = Новый Структура;
	Текущие.Вставить("phone", Неопределено);
	Текущие.Вставить("email", Неопределено);
	Текущие.Вставить("contact_person", Неопределено);
	Текущие.Вставить("address", Неопределено);

	Найдено = Ложь;

	// 1. Через подсистему БСП «УправлениеКонтактнойИнформацией», если она есть.
	Если Метаданные.ОбщиеМодули.Найти("УправлениеКонтактнойИнформацией") <> Неопределено Тогда
		Найдено = ПрочитатьКИЧерезБСП(Ссылка, Текущие) Или Найдено;
	КонецЕсли;

	// 2. Fallback на прямые реквизиты справочника (Телефон/Email/КонтактноеЛицо).
	Если Не Найдено Тогда
		Найдено = ПрочитатьКИИзРеквизитов(Ссылка, Текущие) Или Найдено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("current_values", Текущие);
	Если Не Найдено Тогда
		Результат.Вставить("contact_info_unavailable", Истина);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Пытается прочитать КИ через публичный метод БСП. Любая ошибка/несовпадение
// сигнатуры → Ложь (без исключения наружу). Заполняет phone/address (и email,
// не маскируется) в Текущие.
//
// PII-03: при ar_Константы.ComplianceРежим() = Истина значения типов
// Телефон и Адрес заменяются целиком на "[REDACTED]" (all-or-nothing — без
// частичного маскирования вроде сохранения кода города/индекса, см.
// .docs/specs/PII-03.md, DoD D7). Флаг ComplianceРежим читается один раз до
// цикла (не в цикле) — по аналогии с РежимCompliance в
// ar_ToolUniversal.ЧтениеОбъекта/УниверсальныйЗапрос.
//
// Если у объекта несколько строк КИ одного вида (например, рабочий и
// мобильный телефон), в Текущие.phone/Текущие.address попадает только
// первое найденное непустое представление (существующее поведение "взять
// первое" не меняется этим тикетом) — оно маскируется так же, как и
// единственное значение; остальные записи того же вида не сериализуются
// вовсе, поэтому дополнительно защищать их не требуется.
//
// Email и КонтактноеЛицо (contact_person) в объём PII-03 не входят — их
// обработка не меняется.
//
// ЗначенияПолей (устаревшее поле таблицы результата КонтактнаяИнформацияОбъекта,
// хранящее внутреннее XML-представление адреса/телефона) этим кодом не
// читается и не сериализуется нигде — используется только Представление.
// Если в будущем появится код, сериализующий ЗначенияПолей (например, для
// более детального ответа), к нему ОБЯЗАТЕЛЬНО должно применяться то же
// маскирование "[REDACTED]" при ComplianceРежим() = Истина.
//
// ar_ToolUniversal (read_object/query) контактную информацию БСП физически
// не видит: РегистрСведений.КонтактнаяИнформация не входит в состав
// МетаданныеОбъекта.Реквизиты/ТабличныеЧасти, по которым идут циклы в
// ar_ToolUniversal — изменения там не требуются (см. .docs/specs/PII-03.md,
// «Что НЕ меняется»).
//
Функция ПрочитатьКИЧерезБСП(Знач Ссылка, Текущие)

	// ВАЖНО: 4-й параметр ТолькоПредставление по умолчанию = Истина, и в этом
	// режиме БСП уходит в ветку обратной совместимости, которая без указанного
	// вида/типа КИ всегда возвращает "" (а не таблицу). Нужны все типы КИ,
	// поэтому тип не задаём, но ТолькоПредставление передаём как Ложь.
	Попытка
		ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Ссылка, Неопределено, Неопределено, Ложь);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если ТипЗнч(ТаблицаКИ) <> Тип("ТаблицаЗначений") Тогда
		Возврат Ложь;
	КонецЕсли;

	ЕстьКолонкаТип = (ТаблицаКИ.Колонки.Найти("Тип") <> Неопределено);
	ЕстьКолонкаПредставление = (ТаблицаКИ.Колонки.Найти("Представление") <> Неопределено);
	Если Не ЕстьКолонкаТип Или Не ЕстьКолонкаПредставление Тогда
		Возврат Ложь;
	КонецЕсли;

	// PII-03 (DoD D4): читаем флаг один раз до цикла, не на каждой итерации.
	РежимCompliance = ar_Константы.ComplianceРежим();

	ЧтоТоНайдено = Ложь;
	Для Каждого СтрокаКИ Из ТаблицаКИ Цикл
		Представление = СокрЛП(Строка(СтрокаКИ.Представление));
		Если ПустаяСтрока(Представление) Тогда
			Продолжить;
		КонецЕсли;
		// Пробелы убираем: представление перечисления - "Адрес электронной почты",
		// без этого подстрока "электроннойпочты" никогда не находится.
		ИмяТипа = СтрЗаменить(НРег(Строка(СтрокаКИ.Тип)), " ", "");

		Если ЗаполнитьПолеКИ(ИмяТипа, Представление, РежимCompliance, Текущие) Тогда
			ЧтоТоНайдено = Истина;
		КонецЕсли;
	КонецЦикла;

	// PII-08: прозрачность — одна сводная запись о факте маскирования КИ
	// (только имена полей, без значений). Ошибка записи не роняет tool.
	Если РежимCompliance И ЧтоТоНайдено Тогда
		ЛогироватьМаскированиеКИ(Текущие);
	КонецЕсли;

	Возврат ЧтоТоНайдено;

КонецФункции

// PII-08: Пишет в ar_СлужебныйЛог сводку по замаскированным полям КИ
// (phone/address заменены на "[REDACTED]" при compliance-режиме).
Процедура ЛогироватьМаскированиеКИ(Знач Текущие)

	Попытка
		ПоляМаскирования = Новый Массив;
		Если Текущие.phone = "[REDACTED]" Тогда
			ПоляМаскирования.Добавить("phone");
		КонецЕсли;
		Если Текущие.address = "[REDACTED]" Тогда
			ПоляМаскирования.Добавить("address");
		КонецЕсли;

		Если ПоляМаскирования.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		ar_СлужебныйЛог.Записать("ar_ToolCRM.ПрочитатьКИЧерезБСП", "pii_masked",
			СтрШаблон(НСтр("ru='Полей замаскировано: %1 (%2)';
			|en='Fields masked: %1 (%2)'"),
			Формат(ПоляМаскирования.Количество(), "ЧГ="),
			СтрСоединить(ПоляМаскирования, ", ")));
	Исключение
		// Прозрачность не должна ломать работу tool -- ошибка только в ЖР.
		ЗаписьЖурналаРегистрации(НСтр("ru='ar_ToolCRM'; en='ar_ToolCRM'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// PII-03: определяет вид КИ по ИмяТипа и заполняет соответствующий ключ Текущие
// (phone/email/address), если он ещё не заполнен (правило "первое найденное" —
// не меняется этим тикетом). Возвращает Истина, если поле было заполнено.
//
Функция ЗаполнитьПолеКИ(Знач ИмяТипа, Знач Представление, Знач РежимCompliance, Текущие)

	Если СтрНайти(ИмяТипа, "телефон") > 0 И Текущие.phone = Неопределено Тогда
		Текущие.phone = ЗначениеКИСМаскированием(Представление, РежимCompliance);
		Возврат Истина;
	ИначеЕсли (СтрНайти(ИмяТипа, "email") > 0 Или СтрНайти(ИмяТипа, "электроннойпочты") > 0)
		И Текущие.email = Неопределено Тогда
		// PII-03: Email вне объёма этого тикета, маскирование не применяется (DoD D6).
		Текущие.email = Представление;
		Возврат Истина;
	ИначеЕсли СтрНайти(ИмяТипа, "адрес") > 0 И Текущие.address = Неопределено Тогда
		Текущие.address = ЗначениеКИСМаскированием(Представление, РежимCompliance);
		Возврат Истина;
	Иначе
		// Прочие виды КИ (факс, веб) в объём PII-03 не входят, продолжают игнорироваться.
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// PII-03: возвращает значение поля КИ (Телефон/Адрес) с учётом compliance-режима.
// All-or-nothing (DoD D7): при РежимCompliance = Истина всё представление целиком
// заменяется на "[REDACTED]" — частичное маскирование (код города, индекс и т.п.)
// не применяется. При Ложь возвращается исходное представление без изменений.
//
Функция ЗначениеКИСМаскированием(Знач Представление, Знач РежимCompliance)
	Возврат ?(РежимCompliance, "[REDACTED]", Представление);
КонецФункции

// Fallback: читает прямые реквизиты справочника Контрагенты (если такие есть).
// Возвращает Истина, если хотя бы один реквизит найден и прочитан.
//
// UNIV-02: имена трёх прямых реквизитов контактной информации разрешаются
// через ar_МаппингМетаданных.ИмяРеквизита (indirection для чтения), с той же
// проверкой наличия в МДКонтрагенты.Реквизиты до включения поля в запрос,
// что и раньше. Срабатывает только когда в конфигурации нет подсистемы БСП
// "Контактная информация" (основной путь чтения, см. выше по модулю).
//
Функция ПрочитатьКИИзРеквизитов(Знач Ссылка, Текущие)

	МДКонтрагенты = Метаданные.Справочники.Найти(
		ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты"));
	Если МДКонтрагенты = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяРеквизитаТелефон = ar_МаппингМетаданных.ИмяРеквизита("client.phone_attribute", "Телефон");
	ИмяРеквизитаEmail = ar_МаппингМетаданных.ИмяРеквизита("client.email_attribute", "Email");
	ИмяРеквизитаКонтактноеЛицо = ar_МаппингМетаданных.ИмяРеквизита(
		"client.contact_person_attribute", "КонтактноеЛицо");

	ЕстьТелефон = (МДКонтрагенты.Реквизиты.Найти(ИмяРеквизитаТелефон) <> Неопределено);
	ЕстьEmail = (МДКонтрагенты.Реквизиты.Найти(ИмяРеквизитаEmail) <> Неопределено);
	ЕстьКонтактноеЛицо = (МДКонтрагенты.Реквизиты.Найти(ИмяРеквизитаКонтактноеЛицо) <> Неопределено);

	Если Не ЕстьТелефон И Не ЕстьEmail И Не ЕстьКонтактноеЛицо Тогда
		Возврат Ложь;
	КонецЕсли;

	// Алиасы результата выборки (Телефон/Email/КонтактноеЛицо) остаются
	// фиксированными, динамическим маппингом (UNIV-02) охвачено только имя
	// исходного реквизита в источнике - обращение к Выборка.<Алиас> ниже
	// не меняется.
	ПоляВыборки = "";
	Если ЕстьТелефон Тогда
		ПоляВыборки = ПоляВыборки + ?(ПустаяСтрока(ПоляВыборки), "", ",")
			+ " Контрагенты." + ИмяРеквизитаТелефон + " КАК Телефон";
	КонецЕсли;
	Если ЕстьEmail Тогда
		ПоляВыборки = ПоляВыборки + ?(ПустаяСтрока(ПоляВыборки), "", ",")
			+ " Контрагенты." + ИмяРеквизитаEmail + " КАК Email";
	КонецЕсли;
	Если ЕстьКонтактноеЛицо Тогда
		ПоляВыборки = ПоляВыборки + ?(ПустаяСтрока(ПоляВыборки), "", ",")
			+ " Контрагенты." + ИмяРеквизитаКонтактноеЛицо + " КАК КонтактноеЛицо";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 " + ПоляВыборки + Символы.ПС
		+ "ИЗ " + ИмяТаблицыКонтрагенты() + " КАК Контрагенты" + Символы.ПС
		+ "ГДЕ Контрагенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	Найдено = Ложь;
	Если ЕстьТелефон Тогда
		Текущие.phone = ЗначениеСтрокойИлиПусто(Строка(Выборка.Телефон));
		Найдено = Истина;
	КонецЕсли;
	Если ЕстьEmail Тогда
		Текущие.email = ЗначениеСтрокойИлиПусто(Строка(Выборка.Email));
		Найдено = Истина;
	КонецЕсли;
	Если ЕстьКонтактноеЛицо Тогда
		Текущие.contact_person = ЗначениеСтрокойИлиПусто(Строка(Выборка.КонтактноеЛицо));
		Найдено = Истина;
	КонецЕсли;

	Возврат Найдено;

КонецФункции

#КонецОбласти

#Область РегистрацияTools

// Описание tool search_clients для реестра ar_Tools.
//
// Возвращаемое значение:
//  Структура - см. поля в теле функции (Имя, ОбщийМодуль, ИмяПроцедуры,
//  RiskLevel, ТребуетApproval, Версия, Описание, JSONManifest, ТребуемыеОбъекты).
//
Функция ОписаниеToolПоискКлиентов()
	Описание = Новый Структура;
	Описание.Вставить("Имя", "search_clients");
	Описание.Вставить("ОбщийМодуль", "ar_ToolCRM");
	Описание.Вставить("ИмяПроцедуры", "ПоискКлиентов");
	Описание.Вставить("RiskLevel", "Read");
	Описание.Вставить("ТребуетApproval", Ложь);
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Описание",
		"Поиск контрагентов по строке (наименование, полное наименование, ИНН). Read-only.");
	Описание.Вставить("JSONManifest", МанифестПоискКлиентов());
	// UNIV-03: логическое имя объекта метаданных, без которого tool не может
	// отработать (см. ar_ToolDispatcher.ПроверитьДоступностьTool).
	Описание.Вставить("ТребуемыеОбъекты", СписокИзСтрок("Контрагенты"));
	Возврат Описание;
КонецФункции

// Описание tool update_client_contact для реестра ar_Tools.
//
// Возвращаемое значение:
//  Структура - см. поля в теле функции (Имя, ОбщийМодуль, ИмяПроцедуры,
//  RiskLevel, ТребуетApproval, Версия, Описание, JSONManifest, ТребуемыеОбъекты).
//
Функция ОписаниеToolОбновитьКонтакт()
	Описание = Новый Структура;
	Описание.Вставить("Имя", "update_client_contact");
	Описание.Вставить("ОбщийМодуль", "ar_ToolCRM");
	Описание.Вставить("ИмяПроцедуры", "ОбновитьКонтактКлиента");
	Описание.Вставить("RiskLevel", "Draft");
	Описание.Вставить("ТребуетApproval", Истина);
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Описание",
		"Подготовить изменение контактных данных контрагента (телефон, email,"
		+ " контактное лицо). Этап 1: read-only, возвращает proposed_changes без записи.");
	Описание.Вставить("JSONManifest", МанифестОбновитьКонтакт());
	// UNIV-03: см. комментарий в ОписаниеToolПоискКлиентов.
	Описание.Вставить("ТребуемыеОбъекты", СписокИзСтрок("Контрагенты"));
	Возврат Описание;
КонецФункции

// JSON Schema аргументов search_clients, обёрнутая в OpenAI tool-format
// (см. ar_ToolUniversal.МанифестTool - единый контракт для всех tool-модулей).
Функция МанифестПоискКлиентов()
	Свойства = Новый Структура;
	Свойства.Вставить("query", СвойствоСхемы("string", "Строка поиска: наименование, полное наименование или ИНН."));
	Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум записей (1..50, по умолчанию 10)."));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", СписокИзСтрок("query"));

	Возврат ОбернутьВOpenAIФормат("search_clients",
		"Поиск контрагентов по строке (наименование, полное наименование, ИНН). Read-only.",
		Параметры);
КонецФункции

// JSON Schema аргументов update_client_contact (DoD D11), обёрнутая в OpenAI tool-format.
Функция МанифестОбновитьКонтакт()
	Свойства = Новый Структура;
	Свойства.Вставить("client_ref", СвойствоСхемы("string",
		"Навигационная ссылка (e1cib/...) или UUID контрагента."));
	Свойства.Вставить("phone", СвойствоСхемы("string", "Новый номер телефона (произвольный формат)."));
	Свойства.Вставить("email", СвойствоСхемы("string", "Новый адрес электронной почты."));
	Свойства.Вставить("contact_person", СвойствоСхемы("string", "Имя контактного лица."));
	Свойства.Вставить("comment", СвойствоСхемы("string", "Комментарий к изменению для оператора approval."));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", СписокИзСтрок("client_ref"));

	Возврат ОбернутьВOpenAIФормат("update_client_contact",
		"Подготовить изменение контактных данных контрагента (телефон, email,"
		+ " контактное лицо). Этап 1: read-only, возвращает proposed_changes без записи.",
		Параметры);
КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
// Формат обязателен для всех LLM-провайдеров (OpenAI-совместимые API, включая
// локальные - LM Studio и т.п.) - без обёртки провайдер возвращает 400 на
// список tools (см. ar_ToolUniversal.МанифестTool - образец контракта).
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)
	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", Имя);
	ФункцияОписание.Вставить("description", Описание);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);
	Возврат СтруктуруВJSON(Манифест);
КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
Функция СвойствоСхемы(Знач Тип, Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Массив из одной строки (для поля required JSON Schema).
Функция СписокИзСтрок(Знач Значение)
	Список = Новый Массив;
	Список.Добавить(Значение);
	Возврат Список;
КонецФункции

// Идемпотентно создаёт/обновляет запись ar_Tools по описанию.
// Выполняется в уже поднятом привилегированном режиме (см. ЗарегистрироватьTools).
//
Процедура ЗарегистрироватьОдинTool(Знач Описание, Статистика)

	СсылкаTool = НайтиСсылкуToolПоИмени(Описание.Имя);

	Если ЗначениеЗаполнено(СсылкаTool) Тогда
		Объект = СсылкаTool.ПолучитьОбъект();
		Создаётся = Ложь;
	Иначе
		Объект = Справочники.ar_Tools.СоздатьЭлемент();
		Создаётся = Истина;
	КонецЕсли;

	Объект.Наименование = Описание.Имя;
	Объект.ar_Имя = Описание.Имя;
	Объект.ar_Описание = Описание.Описание;
	Объект.ar_JSONManifest = Описание.JSONManifest;
	Объект.ar_RiskLevel = Перечисления.ar_RiskLevel[Описание.RiskLevel];
	Объект.ar_ОбщийМодуль = Описание.ОбщийМодуль;
	Объект.ar_ИмяПроцедуры = Описание.ИмяПроцедуры;
	Объект.ar_ТребуетApproval = Описание.ТребуетApproval;
	Объект.ar_Версия = Описание.Версия;
	Объект.ar_ИсточникРасширение = "";
	Объект.ar_Включён = Истина;
	// UNIV-03: ТребуемыеОбъекты — необязательное поле описания (Массив строк).
	// Отсутствует → пустой JSON-массив (tool универсальный, не привязан к
	// предметным объектам). ar_Доступен здесь НЕ выставляется — пересчитывается
	// отдельным проходом в ar_ToolDispatcher.ЗарегистрироватьВсеTools/
	// ПересчитатьДоступностьВсехTools после регистрации всех модулей.
	ТребуемыеОбъекты = Неопределено;
	Описание.Свойство("ТребуемыеОбъекты", ТребуемыеОбъекты);
	Если ТипЗнч(ТребуемыеОбъекты) = Тип("Массив") Тогда
		Объект.ar_ТребуемыеОбъекты = ar_JSON.ВЗначениеJSON(ТребуемыеОбъекты);
	Иначе
		Объект.ar_ТребуемыеОбъекты = "[]";
	КонецЕсли;
	Объект.Записать();

	Если Создаётся Тогда
		Статистика.Создано = Статистика.Создано + 1;
	Иначе
		Статистика.Обновлено = Статистика.Обновлено + 1;
	КонецЕсли;

КонецПроцедуры

// Находит ссылку ar_Tools по реквизиту ar_Имя. Неопределено, если нет записи.
Функция НайтиСсылкуToolПоИмени(Знач ИмяTool)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя";
	Запрос.УстановитьПараметр("Имя", ИмяTool);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

// Десериализует JSON-строку аргументов в Соответствие.
// Возвращает Неопределено при ошибке парсинга.
Функция ДесериализоватьАргументы(Знач АргументыJSON)

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(АргументыJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Читает значение из коллекции (Соответствие/Структура) с дефолтом.
Функция ПолучитьЗначениеИзКоллекции(Знач Коллекция, Знач Ключ, Знач Дефолт)

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Значение = Коллекция.Получить(Ключ);
		Если Значение = Неопределено Тогда
			Возврат Дефолт;
		КонецЕсли;
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Коллекция.Свойство(Ключ, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Дефолт;
	КонецЕсли;

	Возврат Дефолт;

КонецФункции

// Экранирует спецсимволы оператора ПОДОБНО.
// Символ экранирования — тильда "~" (как в БСП, см. ОбщегоНазначения.
// СформироватьСтрокуДляПоискаВЗапросе). В тексте запроса ключевое слово
// языка запросов называется СПЕЦСИМВОЛ, а не ЭКРАНИРОВАНИЕ — конструкция
// ПОДОБНО &Параметр ЭКРАНИРОВАНИЕ "~" вызывает ошибку парсера
// ("Expression expected \")\"" на месте ЭКРАНИРОВАНИЕ), т.к. такого
// ключевого слова в языке запросов 1С не существует.
// Сначала экранируем сам символ экранирования, затем остальные спецсимволы.
Функция ЭкранироватьПодобно(Знач Строка)

	Результат = СтрЗаменить(Строка, "~", "~~");
	Результат = СтрЗаменить(Результат, "%", "~%");
	Результат = СтрЗаменить(Результат, "_", "~_");
	Результат = СтрЗаменить(Результат, "[", "~[");
	Возврат Результат;

КонецФункции

// Полное имя таблицы "Справочник.<ИмяВМетаданных>" для источника запроса.
// Имя объекта метаданных берётся с учётом переопределения (регистр
// ar_ПереопределенияОбъектов, см. ar_ToolDispatcher.ИмяОбъектаМетаданных) -
// для целевых конфигураций, где справочник называется не "Контрагенты"
// (например, демо-конфигурация со справочником "_ДемоКонтрагенты").
// Алиас "Контрагенты" в тексте запроса остаётся прежним - меняется только
// имя таблицы-источника, поля запроса продолжают обращаться через алиас.
Функция ИмяТаблицыКонтрагенты()
	Возврат "Справочник." + ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");
КонецФункции

// Строит и выполняет запрос к справочнику Контрагенты.
Функция ВыполнитьЗапросКонтрагентов(Знач СтрокаПоиска, Знач Лимит,
		Знач ЕстьПолноеНаименование, Знач ЕстьИНН, Знач ЕстьКПП, Знач ЕстьЮрФизЛицо)

	ПоляВыборки = "Контрагенты.Ссылка КАК Ссылка," + Символы.ПС
		+ "	Контрагенты.Наименование КАК Наименование";

	Если ЕстьПолноеНаименование Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.НаименованиеПолное КАК НаименованиеПолное";
	КонецЕсли;
	Если ЕстьИНН Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.ИНН КАК ИНН";
	КонецЕсли;
	Если ЕстьКПП Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.КПП КАК КПП";
	КонецЕсли;
	Если ЕстьЮрФизЛицо Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо";
	КонецЕсли;

	// Условие поиска: по Наименование (всегда) + НаименованиеПолное и ИНН — если есть.
	УсловияПоиска = "Контрагенты.Наименование ПОДОБНО &ШаблонПоиска СПЕЦСИМВОЛ ""~""";
	Если ЕстьПолноеНаименование Тогда
		УсловияПоиска = УсловияПоиска + Символы.ПС
			+ "	ИЛИ Контрагенты.НаименованиеПолное ПОДОБНО &ШаблонПоиска СПЕЦСИМВОЛ ""~""";
	КонецЕсли;
	Если ЕстьИНН Тогда
		УсловияПоиска = УсловияПоиска + Символы.ПС
			+ "	ИЛИ Контрагенты.ИНН = &ТочныйПоиск";
	КонецЕсли;

	// ВЫБРАТЬ ПЕРВЫЕ N требует константу в тексте запроса, не параметр (&Лимит
	// синтаксически недопустим на этом месте). Лимит уже провалидирован
	// вызывающей стороной как целое число 1..50 (см. п.3 ВыполнитьSearchClients).
	// Формат(..., "ЧГ=0") - обязателен: Строка(Лимит) для чисел >= 1000 вставляет
	// разделитель групп ("1 500"), что ломает текст запроса.
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ "	" + ПоляВыборки + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	" + ИмяТаблицыКонтрагенты() + " КАК Контрагенты" + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ "	НЕ Контрагенты.ПометкаУдаления" + Символы.ПС
		+ "	И (" + УсловияПоиска + ")";

	// Учёт иерархичности — добавим И НЕ ЭтоГруппа только если справочник иерархический.
	// Метаданные.Справочники.Найти() вместо точечной нотации Метаданные.Справочники.
	// Контрагенты - последняя жёстко ссылается на конкретный объект метаданных
	// и не может учитывать переопределение имени (ar_ПереопределенияОбъектов).
	МДКонтрагентыИерарх = Метаданные.Справочники.Найти(
		ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты"));
	Если МДКонтрагентыИерарх <> Неопределено И МДКонтрагентыИерарх.Иерархический Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	И НЕ Контрагенты.ЭтоГруппа";
	КонецЕсли;

	ЭкранированныйПоиск = ЭкранироватьПодобно(СтрокаПоиска);
	ШаблонПоиска = "%" + ЭкранированныйПоиск + "%";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ШаблонПоиска", ШаблонПоиска);
	Запрос.УстановитьПараметр("ТочныйПоиск", СтрокаПоиска);

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Сериализует выборку в JSON-строку результата.
Функция СериализоватьРезультат(ВыборкаДанных, Знач ЕстьПолноеНаименование, Знач ЕстьИНН,
		Знач ЕстьКПП, Знач ЕстьЮрФизЛицо, Знач Предупреждение)

	Элементы = Новый Массив;
	Счётчик = 0;

	Пока ВыборкаДанных.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ref", ПолучитьНавигационнуюСсылку(ВыборкаДанных.Ссылка));
		Элемент.Вставить("name", Строка(ВыборкаДанных.Наименование));

		Если ЕстьПолноеНаименование Тогда
			Элемент.Вставить("full_name", Строка(ВыборкаДанных.НаименованиеПолное));
		КонецЕсли;
		Если ЕстьИНН Тогда
			Элемент.Вставить("inn", Строка(ВыборкаДанных.ИНН));
		КонецЕсли;
		Если ЕстьКПП Тогда
			Элемент.Вставить("kpp", Строка(ВыборкаДанных.КПП));
		КонецЕсли;
		Если ЕстьЮрФизЛицо Тогда
			// Сравниваем напрямую со значением перечисления: представление зависит
			// от языка пользователя и в локализованных конфигурациях даёт ложь.
			Элемент.Вставить("is_individual",
				ЭтоФизическоеЛицо(ВыборкаДанных.ЮридическоеФизическоеЛицо));
		КонецЕсли;

		Элементы.Добавить(Элемент);
		Счётчик = Счётчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("total_found", Счётчик);
	Если НЕ ПустаяСтрока(Предупреждение) Тогда
		Результат.Вставить("warning", Предупреждение);
	КонецЕсли;

	Возврат СтруктуруВJSON(Результат);

КонецФункции

// Формирует JSON-строку ошибки в формате контракта tool.
Функция СформироватьОшибку(Знач СообщениеОбОшибке)

	Результат = Новый Структура;
	Результат.Вставить("error", СообщениеОбОшибке);
	Результат.Вставить("items", Новый Массив);
	Возврат СтруктуруВJSON(Результат);

КонецФункции

// Формирует JSON-строку ошибки вида {"error":"<код>"} без массива items.
// Используется update_client_contact (контракт ответа не содержит items).
Функция СформироватьОшибкуПростую(Знач СообщениеОбОшибке)
	Результат = Новый Структура;
	Результат.Вставить("error", СообщениеОбОшибке);
	Возврат СтруктуруВJSON(Результат);
КонецФункции

// Сериализует структуру/массив в JSON-строку.
Функция СтруктуруВJSON(Знач Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "");
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Признак «физическое лицо» по значению перечисления ЮридическоеФизическоеЛицо.
// Если перечисления или значения в конфигурации нет (нетиповой случай) —
// возвращает Ложь, чтобы не отдавать LLM ложноположительный признак.
Функция ЭтоФизическоеЛицо(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Перечисление = Метаданные.Перечисления.Найти("ЮридическоеФизическоеЛицо");
	Если Перечисление = Неопределено
		Или Перечисление.ЗначенияПеречисления.Найти("ФизическоеЛицо") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Значение = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;

КонецФункции

#КонецОбласти
