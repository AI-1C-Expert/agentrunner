////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolAccessRules (SCALE-07).
//
// Единая точка вычисления ЭФФЕКТИВНОГО НАБОРА tools агента - объединения
// явного списка (ar_Агенты.ar_ДоступныеTools) и вычисляемых правил
// (ar_Агенты.ar_ПравилаДоступаTools). Оба существующих потребителя обязаны
// читать набор через этот модуль, а не собственным SQL к ar_ДоступныеTools:
//  * ar_PermissionEngine.ToolВWhitelist - L1-гейт (может ли агент вызвать tool);
//  * ar_RuntimeКонтекст.ТаблицаДоступныхTools - сборка tool_definitions для
//    промпта и N для порога прогрессивной выдачи (SCALE-05).
// Расхождение между ними означало бы, что модель видит в промпте не то, что
// реально разрешит L1 (или наоборот) - см. спеку SCALE-07, «Риски».
//
// Модуль не зависит ни от ar_PermissionEngine, ни от ar_RuntimeКонтекст (оба
// зависят от него) - циклических зависимостей нет.
//
// Алгоритм (спека, «Поведение» п.1):
//  1. ЯвныйСписок = ar_ДоступныеTools агента, где ar_Включен = Истина.
//  2. Правила агента (ar_ПравилаДоступаTools), знак ar_Разрешить.
//  3. Явный список пуст И правил нет -> набор = весь доступный реестр
//     (ar_Включён=Истина, ar_Доступен=Истина, не помечен на удаление) -
//     РАСШИРЕНИЕ ПРАВ по сравнению с поведением до SCALE-07, поэтому
//     обработчик обновления (ar_ОбновлениеРасширения) обязан предупредить
//     администратора при первом обнаружении такого агента.
//  4. Иначе: базовое множество кандидатов = весь реестр (тот же фильтр).
//  5. Разрешающие правила объединяются (union). Если разрешающих правил нет
//     вовсе, а есть только запрещающие - базовое множество = весь реестр
//     ("всё, кроме...").
//  6. Запрещающие правила применяются последними и всегда исключают
//     совпавшие tools, независимо от ar_Порядок и от способа разрешения.
//  7. ЯвныйСписок объединяется с результатом правил (сумма множеств) и
//     тоже проходит через запрещающие правила.
//  8. Финальное пересечение с ar_Включён=Истина и ar_Доступен=Истина.
//
// Пересчёт - на каждый вызов (реестр tools меняется независимо от карточки
// агента), без кэширования в отдельной колонке/таблице (спека, «Граничные
// случаи»).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Запрещено: Выполнить(), Вычислить().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Вычисляет эффективный набор tools, доступных агенту (явный список ИЛИ
// правила ИЛИ весь реестр при пустоте обоих), с полями, нужными обоим
// потребителям (whitelist-проверке и сборке контекста).
//
// Один запрос к ar_Tools (кандидаты) + один к ar_ПравилаДоступаTools агента -
// дальнейшая фильтрация (union разрешающих, вычитание запрещающих) в памяти,
// без N+1 обращений к БД (спека, требование к реализации).
//
// Параметры:
//  СсылкаАгент - СправочникСсылка.ar_Агенты - агент, для которого считаем набор.
//
// Возвращаемое значение:
//  ТаблицаЗначений либо Неопределено (СсылкаАгент не задана/не резолвится) -
//  колонки:
//   * ИмяTool          - Строка  - ar_Tools.ar_Имя.
//   * Манифест         - Строка  - ar_Tools.ar_JSONManifest.
//   * ВсегдаВКонтексте - Булево  - ar_Tools.ar_ВсегдаВКонтексте.
//   * КодКатегории     - Строка  - ar_Tools.ar_Категория (может быть "").
//
Функция ЭффективныйНаборTools(Знач СсылкаАгент) Экспорт

	Результат = НоваяТаблицаНабораTools();

	Если Не ЗначениеЗаполнено(СсылкаАгент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кандидаты = ПрочитатьКандидатовРеестра();
	Если Кандидаты.Количество() = 0 Тогда
		Возврат Результат; // Реестр пуст либо всё отключено/недоступно - пустой набор для любого агента.
	КонецЕсли;

	ЯвныйСписок = ПрочитатьЯвныйСписок(СсылкаАгент);
	Правила = ПрочитатьПравила(СсылкаАгент);

	// Решение 5 (спека): и явный список, и правила пусты -> весь доступный
	// реестр. Прямое расширение прав по сравнению с поведением до SCALE-07 -
	// обработчик обновления фиксирует такие агенты отдельно (см.
	// ar_ОбновлениеРасширения, идентификатор обработчика SCALE-07).
	Если ЯвныйСписок.Количество() = 0 И Правила.Количество() = 0 Тогда
		Для Каждого КлючЗначение Из Кандидаты Цикл
			ДобавитьСтрокуНабора(Результат, КлючЗначение.Значение);
		КонецЦикла;
		// Сортировка по имени - детерминированный порядок между вызовами
		// (Соответствие порядок не гарантирует), важно для стабильности
		// префикса промпта (план §3.6, тот же принцип, что и сортировка карты
		// категорий в ar_RuntimeКонтекст).
		Результат.Сортировать("ИмяTool");
		Возврат Результат;
	КонецЕсли;

	// ВАЖНО (найдено живой проверкой на БП 3.0): НаборПоПравилам при отсутствии
	// разрешающих правил возвращает ВЕСЬ реестр как базовое множество. Это
	// верно, когда правила есть (запрещающие сужают весь реестр), но неверно,
	// когда правил нет вовсе, а явный список заполнен: агент «Менеджер по
	// дебиторке» с 5 строками ar_ДоступныеTools получал 39 tools вместо 5 -
	// молчаливое расширение прав, ровно то, что задача обязана предотвращать.
	// Поэтому при пустых правилах базой служит СТРОГО явный список.
	Если Правила.Количество() = 0 Тогда
		НаборИзПравил = Новый Соответствие;
	Иначе
		НаборИзПравил = НаборПоПравилам(Кандидаты, Правила);
	КонецЕсли;

	// Явный список объединяется с результатом правил (сумма множеств) -
	// работает независимо, как до SCALE-07 (DoD D7).
	Для Каждого Имя Из ЯвныйСписок Цикл
		НаборИзПравил.Вставить(Имя, Истина);
	КонецЦикла;

	// Запрещающие правила применяются последними и распространяются на ВСЕ
	// имена, включая явный список (спека п.7) - deny всегда побеждает.
	ИсключитьЗапрещённые(НаборИзПравил, Правила, Кандидаты);

	Для Каждого КлючЗначение Из НаборИзПравил Цикл
		ДанныеTool = Кандидаты.Получить(КлючЗначение.Ключ);
		Если ДанныеTool = Неопределено Тогда
			Продолжить; // Имя не входит в базовое множество (недоступно/отключено/удалено) - п.8.
		КонецЕсли;
		ДобавитьСтрокуНабора(Результат, ДанныеTool);
	КонецЦикла;

	Результат.Сортировать("ИмяTool"); // Детерминированный порядок - см. комментарий выше.

	Возврат Результат;

КонецФункции

// Проверяет вхождение конкретного tool в эффективный набор агента - удобная
// обёртка над ЭффективныйНаборTools для L1-гейта (ar_PermissionEngine), без
// сборки лишних колонок манифеста/категории на стороне вызывающего кода.
//
// Параметры:
//  СсылкаАгент - СправочникСсылка.ar_Агенты.
//  ИмяTool     - Строка - техническое имя tool (ar_Имя).
//
// Возвращаемое значение:
//  Булево - Истина, если ИмяTool входит в эффективный набор агента.
//
Функция ToolДоступенАгенту(Знач СсылкаАгент, Знач ИмяTool) Экспорт

	Набор = ЭффективныйНаборTools(СсылкаАгент);
	Если Набор = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяTool = СокрЛП(Строка(ИмяTool));
	Строки = Набор.НайтиСтроки(Новый Структура("ИмяTool", ИмяTool));
	Возврат Строки.Количество() > 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт пустую ТаблицаЗначений с колонками контракта ЭффективныйНаборTools.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяTool, Манифест, ВсегдаВКонтексте, КодКатегории.
//
Функция НоваяТаблицаНабораTools()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяTool");
	Таблица.Колонки.Добавить("Манифест");
	Таблица.Колонки.Добавить("ВсегдаВКонтексте");
	Таблица.Колонки.Добавить("КодКатегории");
	Возврат Таблица;

КонецФункции

// Добавляет в Таблица одну строку по данным tool из Кандидаты.
//
// Параметры:
//  Таблица   - ТаблицаЗначений - см. НоваяТаблицаНабораTools.
//  ДанныеTool - Структура - см. ПрочитатьКандидатовРеестра (одно значение Соответствия).
//
Процедура ДобавитьСтрокуНабора(Таблица, ДанныеTool)

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ИмяTool          = ДанныеTool.Имя;
	НоваяСтрока.Манифест         = ДанныеTool.Манифест;
	НоваяСтрока.ВсегдаВКонтексте = ДанныеTool.ВсегдаВКонтексте;
	НоваяСтрока.КодКатегории     = ДанныеTool.КодКатегории;

КонецПроцедуры

// Базовое множество кандидатов - весь реестр ar_Tools, включённый и
// доступный, без помеченных на удаление (тот же фильтр, что накладывал
// прежний прямой JOIN в ToolВWhitelist/ТаблицаДоступныхTools).
//
// Возвращаемое значение:
//  Соответствие - Ключ: ИмяTool (Строка, СокрЛП) -> Значение: Структура
//  {Имя, Манифест, ВсегдаВКонтексте, КодКатегории, ИдентификаторПакета,
//  Namespace, RiskLevel (Строка - имя значения перечисления)}.
//
Функция ПрочитатьКандидатовРеестра()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_JSONManifest КАК Манифест,
		|	Tools.ar_ВсегдаВКонтексте КАК ВсегдаВКонтексте,
		|	Tools.ar_Категория КАК КодКатегории,
		|	Tools.ar_ИдентификаторПакета КАК ИдентификаторПакета,
		|	Tools.ar_Namespace КАК Namespace,
		|	Tools.ar_RiskLevel КАК RiskLevel
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Включён = ИСТИНА
		|	И Tools.ar_Доступен = ИСТИНА
		|	И НЕ Tools.ПометкаУдаления";

	Кандидаты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Строка(Выборка.Имя));
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;

		Данные = Новый Структура;
		Данные.Вставить("Имя",                Имя);
		Данные.Вставить("Манифест",            Строка(Выборка.Манифест));
		Данные.Вставить("ВсегдаВКонтексте",    Выборка.ВсегдаВКонтексте = Истина);
		Данные.Вставить("КодКатегории",        СокрЛП(Строка(Выборка.КодКатегории)));
		Данные.Вставить("ИдентификаторПакета", СокрЛП(Строка(Выборка.ИдентификаторПакета)));
		Данные.Вставить("Namespace",           СокрЛП(Строка(Выборка.Namespace)));
		Данные.Вставить("RiskLevel",           ИмяRiskLevel(Выборка.RiskLevel));

		Кандидаты.Вставить(Имя, Данные);
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

// Программное имя значения перечисления ar_RiskLevel ("Read"/"Draft"/
// "Write"/"Commit"), а НЕ синоним Строка(): при DefaultLanguage = Русский
// (Configuration.xml - единственный Language) Строка() вернула бы русские
// синонимы ("Чтение" и т.п.), с которыми правило типа RiskLevel (ar_Значение
// заполняется по спеке латиницей) никогда не совпадёт. Приём - как в
// ar_ToolDispatcher.ИмяRiskLevel, но дефолт при пустой/неизвестной ссылке -
// пустая строка (не "Read"): здесь это критерий сопоставления с правилом
// администратора, и по граничному случаю спеки "пустое/неверное значение
// не должно ронять вычисление - пустое совпадение", а не безопасный дефолт
// уровня риска, как в диспетчере вызова.
//
Функция ИмяRiskLevel(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("ПеречислениеСсылка.ar_RiskLevel")
		Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого ЗначениеМД Из Метаданные.Перечисления.ar_RiskLevel.ЗначенияПеречисления Цикл
		Если Перечисления.ar_RiskLevel[ЗначениеМД.Имя] = Значение Тогда
			Возврат ЗначениеМД.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Читает ТЧ ar_ДоступныеTools агента (строки с ar_Включен = Истина).
//
// Реквизит ТЧ ar_Tool - СТРОКА с именем tool, не ссылка на справочник
// (см. Catalogs/ar_Агенты.xml).
//
// Возвращаемое значение:
//  Массив строк (Строка, СокрЛП, без дублей).
//
Функция ПрочитатьЯвныйСписок(СсылкаАгент)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", СсылкаАгент);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоступныеTools.ar_Tool КАК Имя
		|ИЗ
		|	Справочник.ar_Агенты.ar_ДоступныеTools КАК ДоступныеTools
		|ГДЕ
		|	ДоступныеTools.Ссылка = &Агент
		|	И ДоступныеTools.ar_Включен = ИСТИНА";

	Список = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Строка(Выборка.Имя));
		Если Не ПустаяСтрока(Имя) Тогда
			Список.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Список;

КонецФункции

// Программное имя значения перечисления ar_ТипПравилаДоступа ("Категория"/
// "Пакет"/"Namespace"/"Tool"/"RiskLevel"), а не синоним Строка(): та же
// причина, что у ИмяRiskLevel выше - Configuration.xml объявляет единственный
// DefaultLanguage = Русский, и синонимы значений перечисления НЕ совпадают
// с программными именами (например, RiskLevel -> "Уровень риска"). Без этого
// приёма ЭтоСовпадениеКритерия сравнивала бы русский синоним со строками
// "Категория"/"RiskLevel"/... и правило типа RiskLevel никогда бы не
// совпало - тот же класс бага, что был найден в ПрочитатьКандидатовРеестра
// (ревью 1, замечание 1).
//
// Пустая/неверная ссылка -> "" (пустое совпадение, не ошибка - граничный
// случай спеки).
//
Функция ИмяТипаПравила(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("ПеречислениеСсылка.ar_ТипПравилаДоступа")
		Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого ЗначениеМД Из Метаданные.Перечисления.ar_ТипПравилаДоступа.ЗначенияПеречисления Цикл
		Если Перечисления.ar_ТипПравилаДоступа[ЗначениеМД.Имя] = Значение Тогда
			Возврат ЗначениеМД.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Читает ТЧ ar_ПравилаДоступаTools агента, упорядоченные по ar_Порядок.
//
// Возвращаемое значение:
//  Массив Структур {ТипПравила (Строка - имя значения перечисления),
//  Значение (Строка, СокрЛП), Разрешить (Булево), Порядок (Число)}.
//
Функция ПрочитатьПравила(СсылкаАгент)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", СсылкаАгент);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Правила.ar_ТипПравила КАК ТипПравила,
		|	Правила.ar_Значение КАК Значение,
		|	Правила.ar_Разрешить КАК Разрешить,
		|	Правила.ar_Порядок КАК Порядок
		|ИЗ
		|	Справочник.ar_Агенты.ar_ПравилаДоступаTools КАК Правила
		|ГДЕ
		|	Правила.Ссылка = &Агент
		|УПОРЯДОЧИТЬ ПО
		|	Правила.ar_Порядок,
		|	Правила.НомерСтроки";

	Правила = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Правило = Новый Структура;
		Правило.Вставить("ТипПравила", ИмяТипаПравила(Выборка.ТипПравила));
		Правило.Вставить("Значение",   СокрЛП(Строка(Выборка.Значение)));
		Правило.Вставить("Разрешить",  Выборка.Разрешить = Истина);
		Правило.Вставить("Порядок",    Выборка.Порядок);
		Правила.Добавить(Правило);
	КонецЦикла;

	Возврат Правила;

КонецФункции

// Вычисляет набор имён по разрешающим правилам (union), с фолбэком "весь
// реестр", если разрешающих правил нет вовсе, а есть только запрещающие
// (спека, п.5: "запрещающие правила без единого разрешающего трактуются как
// всё, кроме...").
//
// Параметры:
//  Кандидаты - Соответствие - см. ПрочитатьКандидатовРеестра.
//  Правила   - Массив - см. ПрочитатьПравила.
//
// Возвращаемое значение:
//  Соответствие - Ключ: ИмяTool -> Значение: Истина (множество имён).
//
Функция НаборПоПравилам(Кандидаты, Правила)

	ЕстьРазрешающие = Ложь;
	Для Каждого Правило Из Правила Цикл
		Если Правило.Разрешить Тогда
			ЕстьРазрешающие = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Набор = Новый Соответствие;

	Если Не ЕстьРазрешающие Тогда
		// Только запрещающие правила (или их тоже нет, что сюда не попадает -
		// вызывается только когда правила НЕ пусты) - базовое разрешённое
		// множество = весь реестр, запрет применяется отдельно веткой выше.
		Для Каждого КлючЗначение Из Кандидаты Цикл
			Набор.Вставить(КлючЗначение.Ключ, Истина);
		КонецЦикла;
		Возврат Набор;
	КонецЕсли;

	Для Каждого Правило Из Правила Цикл
		Если Не Правило.Разрешить Тогда
			Продолжить; // Запрещающие обрабатываются отдельно, после объединения с явным списком.
		КонецЕсли;
		СовпавшиеИмена = ИменаПоКритерию(Кандидаты, Правило);
		Для Каждого Имя Из СовпавшиеИмена Цикл
			Набор.Вставить(Имя, Истина);
		КонецЦикла;
	КонецЦикла;

	Возврат Набор;

КонецФункции

// Исключает из набора все имена, совпавшие хотя бы с одним запрещающим
// правилом - deny всегда побеждает (спека п.6-7), независимо от ar_Порядок и
// от того, как имя попало в набор (явный список либо разрешающее правило).
//
// Параметры:
//  Набор     - Соответствие - изменяется по ссылке (Вставить/Удалить).
//  Правила   - Массив - см. ПрочитатьПравила.
//  Кандидаты - Соответствие - см. ПрочитатьКандидатовРеестра.
//
Процедура ИсключитьЗапрещённые(Набор, Правила, Кандидаты)

	Для Каждого Правило Из Правила Цикл
		Если Правило.Разрешить Тогда
			Продолжить;
		КонецЕсли;
		СовпавшиеИмена = ИменаПоКритерию(Кандидаты, Правило);
		Для Каждого Имя Из СовпавшиеИмена Цикл
			Если Набор.Получить(Имя) <> Неопределено Тогда
				Набор.Удалить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Находит имена tools из Кандидаты, совпадающие с одним правилом (Категория/
// Пакет/Namespace/Tool/RiskLevel). Пустое значение критерия не совпадает ни
// с чем (спека, «Граничные случаи» - опечатка не должна расширять доступ,
// wildcard-семантики нет). Неизвестный ТипПравила или значение, не найденное
// ни у одного tool (удалённый пакет, опечатка в RiskLevel) - трактуется как
// пустое совпадение, не как ошибка (graceful-деградация, аналог
// ar_RuntimeКонтекст.СтрокаКартыОднойКатегории).
//
// Возвращаемое значение:
//  Массив строк-имён (может быть пустым).
//
Функция ИменаПоКритерию(Кандидаты, Правило)

	Совпадения = Новый Массив;

	Значение = Правило.Значение;
	Если ПустаяСтрока(Значение) Тогда
		Возврат Совпадения; // Пустая ar_Значение не совпадает ни с чем.
	КонецЕсли;

	Для Каждого КлючЗначение Из Кандидаты Цикл
		ДанныеTool = КлючЗначение.Значение;
		Если ЭтоСовпадениеКритерия(ДанныеTool, Правило.ТипПравила, Значение, Правило.Разрешить) Тогда
			Совпадения.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Совпадения;

КонецФункции

// Сравнивает одно правило с данными одного tool по соответствующему полю.
//
// Параметры:
//  ДанныеTool - Структура - см. ПрочитатьКандидатовРеестра.
//  ТипПравила - Строка - имя значения перечисления ar_ТипПравилаДоступа.
//  Значение   - Строка - ar_Значение правила (непустая, проверено вызывающим кодом).
//  Разрешить  - Булево - ar_Разрешить правила. Нужен только для wildcard:
//                        "*" совпадает лишь в запрещающих правилах (см. ниже).
//
// Возвращаемое значение:
//  Булево - Истина при точном совпадении соответствующего поля ДанныеTool.
//
Функция ЭтоСовпадениеКритерия(ДанныеTool, Знач ТипПравила, Знач Значение, Знач Разрешить)

	// Wildcard "*" работает ТОЛЬКО в запрещающих правилах (Разрешить = Ложь).
	// Он нужен, чтобы выразить «запретить всё» одной строкой: иначе запрет
	// пришлось бы перечислять по всем значениям RiskLevel, и любой новый
	// уровень риска тихо пробивал бы такой запрет. Используется миграцией
	// SCALE-07 (правило-барьер, см. ar_ОбновлениеРасширения).
	//
	// В РАЗРЕШАЮЩИХ правилах wildcard намеренно НЕ поддержан: иначе одна
	// строка «разрешить *» открывала бы весь реестр, а опечатка в значении
	// расширяла бы доступ - спека («Граничные случаи») это прямо запрещает,
	// и сценарий «всё доступное» уже покрыт пустым набором правил (решение 5).
	// Асимметрия сознательная: расширять права молча нельзя, сужать - можно.
	Если Значение = "*" Тогда
		Возврат Не Разрешить;
	КонецЕсли;

	Если ТипПравила = "Категория" Тогда
		Возврат ДанныеTool.КодКатегории = Значение;
	ИначеЕсли ТипПравила = "Пакет" Тогда
		Возврат ДанныеTool.ИдентификаторПакета = Значение;
	ИначеЕсли ТипПравила = "Namespace" Тогда
		Возврат ДанныеTool.Namespace = Значение;
	ИначеЕсли ТипПравила = "Tool" Тогда
		Возврат ДанныеTool.Имя = Значение;
	ИначеЕсли ТипПравила = "RiskLevel" Тогда
		Возврат ДанныеTool.RiskLevel = Значение;
	Иначе
		Возврат Ложь; // Неизвестный/опечатанный ТипПравила - пустое совпадение, не ошибка.
	КонецЕсли;

КонецФункции

#КонецОбласти
