////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_LLMLocalCompatible (AOS LLM LocalCompatible).
//
// Провайдер для локальных LLM-серверов с OpenAI-совместимым API (Ollama,
// LM Studio, LLaMA.cpp HTTP server, vLLM, LocalAI и т.п.). Реализует чат через
// ar_HTTP.ВыполнитьPOST. Принимает сообщения во внутреннем универсальном формате
// AgentRunner и возвращает ответ в том же формате (включая tool_calls и usage).
//
// Два режима (определяются реквизитом провайдера ar_ПоддерживаетToolCalls):
//   * native (Истина)        — формат tools/tool_calls идентичен ar_LLMOpenAI;
//   * text-fallback (Ложь)   — инструкция по вызову инструментов вставляется в
//                              system-prompt, а ответ парсится на наличие блоков
//                              <tool_call>{"tool":"...","args":{...}}</tool_call>.
//
// Свойства модуля: Сервер, без привилегированного режима. Привилегированный
// режим устанавливается внутри ar_Secrets.Прочитать при чтении API-ключа.
// Для локальных серверов API-ключ опционален: если ar_APIKeyИдентификатор
// пуст — заголовок Authorization не добавляется (анонимный клиент).
//
// Контракт: см. ar_LLMКонтракт (формат сообщений, ключи структуры результата,
// валидаторы). Эталон реализации — ar_LLMOpenAI (идентичный контракт Чат()).
//
// См. спеку: .docs/specs/LLM-11.md, Plan §3.14, §5 этап 2.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет запрос к OpenAI-совместимому LLM-серверу.
//
// Поддерживает два режима: native (ar_ПоддерживаетToolCalls = Истина) и
// text-fallback (ar_ПоддерживаетToolCalls = Ложь, теги <tool_call>...</tool_call>).
//
// Параметры:
//   Сообщения  - Массив   - список сообщений во внутреннем формате AgentRunner.
//                           Каждый элемент — Структура с ключами:
//                             role         - Строка ("system" | "user" | "assistant" | "tool")
//                             content      - Строка
//                             tool_calls   - Массив структур (опционально, для assistant)
//                             tool_call_id - Строка (опционально, для tool)
//                             name         - Строка (опционально, для tool)
//   Параметры  - Структура - {Провайдер (СправочникСсылка.ar_LLMПровайдеры),
//                             Модель (Строка),
//                             Температура (Число),
//                             МаксТокенов (Число),
//                             Tools (Массив манифестов)}
//
// Возвращаемое значение:
//   Структура - {Успех, Сообщение, ТокеновВход, ТокеновВыход, Ошибка, КодСостояния}
//
Функция Чат(Сообщения, Параметры) Экспорт

	Результат = НовыйРезультат();

	// --- Валидация входа ---------------------------------------------------
	Если ТипЗнч(Сообщения) <> Тип("Массив") Или Сообщения.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Сообщения не заданы'; en = 'Messages are not set'");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Результат.Ошибка = НСтр("ru = 'Параметры не заданы'; en = 'Parameters are not set'");
		Возврат Результат;
	КонецЕсли;

	Провайдер = Неопределено;
	Параметры.Свойство("Провайдер", Провайдер);
	Если Провайдер = Неопределено Или НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Результат.Ошибка = НСтр("ru = 'Провайдер не задан'; en = 'Provider is not set'");
		Возврат Результат;
	КонецЕсли;

	// --- Чтение реквизитов провайдера --------------------------------------
	BaseURL = "";
	КлючИдентификатор = "";
	ПоддерживаетToolCalls = Ложь;
	DefaultModel = "";
	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер,
			"ar_BaseURL, ar_APIKeyИдентификатор, ar_ПоддерживаетToolCalls, ar_DefaultModel");
		BaseURL = СокрЛП(Строка(Реквизиты.ar_BaseURL));
		КлючИдентификатор = СокрЛП(Строка(Реквизиты.ar_APIKeyИдентификатор));
		Если ТипЗнч(Реквизиты.ar_ПоддерживаетToolCalls) = Тип("Булево") Тогда
			ПоддерживаетToolCalls = Реквизиты.ar_ПоддерживаетToolCalls;
		КонецЕсли;
		DefaultModel = СокрЛП(Строка(Реквизиты.ar_DefaultModel));
	Исключение
		Результат.Ошибка = НСтр("ru = 'Не удалось прочитать провайдера'; en = 'Failed to read provider'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(BaseURL) Тогда
		Результат.Ошибка = НСтр("ru = 'BaseURL не задан у провайдера'; en = 'BaseURL is not set for the provider'");
		Возврат Результат;
	КонецЕсли;

	// --- Чтение API-ключа (опционально для локальных серверов) -------------
	APIKey = "";
	Если НЕ ПустаяСтрока(КлючИдентификатор) Тогда
		Попытка
			ПрочитанныйКлюч = ar_Secrets.Прочитать(ar_Secrets.КлючПровайдера(КлючИдентификатор));
		Исключение
			Результат.Ошибка = НСтр("ru = 'Не удалось прочитать API-ключ'; en = 'Failed to read API key'");
			Возврат Результат;
		КонецПопытки;

		Если ТипЗнч(ПрочитанныйКлюч) <> Тип("Строка") Или ПустаяСтрока(ПрочитанныйКлюч) Тогда
			Результат.Ошибка = НСтр("ru = 'API-ключ не задан для провайдера'; en = 'API key is not set for the provider'");
			Возврат Результат;
		КонецЕсли;

		APIKey = ПрочитанныйКлюч;
	КонецЕсли;

	// --- Модель ------------------------------------------------------------
	Модель = "";
	Параметры.Свойство("Модель", Модель);
	Если ТипЗнч(Модель) <> Тип("Строка") Или ПустаяСтрока(Модель) Тогда
		Модель = ?(ПустаяСтрока(DefaultModel), "llama3", DefaultModel);
	КонецЕсли;

	// --- Подготовка сообщений (text-mode: инструкция в system-prompt) ------
	СообщенияДляЗапроса = Сообщения;
	Tools = Неопределено;
	ЕстьTools = (Параметры.Свойство("Tools", Tools)
		И ТипЗнч(Tools) = Тип("Массив")
		И Tools.Количество() > 0);

	Если НЕ ПоддерживаетToolCalls И ЕстьTools Тогда
		// Создаем копию массива — оригинал из loop не модифицируется (D10).
		СообщенияДляЗапроса = ДобавитьИнструкциюToolMode(Сообщения, ТекстИнструкцииToolMode());
	КонецЕсли;

	// --- Сборка тела запроса ----------------------------------------------
	ТелоJSON = "";
	Попытка
		ТелоJSON = ПостроитьТелоЗапроса(Модель, СообщенияДляЗапроса, Параметры, ПоддерживаетToolCalls);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Ошибка сериализации запроса'; en = 'Request serialization error'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	// --- HTTP-вызов --------------------------------------------------------
	URL = ПостроитьURL(BaseURL);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");
	Если НЕ ПустаяСтрока(APIKey) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + APIKey);
	КонецЕсли;

	Таймаут = 0;
	Параметры.Свойство("Таймаут", Таймаут);
	Если ТипЗнч(Таймаут) <> Тип("Число") Тогда
		Таймаут = 0;
	КонецЕсли;

	HTTPОтвет = ar_HTTP.ВыполнитьPOST(URL, Заголовки, ТелоJSON, ?(Таймаут > 0, Таймаут, 0));

	Результат.КодСостояния = HTTPОтвет.КодСостояния;

	// --- Обработка ошибок HTTP --------------------------------------------
	Если HTTPОтвет.КодСостояния = 0 Тогда
		Результат.Ошибка = ?(ПустаяСтрока(HTTPОтвет.Ошибка),
			НСтр("ru = 'Сетевая ошибка'; en = 'Network error'"), HTTPОтвет.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		Результат.Ошибка = СообщениеОбОшибкеHTTP(HTTPОтвет.КодСостояния, HTTPОтвет.Тело);
		Возврат Результат;
	КонецЕсли;

	// --- Парсинг успешного ответа -----------------------------------------
	ЗаполнитьРезультатИзОтвета(HTTPОтвет.Тело, ПоддерживаетToolCalls, Результат);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует структуру результата по умолчанию (Успех = Ложь).
// Набор ключей идентичен ar_LLMКонтракт.НовыйОтвет().
Функция НовыйРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);
	Возврат Результат;
КонецФункции

// Разбирает тело успешного (HTTP 200) ответа LLM и заполняет Результат.
//
// При любой проблеме структуры — выставляет Результат.Ошибка и не трогает
// Результат.Успех (остается Ложь). При успехе — Результат.Сообщение,
// Результат.ТокеновВход/ТокеновВыход и Результат.Успех = Истина.
//
// Параметры:
//   ТелоОтвета            - Строка    - тело HTTP-ответа (JSON).
//   ПоддерживаетToolCalls - Булево    - режим разбора сообщения.
//   Результат             - Структура - модифицируется.
//
Процедура ЗаполнитьРезультатИзОтвета(ТелоОтвета, ПоддерживаетToolCalls, Результат)

	Попытка
		Ответ = ПрочитатьJSONСтроку(ТелоОтвета);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Ошибка парсинга ответа'; en = 'Response parsing error'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ LLM не является объектом'; en = 'LLM response is not an object'");
		Возврат;
	КонецЕсли;

	СообщениеOpenAI = ИзвлечьСообщениеОтвета(Ответ, Результат);
	Если СообщениеOpenAI = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПоддерживаетToolCalls Тогда
		Результат.Сообщение = СообщениеИзФорматаOpenAI(СообщениеOpenAI);
	Иначе
		Результат.Сообщение = СообщениеИзТекстовогоОтвета(СообщениеOpenAI);
	КонецЕсли;

	ПарситьUsage(Ответ, Результат);

	Результат.Успех = Истина;

КонецПроцедуры

// Извлекает message из choices[0] ответа. При проблеме структуры — выставляет
// Результат.Ошибка и возвращает Неопределено.
Функция ИзвлечьСообщениеОтвета(Ответ, Результат)

	Choices = Ответ.Получить("choices");
	Если ТипЗнч(Choices) <> Тип("Массив") Или Choices.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ LLM не содержит вариантов'; en = 'LLM response has no choices'");
		Возврат Неопределено;
	КонецЕсли;

	ПервыйChoice = Choices[0];
	Если ТипЗнч(ПервыйChoice) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ LLM имеет некорректную структуру choices';
			|en = 'LLM response has invalid choices structure'");
		Возврат Неопределено;
	КонецЕсли;

	СообщениеOpenAI = ПервыйChoice.Получить("message");
	Если ТипЗнч(СообщениеOpenAI) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ LLM не содержит message'; en = 'LLM response has no message'");
		Возврат Неопределено;
	КонецЕсли;

	Возврат СообщениеOpenAI;

КонецФункции

// Строит итоговый URL запроса к OpenAI-совместимому серверу.
//
// Правила достраивания пути (через строковые функции, без регулярных выражений):
//   * .../v1/chat/completions  → as-is;
//   * .../chat                 → as-is (кастомный путь, напр. Ollama /api/chat);
//   * .../v1                   → + "/chat/completions";
//   * прочее (хост или путь)   → trailing slash убирается, добавляется
//                                "/v1/chat/completions".
Функция ПостроитьURL(BaseURL)

	База = СокрЛП(BaseURL);
	Пока СтрДлина(База) > 0 И Прав(База, 1) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;

	ЧастиURL = СтрРазделить(База, "/", Ложь);
	ПоследняяЧасть = "";
	Если ЧастиURL.Количество() > 0 Тогда
		ПоследняяЧасть = НРег(ЧастиURL[ЧастиURL.Количество() - 1]);
	КонецЕсли;

	Если ПоследняяЧасть = "completions" Или ПоследняяЧасть = "chat" Тогда
		// Полный путь уже задан администратором (LM Studio/vLLM/Ollama /api/chat).
		Возврат База;
	ИначеЕсли ПоследняяЧасть = "v1" Тогда
		Возврат База + "/chat/completions";
	КонецЕсли;

	Возврат База + "/v1/chat/completions";

КонецФункции

// Текст инструкции по вызову инструментов в text-mode.
// Описывает формат блока <tool_call>{"tool":"...","args":{...}}</tool_call>.
Функция ТекстИнструкцииToolMode()

	Возврат НСтр(
		"ru = 'Если тебе нужно использовать инструмент, сформируй ответ содержащий ОДИН блок вызова в формате:
		|<tool_call>{""tool"": ""<имя_инструмента>"", ""args"": {<аргументы_JSON>}}</tool_call>
		|Внутри тегов — только JSON без переносов строк. После блока можешь добавить пояснительный текст.';
		|en = 'If you need to use a tool, produce a response containing ONE call block in the format:
		|<tool_call>{""tool"": ""<tool_name>"", ""args"": {<JSON_arguments>}}</tool_call>
		|Inside the tags — only JSON without line breaks. After the block you may add explanatory text.'");

КонецФункции

// Возвращает новый массив сообщений с добавленной инструкцией text-mode.
// Не модифицирует входной массив: создает поверхностные копии сообщений.
//
// Логика: к первому сообщению role="system" добавляется блок инструкции
// (через два перевода строки). Если такого сообщения нет — новое сообщение
// role="system" с инструкцией вставляется в начало массива.
//
// Параметры:
//   Сообщения       - Массив - исходные сообщения (не модифицируется).
//   ТекстИнструкции - Строка - текст блока инструкции.
//
// Возвращаемое значение:
//   Массив - новый массив сообщений с инструкцией.
//
Функция ДобавитьИнструкциюToolMode(Сообщения, ТекстИнструкции)

	СообщенияИтог = Новый Массив;
	ИнструкцияВставлена = Ложь;

	Для Каждого Сообщение Из Сообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			СообщенияИтог.Добавить(Сообщение);
			Продолжить;
		КонецЕсли;

		Роль = "";
		Сообщение.Свойство("role", Роль);

		Если НЕ ИнструкцияВставлена И Строка(Роль) = ar_LLMКонтракт.РольSystem() Тогда
			Копия = СкопироватьСообщение(Сообщение);
			СтароеСодержание = "";
			Копия.Свойство("content", СтароеСодержание);
			Если ПустаяСтрока(Строка(СтароеСодержание)) Тогда
				Копия.Вставить("content", ТекстИнструкции);
			Иначе
				Копия.Вставить("content", Строка(СтароеСодержание) + Символы.ПС + Символы.ПС + ТекстИнструкции);
			КонецЕсли;
			СообщенияИтог.Добавить(Копия);
			ИнструкцияВставлена = Истина;
		Иначе
			СообщенияИтог.Добавить(Сообщение);
		КонецЕсли;

	КонецЦикла;

	Если НЕ ИнструкцияВставлена Тогда
		СообщениеИнструкции = ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольSystem(), ТекстИнструкции);
		СообщенияИтог.Вставить(0, СообщениеИнструкции);
	КонецЕсли;

	Возврат СообщенияИтог;

КонецФункции

// Создает поверхностную копию структуры-сообщения (для неизменности входа).
Функция СкопироватьСообщение(Сообщение)
	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Сообщение Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Строит JSON-тело запроса в OpenAI-формате.
//
// Поле tools добавляется только в native mode (ПоддерживаетToolCalls = Истина)
// и только при непустом Параметры.Tools. В text-mode tools не передается никогда.
Функция ПостроитьТелоЗапроса(Модель, Сообщения, Параметры, ПоддерживаетToolCalls)

	Тело = Новый Соответствие;
	Тело.Вставить("model", Модель);
	Тело.Вставить("messages", СообщенияВФорматOpenAI(Сообщения));

	Температура = Неопределено;
	Если Параметры.Свойство("Температура", Температура) И ТипЗнч(Температура) = Тип("Число") Тогда
		Тело.Вставить("temperature", Температура);
	КонецЕсли;

	МаксТокенов = 0;
	Если Параметры.Свойство("МаксТокенов", МаксТокенов)
		И ТипЗнч(МаксТокенов) = Тип("Число") И МаксТокенов > 0 Тогда
		Тело.Вставить("max_tokens", МаксТокенов);
	КонецЕсли;

	Если ПоддерживаетToolCalls Тогда
		Tools = Неопределено;
		Если Параметры.Свойство("Tools", Tools)
			И ТипЗнч(Tools) = Тип("Массив") И Tools.Количество() > 0 Тогда
			Тело.Вставить("tools", Tools);
		КонецЕсли;
	КонецЕсли;

	Возврат ЗаписатьJSONСтроку(Тело);

КонецФункции

// Сериализует массив внутренних сообщений в массив соответствий формата OpenAI.
Функция СообщенияВФорматOpenAI(Сообщения)

	Результат = Новый Массив;

	Для Каждого Сообщение Из Сообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Соответствие;

		Role = "";
		Сообщение.Свойство("role", Role);
		Элемент.Вставить("role", Строка(Role));

		Content = "";
		Сообщение.Свойство("content", Content);

		ToolCalls = Неопределено;
		Сообщение.Свойство("tool_calls", ToolCalls);
		ЕстьToolCalls = (ТипЗнч(ToolCalls) = Тип("Массив") И ToolCalls.Количество() > 0);

		Если Role = ar_LLMКонтракт.РольAssistant() И ЕстьToolCalls Тогда
			Элемент.Вставить("content", Неопределено); // Платформа сериализует Неопределено как JSON null
			Элемент.Вставить("tool_calls", ToolCallsВФорматOpenAI(ToolCalls));
		Иначе
			Элемент.Вставить("content", Строка(Content));
		КонецЕсли;

		Если Role = ar_LLMКонтракт.РольTool() Тогда
			ToolCallId = "";
			Сообщение.Свойство("tool_call_id", ToolCallId);
			Элемент.Вставить("tool_call_id", Строка(ToolCallId));

			ИмяTool = "";
			Если Сообщение.Свойство("name", ИмяTool) И НЕ ПустаяСтрока(Строка(ИмяTool)) Тогда
				Элемент.Вставить("name", Строка(ИмяTool));
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сериализует массив tool_calls (Структур) в массив Соответствий формата OpenAI.
Функция ToolCallsВФорматOpenAI(ToolCalls)

	Результат = Новый Массив;

	Для Каждого Вызов Из ToolCalls Цикл

		Если ТипЗнч(Вызов) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Соответствие;

		ИдВызова = "";
		Вызов.Свойство("id", ИдВызова);
		Элемент.Вставить("id", Строка(ИдВызова));

		ТипВызова = "function";
		Вызов.Свойство("type", ТипВызова);
		Элемент.Вставить("type", Строка(ТипВызова));

		ФункцияВызова = Неопределено;
		Вызов.Свойство("function", ФункцияВызова);

		ФункцияMap = Новый Соответствие;
		Если ТипЗнч(ФункцияВызова) = Тип("Структура") Тогда
			ИмяФункции = "";
			ФункцияВызова.Свойство("name", ИмяФункции);
			ФункцияMap.Вставить("name", Строка(ИмяФункции));

			Аргументы = "";
			ФункцияВызова.Свойство("arguments", Аргументы);
			ФункцияMap.Вставить("arguments", Строка(Аргументы));
		КонецЕсли;
		Элемент.Вставить("function", ФункцияMap);

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конвертирует Соответствие message (из ответа OpenAI) во внутреннюю Структуру.
// Используется в native mode.
Функция СообщениеИзФорматаOpenAI(СообщениеOpenAI)

	Результат = Новый Структура;

	Role = СообщениеOpenAI.Получить("role");
	Результат.Вставить("role", ?(ТипЗнч(Role) = Тип("Строка"), Role, ar_LLMКонтракт.РольAssistant()));

	Content = СообщениеOpenAI.Получить("content");
	Если Content = Неопределено Или ТипЗнч(Content) <> Тип("Строка") Тогда
		Результат.Вставить("content", "");
	Иначе
		Результат.Вставить("content", Content);
	КонецЕсли;

	ToolCallsRaw = СообщениеOpenAI.Получить("tool_calls");
	Если ТипЗнч(ToolCallsRaw) = Тип("Массив") И ToolCallsRaw.Количество() > 0 Тогда
		Результат.Вставить("tool_calls", ToolCallsИзФорматаOpenAI(ToolCallsRaw));
		Возврат Результат;
	КонецЕсли;

	// Локальные модели даже в native-режиме периодически срываются на текстовый
	// вызов инструмента внутри content (в т.ч. в самодельных обёртках вида
	// "<|tool_call>...<tool_call|>"). Без этого разбора такой текст уходил
	// пользователю как финальный ответ вместо выполнения инструмента.
	Извлечение = ИзвлечьToolCallsИзТекста(Результат.content);
	Если Извлечение.ToolCalls.Количество() > 0 Тогда
		Результат.Вставить("content", Извлечение.ТекстБезТегов);
		Результат.Вставить("tool_calls", Извлечение.ToolCalls);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Конвертирует ответ text-mode в внутреннюю Структуру сообщения.
// Извлекает блоки <tool_call> из content; tool_calls = из тегов, content = текст
// без тегов. Если тегов нет — tool_calls пуст, content = полный текст.
Функция СообщениеИзТекстовогоОтвета(СообщениеOpenAI)

	Результат = Новый Структура;
	Результат.Вставить("role", ar_LLMКонтракт.РольAssistant());

	Content = СообщениеOpenAI.Получить("content");
	Текст = ?(ТипЗнч(Content) = Тип("Строка"), Content, "");

	Извлечение = ИзвлечьToolCallsИзТекста(Текст);

	Результат.Вставить("content", Извлечение.ТекстБезТегов);

	Если Извлечение.ToolCalls.Количество() > 0 Тогда
		Результат.Вставить("tool_calls", Извлечение.ToolCalls);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Извлекает tool_calls из текста ответа модели.
//
// Ищет блоки вызова инструмента, парсит содержимое каждого ({tool, args}) и
// формирует tool_call (id = "local_N", type = "function"). Нераспознанный блок
// пропускается, остальные обрабатываются. Кроме канонического
// <tool_call>...</tool_call> распознаются обёртки, которые реально выдают
// локальные модели: <|tool_call>...<tool_call|>, <|tool_call|>...<|/tool_call|>
// и [TOOL_CALL]...[/TOOL_CALL].
//
// Параметры:
//   Текст - Строка - текст ответа модели.
//
// Возвращаемое значение:
//   Структура - {ToolCalls: Массив, ТекстБезТегов: Строка}.
//
Функция ИзвлечьToolCallsИзТекста(Текст)

	ToolCalls = Новый Массив;
	Остаток = Строка(Текст);
	Номер = 1;

	Для Каждого Пара Из ВариантыРазделителейToolCall() Цикл
		Номер = ИзвлечьБлокиПоРазделителям(Остаток, Пара.Начало, Пара.Конец, Номер, ToolCalls);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ToolCalls", ToolCalls);
	Результат.Вставить("ТекстБезТегов", СокрЛП(Остаток));
	Возврат Результат;

КонецФункции

// Возвращает поддерживаемые пары разделителей блока вызова инструмента.
// Порядок значим: более длинные/специфичные обёртки идут раньше, иначе
// "<tool_call>" не найдётся, а "<|tool_call>" будет разобран частично.
//
// Возвращаемое значение:
//   Массив - элементы Структура {Начало: Строка, Конец: Строка}.
//
Функция ВариантыРазделителейToolCall()

	Варианты = Новый Массив;
	Варианты.Добавить(ПараРазделителей("<|tool_call|>", "<|/tool_call|>"));
	Варианты.Добавить(ПараРазделителей("<|tool_call>", "<tool_call|>"));
	Варианты.Добавить(ПараРазделителей("<tool_call>", "</tool_call>"));
	Варианты.Добавить(ПараРазделителей("[TOOL_CALL]", "[/TOOL_CALL]"));
	Возврат Варианты;

КонецФункции

// Конструирует пару разделителей блока вызова инструмента.
Функция ПараРазделителей(Знач Начало, Знач Конец)
	Пара = Новый Структура;
	Пара.Вставить("Начало", Начало);
	Пара.Вставить("Конец", Конец);
	Возврат Пара;
КонецФункции

// Вырезает из Остатка все блоки между заданными разделителями, разбирает их и
// добавляет распознанные вызовы в ToolCalls.
//
// Параметры:
//   Остаток      - Строка  - текст ответа; изменяется (блоки удаляются).
//   НачалоТега   - Строка  - открывающий разделитель.
//   КонецТега    - Строка  - закрывающий разделитель.
//   Номер        - Число   - следующий свободный номер для id вызова.
//   ToolCalls    - Массив  - пополняется распознанными вызовами.
//
// Возвращаемое значение:
//   Число - следующий свободный номер для id вызова.
//
Функция ИзвлечьБлокиПоРазделителям(Остаток, Знач НачалоТега, Знач КонецТега, Знач Номер, ToolCalls)

	ДлинаНачала = СтрДлина(НачалоТега);
	ДлинаКонца = СтрДлина(КонецТега);

	Пока Истина Цикл

		ПозНач = СтрНайти(Остаток, НачалоТега);
		Если ПозНач = 0 Тогда
			Прервать;
		КонецЕсли;

		// Закрывающий разделитель ищем строго после открывающего: при совпадающих
		// разделителях иначе нашли бы сам открывающий.
		ПозКон = СтрНайти(Остаток, КонецТега, НаправлениеПоиска.СНачала, ПозНач + ДлинаНачала);
		Если ПозКон = 0 Тогда
			// Неполный блок — оставляем текст как есть.
			Прервать;
		КонецЕсли;

		НачалоТела = ПозНач + ДлинаНачала;
		ДлинаТела = ПозКон - НачалоТела;
		ТелоБлока = "";
		Если ДлинаТела > 0 Тогда
			ТелоБлока = Сред(Остаток, НачалоТела, ДлинаТела);
		КонецЕсли;

		ПолныйБлок = Сред(Остаток, ПозНач, ПозКон + ДлинаКонца - ПозНач);

		Если ПопытатьсяРазобратьБлок(ТелоБлока, Номер, ToolCalls) Тогда
			Номер = Номер + 1;
		КонецЕсли;

		Остаток = СтрЗаменить(Остаток, ПолныйБлок, "");

	КонецЦикла;

	Возврат Номер;

КонецФункции

// Разбирает тело одного блока вызова инструмента и добавляет tool_call в массив.
// Возвращает Истину, если вызов добавлен; Ложь — если блок невалиден.
//
// Поддерживаются формы тела:
//   * {"tool":"...","args":{...}}                     - канонический формат;
//   * {"name":"...","arguments":{...}|"{...}"}         - форма OpenAI;
//   * {"function":{"name":"...","arguments":...}}      - вложенная форма OpenAI;
//   * call:<имя>{...}                                  - текстовая форма без JSON.
//
Функция ПопытатьсяРазобратьБлок(ТелоБлока, Номер, ToolCalls)

	Текст = НормализоватьТелоToolCall(ТелоБлока);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Разбор = РазобратьТелоToolCall(Текст);
	Если Разбор = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ToolCalls.Добавить(ar_LLMКонтракт.НовыйToolCall(
		"local_" + Формат(Номер, "ЧГ="), Разбор.Имя, Разбор.АргументыJSON));
	Возврат Истина;

КонецФункции

// Нормализует тело блока перед разбором: раскрывает псевдо-кавычки, которыми
// некоторые локальные модели экранируют строки внутри самодельного блока
// (например <|"|> вместо "), и обрезает пробелы.
Функция НормализоватьТелоToolCall(Знач ТелоБлока)

	Текст = Строка(ТелоБлока);

	Псевдокавычки = Новый Массив;
	Псевдокавычки.Добавить("<|""|>");
	Псевдокавычки.Добавить("<|'|>");
	Псевдокавычки.Добавить("&quot;");

	Для Каждого Псевдокавычка Из Псевдокавычки Цикл
		Текст = СтрЗаменить(Текст, Псевдокавычка, """");
	КонецЦикла;

	Возврат СокрЛП(Текст);

КонецФункции

// Разбирает тело блока вызова инструмента в пару {Имя, АргументыJSON}.
//
// Параметры:
//   Текст - Строка - тело блока без обрамляющих разделителей.
//
// Возвращаемое значение:
//   Структура, Неопределено - {Имя: Строка, АргументыJSON: Строка} либо
//                             Неопределено, если тело не распознано.
//
Функция РазобратьТелоToolCall(Знач Текст)

	Попытка
		ДанныеJSON = ПрочитатьJSONСтроку(Текст);
	Исключение
		ДанныеJSON = Неопределено;
	КонецПопытки;

	Если ТипЗнч(ДанныеJSON) = Тип("Соответствие") Тогда
		Возврат РазобратьСоответствиеToolCall(ДанныеJSON);
	КонецЕсли;

	Возврат РазобратьТекстовыйToolCall(Текст);

КонецФункции

// Извлекает имя и аргументы вызова из разобранного JSON-объекта блока.
// Возвращает Неопределено, если имя инструмента не найдено.
Функция РазобратьСоответствиеToolCall(Знач ДанныеJSON)

	Данные = ДанныеJSON;

	// Форма OpenAI: {"function":{"name":...,"arguments":...}}.
	Вложенная = Данные.Получить("function");
	Если ТипЗнч(Вложенная) = Тип("Соответствие") Тогда
		Данные = Вложенная;
	КонецЕсли;

	ИмяTool = "";
	Для Каждого Ключ Из СтрРазделить("tool,name,tool_name,function_name", ",", Ложь) Цикл
		Значение = Данные.Получить(Ключ);
		Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(СокрЛП(Значение)) Тогда
			ИмяTool = СокрЛП(Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ИмяTool) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Аргументы = Неопределено;
	Для Каждого Ключ Из СтрРазделить("args,arguments,parameters,params,input", ",", Ложь) Цикл
		Значение = Данные.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Аргументы = Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат НовыйРазборToolCall(ИмяTool, АргументыВJSON(Аргументы));

КонецФункции

// Приводит значение аргументов вызова к строке JSON-объекта.
// Строка принимается как готовый JSON (форма OpenAI), прочее сериализуется.
// Нераспознанное значение даёт "{}" - тул сам вернёт осмысленную ошибку.
Функция АргументыВJSON(Знач Аргументы)

	Если Аргументы = Неопределено Тогда
		Возврат "{}";
	КонецЕсли;

	Если ТипЗнч(Аргументы) = Тип("Строка") Тогда
		Текст = СокрЛП(Аргументы);
		Возврат ?(ПустаяСтрока(Текст), "{}", Текст);
	КонецЕсли;

	Попытка
		Возврат ЗаписатьJSONСтроку(Аргументы);
	Исключение
		Возврат "{}";
	КонецПопытки;

КонецФункции

// Разбирает текстовую форму вызова без валидного JSON: "call:<имя>{<тело>}" либо
// "<имя>{<тело>}". Тело в фигурных скобках отдаётся тулу как есть: если это не
// JSON, тул вернёт свою ошибку с подсказкой по формату - это информативнее для
// модели, чем молча потерянный вызов.
//
// Возвращаемое значение:
//   Структура, Неопределено - {Имя, АргументыJSON} либо Неопределено.
//
Функция РазобратьТекстовыйToolCall(Знач Текст)

	Строка_ = СокрЛП(Текст);

	ПозСкобки = СтрНайти(Строка_, "{");
	Если ПозСкобки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастьИмени = СокрЛП(Лев(Строка_, ПозСкобки - 1));

	// Отбрасываем префиксы вида "call:", "tool:", "function:" и разделители.
	Для Каждого Префикс Из СтрРазделить("call:,tool:,function:,name:", ",", Ложь) Цикл
		Если НРег(Лев(ЧастьИмени, СтрДлина(Префикс))) = Префикс Тогда
			ЧастьИмени = СокрЛП(Сред(ЧастьИмени, СтрДлина(Префикс) + 1));
		КонецЕсли;
	КонецЦикла;

	ЧастьИмени = СокрЛП(СтрЗаменить(СтрЗаменить(ЧастьИмени, """", ""), "=", ""));
	Если ПустаяСтрока(ЧастьИмени) ИЛИ НЕ ЭтоИмяИнструмента(ЧастьИмени) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозКонца = 0;
	Для Сч = 1 По СтрДлина(Строка_) Цикл
		Позиция = СтрДлина(Строка_) - Сч + 1;
		Если Сред(Строка_, Позиция, 1) = "}" Тогда
			ПозКонца = Позиция;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПозКонца <= ПозСкобки Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТелоАргументов = Сред(Строка_, ПозСкобки, ПозКонца - ПозСкобки + 1);
	Возврат НовыйРазборToolCall(ЧастьИмени, ЗакавычитьГолыеКлючиJSON(ТелоАргументов));

КонецФункции

// Заключает в кавычки голые ключи JSON-подобного тела ({source:"X"} →
// {"source":"X"}). Локальные модели часто печатают объект в JS-нотации, и без
// этого тело не разбирается ни здесь, ни в самом инструменте.
//
// Обрабатывается только текст вне строковых литералов; при неудаче разбора
// возвращается исходное тело - тул тогда вернёт свою ошибку с подсказкой.
//
// Параметры:
//   Тело - Строка - JSON-подобный текст объекта аргументов.
//
// Возвращаемое значение:
//   Строка - тело с закавыченными ключами.
//
Функция ЗакавычитьГолыеКлючиJSON(Знач Тело)

	Результат = "";
	ВСтроке = Ложь;
	Экранирование = Ложь;
	Буфер = "";

	Для Сч = 1 По СтрДлина(Тело) Цикл

		Символ = Сред(Тело, Сч, 1);

		Если ВСтроке Тогда
			Результат = Результат + Символ;
			Если Экранирование Тогда
				Экранирование = Ложь;
			ИначеЕсли Символ = "\" Тогда
				Экранирование = Истина;
			ИначеЕсли Символ = """" Тогда
				ВСтроке = Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Символ = """" Тогда
			Результат = Результат + СбросБуфераКлюча(Буфер, Ложь) + Символ;
			ВСтроке = Истина;
		ИначеЕсли Символ = ":" Тогда
			// Накопленный до двоеточия идентификатор - это ключ объекта.
			Результат = Результат + СбросБуфераКлюча(Буфер, Истина) + Символ;
		ИначеЕсли Символ = "," ИЛИ Символ = "{" ИЛИ Символ = "}"
			ИЛИ Символ = "[" ИЛИ Символ = "]" Тогда
			Результат = Результат + СбросБуфераКлюча(Буфер, Ложь) + Символ;
		Иначе
			Буфер = Буфер + Символ;
		КонецЕсли;

	КонецЦикла;

	Результат = Результат + СбросБуфераКлюча(Буфер, Ложь);
	Возврат ?(ВСтроке, Тело, Результат);

КонецФункции

// Возвращает содержимое буфера идентификатора, закавычивая его, если это ключ
// объекта (ЭтоКлюч = Истина) и он ещё не в кавычках. Буфер очищается.
Функция СбросБуфераКлюча(Буфер, Знач ЭтоКлюч)

	Значение = Буфер;
	Буфер = "";

	Обрезанное = СокрЛП(Значение);
	Если НЕ ЭтоКлюч ИЛИ ПустаяСтрока(Обрезанное) ИЛИ НЕ ЭтоИмяИнструмента(Обрезанное) Тогда
		Возврат Значение;
	КонецЕсли;

	// Сохраняем исходные отступы вокруг ключа, чтобы не склеить текст.
	ПозицияКлюча = СтрНайти(Значение, Обрезанное);
	Возврат Лев(Значение, ПозицияКлюча - 1) + """" + Обрезанное + """"
		+ Сред(Значение, ПозицияКлюча + СтрДлина(Обрезанное));

КонецФункции

// Проверяет, что строка похожа на идентификатор инструмента (буквы латиницы,
// цифры, подчёркивание, точка). Отсекает случайный текст перед "{".
Функция ЭтоИмяИнструмента(Знач Значение)

	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789_.-";

	Для Сч = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Допустимые, НРег(Сред(Значение, Сч, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Конструирует результат разбора блока вызова инструмента.
Функция НовыйРазборToolCall(Знач Имя, Знач АргументыJSON)
	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("АргументыJSON", АргументыJSON);
	Возврат Результат;
КонецФункции

// Возвращает строку JSON-сериализации значения с настройками AgentRunner:
//   * двойные кавычки;
//   * сохранение null;
//   * даты в ISO 8601.
Функция ЗаписатьJSONСтроку(Значение)

	НастройкиЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "", Истина);

	// Свойства СохранятьNull у НастройкиСериализацииJSON не существует (платформа
	// и так сериализует Неопределено как JSON null по умолчанию). Правильное имя
	// свойства формата дат - ФорматСериализацииДаты (проверено по реальному
	// использованию в БП: DataProcessors/МенеджерКонвертацииУправлениеПерсоналом).
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(НастройкиЗаписи);
	ЗаписатьJSON(Запись, Значение, НастройкиСериализации);
	Возврат Запись.Закрыть();

КонецФункции

// Десериализует JSON-строку в Соответствие/Массив (ЧитатьВСоответствие = Истина).
Функция ПрочитатьJSONСтроку(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Конвертирует массив tool_calls из Соответствий во внутренние Структуры
// через конструктор ar_LLMКонтракт.НовыйToolCall.
Функция ToolCallsИзФорматаOpenAI(ToolCallsRaw)

	Результат = Новый Массив;

	Для Каждого Вызов Из ToolCallsRaw Цикл

		Если ТипЗнч(Вызов) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		ИдВызова = Вызов.Получить("id");
		ИмяФ = "";
		АргументыФ = "";

		ФункцияRaw = Вызов.Получить("function");
		Если ТипЗнч(ФункцияRaw) = Тип("Соответствие") Тогда
			ЗначениеИмя = ФункцияRaw.Получить("name");
			Если ТипЗнч(ЗначениеИмя) = Тип("Строка") Тогда
				ИмяФ = ЗначениеИмя;
			КонецЕсли;
			ЗначениеАргументы = ФункцияRaw.Получить("arguments");
			Если ТипЗнч(ЗначениеАргументы) = Тип("Строка") Тогда
				АргументыФ = ЗначениеАргументы;
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(ar_LLMКонтракт.НовыйToolCall(
			?(ТипЗнч(ИдВызова) = Тип("Строка"), ИдВызова, ""), ИмяФ, АргументыФ));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлекает usage из JSON-ответа и кладет в Результат.ТокеновВход/ТокеновВыход.
// При отсутствии блока usage (штатно для многих локальных серверов) — оставляет
// нули. Числовое приведение делегируется ar_LLMКонтракт.ИзвлечьЧисло.
Процедура ПарситьUsage(Ответ, Результат)

	Usage = Ответ.Получить("usage");
	Если ТипЗнч(Usage) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Результат.ТокеновВход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("prompt_tokens"));
	Результат.ТокеновВыход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("completion_tokens"));

КонецПроцедуры

// Формирует текст ошибки для HTTP-кода != 200, извлекая error.message если есть.
Функция СообщениеОбОшибкеHTTP(КодСостояния, Тело)

	КраткоеТело = "";
	Если ТипЗнч(Тело) = Тип("Строка") И НЕ ПустаяСтрока(Тело) Тогда
		Попытка
			Распарсенное = ПрочитатьJSONСтроку(Тело);
			Если ТипЗнч(Распарсенное) = Тип("Соответствие") Тогда
				ErrorНоды = Распарсенное.Получить("error");
				Если ТипЗнч(ErrorНоды) = Тип("Соответствие") Тогда
					Сообщ = ErrorНоды.Получить("message");
					Если ТипЗнч(Сообщ) = Тип("Строка") Тогда
						КраткоеТело = Сообщ;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Тело ответа не является JSON — оставляем КраткоеТело пустым.
			КраткоеТело = "";
		КонецПопытки;
	КонецЕсли;

	Если КодСостояния = 401 Тогда
		Префикс = НСтр("ru = 'Ошибка авторизации LLM: 401'; en = 'LLM authorization error: 401'");
	ИначеЕсли КодСостояния = 404 Тогда
		Префикс = НСтр("ru = 'LLM endpoint не найден: 404'; en = 'LLM endpoint not found: 404'");
	ИначеЕсли КодСостояния = 429 Тогда
		Префикс = НСтр("ru = 'Rate limit LLM: 429'; en = 'LLM rate limit: 429'");
	ИначеЕсли КодСостояния >= 500 Тогда
		Префикс = НСтр("ru = 'Ошибка сервера LLM: '; en = 'LLM server error: '") + Формат(КодСостояния, "ЧГ=");
	Иначе
		Префикс = НСтр("ru = 'Ошибка LLM: '; en = 'LLM error: '") + Формат(КодСостояния, "ЧГ=");
	КонецЕсли;

	Если ПустаяСтрока(КраткоеТело) Тогда
		Возврат Префикс;
	КонецЕсли;

	Возврат Префикс + ": " + КраткоеТело;

КонецФункции

#КонецОбласти
