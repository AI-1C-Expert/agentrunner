КонецПроцедуры

// Найти записи очереди со статусом "answered" привилегированно (TOOL-19 D8).
// Делегирует в ar_Approval.НайтиОтвеченныеApprovalБезПривилегий.
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если отвеченных нет.
//
Функция НайтиОтвеченныеApprovalПривилегированно() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.НайтиОтвеченныеApprovalБезПривилегий();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Зафиксировать ответ оператора на вопрос ask_user привилегированно (TOOL-19 D7).
// Делегирует в ar_Approval.ОтветитьНаВопросБезПривилегий.
//
// Параметры:
//  ApprovalId   - Строка                       - UUID записи очереди.
//  Пользователь - СправочникСсылка.Пользователи - кто дал ответ.
//  Ответ        - Строка                       - текст ответа оператора.
//
// Возвращаемое значение:
//  Булево - Истина при успехе; Ложь если запись не найдена или имеет неверный статус.
//
Функция ОтветитьНаВопросПривилегированно(Знач ApprovalId, Знач Пользователь,
		Знач Ответ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.ОтветитьНаВопросБезПривилегий(
			ApprovalId, Пользователь, Ответ);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Найти просроченные pending/awaiting_input-записи очереди approval привилегированно.
// Делегирует в ar_Approval.НайтиПросроченныеApprovalБезПривилегий.
//
// Параметры:
//  ГраницаСоздания - Дата - записи старше этой границы считаются просроченными.
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если просроченных нет.
//
Функция НайтиПросроченныеApprovalПривилегированно(Знач ГраницаСоздания) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.НайтиПросроченныеApprovalБезПривилегий(ГраницаСоздания);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Найти одобренные записи очереди approval привилегированно (SCHED-03).
// Делегирует в ar_Approval.НайтиОдобренныеApprovalБезПривилегий.
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если одобренных нет.
//
Функция НайтиОдобренныеApprovalПривилегированно() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.НайтиОдобренныеApprovalБезПривилегий();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Найти зависшие запуски привилегированно (SCHED-04). Делегирует в
// ar_AuditЗапуски.НайтиЗависшиеЗапускиБезПривилегий.
//
// Параметры:
//  ГраницаHeartbeat - Дата - запуски с ar_LastHeartbeat строго раньше этой
//                     границы считаются зависшими.
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (RunId). Пустой, если зависших нет.
//
Функция НайтиЗависшиеЗапускиПривилегированно(Знач ГраницаHeartbeat,
	Знач ГраницаApproval = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_AuditЗапуски.НайтиЗависшиеЗапускиБезПривилегий(
			ГраницаHeartbeat, ГраницаApproval);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Подсчитать активные (Running) запуски привилегированно (SCHED-05). Делегирует
// в ar_AuditЗапуски.ПодсчитатьАктивныеЗапускиБезПривилегий.
//
// Параметры:
//  СсылкаАгент - СправочникСсылка.ar_Агенты - агент для per-agent подсчёта.
//
// Возвращаемое значение:
//  Структура - {ПоАгенту: Число, ВсегоАктивных: Число}.
//
Функция ПодсчитатьАктивныеЗапускиПривилегированно(Знач СсылкаАгент) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_AuditЗапуски.ПодсчитатьАктивныеЗапускиБезПривилегий(СсылкаАгент);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Найти кэшированный результат предыдущего исполнения commit-tool
// привилегированно. Делегирует в ar_Approval.НайтиПредыдущийРезультатБезПривилегий.
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности.
//
// Возвращаемое значение:
//  Неопределено - нет executed-записи; Строка - кэшированный JSON-результат.
//
Функция НайтиПредыдущийРезультатПривилегированно(Знач IdempotencyKey) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.НайтиПредыдущийРезультатБезПривилегий(IdempotencyKey);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Прочитать статус запуска из ar_Запуски привилегированно (для проверки
// финального статуса). Делегирует в ar_Approval.СтатусЗапускаБезПривилегий.
//
// Параметры:
//  RunId - Строка - идентификатор запуска (UUID).
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ar_СтатусЗапуска, Неопределено - статус запуска или
//  Неопределено, если запись не найдена.
//
Функция СтатусЗапускаПривилегированно(Знач RunId) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.СтатусЗапускаБезПривилегий(RunId);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Прочитать запись сессии из ar_Сессии привилегированно (SESS-06).
//
// Выполняется в привилегированном режиме по той же причине, что и запись
// (см. СохранитьСессиюПривилегированно ниже): ar_RuntimeЦикл (вызывающий код)
// работает в правах пользователя сессии, у которого может не быть права
// "Чтение" на ar_Сессии - ни одна роль расширения его не выдаёт. Без
// привилегий МенеджерЗаписи.Прочитать() молча не находит существующую
// запись (платформа не выбрасывает исключение при недостатке прав на
// регистр сведений, а трактует как "запись не найдена").
//
// Параметры:
//  СсылкаАгент - СправочникСсылка.ar_Агенты - агент, за которым закреплена сессия.
//  Якорь       - Строка - универсальный строковый якорь диалога.
//
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.ar_Сессии - прочитанная запись (проверить
//  Выбран() у вызывающего кода).
//
Функция ПрочитатьСессиюПривилегированно(Знач СсылкаАгент, Знач Якорь) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи = РегистрыСведений.ar_Сессии.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_Агент = КлючИзмеренияАгент(СсылкаАгент);
		МенеджерЗаписи.ar_Якорь = Якорь;
		МенеджерЗаписи.Прочитать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат МенеджерЗаписи;

КонецФункции

// Нормализовать значение для составного измерения ar_Сессии.ar_Агент (SESS-07).
//
// Измерение типизировано как СправочникСсылка.ar_Агенты + Строка(150) именно
// потому, что пустая ссылка ненадёжна как значение ссылочного измерения
// регистра сведений: запись с ПустаяСсылка() проходит без исключения, но
// последующий МенеджерЗаписи.Прочитать() по тому же ключу не находит её
// даже в пределах одного серверного вызова сразу после коммита транзакции
// (воспроизведено диагностикой, не документированная платформой тонкость
// сравнения "пустых" ссылочных значений при построении отбора). Строковое
// значение "" сравнивается предсказуемо, поэтому для no-agent-запуска
// (СсылкаАгент - пустая ссылка) в измерение кладётся "" вместо ПустаяСсылка().
//
// Параметры:
//  СсылкаАгент - СправочникСсылка.ar_Агенты - агент (может быть пустой ссылкой).
//
// Возвращаемое значение:
//  СправочникСсылка.ar_Агенты, Строка - СсылкаАгент как есть, если заполнена;
//  иначе "".
//
Функция КлючИзмеренияАгент(Знач СсылкаАгент) Экспорт

	Если ЗначениеЗаполнено(СсылкаАгент) Тогда
		Возврат СсылкаАгент;
	КонецЕсли;

	Возврат "";

КонецФункции

// Сохранить/обновить запись сессии в ar_Сессии привилегированно (SESS-02).
//
// Содержит всю работу с регистром: блокировка, транзакция, МенеджерЗаписи,
// upsert. Выполняется в привилегированном режиме, т.к. ar_RuntimeЦикл (вызывающий
// код) работает в правах пользователя сессии, у которого может не быть права
// "Изменение" на ar_Сессии.
//
// Параметры:
//  СсылкаАгент     - СправочникСсылка.ar_Агенты - агент, за которым закреплена сессия.
//  Якорь           - Строка - универсальный строковый якорь диалога
//                    (chat:<uuid>/ref:<XMLСтрока(Ссылка)>, см. SESS-05).
//  RunId           - Строка(36) - идентификатор завершившегося запуска.
//  Снимок          - Соответствие - {v:1, history:[...]} после компакции.
//  ПользовательUUID - Строка - UUID пользователя ИБ - инициатора диалога
//                    (пустая строка, если неизвестен). По умолчанию "".
//
Процедура СохранитьСессиюПривилегированно(Знач СсылкаАгент, Знач Якорь,
		Знач RunId, Знач Снимок, Знач ПользовательUUID = "") Экспорт

	КлючАгент = КлючИзмеренияАгент(СсылкаАгент);

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		НачатьТранзакцию();
		Попытка

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_Сессии");
			ЭлементБлокировки.УстановитьЗначение("ar_Агент", КлючАгент);
			ЭлементБлокировки.УстановитьЗначение("ar_Якорь", Якорь);
			Блокировка.Заблокировать();

			Хранилище = Новый ХранилищеЗначения(Снимок, Новый СжатиеДанных(9));

			МенеджерЗаписи = РегистрыСведений.ar_Сессии.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ar_Агент = КлючАгент;
			МенеджерЗаписи.ar_Якорь = Якорь;
			МенеджерЗаписи.Прочитать();

			ЕстьЗапись = МенеджерЗаписи.Выбран();
			ТекущаяДатаВремя = ТекущаяДатаСеанса();

			// SESS-07: Прочитать() для несуществующей записи может сбрасывать
			// значения измерений объекта МенеджераЗаписи (особенно заметно для
			// составного типа ar_Агент) - переустанавливаем их явно перед
			// записью, не полагаясь на то, что присвоение до Прочитать() уцелеет.
			МенеджерЗаписи.ar_Агент = КлючАгент;
			МенеджерЗаписи.ar_Якорь = Якорь;

			МенеджерЗаписи.ar_LastRunId = RunId;
			МенеджерЗаписи.ar_ИсторияСжатая = Хранилище;
			МенеджерЗаписи.ar_Обновлена = ТекущаяДатаВремя;
			Если ЗначениеЗаполнено(ПользовательUUID) Тогда
				МенеджерЗаписи.ar_Пользователь = ПользовательUUID;
			КонецЕсли;

			Если Не ЕстьЗапись Тогда
				МенеджерЗаписи.ar_Активна = Истина;
				МенеджерЗаписи.ar_Создана = ТекущаяДатаВремя;
			КонецЕсли;
			// При ЕстьЗапись=Истина: ar_Активна и ar_Создана НЕ трогаем
			// (не реактивируем деактивированные сессии - политика SESS-02).

			МенеджерЗаписи.Записать(Истина);

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		// SESS-Debug (диагностика в разработке, оставлено намеренно): контрольное
		// чтение и полный дамп регистра сразу после коммита - см. SESS-07
		// (составной тип ar_Агент устранил проблему пустой ссылки, но чтение
		// в следующем run всё ещё не находит запись - нужно видеть физическое
		// состояние таблицы сразу после записи, чтобы отличить "не записалось"
		// от "записалось, но следующий Прочитать() всё равно не находит").
		КонтрольнаяПроверка = РегистрыСведений.ar_Сессии.СоздатьМенеджерЗаписи();
		КонтрольнаяПроверка.ar_Агент = КлючАгент;
		КонтрольнаяПроверка.ar_Якорь = Якорь;
		КонтрольнаяПроверка.Прочитать();

		// ВЫРАЗИТЬ обязателен для составного (мультитипного) измерения ar_Агент -
		// без него представление поля в выборке запроса ненадёжно для диагностики
		// (тип/строковое значение могут отображаться некорректно, даже если
		// физическое значение в базе верное).
		ЗапросВсе = Новый Запрос(
			"ВЫБРАТЬ
			|	ВЫРАЗИТЬ(Сессии.ar_Агент КАК Строка(150)) КАК АгентСтрокой,
			|	Сессии.ar_Агент КАК АгентКакЕсть,
			|	Сессии.ar_Якорь КАК Якорь,
			|	Сессии.ar_LastRunId КАК LastRunId,
			|	Сессии.ar_Активна КАК Активна
			|ИЗ
			|	РегистрСведений.ar_Сессии КАК Сессии");
		ВыборкаВсе = ЗапросВсе.Выполнить().Выбрать();
		ВсегоСтрок = ВыборкаВсе.Количество();
		ДампВсехСтрок = "";
		Пока ВыборкаВсе.Следующий() Цикл
			ДампВсехСтрок = ДампВсехСтрок + СтрШаблон(
				"[АгентСтрокой='%1' АгентКакЕсть(тип:%2)='%3' Якорь(длина:%4)='%5' LastRunId=%6 Активна=%7] ",
				ВыборкаВсе.АгентСтрокой,
				ТипЗнч(ВыборкаВсе.АгентКакЕсть), Строка(ВыборкаВсе.АгентКакЕсть),
				СтрДлина(ВыборкаВсе.Якорь), ВыборкаВсе.Якорь,
				ВыборкаВсе.LastRunId, ВыборкаВсе.Активна);
		КонецЦикла;

		ar_СлужебныйЛог.Записать("ar_AuditЗащищённыйРежим.СохранитьСессиюПривилегированно",
			"sess_write_verify",
			СтрШаблон("КлючАгент='%1'(тип:%2), ОжидаемыйЯкорь(длина:%3)='%4', ВыбранСразуПослеЗаписи=%5, "
				+ "ЧерезМенеджерЗаписи.ar_Якорь(длина:%6)='%7', ВсегоСтрокВРегистре=%8, Дамп: %9",
				Строка(КлючАгент), ТипЗнч(КлючАгент),
				СтрДлина(Якорь), Якорь,
				КонтрольнаяПроверка.Выбран(),
				СтрДлина(КонтрольнаяПроверка.ar_Якорь), КонтрольнаяПроверка.ar_Якорь,
				ВсегоСтрок, ДампВсехСтрок),
			, RunId);

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Найти активные сессии для ротации по TTL (порог давности).
// Возвращает массив структур {Агент, Якорь} для записей ar_Сессии
// с ar_Активна=Истина и ar_Обновлена < Граница, первые 50.
//
// Параметры:
//  Граница - ДатаВремя - порог давности (сессии с Обновлена < Граница).
//
// Возвращаемое значение:
//  Массив<Структура{Агент, Якорь}> - пустой, если нет подходящих записей.
//
Функция НайтиСессииДляРотацииПривилегированно(Знач Граница) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 50
			|	Сессии.ar_Агент КАК Агент,
			|	Сессии.ar_Якорь КАК Якорь
			|ИЗ
			|	РегистрСведений.ar_Сессии КАК Сессии
			|ГДЕ
			|	Сессии.ar_Активна = ИСТИНА
			|	И Сессии.ar_Обновлена < &Граница
			|УПОРЯДОЧИТЬ ПО
			|	Сессии.ar_Обновлена";
		Запрос.УстановитьПараметр("Граница", Граница);

		Результат = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("Агент", Выборка.Агент);
			Элемент.Вставить("Якорь", Выборка.Якорь);
			Результат.Добавить(Элемент);
		КонецЦикла;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Закрыть сессию (установить ar_Активна=Ложь) для пары (Агент, Якорь).
// Идемпотентна: если запись не найдена или уже неактивна - no-op.
// Не изменяет ar_ИсторияСжатая, ar_LastRunId, ar_Создана, ar_Обновлена.
//
// Параметры:
//  Агент - СправочникСсылка.ar_Агенты - агент сессии.
//  Якорь - Строка, Неопределено - универсальный строковый якорь-контекст
//          сессии (chat:<uuid>/ref:<...>, см. SESS-05).
//
Процедура ЗакрытьСессиюПривилегированно(Знач Агент, Знач Якорь) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		КлючАгент = КлючИзмеренияАгент(Агент);

		МенеджерЗаписи = РегистрыСведений.ar_Сессии.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_Агент = КлючАгент;
		МенеджерЗаписи.ar_Якорь = Якорь;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.ar_Активна Тогда
			// SESS-07: переустановка измерений после Прочитать() - см.
			// СохранитьСессиюПривилегированно (тот же регистр, составной тип
			// ar_Агент, тот же риск сброса полей после Прочитать()).
			МенеджерЗаписи.ar_Агент = КлючАгент;
			МенеджерЗаписи.ar_Якорь = Якорь;
			МенеджерЗаписи.ar_Активна = Ложь;
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;
		// Запись не найдена ИЛИ уже неактивна - идемпотентный no-op.

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

#КонецОбласти
