////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_AuditЗащищённыйРежим (Audit Protected Mode).
//
// Централизованный привилегированный слой записи в audit-хранилище AgentRunner
// (Plan §1.3, §2.5, §2.8). Назначение: вынести точечное переключение
// УстановитьПривилегированныйРежим(Истина/Ложь) из непривилегированных модулей
// (прежде всего ar_Approval) в одну аудируемую точку.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь
// (см. манифест). Привилегии поднимаются ТОЧЕЧНО внутри каждой экспортной
// процедуры и всегда сбрасываются парным вызовом (Ложь) - и в ветке Исключение,
// и после КонецПопытки (эквивалент try/finally, Plan §1.3).
//
// Модуль тонкий: он НЕ содержит бизнес-логики. Каждая процедура только
//   1) поднимает привилегии,
//   2) делегирует конечному исполнителю (ar_AuditЗапуски/ar_AuditСобытия/
//      ar_AuditДействия для аудита; служебные процедуры ar_Approval для записи
//      в служебные регистры approval-очереди и ar_Запуски),
//   3) сбрасывает привилегии.
//
// AUD-06: платформа запрещает Privileged=true в общих модулях расширений
// ("Cannot use privileged common modules in extensions"), поэтому конечные
// модули аудита (ar_AuditДействия/ar_AuditЗапуски/ar_AuditСобытия) тоже
// Privileged=false. Оба уровня - и этот фасад, и (там, где фасад не
// используется) вызывающий код - точечно поднимают режим сами; платформа
// ведёт стек УстановитьПривилегированныйРежим, поэтому двойной подъём (если
// вдруг случится) безопасен: два (Истина) требуют двух (Ложь).
//
// Запрещено: Выполнить(), Вычислить() (Plan §1.3).
//
// См. спеку: .docs/specs/AUD-04.md, Plan §1.3, §2.5, §2.8.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

////////////////////////////////////////////////////////////////////////////////
// Фасады записи аудита (делегируют в aosAudit*).

// Записать/обновить статус запуска в ar_Запуски привилегированно (фасад над
// ar_AuditЗапуски). Поднимает привилегии, делегирует, сбрасывает привилегии.
//
// Параметры:
//  RunId                - Строка - идентификатор запуска (UUID).
//  Статус               - Строка - целевая операция аудита запуска:
//                         "Завершить" - перевести запуск в финальный статус;
//                         "Прервать"  - перевести в aborted.
//                         Иные значения трактуются как "Завершить".
//  ДополнительныеДанные - Структура, Неопределено - данные для ar_AuditЗапуски
//                         .Завершить (статус, ошибка и т.п.). Для "Прервать"
//                         игнорируется.
//
// Возвращаемое значение: нет.
//
// Исключения: пробрасываются наружу (вызывающий обрабатывает сам). Привилегии
//             при этом сбрасываются в ветке Исключение.
//
Процедура ЗаписатьСтатусЗапускаПривилегированно(Знач RunId, Знач Статус = "Завершить",
		Знач ДополнительныеДанные = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если Статус = "Прервать" Тогда
			ar_AuditЗапуски.ПрерватьЗапуск(RunId);
		Иначе
			ar_AuditЗапуски.Завершить(RunId, ДополнительныеДанные);
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Записать событие в ar_СобытияЗапуска привилегированно (фасад над
// ar_AuditСобытия). Поднимает привилегии, делегирует, сбрасывает привилегии.
//
// Параметры:
//  RunId      - Строка - идентификатор запуска (UUID) или "" (sentinel внутри
//               ar_AuditСобытия).
//  ТипСобытия - ПеречислениеСсылка.ar_ТипСобытия, Строка - тип события.
//  Payload    - Структура, Соответствие, Массив, Неопределено - данные события.
//
// Возвращаемое значение: нет.
//
// Исключения: ar_AuditСобытия.Зафиксировать сам не пробрасывает (логирует), но
//             фасад на всякий случай сбрасывает привилегии в ветке Исключение.
//
Процедура ЗаписатьСобытиеПривилегированно(Знач RunId, Знач ТипСобытия,
		Знач Payload = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ar_AuditСобытия.Зафиксировать(RunId, ТипСобытия, Payload);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Записать действие в ar_ДействияАгента привилегированно (фасад над
// ar_AuditДействия). Поднимает привилегии, делегирует, сбрасывает привилегии.
//
// Параметры:
//  RunId         - Строка - идентификатор запуска (UUID).
//  Sequence      - Число - порядковый номер действия.
//  ИмяTool       - Строка - имя инструмента.
//  АргументыJSON - Строка - аргументы действия в JSON.
//  RiskLevel     - Строка - уровень риска (Read/Draft/Write/Commit).
//  ResultRef     - Строка - ссылка/идентификатор результата.
//  ДопДанные     - Структура, Неопределено - дополнительные поля действия.
//
// Возвращаемое значение:
//  Булево - результат ar_AuditДействия.Записать (Истина при успешной записи).
//
// Исключения: пробрасываются наружу; привилегии сбрасываются в ветке Исключение.
//
Функция ЗаписатьДействиеПривилегированно(Знач RunId, Знач Sequence, Знач ИмяTool,
		Знач АргументыJSON, Знач RiskLevel = "", Знач ResultRef = "",
		Знач ДопДанные = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_AuditДействия.Записать(RunId, Sequence, ИмяTool, АргументыJSON,
			RiskLevel, ResultRef, ДопДанные);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Создать запись о запуске агента привилегированно (фасад над ar_AuditЗапуски).
// Поднимает привилегии, делегирует, сбрасывает привилегии. Централизована в
// фасаде (AUD-06), т.к. вызывается из нескольких точек (ar_RuntimeЗапуск -
// продовый путь постановки фонового задания; DataProcessors/ar_ТестЦикла -
// тестовая/отладочная обработка).
//
// Параметры:
//  RunId           - Строка - идентификатор запуска (UUID, длина 36). Обязателен.
//  СтруктураДанных - Структура - данные запуска (см. ar_AuditЗапуски.Создать).
//
// Возвращаемое значение: нет.
//
// Исключения: пробрасываются наружу (вызывающий обрабатывает сам). Привилегии
//             при этом сбрасываются в ветке Исключение.
//
Процедура СоздатьЗапускПривилегированно(Знач RunId, Знач СтруктураДанных) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ar_AuditЗапуски.Создать(RunId, СтруктураДанных);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Сохранить снимок состояния цикла рассуждения привилегированно (фасад над
// ar_AuditЗапуски.СохранитьСнимок). Поднимает привилегии, делегирует, сбрасывает
// привилегии. Централизована в фасаде (AUD-06), т.к. вызывается из нескольких
// точек (ar_RuntimeЦикл - паузы approval/input; ar_Approval - после применения
// approved-действия).
//
// Параметры:
//  RunId           - Строка - идентификатор запуска. Обязателен.
//  ДанныеСостояния - Структура, Соответствие, Массив или примитив - содержимое
//                    state (см. ar_AuditЗапуски.СохранитьСнимок).
//
// Возвращаемое значение: нет.
//
// Исключения: пробрасываются наружу (вызывающий обрабатывает сам). Привилегии
//             при этом сбрасываются в ветке Исключение.
//
Процедура СохранитьСнимокПривилегированно(Знач RunId, Знач ДанныеСостояния) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ar_AuditЗапуски.СохранитьСнимок(RunId, ДанныеСостояния);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Фасады доступа к служебным регистрам approval-хранилища.
//
// Логика чтения/записи регистров остаётся в служебных процедурах ar_Approval
// (модуль approval - владелец очереди). Фасад только инкапсулирует подъём/сброс
// привилегий и делегирует обратно: под уже поднятыми привилегиями вызывается
// непривилегированная служебная процедура ar_Approval, которая выполняет
// собственно работу с регистрами. Так весь "точечный privilege" сосредоточен
// здесь, а ar_Approval не переключает режим сам (Plan §1.3, §2.8).

// Поставить запись очереди approval (pending) и перевести запуск в паузу,
// привилегированно. Делегирует в ar_Approval.ЗаписатьЗаписьОчередиИПаузу.
//
// Параметры:
//  ApprovalId        - Строка - идентификатор записи очереди (UUID).
//  RunId             - Строка - идентификатор запуска (UUID).
//  Sequence          - Число  - порядковый номер действия.
//  ActionPayloadJSON - Строка - сериализованное действие.
//  Обоснование       - Строка - обоснование LLM.
//  IdempotencyKey    - Строка - ключ идемпотентности.
//
// Возвращаемое значение: нет.
//
Процедура ПоставитьВОчередьПривилегированно(Знач ApprovalId, Знач RunId, Знач Sequence,
		Знач ActionPayloadJSON, Знач Обоснование, Знач IdempotencyKey) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ar_Approval.ЗаписатьЗаписьОчередиИПаузу(ApprovalId, RunId, Sequence,
			ActionPayloadJSON, Обоснование, IdempotencyKey);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Обновить статус записи очереди approval привилегированно. Делегирует в
// ar_Approval.ОбновитьЗаписьApprovalБезПривилегий (та сама не пробрасывает).
//
// Параметры:
//  ApprovalId   - Строка    - идентификатор записи очереди (UUID).
//  НовыйСтатус  - Строка    - целевой статус.
//  ДопПараметры - Структура, Неопределено - доп. параметры перевода статуса.
//
// Возвращаемое значение:
//  Булево - результат служебной процедуры ar_Approval.
//
Функция ОбновитьЗаписьОчередиПривилегированно(Знач ApprovalId, Знач НовыйСтатус,
		Знач ДопПараметры = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.ОбновитьЗаписьApprovalБезПривилегий(ApprovalId,
			НовыйСтатус, ДопПараметры);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Прочитать запись очереди approval привилегированно. Делегирует в
// ar_Approval.ПрочитатьЗаписьОчередиБезПривилегий.
//
// Параметры:
//  ApprovalId - Строка - идентификатор записи очереди (UUID).
//
// Возвращаемое значение:
//  Структура, Неопределено - данные записи или Неопределено, если не найдена.
//
Функция ПрочитатьЗаписьОчередиПривилегированно(Знач ApprovalId) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.ПрочитатьЗаписьОчередиБезПривилегий(ApprovalId);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Прочитать текущий статус записи очереди approval привилегированно. Делегирует
// в ar_Approval.СтатусЗаписиОчередиБезПривилегий.
//
// Параметры:
//  ApprovalId - Строка - идентификатор записи очереди (UUID).
//
// Возвращаемое значение:
//  Строка - статус записи или "", если не найдена.
//
Функция СтатусЗаписиОчередиПривилегированно(Знач ApprovalId) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.СтатусЗаписиОчередиБезПривилегий(ApprovalId);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Найти ApprovalId по ключу идемпотентности и статусу привилегированно.
// Делегирует в ar_Approval.ApprovalIdПоКлючу.
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности.
//  Статус         - Строка - статус записи для поиска.
//
// Возвращаемое значение:
//  Строка - найденный ApprovalId или "".
//
Функция ApprovalIdПоКлючуПривилегированно(Знач IdempotencyKey, Знач Статус) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ar_Approval.ApprovalIdПоКлючу(IdempotencyKey, Статус);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Записать вопрос ask_user в очередь и перевести запуск в PausedForInput (TOOL-19 D5).
// Делегирует в ar_Approval.ЗаписатьВопросВОчередьИПаузуБезПривилегий.
//
// Параметры:
//  ApprovalId        - Строка - UUID записи очереди (сформирован ar_ToolInteraction).
//  RunId             - Строка - идентификатор запуска (UUID).
