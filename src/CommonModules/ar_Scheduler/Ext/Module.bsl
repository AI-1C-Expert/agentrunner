#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания ar_ПланировщикАгентов.
//
// Вызывается платформой раз в минуту от имени пользователя, указанного
// в регламентном задании (рекомендуется служебный пользователь агентов).
// Обходит активных агентов с заполненным расписанием Cron, проверяет
// совпадение с текущей минутой и стартует совпавших агентов в фоне
// через ar_RuntimeЗапуск.СтартоватьВФоне с триггером "cron".
//
// Параметров не принимает, значения не возвращает. Исключения наружу
// не пробрасывает: любая ошибка логируется в журнал регистрации.
//
Процедура ОбработатьПланировщик() Экспорт

	ДатаСеанса = ТекущаяДатаСеанса();
	МоментВремени = ДатаСеанса - Секунда(ДатаСеанса);

	Попытка
		ТаблицаАгентов = АгентыДляЗапуска(МоментВремени);
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Ошибка выборки агентов планировщиком: %1';
				|en='Scheduler failed to select agents: %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		Возврат;
	КонецПопытки;

	СлужебныйПользователь = ar_Константы.СлужебныйПользователь();

	Для Каждого СтрокаАгента Из ТаблицаАгентов Цикл
		// Защита на уровне одного агента: ошибка по одному агенту
		// не прерывает обход остальных.
		Попытка
			ЗапуститьАгента(СтрокаАгента.Ссылка, СлужебныйПользователь,
				СтрокаАгента.РутинаРеф, СтрокаАгента.ИнструкцияДобавка);
		Исключение
			ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибкиАгента = СтрШаблон(
				НСтр("ru='Ошибка запуска агента «%1» планировщиком: %2';
					|en='Scheduler failed to start agent ""%1"": %2'"),
				СтрокаАгента.Ссылка,
				ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаАгента.Ссылка,
				ТекстОшибкиАгента);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Обработчик регламентного задания ar_ВозобновлениеПослеApproval (SCHED-03).
//
// Вызывается платформой раз в минуту. Восстанавливает «последнюю милю»
// approval-flow: находит одобренные оператором записи очереди (статус
// "approved"), чьи запуски всё ещё в PausedForApproval, и запускает для
// каждого новое фоновое задание через ar_RuntimeЗапуск.Возобновить. Этот же
// тик обрабатывает истёкшие по TTL pending-записи через ar_Approval.Истечь.
//
// Параметров не принимает, значения не возвращает. Исключения наружу не
// пробрасывает: ошибка по одному ApprovalId логируется и не прерывает обход.
//
Процедура ОбработатьВозобновление() Экспорт

	// 1. Тик возобновления: approved → запуск нового фонового задания.
	Попытка
		ОдобренныеId = ar_Approval.НайтиОдобренныеApproval();
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Ошибка выборки одобренных approval-записей: %1';
				|en='Failed to select approved approval records: %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		ОдобренныеId = Новый Массив;
	КонецПопытки;

	Для Каждого ApprovalId Из ОдобренныеId Цикл
		// Защита на уровне одного ApprovalId: ошибка по одной записи не
		// прерывает обход остальных.
		Попытка
			ВозобновитьОдобренное(ApprovalId);
		Исключение
			ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(
				НСтр("ru='Ошибка возобновления по ApprovalId «%1»: %2';
					|en='Failed to resume by ApprovalId ""%1"": %2'"),
				ApprovalId,
				ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	// 2. Тик возобновления ask_user: answered → возобновление с UserAnswer (TOOL-19 D8).
	Попытка
		ОтвеченныеId = ar_Approval.НайтиОтвеченныеApproval();
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Ошибка выборки отвеченных approval-записей (ask_user): %1';
				|en='Failed to select answered approval records (ask_user): %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		ОтвеченныеId = Новый Массив;
	КонецПопытки;

	Для Каждого ApprovalId Из ОтвеченныеId Цикл
		Попытка
			ВозобновитьОтвеченное(ApprovalId);
		Исключение
			ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(
				НСтр("ru='Ошибка возобновления ask_user по ApprovalId «%1»: %2';
					|en='Failed to resume ask_user by ApprovalId ""%1"": %2'"),
				ApprovalId,
				ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	// 3. Тик истечения: pending/awaiting_input с истёкшим TTL → expired (APPR-04, TOOL-19 D16).
	Попытка
		ПросроченныеId = ar_Approval.НайтиПросроченныеApproval();
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Ошибка выборки просроченных approval-записей: %1';
				|en='Failed to select expired approval records: %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		ПросроченныеId = Новый Массив;
	КонецПопытки;

	Для Каждого ApprovalId Из ПросроченныеId Цикл
		Попытка
			ar_Approval.Истечь(ApprovalId);
		Исключение
			ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(
				НСтр("ru='Ошибка истечения approval по ApprovalId «%1»: %2';
					|en='Failed to expire approval by ApprovalId ""%1"": %2'"),
				ApprovalId,
				ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Обработчик регламентного задания ar_ОчисткаЗависших (SCHED-04).
//
// Вызывается платформой раз в минуту. Sweeper зависших запусков: находит
// запуски в статусах Running/PausedForApproval, чей ar_LastHeartbeat устарел
// (старше порога ar_Константы.HeartbeatПорогСек()), и переводит каждый такой
// запуск в статус Interrupted через ar_AuditЗапуски.ПрерватьЗапуск. Автоматический
// resume запрещён - возобновление только вручную из Run Viewer (UI-13).
//
// Параметров не принимает, значения не возвращает. Исключения наружу не
// пробрасывает: ошибка по одному RunId логируется и не прерывает обход
// остальных; ошибка выборки логируется и завершает тик.
//
Процедура ОбработатьОчисткуЗависших() Экспорт

	ПорогСек = ar_Константы.HeartbeatПорогСек();
	ГраницаHeartbeat = ТекущаяДатаСеанса() - ПорогСек;

	// Ожидание оператора живёт по своему, куда более длинному порогу: там
	// heartbeat обновлять некому, и общая граница убивала запуск раньше, чем
	// человек успевал нажать «Подтвердить» (см. ar_Константы).
	ПорогApprovalСек = ar_Константы.ПорогОжиданияApprovalСек();
	ГраницаApproval = ТекущаяДатаСеанса() - ПорогApprovalСек;

	Попытка
		ЗависшиеRunId = НайтиЗависшиеRunId(ГраницаHeartbeat, ГраницаApproval);
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='SCHED-04: ошибка выборки зависших запусков: %1';
				|en='SCHED-04: failed to select stale runs: %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		Возврат;
	КонецПопытки;

	Для Каждого RunId Из ЗависшиеRunId Цикл
		// Защита на уровне одного RunId: ошибка по одному запуску не прерывает
		// обход остальных.
		Попытка
			ПометитьЗависшимИЗафиксировать(RunId, ПорогСек, ПорогApprovalСек);
		Исключение
			ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(
				НСтр("ru='SCHED-04: ошибка обработки зависшего RunId=%1: %2';
					|en='SCHED-04: failed to process stale RunId=%1: %2'"),
				RunId,
				ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Закрыть устаревшие активные сессии по TTL (SESS-03).
// Регламентное задание ar_РотацияСессий, раз в сутки в 01:30.
//
// Алгоритм:
//   1. Guard: файловая база → Возврат (требуется client-server, Plan §1.1).
//   2. Граница = ТекущаяДатаСеанса() - ar_Константы.СессияTTLДней() * 86400.
//   3. Поиск первых 50 пар {Агент, Якорь} с ar_Активна=Истина и
//      ar_Обновлена < Граница через привилегированный фасад.
//   4. Для каждой пары — ЗакрытьСессиюПривилегированно (идетмпотентно,
//      ошибка по одной паре не прерывает обход остальных).
//   5. Каждое закрытие логируется в журнал регистрации (Информация).
//
Процедура ОбработатьРотациюСессий() Экспорт

	ДнейTTL = ar_Константы.СессияTTLДней();
	Граница = ТекущаяДатаСеанса() - ДнейTTL * 86400;

	Попытка
		СессииДляРотации = ar_AuditЗащищённыйРежим.НайтиСессииДляРотацииПривилегированно(Граница);
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='SESS-03: ошибка выборки сессий для ротации: %1';
				|en='SESS-03: failed to select sessions for rotation: %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		Возврат;
	КонецПопытки;

	Для Каждого Пара Из СессииДляРотации Цикл
		Попытка
			ar_AuditЗащищённыйРежим.ЗакрытьСессиюПривилегированно(Пара.Агент, Пара.Якорь);

			ТекстСобытия = СтрШаблон(
				НСтр("ru='SESS-03: сессия (Агент=%1, Якорь=%2) деактивирована по TTL';
					|en='SESS-03: session (Agent=%1, Anchor=%2) deactivated by TTL'"),
				Пара.Агент,
				Пара.Якорь);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Информация,
				,
				Пара.Агент,
				ТекстСобытия);
		Исключение
			ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(
				НСтр("ru='SESS-03: ошибка закрытия сессии (Агент=%1, Якорь=%2): %3';
					|en='SESS-03: failed to close session (Agent=%1, Anchor=%2): %3'"),
				Пара.Агент,
				Пара.Якорь,
				ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Обработчик регламентного задания ar_ОпросПодписокАгентов (EXT-08).
//
// Вызывается платформой раз в минуту. Сканирует справочник ar_ПодпискиАгентов,
// находит активные подписки на нестандартные типы объектов (не горячие EXT-07),
// ищет объекты этих типов, изменённые с момента последнего тика (watermark), и
// запускает агентов в фоне через ar_RuntimeЗапуск.СтартоватьВФоне.
//
// Watermark хранится в константе ar_ОпросПодписокПоследнийЗапуск.
// При критической ошибке watermark не обновляется — следующий тик повторит диапазон.
//
// Параметров не принимает, значения не возвращает. Исключения наружу
// не пробрасывает: ошибки логируются в журнал регистрации.
//
Процедура ОбработатьОпросПодписок() Экспорт

	// Загрузить активные типы из подписок.
	АктивныеТипы = Неопределено;
	Попытка
		АктивныеТипы = ПолучитьАктивныеТипыПодписок();
	Исключение
		ТекстОш = СтрШаблон(
			НСтр("ru='EXT-08: ошибка получения активных типов подписок: %1';
				|en='EXT-08: failed to get active subscription types: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОш);
		Возврат; // критическая ошибка - watermark не сдвигается
	КонецПопытки;

	Если АктивныеТипы.Количество() = 0 Тогда
		// Нет активных подписок - сдвинуть watermark и выйти.
		ОбновитьМеткуОпросаПривилегированно(ТекущаяДатаСеанса() - Секунда(ТекущаяДатаСеанса()));
		Возврат;
	КонецЕсли;

	// Определить watermark.
	ДатаС = Константы.ar_ОпросПодписокПоследнийЗапуск.Получить();
	Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
		// Первый запуск — обрабатываем последний час (аналог SCHED-07).
		ДатаС = ТекущаяДатаСеанса() - 3600;
	КонецЕсли;

	// Список горячих типов EXT-07 (исключаем дублирование).
	ГорячиеТипы = ar_ОбработчикПодписок.ГорячиеТипы();

	МаксОбъектов = 50;
	КритическаяОшибка = Ложь;

	Для Каждого СтрокаТипа Из АктивныеТипы Цикл
		ТипОбъекта = СтрокаТипа.ТипОбъекта;

		// D7: пропускаем горячие типы (push-модель EXT-07 быстрее).
		Если ГорячиеТипы.Найти(ТипОбъекта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Защита на уровне одного типа: ошибка одного типа не прерывает обход остальных.
		Попытка
			ОбработатьОдинТипПодписок(ТипОбъекта, ДатаС, МаксОбъектов);
		Исключение
			ТекстОш = СтрШаблон(
				НСтр("ru='EXT-08: ошибка обработки типа «%1»: %2';
					|en='EXT-08: error processing type ""%1"": %2'"),
				ТипОбъекта,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ТекстОш);
			КритическаяОшибка = Истина;
		КонецПопытки;
	КонецЦикла;

	// D6: watermark обновляется только при отсутствии критических ошибок.
	Если НЕ КритическаяОшибка Тогда
		ОбновитьМеткуОпросаПривилегированно(ТекущаяДатаСеанса() - Секунда(ТекущаяДатаСеанса()));
	КонецЕсли;

КонецПроцедуры

// Диагностика планировщика AgentRunner (SCHED-06).
//
// Проверяет дату последнего успешного завершения каждого из четырёх регламентных
// заданий AgentRunner (ar_ПланировщикАгентов, ar_ВозобновлениеПослеApproval,
// ar_ОчисткаЗависших, ar_РотацияСессий) и определяет статус liveness. Используется общей формой
// «Настройки AgentRunner» как ненавязчивый индикатор того, что регламентные задания
// включены и срабатывают на сервере (Plan §7: риск отключённых РЗ).
//
// Вся функция обёрнута в Попытку/Исключение: при ошибке чтения метаданных РЗ
// (например, недостаточно прав у пользователя формы) возвращается массив с одним
// элементом со статусом "error" и текстом ошибки в синониме - форма не падает.
//
// Возвращаемое значение:
//   Массив из Структура - по одному элементу на каждое РЗ AgentRunner. Ключи:
//     * Имя            - Строка - имя РЗ (например "ar_ПланировщикАгентов").
//     * Синоним        - Строка - человекочитаемое имя РЗ.
//     * ПоследнийЗапуск - Дата  - окончание последнего фонового задания
//                                 ('00010101', если задание не запускалось).
//     * СекундНазад    - Число  - секунд с момента последнего запуска (-1, если
//                                 не запускалось).
//     * Статус         - Строка - "ok" / "warning" / "error".
//
Функция ДиагностикаПланировщика() Экспорт

	Результат = Новый Массив;

	Попытка
		ПорогСек = ПорогПредупрежденияСек();

		ОписанияРЗ = Новый Массив;
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_ПланировщикАгентов",
			НСтр("ru='Планировщик агентов AgentRunner'; en='AgentRunner Scheduler'")));
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_ВозобновлениеПослеApproval",
			НСтр("ru='Возобновление агентов после подтверждения'; en='AgentRunner Resume After Approval'")));
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_ОчисткаЗависших",
			НСтр("ru='Очистка зависших запусков AgentRunner'; en='AgentRunner Stale Run Cleanup'")));
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_РотацияСессий",
			НСтр("ru='Ротация сессий AgentRunner'; en='AgentRunner Session Rotation'")));
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_ОбработчикУпоминаний",
			НСтр("ru='Обработчик упоминаний AgentRunner'; en='AgentRunner Mention Handler'")));
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_КомпакцияAudit",
			НСтр("ru='Компакция аудита AgentRunner'; en='AgentRunner Audit Compaction'")));
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_ОбновлениеПамятиAuto",
			НСтр("ru='Обновление памяти агентов AgentRunner (авто)'; en='AgentRunner Auto Memory Update'")));
		ОписанияРЗ.Добавить(ОписаниеРЗ(
			"ar_ОпросПодписокАгентов",
			НСтр("ru='Опрос подписок агентов AgentRunner'; en='AgentRunner Agent Subscription Poll'")));

		Для Каждого Описание Из ОписанияРЗ Цикл
			Результат.Добавить(ДиагностикаОдногоРЗ(Описание.Имя, Описание.Синоним, ПорогСек));
		КонецЦикла;
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = Новый Массив;
		ЭлементОшибки = Новый Структура;
		ЭлементОшибки.Вставить("Имя", "diagnostic_error");
		ЭлементОшибки.Вставить("Синоним", СтрШаблон(
			НСтр("ru='Не удалось получить статус планировщика: %1';
				|en='Failed to get scheduler status: %1'"),
			ПредставлениеОшибки));
		ЭлементОшибки.Вставить("ПоследнийЗапуск", '00010101');
		ЭлементОшибки.Вставить("СекундНазад", -1);
		ЭлементОшибки.Вставить("Статус", "error");
		Результат.Добавить(ЭлементОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Обработчик регламентного задания ar_ОбработчикУпоминаний (SCHED-07).
//
// Вызывается платформой раз в минуту. Сканирует источники сообщений/комментариев
// на наличие текстов с @<имя_агента>. При совпадении с активными рутинами типа
// "mention" запускает агента с триггером "mention" и якорем = объект, у которого
// оставлен комментарий. Watermark (последний обработанный момент) сохраняется в
// константе ar_ОбработчикУпоминанийПоследнийЗапуск.
//
// При критической ошибке watermark не обновляется: следующий тик повторно
// обработает тот же диапазон (идемпотентная защита от пропуска упоминаний).
//
Процедура ОбработатьУпоминания() Экспорт

	// Загрузить активные рутины типа mention.
	РутиныMention = НайтиАктивныеРутиныMention();
	Если РутиныMention.Количество() = 0 Тогда
		// Нет агентов с mention-рутинами - сдвинуть watermark и выйти.
		ОбновитьWatermarkУпоминаний(ТекущаяДатаСеанса());
		Возврат;
	КонецЕсли;

	// Определить дату начала выборки (watermark).
	ДатаС = Константы.ar_ОбработчикУпоминанийПоследнийЗапуск.Получить();
	Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
		// Первый запуск - обрабатываем только последний час.
		ДатаС = ТекущаяДатаСеанса() - 3600;
	КонецЕсли;

	МаксДатаСообщения = ДатаС;
	Попытка

		НовыеУпоминания = НайтиНовыеУпоминания(ДатаС);

		Для Каждого Упоминание Из НовыеУпоминания Цикл
			Если ЗначениеЗаполнено(Упоминание.ДатаСообщения) Тогда
				МаксДатаСообщения = Макс(МаксДатаСообщения, Упоминание.ДатаСообщения);
			КонецЕсли;
			Попытка
				ОбработатьОдноУпоминание(Упоминание, РутиныMention);
			Исключение
				ТекстОшибки = СтрШаблон(
					НСтр("ru='SCHED-07: ошибка обработки упоминания: %1';
						|en='SCHED-07: mention processing error: %1'"),
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьЖурналаРегистрации(
					ИмяСобытияЖурнала(),
					УровеньЖурналаРегистрации.Предупреждение,
					,
					,
					ТекстОшибки);
			КонецПопытки;
		КонецЦикла;

		// Обновить watermark до максимальной даты обработанных сообщений.
		ОбновитьWatermarkУпоминаний(МаксДатаСообщения);

	Исключение
		// Критичная ошибка (недоступна БД, ошибка API СВ) - watermark НЕ обновляется,
		// чтобы следующий тик повторил обработку того же диапазона.
		ТекстОшибки = СтрШаблон(
			НСтр("ru='SCHED-07: критичная ошибка обработчика упоминаний: %1';
				|en='SCHED-07: mention handler critical error: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Обработчик регламентного задания ar_ОбновлениеПамятиAuto (SCHED-09).
//
// Вызывается платформой раз в сутки в 04:00. Анализирует завершённые запуски
// агентов за последние сутки, выявляет повторяющиеся паттерны (частые
// инструменты, повторяющиеся ошибки, итоги запусков) и ставит proposals
// в ar_ОчередьApproval через ar_Approval.Поставить.
//
// Ключевое ограничение: задание НИКОГДА не модифицирует ar_ПамятьАгента
// напрямую. Любое предложение проходит через approval-flow (APPR-01).
// Фактическая запись происходит в ar_ВозобновлениеПослеApproval (SCHED-03).
//
// Параметров не принимает, значения не возвращает. Исключения наружу
// не пробрасывает: ошибка логируется в журнал регистрации.
//
Процедура ОбработатьОбновлениеПамятиAuto() Экспорт

	ПорогДаты = ПорогДатыАнализа();

	// Ветка 1: агентные завершённые запуски (исходный SCHED-09).
	Попытка
		ТаблицаАгентов = АгентыСЗавершённымиЗапусками(ПорогДаты);

		Если ТаблицаАгентов.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Информация,
				,
				,
				НСтр("ru='SCHED-09: нет завершённых запусков агентов за сутки';
					|en='SCHED-09: no completed agent runs in the last 24 hours'"));
		Иначе
			РезультатОбработки = ОбработатьАгентовMemoryAuto(ТаблицаАгентов, ПорогДаты);

			Если РезультатОбработки.ВсегоProposals > 0 Тогда
				ЗафиксироватьMetaMemoryProposed(
					РезультатОбработки.КоличествоАгентов,
					РезультатОбработки.ВсегоProposals,
					ПорогДаты);
			КонецЕсли;

			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Информация,
				,
				,
				СтрШаблон(
					НСтр("ru='SCHED-09: сформировано %1 proposals для %2 агентов';
						|en='SCHED-09: formed %1 proposals for %2 agents'"),
					РезультатОбработки.ВсегоProposals,
					РезультатОбработки.КоличествоАгентов));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон(
				НСтр("ru='SCHED-09: критичная ошибка обработчика обновления памяти (агенты): %1';
					|en='SCHED-09: critical error in auto memory update handler (agents): %1'"),
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	// Ветка 2: no-agent завершённые сессии, группировка по пользователю (MEM-03, D7).
	// Отдельный Попытка/Исключение - ошибка в одной ветке не должна блокировать другую.
	Попытка
		ТаблицаПользователей = ПользователиСЗавершённымиЗапусками(ПорогДаты);

		Если ТаблицаПользователей.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Информация,
				,
				,
				НСтр("ru='SCHED-09: нет завершённых no-agent запусков за сутки';
					|en='SCHED-09: no completed no-agent runs in the last 24 hours'"));
		Иначе
			РезультатОбработкиПользователей = ОбработатьПользователейMemoryAuto(ТаблицаПользователей, ПорогДаты);

			Если РезультатОбработкиПользователей.ВсегоProposals > 0 Тогда
				ЗафиксироватьMetaMemoryProposedПользователи(
					РезультатОбработкиПользователей.КоличествоПользователей,
					РезультатОбработкиПользователей.ВсегоProposals,
					ПорогДаты);
			КонецЕсли;

			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Информация,
				,
				,
				СтрШаблон(
					НСтр("ru='SCHED-09: сформировано %1 proposals для %2 пользователей (no-agent)';
						|en='SCHED-09: formed %1 proposals for %2 users (no-agent)'"),
					РезультатОбработкиПользователей.ВсегоProposals,
					РезультатОбработкиПользователей.КоличествоПользователей));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон(
				НСтр("ru='SCHED-09: критичная ошибка обработчика обновления памяти (пользователи): %1';
					|en='SCHED-09: critical error in auto memory update handler (users): %1'"),
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Обработчик регламентного задания ar_КомпакцияAudit (SCHED-08).
//
// Раз в сутки (ночное окно 03:00) удаляет устаревшие строки регистра
// ar_СобытияЗапуска. Глубина хранения задаётся константой
// ar_КомпакцияAuditДней (по умолчанию 90 дней).
// После успешного цикла фиксирует мета-событие AuditPurged.
//
// Двойная защита от несанкционированного удаления:
//   1) Константа ar_РазрешитьОчисткуAudit = Истина.
//   2) Текущий пользователь сессии имеет роль ar_РольОчисткаAudit.
//
// Параметров не принимает, значения не возвращает. Исключения наружу
// не пробрасывает: ошибка логируется в журнал регистрации.
//
Процедура ОбработатьКомпакциюAudit() Экспорт

	// Двойная проверка разрешения на очистку.
	Если Не КомпакцияAuditРазрешена() Тогда
		Возврат;
	КонецЕсли;

	ДнейНастройка = 0;
	ПорогДаты = ПорогДатыКомпакции(ДнейНастройка);

	ВсегоУдалено = 0;
	МаксИтераций = 100;
	НомерИтерации = 0;

	Попытка
		Пока НомерИтерации < МаксИтераций Цикл
			НомерИтерации = НомерИтерации + 1;
			УдаленоВПорции = УдалитьУстаревшиеСобытияПорцией(ПорогДаты);
			ВсегоУдалено = ВсегоУдалено + УдаленоВПорции;
			Если УдаленоВПорции = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		ЗафиксироватьMetaAuditPurged(ВсегоУдалено, ПорогДаты, ДнейНастройка);

		ТекстСобытияЖР = СтрШаблон(
			НСтр("ru='SCHED-08: компакция audit завершена: удалено %1 записей, порог %2, retention %3 дн.';
				|en='SCHED-08: audit compaction done: deleted %1 rows, threshold %2, retention %3 days'"),
			ВсегоУдалено,
			Формат(ПорогДаты, "ДФ='dd.MM.yyyy'"),
			ДнейНастройка);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСобытияЖР);
	Исключение
		ТекстОшибкиЖР = СтрШаблон(
			НСтр("ru='SCHED-08: ошибка компакции audit: %1';
				|en='SCHED-08: audit compaction error: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибкиЖР);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Диагностика одного регламентного задания AgentRunner (SCHED-06).
//
// Получает объект РЗ через БСП, читает дату окончания последнего фонового
// задания и определяет статус по порогу и флагу использования РЗ.
//
// Логика статуса (DoD D6):
//   * "ok"      - запуск был и СекундНазад < ПорогСек.
//   * "error"   - РЗ выключено (Использование = Ложь) - в т.ч. если ни разу не
//                 запускалось при выключенном задании.
//   * "warning" - РЗ включено, но последний запуск старше порога либо запусков
//                 ещё не было (ждём первого тика).
//
// Параметры:
//   ИмяМетаданных - Строка - имя РЗ (например "ar_ПланировщикАгентов").
//   Синоним       - Строка - человекочитаемое имя РЗ.
//   ПорогСек      - Число  - порог предупреждения в секундах.
//
// Возвращаемое значение:
//   Структура - {Имя, Синоним, ПоследнийЗапуск, СекундНазад, Статус}.
//
Функция ДиагностикаОдногоРЗ(Знач ИмяМетаданных, Знач Синоним, Знач ПорогСек)

	ПоследнийЗапуск = '00010101';
	СекундНазад = -1;

	ОбъектМетаданных = Метаданные.РегламентныеЗадания.Найти(ИмяМетаданных);
	Если ОбъектМетаданных = Неопределено Тогда
		// РЗ отсутствует в конфигурации (расширение не применено корректно).
		Возврат ЭлементДиагностики(ИмяМетаданных, Синоним, ПоследнийЗапуск, СекундНазад, "error");
	КонецЕсли;

	РЗ = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(ОбъектМетаданных);

	ПоследнееЗадание = РЗ.ПоследнееЗадание;
	Если ПоследнееЗадание <> Неопределено И ЗначениеЗаполнено(ПоследнееЗадание.Конец) Тогда
		ПоследнийЗапуск = ПоследнееЗадание.Конец;
		СекундНазад = ТекущаяДатаСеанса() - ПоследнийЗапуск;
		Если СекундНазад < 0 Тогда
			СекундНазад = 0;
		КонецЕсли;
	КонецЕсли;

	Если Не РЗ.Использование Тогда
		Статус = "error";
	ИначеЕсли СекундНазад >= 0 И СекундНазад < ПорогСек Тогда
		Статус = "ok";
	Иначе
		Статус = "warning";
	КонецЕсли;

	Возврат ЭлементДиагностики(ИмяМетаданных, Синоним, ПоследнийЗапуск, СекундНазад, Статус);

КонецФункции

// Конструктор структуры описания РЗ для перечня проверяемых заданий (SCHED-06).
//
// Параметры:
//   Имя     - Строка - имя РЗ (например "ar_ПланировщикАгентов").
//   Синоним - Строка - человекочитаемое имя РЗ.
//
// Возвращаемое значение:
//   Структура - {Имя, Синоним}.
//
Функция ОписаниеРЗ(Знач Имя, Знач Синоним)

	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Синоним", Синоним);
	Возврат Результат;

КонецФункции

// Конструктор структуры элемента диагностики (SCHED-06).
//
// Параметры:
//   Имя             - Строка - имя РЗ.
//   Синоним         - Строка - человекочитаемое имя РЗ.
//   ПоследнийЗапуск - Дата   - окончание последнего фонового задания.
//   СекундНазад     - Число  - секунд с последнего запуска (-1, если не было).
//   Статус          - Строка - "ok" / "warning" / "error".
//
// Возвращаемое значение:
//   Структура - {Имя, Синоним, ПоследнийЗапуск, СекундНазад, Статус}.
//
Функция ЭлементДиагностики(Знач Имя, Знач Синоним, Знач ПоследнийЗапуск, Знач СекундНазад, Знач Статус)

	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Синоним", Синоним);
	Результат.Вставить("ПоследнийЗапуск", ПоследнийЗапуск);
	Результат.Вставить("СекундНазад", СекундНазад);
	Результат.Вставить("Статус", Статус);
	Возврат Результат;

КонецФункции

// Порог предупреждения диагностики планировщика в секундах (SCHED-06).
// Обёртка над ar_Константы для единого места чтения и тестируемости.
//
// Возвращаемое значение:
//   Число - порог в секундах (дефолт 300).
//
Функция ПорогПредупрежденияСек()

	Возврат ar_Константы.ПорогПредупрежденияПланировщика();

КонецФункции

// Выбирает агентов для запуска по двум источникам: основной - справочник
// ar_Рутины (ROUT-02), fallback - legacy ar_Агенты.ar_РасписаниеCron (SCHED-02).
//
// На этапе 2 (ROUT-02) основным источником стал справочник ar_Рутины:
// активные cron-рутины с совпадающим расписанием. Legacy-ветка сохранена
// как fallback до миграции данных в ROUT-03 (помечена DEPRECATED).
// Anti-duplication: если агент есть в обоих источниках - запускается только
// через routines (один запуск в тик).
//
// Параметры:
//   МоментВремени - Дата - момент проверки (начало минуты).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки:
//     * Ссылка          - СправочникСсылка.ar_Агенты - агент к запуску.
//     * РутинаРеф       - СправочникСсылка.ar_Рутины - рутина (пустая для legacy).
//     * ИнструкцияДобавка - Строка - переопределение инструкции (пустая для legacy).
//
Функция АгентыДляЗапуска(МоментВремени)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("РутинаРеф");
	Результат.Колонки.Добавить("ИнструкцияДобавка");

	// 1. Основной источник: ar_Рутины (ROUT-02).
	Попытка
		ТаблицаИзРутин = АгентыИзРутин(МоментВремени);
		Для Каждого СтрокаРутины Из ТаблицаИзРутин Цикл
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Ссылка = СтрокаРутины.Ссылка;
			НоваяСтрока.РутинаРеф = СтрокаРутины.РутинаРеф;
			НоваяСтрока.ИнструкцияДобавка = СтрокаРутины.ИнструкцияДобавка;
		КонецЦикла;
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='ROUT-02: ошибка выборки агентов из рутин: %1';
				|en='ROUT-02: failed to select agents from routines: %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		ТаблицаИзРутин = Новый ТаблицаЗначений;
	КонецПопытки;

	// 2. Fallback: legacy ar_Агенты.ar_РасписаниеCron (SCHED-02).
	// DEPRECATED: удалить после ROUT-03 (миграция данных).
	Попытка
		ТаблицаLegacy = АгентыИзLegacyРасписания(МоментВремени);
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='SCHED-02: ошибка выборки агентов из legacy-расписания: %1';
				|en='SCHED-02: failed to select agents from legacy schedule: %1'"),
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		ТаблицаLegacy = Новый ТаблицаЗначений;
	КонецПопытки;

	// 3. Anti-duplication: если агент уже есть в routines - не добавлять из legacy.
	АгентыИзРутинМножество = Новый Соответствие;
	Для Каждого СтрокаРутины Из ТаблицаИзРутин Цикл
		АгентыИзРутинМножество.Вставить(СтрокаРутины.Ссылка, Истина);
	КонецЦикла;

	Для Каждого СтрокаLegacy Из ТаблицаLegacy Цикл
		Если АгентыИзРутинМножество.Получить(СтрокаLegacy.Ссылка) = Истина Тогда
			// Агент уже будет запущен через routines - пропускаем legacy.
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Ссылка = СтрокаLegacy.Ссылка;
		НоваяСтрока.РутинаРеф = Справочники.ar_Рутины.ПустаяСсылка();
		НоваяСтрока.ИнструкцияДобавка = "";
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Основной источник агентов для запуска: активные cron-рутины (ROUT-02).
//
// Запрос к ar_Рутины с фильтрами: активна, тип=cron, не помечена на удаление,
// агент активен и не помечен. Для каждой строки парсит ar_ПараметрыJSON,
// извлекает expression, проверяет совпадение с моментом через ar_Cron.
//
// Параметры:
//   МоментВремени - Дата - момент проверки (начало минуты).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: Ссылка, РутинаРеф, ИнструкцияДобавка.
//
Функция АгентыИзРутин(МоментВремени)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("РутинаРеф");
	Результат.Колонки.Добавить("ИнструкцияДобавка");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Рутины.Ссылка КАК РутинаРеф,
		|	Рутины.ar_Агент КАК Агент,
		|	Рутины.ar_ПараметрыJSON КАК ПараметрыJSON,
		|	Рутины.ar_ИнструкцияПереопределение КАК ИнструкцияПереопределение
		|ИЗ
		|	Справочник.ar_Рутины КАК Рутины
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
		|		ПО Рутины.ar_Агент = Агенты.Ссылка
		|ГДЕ
		|	НЕ Рутины.ПометкаУдаления
		|	И Рутины.ar_Активна
		|	И Рутины.ar_ТипТриггера = ""cron""
		|	И НЕ Агенты.ПометкаУдаления
		|	И Агенты.ar_Активен";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		// Парсинг JSON: {"expression": "0 9 * * 1-5"}.
		Параметры = ar_JSON.ИзJSON(Выборка.ПараметрыJSON);
		Если Параметры = Неопределено Тогда
			// Пустой или невалидный JSON - пропускаем без лога.
			Продолжить;
		КонецЕсли;

		Выражение = Неопределено;
		Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
			Выражение = Параметры.Получить("expression");
		ИначеЕсли ТипЗнч(Параметры) = Тип("Структура") Тогда
			Параметры.Свойство("expression", Выражение);
		КонецЕсли;

		Если Выражение = Неопределено Или ПустаяСтрока(Строка(Выражение)) Тогда
			// Нет expression - пропускаем.
			Продолжить;
		КонецЕсли;

		// Проверка совпадения cron-выражения с моментом.
		Если Не ar_Cron.СовпадаетСВременем(Строка(Выражение), МоментВремени) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Ссылка = Выборка.Агент;
		НоваяСтрока.РутинаРеф = Выборка.РутинаРеф;
		НоваяСтрока.ИнструкцияДобавка = Строка(Выборка.ИнструкцияПереопределение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// DEPRECATED: Legacy-источник агентов для запуска (SCHED-02).
// Удалить после ROUT-03 (миграция данных из ar_Агенты.ar_РасписаниеCron
// в ar_Рутины).
//
// Параметры:
//   МоментВремени - Дата - момент проверки (начало минуты).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: Ссылка.
//
Функция АгентыИзLegacyРасписания(МоментВремени)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Ссылка КАК Ссылка,
		|	Агенты.ar_РасписаниеCron КАК РасписаниеCron
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	НЕ Агенты.ПометкаУдаления
		|	И Агенты.ar_Активен
		|	И Агенты.ar_РасписаниеCron <> """"";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если ar_Cron.СовпадаетСВременем(Выборка.РасписаниеCron, МоментВремени) Тогда
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Ссылка = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Стартует агента в фоне через ar_RuntimeЗапуск с триггером "cron".
// Результат запуска логируется в журнал регистрации; исключение не
// генерируется: запись audit-события выполняет сам ar_RuntimeЗапуск.
//
// Параметры:
//   СсылкаАгент     - СправочникСсылка.ar_Агенты - запускаемый агент.
//   ПользовательРеф - СправочникСсылка.Пользователи - служебный
//                     пользователь (пустая ссылка, если не настроен;
//                     тогда ar_RuntimeЗапуск подставит текущего).
//   РутинаРеф       - СправочникСсылка.ar_Рутины - рутина-источник запуска
//                     (ROUT-02). Неопределено или пустая ссылка для legacy.
//   ИнструкцияДобавка - Строка - переопределение инструкции из рутины
//                     (ROUT-04). Пустая строка если не задано.
//
Процедура ЗапуститьАгента(СсылкаАгент, ПользовательРеф,
		РутинаРеф = Неопределено, ИнструкцияДобавка = "")

	// SCHED-05: rate-limiter. До постановки задания проверяем, не превышен ли
	// лимит одновременных запусков на агента и суммарный лимит активных запусков.
	// Излишки не отбрасываются - следующий тик планировщика (через 60 сек) снова
	// проверит cron-совпадение и квоту.
	//
	// safe-fail: при ошибке подсчёта счётчиков запуск в данном тике пропускается
	// (лучше пропустить тик, чем запустить агента в обход rate-limit).
	Попытка
		Счётчики = ПодсчитатьСчётчики(СсылкаАгент);
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(
			НСтр("ru='SCHED-05: ошибка подсчёта активных запусков для агента «%1», запуск пропущен: %2';
				|en='SCHED-05: failed to count active runs for agent ""%1"", run skipped: %2'"),
			СсылкаАгент,
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			СсылкаАгент,
			ТекстОшибки);
		Возврат;
	КонецПопытки;

	ЛимитАгента = ЛимитПоАгенту();
	Если Счётчики.ПоАгенту >= ЛимитАгента Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru='SCHED-05: превышен лимит одновременных запусков агента «%1»: активных %2, лимит %3. Запуск отложен до следующего тика';
				|en='SCHED-05: per-agent concurrency limit exceeded for agent ""%1"": active %2, limit %3. Run deferred to next tick'"),
			СсылкаАгент,
			Счётчики.ПоАгенту,
			ЛимитАгента);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			СсылкаАгент,
			ТекстСобытия);
		Возврат;
	КонецЕсли;

	ЛимитВсего = ЛимитСуммарный();
	Если Счётчики.ВсегоАктивных >= ЛимитВсего Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru='SCHED-05: превышен суммарный лимит активных запусков (агент «%1»): всего активных %2, лимит %3. Запуск отложен до следующего тика';
				|en='SCHED-05: global concurrency limit exceeded (agent ""%1""): total active %2, limit %3. Run deferred to next tick'"),
			СсылкаАгент,
			Счётчики.ВсегоАктивных,
			ЛимитВсего);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			СсылкаАгент,
			ТекстСобытия);
		Возврат;
	КонецЕсли;

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "cron");
	Если ЗначениеЗаполнено(ПользовательРеф) Тогда
		КонтекстТриггера.Вставить("ПользовательРеф", ПользовательРеф);
	КонецЕсли;
	// ROUT-02: прокидываем ссылку на рутину для прослеживаемости.
	Если РутинаРеф <> Неопределено И ЗначениеЗаполнено(РутинаРеф) Тогда
		КонтекстТриггера.Вставить("РутинаРеф", РутинаРеф);
	КонецЕсли;
	// ROUT-04: прокидываем переопределение инструкции (если задано).
	Если ЗначениеЗаполнено(ИнструкцияДобавка) Тогда
		КонтекстТриггера.Вставить("ИнструкцияДобавка", ИнструкцияДобавка);
	КонецЕсли;

	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(СсылкаАгент, КонтекстТриггера);

	Если Результат.Успех Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru='Агент «%1» поставлен в очередь запуска планировщиком (RunId %2)';
				|en='Agent ""%1"" queued by scheduler (RunId %2)'"),
			СсылкаАгент,
			Результат.RunId);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			СсылкаАгент,
			ТекстСобытия);
	Иначе
		ТекстСобытия = СтрШаблон(
			НСтр("ru='Агент «%1» не запущен планировщиком. Причина: %2';
				|en='Agent ""%1"" not started by scheduler. Reason: %2'"),
			СсылкаАгент,
			Результат.Причина);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			СсылкаАгент,
			ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

// Возобновляет один одобренный запуск по записи очереди approval (SCHED-03).
// Читает RunId из записи под привилегиями и вызывает ar_RuntimeЗапуск.Возобновить.
// Результат логируется в журнал регистрации; исключение наружу не генерируется
// (внешний цикл всё равно защищён Попыткой на уровне одного ApprovalId).
//
// Параметры:
//   ApprovalId - Строка - идентификатор записи очереди (измерение ar_ApprovalId).
//
Процедура ВозобновитьОдобренное(Знач ApprovalId)

	ДанныеЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно(ApprovalId);
	Если ДанныеЗаписи = Неопределено Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru='SCHED-03: запись очереди approval не найдена, ApprovalId %1';
				|en='SCHED-03: approval queue record not found, ApprovalId %1'"),
			ApprovalId);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстСобытия);
		Возврат;
	КонецЕсли;

	Результат = ar_RuntimeЗапуск.Возобновить(ДанныеЗаписи.RunId);

	Если Результат.Успех Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru='SCHED-03: возобновлён RunId=%1';
				|en='SCHED-03: resumed RunId=%1'"),
			ДанныеЗаписи.RunId);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСобытия);
	Иначе
		ТекстСобытия = СтрШаблон(
			НСтр("ru='SCHED-03: не удалось возобновить RunId=%1: %2';
				|en='SCHED-03: failed to resume RunId=%1: %2'"),
			ДанныеЗаписи.RunId,
			Результат.Причина);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

// Возобновить запуск после ответа оператора на вопрос ask_user (TOOL-19 D8).
// Читает RunId и UserAnswer из записи очереди "answered" под привилегиями.
// Передаёт UserAnswer в КонтекстРезюме для инъекции в ar_RuntimeЦикл.
// Вызывает ar_RuntimeЗапуск.Возобновить с триггером "input_resume".
//
// Параметры:
//   ApprovalId - Строка - идентификатор записи очереди (измерение ar_ApprovalId).
//
Процедура ВозобновитьОтвеченное(Знач ApprovalId)

	ДанныеЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно(ApprovalId);
	Если ДанныеЗаписи = Неопределено Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru='TOOL-19: запись очереди ask_user не найдена, ApprovalId %1';
				|en='TOOL-19: ask_user queue record not found, ApprovalId %1'"),
			ApprovalId);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстСобытия);
		Возврат;
	КонецЕсли;

	// Извлечь UserAnswer из payload.
	UserAnswer = "";
	Попытка
		Payload = ar_JSON.ИзJSON(ДанныеЗаписи.ActionPayloadJSON);
		Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
			UserAnswer = ?(ТипЗнч(Payload.Получить("user_answer")) = Тип("Строка"),
				Payload.Получить("user_answer"), "");
		ИначеЕсли ТипЗнч(Payload) = Тип("Структура") Тогда
			ЗначениеОтвета = "";
			Payload.Свойство("user_answer", ЗначениеОтвета);
			UserAnswer = ?(ТипЗнч(ЗначениеОтвета) = Тип("Строка"), ЗначениеОтвета, "");
		КонецЕсли;
	Исключение
		// Если payload не распарсился - возобновляем с пустым ответом.
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru='TOOL-19: не удалось разобрать payload ApprovalId=%1, ответ пуст';
				|en='TOOL-19: failed to parse payload ApprovalId=%1, answer is empty'"),
			ApprovalId);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстПредупреждения);
	КонецПопытки;

	// Контекст резюме: approval_id + user_answer для инъекции в ar_RuntimeЦикл.
	КонтекстРезюме = Новый Структура;
	КонтекстРезюме.Вставить("approval_id", ApprovalId);
	КонтекстРезюме.Вставить("user_answer", UserAnswer);

	// Багфикс UI-30: параметры были смещены - строка "input_resume" попадала в
	// КонтекстОтклонения, а структура КонтекстРезюме - в строковый параметр
	// ТриггерПереопределен, из-за чего возобновление после ответа падало всегда.
	Результат = ar_RuntimeЗапуск.Возобновить(ДанныеЗаписи.RunId,
		Неопределено, "input_resume", КонтекстРезюме);

	Если Результат.Успех Тогда
		ТекстСобытия = СтрШаблон(
			НСтр("ru='TOOL-19: возобновлён RunId=%1 (ask_user answered)';
				|en='TOOL-19: resumed RunId=%1 (ask_user answered)'"),
			ДанныеЗаписи.RunId);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСобытия);
	Иначе
		ТекстСобытия = СтрШаблон(
			НСтр("ru='TOOL-19: не удалось возобновить RunId=%1 (ask_user): %2';
				|en='TOOL-19: failed to resume RunId=%1 (ask_user): %2'"),
			ДанныеЗаписи.RunId,
			Результат.Причина);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

// Найти зависшие RunId через привилегированный фасад (SCHED-04). Фасад над
// ar_AuditЗащищённыйРежим.НайтиЗависшиеЗапускиПривилегированно.
//
// Параметры:
//   ГраницаHeartbeat - Дата - граница давности heartbeat.
//
// Возвращаемое значение:
//   Массив - элементы типа Строка (RunId). До 50 записей.
//
Функция НайтиЗависшиеRunId(Знач ГраницаHeartbeat, Знач ГраницаApproval = Неопределено)

	Возврат ar_AuditЗащищённыйРежим.НайтиЗависшиеЗапускиПривилегированно(
		ГраницаHeartbeat, ГраницаApproval);

КонецФункции

// Пометить один зависший запуск Interrupted и зафиксировать audit-событие
// (SCHED-04). Вызывает ar_AuditЗапуски.ПрерватьЗапуск (guard на финальные
// статусы - внутри метода), затем ar_AuditСобытия.Зафиксировать и пишет
// Предупреждение в журнал регистрации.
//
// Фиксация audit-события защищена внутренней Попыткой: если запись события не
// удалась, основное действие (Прервать) уже выполнено - логируем Предупреждение,
// не пробрасывая ошибку.
//
// Параметры:
//   RunId            - Строка - идентификатор зависшего запуска.
//   ПорогСек         - Число  - применённый порог heartbeat (для payload).
//   ПорогApprovalСек - Число  - порог ожидания подтверждения. Необязательный:
//                      порогов два (см. ОбработатьОчисткуЗависших), а статус
//                      запуска сюда не доходит - поэтому в payload пишутся оба,
//                      чтобы по событию можно было понять, какой сработал.
//
Процедура ПометитьЗависшимИЗафиксировать(Знач RunId, Знач ПорогСек,
	Знач ПорогApprovalСек = Неопределено)

	ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunId, "Прервать");

	Попытка
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("reason", "heartbeat_timeout");
		ДанныеСобытия.Вставить("threshold_sec", ПорогСек);
		Если ПорогApprovalСек <> Неопределено Тогда
			ДанныеСобытия.Вставить("approval_threshold_sec", ПорогApprovalСек);
		КонецЕсли;
		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "run_interrupted_by_sweeper", ДанныеСобытия);
	Исключение
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru='SCHED-04: не удалось записать audit-событие для RunId=%1: %2';
				|en='SCHED-04: failed to record audit event for RunId=%1: %2'"),
			RunId,
			ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстПредупреждения);
	КонецПопытки;

	ТекстСобытия = СтрШаблон(
		НСтр("ru='SCHED-04: RunId=%1 помечен Interrupted (heartbeat устарел)';
			|en='SCHED-04: RunId=%1 marked Interrupted (stale heartbeat)'"),
		RunId);
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурнала(),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		ТекстСобытия);

КонецПроцедуры

// Подсчитать активные запуски для rate-limiter (SCHED-05) через привилегированный
// фасад ar_AuditЗащищённыйРежим.ПодсчитатьАктивныеЗапускиПривилегированно.
// Исключения пробрасываются наружу - их ловит Попытка в ЗапуститьАгента (safe-fail).
//
// Параметры:
//   СсылкаАгент - СправочникСсылка.ar_Агенты - агент для per-agent подсчёта.
//
// Возвращаемое значение:
//   Структура - {ПоАгенту: Число, ВсегоАктивных: Число}.
//
Функция ПодсчитатьСчётчики(Знач СсылкаАгент)

	Возврат ar_AuditЗащищённыйРежим.ПодсчитатьАктивныеЗапускиПривилегированно(СсылкаАгент);

КонецФункции

// Лимит одновременных запусков на одного агента (SCHED-05). Обёртка над
// ar_Константы для единого места чтения лимита и тестируемости.
//
// Возвращаемое значение:
//   Число - предел одновременных запусков агента.
//
Функция ЛимитПоАгенту()

	Возврат ar_Константы.МаксОдновременныхЗапусковАгента();

КонецФункции

// Суммарный лимит активных запусков (SCHED-05). Обёртка над ar_Константы.
//
// Возвращаемое значение:
//   Число - предел суммарных активных запусков.
//
Функция ЛимитСуммарный()

	Возврат ar_Константы.МаксСуммарныхЗапусков();

КонецФункции

// Имя события для журнала регистрации.
//
// Возвращаемое значение:
//   Строка - имя события.
//
Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru='Планировщик AgentRunner'; en='AgentRunner Scheduler'");

КонецФункции

// ===== SCHED-07: Обработчик упоминаний =====

// Находит активные рутины типа "mention" с активными агентами (SCHED-07).
//
// Запрос к ar_Рутины с фильтрами: не помечена, активна, тип=mention.
// Внутреннее соединение с ar_Агенты: не помечен, активен.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки:
//     * РутинаРеф           - СправочникСсылка.ar_Рутины
//     * АгентСсылка         - СправочникСсылка.ar_Агенты
//     * АгентНаименование   - Строка
//     * ИнструкцияДобавка   - Строка
//     * ПараметрыJSON       - Строка
//
Функция НайтиАктивныеРутиныMention()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("РутинаРеф");
	Результат.Колонки.Добавить("АгентСсылка");
	Результат.Колонки.Добавить("АгентНаименование");
	Результат.Колонки.Добавить("ИнструкцияДобавка");
	Результат.Колонки.Добавить("ПараметрыJSON");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Рутины.Ссылка КАК РутинаРеф,
		|	Агенты.Ссылка КАК АгентСсылка,
		|	Агенты.Наименование КАК АгентНаименование,
		|	Рутины.ar_ИнструкцияПереопределение КАК ИнструкцияДобавка,
		|	Рутины.ar_ПараметрыJSON КАК ПараметрыJSON
		|ИЗ
		|	Справочник.ar_Рутины КАК Рутины
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
		|		ПО Рутины.ar_Агент = Агенты.Ссылка
		|ГДЕ
		|	НЕ Рутины.ПометкаУдаления
		|	И Рутины.ar_Активна
		|	И Рутины.ar_ТипТриггера = ""mention""
		|	И НЕ Агенты.ПометкаУдаления
		|	И Агенты.ar_Активен";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.РутинаРеф = Выборка.РутинаРеф;
		Строка.АгентСсылка = Выборка.АгентСсылка;
		Строка.АгентНаименование = Строка(Выборка.АгентНаименование);
		Строка.ИнструкцияДобавка = Строка(Выборка.ИнструкцияДобавка);
		Строка.ПараметрыJSON = Строка(Выборка.ПараметрыJSON);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Опрашивает источники новых упоминаний начиная с ДатаС (SCHED-07).
//
// Стратегия 1 (MVP): СистемаВзаимодействия - если подключена.
// При недоступности СВ логируется Информация и возвращается пустой массив.
// Лимит выборки: первые 500 сообщений за тик (защита от burst).
//
// Параметры:
//   ДатаС - Дата - watermark, начало диапазона выборки.
//
// Возвращаемое значение:
//   Массив из Структура - элементы с полями:
//     * ТекстСообщения - Строка
//     * ЯкорьСсылка    - ЛюбаяСсылка или Неопределено
//     * ДатаСообщения  - Дата
//
Функция НайтиНовыеУпоминания(ДатаС)

	Результат = Новый Массив;

	// Стратегия 1: Система взаимодействия (платформенный API 8.3.26+).
	Если НЕ СистемаВзаимодействия.Подключена() Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			НСтр("ru='SCHED-07: Система взаимодействия недоступна, mention-trigger пропущен';
				|en='SCHED-07: CollaborationSystem not connected, mention-trigger skipped'"));
		Возврат Результат;
	КонецЕсли;

	Попытка
		ПрочитатьСообщенияСВВРезультат(ДатаС, Результат);
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru='SCHED-07: ошибка чтения сообщений СистемыВзаимодействия: %1';
				|en='SCHED-07: CollaborationSystem read error: %1'"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Читает сообщения из СистемыВзаимодействия начиная с ДатаС и добавляет
// их в Результат (SCHED-07). Выделено для снижения когнитивной сложности
// НайтиНовыеУпоминания. Лимит: первые 500 сообщений за вызов.
//
// Параметры:
//   ДатаС    - Дата   - watermark начала выборки.
//   Результат - Массив - накапливаемый результат (изменяется по ссылке).
//
Процедура ПрочитатьСообщенияСВВРезультат(ДатаС, Результат)

	// Максимум сообщений за один тик (защита от burst-сценария).
	МаксСообщений = 500;

	Отбор = Новый ОтборСообщенийСистемыВзаимодействия;
	Отбор.После = ДатаС;

	КоличествоОбработано = 0;
	Для Каждого Сообщение Из СистемаВзаимодействия.ПолучитьСообщения(Отбор) Цикл
		Если КоличествоОбработано >= МаксСообщений Тогда
			Прервать;
		КонецЕсли;

		ЭлементСообщения = ПреобразоватьСообщениеСВВСтруктуру(Сообщение);
		Если ЭлементСообщения <> Неопределено Тогда
			Результат.Добавить(ЭлементСообщения);
		КонецЕсли;

		КоличествоОбработано = КоличествоОбработано + 1;
	КонецЦикла;

КонецПроцедуры

// Преобразует одно сообщение СВ в структуру для обработки упоминаний (SCHED-07).
// Возвращает Неопределено, если текст сообщения недоступен или пуст.
//
// Параметры:
//   Сообщение - СообщениеСистемыВзаимодействия - сообщение из СВ.
//
// Возвращаемое значение:
//   Структура - {ТекстСообщения, ЯкорьСсылка, ДатаСообщения} или Неопределено.
//
Функция ПреобразоватьСообщениеСВВСтруктуру(Сообщение)

	// Конвертируем ФорматированнаяСтрока -> Строка.
	ТекстСообщения = "";
	Попытка
		ТекстСообщения = Строка(Сообщение.Текст);
	Исключение
		// Конвертация не удалась - пропускаем сообщение.
		Возврат Неопределено;
	КонецПопытки;

	Если ПустаяСтрока(ТекстСообщения) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Якорь: связанный объект ИБ из данных сообщения (global mention если не задан).
	ЯкорьСсылка = ИзвлечьЯкорьИзСообщенияСВ(Сообщение);

	Элемент = Новый Структура;
	Элемент.Вставить("ТекстСообщения", ТекстСообщения);
	Элемент.Вставить("ЯкорьСсылка", ЯкорьСсылка);
	Элемент.Вставить("ДатаСообщения", Сообщение.Дата);
	Возврат Элемент;

КонецФункции

// Извлекает ссылку на объект ИБ-якорь из данных сообщения СВ (SCHED-07).
// Возвращает Неопределено при отсутствии или недоступности якоря.
//
// Параметры:
//   Сообщение - СообщениеСистемыВзаимодействия.
//
// Возвращаемое значение:
//   ЛюбаяСсылка или Неопределено.
//
Функция ИзвлечьЯкорьИзСообщенияСВ(Сообщение)

	Попытка
		Если Сообщение.Данные <> Неопределено
			И Сообщение.Данные.Ссылка <> Неопределено
			И ЗначениеЗаполнено(Сообщение.Данные.Ссылка) Тогда
			Возврат Сообщение.Данные.Ссылка;
		КонецЕсли;
	Исключение
		// Якорь недоступен (поле Данные или Ссылка недоступно в текущем контексте).
		// Продолжаем без якоря (global mention - UC-4).
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			НСтр("ru='SCHED-07: якорь из сообщения СВ недоступен, запуск без контекста';
				|en='SCHED-07: anchor from CV message unavailable, starting without context'"));
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Извлекает уникальные @-упоминания из текста (SCHED-07).
//
// Парсит подстроки вида "@Имя" где Имя - последовательность букв/цифр/подчеркивания.
// Символ "@" должен стоять в начале строки или после пробельного символа
// (так не захватываем "@" внутри email-адресов типа user@example.com).
// Возвращает массив уникальных имён; регистр не нормализуется (сравнение при
// поиске рутины выполняется регистронезависимо через НРег).
//
// Параметры:
//   Текст - Строка - текст сообщения/комментария.
//
// Возвращаемое значение:
//   Массив из Строка - уникальные имена агентов без символа "@".
//
Функция ИзвлечьУпоминания(Текст)

	Имена = Новый Массив;
	УникальныеИмена = Новый Соответствие;

	ДлинаТекста = СтрДлина(Текст);
	Позиция = 1;

	Пока Позиция <= ДлинаТекста Цикл
		СимволАт = Сред(Текст, Позиция, 1);

		Если СимволАт <> "@" Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		// Пропускаем "@" внутри слова (например в email: user@example.com).
		Если НЕ АтСтоитПослеПробела(Текст, Позиция) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		// Читаем имя после "@": буквы, цифры, подчёркивание (кириллица и латиница).
		НачалоИмени = Позиция + 1;
		КонецИмени = НайтиКонецИмениАгента(Текст, НачалоИмени, ДлинаТекста);

		ДлинаИмени = КонецИмени - НачалоИмени;
		Если ДлинаИмени > 0 Тогда
			Имя = Сред(Текст, НачалоИмени, ДлинаИмени);
			// Дедупликация: добавляем только уникальные (регистронезависимо).
			Если УникальныеИмена.Получить(НРег(Имя)) = Неопределено Тогда
				УникальныеИмена.Вставить(НРег(Имя), Истина);
				Имена.Добавить(Имя);
			КонецЕсли;
			Позиция = КонецИмени;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Проверяет, что "@" в позиции стоит в начале строки или после пробельного символа.
// Используется для исключения "@" внутри email-адресов (SCHED-07).
//
// Параметры:
//   Текст   - Строка - исходная строка.
//   Позиция - Число  - позиция символа "@".
//
// Возвращаемое значение:
//   Булево - Истина, если "@" стоит в допустимой позиции.
//
Функция АтСтоитПослеПробела(Текст, Позиция)

	Если Позиция = 1 Тогда
		Возврат Истина;
	КонецЕсли;

	СимволДо = Сред(Текст, Позиция - 1, 1);
	Возврат СимволДо = " "
		ИЛИ СимволДо = Символы.Таб
		ИЛИ СимволДо = Символы.ПС
		ИЛИ СимволДо = Символы.ВК;

КонецФункции

// Находит позицию конца имени агента в строке начиная с НачалоИмени (SCHED-07).
// Допустимые символы имени: цифры (0-9), латиница (A-Z, a-z), кириллица, подчёркивание.
//
// Параметры:
//   Текст       - Строка - исходная строка.
//   НачалоИмени - Число  - позиция первого символа имени.
//   ДлинаТекста - Число  - длина строки (для оптимизации).
//
// Возвращаемое значение:
//   Число - позиция первого символа после имени (НачалоИмени, если имя пустое).
//
Функция НайтиКонецИмениАгента(Текст, НачалоИмени, ДлинаТекста)

	Позиция = НачалоИмени;
	Пока Позиция <= ДлинаТекста Цикл
		КодСим = КодСимвола(Сред(Текст, Позиция, 1));
		Если НЕ ЭтоДопустимыйСимволИмениАгента(КодСим) Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Позиция;

КонецФункции

// Проверяет, является ли символ допустимым в имени агента (SCHED-07).
// Допустимы: цифры ASCII, латиница, подчёркивание, кириллица (U+0410+).
//
// Параметры:
//   КодСим - Число - код символа (от КодСимвола()).
//
// Возвращаемое значение:
//   Булево - Истина, если символ допустим.
//
Функция ЭтоДопустимыйСимволИмениАгента(КодСим)

	// Цифры 0-9
	Если КодСим >= 48 И КодСим <= 57 Тогда
		Возврат Истина;
	КонецЕсли;
	// Латиница A-Z
	Если КодСим >= 65 И КодСим <= 90 Тогда
		Возврат Истина;
	КонецЕсли;
	// Латиница a-z
	Если КодСим >= 97 И КодСим <= 122 Тогда
		Возврат Истина;
	КонецЕсли;
	// Подчёркивание _
	Если КодСим = 95 Тогда
		Возврат Истина;
	КонецЕсли;
	// Кириллица: основной блок U+0410-U+044F (А-я) и дополнение U+0450-U+045F
	Если КодСим >= 1040 И КодСим <= 1103 Тогда
		Возврат Истина;
	КонецЕсли;
	// Кириллица: буква Ё (U+0401=1025) и ё (U+0451=1105)
	Если КодСим = 1025 ИЛИ КодСим = 1105 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Ищет рутину в таблице по имени агента (SCHED-07).
//
// Сначала пробует точное совпадение (регистронезависимо), затем
// совпадение по первому слову наименования агента.
//
// Параметры:
//   ИмяАгента    - Строка - имя из @-упоминания.
//   РутиныMention - ТаблицаЗначений - из НайтиАктивныеРутиныMention().
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений или Неопределено.
//
Функция НайтиРутинуПоИмениАгента(ИмяАгента, РутиныMention)

	ИмяАгентаНРег = НРег(ИмяАгента);

	// Проход 1: точное совпадение наименования.
	Для Каждого Строка Из РутиныMention Цикл
		Если НРег(Строка.АгентНаименование) = ИмяАгентаНРег Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;

	// Проход 2: совпадение по первому слову наименования агента.
	Для Каждого Строка Из РутиныMention Цикл
		ЧастиНаименования = СтрРазделить(Строка.АгентНаименование, " ", Ложь);
		Если ЧастиНаименования.Количество() > 0
			И НРег(ЧастиНаименования[0]) = ИмяАгентаНРег Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Обрабатывает одно сообщение: извлекает упоминания и запускает агентов (SCHED-07).
//
// Параметры:
//   Упоминание    - Структура - {ТекстСообщения, ЯкорьСсылка, ДатаСообщения}.
//   РутиныMention - ТаблицаЗначений - из НайтиАктивныеРутиныMention().
//
Процедура ОбработатьОдноУпоминание(Упоминание, РутиныMention)

	ИменаАгентов = ИзвлечьУпоминания(Упоминание.ТекстСообщения);

	Для Каждого ИмяАгента Из ИменаАгентов Цикл
		СтрокаРутины = НайтиРутинуПоИмениАгента(ИмяАгента, РутиныMention);
		Если СтрокаРутины = Неопределено Тогда
			// Упоминание есть, но нет активного агента с такой mention-рутиной.
			Продолжить;
		КонецЕсли;

		ЗапуститьАгентаПоУпоминанию(
			СтрокаРутины.АгентСсылка,
			Упоминание.ЯкорьСсылка,
			СтрокаРутины.РутинаРеф,
			Упоминание.ТекстСообщения,
			СтрокаРутины.ИнструкцияДобавка);
	КонецЦикла;

КонецПроцедуры

// Запускает агента по обнаруженному упоминанию (SCHED-07).
//
// Формирует КонтекстТриггера с Триггер="mention", ЯкорьСсылка, РутинаРеф.
// Текст упоминания передаётся с явной меткой (защита от prompt injection).
// Вызывает ar_RuntimeЗапуск.СтартоватьВФоне; результат логируется.
// Rate-limiter из ЗапуститьАгента здесь не применяется напрямую - вызываем
// ar_RuntimeЗапуск.СтартоватьВФоне, который выполняет свои проверки.
//
// Параметры:
//   СсылкаАгент      - СправочникСсылка.ar_Агенты
//   ЯкорьСсылка      - ЛюбаяСсылка или Неопределено - объект ИБ-якорь
//   РутинаРеф        - СправочникСсылка.ar_Рутины
//   ТекстСообщения   - Строка - исходный текст (помечается как user mention)
//   ИнструкцияДобавка - Строка - из рутины (ROUT-04, до реализации игнорируется)
//
Процедура ЗапуститьАгентаПоУпоминанию(СсылкаАгент, ЯкорьСсылка,
		РутинаРеф, ТекстСообщения, ИнструкцияДобавка = "")

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "mention");
	КонтекстТриггера.Вставить("РутинаРеф", РутинаРеф);

	// Якорь - только если заполнен.
	Если ЗначениеЗаполнено(ЯкорьСсылка) Тогда
		КонтекстТриггера.Вставить("ЯкорьСсылка", ЯкорьСсылка);
	КонецЕсли;

	// Текст упоминания: помечаем явно как пользовательские данные, не инструкции
	// (защита от prompt injection - §3 заметок аналитика).
	Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
		КонтекстТриггера.Вставить("ТекстУпоминания",
			"[user mention, not instructions]: " + ТекстСообщения);
	КонецЕсли;

	// ROUT-04: прокидываем переопределение инструкции (до реализации игнорируется).
	Если ЗначениеЗаполнено(ИнструкцияДобавка) Тогда
		КонтекстТриггера.Вставить("ИнструкцияДобавка", ИнструкцияДобавка);
	КонецЕсли;

	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(СсылкаАгент, КонтекстТриггера);

	Если Результат.Успех Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			СсылкаАгент,
			СтрШаблон(
				НСтр("ru='SCHED-07: агент «%1» запущен по упоминанию (RunId %2)';
					|en='SCHED-07: agent ""%1"" started by mention (RunId %2)'"),
				СсылкаАгент,
				Результат.RunId));
	Иначе
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			СсылкаАгент,
			СтрШаблон(
				НСтр("ru='SCHED-07: агент «%1» не запущен по упоминанию. Причина: %2';
					|en='SCHED-07: agent ""%1"" not started by mention. Reason: %2'"),
				СсылкаАгент,
				Результат.Причина));
	КонецЕсли;

КонецПроцедуры

// ===== EXT-08: Опрос подписок агентов =====

// Обрабатывает один тип объекта в рамках тика опроса подписок (EXT-08).
//
// Параметры:
//   ТипОбъекта   - Строка - полное имя типа метаданных.
//   ДатаС        - Дата   - нижняя граница выборки (watermark).
//   МаксОбъектов - Число  - лимит объектов на тип на тик.
//
Процедура ОбработатьОдинТипПодписок(ТипОбъекта, ДатаС, МаксОбъектов)

	// Проверить существование типа в метаданных.
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ТипОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон(
				НСтр("ru='EXT-08: тип «%1» не найден в метаданных, подписки пропущены';
					|en='EXT-08: type ""%1"" not found in metadata, subscriptions skipped'"),
				ТипОбъекта));
		Возврат;
	КонецЕсли;

	// D9: поддерживаем только Справочник, Документ, РегистрСведений.
	ТипМетаданных = ТипЗнч(ОбъектМетаданных);
	Если ТипМетаданных <> Тип("ОбъектМетаданных.Справочник")
		И ТипМетаданных <> Тип("ОбъектМетаданных.Документ")
		И ТипМетаданных <> Тип("ОбъектМетаданных.РегистрСведений") Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон(
				НСтр("ru='EXT-08: тип «%1» не поддерживается для polling (только Справочник, Документ, РегистрСведений)';
					|en='EXT-08: type ""%1"" is not supported for polling (only Catalog, Document, InformationRegister)'"),
				ТипОбъекта));
		Возврат;
	КонецЕсли;

	// Найти измененные объекты с watermark до now.
	МассивОбъектов = НайтиИзмененныеОбъекты(ТипОбъекта, ДатаС, МаксОбъектов);
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Загрузить подписки для данного типа.
	Подписки = НайтиПодпискиДляТипа(ТипОбъекта);
	Если Подписки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Для каждого найденного объекта и каждой подписки — проверить фильтр и запустить агента.
	Для Каждого ОбъектСсылка Из МассивОбъектов Цикл
		ОбъектДанных = Неопределено;
		Попытка
			ОбъектДанных = ОбъектСсылка.ПолучитьОбъект();
		Исключение
			// Объект недоступен — пропускаем без прерывания тика.
			Продолжить;
		КонецПопытки;

		Если ОбъектДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Подписка Из Подписки Цикл
			// D11: ошибка одной пары (агент, объект) не прерывает обход остальных.
			Попытка
				ОбработатьОдинОбъектОднуПодписку(ОбъектДанных, ОбъектСсылка, Подписка, ТипОбъекта);
			Исключение
				ЗаписьЖурналаРегистрации(
					ИмяСобытияЖурнала(),
					УровеньЖурналаРегистрации.Ошибка,
					,
					ОбъектСсылка,
					СтрШаблон(
						НСтр("ru='EXT-08: ошибка обработки объекта «%1» для подписки «%2»: %3';
							|en='EXT-08: error processing object ""%1"" for subscription ""%2"": %3'"),
						ОбъектСсылка,
						Подписка.Ссылка,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Проверить фильтр и запустить агента для одной пары (объект, подписка) (EXT-08).
//
// Параметры:
//   ОбъектДанных - ОбъектДанных                - прочитанный объект.
//   ОбъектСсылка - ЛюбаяСсылка                 - ссылка на объект.
//   Подписка     - СтрокаТаблицыЗначений        - строка из НайтиПодпискиДляТипа.
//   ТипОбъекта   - Строка                       - полное имя типа метаданных.
//
Процедура ОбработатьОдинОбъектОднуПодписку(ОбъектДанных, ОбъектСсылка, Подписка, ТипОбъекта)

	// Проверить JSON-фильтр (переиспользуем из ar_ОбработчикПодписок EXT-07).
	Если НЕ ar_ОбработчикПодписок.ПроверитьФильтр(Подписка, ОбъектДанных) Тогда
		Возврат;
	КонецЕсли;

	// D12: КонтекстТриггера с Триггер="event" и ЯкорьСсылка.
	КонтекстТриггера = ar_ОбработчикПодписок.СформироватьКонтекстТриггера(
		ОбъектДанных, Подписка, ТипОбъекта);

	// Запуск агента в фоне.
	Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Подписка.ar_Агент, КонтекстТриггера);
	Если НЕ Результат.Успех Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			ОбъектСсылка,
			СтрШаблон(
				НСтр("ru='EXT-08: агент «%1» не запущен. Причина: %2';
					|en='EXT-08: agent ""%1"" not started. Reason: %2'"),
				Подписка.ar_Агент,
				Результат.Причина));
	КонецЕсли;

КонецПроцедуры

// Выбрать уникальные типы объектов из активных подписок (EXT-08).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: ТипОбъекта (Строка), КоличествоПодписок (Число).
//
Функция ПолучитьАктивныеТипыПодписок()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	П.ar_Событие1С КАК Событие1С,
		|	КОЛИЧЕСТВО(П.Ссылка) КАК КоличествоПодписок
		|ИЗ
		|	Справочник.ar_ПодпискиАгентов КАК П
		|ГДЕ
		|	П.ar_Включён = ИСТИНА
		|	И П.ПометкаУдаления = ЛОЖЬ
		|СГРУППИРОВАТЬ ПО
		|	П.ar_Событие1С";

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТипОбъекта");
	Результат.Колонки.Добавить("КоличествоПодписок");

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СобытиеСтрока = Строка(Выборка.Событие1С);
		// Извлечь тип объекта: убираем суффиксы .ПриЗаписи / .ПередЗаписью.
		ТипОбъекта = ИзвлечьТипОбъектаИзСобытия(СобытиеСтрока);
		Если ПустаяСтрока(ТипОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Строка = Результат.Добавить();
		Строка.ТипОбъекта = ТипОбъекта;
		Строка.КоличествоПодписок = Выборка.КоличествоПодписок;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлечь полное имя типа из строки события (EXT-08).
// Убирает суффиксы .ПриЗаписи / .ПередЗаписью / .ПриПроведении.
//
// Параметры:
//   СобытиеСтрока - Строка - значение поля ar_Событие1С.
//
// Возвращаемое значение:
//   Строка - полное имя типа объекта (например, "Справочник.ТовариИУслуги").
//
Функция ИзвлечьТипОбъектаИзСобытия(СобытиеСтрока)

	Суффиксы = Новый Массив;
	Суффиксы.Добавить(".ПриЗаписи");
	Суффиксы.Добавить(".ПередЗаписью");
	Суффиксы.Добавить(".ПриПроведении");
	Суффиксы.Добавить(".ПередПроведением");

	Для Каждого Суффикс Из Суффиксы Цикл
		Позиция = СтрНайти(СобытиеСтрока, Суффикс);
		Если Позиция > 0 Тогда
			Возврат Лев(СобытиеСтрока, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	// Нет суффикса — считаем, что это уже тип объекта.
	Возврат СобытиеСтрока;

КонецФункции

// Найти изменённые объекты указанного типа за период с watermark (EXT-08).
//
// Поддерживаемые типы:
//   - Справочник: фильтр по ДатаМодификации.
//   - Документ:   фильтр по ДатаМодификации.
//   - РегистрСведений: фильтр по МоментВремени (деградированный режим без фильтра даты).
//
// Параметры:
//   ТипОбъектаСтрока - Строка - полное имя типа метаданных.
//   ДатаС            - Дата   - нижняя граница (watermark).
//   МаксОбъектов     - Число  - лимит на тип на тик.
//
// Возвращаемое значение:
//   Массив из ЛюбаяСсылка.
//
Функция НайтиИзмененныеОбъекты(ТипОбъектаСтрока, ДатаС, МаксОбъектов)

	Результат = Новый Массив;

	ЧастиИмени = СтрРазделить(ТипОбъектаСтрока, ".", Ложь);
	Если ЧастиИмени.Количество() < 2 Тогда
		Возврат Результат;
	КонецЕсли;

	КатегорияОбъекта = ЧастиИмени[0];
	ИмяОбъекта       = ЧастиИмени[1];

	Если КатегорияОбъекта = "Справочник" ИЛИ КатегорияОбъекта = "Документ" Тогда
		Результат = НайтиИзмененныеСпрДок(КатегорияОбъекта, ИмяОбъекта, ДатаС, МаксОбъектов);
	ИначеЕсли КатегорияОбъекта = "РегистрСведений" Тогда
		// Для регистров используем деградированный режим (выборка последних N записей без фильтра даты).
		Результат = НайтиИзмененныеРегистрСведений(ИмяОбъекта, МаксОбъектов);
	Иначе
		// Тип не поддерживается — проверка выполнена выше в ОбработатьОдинТипПодписок.
		Результат = Новый Массив;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Найти измененные записи Справочника или Документа с фильтром по ДатаМодификации (EXT-08).
// Лимит: фиксированные 50 объектов на тик (D10).
//
// Параметры:
//   КатегорияОбъекта - Строка - "Справочник" или "Документ".
//   ИмяОбъекта       - Строка - имя объекта без категории.
//   ДатаС            - Дата   - нижняя граница (watermark).
//   МаксОбъектов     - Число  - лимит (используется для управления циклом выборки).
//
// Возвращаемое значение:
//   Массив из ЛюбаяСсылка.
//
Функция НайтиИзмененныеСпрДок(КатегорияОбъекта, ИмяОбъекта, ДатаС, МаксОбъектов)

	Результат = Новый Массив;

	// Формируем динамический текст запроса с именем таблицы (класс объекта и имя).
	// ПЕРВЫЕ в 1С принимает только литерал — используем фиксированное значение 50 (D10).
	// Параметры ДатаС подставляются безопасно через УстановитьПараметр.
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	" + КатегорияОбъекта + "." + ИмяОбъекта + " КАК Т
		|ГДЕ
		|	Т.ДатаМодификации > &ДатаС
		|	И НЕ Т.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаМодификации";

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаС", ДатаС);

		Выборка = Запрос.Выполнить().Выбрать();
		КоличествоДобавлено = 0;
		Пока Выборка.Следующий() И КоличествоДобавлено < МаксОбъектов Цикл
			Результат.Добавить(Выборка.Ссылка);
			КоличествоДобавлено = КоличествоДобавлено + 1;
		КонецЦикла;
	Исключение
		// ДатаМодификации отсутствует — пробуем без фильтра даты (degraded mode).
		Результат = НайтиСпрДокБезФильтраДаты(КатегорияОбъекта, ИмяОбъекта, МаксОбъектов);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Найти записи Справочника/Документа без фильтра по дате (деградированный режим, EXT-08).
// Используется для типов без реквизита ДатаМодификации.
//
// Параметры:
//   КатегорияОбъекта - Строка - категория.
//   ИмяОбъекта       - Строка - имя объекта.
//   МаксОбъектов     - Число  - лимит.
//
// Возвращаемое значение:
//   Массив из ЛюбаяСсылка.
//
Функция НайтиСпрДокБезФильтраДаты(КатегорияОбъекта, ИмяОбъекта, МаксОбъектов)

	Результат = Новый Массив;

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	" + КатегорияОбъекта + "." + ИмяОбъекта + " КАК Т
		|ГДЕ
		|	НЕ Т.ПометкаУдаления";

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;

		Выборка = Запрос.Выполнить().Выбрать();
		КоличествоДобавлено = 0;
		Пока Выборка.Следующий() И КоличествоДобавлено < МаксОбъектов Цикл
			Результат.Добавить(Выборка.Ссылка);
			КоличествоДобавлено = КоличествоДобавлено + 1;
		КонецЦикла;
	Исключение
		// Запрос не удался — пробрасываем исключение, лог в вызывающем коде.
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Найти записи регистра сведений (деградированный режим без фильтра даты, EXT-08).
// UC-3: для независимых непериодических РС нет встроенного МоментВремени.
//
// Параметры:
//   ИмяОбъекта   - Строка - имя РС без категории.
//   МаксОбъектов - Число  - лимит.
//
// Возвращаемое значение:
//   Массив из ЛюбаяСсылка (пустой — регистры не имеют Ссылка).
//
Функция НайтиИзмененныеРегистрСведений(ИмяОбъекта, МаксОбъектов)

	// Регистры сведений не имеют Ссылка — polling по ним реализуется через набор записей.
	// В текущей реализации возвращаем пустой массив (объекты для фильтрации недоступны).
	// TODO EXT-08: расширить поддержку РС через МоментВремени (периодические РС).
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурнала(),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		СтрШаблон(
			НСтр("ru='EXT-08: РегистрСведений.%1 - polling объектов не реализован (нет Ссылка), тип пропущен';
				|en='EXT-08: InformationRegister.%1 - object polling not implemented (no Ref), type skipped'"),
			ИмяОбъекта));

	Возврат Новый Массив;

КонецФункции

// Загрузить активные подписки для данного типа объекта (EXT-08).
//
// Параметры:
//   ТипОбъектаСтрока - Строка - полное имя типа метаданных.
//
// Возвращаемое значение:
//   ТаблицаЗначений - с колонками: Ссылка, ar_Агент, ar_ФильтрJSON.
//
Функция НайтиПодпискиДляТипа(ТипОбъектаСтрока)

	// Ищем подписки, где событие начинается с имени типа объекта.
	СобытиеТип = ТипОбъектаСтрока + ".ПриЗаписи";
	СобытиеТипБезСуффикса = ТипОбъектаСтрока;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Ссылка КАК Ссылка,
		|	П.ar_Агент КАК ar_Агент,
		|	П.ar_ФильтрJSON КАК ar_ФильтрJSON
		|ИЗ
		|	Справочник.ar_ПодпискиАгентов КАК П
		|ГДЕ
		|	П.ar_Событие1С = &СобытиеТип
		|	И П.ar_Включён = ИСТИНА
		|	И П.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	П.Ссылка КАК Ссылка,
		|	П.ar_Агент КАК ar_Агент,
		|	П.ar_ФильтрJSON КАК ar_ФильтрJSON
		|ИЗ
		|	Справочник.ar_ПодпискиАгентов КАК П
		|ГДЕ
		|	П.ar_Событие1С = &СобытиеТипБезСуффикса
		|	И П.ar_Включён = ИСТИНА
		|	И П.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("СобытиеТип", СобытиеТип);
	Запрос.УстановитьПараметр("СобытиеТипБезСуффикса", СобытиеТипБезСуффикса);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Обновляет watermark константы ar_ОпросПодписокПоследнийЗапуск (EXT-08).
//
// Запись выполняется под привилегированным режимом (обычный пользователь РЗ
// не имеет права записи константы). Привилегированный режим обязательно
// снимается в ветке Исключение (try/finally-паттерн).
//
// Параметры:
//   НоваяДата - Дата - новое значение watermark.
//
Процедура ОбновитьМеткуОпросаПривилегированно(НоваяДата)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.ar_ОпросПодписокПоследнийЗапуск.Установить(НоваяДата);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Обновляет watermark константы ar_ОбработчикУпоминанийПоследнийЗапуск (SCHED-07).
//
// Запись выполняется под привилегированным режимом (обычный пользователь РЗ
// не имеет права записи константы). Привилегированный режим обязательно
// снимается в ветке Исключение (try/finally-паттерн).
//
// Параметры:
//   НоваяМетка - Дата - новое значение watermark.
//
Процедура ОбновитьWatermarkУпоминаний(НоваяМетка)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.ar_ОбработчикУпоминанийПоследнийЗапуск.Установить(НоваяМетка);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// ===== SCHED-08: Компакция аудита =====

// Проверяет, разрешено ли выполнение компакции аудита (SCHED-08).
//
// Двойная проверка:
//   1) Константа ar_РазрешитьОчисткуAudit = Истина.
//   2) Текущий пользователь сессии входит в роль ar_РольОчисткаAudit.
//
// При невыполнении любого условия фиксируется запись в журнале регистрации
// и возвращается Ложь. Удаление данных при Ложь не производится.
//
// Возвращаемое значение:
//   Булево - Истина, если оба условия выполнены.
//
Функция КомпакцияAuditРазрешена()

	Если Не Константы.ar_РазрешитьОчисткуAudit.Получить() Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			НСтр("ru='SCHED-08: компакция audit отключена (константа ar_РазрешитьОчисткуAudit = Ложь)';
				|en='SCHED-08: audit compaction disabled (constant ar_РазрешитьОчисткуAudit = False)'"));
		Возврат Ложь;
	КонецЕсли;

	Если Не Пользователи.РолиДоступны("ar_РольОчисткаAudit") Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			НСтр("ru='SCHED-08: пользователь не имеет роли ar_РольОчисткаAudit, компакция отменена';
				|en='SCHED-08: user does not have role ar_РольОчисткаAudit, compaction aborted'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Вычисляет дату-порог для удаления устаревших событий (SCHED-08).
//
// Читает константу ar_КомпакцияAuditДней. При значении <= 0 подставляет
// безопасный дефолт 90 дней. При отрицательном значении дополнительно
// логируется Предупреждение.
//
// Выходной параметр ДнейНастройка заполняется фактическим значением дней
// (для передачи в ЗафиксироватьMetaAuditPurged).
//
// Параметры:
//   ДнейНастройка - Число - выходной параметр, заполняется фактическим числом
//                           дней хранения (включая подставленный дефолт).
//
// Возвращаемое значение:
//   Дата - порог: ТекущаяДатаСеанса() - ДнейНастройка * 86400.
//
Функция ПорогДатыКомпакции(ДнейНастройка)

	ДнейСохранено = Константы.ar_КомпакцияAuditДней.Получить();

	ДнейПоУмолчанию = 90;
	СекундВСутках = 86400;

	Если ДнейСохранено < 0 Тогда
		ТекстПредупрежденияКомпакции = СтрШаблон(
			НСтр("ru='SCHED-08: некорректное значение константы ar_КомпакцияAuditДней (%1), используется дефолт 90 дней';
				|en='SCHED-08: invalid value of constant ar_КомпакцияAuditДней (%1), using default 90 days'"),
			ДнейСохранено);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстПредупрежденияКомпакции);
		ДнейНастройка = ДнейПоУмолчанию;
	ИначеЕсли ДнейСохранено = 0 Тогда
		ДнейНастройка = ДнейПоУмолчанию;
	Иначе
		ДнейНастройка = ДнейСохранено;
	КонецЕсли;

	Возврат ТекущаяДатаСеанса() - ДнейНастройка * СекундВСутках;

КонецФункции

// Удаляет порцию устаревших событий из регистра ar_СобытияЗапуска (SCHED-08).
//
// Выбирает первые 1000 записей старше ПорогДаты (по ресурсу ar_МоментВремени)
// и удаляет каждую через НаборЗаписей с отбором по измерениям ar_RunId и
// ar_Sequence. Каждое удаление - отдельная транзакция (против длинных блокировок).
//
// Параметры:
//   ПорогДаты - Дата - нижняя граница: записи с ar_МоментВремени < ПорогДаты
//                      подлежат удалению.
//
// Возвращаемое значение:
//   Число - фактическое количество удалённых строк (0, если нет данных).
//
Функция УдалитьУстаревшиеСобытияПорцией(ПорогДаты)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	Сб.ar_RunId КАК ar_RunId,
		|	Сб.ar_Sequence КАК ar_Sequence
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК Сб
		|ГДЕ
		|	Сб.ar_МоментВремени < &ПорогДаты
		|УПОРЯДОЧИТЬ ПО
		|	Сб.ar_МоментВремени";
	Запрос.УстановитьПараметр("ПорогДаты", ПорогДаты);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	КонецЕсли;

	УдаленоСтрок = 0;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ar_СобытияЗапуска.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ar_RunId.Использование = Истина;
		НаборЗаписей.Отбор.ar_RunId.Значение = Выборка.ar_RunId;
		НаборЗаписей.Отбор.ar_Sequence.Использование = Истина;
		НаборЗаписей.Отбор.ar_Sequence.Значение = Выборка.ar_Sequence;
		// Записываем пустой набор - удаление записи регистра сведений (стандартный паттерн).
		НаборЗаписей.Записать();
		УдаленоСтрок = УдаленоСтрок + 1;
	КонецЦикла;

	Возврат УдаленоСтрок;

КонецФункции

// Фиксирует мета-событие AuditPurged после успешной компакции (SCHED-08).
//
// Формирует payload {deleted_rows, threshold_date, retention_days} и вызывает
// ar_AuditСобытия.Зафиксировать с RunId = "" (sentinel-UUID: события вне
// контекста запуска агента). Фиксируется даже при deleted_rows = 0 (для
// трассируемости факта запуска компакции).
//
// Параметры:
//   УдаленоСтрок  - Число - итоговое количество удалённых строк.
//   ПорогДаты     - Дата  - дата-порог, применённая при удалении.
//   ДнейНастройка - Число - фактическое количество дней хранения.
//
Процедура ЗафиксироватьMetaAuditPurged(УдаленоСтрок, ПорогДаты, ДнейНастройка)

	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("deleted_rows", УдаленоСтрок);
	ПараметрыСобытия.Вставить("threshold_date", Формат(ПорогДаты, "ДФ='yyyy-MM-dd'"));
	ПараметрыСобытия.Вставить("retention_days", ДнейНастройка);

	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", "AuditPurged", ПараметрыСобытия);

КонецПроцедуры

// ===== SCHED-09: Обновление памяти Auto =====

// Возвращает дату-порог для анализа запусков агентов (SCHED-09).
// Сутки назад от текущего момента сессии.
//
// Возвращаемое значение:
//   Дата - ТекущаяДатаСеанса() - 86400.
//
Функция ПорогДатыАнализа()

	СекундВСутках = 86400;
	Возврат ТекущаяДатаСеанса() - СекундВСутках;

КонецФункции

// Обходит таблицу агентов и ставит proposals в очередь approval (SCHED-09).
// Выделено из ОбработатьОбновлениеПамятиAuto для снижения когнитивной сложности.
//
// Параметры:
//   ТаблицаАгентов - ТаблицаЗначений {АгентРеф, КоличествоЗапусков}.
//   ПорогДаты      - Дата - нижняя граница периода анализа.
//
// Возвращаемое значение:
//   Структура {ВсегоProposals: Число, КоличествоАгентов: Число}.
//
Функция ОбработатьАгентовMemoryAuto(ТаблицаАгентов, ПорогДаты)

	ЛимитProposalsСуммарно = 20;
	ЛимитProposalsНаАгента = 5;

	ВсегоProposals = 0;
	КоличествоАгентов = 0;

	Для Каждого СтрокаАгента Из ТаблицаАгентов Цикл
		Если ВсегоProposals >= ЛимитProposalsСуммарно Тогда
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Информация,
				,
				,
				НСтр("ru='SCHED-09: достигнут суммарный лимит proposals (20), обработка остановлена';
					|en='SCHED-09: global proposals limit (20) reached, processing stopped'"));
			Прервать;
		КонецЕсли;

		АгентРеф = СтрокаАгента.АгентРеф;

		Proposals = Неопределено;
		Попытка
			Proposals = СформироватьProposals(АгентРеф, ПорогДаты);
		Исключение
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				АгентРеф,
				СтрШаблон(
					НСтр("ru='SCHED-09: ошибка формирования proposals для агента «%1»: %2';
						|en='SCHED-09: failed to form proposals for agent ""%1"": %2'"),
					АгентРеф,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;

		Если Proposals = Неопределено ИЛИ Proposals.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоАгентов = КоличествоАгентов + 1;
		НомерProposal = 0;

		Для Каждого Proposal Из Proposals Цикл
			Если НомерProposal >= ЛимитProposalsНаАгента ИЛИ ВсегоProposals >= ЛимитProposalsСуммарно Тогда
				Прервать;
			КонецЕсли;

			Попытка
				ПоставитьProposalВApproval(АгентРеф, Proposal, НомерProposal, ПорогДаты);
				НомерProposal = НомерProposal + 1;
				ВсегоProposals = ВсегоProposals + 1;
			Исключение
				ЗаписьЖурналаРегистрации(
					ИмяСобытияЖурнала(),
					УровеньЖурналаРегистрации.Ошибка,
					,
					АгентРеф,
					СтрШаблон(
						НСтр("ru='SCHED-09: ошибка постановки proposal (тип=%1) для агента «%2»: %3';
							|en='SCHED-09: failed to enqueue proposal (type=%1) for agent ""%2"": %3'"),
						Proposal.Тип,
						АгентРеф,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ВсегоProposals", ВсегоProposals);
	Результат.Вставить("КоличествоАгентов", КоличествоАгентов);
	Возврат Результат;

КонецФункции

// Обходит таблицу пользователей (режим «без агента») и ставит proposals в
// очередь approval (MEM-03, D7). Аналог ОбработатьАгентовMemoryAuto для
// no-agent сессий - выделена отдельно, а не унифицирована с агентной веткой,
// чтобы не рефакторить существующие жёстко типизированные на СправочникСсылка.
// ar_Агенты функции SCHED-09 (риск регрессии, см. спеку MEM-03 §Риски).
//
// Параметры:
//   ТаблицаПользователей - ТаблицаЗначений {ПользовательРеф, КоличествоЗапусков}.
//   ПорогДаты            - Дата - нижняя граница периода анализа.
//
// Возвращаемое значение:
//   Структура {ВсегоProposals: Число, КоличествоПользователей: Число}.
//
Функция ОбработатьПользователейMemoryAuto(ТаблицаПользователей, ПорогДаты)

	ЛимитProposalsСуммарно = 20;
	ЛимитProposalsНаПользователя = 5;

	ВсегоProposals = 0;
	КоличествоПользователей = 0;

	Для Каждого СтрокаПользователя Из ТаблицаПользователей Цикл
		Если ВсегоProposals >= ЛимитProposalsСуммарно Тогда
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Информация,
				,
				,
				НСтр("ru='SCHED-09: достигнут суммарный лимит proposals (20) для пользователей, обработка остановлена';
					|en='SCHED-09: global proposals limit (20) for users reached, processing stopped'"));
			Прервать;
		КонецЕсли;

		ПользовательРеф = СтрокаПользователя.ПользовательРеф;

		Proposals = Неопределено;
		Попытка
			Proposals = СформироватьProposalsПользователя(ПользовательРеф, ПорогДаты);
		Исключение
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				СтрШаблон(
					НСтр("ru='SCHED-09: ошибка формирования proposals для пользователя «%1»: %2';
						|en='SCHED-09: failed to form proposals for user ""%1"": %2'"),
					ПользовательРеф,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			Продолжить;
		КонецПопытки;

		Если Proposals = Неопределено ИЛИ Proposals.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоПользователей = КоличествоПользователей + 1;
		НомерProposal = 0;

		Для Каждого Proposal Из Proposals Цикл
			Если НомерProposal >= ЛимитProposalsНаПользователя ИЛИ ВсегоProposals >= ЛимитProposalsСуммарно Тогда
				Прервать;
			КонецЕсли;

			Попытка
				ПоставитьProposalВApprovalПользователя(ПользовательРеф, Proposal, НомерProposal, ПорогДаты);
				НомерProposal = НомерProposal + 1;
				ВсегоProposals = ВсегоProposals + 1;
			Исключение
				ЗаписьЖурналаРегистрации(
					ИмяСобытияЖурнала(),
					УровеньЖурналаРегистрации.Ошибка,
					,
					,
					СтрШаблон(
						НСтр("ru='SCHED-09: ошибка постановки proposal (тип=%1) для пользователя «%2»: %3';
							|en='SCHED-09: failed to enqueue proposal (type=%1) for user ""%2"": %3'"),
						Proposal.Тип,
						ПользовательРеф,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ВсегоProposals", ВсегоProposals);
	Результат.Вставить("КоличествоПользователей", КоличествоПользователей);
	Возврат Результат;

КонецФункции

// Фиксирует мета-событие MemoryProposed после обработки агентов (SCHED-09).
// Параметры:
//   КоличествоАгентов - Число - обработано агентов.
//   КоличествоProposals - Число - всего поставлено proposals.
//   ПорогДаты           - Дата - начало анализируемого периода.
Процедура ЗафиксироватьMetaMemoryProposed(КоличествоАгентов, КоличествоProposals, ПорогДаты)

	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("agents_processed", КоличествоАгентов);
	ПараметрыСобытия.Вставить("proposals_count", КоличествоProposals);
	ПараметрыСобытия.Вставить("period_start", Формат(ПорогДаты, "ДФ='yyyy-MM-ddTHH:mm:ss'"));
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", "MemoryProposed", ПараметрыСобытия);

КонецПроцедуры

// Фиксирует мета-событие MemoryProposed после обработки пользователей no-agent
// (MEM-03, D7, аналог ЗафиксироватьMetaMemoryProposed для агентов). Отдельная
// процедура - ключ payload "users_processed" семантически отличается от
// "agents_processed", смешивать значения в одном ключе некорректно для
// последующей аналитики событий аудита.
//
// Параметры:
//   КоличествоПользователей - Число - обработано пользователей.
//   КоличествоProposals     - Число - всего поставлено proposals.
//   ПорогДаты                - Дата - начало анализируемого периода.
Процедура ЗафиксироватьMetaMemoryProposedПользователи(КоличествоПользователей, КоличествоProposals, ПорогДаты)

	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("users_processed", КоличествоПользователей);
	ПараметрыСобытия.Вставить("proposals_count", КоличествоProposals);
	ПараметрыСобытия.Вставить("period_start", Формат(ПорогДаты, "ДФ='yyyy-MM-ddTHH:mm:ss'"));
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", "MemoryProposed", ПараметрыСобытия);

КонецПроцедуры

// Возвращает таблицу агентов с завершёнными запусками за период (SCHED-09).
//
// Запрашивает РегистрСведений.ar_Запуски с фильтром:
//   ar_Статус = "completed" И ar_СтартовалВ > ПорогДаты И ar_АгентРеф заполнен
//   (реальный агент; no-agent запуски обрабатываются отдельно, см.
//   ПользователиСЗавершённымиЗапусками, MEM-03).
// Агрегирует по агенту, возвращает уникальные агенты.
//
// Примечание (MEM-03): исправлено имя поля регистра ar_Агент -> ar_АгентРеф
// (фактическое имя реквизита в ar_Запуски.xml, см. МЕТА).
//
// Параметры:
//   ПорогДаты - Дата - нижняя граница выборки.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: АгентРеф, КоличествоЗапусков.
//
Функция АгентыСЗавершённымиЗапусками(ПорогДаты)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("АгентРеф");
	Результат.Колонки.Добавить("КоличествоЗапусков");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запуски.ar_АгентРеф КАК АгентРеф,
		|	КОЛИЧЕСТВО(Запуски.ar_RunId) КАК КоличествоЗапусков
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_Статус = ""completed""
		|	И Запуски.ar_СтартовалВ > &ПорогДаты
		|	И ЗНАЧЕНИЕ(Справочник.ar_Агенты.ПустаяСсылка) <> Запуски.ar_АгентРеф
		|СГРУППИРОВАТЬ ПО
		|	Запуски.ar_АгентРеф
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(Запуски.ar_RunId) >= 1";
	Запрос.УстановитьПараметр("ПорогДаты", ПорогДаты);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.АгентРеф = Выборка.АгентРеф;
		Строка.КоличествоЗапусков = Выборка.КоличествоЗапусков;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает таблицу пользователей с завершёнными no-agent запусками за период
// (MEM-03, D7). Аналог АгентыСЗавершёнными Запусками для режима «без агента».
//
// Запрашивает РегистрСведений.ar_Запуски с фильтром:
//   ar_Статус = "completed" И ar_Триггер = "manual_chat_no_agent"
//   И ar_СтартовалВ > ПорогДаты И ar_ПользовательРеф заполнен.
//
// Историческая справка: до 0.1.0.247 тип ar_ПользовательРеф был задан в
// метаданных голым <v8:TypeId> с GUID справочника Пользователи из эталонной
// БСП (c54edff0-...). В целевой базе (БП 3.0.201.16 + БИТ.ФИНАНС) у этого
// справочника другой GUID, поэтому тип не разрешался: поле считалось
// нетипизированным, "СГРУППИРОВАТЬ ПО" падало с "Field may not be grouped",
// а ВЫРАЗИТЬ(... КАК Справочник.Пользователи) - с "Incompatible types".
// Тип заменён на <v8:Type>cfg:CatalogRef.Пользователи</v8:Type> (разрешается
// по имени в любой конфигурации с БСП), группировка снова штатная.
// Получение строкового
// UUID для дальнейшего построения ar_ВладелецКлюч ("ibuser:<uuid>") требует
// вызова УникальныйИдентификатор() - метод объекта, недоступен в тексте запроса -
// поэтому выполняется построчно при обходе выборки (см. вызывающую сторону,
// ОбработатьПользователейMemoryAuto).
//
// Параметры:
//   ПорогДаты - Дата - нижняя граница выборки.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: ПользовательРеф, КоличествоЗапусков.
//
Функция ПользователиСЗавершённымиЗапусками(ПорогДаты)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ПользовательРеф");
	Результат.Колонки.Добавить("КоличествоЗапусков");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запуски.ar_ПользовательРеф КАК ПользовательРеф,
		|	КОЛИЧЕСТВО(Запуски.ar_RunId) КАК КоличествоЗапусков
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_Статус = ""completed""
		|	И Запуски.ar_Триггер = ""manual_chat_no_agent""
		|	И Запуски.ar_СтартовалВ > &ПорогДаты
		|	И Запуски.ar_ПользовательРеф ЕСТЬ НЕ NULL
		|СГРУППИРОВАТЬ ПО
		|	Запуски.ar_ПользовательРеф
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(Запуски.ar_RunId) >= 1";
	Запрос.УстановитьПараметр("ПорогДаты", ПорогДаты);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.ПользовательРеф = Выборка.ПользовательРеф;
		Строка.КоличествоЗапусков = Выборка.КоличествоЗапусков;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует список proposals для агента по анализу событий запусков (SCHED-09).
//
// Лёгкий алгоритм (без LLM):
//   1. tool_called >= 3 раза одного инструмента => fact (часто использует tool).
//   2. error >= 2 раза => rule (повторяющаяся ошибка).
//   3. Последний completed => note (итог запуска).
//
// Параметры:
//   АгентРеф  - СправочникСсылка.ar_Агенты
//   ПорогДаты - Дата - нижняя граница периода
//
// Возвращаемое значение:
//   Массив из Структура {Текст, Тип, КлючевыеСлова, Обоснование}.
//
Функция СформироватьProposals(АгентРеф, ПорогДаты)

	Агрегаты = АгрегатыСобытийАгента(АгентРеф, ПорогДаты);
	Возврат ProposalsИзАгрегатов(Агрегаты);

КонецФункции

// Формирует список proposals для пользователя (режим «без агента», MEM-03,
// D7). Аналог СформироватьProposals для агента - тот же лёгкий алгоритм
// (без LLM), источник агрегатов - АгрегатыСобытийПользователя.
//
// Параметры:
//   ПользовательРеф - ПользовательИнформационнойБазы
//   ПорогДаты        - Дата - нижняя граница периода
//
// Возвращаемое значение:
//   Массив из Структура {Текст, Тип, КлючевыеСлова, Обоснование}.
//
Функция СформироватьProposalsПользователя(ПользовательРеф, ПорогДаты)

	Агрегаты = АгрегатыСобытийПользователя(ПользовательРеф, ПорогДаты);
	Возврат ProposalsИзАгрегатов(Агрегаты);

КонецФункции

// Строит массив proposals из уже вычисленных агрегатов событий (SCHED-09/MEM-03).
// Общая логика для агентной и пользовательской веток - выделена, чтобы не
// дублировать алгоритм классификации (частые инструменты / повторяющиеся
// ошибки / итог последнего запуска) в двух местах.
//
// Параметры:
//   Агрегаты - Структура {СчётчикИнструментов, СчётчикОшибок, ТекстОшибокПоКлючу,
//              ПервыйCompleted} или Неопределено (нет событий за период).
//
// Возвращаемое значение:
//   Массив из Структура {Текст, Тип, КлючевыеСлова, Обоснование}.
//
Функция ProposalsИзАгрегатов(Агрегаты)

	Proposals = Новый Массив;

	Если Агрегаты = Неопределено Тогда
		Возврат Proposals;
	КонецЕсли;

	// Proposal 1: частые инструменты (>= 3 вызовов).
	ЧастыеИнструменты = Новый Массив;
	Для Каждого КЗ Из Агрегаты.СчётчикИнструментов Цикл
		Если КЗ.Значение >= 3 Тогда
			ЧастыеИнструменты.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Если ЧастыеИнструменты.Количество() > 0 Тогда
		СписокИнструментов = СтрСоединить(ЧастыеИнструменты, ", ");
		Proposals.Добавить(СоздатьProposalFact(СписокИнструментов));
	КонецЕсли;

	// Proposal 2: повторяющиеся ошибки (>= 2 раза).
	Для Каждого КЗ Из Агрегаты.СчётчикОшибок Цикл
		Если КЗ.Значение >= 2 Тогда
			ТекстОшибки = Строка(Агрегаты.ТекстОшибокПоКлючу.Получить(КЗ.Ключ));
			Proposals.Добавить(СоздатьProposalRule(ТекстОшибки, КЗ.Значение));
		КонецЕсли;
	КонецЦикла;

	// Proposal 3: итог последнего завершённого запуска.
	Если НЕ ПустаяСтрока(Агрегаты.ПервыйCompleted) Тогда
		Proposals.Добавить(СоздатьProposalNote(Агрегаты.ПервыйCompleted));
	КонецЕсли;

	Возврат Proposals;

КонецФункции

// Создаёт структуру proposal типа fact (SCHED-09).
// Параметры:
//   СписокИнструментов - Строка - список частых инструментов через запятую.
// Возвращаемое значение:
//   Структура {Текст, Тип, КлючевыеСлова, Обоснование}.
Функция СоздатьProposalFact(СписокИнструментов)
	Результат = Новый Структура;
	ТекстFactRu = НСтр("ru='Агент часто использует инструменты: %1. Вероятно, они нужны в большинстве задач.';
		|en='Agent frequently uses tools: %1. Likely needed in most tasks.'");
	ОбоснованиеFactRu = НСтр("ru='Инструменты %1 вызывались 3+ раз за последние сутки.';
		|en='Tools %1 were called 3+ times in the last 24 hours.'");
	Результат.Вставить("Текст", СтрШаблон(ТекстFactRu, СписокИнструментов));
	Результат.Вставить("Тип", "fact");
	Результат.Вставить("КлючевыеСлова", "tools, frequent, " + СписокИнструментов);
	Результат.Вставить("Обоснование", СтрШаблон(ОбоснованиеFactRu, СписокИнструментов));
	Возврат Результат;
КонецФункции

// Создаёт структуру proposal типа rule (SCHED-09).
// Параметры:
//   ТекстОшибки - Строка - текст повторяющейся ошибки.
//   КоличествоРаз - Число - сколько раз ошибка встречалась.
// Возвращаемое значение:
//   Структура {Текст, Тип, КлючевыеСлова, Обоснование}.
Функция СоздатьProposalRule(ТекстОшибки, КоличествоРаз)
	Результат = Новый Структура;
	МаксДлинаОшибки = 200;
	ТекстRuleRu = НСтр("ru='Агент повторно сталкивается с ошибкой: %1. Рекомендуется проверить конфигурацию.';
		|en='Agent repeatedly encounters error: %1. Recommend checking configuration.'");
	ОбоснованиеRuleRu = НСтр("ru='Ошибка встречалась %1 раз(а) за последние сутки.';
		|en='Error occurred %1 time(s) in the last 24 hours.'");
	Результат.Вставить("Текст", СтрШаблон(ТекстRuleRu, Лев(ТекстОшибки, МаксДлинаОшибки)));
	Результат.Вставить("Тип", "rule");
	Результат.Вставить("КлючевыеСлова", "error, recurring");
	Результат.Вставить("Обоснование", СтрШаблон(ОбоснованиеRuleRu, КоличествоРаз));
	Возврат Результат;
КонецФункции

// Создаёт структуру proposal типа note (SCHED-09).
// Параметры:
//   ТекстИтога - Строка - текст итога последнего завершённого запуска.
// Возвращаемое значение:
//   Структура {Текст, Тип, КлючевыеСлова, Обоснование}.
Функция СоздатьProposalNote(ТекстИтога)
	Результат = Новый Структура;
	ТекстNoteRu = НСтр("ru='Итог последнего завершённого запуска: %1';
		|en='Summary of last completed run: %1'");
	Результат.Вставить("Текст", СтрШаблон(ТекстNoteRu, ТекстИтога));
	Результат.Вставить("Тип", "note");
	Результат.Вставить("КлючевыеСлова", "run, completed, summary");
	Результат.Вставить("Обоснование",
		НСтр("ru='Автоматически извлеченный итог последнего успешного запуска агента.';
			|en='Automatically extracted summary of the last successful agent run.'"));
	Возврат Результат;
КонецФункции

// Агрегирует события агента за период (SCHED-09).
// Возвращает структуру с агрегатами: счётчики инструментов, ошибок, итог запуска.
// Параметры:
//   АгентРеф  - СправочникСсылка.ar_Агенты
//   ПорогДаты - Дата - нижняя граница периода
// Возвращаемое значение:
//   Структура {СчётчикИнструментов, СчётчикОшибок, ТекстОшибокПоКлючу, ПервыйCompleted}
//   или Неопределено если событий нет.
Функция АгрегатыСобытийАгента(АгентРеф, ПорогДаты)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СобытияЗапуска.ar_ТипСобытия КАК ТипСобытия,
		|	СобытияЗапуска.ar_PayloadJSON КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК СобытияЗапуска
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
		|		ПО СобытияЗапуска.ar_RunId = Запуски.ar_RunId
		|ГДЕ
		|	Запуски.ar_АгентРеф = &АгентРеф
		|	И Запуски.ar_СтартовалВ > &ПорогДаты
		|	И СобытияЗапуска.ar_МоментВремени > &ПорогДаты
		|	И СобытияЗапуска.ar_ТипСобытия В (""tool_called"", ""error"", ""completed"")
		|УПОРЯДОЧИТЬ ПО
		|	СобытияЗапуска.ar_МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("АгентРеф", АгентРеф);
	Запрос.УстановитьПараметр("ПорогДаты", ПорогДаты);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Агрегаты = Новый Структура;
	Агрегаты.Вставить("СчётчикИнструментов", Новый Соответствие);
	Агрегаты.Вставить("СчётчикОшибок", Новый Соответствие);
	Агрегаты.Вставить("ТекстОшибокПоКлючу", Новый Соответствие);
	Агрегаты.Вставить("ПервыйCompleted", "");

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбработатьОдноСобытиеАгрегации(Выборка, Агрегаты);
	КонецЦикла;

	Возврат Агрегаты;

КонецФункции

// Агрегирует события пользователя в режиме «без агента» за период (MEM-03, аналог
// АгрегатыСобытийАгента). Джойн идёт через ar_Запуски.ar_ПользовательРеф вместо
// ar_АгентРеф и дополнительно фильтрует по ar_Триггер = "manual_chat_no_agent" -
// иначе агрегаты пользователя могли бы захватить его же агентные запуски.
//
// Параметры:
//   ПользовательРеф - ПользовательИнформационнойБазы - владелец no-agent сессий.
//   ПорогДаты        - Дата - нижняя граница периода.
//
// Возвращаемое значение:
//   Структура {СчётчикИнструментов, СчётчикОшибок, ТекстОшибокПоКлючу, ПервыйCompleted}
//   или Неопределено если событий нет.
//
Функция АгрегатыСобытийПользователя(ПользовательРеф, ПорогДаты)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СобытияЗапуска.ar_ТипСобытия КАК ТипСобытия,
		|	СобытияЗапуска.ar_PayloadJSON КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК СобытияЗапуска
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
		|		ПО СобытияЗапуска.ar_RunId = Запуски.ar_RunId
		|ГДЕ
		|	Запуски.ar_ПользовательРеф = &ПользовательРеф
		|	И Запуски.ar_Триггер = ""manual_chat_no_agent""
		|	И Запуски.ar_СтартовалВ > &ПорогДаты
		|	И СобытияЗапуска.ar_МоментВремени > &ПорогДаты
		|	И СобытияЗапуска.ar_ТипСобытия В (""tool_called"", ""error"", ""completed"")
		|УПОРЯДОЧИТЬ ПО
		|	СобытияЗапуска.ar_МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("ПользовательРеф", ПользовательРеф);
	Запрос.УстановитьПараметр("ПорогДаты", ПорогДаты);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Агрегаты = Новый Структура;
	Агрегаты.Вставить("СчётчикИнструментов", Новый Соответствие);
	Агрегаты.Вставить("СчётчикОшибок", Новый Соответствие);
	Агрегаты.Вставить("ТекстОшибокПоКлючу", Новый Соответствие);
	Агрегаты.Вставить("ПервыйCompleted", "");

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбработатьОдноСобытиеАгрегации(Выборка, Агрегаты);
	КонецЦикла;

	Возврат Агрегаты;

КонецФункции

// Обрабатывает одну строку выборки событий при агрегации (SCHED-09).
// Изменяет агрегаты по ссылке. Выделено для снижения когнитивной сложности.
// Параметры:
//   Выборка  - РезультатЗапросаВыборка - текущая строка.
//   Агрегаты - Структура {СчётчикИнструментов, СчётчикОшибок, ТекстОшибокПоКлючу, ПервыйCompleted}.
Процедура ОбработатьОдноСобытиеАгрегации(Выборка, Агрегаты)

	ТипСобытия = НРег(Строка(Выборка.ТипСобытия));
	PayloadJSON = Строка(Выборка.PayloadJSON);

	Payload = Неопределено;
	Если НЕ ПустаяСтрока(PayloadJSON) Тогда
		Payload = ar_JSON.ИзJSON(PayloadJSON);
	КонецЕсли;

	Если ТипСобытия = "tool_called" Тогда
		ОбработатьСобытиеToolCalled(Payload, Агрегаты.СчётчикИнструментов);
	ИначеЕсли ТипСобытия = "error" Тогда
		ОбработатьСобытиеError(Payload, Агрегаты.СчётчикОшибок, Агрегаты.ТекстОшибокПоКлючу);
	ИначеЕсли ТипСобытия = "completed" Тогда
		Если ПустаяСтрока(Агрегаты.ПервыйCompleted) Тогда
			ОбработатьСобытиеCompleted(Payload, Агрегаты);
		КонецЕсли;
	Иначе
		// Прочие типы событий (например, "started", "paused") - не агрегируем, пропускаем явно.
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Обновляет счётчик инструментов по событию tool_called (SCHED-09).
// Параметры:
//   Payload              - Соответствие или Неопределено - распарсенный payload.
//   СчётчикИнструментов - Соответствие - изменяется по ссылке.
Процедура ОбработатьСобытиеToolCalled(Payload, СчётчикИнструментов)

	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ИмяИнструмента = Payload.Получить("tool_name");
	Если ИмяИнструмента = Неопределено ИЛИ ПустаяСтрока(Строка(ИмяИнструмента)) Тогда
		Возврат;
	КонецЕсли;

	КлючИнструмента = НРег(Строка(ИмяИнструмента));
	ТекущееЧисло = СчётчикИнструментов.Получить(КлючИнструмента);
	Если ТекущееЧисло = Неопределено Тогда
		СчётчикИнструментов.Вставить(КлючИнструмента, 1);
	Иначе
		СчётчикИнструментов.Вставить(КлючИнструмента, ТекущееЧисло + 1);
	КонецЕсли;

КонецПроцедуры

// Обновляет счётчик ошибок по событию error (SCHED-09).
// Параметры:
//   Payload          - Соответствие или Неопределено - распарсенный payload.
//   СчётчикОшибок    - Соответствие - изменяется по ссылке.
//   ТекстыОшибок     - Соответствие - изменяется по ссылке.
Процедура ОбработатьСобытиеError(Payload, СчётчикОшибок, ТекстыОшибок)

	МаксДлинаТекстОшибки = 200;
	МаксДлинаКлюча = 100;
	ТекстОшибки = "";

	Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
		ЗначениеОшибки = Payload.Получить("error_text");
		Если ЗначениеОшибки <> Неопределено Тогда
			ТекстОшибки = Лев(Строка(ЗначениеОшибки), МаксДлинаТекстОшибки);
		КонецЕсли;
	КонецЕсли;

	КлючОшибки = НРег(Лев(ТекстОшибки, МаксДлинаКлюча));
	ТекущееЧисло = СчётчикОшибок.Получить(КлючОшибки);
	Если ТекущееЧисло = Неопределено Тогда
		СчётчикОшибок.Вставить(КлючОшибки, 1);
		ТекстыОшибок.Вставить(КлючОшибки, ТекстОшибки);
	Иначе
		СчётчикОшибок.Вставить(КлючОшибки, ТекущееЧисло + 1);
	КонецЕсли;

КонецПроцедуры

// Обновляет итог последнего completed-запуска в агрегате (SCHED-09).
// Параметры:
//   Payload  - Соответствие или Неопределено - распарсенный payload.
//   Агрегаты - Структура - изменяет Агрегаты.ПервыйCompleted по ссылке.
Процедура ОбработатьСобытиеCompleted(Payload, Агрегаты)

	МаксДлинаОтвета = 500;
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ЗначениеОтвета = Payload.Получить("final_answer");
	Если ЗначениеОтвета <> Неопределено Тогда
		Агрегаты.ПервыйCompleted = Лев(Строка(ЗначениеОтвета), МаксДлинаОтвета);
	КонецЕсли;

КонецПроцедуры

// Проверяет наличие дубля proposal в ar_ПамятьАгента (SCHED-09, UC-3).
//
// Защита от flood: если уже есть запись с тем же типом, источником "auto"
// и датой обновления позже ПорогДаты - proposal пропускается.
//
// Параметры:
//   АгентРеф  - СправочникСсылка.ar_Агенты
//   ТипProposal - Строка - тип proposal ("fact", "rule", "note")
//   ПорогДаты - Дата - нижняя граница периода
//
// Возвращаемое значение:
//   Булево - Истина, если дубль найден.
//
Функция ЕстьДубльВПамятиАгента(АгентРеф, ТипProposal, ПорогДаты)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Признак
		|ИЗ
		|	Справочник.ar_ПамятьАгента КАК ПамятьАгента
		|ГДЕ
		|	ПамятьАгента.ar_Агент = &АгентРеф
		|	И ПамятьАгента.ar_Тип = &ТипProposal
		|	И ПамятьАгента.ar_Источник = ""auto""
		|	И ПамятьАгента.ar_Обновлено > &ПорогДаты
		|	И НЕ ПамятьАгента.ПометкаУдаления";
	Запрос.УстановитьПараметр("АгентРеф", АгентРеф);
	Запрос.УстановитьПараметр("ТипProposal", ТипProposal);
	Запрос.УстановитьПараметр("ПорогДаты", ПорогДаты);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Проверяет наличие дубля proposal в ar_ПамятьАгента для пользователя-владельца
// (MEM-03, аналог ЕстьДубльВПамятиАгента, UC-3). Фильтрует по ar_ВладелецКлюч
// вместо ar_Агент - находит только записи текущего пользователя, изолируя от
// других пользователей и агентов (MEM-03 §4).
//
// Параметры:
//   ВладелецКлюч - Строка - "ibuser:<uuid>" (см. ar_Память.СформироватьВладелецКлюч).
//   ТипProposal  - Строка - тип proposal ("fact", "rule", "note")
//   ПорогДаты    - Дата - нижняя граница периода
//
// Возвращаемое значение:
//   Булево - Истина, если дубль найден.
//
Функция ЕстьДубльВПамятиВладельца(ВладелецКлюч, ТипProposal, ПорогДаты)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Признак
		|ИЗ
		|	Справочник.ar_ПамятьАгента КАК ПамятьАгента
		|ГДЕ
		|	ПамятьАгента.ar_ВладелецКлюч = &ВладелецКлюч
		|	И ПамятьАгента.ar_Тип = &ТипProposal
		|	И ПамятьАгента.ar_Источник = ""auto""
		|	И ПамятьАгента.ar_Обновлено > &ПорогДаты
		|	И НЕ ПамятьАгента.ПометкаУдаления";
	Запрос.УстановитьПараметр("ВладелецКлюч", ВладелецКлюч);
	Запрос.УстановитьПараметр("ТипProposal", ТипProposal);
	Запрос.УстановитьПараметр("ПорогДаты", ПорогДаты);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Проверяет наличие pending-proposal с тем же IdempotencyKey (SCHED-09, UC-4).
//
// Параметры:
//   IdempotencyKey - Строка - ключ идемпотентности.
//
// Возвращаемое значение:
//   Булево - Истина, если pending-запись уже существует.
//
Функция ЕстьPendingProposal(IdempotencyKey)

	СуществующийId = ar_AuditЗащищённыйРежим.ApprovalIdПоКлючуПривилегированно(
		IdempotencyKey, "pending");
	Возврат НЕ ПустаяСтрока(СуществующийId);

КонецФункции

// Ставит один proposal в очередь approval (SCHED-09).
//
// Формирует sentinel RunId, строит ActionPayloadJSON совместимый с
// ar_ToolПамять.Запомнить, вызывает ar_Approval.Поставить.
// До постановки проверяет:
//   - дубль в ar_ПамятьАгента (UC-3),
//   - pending-proposal с тем же ключом (UC-4).
//
// Параметры:
//   АгентРеф      - СправочникСсылка.ar_Агенты
//   Proposal      - Структура {Текст, Тип, КлючевыеСлова, Обоснование}
//   НомерProposal - Число - порядковый номер (0-based) в текущем тике.
//   ПорогДаты     - Дата - порог периода анализа (для проверки дублей).
//
Процедура ПоставитьProposalВApproval(АгентРеф, Proposal, НомерProposal, ПорогДаты)

	// Проверка дубля в ar_ПамятьАгента (UC-3).
	Если ЕстьДубльВПамятиАгента(АгентРеф, Proposal.Тип, ПорогДаты) Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			АгентРеф,
			СтрШаблон(
				НСтр("ru='SCHED-09: пропущен proposal (тип=%1) для агента «%2» - дубль в памяти агента';
					|en='SCHED-09: skipped proposal (type=%1) for agent ""%2"" - duplicate in agent memory'"),
				Proposal.Тип,
				АгентРеф));
		Возврат;
	КонецЕсли;

	// Формируем IdempotencyKey.
	ДатаСтрока = Формат(ТекущаяДатаСеанса(), "ДФ='yyyyMMdd'");
	IdempotencyKey = "sched09_" + Строка(АгентРеф) + "_" + Proposal.Тип + "_" + ДатаСтрока;

	// Проверка pending-дубля (UC-4).
	Если ЕстьPendingProposal(IdempotencyKey) Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			АгентРеф,
			СтрШаблон(
				НСтр("ru='SCHED-09: пропущен proposal (тип=%1) для агента «%2» - pending уже существует';
					|en='SCHED-09: skipped proposal (type=%1) for agent ""%2"" - pending already exists'"),
				Proposal.Тип,
				АгентРеф));
		Возврат;
	КонецЕсли;

	// Формируем sentinel RunId (нет "живого" запуска агента для этого РЗ).
	SentinelRunId = "sched09_auto_" + ДатаСтрока + "_" + Строка(НомерProposal);

	// Навигационная ссылка агента для payload.
	АгентRefStr = "";
	Попытка
		АгентRefStr = ar_Утилиты.НавигационнаяСсылкаОбъекта(АгентРеф);
	Исключение
		// Агент удалён или недоступен - proposal пропускаем (UC: агент удалён до постановки).
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			АгентРеф,
			СтрШаблон(
				НСтр("ru='SCHED-09: агент недоступен или удалён, proposal пропущен. Агент: %1. Ошибка: %2';
					|en='SCHED-09: agent is unavailable or deleted, proposal skipped. Agent: %1. Error: %2'"),
				АгентРеф,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	// TD-02: регистрируем ar_АгентРеф на записи ar_Запуски ДО постановки в
	// очередь approval. ar_Approval.ЗаписатьЗаписьОчередиИПаузу создаёт запись
	// ar_Запуски только если её ещё нет ("Если Не ЗаписьЗапуска.Выбран() Тогда
	// ar_RunId = RunId") - без этого шага ar_АгентРеф остаётся пустой ссылкой,
	// и ar_RuntimeЗапуск.Возобновить передаёт в ar_RuntimeЦикл.ВыполнитьАгента
	// пустого агента (ПрочитатьДанныеАгента(ПустаяСсылка) = Неопределено -> run
	// падает в agent_not_found_or_inactive ДО восстановления состояния из
	// снимка). ar_AuditЗащищённыйРежим - существующий привилегированный фасад
	// (AUD-04/AUD-06), сам ar_Scheduler привилегии не поднимает.
	ДанныеСоздания = Новый Структура;
	ДанныеСоздания.Вставить("АгентРеф", АгентРеф);
	ДанныеСоздания.Вставить("Триггер",  "cron");
	ДанныеСоздания.Вставить("Статус",   "Created");
	Попытка
		ar_AuditЗащищённыйРежим.СоздатьЗапускПривилегированно(SentinelRunId, ДанныеСоздания);
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			АгентРеф,
			СтрШаблон(
				НСтр("ru='SCHED-09: не удалось предварительно зарегистрировать sentinel-запуск %1, proposal пропущен. Ошибка: %2';
					|en='SCHED-09: failed to pre-register sentinel run %1, proposal skipped. Error: %2'"),
				SentinelRunId,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	// Строим ActionPayloadJSON совместимый с ar_ToolПамять.Запомнить (MEM-01).
	// TD-02: имя реально зарегистрированного tool - "remember" (см.
	// ar_ToolПамять.ЗарегистрироватьTools), а не условное "auto_memory_update" -
	// иначе ar_ToolDispatcher.НайтиToolПоИмени не найдёт tool при resume.
	ArgsMap = Новый Соответствие;
	ArgsMap.Вставить("text", Лев(Proposal.Текст, 1000));
	ArgsMap.Вставить("type", Proposal.Тип);
	ArgsMap.Вставить("keywords", Proposal.КлючевыеСлова);
	ArgsMap.Вставить("source", "auto");
	ArgsMap.Вставить("source_run_id", SentinelRunId);
	ArgsMap.Вставить("agent_ref", АгентRefStr);
	АргументыJSON = ar_JSON.ВЗначениеJSON(ArgsMap);

	Действие = Новый Структура;
	Действие.Вставить("Имя", "remember");
	Действие.Вставить("ИдВызова", IdempotencyKey);
	Действие.Вставить("IdempotencyKey", IdempotencyKey);
	Действие.Вставить("Обоснование", Proposal.Обоснование);
	Действие.Вставить("Аргументы", АргументыJSON);

	// Формируем КонтекстЗапуска с sentinel RunId и синтетическим Состоянием
	// (TD-02) - без него ar_Approval.СохранитьСнимокЕслиЕсть не пишет
	// StateSnapshot, и ar_RuntimeЗапуск.Возобновить возвращает
	// snapshot_missing_or_incompatible.
	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("RunId", SentinelRunId);
	КонтекстЗапуска.Вставить("Sequence", НомерProposal);
	КонтекстЗапуска.Вставить("Состояние", СформироватьСостояниеДляSentinel(
		SentinelRunId, "remember", IdempotencyKey, АргументыJSON, IdempotencyKey, ""));

	// Постановка в очередь approval (единственная точка входа - APPR-01).
	ar_Approval.Поставить(КонтекстЗапуска, Действие);

КонецПроцедуры

// Ставит один proposal пользователя (режим «без агента») в очередь approval
// (MEM-03, D7, аналог ПоставитьProposalВApproval для агента).
//
// Отличия от агентной ветки:
//   - дубль-проверка идёт по ar_ВладелецКлюч (ЕстьДубльВПамятиВладельца), а не ar_Агент;
//   - IdempotencyKey строится на основе ВладелецКлюч, а не Строка(АгентРеф);
//   - ActionPayloadJSON.args не содержит agent_ref, вместо него owner_key -
//     ar_ToolПамять.ЗапомнитьВнутр читает владельца из Контекст.ПользовательUUID/
//     Контекст.Агент (КонтекстЗапуска), а не из тела аргументов - owner_key здесь
//     носит справочный/аудиторский характер (видно в Approval Queue, кто владелец).
//
// Параметры:
//   ПользовательРеф - ПользовательИнформационнойБазы - владелец no-agent сессий.
//   Proposal         - Структура {Текст, Тип, КлючевыеСлова, Обоснование}
//   НомерProposal    - Число - порядковый номер (0-based) в текущем тике.
//   ПорогДаты        - Дата - порог периода анализа (для проверки дублей).
//
Процедура ПоставитьProposalВApprovalПользователя(ПользовательРеф, Proposal, НомерProposal, ПорогДаты)

	// UUID пользователя ИБ - основа ar_ВладелецКлюч (тот же приём, что в ar_Диалог,
	// см. src/CommonForms/ar_Диалог/Ext/Form/Module.bsl:372).
	ПользовательUUID = "";
	Попытка
		ПользовательUUID = Строка(ПользовательРеф.УникальныйИдентификатор());
	Исключение
		// Пользователь ИБ удалён/недоступен - proposal пропускаем.
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон(
				НСтр("ru='SCHED-09: пользователь ИБ недоступен или удалён, proposal пропущен. Ошибка: %1';
					|en='SCHED-09: infobase user is unavailable or deleted, proposal skipped. Error: %1'"),
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	ВладелецКлюч = ar_Память.СформироватьВладелецКлюч(Неопределено, ПользовательUUID);
	Если ПустаяСтрока(ВладелецКлюч) Тогда
		Возврат;
	КонецЕсли;

	// Проверка дубля в ar_ПамятьАгента (аналог UC-3, по владельцу).
	Если ЕстьДубльВПамятиВладельца(ВладелецКлюч, Proposal.Тип, ПорогДаты) Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон(
				НСтр("ru='SCHED-09: пропущен proposal (тип=%1) для пользователя «%2» - дубль в памяти';
					|en='SCHED-09: skipped proposal (type=%1) for user ""%2"" - duplicate in memory'"),
				Proposal.Тип,
				ВладелецКлюч));
		Возврат;
	КонецЕсли;

	// Формируем IdempotencyKey (на основе ВладелецКлюч, а не Строка(АгентРеф)).
	ДатаСтрока = Формат(ТекущаяДатаСеанса(), "ДФ='yyyyMMdd'");
	IdempotencyKey = "sched09_" + ВладелецКлюч + "_" + Proposal.Тип + "_" + ДатаСтрока;

	// Проверка pending-дубля (аналог UC-4).
	Если ЕстьPendingProposal(IdempotencyKey) Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон(
				НСтр("ru='SCHED-09: пропущен proposal (тип=%1) для пользователя «%2» - pending уже существует';
					|en='SCHED-09: skipped proposal (type=%1) for user ""%2"" - pending already exists'"),
				Proposal.Тип,
				ВладелецКлюч));
		Возврат;
	КонецЕсли;

	// Формируем sentinel RunId (нет "живого" запуска для этого РЗ).
	SentinelRunId = "sched09_auto_" + ДатаСтрока + "_" + Строка(НомерProposal);

	// TD-02: регистрируем запись ar_Запуски заранее, симметрично агентной ветке
	// (ПоставитьProposalВApproval). Для no-agent запусков ar_АгентРеф остаётся
	// пустой ссылкой (Опционально в ar_AuditЗапуски.Создать) - привязка к
	// владельцу идёт через ВладелецКлюч/ПользовательUUID синтетического
	// Состояния, а не через ar_АгентРеф.
	ДанныеСоздания = Новый Структура;
	ДанныеСоздания.Вставить("Триггер", "cron");
	ДанныеСоздания.Вставить("Статус",  "Created");
	Попытка
		ar_AuditЗащищённыйРежим.СоздатьЗапускПривилегированно(SentinelRunId, ДанныеСоздания);
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон(
				НСтр("ru='SCHED-09: не удалось предварительно зарегистрировать sentinel-запуск %1, proposal пропущен. Ошибка: %2';
					|en='SCHED-09: failed to pre-register sentinel run %1, proposal skipped. Error: %2'"),
				SentinelRunId,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	// Строим ActionPayloadJSON совместимый с ar_ToolПамять.Запомнить (MEM-01/MEM-03).
	// TD-02: имя реально зарегистрированного tool - "remember" (см.
	// ar_ToolПамять.ЗарегистрироватьTools), а не условное "auto_memory_update".
	ArgsMap = Новый Соответствие;
	ArgsMap.Вставить("text", Лев(Proposal.Текст, 1000));
	ArgsMap.Вставить("type", Proposal.Тип);
	ArgsMap.Вставить("keywords", Proposal.КлючевыеСлова);
	ArgsMap.Вставить("source", "auto");
	ArgsMap.Вставить("source_run_id", SentinelRunId);
	// MEM-03: owner_key - справочно (видно оператору в Approval Queue),
	// фактический владелец при resume определяется через
	// Контекст.ПользовательUUID (синтетическое Состояние ниже).
	ArgsMap.Вставить("owner_key", ВладелецКлюч);
	АргументыJSON = ar_JSON.ВЗначениеJSON(ArgsMap);

	Действие = Новый Структура;
	Действие.Вставить("Имя", "remember");
	Действие.Вставить("ИдВызова", IdempotencyKey);
	Действие.Вставить("IdempotencyKey", IdempotencyKey);
	Действие.Вставить("Обоснование", Proposal.Обоснование);
	Действие.Вставить("Аргументы", АргументыJSON);

	// TD-02 (итерация 2): resume пользовательской (no-agent) ветки требует
	// признак БезАгента=Истина и валидный ОверрайдПровайдер (ar_RuntimeЦикл.
	// ДанныеАгентаБезАгента отказывает при пустом/неверном типе провайдера).
	// У sched09 auto-proposal нет живой сессии, из которой можно взять
	// провайдер (регистр ar_Запуски провайдера не хранит) - берём первый
	// включённый (ar_Включён=Истина) провайдер с поддержкой tool calls,
	// см. ПодобратьПровайдерДляBezAgentaResume. Если такого нет - proposal
	// пропускается (без провайдера resume гарантированно не сможет вызвать LLM).
	ПровайдерРеф = ПодобратьПровайдерДляBezAgentaResume();
	Если ПровайдерРеф = Неопределено Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СтрШаблон(
				НСтр("ru='SCHED-09: нет доступного включённого LLM-провайдера для resume «без агента», proposal (тип=%1) пользователя «%2» пропущен';
					|en='SCHED-09: no enabled LLM provider available for no-agent resume, proposal (type=%1) for user ""%2"" skipped'"),
				Proposal.Тип,
				ВладелецКлюч));
		Возврат;
	КонецЕсли;

	ОверрайдTools = Новый Массив;
	ОверрайдTools.Добавить("remember");

	РежимБезАгента = Новый Структура;
	РежимБезАгента.Вставить("БезАгента", Истина);
	РежимБезАгента.Вставить("ОверрайдПровайдер", ar_Утилиты.НавигационнаяСсылкаОбъекта(ПровайдерРеф));
	РежимБезАгента.Вставить("ОверрайдTools", ОверрайдTools);

	// Формируем КонтекстЗапуска с sentinel RunId и синтетическим Состоянием
	// (TD-02, симметрично агентной ветке) - без него StateSnapshot не пишется
	// и ar_RuntimeЗапуск.Возобновить возвращает snapshot_missing_or_incompatible.
	// БезАгента/ОверрайдПровайдер/ОверрайдTools (РежимБезАгента) прокидываются
	// через Состояние -> ar_RuntimeЗапуск.Возобновить
	// (ДополнитьКонтекстТриггераИзСнимкаБезАгента) -> КонтекстТриггера, чтобы
	// ar_RuntimeЦикл.ВыполнитьАгентаВнутр смог собрать ДанныеАгентаБезАгента
	// вместо падения в agent_not_found_or_inactive (см. td-02.md, Ревью 1 (BLOCKED),
	// находка (b), Реализация итерация 2).
	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("RunId", SentinelRunId);
	КонтекстЗапуска.Вставить("Sequence", НомерProposal);
	КонтекстЗапуска.Вставить("Состояние", СформироватьСостояниеДляSentinel(
		SentinelRunId, "remember", IdempotencyKey, АргументыJSON, IdempotencyKey, ПользовательUUID,
		РежимБезАгента));

	// Постановка в очередь approval (единственная точка входа - APPR-01).
	ar_Approval.Поставить(КонтекстЗапуска, Действие);

КонецПроцедуры

// TD-02: синтезирует минимальное Состояние цикла рассуждения для sentinel-
// запуска SCHED-09 (нет живого ReAct-цикла - proposal рождается вне запуска
// агента). Совместимо с ar_RuntimeЦикл.ВосстановитьСостояние/ДополнитьКлючи:
// передаётся логически осмысленный минимум, недостающие ключи нового формата
// подставит ДополнитьКлючи(Состояние, НовоеСостояние(RunId)) на стороне
// ar_RuntimeЦикл при resume.
//
// ar_RuntimeЦикл.НовоеСостояние не экспортируется - структура дублируется
// здесь локально (см. риски TD-02: sched09 - принципиально другой, batch/cron
// вызывающий контекст, прямая связка с ReAct-модулем увеличила бы риск
// регрессии в обоих модулях при будущих доработках).
//
// Сообщения содержат минимум одну пару: assistant с tool_calls (само действие
// remember, ещё не выполненное) + tool-observation "queued for approval",
// в точности как реальный ReAct-цикл кладёт в историю перед паузой
// (ar_RuntimeЦикл.ОбработатьДействие/ДобавитьObservation) - без этого при
// resume у LLM/диспетчера не будет исходного tool_call в истории, на который
// claim'ится наблюдение.
//
// Параметры:
//  RunId            - Строка(36) - SentinelRunId.
//  ИмяTool          - Строка - имя реально зарегистрированного tool ("remember").
//  ИдВызова         - Строка - идентификатор tool_call (= IdempotencyKey).
//  АргументыJSON    - Строка - JSON-аргументы вызова (= Действие.Аргументы).
//  ApprovalId       - Строка - используется как placeholder в тексте observation
//                     (реальный ApprovalId присваивается позже внутри
//                     ar_Approval.Поставить, здесь для наблюдения важен факт
//                     постановки, не конкретный UUID).
//  ПользовательUUID - Строка - для пользовательской (no-agent) ветки MEM-03;
//                     "" для агентной ветки.
//  РежимБезАгента   - Структура, Неопределено - TD-02 (итерация 2), только для
//                     пользовательской (no-agent) ветки; Неопределено для
//                     агентной. Ключи:
//                      * БезАгента       - Булево - Истина.
//                      * ОверрайдПровайдер - Строка - навигационная ссылка
//                        (ar_Утилиты.НавигационнаяСсылкаОбъекта) на
//                        СправочникСсылка.ar_LLMПровайдеры для resume
//                        (ar_RuntimeЦикл.ДанныеАгентаБезАгента требует
//                        непустой валидный провайдер). Ссылочные типы
//                        запрещены в state (ar_AuditЗапуски.
//                        ПроверитьСериализуемость) - поэтому строка.
//                      * ОверрайдTools   - Массив строк - имена tools для
//                        ar_RuntimeЦикл.ОпределенияOverrideTools (пересобирается
//                        на каждом шаге из КонтекстТриггера, не из снимка -
//                        см. ar_RuntimeЦикл.ВыполнитьАгентаВнутр:373-375).
//                     Сохраняется в Состоянии, т.к. ar_RuntimeЗапуск.Возобновить
//                     строит КонтекстТриггера заново на resume и не имеет
//                     иного источника этих данных - см. ar_RuntimeЗапуск.
//                     ДополнитьКонтекстТриггераИзСнимкаБезАгента.
//
// Возвращаемое значение:
//  Структура - синтетическое Состояние цикла.
//
Функция СформироватьСостояниеДляSentinel(Знач RunId, Знач ИмяTool, Знач ИдВызова,
		Знач АргументыJSON, Знач ApprovalId, Знач ПользовательUUID, Знач РежимБезАгента = Неопределено)

	Состояние = Новый Структура;
	Состояние.Вставить("Сообщения",        Новый Массив);
	Состояние.Вставить("ШаговВсего",       0);
	Состояние.Вставить("ДействийВсего",    1);
	Состояние.Вставить("ОжидаютApproval",  1);
	Состояние.Вставить("ОжидаютInput",     0);
	Состояние.Вставить("Результат",        "");
	Состояние.Вставить("RunId",            RunId);
	Состояние.Вставить("ТокеновВход",      0);
	Состояние.Вставить("ТокеновВыход",     0);
	Состояние.Вставить("DryRun",           Ложь);
	Состояние.Вставить("ИнструкцияДобавка", "");
	Состояние.Вставить("ПользовательUUID",
		?(ТипЗнч(ПользовательUUID) = Тип("Строка"), ПользовательUUID, ""));

	// TD-02 (итерация 2): признак «без агента» и данные для его resume - см.
	// ar_RuntimeЗапуск.ДополнитьКонтекстТриггераИзСнимкаБезАгента (единственный читатель этих
	// ключей на стороне resume). Хранится в state как примитивы (Булево/Строка/
	// Массив строк) - допустимые типы для ar_AuditЗапуски.ПроверитьСериализуемость.
	БезАгента = Ложь;
	ОверрайдПровайдерСтрока = "";
	ОверрайдTools = Неопределено;
	Если ТипЗнч(РежимБезАгента) = Тип("Структура") Тогда
		РежимБезАгента.Свойство("БезАгента", БезАгента);
		РежимБезАгента.Свойство("ОверрайдПровайдер", ОверрайдПровайдерСтрока);
		РежимБезАгента.Свойство("ОверрайдTools", ОверрайдTools);
	КонецЕсли;

	Состояние.Вставить("БезАгента", (БезАгента = Истина));
	Состояние.Вставить("ОверрайдПровайдер",
		?(ТипЗнч(ОверрайдПровайдерСтрока) = Тип("Строка"), ОверрайдПровайдерСтрока, ""));
	Если ТипЗнч(ОверрайдTools) = Тип("Массив") Тогда
		Состояние.Вставить("ОверрайдTools", ОверрайдTools);
	Иначе
		Состояние.Вставить("ОверрайдTools", Новый Массив);
	КонецЕсли;

	ToolCall = ar_LLMКонтракт.НовыйToolCall(ИдВызова, ИмяTool, АргументыJSON);
	МассивВызовов = Новый Массив;
	МассивВызовов.Добавить(ToolCall);

	СообщениеАссистента = ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольAssistant(), "");
	СообщениеАссистента.Вставить("tool_calls", МассивВызовов);
	Состояние.Сообщения.Добавить(СообщениеАссистента);

	// Наблюдение "queued for approval" - тот же текст, что кладёт в историю
	// реальный цикл (ar_RuntimeЦикл.ОбработатьДействие, ветка approval_required).
	ТекстНаблюдения = "queued for approval (id=" + ApprovalId + ")";
	Наблюдение = ar_LLMКонтракт.НовыйToolResult(ИдВызова, ИмяTool, ТекстНаблюдения);
	Состояние.Сообщения.Добавить(Наблюдение);

	Возврат Состояние;

КонецФункции

// TD-02 (итерация 2): подобрать LLM-провайдера для resume пользовательской
// (no-agent) sentinel-ветки. sched09 auto-proposal формируется постфактум из
// аудита завершённых запусков, а не из живой сессии - регистр ar_Запуски не
// хранит использованный провайдер, поэтому взять «тот самый» провайдер
// исходной сессии невозможно. Берём первый включённый провайдер с поддержкой
// tool calls (обязательное условие для ReAct-цикла) - детерминированный выбор
// по Наименованию для стабильности между тиками регламентного задания.
//
// Возвращаемое значение:
//  СправочникСсылка.ar_LLMПровайдеры - найденный провайдер;
//  Неопределено - если ни одного подходящего провайдера нет.
//
Функция ПодобратьПровайдерДляBezAgentaResume()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Провайдеры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_LLMПровайдеры КАК Провайдеры
		|ГДЕ
		|	Провайдеры.ar_Включён = ИСТИНА
		|	И Провайдеры.ar_ПоддерживаетToolCalls = ИСТИНА
		|	И НЕ Провайдеры.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Провайдеры.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
