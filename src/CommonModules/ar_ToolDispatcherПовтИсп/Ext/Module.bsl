////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolDispatcherПовтИсп (Диспетчер tools, ПовтИсп).
//
// Кеширующая (НаВремяВызова) обёртка для замера производительности инструментов
// (PERF-01) через подсистему БСП «Оценка производительности»:
//   * наличие подсистемы в целевой конфигурации;
//   * ссылка на её общий модуль ОценкаПроизводительности.
//
// Кеш НаВремяВызова живёт в пределах одного серверного вызова - следующий
// отдельный вызов tool всегда видит актуальное состояние конфигурации.
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, ServerCall = false, Privileged = false,
//   ReturnValuesReuse = НаВремяВызова (DuringRequest).
//
// См. ar_ToolDispatcher.Вызвать (шаг 5), .docs/specs/PERF-01.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет наличие подсистемы БСП «Оценка производительности» в целевой
// конфигурации. Кешируется на время текущего серверного вызова - platform
// пересчитывает результат только на границе следующего отдельного вызова.
//
// Возвращаемое значение:
//  Булево - Истина, если подсистема присутствует в конфигурации.
//
Функция ПодсистемаОценкаПроизводительностиЕсть() Экспорт

	Возврат ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ОценкаПроизводительности");

КонецФункции

// Возвращает ссылку на общий модуль ОценкаПроизводительности либо Неопределено,
// если подсистема отсутствует в конфигурации. Кешируется на время текущего
// серверного вызова - вызывать только после проверки
// ПодсистемаОценкаПроизводительностиЕсть() (без неё ОбщийМодуль(...) на
// конфигурации без подсистемы упадёт).
//
// Возвращаемое значение:
//  ОбщийМодуль, Неопределено - модуль ОценкаПроизводительности БСП, либо
//  Неопределено, если подсистемы нет.
//
Функция МодульОценкаПроизводительности() Экспорт

	Если Не ПодсистемаОценкаПроизводительностиЕсть() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.ОбщийМодуль("ОценкаПроизводительности");

КонецФункции

#КонецОбласти
