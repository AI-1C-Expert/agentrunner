////////////////////////////////////////////////////////////////////////////////
// Модуль проверки актуальной версии расширения AgentRunner.
// Делает GET https://agentrunner.ru/latest.json?install_id=<uuid>, сравнивает
// с текущей версией из ar_Утилиты.ВерсияРасширения() (метаданные подключённого
// расширения, Configuration.xml.Version). install_id - анонимный постоянный
// ID инсталляции (см. agentrunner_site/.docs/ext-install-id-requirement.md),
// используется сайтом только для подсчёта активных установок. Вызывается
// регламентным заданием ar_ПроверкаВерсии (раз в сутки) и при открытии формы
// настроек.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет актуальность версии расширения, запрашивая agentrunner.ru.
//
// Возвращаемое значение:
//  Структура - поля:
//   * ЕстьОбновление    - Булево
//   * ПоследняяВерсия   - Строка - SemVer последней версии
//   * URL               - Строка - ссылка на страницу релизов
//   * ОшибкаПолучения   - Строка - пусто если успех
//
Функция ПроверитьВерсию() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЕстьОбновление",  Ложь);
	Результат.Вставить("ПоследняяВерсия", "");
	Результат.Вставить("URL",             "");
	Результат.Вставить("ОшибкаПолучения", "");

	// Текущую версию берём из метаданных подключённого расширения
	// (Configuration.xml.Version) через ar_Утилиты.ВерсияРасширения() -
	// единый достоверный источник фактически загруженной в ИБ версии
	// (Расширения[0].Версия).
	ТекущаяВерсия = ar_Утилиты.ВерсияРасширения();

	ПортHTTPS    = 443;
	ТаймаутСек   = 10;
	КодОК        = 200;

	InstallId = ПолучитьИлиСоздатьInstallId();

	ПутьЗапроса = "/latest.json";
	Если Не ПустаяСтрока(InstallId) Тогда
		ПутьЗапроса = ПутьЗапроса + "?install_id=" + InstallId;
	КонецЕсли;

	ТелоОтвета = "";
	Попытка
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(
			Неопределено, Новый СертификатыУдостоверяющихЦентровОС);
		Соединение = Новый HTTPСоединение(
			ar_Константы.ВерсионныйХост(), ПортHTTPS, , , Неопределено, ТаймаутСек, ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(ПутьЗапроса);
		Запрос.Заголовки.Вставить("Accept", "application/json");
		Ответ = Соединение.Получить(Запрос);
		Если Ответ.КодСостояния <> КодОК Тогда
			Результат.ОшибкаПолучения = НСтр("ru = 'Сервер вернул код'; en = 'Server returned code'")
				+ " " + Ответ.КодСостояния;
			Возврат Результат;
		КонецЕсли;
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Исключение
		Результат.ОшибкаПолучения = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	ДанныеJSON = ar_JSON.ИзJSON(ТелоОтвета);

	КлючLatest    = "latest";
	КлючURL       = "url";

	JSONНекорректен = ДанныеJSON = Неопределено
		Или ТипЗнч(ДанныеJSON) <> Тип("Соответствие")
		Или ДанныеJSON[КлючLatest] = Неопределено
		Или ПустаяСтрока(ДанныеJSON[КлючLatest]);

	Если JSONНекорректен Тогда
		Результат.ОшибкаПолучения = НСтр(
			"ru = 'Некорректный формат ответа latest.json';"
			+ "en = 'Invalid latest.json response format'");
		Возврат Результат;
	КонецЕсли;

	ПоследняяВерсия = ДанныеJSON[КлючLatest];
	URLРелизов = ДанныеJSON[КлючURL];
	Если URLРелизов = Неопределено Или ТипЗнч(URLРелизов) <> Тип("Строка") Или ПустаяСтрока(URLРелизов) Тогда
		URLРелизов = ar_Константы.URLСтраницыРелизов();
	КонецЕсли;

	Результат.ПоследняяВерсия = ПоследняяВерсия;
	Результат.URL              = URLРелизов;

	// Если текущую версию не удалось определить ("?" - расширение не найдено
	// среди подключённых), не показываем обновление: сравнивать не с чем.
	Если ТекущаяВерсия = "?" Тогда
		Возврат Результат;
	КонецЕсли;

	Если СравнитьВерсии(ТекущаяВерсия, ПоследняяВерсия) < 0 Тогда
		Результат.ЕстьОбновление = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сравнивает две SemVer-строки (major.minor.patch).
// Нечисловые компоненты (пред-релизные суффиксы вроде "1.0.0-alpha")
// интерпретируются как 0 - безопасный дефолт.
// Возвращает: -1 если В1 < В2, 0 если равны, 1 если В1 > В2.
//
// Используется также ar_ОбновлениеРасширения для сортировки/отбора
// обработчиков обновления по версии.
//
// Параметры:
//   В1 - Строка - первая версия (например "0.1.0").
//   В2 - Строка - вторая версия (например "0.2.0").
//
// Возвращаемое значение:
//   Число - -1, 0 или 1.
//
Функция СравнитьВерсии(В1, В2) Экспорт

	Части1 = СтрРазделить(В1, ".", Ложь);
	Части2 = СтрРазделить(В2, ".", Ложь);

	КоличествоЧастей = Макс(Части1.Количество(), Части2.Количество());
	Для Индекс = 0 По КоличествоЧастей - 1 Цикл
		Ч1 = ЧастьВерсии(Части1, Индекс);
		Ч2 = ЧастьВерсии(Части2, Индекс);
		Если Ч1 < Ч2 Тогда
			Возврат -1;
		ИначеЕсли Ч1 > Ч2 Тогда
			Возврат 1;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает постоянный анонимный ID инсталляции для логирования на сайте
// (см. agentrunner_site/.docs/ext-install-id-requirement.md). Генерируется
// лениво при первом обращении и сохраняется через ar_Secrets - переживает
// перезапуск 1С и обновление версии расширения. Содержит только случайный
// UUID, никаких данных, идентифицирующих организацию.
//
// Возвращаемое значение:
//   Строка - UUID (36 символов) либо "" при ошибке хранилища/генерации
//            (запрос всё равно уйдёт, просто без install_id).
//
Функция ПолучитьИлиСоздатьInstallId()

	Попытка
		Существующий = ar_Secrets.Прочитать(ar_Secrets.КлючУстановки());
		Если Существующий <> Неопределено И Не ПустаяСтрока(Существующий) Тогда
			Возврат Существующий;
		КонецЕсли;

		СозданныйId = ar_Утилиты.НовыйUUID();
		Если ПустаяСтрока(СозданныйId) Тогда
			Возврат "";
		КонецЕсли;

		ar_Secrets.Сохранить(ar_Secrets.КлючУстановки(), СозданныйId);
		Возврат СозданныйId;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Извлекает числовой компонент версии из массива частей по индексу.
// Возвращает 0 если индекс выходит за границы или значение не является числом.
// Пред-релизные суффиксы (дефис и далее) обрезаются перед конвертацией.
//
// Параметры:
//   Части  - Массив - массив строк (компонентов версии).
//   Индекс - Число  - индекс нужного компонента (0-based).
//
// Возвращаемое значение:
//   Число - числовое значение компонента или 0.
//
Функция ЧастьВерсии(Части, Индекс)

	Если Индекс >= Части.Количество() Тогда
		Возврат 0;
	КонецЕсли;

	СтрЧасти = СокрЛП(Части[Индекс]);

	// Пред-релизные суффиксы ("alpha", "beta", "rc.1") обрезаем по первому дефису.
	ПозДефиса = СтрНайти(СтрЧасти, "-");
	Если ПозДефиса > 0 Тогда
		СтрЧасти = Лев(СтрЧасти, ПозДефиса - 1);
	КонецЕсли;

	// Проверяем что строка состоит только из цифр перед конвертацией.
	Если Не СтрЧасти = Формат(Формат(СтрЧасти, "ЧГ=0"), "ЧГ=0") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(СтрЧасти);

КонецФункции

#КонецОбласти
