////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_LLMOpenAI (AOS LLM OpenAI).
//
// Первый LLM-провайдер ядра AgentRunner. Реализует чат с OpenAI Chat Completions
// API (/v1/chat/completions) через ar_HTTP.ВыполнитьPOST. Принимает сообщения
// во внутреннем универсальном формате AgentRunner и возвращает ответ в том же
// формате, включая tool_calls и usage.
//
// Свойства модуля: Сервер, без привилегированного режима. Привилегированный
// режим устанавливается внутри ar_Secrets.Прочитать при чтении API-ключа.
//
// Контракт: см. ar_LLMКонтракт (формат сообщений, ключи структуры результата,
// валидаторы). Локальный НовыйРезультат() сохранён по образцу
// ar_LLMКонтракт.НовыйОтвет() для бинарной совместимости.
//
// См. спеку: .docs/specs/LLM-01.md, Plan §3.14, §11.7.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет запрос к OpenAI Chat Completions API.
//
// Параметры:
//   Сообщения  - Массив   - список сообщений во внутреннем формате AgentRunner.
//                           Каждый элемент — Структура с ключами:
//                             role         - Строка ("system" | "user" | "assistant" | "tool")
//                             content      - Строка
//                             tool_calls   - Массив структур (опционально, для assistant)
//                             tool_call_id - Строка (опционально, для tool)
//                             name         - Строка (опционально, для tool)
//   Параметры  - Структура - {Провайдер (СправочникСсылка.ar_LLMПровайдеры),
//                             Модель (Строка),
//                             Температура (Число),
//                             МаксТокенов (Число),
//                             Tools (Массив манифестов)}
//
// Возвращаемое значение:
//   Структура - {Успех, Сообщение, ТокеновВход, ТокеновВыход, Ошибка, КодСостояния}
//
Функция Чат(Сообщения, Параметры) Экспорт

	Результат = НовыйРезультат();

	// --- Валидация входа ---------------------------------------------------
	Если ТипЗнч(Сообщения) <> Тип("Массив") Или Сообщения.Количество() = 0 Тогда
		Результат.Ошибка = "Сообщения не заданы";
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Результат.Ошибка = "Параметры не заданы";
		Возврат Результат;
	КонецЕсли;

	Провайдер = Неопределено;
	Параметры.Свойство("Провайдер", Провайдер);
	Если Провайдер = Неопределено Или НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Результат.Ошибка = "Провайдер не задан";
		Возврат Результат;
	КонецЕсли;

	// --- Чтение реквизитов провайдера --------------------------------------
	BaseURL = "";
	КлючИдентификатор = "";
	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер, "ar_BaseURL, ar_APIKeyИдентификатор");
		BaseURL = СокрЛП(Строка(Реквизиты.ar_BaseURL));
		КлючИдентификатор = СокрЛП(Строка(Реквизиты.ar_APIKeyИдентификатор));
	Исключение
		Результат.Ошибка = "Не удалось прочитать провайдера: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(BaseURL) Тогда
		Результат.Ошибка = "BaseURL не задан у провайдера";
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(КлючИдентификатор) Тогда
		Результат.Ошибка = "Идентификатор API-ключа не задан у провайдера";
		Возврат Результат;
	КонецЕсли;

	// --- Чтение API-ключа из БезопасногоХранилища -------------------------
	APIKey = Неопределено;
	Попытка
		APIKey = ar_Secrets.Прочитать(ar_Secrets.КлючПровайдера(КлючИдентификатор));
	Исключение
		Результат.Ошибка = "Не удалось прочитать API-ключ";
		Возврат Результат;
	КонецПопытки;

	Если APIKey = Неопределено Или ТипЗнч(APIKey) <> Тип("Строка") Или ПустаяСтрока(APIKey) Тогда
		Результат.Ошибка = "API-ключ не задан для провайдера";
		Возврат Результат;
	КонецЕсли;

	// --- Модель ------------------------------------------------------------
	Модель = "";
	Параметры.Свойство("Модель", Модель);
	Если ТипЗнч(Модель) <> Тип("Строка") Или ПустаяСтрока(Модель) Тогда
		Модель = "gpt-4o";
	КонецЕсли;

	// --- Сборка тела запроса ----------------------------------------------
	ТелоJSON = "";
	Попытка
		ТелоJSON = ПостроитьТелоЗапроса(Модель, Сообщения, Параметры);
	Исключение
		Результат.Ошибка = "Ошибка сериализации запроса: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	// --- HTTP-вызов --------------------------------------------------------
	URL = ПостроитьURL(BaseURL);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + APIKey);
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");

	// Структура.Свойство() при отсутствии ключа записывает в переменную Неопределено,
	// поэтому тип проверяем после вызова, а не полагаемся на инициализацию.
	Таймаут = 0;
	ЗначениеТаймаута = Неопределено;
	Если Параметры.Свойство("Таймаут", ЗначениеТаймаута)
		И ТипЗнч(ЗначениеТаймаута) = Тип("Число") Тогда
		Таймаут = ЗначениеТаймаута;
	КонецЕсли;

	// HTTP-04: идемпотентный ключ для защиты от двойной оплаты при ретраях.
	// UUID генерируется один раз на логический вызов Чат(); при сетевом ретрае
	// в рамках одного вызова OpenAI вернёт кешированный ответ (где поддерживает).
	// Технический долг: при ретраях в ar_LLMДиспетчер (LLM-02) генерируется новый
	// UUID, т.к. диспетчер вызывает Чат заново — см. HTTP-04 spec, раздел "Риски".
	IdempotencyKey = Строка(Новый УникальныйИдентификатор());

	// HTTP-05: если у провайдера установлен флаг ar_ИспользоватьПрокси —
	// получаем объект ИнтернетПрокси через БСП и передаём в HTTP-вызов.
	Прокси = ПолучитьПрокси(Провайдер);

	HTTPОтвет = ar_HTTP.ВыполнитьPOST(URL, Заголовки, ТелоJSON,
		?(Таймаут > 0, Таймаут, 0), IdempotencyKey, Прокси);

	Результат.КодСостояния = HTTPОтвет.КодСостояния;

	// --- Обработка ошибок HTTP --------------------------------------------
	Если HTTPОтвет.КодСостояния = 0 Тогда
		Результат.Ошибка = ?(ПустаяСтрока(HTTPОтвет.Ошибка), "Сетевая ошибка", HTTPОтвет.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		Результат.Ошибка = СообщениеОбОшибкеHTTP(HTTPОтвет.КодСостояния, HTTPОтвет.Тело);
		Возврат Результат;
	КонецЕсли;

	// --- Парсинг ответа ----------------------------------------------------
	Попытка
		Ответ = ПрочитатьJSONСтроку(HTTPОтвет.Тело);
	Исключение
		Результат.Ошибка = "Ошибка парсинга ответа: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "Ответ LLM не является объектом";
		Возврат Результат;
	КонецЕсли;

	Choices = Ответ.Получить("choices");
	Если ТипЗнч(Choices) <> Тип("Массив") Или Choices.Количество() = 0 Тогда
		Результат.Ошибка = "Ответ LLM не содержит вариантов";
		Возврат Результат;
	КонецЕсли;

	ПервыйChoice = Choices[0];
	Если ТипЗнч(ПервыйChoice) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "Ответ LLM имеет некорректную структуру choices";
		Возврат Результат;
	КонецЕсли;

	СообщениеOpenAI = ПервыйChoice.Получить("message");
	Если ТипЗнч(СообщениеOpenAI) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "Ответ LLM не содержит message";
		Возврат Результат;
	КонецЕсли;

	Результат.Сообщение = СообщениеИзФорматаOpenAI(СообщениеOpenAI);

	// --- Usage -------------------------------------------------------------
	// LLM-06: единый парсер usage через ar_LLMКонтракт; нули при отсутствии блока.
	ПарситьUsage(Ответ, Результат);

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// HTTP-05: возвращает объект ИнтернетПрокси для провайдера, либо Неопределено.
//
// Если у провайдера установлен флаг ar_ИспользоватьПрокси — вызывается
// БСП-метод ПолучениеФайловИзИнтернета.ПолучитьПрокси("https"), который
// возвращает прокси на основании настроек кластера/сервера.
//
// При отсутствии подсистемы РаботаСФайлами или ошибке получения прокси —
// возвращается Неопределено (соединение пойдёт напрямую), а событие
// фиксируется в журнале регистрации как предупреждение.
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры - ссылка на провайдера.
//
// Возвращаемое значение:
//   ИнтернетПрокси, Неопределено - объект прокси или Неопределено.
//
Функция ПолучитьПрокси(Провайдер)

	ИспользоватьПрокси = Ложь;
	Попытка
		РеквизитыПрокси = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер, "ar_ИспользоватьПрокси");
		Если ТипЗнч(РеквизитыПрокси.ar_ИспользоватьПрокси) = Тип("Булево") Тогда
			ИспользоватьПрокси = РеквизитыПрокси.ar_ИспользоватьПрокси;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ИспользоватьПрокси Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("ПолучениеФайловИзИнтернета") = Неопределено Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Подсистема РаботаСФайлами недоступна — прокси не используется';
			    |en = 'Subsystem FilesOperations is unavailable — proxy is not used'"));
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
	Исключение
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Не удалось получить ИнтернетПрокси';
			    |en = 'Failed to obtain InternetProxy'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Формирует структуру результата по умолчанию (Успех = Ложь).
Функция НовыйРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);
	Возврат Результат;
КонецФункции

// Строит итоговый URL вида <BaseURL>/v1/chat/completions.
// BaseURL может быть с / на конце или без, и может уже содержать /v1.
Функция ПостроитьURL(BaseURL)

	База = СокрЛП(BaseURL);
	Пока СтрДлина(База) > 0 И Прав(База, 1) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;

	Если СтрДлина(База) >= 3 И Прав(База, 3) = "/v1" Тогда
		Возврат База + "/chat/completions";
	КонецЕсли;

	Возврат База + "/v1/chat/completions";

КонецФункции

// Строит JSON-тело запроса OpenAI.
Функция ПостроитьТелоЗапроса(Модель, Сообщения, Параметры)

	Тело = Новый Соответствие;
	Тело.Вставить("model", Модель);
	Тело.Вставить("messages", СообщенияВФорматOpenAI(Сообщения));

	Температура = Неопределено;
	Если Параметры.Свойство("Температура", Температура) И Температура <> Неопределено Тогда
		Если ТипЗнч(Температура) = Тип("Число") Тогда
			Тело.Вставить("temperature", Температура);
		КонецЕсли;
	КонецЕсли;

	МаксТокенов = 0;
	Если Параметры.Свойство("МаксТокенов", МаксТокенов) И ТипЗнч(МаксТокенов) = Тип("Число") И МаксТокенов > 0 Тогда
		Тело.Вставить("max_tokens", МаксТокенов);
	КонецЕсли;

	Tools = Неопределено;
	Если Параметры.Свойство("Tools", Tools) И ТипЗнч(Tools) = Тип("Массив") И Tools.Количество() > 0 Тогда
		Тело.Вставить("tools", Tools);
	КонецЕсли;

	Возврат ЗаписатьJSONСтроку(Тело);

КонецФункции

// Сериализует массив внутренних сообщений в массив соответствий формата OpenAI.
Функция СообщенияВФорматOpenAI(Сообщения)

	Результат = Новый Массив;

	Для Каждого Сообщение Из Сообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Соответствие;

		Role = "";
		Сообщение.Свойство("role", Role);
		Элемент.Вставить("role", Строка(Role));

		Content = "";
		Сообщение.Свойство("content", Content);

		ToolCalls = Неопределено;
		Сообщение.Свойство("tool_calls", ToolCalls);
		ЕстьToolCalls = (ТипЗнч(ToolCalls) = Тип("Массив") И ToolCalls.Количество() > 0);

		Если Role = "assistant" И ЕстьToolCalls Тогда
			Элемент.Вставить("content", Неопределено); // Платформа сериализует Неопределено как JSON null
			Элемент.Вставить("tool_calls", ToolCallsВФорматOpenAI(ToolCalls));
		Иначе
			Элемент.Вставить("content", Строка(Content));
		КонецЕсли;

		Если Role = "tool" Тогда
			ToolCallId = "";
			Сообщение.Свойство("tool_call_id", ToolCallId);
			Элемент.Вставить("tool_call_id", Строка(ToolCallId));

			ИмяTool = "";
			Если Сообщение.Свойство("name", ИмяTool) И НЕ ПустаяСтрока(Строка(ИмяTool)) Тогда
				Элемент.Вставить("name", Строка(ИмяTool));
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сериализует массив tool_calls (Структур) в массив Соответствий.
Функция ToolCallsВФорматOpenAI(ToolCalls)

	Результат = Новый Массив;

	Для Каждого Вызов Из ToolCalls Цикл

		Если ТипЗнч(Вызов) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Соответствие;

		ИдВызова = "";
		Вызов.Свойство("id", ИдВызова);
		Элемент.Вставить("id", Строка(ИдВызова));

		ТипВызова = "function";
		Вызов.Свойство("type", ТипВызова);
		Элемент.Вставить("type", Строка(ТипВызова));

		ФункцияВызова = Неопределено;
		Вызов.Свойство("function", ФункцияВызова);

		ФункцияMap = Новый Соответствие;
		Если ТипЗнч(ФункцияВызова) = Тип("Структура") Тогда
			ИмяФункции = "";
			ФункцияВызова.Свойство("name", ИмяФункции);
			ФункцияMap.Вставить("name", Строка(ИмяФункции));

			Аргументы = "";
			ФункцияВызова.Свойство("arguments", Аргументы);
			ФункцияMap.Вставить("arguments", Строка(Аргументы));
		КонецЕсли;
		Элемент.Вставить("function", ФункцияMap);

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конвертирует Соответствие message (из ответа OpenAI) во внутреннюю Структуру.
Функция СообщениеИзФорматаOpenAI(СообщениеOpenAI)

	Результат = Новый Структура;

	Role = СообщениеOpenAI.Получить("role");
	Результат.Вставить("role", ?(ТипЗнч(Role) = Тип("Строка"), Role, "assistant"));

	Content = СообщениеOpenAI.Получить("content");
	Если Content = Неопределено ИЛИ ТипЗнч(Content) <> Тип("Строка") Тогда
		Результат.Вставить("content", "");
	Иначе
		Результат.Вставить("content", Content);
	КонецЕсли;

	ToolCallsRaw = СообщениеOpenAI.Получить("tool_calls");
	Если ТипЗнч(ToolCallsRaw) = Тип("Массив") И ToolCallsRaw.Количество() > 0 Тогда
		Результат.Вставить("tool_calls", ToolCallsИзФорматаOpenAI(ToolCallsRaw));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Конвертирует массив tool_calls из Соответствий во внутренние Структуры.
Функция ToolCallsИзФорматаOpenAI(ToolCallsRaw)

	Результат = Новый Массив;

	Для Каждого Вызов Из ToolCallsRaw Цикл

		Если ТипЗнч(Вызов) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		Структ = Новый Структура;

		ИдВызова = Вызов.Получить("id");
		Структ.Вставить("id", ?(ТипЗнч(ИдВызова) = Тип("Строка"), ИдВызова, ""));

		ТипВызова = Вызов.Получить("type");
		Структ.Вставить("type", ?(ТипЗнч(ТипВызова) = Тип("Строка"), ТипВызова, "function"));

		ФункцияRaw = Вызов.Получить("function");
		ФункцияСтрукт = Новый Структура;
		Если ТипЗнч(ФункцияRaw) = Тип("Соответствие") Тогда
			ИмяФ = ФункцияRaw.Получить("name");
			ФункцияСтрукт.Вставить("name", ?(ТипЗнч(ИмяФ) = Тип("Строка"), ИмяФ, ""));

			АргументыФ = ФункцияRaw.Получить("arguments");
			ФункцияСтрукт.Вставить("arguments", ?(ТипЗнч(АргументыФ) = Тип("Строка"), АргументыФ, ""));
		Иначе
			ФункцияСтрукт.Вставить("name", "");
			ФункцияСтрукт.Вставить("arguments", "");
		КонецЕсли;
		Структ.Вставить("function", ФункцияСтрукт);

		Результат.Добавить(Структ);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает строку JSON-сериализации значения с настройками AgentRunner:
//   * двойные кавычки;
//   * сохранение null;
//   * даты в ISO 8601.
Функция ЗаписатьJSONСтроку(Значение)

	НастройкиЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "", Истина);

	// Свойства СохранятьNull у НастройкиСериализацииJSON не существует (платформа
	// и так сериализует Неопределено как JSON null по умолчанию). Правильное имя
	// свойства формата дат - ФорматСериализацииДаты (проверено по реальному
	// использованию в БП: DataProcessors/МенеджерКонвертацииУправлениеПерсоналом).
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(НастройкиЗаписи);
	ЗаписатьJSON(Запись, Значение, НастройкиСериализации);
	Возврат Запись.Закрыть();

КонецФункции

// Десериализует JSON-строку в Соответствие/Массив (ЧитатьВСоответствие = Истина).
Функция ПрочитатьJSONСтроку(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Извлекает usage из JSON-ответа OpenAI и кладёт в Результат.ТокеновВход/ТокеновВыход.
//
// При отсутствии блока usage (некоторые локальные модели, ошибочный ответ API) —
// оставляет нули и пишет запись в журнал регистрации уровня Информация.
// Числовое приведение делегируется ar_LLMКонтракт.ИзвлечьЧисло (LLM-06).
//
// Параметры:
//   Ответ     - Соответствие - распарсенный JSON ответа OpenAI.
//   Результат - Структура    - модифицируется: ТокеновВход / ТокеновВыход.
//
Процедура ПарситьUsage(Ответ, Результат)

	Usage = Ответ.Получить("usage");

	Если ТипЗнч(Usage) <> Тип("Соответствие") Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.LLM.Usage",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.ОбщиеМодули.ar_LLMOpenAI,
			,
			НСтр("ru = 'Блок usage отсутствует в ответе OpenAI; токены не учтены';
			    |en = 'Usage block is missing in OpenAI response; tokens not counted'"));
		Возврат;
	КонецЕсли;

	Результат.ТокеновВход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("prompt_tokens"));
	Результат.ТокеновВыход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("completion_tokens"));

КонецПроцедуры

// Формирует текст ошибки для HTTP-кода != 200, извлекая error.message если есть.
Функция СообщениеОбОшибкеHTTP(КодСостояния, Тело)

	КраткоеТело = "";
	Если ТипЗнч(Тело) = Тип("Строка") И НЕ ПустаяСтрока(Тело) Тогда
		Попытка
			Распарсенное = ПрочитатьJSONСтроку(Тело);
			Если ТипЗнч(Распарсенное) = Тип("Соответствие") Тогда
				ErrorНоды = Распарсенное.Получить("error");
				Если ТипЗнч(ErrorНоды) = Тип("Соответствие") Тогда
					Сообщ = ErrorНоды.Получить("message");
					Если ТипЗнч(Сообщ) = Тип("Строка") Тогда
						КраткоеТело = Сообщ;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// игнорируем — оставим КраткоеТело пустым
		КонецПопытки;
	КонецЕсли;

	Префикс = "";
	Если КодСостояния = 401 Тогда
		Префикс = "Ошибка авторизации LLM: 401";
	ИначеЕсли КодСостояния = 429 Тогда
		Префикс = "Rate limit LLM: 429";
	ИначеЕсли КодСостояния >= 500 Тогда
		Префикс = "Ошибка сервера LLM: " + Формат(КодСостояния, "ЧГ=");
	Иначе
		Префикс = "Ошибка LLM: " + Формат(КодСостояния, "ЧГ=");
	КонецЕсли;

	Если ПустаяСтрока(КраткоеТело) Тогда
		Возврат Префикс;
	КонецЕсли;

	Возврат Префикс + ": " + КраткоеТело;

КонецФункции

#КонецОбласти
