// ar_МаппингМетаданных (UNIV-02): indirection для имён реквизитов/табличных
// частей при ЧТЕНИИ данных прикладных объектов (документ "Счёт", справочник
// "Контрагенты" и т.п.) в tool-модулях (ar_ToolДокументы, ar_ToolCRM).
//
// Тот же принцип, что уже применён к именам объектов метаданных
// (ar_ToolDispatcher.ИмяОбъектаМетаданных, регистр ar_ПереопределенияОбъектов),
// но источник значений - регистр ar_ПрофильКонфигурации (UNIV-01), т.к.
// реквизиты - доменная семантика конкретного tool-а ("клиент счёта", "сумма
// счёта"), а не общий каталог переопределений объектов.
//
// Граница (важно, зафиксировано по решению аналитика/пользователя UNIV-02):
// путь ЗАПИСИ документов (ar_АдаптерБП, ar_АдаптерЗаполнения, UNIV-06) этот
// модуль НЕ использует и не должен использовать - заполнение документа
// идёт через родной механизм конфигурации (Заполнить() -> ОбработкаЗаполнения
// -> функциональные опции, учётная политика, десятки связанных полей),
// который indirection по именам реквизитов не решает и решать не должен
// (см. докстринг ar_АдаптерБП). Единственный потребитель этого модуля -
// операции ЧТЕНИЯ.
//
// Модуль не хранит словарь дефолтов - каждый вызывающий tool передаёт свой
// ИмяПоУмолчанию вторым параметром. Модуль только читает профиль и решает,
// что вернуть.

#Область ПрограммныйИнтерфейс

// Возвращает фактическое имя реквизита (или табличной части) объекта
// метаданных для использования в тексте запроса - с учётом переопределения
// через ar_ПрофильКонфигурации (UNIV-01).
//
// Приоритет: если для ЛогическийКлюч в профиле есть непустое значение
// (записано автоматически UNIV-01 ЗаполнитьАвтоматически() при Тип="БП",
// либо вручную через ar_ПрофильКонфигурации.Установить(..., "manual"), либо
// в будущем импортом пресета UNIV-04 через "preset") - используется оно.
// Иначе возвращается ИмяПоУмолчанию, зашитое в коде вызывающего модуля.
//
// Не бросает исключений: если ar_ПрофильКонфигурации по какой-либо причине
// недоступен (крайний случай), возвращается ИмяПоУмолчанию - вызывающий
// код никогда не должен упасть из-за этого фасада.
//
// Параметры:
//  ЛогическийКлюч  - Строка - стабильный доменный ключ, например
//                    "invoice.total_attribute", "invoice.items_table".
//  ИмяПоУмолчанию  - Строка - имя реквизита или табличной части, зашитое в
//                    коде вызывающего модуля, применяется, если в профиле
//                    нет записи.
//
// Возвращаемое значение:
//  Строка - фактическое имя реквизита/табличной части для использования в
//           МД.Реквизиты.Найти(...) / МД.ТабличныеЧасти.Найти(...) и в
//           тексте запроса.
//
Функция ИмяРеквизита(Знач ЛогическийКлюч, Знач ИмяПоУмолчанию) Экспорт

	Попытка
		ИзПрофиля = ar_ПрофильКонфигурации.Значение(ЛогическийКлюч, "");
	Исключение
		// Крайний случай - модуль ar_ПрофильКонфигурации недоступен.
		// Диспетчер/tool-слой не должен падать из-за фасада маппинга.
		ТекстПредупреждения = СтрШаблон("Ключ=""%1"": %2", ЛогическийКлюч,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать(
			"ar_МаппингМетаданных.ИмяРеквизита",
			"profile_module_unavailable",
			ТекстПредупреждения,
			"Предупреждение");
		Возврат ИмяПоУмолчанию;
	КонецПопытки;

	Если Не ПустаяСтрока(ИзПрофиля) Тогда
		Возврат ИзПрофиля;
	КонецЕсли;

	Возврат ИмяПоУмолчанию;

КонецФункции

#КонецОбласти
