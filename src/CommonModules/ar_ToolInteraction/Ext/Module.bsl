////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolInteraction (Tool - взаимодействие с пользователем).
//
// Реализует tool ask_user - единственный законный способ для агента задать
// уточняющий вопрос оператору в рамках запуска (Plan 2.8, 3.2, TOOL-19).
//
// ask_user приостанавливает фоновое задание (статус PausedForInput), создает
// запись ar_ОчередьApproval со статусом "awaiting_input", сохраняет
// StateSnapshot и фиксирует аудит-событие user_input_requested.
// После ответа оператора регламентное задание ВозобновлениеПослеApproval
// (SCHED-03) подхватывает запись со статусом "answered" и передает
// UserAnswer как tool_result в восстановленный контекст LLM.
//
// Отличия от approval-flow (APPR-01):
//   * RiskLevel = Read  - tool только получает информацию, не мутирует данные.
//   * ТребуетApproval = Ложь - пауза управляется самим tool.
//   * Статус очереди "awaiting_input", а не "pending".
//   * Статус запуска PausedForInput, а не PausedForApproval.
//   * Payload содержит флаг ask_user:true и поле choices (опциональные варианты).
//
// Граничные случаи:
//   * question пуста или > 2000 символов -> observation {"error":"invalid_question"}.
//   * choices задан, но пуст -> игнорируется (поле свободного ввода).
//   * choices > 20 вариантов -> обрезать до 20, добавить "truncated":true.
//   * DryRun=Истина -> observation {"dry_run":true,"would_ask":"<question>"}.
//   * Запуск в финальном статусе -> observation {"error":"run_is_final"}.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/TOOL-19.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня (контракт Слоя 0 - ar_ToolDispatcher.ВыполнитьЯдровойМодуль).
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя процедуры tool из ar_Tools.ar_ИмяПроцедуры.
//  Аргументы    - Строка    - JSON-аргументы tool (обогащенные диспетчером).
//  Контекст     - Структура - КонтекстЗапуска {RunId, Агент, DryRun, Sequence, ...}.
//
// Возвращаемое значение:
//  Строка - JSON-observation для LLM.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ЗадатьВопросПользователю" Тогда
		Возврат ЗадатьВопросПользователю(Аргументы, Контекст);
	КонецЕсли;

	ОбъектОтвета = Новый Структура;
	ОбъектОтвета.Вставить("error", "unknown_procedure: " + ИмяПроцедуры);
	Возврат ar_JSON.ВЗначениеJSON(ОбъектОтвета);

КонецФункции

// Зарегистрировать tool ask_user в справочнике ar_Tools.
//
// Вызывается из ar_ToolDispatcher.ЗарегистрироватьВсеTools() при первом
// развертывании. Идемпотентно: если tool уже существует - обновляет поля.
//
Процедура ЗарегистрироватьTools() Экспорт

	Манифест = НовыйМанифестAskUser();
	ИмяTool = "ask_user";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", ИмяTool);

	Выборка = Запрос.Выполнить().Выбрать();

	НачатьТранзакцию();
	Попытка

		Если Выборка.Следующий() Тогда
			Объект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.ar_Tools.СоздатьЭлемент();
		КонецЕсли;

		Объект.ar_Имя            = ИмяTool;
		Объект.ar_ОбщийМодуль    = "ar_ToolInteraction";
		Объект.ar_ИмяПроцедуры   = "ЗадатьВопросПользователю";
		Объект.ar_Включён         = Истина;
		Объект.ar_ТребуетApproval = Ложь;
		Объект.ar_JSONManifest    = Манифест;
		Объект.ar_RiskLevel       = Перечисления.ar_RiskLevel.Read;

		Объект.Записать();

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Реализация tool ask_user.
//
// Параметры:
//  АргументыJSON - Строка    - JSON с полями question, hint (опц.), choices (опц.),
//                              _dry_run (проставляется диспетчером).
//  Контекст      - Структура - КонтекстЗапуска {RunId, Агент, DryRun, Sequence}.
//
// Возвращаемое значение:
//  Строка - JSON-observation:
//    * DryRun=Истина -> {"dry_run":true,"would_ask":"<question>"}
//    * Нормально     -> {"paused":"awaiting_user_input","approval_id":"<UUID>"}
//    * Ошибка        -> {"error":"<код>"}
//
// Имя выбрано с суффиксом «Пользователю» во избежание конфликта с системной
// функцией платформы ЗадатьВопрос() (AI-аудит code.1c.ai, TOOL-19 итерация 2).
//
Функция ЗадатьВопросПользователю(Знач АргументыJSON, Знач Контекст) Экспорт

	RunId = ЗначениеКонтекста(Контекст, "RunId", "");

	// --- Разбор аргументов ---------------------------------------------------

	Аргументы = РазобратьАргументы(АргументыJSON);
	Вопрос    = СтрокаИзАргументов(Аргументы, "question");
	Подсказка = СтрокаИзАргументовИлиНеопределено(Аргументы, "hint");

	// Варианты ответа: обрезать до 20, пустой массив игнорировать.
	НормализованныеВарианты = НормализоватьВарианты(Аргументы.Получить("choices"));
	Варианты = НормализованныеВарианты.Варианты;
	Усечено  = НормализованныеВарианты.Усечено;

	// --- Валидация вопроса ---------------------------------------------------

	МаксДлинаВопроса = 2000;
	Если ПустаяСтрока(Вопрос) Или СтрДлина(Вопрос) > МаксДлинаВопроса Тогда
		Возврат ОшибочноеObservation("invalid_question");
	КонецЕсли;

	// --- DryRun --------------------------------------------------------------

	DryRun = ar_ToolDispatcher.ИзвлечьDryRun(АргументыJSON);
	Если DryRun Тогда
		ОбъектDryRun = Новый Структура;
		ОбъектDryRun.Вставить("dry_run", Истина);
		ОбъектDryRun.Вставить("would_ask", Вопрос);
		Возврат ar_JSON.ВЗначениеJSON(ОбъектDryRun);
	КонецЕсли;

	// --- Проверка финального статуса запуска ---------------------------------

	Если Не ПустаяСтрока(RunId) И ЗапускВФинальномСтатусе(RunId) Тогда
		Возврат ОшибочноеObservation("run_is_final");
	КонецЕсли;

	// --- Маскировка секретов -------------------------------------------------

	ВопросМаск    = ar_Утилиты.МаскироватьСекреты(Вопрос);
	ПодсказкаМаск = Неопределено;
	Если ТипЗнч(Подсказка) = Тип("Строка") Тогда
		ПодсказкаМаск = ar_Утилиты.МаскироватьСекреты(Подсказка);
	КонецЕсли;

	// --- Извлечение tool_call_id ---------------------------------------------

	ToolCallId = СтрокаИзАргументов(Аргументы, "_tool_call_id");
	Если ПустаяСтрока(ToolCallId) Тогда
		ToolCallId = СтрокаИзАргументов(Аргументы, "tool_call_id");
	КонецЕсли;

	// --- Формирование ActionPayloadJSON --------------------------------------

	ApprovalId = ar_Утилиты.НовыйUUID();
	Sequence   = ЗначениеКонтекста(Контекст, "Sequence", 0);

	Payload = СформироватьPayload(
		ApprovalId, RunId, ВопросМаск, ПодсказкаМаск, Варианты, ToolCallId, Усечено);

	ActionPayloadJSON = ar_JSON.ВЗначениеJSON(Payload);

	// --- Запись в очередь и перевод статуса (через привилегированный фасад) --

	Попытка
		ar_AuditЗащищённыйРежим.ПоставитьВопросВОчередьПривилегированно(
			ApprovalId, RunId, Sequence, ActionPayloadJSON);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочноеObservation("ask_user_enqueue_failed: " + ТекстОшибки);
	КонецПопытки;

	// --- Аудит-событие user_input_requested ----------------------------------

	ЗафиксироватьАудитЗапрос(RunId, ApprovalId, ВопросМаск);

	// --- Observation-маркер паузы для ar_RuntimeЦикл ------------------------

	ОбъектПаузы = Новый Структура;
	ОбъектПаузы.Вставить("paused",      "awaiting_user_input");
	ОбъектПаузы.Вставить("approval_id", ApprovalId);
	Возврат ar_JSON.ВЗначениеJSON(ОбъектПаузы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вернуть JSON-строку ошибки-observation: {"error":"<текст>"}.
//
// Параметры:
//  ТекстОшибки - Строка - код ошибки или описание.
//
// Возвращаемое значение:
//  Строка - JSON-строка {"error":"..."}.
//
Функция ОшибочноеObservation(Знач ТекстОшибки)
	Объект = Новый Структура;
	КодОшибки = ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, "");
	Объект.Вставить("error", КодОшибки);
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""dispatch_error""}", Результат);
КонецФункции

// Нормализовать массив вариантов ответа (choices).
//
// Обрезает до 20 элементов. Пустой массив или не-массив -> Варианты = Неопределено.
//
// Параметры:
//  ЗначениеВариантов - Произвольный - значение ключа "choices" из разобранных аргументов.
//
// Возвращаемое значение:
//  Структура - поля: Варианты (Массив или Неопределено), Усечено (Булево).
//
Функция НормализоватьВарианты(Знач ЗначениеВариантов)

	МаксВариантов = 20;
	Результат = Новый Структура("Варианты, Усечено", Неопределено, Ложь);

	Если ТипЗнч(ЗначениеВариантов) <> Тип("Массив")
		Или ЗначениеВариантов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеВариантов.Количество() > МаксВариантов Тогда
		ОбрезанныйМассив = Новый Массив;
		Для н = 0 По МаксВариантов - 1 Цикл
			ОбрезанныйМассив.Добавить(ЗначениеВариантов[н]);
		КонецЦикла;
		Результат.Варианты = ОбрезанныйМассив;
		Результат.Усечено  = Истина;
	Иначе
		Результат.Варианты = ЗначениеВариантов;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сформировать структуру ActionPayload для записи в очередь.
//
// Параметры:
//  ApprovalId    - Строка          - UUID записи очереди.
//  RunId         - Строка          - идентификатор запуска.
//  ВопросМаск    - Строка          - вопрос с маскированными секретами.
//  ПодсказкаМаск - Строка, Неопределено - подсказка (или Неопределено).
//  Варианты      - Массив, Неопределено - варианты ответа (или Неопределено).
//  ToolCallId    - Строка          - идентификатор вызова tool от LLM.
//  Усечено       - Булево          - признак усечения вариантов.
//
// Возвращаемое значение:
//  Структура - payload для сериализации в JSON.
//
Функция СформироватьPayload(Знач ApprovalId, Знач RunId, Знач ВопросМаск,
	Знач ПодсказкаМаск, Знач Варианты, Знач ToolCallId, Знач Усечено)

	Payload = Новый Структура;
	Payload.Вставить("ask_user",     Истина);
	Payload.Вставить("approval_id",  ApprovalId);
	Payload.Вставить("run_id",       RunId);
	Payload.Вставить("question",     ВопросМаск);
	Payload.Вставить("hint",         ПодсказкаМаск);
	Payload.Вставить("choices",      Варианты);
	Payload.Вставить("tool_call_id", ToolCallId);
	Payload.Вставить("user_answer",  Неопределено);
	Если Усечено Тогда
		Payload.Вставить("truncated", Истина);
	КонецЕсли;
	Возврат Payload;

КонецФункции

// Зафиксировать аудит-событие user_input_requested (fire-and-forget).
//
// Ошибки не блокируют основной поток - пишутся в журнал регистрации.
//
// Параметры:
//  RunId      - Строка - идентификатор запуска.
//  ApprovalId - Строка - UUID записи очереди.
//  Вопрос     - Строка - текст вопроса (маскированный).
//
Процедура ЗафиксироватьАудитЗапрос(Знач RunId, Знач ApprovalId, Знач Вопрос)

	КодСобытия = "user_input_requested";

	Попытка
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("code",        КодСобытия);
		ДанныеСобытия.Вставить("approval_id", ApprovalId);
		ДанныеСобытия.Вставить("question",    Вопрос);
		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, КодСобытия, ДанныеСобытия);
	Исключение
		// Аудит-событие не блокирует основной поток. Ошибка логируется платформой.
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(
			ИнформацияОбОшибке());
		ЗаписатьИнформациюВЖурнал("TOOL-19: аудит " + КодСобытия
			+ " не записан: " + ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Разобрать JSON-аргументы.
//
// Параметры:
//  АргументыJSON - Строка - JSON-строка аргументов tool.
//
// Возвращаемое значение:
//  Соответствие - разобранные аргументы; пустое соответствие при ошибке парсинга.
//
Функция РазобратьАргументы(Знач АргументыJSON)
	Объект = ar_JSON.ИзJSON(АргументыJSON);
	Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Возврат Объект;
	КонецЕсли;
	Возврат Новый Соответствие;
КонецФункции

// Получить строковое значение по ключу из разобранных аргументов.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы tool.
//  Ключ      - Строка       - имя поля.
//
// Возвращаемое значение:
//  Строка - значение поля или пустая строка, если ключ отсутствует или не строка.
//
Функция СтрокаИзАргументов(Знач Аргументы, Знач Ключ)
	Значение = Аргументы.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

// Получить строковое значение или Неопределено, если пустое или не строка.
//
// Параметры:
//  Аргументы - Соответствие - разобранные аргументы tool.
//  Ключ      - Строка       - имя поля.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение поля или Неопределено.
//
Функция СтрокаИзАргументовИлиНеопределено(Знач Аргументы, Знач Ключ)
	Значение = Аргументы.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(СокрЛП(Значение)) Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Проверить, находится ли запуск в финальном статусе (не допускающем паузы).
//
// Параметры:
//  RunId - Строка - идентификатор запуска.
//
// Возвращаемое значение:
//  Булево - Истина, если запуск завершён и пауза невозможна.
//
Функция ЗапускВФинальномСтатусе(Знач RunId)

	МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_RunId = RunId;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;

	Статус = МенеджерЗаписи.ar_Статус;

	Возврат Статус = Перечисления.ar_СтатусЗапуска.Completed
		Или Статус = Перечисления.ar_СтатусЗапуска.Failed
		Или Статус = Перечисления.ar_СтатусЗапуска.Cancelled
		Или Статус = Перечисления.ar_СтатусЗапуска.MaxStepsReached
		Или Статус = Перечисления.ar_СтатусЗапуска.DeniedGlobally
		Или Статус = Перечисления.ar_СтатусЗапуска.Interrupted
		Или Статус = Перечисления.ar_СтатусЗапуска.FailedIncompatibleState;

КонецФункции

// Безопасно получить значение из КонтекстЗапуска (Структура) с дефолтом.
//
// Параметры:
//  Контекст - Структура  - структура КонтекстЗапуска.
//  Ключ     - Строка     - имя поля.
//  Дефолт   - Произвольный - значение по умолчанию.
//
// Возвращаемое значение:
//  Произвольный - значение поля или Дефолт, если поле отсутствует.
//
Функция ЗначениеКонтекста(Знач Контекст, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Дефолт;
	Контекст.Свойство(Ключ, Значение);
	Возврат Значение;
КонецФункции

// Записать информационное сообщение в журнал регистрации.
//
// Параметры:
//  Текст - Строка - текст записи.
//
Процедура ЗаписатьИнформациюВЖурнал(Знач Текст)
	НаименованиеПриложения = НСтр(
		"ru='AgentRunner.ToolInteraction'; en='AgentRunner.ToolInteraction'");
	ЗаписьЖурналаРегистрации(
		НаименованиеПриложения,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Текст);
КонецПроцедуры

// Сформировать JSON-манифест tool ask_user для регистрации в ar_Tools.
//
// Возвращаемое значение:
//  Строка - JSON-манифест функции по схеме OpenAI tool.
//
Функция НовыйМанифестAskUser()

	ОписаниеВопроса = НСтр(
		"ru='Текст вопроса на русском языке, понятный пользователю';"
		+ "en='Question text in Russian, understandable to the user'");
	ОписаниеПодсказки = НСтр(
		"ru='Необязательная подсказка или пример ожидаемого ответа';"
		+ "en='Optional hint or example of expected answer'");
	ОписаниеВариантов = НСтр(
		"ru='Необязательный список вариантов ответа. Если задан, UI покажет кнопки.';"
		+ "en='Optional list of answer choices. If set, UI will show buttons.'");

	Свойства = Новый Структура;
	Свойства.Вставить("question", СтрокаСвойствоManifest(ОписаниеВопроса));
	Свойства.Вставить("hint",     СтрокаСвойствоManifest(ОписаниеПодсказки));
	Свойства.Вставить("choices",  МассивСвойствоManifest(ОписаниеВариантов));

	ТребуемыеПоля = Новый Массив;
	ТребуемыеПоля.Добавить("question");

	Параметры = Новый Структура;
	Параметры.Вставить("type",       "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required",   ТребуемыеПоля);

	ОписаниеTool = НСтр(
		"ru='Задать уточняющий вопрос пользователю."
		+ " Использовать только когда без ответа невозможно продолжить задачу."
		+ " Tool приостанавливает цикл и ждет ответа.';"
		+ "en='Ask the user a clarifying question."
		+ " Use only when the task cannot continue without an answer."
		+ " Tool pauses the cycle and waits for a response.'");

	// ОБЯЗАТЕЛЬНА обёртка {"type":"function","function":{...}} - единый контракт
	// всех tool-манифестов (см. ar_ToolUniversal.МанифестTool). Без неё
	// OpenAI-совместимый провайдер (в т.ч. локальный LM Studio) не распознаёт
	// элемент как вызываемую функцию: ask_user уходил в список плоским, среди
	// корректно обёрнутых соседей, и модель его просто не видела - вместо
	// вызова tool она задавала вопрос обычным текстом в чат.
	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name",        "ask_user");
	ФункцияОписание.Вставить("description", ОписаниеTool);
	ФункцияОписание.Вставить("parameters",  Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type",     "function");
	Манифест.Вставить("function", ФункцияОписание);

	Возврат ar_JSON.ВЗначениеJSON(Манифест);

КонецФункции

// Создать структуру описания строкового свойства манифеста.
//
// Параметры:
//  Описание - Строка - локализованное описание поля.
//
// Возвращаемое значение:
//  Структура - {type: "string", description: "..."}.
//
Функция СтрокаСвойствоManifest(Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type",        "string");
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Создать структуру описания массива строк в манифесте.
//
// Параметры:
//  Описание - Строка - локализованное описание поля.
//
// Возвращаемое значение:
//  Структура - {type: "array", items: {type: "string"}, description: "..."}.
//
Функция МассивСвойствоManifest(Знач Описание)
	Элемент = Новый Структура;
	Элемент.Вставить("type", "string");
	Свойство = Новый Структура;
	Свойство.Вставить("type",        "array");
	Свойство.Вставить("items",       Элемент);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

#КонецОбласти
