////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_LLMТест (Тест LLM-провайдера).
//
// Облегчённая проверка доступности и валидности API-ключа LLM-провайдера.
// Используется формой ar_LLMПровайдеры.ФормаЭлемента (кнопка «Тест соединения»)
// и потенциально автоматическими проверками в дальнейшем.
//
// Делает один HTTP-запрос к /models (или эквиваленту провайдера) с заголовком
// авторизации и возвращает структуру { Успех, Сообщение, КодСостояния }.
// Значение ключа никогда не попадает в результат: маскировка
// ar_Утилиты.МаскироватьСекреты применяется ко всем текстовым полям.
//
// Свойства модуля: Сервер, без привилегированного режима. Доступ к секретам —
// только через ar_Secrets (прямой БезопасноеХранилище запрещён, см. SEC-01).
//
// Ограничения этапа 1:
//  - ar_HTTP пока умеет только POST. Используем POST на /models с пустым телом;
//    провайдер ответит 405/401/200 — для теста соединения этого достаточно.
//    После HTTP-05 заменить на GET. См. TODO ниже.
//  - allow-list URL ещё не реализован (HTTP-02). Полный URL берётся из
//    реквизита ar_BaseURL без дополнительной проверки. См. TODO ниже.
//
// См. спеку: .docs/specs/SEC-04.md, Plan §3.9.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверить соединение с LLM-провайдером.
//
// Делает один HTTP-запрос к endpoint провайдера с заголовком авторизации.
// HTTP 2xx считается успехом (ключ принят), любой 4xx/5xx или сетевая ошибка —
// неудачей. Значение API-ключа не возвращается и маскируется в сообщениях.
//
// Параметры:
//  СсылкаПровайдера - СправочникСсылка.ar_LLMПровайдеры - провайдер для теста.
//
// LLM-12: тест соединения для провайдеров с непустым ТелоЗапроса (например,
// AgentRunner Cloud) выполняет реальный HTTP POST с валидным минимальным
// телом чата - для AgentRunner Cloud это означает реальный платный вызов
// шлюза (согласовано с пользователем, см. .docs/specs/LLM-12.md). Никаких
// предупреждающих текстов о списании средств не добавляется.
//
// Возвращаемое значение:
//  Структура с ключами:
//    * Успех        - Булево - Истина при HTTP 2xx, иначе Ложь.
//    * Сообщение    - Строка - человекочитаемое описание результата (с маскировкой).
//    * КодСостояния - Число  - HTTP-код ответа; 0 при сетевой ошибке / до соединения.
//
Функция ПроверитьСоединение(СсылкаПровайдера) Экспорт

	Результат = НовыйРезультат();

	Если НЕ ЗначениеЗаполнено(СсылкаПровайдера) Тогда
		Результат.Сообщение = НСтр("ru = 'Провайдер не задан'; en = 'Provider is not set'");
		Возврат Результат;
	КонецЕсли;

	Данные = ДанныеПровайдера(СсылкаПровайдера);

	Если ПустаяСтрока(Данные.UUID) Тогда
		Результат.Сообщение = НСтр("ru = 'Ключ не задан'; en = 'Key is not set'");
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(Данные.BaseURL) Тогда
		Результат.Сообщение = НСтр("ru = 'BaseURL не задан'; en = 'BaseURL is not set'");
		Возврат Результат;
	КонецЕсли;

	// HTTP-02: добавить проверку allow-list для BaseURL после реализации HTTP-02.

	Ключ = ar_Secrets.Прочитать(ar_Secrets.КлючПровайдера(Данные.UUID));
	Если Ключ = Неопределено ИЛИ ПустаяСтрока(Ключ) Тогда
		Результат.Сообщение = НСтр("ru = 'Ключ не найден в безопасном хранилище';
			|en = 'Key not found in secure storage'");
		Возврат Результат;
	КонецЕсли;

	ОписаниеТеста = ОписаниеТестовогоЗапроса(Данные.Тип, Данные.BaseURL, Ключ, Данные.DefaultModel);
	Если НЕ ОписаниеТеста.Поддерживается Тогда
		Результат.Сообщение = ОписаниеТеста.Сообщение;
		Возврат Результат;
	КонецЕсли;

	// Очищаем переменную Ключ — далее он живёт только внутри ОписаниеТеста.Заголовки
	// до момента передачи в ar_HTTP. Сами Заголовки в Результат не попадают.
	Ключ = Неопределено;

	// HTTP-05: заменить POST на GET после расширения ar_HTTP полным набором методов.
	// LLM-12: для провайдеров с непустым ОписаниеТеста.ТелоЗапроса (например,
	// AgentRunner Cloud, где протокол требует валидное тело чата - пустое "{}"
	// вызовет 422) используем это тело; для остальных типов провайдера
	// поведение не меняется - fallback на "{}".
	ТелоЗапроса = ?(ЗначениеЗаполнено(ОписаниеТеста.ТелоЗапроса), ОписаниеТеста.ТелоЗапроса, "{}");
	Ответ = ar_HTTP.ВыполнитьPOST(ОписаниеТеста.URL, ОписаниеТеста.Заголовки, ТелоЗапроса, 30);

	Результат.КодСостояния = Ответ.КодСостояния;

	Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Соединение успешно (%1)'; en = 'Connection successful (%1)'"),
			Ответ.КодСостояния);
	ИначеЕсли Ответ.КодСостояния = 405 Тогда
		// POST на GET-only endpoint: провайдер ответил, ключ принят.
		// После HTTP-05 (переход на GET) эта ветка станет недостижима.
		Результат.Успех = Истина;
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Соединение успешно (%1, метод не поддерживается, но провайдер ответил)';
				|en = 'Connection successful (%1, method not allowed, provider responded)'"),
			Ответ.КодСостояния);
	ИначеЕсли Ответ.КодСостояния = 401 ИЛИ Ответ.КодСостояния = 403 Тогда
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Ошибка авторизации (%1): неверный или отозванный API-ключ';
				|en = 'Authorization error (%1): invalid or revoked API key'"),
			Ответ.КодСостояния);
	ИначеЕсли Ответ.КодСостояния = 0 Тогда
		Если ЗначениеЗаполнено(Ответ.Ошибка) Тогда
			Результат.Сообщение = СтрШаблон(
				НСтр("ru = 'Нет ответа от провайдера: %1'; en = 'No response from provider: %1'"),
				Ответ.Ошибка);
		Иначе
			Результат.Сообщение = НСтр("ru = 'Нет ответа от провайдера (таймаут)';
				|en = 'No response from provider (timeout)'");
		КонецЕсли;
	Иначе
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'Провайдер ответил с кодом %1'; en = 'Provider responded with code %1'"),
			Ответ.КодСостояния);
	КонецЕсли;

	// Финальная страховка: даже если в сообщение чудом попал секрет — замаскируем.
	Результат.Сообщение = ar_Утилиты.МаскироватьСекреты(Результат.Сообщение);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт пустой результат теста.
Функция НовыйРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("КодСостояния", 0);
	Возврат Результат;
КонецФункции

// Получает данные провайдера одним запросом (UUID, BaseURL, Тип, DefaultModel).
//
// Параметры:
//  СсылкаПровайдера - СправочникСсылка.ar_LLMПровайдеры
//
// Возвращаемое значение:
//  Структура { UUID, BaseURL, Тип, DefaultModel }.
//
Функция ДанныеПровайдера(СсылкаПровайдера)

	Данные = Новый Структура;
	Данные.Вставить("UUID", "");
	Данные.Вставить("BaseURL", "");
	Данные.Вставить("Тип", Неопределено);
	Данные.Вставить("DefaultModel", "");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Провайдер.ar_APIKeyИдентификатор КАК UUID,
		|	Провайдер.ar_BaseURL КАК BaseURL,
		|	Провайдер.ar_Тип КАК Тип,
		|	Провайдер.ar_DefaultModel КАК DefaultModel
		|ИЗ
		|	Справочник.ar_LLMПровайдеры КАК Провайдер
		|ГДЕ
		|	Провайдер.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаПровайдера);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Данные.UUID         = СокрЛП(Строка(Выборка.UUID));
		Данные.BaseURL       = СокрЛП(Строка(Выборка.BaseURL));
		Данные.Тип           = Выборка.Тип;
		Данные.DefaultModel  = СокрЛП(Строка(Выборка.DefaultModel));
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Формирует описание тестового HTTP-запроса в зависимости от типа провайдера.
//
// Параметры:
//  Тип           - EnumRef.ar_ТипПровайдера
//  BaseURL       - Строка - базовый URL провайдера (без завершающего "/").
//  Ключ          - Строка - значение API-ключа.
//  DefaultModel  - Строка - модель по умолчанию провайдера (для типов,
//                  которым для тестового запроса нужно валидное тело чата
//                  с указанием модели, например AgentRunnerCloud). Необязательный.
//
// Возвращаемое значение:
//  Структура {
//    Поддерживается - Булево,
//    Сообщение      - Строка,
//    URL            - Строка,
//    Заголовки      - Соответствие,
//    ТелоЗапроса    - Строка - JSON тела запроса; пустая строка "" означает
//                     "использовать дефолтное тело {}" (поведение,
//                     сохранённое для типов, не требующих валидного тела чата).
//  }.
//
Функция ОписаниеТестовогоЗапроса(Тип, BaseURL, Ключ, DefaultModel = "")

	Описание = Новый Структура;
	Описание.Вставить("Поддерживается", Ложь);
	Описание.Вставить("Сообщение", "");
	Описание.Вставить("URL", "");
	Описание.Вставить("Заголовки", Новый Соответствие);
	Описание.Вставить("ТелоЗапроса", "");

	БазаБезСлеша = ?(Прав(BaseURL, 1) = "/", Лев(BaseURL, СтрДлина(BaseURL) - 1), BaseURL);

	Если Тип = Перечисления.ar_ТипПровайдера.OpenAI
		ИЛИ Тип = Перечисления.ar_ТипПровайдера.LocalCompatible Тогда

		Описание.URL = БазаБезСлеша + "/models";
		Описание.Заголовки.Вставить("Authorization", "Bearer " + Ключ);
		Описание.Заголовки.Вставить("Content-Type",  "application/json");
		Описание.Поддерживается = Истина;

	ИначеЕсли Тип = Перечисления.ar_ТипПровайдера.Anthropic Тогда

		Описание.URL = БазаБезСлеша + "/v1/models";
		Описание.Заголовки.Вставить("x-api-key",         Ключ);
		Описание.Заголовки.Вставить("anthropic-version", "2023-06-01");
		Описание.Заголовки.Вставить("Content-Type",      "application/json");
		Описание.Поддерживается = Истина;

	ИначеЕсли Тип = Перечисления.ar_ТипПровайдера.YandexGPT Тогда

		Описание.URL = БазаБезСлеша + "/v1/fm/foundationModels";
		Описание.Заголовки.Вставить("Authorization", "Bearer " + Ключ);
		Описание.Заголовки.Вставить("Content-Type",  "application/json");
		Описание.Поддерживается = Истина;

	ИначеЕсли Тип = Перечисления.ar_ТипПровайдера.GigaChat Тогда

		// GigaChat использует OAuth2: API-ключ нельзя напрямую слать как Bearer,
		// нужен предварительный обмен на access_token. Реализация — задача LLM-05.
		Описание.Сообщение = НСтр("ru = 'Тест GigaChat требует OAuth2 — будет реализован в LLM-05';
			|en = 'GigaChat test requires OAuth2 — will be implemented in LLM-05'");

	ИначеЕсли Тип = Перечисления.ar_ТипПровайдера.AgentRunnerCloud Тогда

		// LLM-12: протокол шлюза требует непустое валидное тело (provider,
		// model, messages обязательны по схеме) - пустое "{}" вызовет 422.
		// Тест соединения для этого типа провайдера выполняет реальный
		// платный вызов /api/proxy (согласовано с пользователем) - не заглушку.
		Модель = ?(ЗначениеЗаполнено(DefaultModel), DefaultModel, "Qwen3.6-35B-A3B");

		Описание.URL = БазаБезСлеша + "/api/proxy";
		Описание.Заголовки.Вставить("Authorization", "Bearer " + Ключ);
		Описание.Заголовки.Вставить("Content-Type",  "application/json");
		Описание.ТелоЗапроса = ar_LLMAgentRunnerCloud.ТелоМинимальногоЗапроса(Модель, "ping", 16);
		Описание.Поддерживается = Истина;

	Иначе

		Описание.Сообщение = НСтр("ru = 'Неизвестный тип провайдера';
			|en = 'Unknown provider type'");

	КонецЕсли;

	Возврат Описание;

КонецФункции

#КонецОбласти
