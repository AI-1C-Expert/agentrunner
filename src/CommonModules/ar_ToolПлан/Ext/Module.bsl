////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolПлан (Tool - план запуска).
//
// Реализует tool:
//   update_plan — объявить/обновить план работы по многоэтапной задаче (PLAN-03).
//
// S4 (шапка Tasks_plan.md): wait_for_event (PLAN-11) добавит вторую функцию в
// этот же модуль - отдельный модуль заводить не нужно (по образцу
// ar_ToolРеестрПоиск: find_tools + describe_tool в одном модуле).
//
// Контракт tool-функции:
//   Вход:  Аргументы (Строка) — JSON-объект аргументов от LLM.
//          Контекст (Структура) — КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//          БЕЗ Состояние (Plan-ревью R1, ar_RuntimeЦикл.КонтекстЗапуска) - tool
//          физически не может прочитать/записать текущий план запуска.
//   Выход: Строка JSON — observation для добавления в контекст как role:tool.
//          Никогда не пустая; при ошибке — {"error":"<код>"}.
//
// Роль update_plan в этой задаче узкая: провалидировать и нормализовать
// присланные LLM пункты через ar_ПланЗапуска (без доступа к предыдущему плану -
// merge-семантика здесь не применяется буквально, вызывается
// Применить(НовыйПлан(), ПунктыИзLLM)). Настоящее слияние с историей и запись
// в ar_Запуски (событие PlanUpdated) делает цикл ar_RuntimeЦикл (PLAN-04) - вне
// скоупа этой задачи.
//
// update_plan read-only с точки зрения ИБ: не пишет в Состояние, не читает и
// не пишет РегистрСведений.ar_Запуски, HTTP не делает. Привилегированный режим
// используется ТОЛЬКО в ЗарегистрироватьTools (запись в служебный реестр
// ar_Tools) — сама выдача не требует повышенных прав (Plan §3.3).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/PLAN-03.md, .docs/specs/PLAN-02.md, .docs/specs/PLAN-01.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня модуля ar_ToolПлан. Маршрутизирует вызов по имени
// процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolПлан.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры ("ОбновитьПлан").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ОбновитьПлан" Тогда
		Возврат ОбновитьПлан(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Идемпотентно создаёт/обновляет запись реестра ar_Tools для tool update_plan
// (PLAN-03). Вызывается из ar_ToolDispatcher.ЗарегистрироватьВсеTools() и из
// обработчика обновления расширения. Привилегированный режим включается
// локально только для записи в служебный реестр ядра, с парным сбросом в
// блоке Исключение (Plan §1.3).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } — статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинИнструмент(ОписаниеToolUpdatePlan(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

// Tool update_plan: провалидировать и нормализовать пункты плана,
// присланные LLM, вернуть короткий observation с планом и прогрессом.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM. Поля:
//    steps (обяз.) - массив объектов {title: string, status: string}.
//                    status - одно из pending|in_progress|done|skipped, вне
//                    словаря/отсутствует - нормализуется в pending силами
//                    ar_ПланЗапуска.
//    note  (опц.)  - строка, комментарий агента. Не участвует в контракте
//                    ar_ПланЗапуска, маскируется и возвращается как есть.
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}. DryRun
//              не даёт отдельной ветки: update_plan не мутирует ИБ и не
//              создаёт approval-запись, поведение то же, что и без DryRun.
//
// Возвращаемое значение:
//  Строка - JSON {"plan":[{"title":"...","status":"..."}],"progress":"N/M"
//           [,"truncated":true][,"note":"..."]} либо {"error":"<код>"}.
//
Функция ОбновитьПлан(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Возврат ОбновитьПланВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// update_plan: валидация и нормализация без истории.

// Основная логика tool update_plan. Выделена из ОбновитьПлан, чтобы внешний
// Попытка/Исключение ловил любые непредвиденные ошибки.
//
// Алгоритм (см. .docs/specs/PLAN-03.md, раздел «Поведение»):
//  1. Разбор АргументыJSON через ar_JSON.ИзJSON - при ошибке парсинга получаем
//     пустое Соответствие, не исключение.
//  2. Извлечение steps - если это не Массив или отсутствует, invalid_steps
//     (единственный обязательный параметр).
//  3. Извлечение note (опционально), маскировка секретов.
//  4. Передача steps в ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(),
//     steps) - НЕ ar_ПланЗапуска.Применить(ПредыдущийПлан, ...) буквально:
//     предыдущего плана внутри tool нет (R1 - Состояние недоступно). Так
//     нормализуются и усекаются присланные пункты по тем же правилам
//     (лимиты 12/150, фильтрация мусора), но БЕЗ merge с историей.
//  5. Формирование короткого observation: plan (Результат.Пункты),
//     progress ("<Закрыто>/<Всего>" через ar_ПланЗапуска.Прогресс),
//     truncated:true при Результат.Усечено.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы tool (см. ОбновитьПлан).
//  Контекст  - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. ОбновитьПлан).
//
Функция ОбновитьПланВнутр(Знач Аргументы, Знач Контекст)

	ДанныеJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_steps");
	КонецЕсли;

	СырыеШаги = ДанныеJSON.Получить("steps");
	Если ТипЗнч(СырыеШаги) <> Тип("Массив") Тогда
		Возврат ОшибочныйJSON("invalid_steps");
	КонецЕсли;

	СтрокаNote = СтрокаNoteИзАргументов(ДанныеJSON);

	// ar_JSON.ИзJSON разбирает JSON-объекты как Соответствие, а не Структура
	// (докстринг ar_JSON.ИзJSON, платформенный ПрочитатьJSON с
	// ПрочитатьВСоответствие=Истина). ar_ПланЗапуска.НормализоватьПунктLLM
	// требует строго Тип("Структура") для каждого элемента - без конвертации
	// любой корректный вход отбрасывается как мусор (ревью 1, замечание 1).
	ШагиДляПланировщика = ПривестиШагиКСтруктурам(СырыеШаги);

	// DryRun (Контекст.DryRun = Истина) сознательно НЕ даёт отдельной ветки с
	// фиктивным ответом, в отличие от ask_user: update_plan не мутирует ИБ и
	// не создаёт approval-запись, поэтому поведение одинаковое с обычным
	// вызовом (см. спеку PLAN-03, «Поведение», шаг 6).

	// Предыдущего плана внутри tool нет (R1) - НовыйПлан() как база слияния,
	// это нормализация/усечение входа LLM, а не честный merge с историей.
	Результат = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), ШагиДляПланировщика);
	Прогресс   = ar_ПланЗапуска.Прогресс(Результат);

	ОтветПлан = Новый Массив;
	Для Каждого Пункт Из Результат.Пункты Цикл
		ЭлементПлана = Новый Структура;
		ЭлементПлана.Вставить("title", Пункт.Заголовок);
		ЭлементПлана.Вставить("status", Пункт.Статус);
		ОтветПлан.Добавить(ЭлементПлана);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("plan", ОтветПлан);
	Ответ.Вставить("progress", Строка(Прогресс.Закрыто) + "/" + Строка(Прогресс.Всего));

	Если Результат.Усечено Тогда
		Ответ.Вставить("truncated", Истина);
	КонецЕсли;

	Если СтрокаNote <> Неопределено Тогда
		Ответ.Вставить("note", СтрокаNote);
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Конвертирует массив сырых элементов steps (каждый - Соответствие, как их
// разбирает ar_JSON.ИзJSON) в массив Структур с полями title/status, как их
// ожидает ar_ПланЗапуска.НормализоватьПунктLLM (строгая проверка
// ТипЗнч(...) = Тип("Структура")). Элемент, который сам не является
// Соответствие (мусор внутри массива steps), передаётся дальше как есть -
// ar_ПланЗапуска отбросит его самостоятельно как невалидный тип.
//
// Экспортная (PLAN-04, уточнение U7): переиспользуется из ar_RuntimeЦикл
// (ОбработатьРезультатUpdatePlan) - та же граница типов Соответствие/Структура
// возникает при разборе observation update_plan цикла, что и здесь при разборе
// аргументов steps. Единственная точка конвертации, дублирование в третьем
// месте не допускается.
//
// Параметры:
//  СырыеШаги - Массив - элементы steps после ar_JSON.ИзJSON (обычно
//              Соответствие с ключами title/status, но тип элементов не
//              гарантирован - вход от LLM).
//
// Возвращаемое значение:
//  Массив - элементы Структура("title, status", ...) там, где конвертация
//  возможна, либо исходный элемент без изменений (для дальнейшей отбраковки
//  ar_ПланЗапуска как мусора).
//
Функция ПривестиШагиКСтруктурам(Знач СырыеШаги) Экспорт

	Результат = Новый Массив;

	// Защитная проверка типа входа (PLAN-04): функция стала экспортной и
	// вызывается из второго места (ar_RuntimeЦикл) - вызывающая сторона там
	// уже проверяет ТипЗнч(...) = Тип("Массив") перед вызовом, но повторная
	// проверка здесь не даёт функции упасть, если контракт нарушит будущий
	// вызывающий код.
	Если ТипЗнч(СырыеШаги) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СыройЭлемент Из СырыеШаги Цикл
		// Соответствие.Получить(<Ключ>) безопасен на отсутствующем ключе -
		// работает как оператор [], возвращает Неопределено, исключения не
		// бросает (в отличие от обращения к отсутствующему реквизиту
		// Структуры через точку) - см. платформенную документацию метода.
		// Обёртка Попытка здесь избыточна.
		Если ТипЗнч(СыройЭлемент) = Тип("Соответствие") Тогда
			ЗначениеЗаголовка = СыройЭлемент.Получить("title");
			ЗначениеСтатуса   = СыройЭлемент.Получить("status");
			Структурированный = Новый Структура("title, status", ЗначениеЗаголовка, ЗначениеСтатуса);
			Результат.Добавить(Структурированный);
		Иначе
			// Не Соответствие (например Строка, Число, Массив, Неопределено) -
			// заведомый мусор, ar_ПланЗапуска.НормализоватьПунктLLM отбросит
			// его сам по проверке ТипЗнч(...) <> Тип("Структура").
			Результат.Добавить(СыройЭлемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлекает опциональное поле note из разобранных аргументов и маскирует в
// нём секреты (по аналогии с question/hint у ask_user). Отсутствующее или
// не строковое значение - Неопределено (поле не попадёт в observation).
//
// Параметры:
//  ДанныеJSON - Соответствие - разобранные аргументы tool (ar_JSON.ИзJSON).
//
// Возвращаемое значение:
//  Строка, Неопределено - замаскированный текст note либо Неопределено.
//
Функция СтрокаNoteИзАргументов(Знач ДанныеJSON)

	ЗначениеNote = ДанныеJSON.Получить("note");
	Если ТипЗнч(ЗначениеNote) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Note = СокрЛП(ЗначениеNote);
	Если ПустаяСтрока(Note) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ar_Утилиты.МаскироватьСекреты(Note);

КонецФункции

// JSON-строка ошибки-observation: {"error":"<текст>"}.
//
// Параметры:
//  ТекстОшибки - Строка - код/текст ошибки.
//
// Возвращаемое значение:
//  Строка - JSON {"error":"<текст>"}.
//
Функция ОшибочныйJSON(Знач ТекстОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""tool_error""}", Результат);
КонецФункции

// Описание tool update_plan для регистрации в ar_Tools.
//
// Возвращаемое значение:
//  Структура - поля Имя, Описание, КраткоеОписание, ОбщийМодуль, ИмяПроцедуры,
//  RiskLevel, ТребуетApproval, Включён, Версия, JSONManifest.
//
Функция ОписаниеToolUpdatePlan()

	// OpenAI tool-format (parameters, не Anthropic input_schema) - единый
	// контракт для всех LLM-провайдеров (образец: ar_ToolРеестрПоиск.ОписаниеToolFindTools).
	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""update_plan"",
	|    ""description"": ""Объявить или обновить план работы по многоэтапной задаче. Вызывай на задачах из нескольких шагов, чтобы оператор видел прогресс. План - твоё намерение: переписывай его, если обстоятельства изменились."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""steps""],
	|      ""properties"": {
	|        ""steps"": {
	|          ""type"": ""array"",
	|          ""items"": {
	|            ""type"": ""object"",
	|            ""properties"": {
	|              ""title"": { ""type"": ""string"", ""description"": ""Краткий заголовок шага плана, до 150 символов."" },
	|              ""status"": { ""type"": ""string"", ""enum"": [""pending"", ""in_progress"", ""done"", ""skipped""], ""description"": ""Статус шага. Неизвестное или отсутствующее значение трактуется как pending."" }
	|            },
	|            ""required"": [""title""]
	|          },
	|          ""description"": ""Список шагов плана, до 12 элементов. Присылай полный актуальный список при каждом вызове.""
	|        },
	|        ""note"": {
	|          ""type"": ""string"",
	|          ""description"": ""Опциональный короткий комментарий о текущем состоянии работы.""
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя",              "update_plan");
	Описание.Вставить("Описание",
		НСтр("ru = 'Объявить или обновить план работы по многоэтапной задаче. Вызывай на задачах из нескольких шагов, чтобы оператор видел прогресс. План — твоё намерение: переписывай его, если обстоятельства изменились.';
		|en = 'Announce or update the work plan for a multi-step task. Call it on tasks with several steps so the operator can see progress. The plan is your intent: rewrite it if circumstances change.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Объявить или обновить план работы';
		|en = 'Announce or update the work plan'"));
	Описание.Вставить("ОбщийМодуль",      "ar_ToolПлан");
	Описание.Вставить("ИмяПроцедуры",     "ОбновитьПлан");
	Описание.Вставить("RiskLevel",        "Read");
	Описание.Вставить("ТребуетApproval",  Ложь);
	Описание.Вставить("Включён",          Истина);
	Описание.Вставить("Версия",           "1.0.0");
	Описание.Вставить("JSONManifest",     МанифестJSON);
	Возврат Описание;

КонецФункции

// Создать или обновить одну запись в ar_Tools по описанию.
// Ищет по ar_Имя среди непомеченных. При нахождении — обновляет, иначе создаёт.
// ar_Категория здесь сознательно НЕ заполняется - постпроход
// ar_ToolDispatcher.ЗаполнитьПредставленияВсехTools() делает это после
// регистрации всех модулей (спека PLAN-03, «Сущности и метаданные»).
//
// Параметры:
//  Описание   - Структура - см. ОписаниеToolUpdatePlan.
//  Статистика - Структура - {Создано, Обновлено} - модифицируется по ссылке.
//
Процедура ЗарегистрироватьОдинИнструмент(Знач Описание, Статистика)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", Описание.Имя);

	Выборка = Запрос.Выполнить().Выбрать();

	НачатьТранзакцию();
	Попытка
		Если Выборка.Следующий() Тогда
			ОбъектИнструмент = Выборка.Ссылка.ПолучитьОбъект();
			Статистика.Обновлено = Статистика.Обновлено + 1;
		Иначе
			ОбъектИнструмент = Справочники.ar_Tools.СоздатьЭлемент();
			Статистика.Создано = Статистика.Создано + 1;
		КонецЕсли;

		ОбъектИнструмент.Наименование        = Описание.Имя;
		ОбъектИнструмент.ar_Имя              = Описание.Имя;
		ОбъектИнструмент.ar_Описание         = Описание.Описание;
		ОбъектИнструмент.ar_КраткоеОписание  = Описание.КраткоеОписание;
		ОбъектИнструмент.ar_ОбщийМодуль      = Описание.ОбщийМодуль;
		ОбъектИнструмент.ar_ИмяПроцедуры     = Описание.ИмяПроцедуры;
		ОбъектИнструмент.ar_ТребуетApproval  = Описание.ТребуетApproval;
		ОбъектИнструмент.ar_Включён          = Описание.Включён;
		ОбъектИнструмент.ar_Версия           = Описание.Версия;
		ОбъектИнструмент.ar_JSONManifest     = Описание.JSONManifest;

		// Установка RiskLevel через перечисление (образец: ar_ToolРеестрПоиск.ПолучитьУровеньРиска).
		ОбъектИнструмент.ar_RiskLevel = ПолучитьУровеньРиска(Описание.RiskLevel);

		// Справочник записывается без параметров.
		ОбъектИнструмент.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Получить ссылку перечисления ar_RiskLevel по строковому имени.
// При неизвестном имени возвращает Read (безопасный дефолт).
//
// Параметры:
//  ИмяЗначения - Строка - имя значения перечисления ar_RiskLevel.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ar_RiskLevel - найденное значение либо Read по умолчанию.
//
Функция ПолучитьУровеньРиска(Знач ИмяЗначения)
	Если ТипЗнч(ИмяЗначения) <> Тип("Строка") Тогда
		Возврат Перечисления.ar_RiskLevel.Read;
	КонецЕсли;
	Для Каждого ЗначМД Из Метаданные.Перечисления.ar_RiskLevel.ЗначенияПеречисления Цикл
		Если ЗначМД.Имя = ИмяЗначения Тогда
			Возврат Перечисления.ar_RiskLevel[ЗначМД.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Перечисления.ar_RiskLevel.Read;
КонецФункции

#КонецОбласти
