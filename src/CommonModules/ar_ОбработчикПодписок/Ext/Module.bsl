// Общий модуль ar_ОбработчикПодписок (AOS Обработчик подписок на события).
//
// Реализует event-driven триггеры для агентов при записи объектов базы данных.
// Уровень 1 (горячие типы) по Plan §2.10: единая широкая подписка на ПриЗаписи
// всех объектов, с фильтрацией по списку горячих типов внутри обработчика.
//
// Список горячих типов (ГорячиеТипы) задается внутренней константой модуля.
// Активные подписки читаются из справочника ar_ПодпискиАгентов (META-35).
// Запуск агентов через ar_RuntimeЗапуск.СтартоватьВФоне (RT-02).
//
// Экспортные функции ГорячиеТипы, ПроверитьФильтр, СформироватьКонтекстТриггера
// используются также в EXT-08 (регламентный опрос подписок).
//
// Свойства модуля: Серверный, НеГлобальный, Привилегированный = Ложь.
// Нет Выполнить()/Вычислить(). Нет УстановитьПривилегированныйРежим().
//
// EXT-07 / EXT-08 / Plan §2.10, §5.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие ПриЗаписи «горячих» объектов.
// Сигнатура задана платформой.
//
// Параметры:
//   Источник - ОбъектДанных - объект, который был записан.
//   Отказ    - Булево       - признак отказа (не устанавливается).
//
Процедура ПриЗаписиОбъекта(Источник, Отказ) Экспорт

	// ВРЕМЕННО (диагностика event-подписки PAY-01): факт вызова обработчика.
	Попытка
		ar_СлужебныйЛог.Записать(
			"ar_ОбработчикПодписок.ПриЗаписиОбъекта",
			"debug_handler_called",
			СтрШаблон("Объект=%1; Загрузка=%2", Источник.Метаданные().ПолноеИмя(), Источник.ОбменДанными.Загрузка),
			"Информация");
	Исключение
		// Диагностика не должна ломать запись объекта.
	КонецПопытки;

	// UC-3: при загрузке из обмена данными не запускаем агентов.
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяОбъекта = Источник.Метаданные().ПолноеИмя();

	// Проверка принадлежности к «горячим» типам.
	Если ГорячиеТипы().Найти(ПолноеИмяОбъекта) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Читаем активные подписки для данного типа объекта.
	АктивныеПодписки = НайтиАктивныеПодписки(ПолноеИмяОбъекта);

	// ВРЕМЕННО (диагностика event-подписки PAY-01): сколько подписок нашли.
	Попытка
		ar_СлужебныйЛог.Записать(
			"ar_ОбработчикПодписок.ПриЗаписиОбъекта",
			"debug_subscriptions_found",
			СтрШаблон("Тип=%1; Найдено=%2", ПолноеИмяОбъекта, АктивныеПодписки.Количество()),
			"Информация");
	Исключение
	КонецПопытки;

	Если АктивныеПодписки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МетаданныеОбъекта = Источник.Метаданные();
	СсылкаОбъекта     = Источник.Ссылка;

	// Для каждой подписки: проверяем фильтр и запускаем агента.
	Для Каждого Подписка Из АктивныеПодписки Цикл

		Если НЕ ПроверитьФильтр(Подписка, Источник) Тогда
			Продолжить;
		КонецЕсли;

		КонтекстТриггера = СформироватьКонтекстТриггера(Источник, Подписка, ПолноеИмяОбъекта);

		Попытка
			Результат = ar_RuntimeЗапуск.СтартоватьВФоне(Подписка.ar_Агент, КонтекстТриггера);

			// ВРЕМЕННО (диагностика event-подписки PAY-01): результат запуска.
			Попытка
				ar_СлужебныйЛог.Записать(
					"ar_ОбработчикПодписок.ПриЗаписиОбъекта",
					"debug_start_result",
					СтрШаблон("Агент=%1; Успех=%2; Причина=%3", Подписка.ar_Агент, Результат.Успех, Результат.Причина),
					"Информация");
			Исключение
			КонецПопытки;

			Если НЕ Результат.Успех Тогда
				ШаблонСообщения = НСтр("ru = 'Агент: %1, причина: %2';
					|en = 'Agent: %1, reason: %2'");
				СообщениеОНеудаче = СтрШаблон(ШаблонСообщения, Подписка.ar_Агент, Результат.Причина);
				СобытиеЖурнала = НСтр("ru = 'AgentRunner.Подписки: не удалось запустить агента';
					|en = 'AgentRunner.Subscriptions: failed to start agent'");
				ЗаписьЖурналаРегистрации(
					СобытиеЖурнала,
					УровеньЖурналаРегистрации.Предупреждение,
					МетаданныеОбъекта,
					СсылкаОбъекта,
					СообщениеОНеудаче);
			КонецЕсли;
		Исключение
			// D8: ошибка запуска агента НЕ устанавливает Отказ.
			ОписаниеОш = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			СобытиеЖурнала = НСтр("ru = 'AgentRunner.Подписки: исключение при запуске агента';
				|en = 'AgentRunner.Subscriptions: exception starting agent'");
			КомментарийЖурнала = НСтр("ru = 'Агент: %1, Ошибка: %2';
				|en = 'Agent: %1, Error: %2'");
			КомментарийЖурнала = СтрШаблон(КомментарийЖурнала, Подписка.ar_Агент, ОписаниеОш);
			ЗаписьЖурналаРегистрации(
				СобытиеЖурнала,
				УровеньЖурналаРегистрации.Ошибка,
				МетаданныеОбъекта,
				СсылкаОбъекта,
				КомментарийЖурнала);

			// ВРЕМЕННО (диагностика event-подписки PAY-01): полный текст исключения.
			Попытка
				ar_СлужебныйЛог.Записать(
					"ar_ОбработчикПодписок.ПриЗаписиОбъекта",
					"debug_start_exception",
					ОписаниеОш,
					"Ошибка");
			Исключение
			КонецПопытки;
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Возвращает массив полных имён «горячих» типов объектов.
// Может быть расширен без изменения архитектуры подписки.
// Используется EXT-08 (опрос подписок) для исключения горячих типов из polling.
//
// Возвращаемое значение:
//   Массив из Строка - полные имена типов метаданных
//                      (например, "Справочник.Контрагенты").
//
Функция ГорячиеТипы() Экспорт

	Типы = Новый Массив;
	Типы.Добавить("Справочник.Контрагенты");
	Типы.Добавить("Документ.СчетНаОплатуПокупателю");
	Типы.Добавить("Документ.ЗаказПокупателя");
	Возврат Типы;

КонецФункции

// Проверить JSON-фильтр подписки против реальных реквизитов записанного объекта.
// При пустом фильтре или ошибке парсинга считать совпадением (пропускать все).
// Используется EXT-07 (горячие типы) и EXT-08 (опрос подписок).
//
// Параметры:
//   Подписка - СтрокаТаблицыЗначений - строка из НайтиАктивныеПодписки.
//   Источник - ОбъектДанных          - записанный объект.
//
// Возвращаемое значение:
//   Булево - Истина, если фильтр совпадает (или фильтр пуст/невалиден).
//
Функция ПроверитьФильтр(Подписка, Источник) Экспорт

	ФильтрСтрока = Подписка.ar_ФильтрJSON;

	Если НЕ ЗначениеЗаполнено(ФильтрСтрока) Тогда
		Возврат Истина; // пустой фильтр = пропускать все
	КонецЕсли;

	// D7: ошибка парсинга - считать фильтр пустым, логировать предупреждение.
	Попытка
		ФильтрСоответствие = ar_JSON.ИзJSON(ФильтрСтрока);
	Исключение
		ОписаниеОш      = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СобытиеЖурнала  = НСтр("ru = 'AgentRunner.Подписки: невалидный JSON-фильтр подписки';
			|en = 'AgentRunner.Subscriptions: invalid JSON filter in subscription'");
		ЗаписьЖурналаРегистрации(
			СобытиеЖурнала,
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Подписка.Ссылка,
			ОписаниеОш);
		Возврат Истина; // при ошибке парсинга фильтр не применяется
	КонецПопытки;

	Если ФильтрСоответствие = Неопределено ИЛИ ТипЗнч(ФильтрСоответствие) <> Тип("Соответствие") Тогда
		Возврат Истина; // не соответствие, фильтр не применяется
	КонецЕсли;

	// Сопоставление каждого ключа фильтра с реквизитом объекта.
	// Условие: ВСЕ ключи фильтра должны совпасть (логическое И).
	// Значения сравниваются как строки для безопасности с разнотипными значениями.
	Для Каждого ЭлементФильтра Из ФильтрСоответствие Цикл
		ИмяРеквизита    = ЭлементФильтра.Ключ;
		ЗначениеФильтра = Строка(ЭлементФильтра.Значение);

		Попытка
			ФактическоеЗначение = Строка(Источник[ИмяРеквизита]);
		Исключение
			// Реквизит с таким именем не существует, фильтр не совпадает.
			Возврат Ложь;
		КонецПопытки;

		Если ФактическоеЗначение <> ЗначениеФильтра Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Сформировать структуру КонтекстТриггера для передачи в ar_RuntimeЗапуск.
// Используется EXT-07 (горячие типы) и EXT-08 (опрос подписок).
//
// Параметры:
//   Источник          - ОбъектДанных          - записанный объект.
//   Подписка          - СтрокаТаблицыЗначений - строка из НайтиАктивныеПодписки.
//   ПолноеИмяОбъекта  - Строка                - полное имя типа метаданных.
//
// Возвращаемое значение:
//   Структура - контекст триггера для ar_RuntimeЗапуск.СтартоватьВФоне:
//     * Триггер     - Строка                                  - "event".
//     * ЯкорьСсылка - ЛюбаяСсылка                            - ссылка на записанный объект.
//     * СобытиеТип  - Строка                                  - полное имя типа + ".ПриЗаписи".
//     * ЭтоНовый    - Булево                                  - признак нового объекта.
//     * ПодпискаРеф - СправочникСсылка.ar_ПодпискиАгентов   - ссылка на подписку.
//
Функция СформироватьКонтекстТриггера(Источник, Подписка, ПолноеИмяОбъекта) Экспорт

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер",     "event");
	КонтекстТриггера.Вставить("ЯкорьСсылка", Источник.Ссылка);
	КонтекстТриггера.Вставить("СобытиеТип",  ПолноеИмяОбъекта + ".ПриЗаписи");
	КонтекстТриггера.Вставить("ЭтоНовый",    Источник.ЭтоНовый());
	КонтекстТриггера.Вставить("ПодпискаРеф", Подписка.Ссылка);
	Возврат КонтекстТриггера;

КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Найти активные подписки в справочнике ar_ПодпискиАгентов
// для данного типа объекта (по полному имени в событии).
//
// Параметры:
//   ПолноеИмяОбъекта - Строка - полное имя объекта метаданных
//                               (например, "Справочник.Контрагенты").
//
// Возвращаемое значение:
//   ТаблицаЗначений - с колонками: ar_Агент, ar_ФильтрJSON, Ссылка.
//
Функция НайтиАктивныеПодписки(ПолноеИмяОбъекта)

	СобытиеТип = ПолноеИмяОбъекта + ".ПриЗаписи";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Ссылка КАК Ссылка,
		|	П.ar_Агент КАК ar_Агент,
		|	П.ar_ФильтрJSON КАК ar_ФильтрJSON
		|ИЗ
		|	Справочник.ar_ПодпискиАгентов КАК П
		|ГДЕ
		|	П.ar_Событие1С = &СобытиеТип
		|	И П.ar_Включён = ИСТИНА
		|	И П.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("СобытиеТип", СобытиеТип);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
