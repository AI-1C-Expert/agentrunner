////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_PermissionЛимиты (PermissionЛимиты / Проверка лимитов).
//
// Уровень L3 permission engine: проверка количественных лимитов агента
// в рамках одного запуска:
//   Q0 — максимум действий за запуск (МаксДействий);
//   Q1 — максимальная сумма одного действия (МаксСуммаДействия).
//
// Вызывается из ar_PermissionEngine.ВыполнитьПроверки после L0-L2.
//
// Контракт возвращаемого значения совпадает с ar_PermissionEngine.Allow/Deny:
//   Структура {Решение: "allow"|"deny", Причина: Строка,
//              RiskLevel: Неопределено, СсылкаTool: Неопределено}.
// Поля RiskLevel и СсылкаTool всегда Неопределено — заполняются на L4.
//
// Свойства модуля: Сервер, НеГлобальный, без привилегированного режима
// (проверки лимитов выполняются в правах пользователя сессии).
//
// См. спеку: .docs/specs/PERM-03.md, Plan §2.8.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверить количественные лимиты агента для данного действия.
//
// Шаги:
//   Q0: Sequence >= МаксДействий (при МаксДействий > 0) → deny "max_actions_exceeded";
//   Q1: числовая сумма в аргументах > МаксСуммаДействия (при > 0)
//       → deny "action_sum_exceeds_limit";
//   иначе → allow.
//
// Параметры:
//   ДанныеАгента    - Структура - {МаксДействий, МаксСуммаДействия, ...}.
//   ДанныеTool      - Структура - {Включен, ОбщийМодуль, ИмяПроцедуры,
//                                  RiskLevel, ТребуетApproval}.
//   КонтекстЗапуска - Структура - {RunId, Sequence, DryRun, ...}.
//   Действие        - Структура - {Имя, ИдВызова, Аргументы} от ar_RuntimeПарсер.
//                                  Аргументы — JSON-строка аргументов tool.
//
// Возвращаемое значение:
//   Структура - {Решение: "allow"|"deny", Причина: Строка,
//                RiskLevel: Неопределено, СсылкаTool: Неопределено}.
//
Функция Проверить(ДанныеАгента, ДанныеTool, КонтекстЗапуска, Действие) Экспорт

	Попытка
		Возврат ВыполнитьПроверкуЛимитов(ДанныеАгента, ДанныеTool, КонтекстЗапуска, Действие);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Deny("permission_limits_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика: Q0 (лимит действий) и Q1 (лимит суммы действия).
//
Функция ВыполнитьПроверкуЛимитов(ДанныеАгента, ДанныеTool, КонтекстЗапуска, Действие)

	// Q0: лимит количества действий за запуск.
	МаксДействий = 0;
	ДанныеАгента.Свойство("МаксДействий", МаксДействий);
	Если ТипЗнч(МаксДействий) = Тип("Число") И МаксДействий > 0 Тогда
		Sequence = 0;
		КонтекстЗапуска.Свойство("Sequence", Sequence);
		Если ТипЗнч(Sequence) <> Тип("Число") Тогда
			Sequence = 0;
		КонецЕсли;
		Если Sequence >= МаксДействий Тогда
			Возврат Deny(НСтр("ru = 'max_actions_exceeded'; en = 'max_actions_exceeded'"));
		КонецЕсли;
	КонецЕсли;

	// Q1: лимит суммы одного действия.
	МаксСуммаДействия = 0;
	ДанныеАгента.Свойство("МаксСуммаДействия", МаксСуммаДействия);
	Если ТипЗнч(МаксСуммаДействия) = Тип("Число") И МаксСуммаДействия > 0 Тогда
		СуммаДействия = ИзвлечьСуммуИзАргументов(Действие);
		Если СуммаДействия > МаксСуммаДействия Тогда
			Возврат Deny(НСтр("ru = 'action_sum_exceeds_limit'; en = 'action_sum_exceeds_limit'"));
		КонецЕсли;
	КонецЕсли;

	Возврат Allow();

КонецФункции

// Попытаться извлечь числовую сумму из аргументов действия.
// Ищет ключи (в порядке): amount, sum, сумма, value — первый найденный
// со значением-числом > 0. Возвращает 0, если сумма не найдена,
// не является числом или не положительна (нет ограничиваемой суммы).
//
// Параметры:
//   Действие - Структура - {Имя, ИдВызова, Аргументы}; Аргументы — JSON-строка.
//
// Возвращаемое значение:
//   Число - найденная сумма > 0 либо 0.
//
Функция ИзвлечьСуммуИзАргументов(Действие)

	Если ТипЗнч(Действие) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	АргументыJSON = "";
	Действие.Свойство("Аргументы", АргументыJSON);
	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат 0;
	КонецЕсли;

	Аргументы = ar_JSON.ИзJSON(АргументыJSON);
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		// Неопределено (невалидный JSON) либо не объект (массив/примитив) — суммы нет.
		Возврат 0;
	КонецЕсли;

	КлючиСумм = КлючиДенежныхАргументов();
	Для Каждого Ключ Из КлючиСумм Цикл
		Значение = Аргументы.Получить(Ключ);
		Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Имена ключей в аргументах tool, трактуемые как денежная сумма действия.
//
Функция КлючиДенежныхАргументов()

	Ключи = Новый Массив;
	Ключи.Добавить("amount");
	Ключи.Добавить("sum");
	Ключи.Добавить("сумма");
	Ключи.Добавить("value");
	Возврат Ключи;

КонецФункции

// ---- Helpers возвращаемых структур (дублируют формат ar_PermissionEngine) ----

Функция Allow()
	Результат = Новый Структура;
	Результат.Вставить("Решение",    "allow");
	Результат.Вставить("Причина",    "");
	Результат.Вставить("RiskLevel",  Неопределено);
	Результат.Вставить("СсылкаTool", Неопределено);
	Возврат Результат;
КонецФункции

Функция Deny(Причина)
	Результат = Новый Структура;
	Результат.Вставить("Решение",    "deny");
	Результат.Вставить("Причина",    Причина);
	Результат.Вставить("RiskLevel",  Неопределено);
	Результат.Вставить("СсылкаTool", Неопределено);
	Возврат Результат;
КонецФункции

#КонецОбласти
