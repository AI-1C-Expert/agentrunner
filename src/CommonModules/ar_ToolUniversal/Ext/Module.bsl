// Формирование observation.

// Сформировать observation-заглушку не реализованного tool:
//   {"status":"not_implemented","tool":"<имя>","hint":"Available in TOOL-02/TOOL-03"}.
//
// Параметры:
//  ИмяTool - Строка - имя tool для поля "tool".
//
// Возвращаемое значение:
//  Строка - JSON-observation заглушки.
//
Функция ЗаглушкаНеРеализовано(Знач ИмяTool)
	Объект = Новый Структура;
	Объект.Вставить("status", "not_implemented");
	Объект.Вставить("tool", ИмяTool);
	Объект.Вставить("hint", "Available in TOOL-02/TOOL-03");
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// JSON-строка ошибки-observation: {"error":"<код>"}.
//
// Параметры:
//  КодОшибки - Строка - код ошибки для поля "error".
//
// Возвращаемое значение:
//  Строка - JSON-observation ошибки.
//
Функция ОшибочныйJSON(Знач КодОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// JSON-строка ошибки-observation с подсказкой для самокоррекции LLM:
// {"error":"<код>","hint":"<как исправить вызов>"}.
//
// Параметры:
//  КодОшибки - Строка - код ошибки для поля "error".
//  Подсказка - Строка - текст подсказки для поля "hint".
//
// Возвращаемое значение:
//  Строка - JSON-observation ошибки.
//
Функция ОшибочныйJSONСПодсказкой(Знач КодОшибки, Знач Подсказка)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("hint", Подсказка);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// Формирует observation tool_error из информации об ошибке, очищая текст для LLM.
//
// Параметры:
//  ИнфоОбОшибке - ИнформацияОбОшибке - перехваченное исключение.
//
// Возвращаемое значение:
//  Строка - JSON {"error":"tool_error","detail":"<очищенный текст>"}.
//
Функция ОшибкаTool(Знач ИнфоОбОшибке)
	ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнфоОбОшибке));
	Объект = Новый Структура;
	Объект.Вставить("error", "tool_error");
	Объект.Вставить("detail", ТекстОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

#КонецОбласти
