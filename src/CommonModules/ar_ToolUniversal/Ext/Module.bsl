////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolUniversal (Tool Universal).
//
// Tool-слой универсальных read-only инструментов исследования метаданных и
// данных целевой конфигурации (Plan §2.8 этап 1): search_metadata,
// list_catalogs, list_documents, read_object, query, get_recent_changes,
// search_text, get_object_structure, find_references, get_object_history.
//
// TOOL-02 реализует 6 из 7 функций (search_metadata, list_catalogs,
// list_documents, read_object, get_recent_changes, search_text). TOOL-03
// завершает реализацию УниверсальныйЗапрос (query) - построитель безопасных
// read-only запросов к данным целевой КФ.
//
// Маршрутизация второго уровня выполняется локальной экспортной функцией
// Диспетчер по имени процедуры - без изменений в центральном диспетчере
// (ar_ToolDispatcher) и без Выполнить()/Вычислить().
//
// Контракт tool-функции:
//   Вход:  Аргументы (Строка) - JSON-объект аргументов от LLM (обогащённый
//          системными полями _dry_run / _idempotency_key диспетчером).
//          Контекст (Структура) - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//   Выход: Строка JSON - observation для добавления в контекст как role:tool.
//          Никогда не пустая; при ошибке - {"error":"<код>"}.
//
// Все функции read-only; флаг DryRun игнорируется без ошибки. Привилегированный
// режим не используется - данные читаются в правах пользователя сессии (RLS
// целевой КФ работает естественно, Plan §2.8, §3.1).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/TOOL-02.md, Plan §2.8, §3.4, §3.5, §3.6.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня модуля ar_ToolUniversal. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolUniversal.
//
// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры (например "ПоискМетаданных").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ПоискМетаданных" Тогда
		Возврат ПоискМетаданных(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СписокСправочников" Тогда
		Возврат СписокСправочников(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СписокДокументов" Тогда
		Возврат СписокДокументов(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ЧтениеОбъекта" Тогда
		Возврат ЧтениеОбъекта(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "УниверсальныйЗапрос" Тогда
		Возврат УниверсальныйЗапрос(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПоследниеИзменения" Тогда
		Возврат ПоследниеИзменения(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПоискТекста" Тогда
		Возврат ПоискТекста(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СтруктураТипаОбъекта" Тогда
		Возврат СтруктураТипаОбъекта(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "НайтиСсылки" Тогда
		Возврат НайтиСсылки(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ИсторияВерсийОбъекта" Тогда
		Возврат ИсторияВерсийОбъекта(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "Агрегировать" Тогда
		Возврат Агрегировать(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ФункциональныеОпции" Тогда
		Возврат ФункциональныеОпции(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СписокКонстант" Тогда
		Возврат СписокКонстант(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ТекущийКонтекст" Тогда
		Возврат ТекущийКонтекст(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Tool search_metadata: строковый поиск объектов метаданных по части имени
// или синонима. Обходит коллекции Справочники, Документы, РегистрыСведений,
// РегистрыНакопления, РегистрыБухгалтерии, Перечисления, Отчеты, Обработки.
//
// Параметры (JSON): query (обяз.), object_type (опц.), limit (1..100, деф. 20).
//
// Возвращаемое значение:
//  Строка - JSON {"items":[{type,name,synonym,comment}],"total_found":N}.
//
Функция ПоискМетаданных(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		СтрокаПоиска = ПолучитьСтроку(Аргс, "query");
		Если ПустаяСтрока(СтрокаПоиска) Тогда
			Возврат ОшибочныйJSON("query_required");
		КонецЕсли;
		Если СтрДлина(СтрокаПоиска) > 200 Тогда
			СтрокаПоиска = Лев(СтрокаПоиска, 200);
		КонецЕсли;
		СтрокаПоискаВРег = ВРег(СтрокаПоиска);

		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 20), 1, 100, 20);
		ТипОбъекта = ПолучитьСтроку(Аргс, "object_type");

		Элементы = Новый Массив;
		ВсегоНайдено = 0;

		КоллекцииМетаданных = КоллекцииМетаданныхДляПоиска(ТипОбъекта);
		Для Каждого ОписаниеКоллекции Из КоллекцииМетаданных Цикл
			Для Каждого МД Из ОписаниеКоллекции.Коллекция Цикл
				Если НЕ ОбъектСоответствуетПоиску(МД, СтрокаПоискаВРег) Тогда
					Продолжить;
				КонецЕсли;
				ВсегоНайдено = ВсегоНайдено + 1;
				Если Элементы.Количество() < Лимит Тогда
					Элемент = Новый Структура;
					Элемент.Вставить("type", ОписаниеКоллекции.Тип);
					Элемент.Вставить("name", МД.Имя);
					Элемент.Вставить("synonym", МД.Синоним);
					Элемент.Вставить("comment", МД.Комментарий);
					Элементы.Добавить(Элемент);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Результат = Новый Структура;
		Результат.Вставить("items", Элементы);
		Результат.Вставить("total_found", ВсегоНайдено);
		Возврат ar_JSON.ВЗначениеJSON(Результат);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool list_catalogs: список справочников целевой конфигурации.
//
// Параметры (JSON): include_groups (опц., деф. Ложь), limit (опц.), offset (опц., деф. 0).
//
// Возвращаемое значение:
//  Строка - JSON {"catalogs":[{name,synonym,hierarchical,has_owners[,
//           predefined_groups_count]}],"count":N,"offset":N,"next_offset":N|null}.
//           Не более 200 записей на страницу.
//
Функция СписокСправочников(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);
		ВключатьГруппы = ПолучитьБулево(Аргс, "include_groups", Ложь);
		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", МаксимумОбъектовСписка()),
			1, МаксимумОбъектовСписка(), МаксимумОбъектовСписка());
		Offset = НормализоватьОффсет(Аргс);

		ВсеСправочники = Новый Массив;
		Для Каждого МД Из Метаданные.Справочники Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("name", МД.Имя);
			Элемент.Вставить("synonym", МД.Синоним);
			Элемент.Вставить("hierarchical", МД.Иерархический);
			Элемент.Вставить("has_owners", МД.Владельцы.Количество() > 0);
			Если ВключатьГруппы Тогда
				Элемент.Вставить("predefined_groups_count", КоличествоПредопределённыхГрупп(МД));
			КонецЕсли;
			ВсеСправочники.Добавить(Элемент);
		КонецЦикла;

		СортироватьМассивСтруктурПоИмени(ВсеСправочники);
		Страница = СрезМассиваСОффсетом(ВсеСправочники, Offset, Лимит);
		ЕстьПродолжение = (Offset + Страница.Количество()) < ВсеСправочники.Количество();
		NextOffset = ?(ЕстьПродолжение, Offset + Страница.Количество(), Неопределено);

		Результат = Новый Структура;
		Результат.Вставить("catalogs", Страница);
		Результат.Вставить("count", Страница.Количество());
		Результат.Вставить("offset", Offset);
		Результат.Вставить("next_offset", NextOffset);
		Возврат ar_JSON.ВЗначениеJSON(Результат);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool list_documents: список документов целевой конфигурации с регистрами,
// в которые документ делает движения.
//
// Параметры (JSON): limit (опц.), offset (опц., деф. 0).
//
// Возвращаемое значение:
//  Строка - JSON {"documents":[{name,synonym,registers}],"count":N,"offset":N,"next_offset":N|null}.
//
Функция СписокДокументов(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);
		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", МаксимумОбъектовСписка()),
			1, МаксимумОбъектовСписка(), МаксимумОбъектовСписка());
		Offset = НормализоватьОффсет(Аргс);

		ВсеДокументы = Новый Массив;
		Для Каждого МД Из Метаданные.Документы Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("name", МД.Имя);
			Элемент.Вставить("synonym", МД.Синоним);
			Элемент.Вставить("registers", ИменаРегистровДвижений(МД));
			ВсеДокументы.Добавить(Элемент);
		КонецЦикла;

		СортироватьМассивСтруктурПоИмени(ВсеДокументы);
		Страница = СрезМассиваСОффсетом(ВсеДокументы, Offset, Лимит);
		ЕстьПродолжение = (Offset + Страница.Количество()) < ВсеДокументы.Количество();
		NextOffset = ?(ЕстьПродолжение, Offset + Страница.Количество(), Неопределено);

		Результат = Новый Структура;
		Результат.Вставить("documents", Страница);
		Результат.Вставить("count", Страница.Количество());
		Результат.Вставить("offset", Offset);
		Результат.Вставить("next_offset", NextOffset);
		Возврат ar_JSON.ВЗначениеJSON(Результат);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool read_object: чтение реквизитов объекта ИБ по навигационной ссылке или
// UUID. Исключает реквизиты типов ХранилищеЗначения / Строка неограниченной
// длины, не рекурсирует ссылочные значения (только {ref,name}).
//
// Параметры (JSON): ref (обяз.), object_type (опц., нужен при ref-UUID),
//   fields (опц. массив), include_tabular (опц., деф. Ложь).
//
// Возвращаемое значение:
//  Строка - JSON {ref,type,fields,tabular_sections,truncated_fields[,deleted]}
//           либо {"error":"object_not_found"}.
//
Функция ЧтениеОбъекта(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		СтрокаСсылки = ПолучитьСтроку(Аргс, "ref");
		Если ПустаяСтрока(СтрокаСсылки) Тогда
			Возврат ОшибочныйJSON("ref_required");
		КонецЕсли;

		ТипОбъекта = ПолучитьСтроку(Аргс, "object_type");
		Ссылка = РазыменоватьСсылку(СтрокаСсылки, ТипОбъекта);

		Если Ссылка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Возврат ОшибочныйJSON("object_not_found");
		КонецЕсли;

		МетаданныеОбъекта = Ссылка.Метаданные();
		ПолноеИмяТипа = МетаданныеОбъекта.ПолноеИмя();

		ЗапрошенныеПоля = ПолучитьМассивСтрок(Аргс, "fields");
		ВключатьТабличные = ПолучитьБулево(Аргс, "include_tabular", Ложь);

		// TOOL-16: читаем флаг compliance один раз — при Ложь не входим в ветки маскировки.
		РежимCompliance = ar_Константы.ComplianceРежим();
		// PII-08: счётчик срабатываний маскирования для прозрачности (лог pii_masked).
		СтатистикаМаскирования = ?(РежимCompliance, НоваяСтатистикаМаскирования(), Неопределено);

		Поля = Новый Структура;
		ОбрезанныеПоля = Новый Массив;
		ЗаполнитьПоляЗаголовка(Ссылка, МетаданныеОбъекта, ЗапрошенныеПоля, Поля, ОбрезанныеПоля,
			РежимCompliance, СтатистикаМаскирования);

		// ROREF-02: контактная информация (Email/Телефон/Адрес) в конфигурациях
		// на базе БСП хранится через подсистему "УправлениеКонтактнойИнформацией"
		// (подчинённый регистр сведений), а не как прямой реквизит справочника -
		// whitelist прямых реквизитов (ЗаполнитьПоляЗаголовка) её не видит.
		// Подмешиваем те же виды КИ, что уже читает ar_ToolCRM.ПолучитьТекущиеКонтакты,
		// universally для любого объекта с этой подсистемой, а не только контрагентов.
		ДобавитьКонтактнуюИнформациюБСП(Ссылка, ЗапрошенныеПоля, Поля, РежимCompliance, ПолноеИмяТипа,
			СтатистикаМаскирования);

		ТабличныеЧасти = Новый Структура;
		Если ВключатьТабличные Тогда
			ЗаполнитьТабличныеЧасти(Ссылка, МетаданныеОбъекта, ТабличныеЧасти, РежимCompliance,
				СтатистикаМаскирования);
		КонецЕсли;

		// PII-08: одна сводная запись на вызов tool -- только счётчик и имена полей,
		// без значений.
		ЛогироватьМаскирование("read_object", СтатистикаМаскирования, Контекст);

		Результат = Новый Структура;
		Результат.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Ссылка));
		Результат.Вставить("type", КороткийТипМетаданных(ПолноеИмяТипа));
		Результат.Вставить("fields", Поля);
		Результат.Вставить("tabular_sections", ТабличныеЧасти);
		Результат.Вставить("truncated_fields", ОбрезанныеПоля);

		Если ОбъектПомеченНаУдаление(Ссылка) Тогда
			Результат.Вставить("deleted", Истина);
		КонецЕсли;

		Возврат ОграничитьРазмерObservation(Результат);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool query: универсальный построитель read-only запросов к данным целевой
// конфигурации. Поддерживает Справочники, Документы, Регистры сведений и
// накопления. Имена источника и полей валидируются по метаданным и никогда не
// попадают в текст запроса напрямую - только МД.ПолноеИмя() и параметрические
// значения (&П_<Поле>). Привилегированный режим не используется: данные читаются
// в правах сессии (RLS целевой КФ работает естественно).
//
// Параметры (JSON): source (обяз., "<Класс>.<Имя>"), filters (обяз., объект),
//   fields (опц., массив строк), limit (опц., деф. 100, макс. 1000).
//
// Возвращаемое значение:
//  Строка - JSON {source, items, count, limit, truncated, warnings} либо
//           {"error":"<код>"[,"hint":...]}.
//
Функция УниверсальныйЗапрос(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		Предупреждения = Новый Массив;

		Источник = ПолучитьИсточникССинонимами(Аргс, Предупреждения);
		Фильтры = ПолучитьФильтрыССинонимами(Аргс, Предупреждения);

		// LLM нередко кладёт source внутрь filters вместо верхнего уровня -
		// поднимаем его наверх, иначе диалог срывается в переспрашивание.
		Если ПустаяСтрока(Источник) И ТипЗнч(Фильтры) = Тип("Соответствие") Тогда
			ВложенныйИсточник = Фильтры.Получить("source");
			Если ТипЗнч(ВложенныйИсточник) = Тип("Строка")
				И НЕ ПустаяСтрока(СокрЛП(ВложенныйИсточник)) Тогда
				Источник = СокрЛП(ВложенныйИсточник);
				Фильтры.Удалить("source");
				Предупреждения.Добавить("source_taken_from_filters");
			КонецЕсли;
		КонецЕсли;

		Если ПустаяСтрока(Источник) Тогда
			Возврат ОшибочныйJSONСПодсказкой("source_required",
				"Pass source as a top-level string, e.g."
				+ " {""source"":""Справочник.Контрагенты"",""filters"":{}}."
				+ " Call search_metadata first if the exact name is unknown");
		КонецЕсли;

		// Отсутствие filters равнозначно {} - выборка без отбора (как в aggregate).
		// Иначе запрос вида "покажи всех" срывается в filters_required.
		Если Фильтры = Неопределено Тогда
			Фильтры = Новый Соответствие;
		ИначеЕсли ТипЗнч(Фильтры) <> Тип("Соответствие") Тогда
			Возврат ОшибочныйJSONСПодсказкой("filters_required",
				"Pass filters as an object of field/value pairs, e.g."
				+ " {""filters"":{""Наименование"":""Ромашка""}}; a text condition"
				+ " string is not accepted. Omit filters or use {} to select without filtering");
		КонецЕсли;

		Лимит = НормализоватьЛимитЗапроса(Аргс, Предупреждения);
		Offset = НормализоватьОффсет(Аргс);

		ОписаниеИсточника = ВалидироватьИсточникЗапроса(Источник);
		Если ОписаниеИсточника = Неопределено Тогда
			Возврат ОшибкаНеизвестногоИсточника();
		КонецЕсли;
		Если ОписаниеИсточника.ЭтоОбъектРасширения Тогда
			Возврат ОшибочныйJSON("access_denied_to_extension_object");
		КонецЕсли;

		ДоступныеПоля = ПолучитьДоступныеПоля(ОписаниеИсточника.Метаданные, ОписаниеИсточника.Категория);

		ЗапрошенныеПоля = ПолучитьМассивСтрок(Аргс, "fields");
		ПоляЗапроса = ОтобратьПоляЗапроса(ЗапрошенныеПоля, ДоступныеПоля, Предупреждения);
		Если ПоляЗапроса.Количество() = 0 Тогда
			Возврат ОшибочныйJSONСПодсказкой("no_valid_fields",
				"Call get_object_structure to list available fields of the source");
		КонецЕсли;

		Запрос = Новый Запрос;
		УсловияЗапроса = СобратьУсловияЗапроса(Запрос, Фильтры, ДоступныеПоля, ОписаниеИсточника, Предупреждения);

		// Определяем полное количество записей запросом КОЛИЧЕСТВО для корректного next_offset.
		ВсегоЗаписей = ВыполнитьЗапросКоличества(ОписаниеИсточника, УсловияЗапроса, Запрос);

		// TOOL-16: читаем флаг compliance один раз — при Ложь не входим в ветки маскировки.
		РежимCompliance = ar_Константы.ComplianceРежим();
		// PII-08: счётчик срабатываний маскирования для прозрачности (лог pii_masked).
		СтатистикаМаскирования = ?(РежимCompliance, НоваяСтатистикаМаскирования(), Неопределено);

		Запрос.Текст = ТекстЗапросаДанных(ОписаниеИсточника, ПоляЗапроса, УсловияЗапроса, Лимит, Offset);

		Observation = СериализоватьРезультатЗапроса(Запрос.Выполнить(), ПоляЗапроса,
			Источник, Лимит, Offset, ВсегоЗаписей, Предупреждения, РежимCompliance,
			ОписаниеИсточника.ПолноеИмя, СтатистикаМаскирования);

		// PII-08: одна сводная запись на вызов tool -- только счётчик и имена полей,
		// без значений.
		ЛогироватьМаскирование("query", СтатистикаМаскирования, Контекст);

		Возврат Observation;
	Исключение
		Возврат ОшибкаВыполненияЗапроса(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool get_recent_changes: недавно изменённые объекты (Справочники и Документы).
//
// Документы фильтруются по стандартному реквизиту Дата. Справочники - по
// реквизиту ДатаИзменения, если он определён в метаданных; иначе возвращается
// graceful observation {"error":"no_change_tracking","hint":...}.
//
// Параметры (JSON): object_type (обяз., "<Тип>.<Имя>"), minutes (1..1440,
//   деф. 60), limit (деф. 20).
//
// Возвращаемое значение:
//  Строка - JSON {"items":[{ref,name,date}],"count":N} либо graceful error.
//
Функция ПоследниеИзменения(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		ТипОбъекта = ПолучитьСтроку(Аргс, "object_type");
		Если ПустаяСтрока(ТипОбъекта) Тогда
			Возврат ОшибочныйJSON("object_type_required");
		КонецЕсли;

		ОписаниеТипа = РазобратьТипОбъекта(ТипОбъекта);
		Если ОписаниеТипа = Неопределено Тогда
			Возврат ОшибочныйJSONСПодсказкой("unknown_object_type",
				"object_type должен быть в формате ""Тип.Имя"", например ""Справочник.Контрагенты"""
				+ " или ""Документ.СчетНаОплатуПокупателю"". Английские имена классов метаданных"
				+ " (Catalog, Document) не поддерживаются - используйте search_metadata, чтобы"
				+ " найти точное русское имя объекта.");
		КонецЕсли;

		Минуты = НормализоватьЛимит(ПолучитьЧисло(Аргс, "minutes", 60), 1, 1440, 60);
		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 20), 1, 100, 20);
		ДатаОт = ТекущаяДатаСеанса() - Минуты * 60;

		Если ОписаниеТипа.Категория = "Документ" Тогда
			Элементы = ПолучитьИзменённыеДокументы(ОписаниеТипа.ПолноеИмя, ДатаОт, Лимит);
		Иначе
			Если НЕ СправочникОтслеживаетИзменения(ОписаниеТипа.Метаданные) Тогда
				Результат = Новый Структура;
				Результат.Вставить("error", "no_change_tracking");
				Результат.Вставить("hint", "use query with date filter");
				Возврат ar_JSON.ВЗначениеJSON(Результат);
			КонецЕсли;
			Элементы = ПолучитьИзменённыеСправочники(ОписаниеТипа.ПолноеИмя, ДатаОт, Лимит);
		КонецЕсли;

		Результат = Новый Структура;
		Результат.Вставить("items", Элементы);
		Результат.Вставить("count", Элементы.Количество());
		Возврат ar_JSON.ВЗначениеJSON(Результат);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool search_text: полнотекстовый поиск по данным ИБ. При отключённом ПП -
// graceful fallback на search_metadata с warning.
//
// Параметры (JSON): query (обяз., >= 3 симв.), object_type (опц.),
//   limit (деф. 10), offset (опц., деф. 0).
//
// Возвращаемое значение:
//  Строка - JSON {"items":[{ref,name,type,highlight}],"count":N,"offset":N,"next_offset":N|null}
//           либо fallback {"warning":"fulltext_search_disabled",...} либо
//           {"error":"query_too_short"}.
//
Функция ПоискТекста(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		СтрокаПоиска = ПолучитьСтроку(Аргс, "query");
		Если ПустаяСтрока(СтрокаПоиска) ИЛИ СтрДлина(СтрокаПоиска) < 3 Тогда
			Возврат ОшибочныйJSON("query_too_short");
		КонецЕсли;
		Если СтрДлина(СтрокаПоиска) > 500 Тогда
			СтрокаПоиска = Лев(СтрокаПоиска, 500);
		КонецЕсли;

		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 10), 1, 100, 10);
		ТипОбъекта = ПолучитьСтроку(Аргс, "object_type");
		Offset = НормализоватьОффсет(Аргс);

		Если НЕ ПолнотекстовыйПоискДоступен() Тогда
			Возврат FallbackНаПоискМетаданных(СтрокаПоиска, ТипОбъекта, Лимит, Offset);
		КонецЕсли;

		Возврат ВыполнитьПолнотекстовыйПоиск(СтрокаПоиска, ТипОбъекта, Лимит, Offset);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool get_object_structure: схема типа метаданных - реквизиты, ТЧ, измерения, ресурсы.
// RiskLevel=Read, ТребуетApproval=Ложь. DryRun игнорируется.
//
// Параметры (JSON): object_type (обяз.) - полное имя типа вида "Класс.Имя".
//
// Возвращаемое значение:
//  Строка - JSON {type, name, synonym, attributes, tabular_sections,
//           dimensions, resources, measures, values, truncated} | {"error":"<код>"}
//
Функция СтруктураТипаОбъекта(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		ИмяТипа = ПолучитьСтроку(Аргс, "object_type");
		Если ПустаяСтрока(ИмяТипа) Тогда
			Возврат ОшибочныйJSON("object_type_required");
		КонецЕсли;

		ОписаниеМД = НайтиОбъектМетаданных(ИмяТипа);
		Если ОписаниеМД = Неопределено Тогда
			Возврат ОшибочныйJSON("unknown_object_type");
		КонецЕсли;

		МД = ОписаниеМД.Метаданные;
		Если ИсточникРасширения(МД) Тогда
			Возврат ОшибочныйJSON("access_denied_to_extension_object");
		КонецЕсли;

		Результат = Новый Структура;
		Результат.Вставить("type", КороткийТипМетаданных(МД.ПолноеИмя()));
		Результат.Вставить("name", МД.Имя);
		Результат.Вставить("synonym", МД.Синоним);

		Класс = ОписаниеМД.Класс;

		Если Класс = "Перечисление" Тогда
			Значения = Новый Массив;
			Для Каждого ЗначениеМД Из МД.ЗначенияПеречисления Цикл
				ЗначениеОбъект = Новый Структура;
				ЗначениеОбъект.Вставить("name", ЗначениеМД.Имя);
				ЗначениеОбъект.Вставить("synonym", ЗначениеМД.Синоним);
				Значения.Добавить(ЗначениеОбъект);
			КонецЦикла;
			Результат.Вставить("values", Значения);
			Результат.Вставить("attributes", Новый Массив);
			Результат.Вставить("tabular_sections", Новый Массив);
			Результат.Вставить("dimensions", Новый Массив);
			Результат.Вставить("resources", Новый Массив);
			Результат.Вставить("measures", Новый Массив);
		ИначеЕсли Класс = "Справочник" ИЛИ Класс = "Документ" Тогда
			Результат.Вставить("attributes", СобратьАтрибутыКоллекции(МД.Реквизиты));
			ТабличныеЧастиМассив = Новый Массив;
			Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
				ТЧОбъект = Новый Структура;
				ТЧОбъект.Вставить("name", ТЧ.Имя);
				ТЧОбъект.Вставить("synonym", ТЧ.Синоним);
				ТЧОбъект.Вставить("attributes", СобратьАтрибутыКоллекции(ТЧ.Реквизиты));
				ТабличныеЧастиМассив.Добавить(ТЧОбъект);
			КонецЦикла;
			Результат.Вставить("tabular_sections", ТабличныеЧастиМассив);
			Результат.Вставить("dimensions", Новый Массив);
			Результат.Вставить("resources", Новый Массив);
			Результат.Вставить("measures", Новый Массив);
		ИначеЕсли Класс = "РегистрСведений" ИЛИ Класс = "РегистрНакопления"
			ИЛИ Класс = "РегистрБухгалтерии" Тогда
			Результат.Вставить("attributes", СобратьАтрибутыКоллекции(МД.Реквизиты));
			Результат.Вставить("tabular_sections", Новый Массив);
			Результат.Вставить("dimensions", СобратьАтрибутыКоллекции(МД.Измерения));
			Результат.Вставить("resources", СобратьАтрибутыКоллекции(МД.Ресурсы));
			Результат.Вставить("measures", Новый Массив);
		Иначе
			// Неподдерживаемый класс - возвращаем ошибку unknown_object_type.
			Возврат ОшибочныйJSON("unknown_object_type");
		КонецЕсли;

		Результат.Вставить("truncated", Ложь);
		Возврат ОграничитьРазмерОбзорСтруктуры(Результат);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool find_references: поиск мест использования объекта ИБ через НайтиПоСсылкам.
// RiskLevel=Read, ТребуетApproval=Ложь. DryRun игнорируется (read-only).
//
// Параметры (JSON): ref (обяз.) - навигационная ссылка или UUID,
//   object_type (опц.) - тип, нужен если ref - UUID,
//   limit (опц., деф. 20, макс. 100).
//
// Возвращаемое значение:
//  Строка - JSON {ref, type, name, items:[{type,ref,name,field}], count, truncated}
//           | {"error":"<код>"}
//
Функция НайтиСсылки(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		СтрокаСсылки = ПолучитьСтроку(Аргс, "ref");
		Если ПустаяСтрока(СтрокаСсылки) Тогда
			Возврат ОшибочныйJSON("ref_required");
		КонецЕсли;

		ТипОбъекта = ПолучитьСтроку(Аргс, "object_type");
		Ссылка = РазыменоватьСсылку(СтрокаСсылки, ТипОбъекта);

		Если Ссылка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Возврат ОшибочныйJSON("object_not_found");
		КонецЕсли;

		МД = Ссылка.Метаданные();
		Если ИсточникРасширения(МД) Тогда
			Возврат ОшибочныйJSON("access_denied_to_extension_object");
		КонецЕсли;

		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 20), 1, 100, 20);
		Offset = НормализоватьОффсет(Аргс);

		МассивСсылок = Новый Массив;
		МассивСсылок.Добавить(Ссылка);

		ТаблицаМест = НайтиПоСсылкам(МассивСсылок);

		// Срез таблицы мест использования с учётом смещения.
		ВсегоМест = ТаблицаМест.Количество();
		Элементы = ПреобразоватьМестаИспользованияСОффсетом(ТаблицаМест, Offset, Лимит);
		ЕстьПродолжение = (Offset + Элементы.Количество()) < ВсегоМест;
		NextOffset = ?(ЕстьПродолжение, Offset + Элементы.Количество(), Неопределено);

		// truncated остаётся для обратной совместимости: true если размер обрезан ОграничитьРазмерObservation.
		// На этом уровне выставляем false; ОграничитьРазмерObservation может установить size_limited.
		Результат = Новый Структура;
		Результат.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Ссылка));
		Результат.Вставить("type", КороткийТипМетаданных(МД.ПолноеИмя()));
		Результат.Вставить("name", Строка(Ссылка));
		Результат.Вставить("items", Элементы);
		Результат.Вставить("count", Элементы.Количество());
		Результат.Вставить("offset", Offset);
		Результат.Вставить("next_offset", NextOffset);
		Результат.Вставить("truncated", Ложь);

		Возврат ОграничитьРазмерObservation(Результат);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool get_object_history: история версий объекта ИБ через БСП «Версионирование объектов».
// RiskLevel=Read, ТребуетApproval=Ложь. DryRun игнорируется (read-only).
//
// Параметры (JSON): ref (обяз.) - навигационная ссылка или UUID,
//   object_type (опц.) - тип, нужен если ref - UUID,
//   limit (опц., деф. 10, макс. 50).
//
// Возвращаемое значение:
//  Строка - JSON {ref, type, name, versions:[{version,date,user,comment}], count, truncated}
//           | {"error":"no_version_history","hint":"..."} | {"error":"<код>"}
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM.
//  Контекст  - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ИсторияВерсийОбъекта(Знач Аргументы, Знач Контекст) Экспорт

	Попытка

		Аргс = РазобратьАргументы(Аргументы);

		// 1. Разобрать ref.
		СтрокаСсылки = ПолучитьСтроку(Аргс, "ref");
		Если ПустаяСтрока(СтрокаСсылки) Тогда
			Возврат ОшибочныйJSON("ref_required");
		КонецЕсли;

		// 2. Разыменовать ссылку.
		ТипОбъекта = ПолучитьСтроку(Аргс, "object_type");
		Ссылка = РазыменоватьСсылку(СтрокаСсылки, ТипОбъекта);
		Если Ссылка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Возврат ОшибочныйJSON("object_not_found");
		КонецЕсли;

		// 3. Проверка источника расширения.
		МД = Ссылка.Метаданные();
		Если ИсточникРасширения(МД) Тогда
			Возврат ОшибочныйJSON("access_denied_to_extension_object");
		КонецЕсли;

		// 4. Нормализовать лимит.
		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 10), 1, 50, 10);

		// 5-7. Проверить подсистему, права и получить список версий.
		ОшибкаПодсистемы = ПроверитьДоступностьВерсионирования();
		Если ОшибкаПодсистемы <> Неопределено Тогда
			Возврат ОшибкаПодсистемы;
		КонецЕсли;

		НомерПоследней = ВерсионированиеОбъектов.НомерПоследнейВерсии(Ссылка);
		Если НомерПоследней = 0 Тогда
			Результат = Новый Структура;
			Результат.Вставить("error", "no_version_history");
			Результат.Вставить("hint", "Enable object versioning in BSP settings for this object type");
			Возврат ar_JSON.ВЗначениеJSON(Результат);
		КонецЕсли;

		// 8. Собрать массив версий.
		НомерНачала = Макс(1, НомерПоследней - Лимит + 1);
		Версии = СобратьВерсииОбъекта(Ссылка, НомерПоследней, НомерНачала);

		// 9. Признак усечения: первая запрошенная версия не является версией 1.
		Усечено = НомерНачала > 1;

		// 10. Сформировать результат.
		Результат = Новый Структура;
		Результат.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Ссылка));
		Результат.Вставить("type", КороткийТипМетаданных(МД.ПолноеИмя()));
		Результат.Вставить("name", Строка(Ссылка));
		Результат.Вставить("versions", Версии);
		Результат.Вставить("count", Версии.Количество());
		Результат.Вставить("truncated", Усечено);

		Возврат ОграничитьРазмерObservation(Результат);

	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool aggregate: агрегация данных источника query (СУММА/КОЛИЧЕСТВО/МИНИМУМ/
// МАКСИМУМ/СРЕДНЕЕ) с группировкой. Полностью переиспользует whitelist-путь
// query (ВалидироватьИсточникЗапроса, ПолучитьДоступныеПоля, ОтобратьПоляЗапроса,
// СобратьУсловияЗапроса) - текст запроса от LLM не принимается, ни group_by, ни
// aggregates[].field не попадают в текст запроса без проверки по whitelist
// источника (UNIV-07, DoD D1).
//
// Параметры (JSON): source (обяз., "<Класс>.<Имя>"), filters (опц., формат query),
//   group_by (опц., Массив строк полей), aggregates (обяз., Массив
//   {"func":"СУММА"|"SUM"|...,"field":"...","as":"..." (опц.)}), limit (опц.,
//   деф. 100, макс. 500).
//
// Возвращаемое значение:
//  Строка - JSON {"source","group_by","aggregates","items","count","limit",
//  "paginated":false,"truncated","warnings"} либо {"error":...}.
//
Функция Агрегировать(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);

		Предупреждения = Новый Массив;

		Источник = ПолучитьИсточникССинонимами(Аргс, Предупреждения);
		Если ПустаяСтрока(Источник) Тогда
			Возврат ОшибочныйJSONСПодсказкой("source_required",
				"Pass source as a top-level string, e.g."
				+ " {""source"":""Документ.РеализацияТоваровУслуг"",""aggregates"":"
				+ "[{""func"":""СУММА"",""field"":""СуммаДокумента""}]}");
		КонецЕсли;

		Фильтры = ПолучитьФильтрыССинонимами(Аргс, Предупреждения);
		Если Фильтры = Неопределено Тогда
			Фильтры = Новый Соответствие;
		ИначеЕсли ТипЗнч(Фильтры) <> Тип("Соответствие") Тогда
			Возврат ОшибочныйJSONСПодсказкой("filters_required",
				"Pass filters as an object; omit it or use {} to select without filtering");
		КонецЕсли;

		GroupByПоля = ПолучитьМассивСтрок(Аргс, "group_by");

		МассивАгрегатов = Аргс.Получить("aggregates");
		Если ТипЗнч(МассивАгрегатов) <> Тип("Массив") ИЛИ МассивАгрегатов.Количество() = 0 Тогда
			Возврат ОшибочныйJSONСПодсказкой("aggregates_required",
				"Pass aggregates as a non-empty array, e.g."
				+ " [{""func"":""СУММА"",""field"":""СуммаДокумента"",""as"":""итого""}]");
		КонецЕсли;

		Лимит = НормализоватьЛимитАгрегатов(Аргс, Предупреждения);

		ОписаниеИсточника = ВалидироватьИсточникЗапроса(Источник);
		Если ОписаниеИсточника = Неопределено Тогда
			Возврат ОшибкаНеизвестногоИсточника();
		КонецЕсли;
		Если ОписаниеИсточника.ЭтоОбъектРасширения Тогда
			Возврат ОшибочныйJSON("access_denied_to_extension_object");
		КонецЕсли;

		ДоступныеПоля = ПолучитьДоступныеПоля(ОписаниеИсточника.Метаданные, ОписаниеИсточника.Категория);

		// group_by - тот же whitelist-путь, что и fields в query (переиспользуем
		// ОтобратьПоляЗапроса: непустой список -> пересечение с whitelist).
		GroupByКанонические = ОтобратьПоляЗапроса(GroupByПоля, ДоступныеПоля, Предупреждения);
		Если GroupByПоля.Количество() = 0 Тогда
			// ОтобратьПоляЗапроса с пустым списком вернула бы весь whitelist -
			// для aggregate пустой group_by означает "без группировки", не "все поля".
			GroupByКанонические = Новый Массив;
		КонецЕсли;

		АгрегатыКанонические = РазобратьАгрегаты(МассивАгрегатов, ДоступныеПоля, Предупреждения);
		Если АгрегатыКанонические.Количество() = 0 Тогда
			Возврат ОшибочныйJSONСПодсказкой("no_valid_aggregates",
				"Call get_object_structure to list available fields of the source;"
				+ " func must be one of SUM/COUNT/MIN/MAX/AVG"
				+ " (or СУММА/КОЛИЧЕСТВО/МИНИМУМ/МАКСИМУМ/СРЕДНЕЕ)");
		КонецЕсли;

		Запрос = Новый Запрос;
		УсловияЗапроса = СобратьУсловияЗапроса(Запрос, Фильтры, ДоступныеПоля, ОписаниеИсточника, Предупреждения);

		Запрос.Текст = ТекстЗапросаАгрегатов(ОписаниеИсточника, GroupByКанонические,
			АгрегатыКанонические, УсловияЗапроса, Лимит);

		РежимCompliance = ar_Константы.ComplianceРежим();
		СтатистикаМаскирования = ?(РежимCompliance, НоваяСтатистикаМаскирования(), Неопределено);

		Observation = СериализоватьРезультатАгрегатов(Запрос.Выполнить(), Источник,
			GroupByКанонические, АгрегатыКанонические, Лимит, Предупреждения,
			РежимCompliance, ОписаниеИсточника.ПолноеИмя, СтатистикаМаскирования);

		ЛогироватьМаскирование("aggregate", СтатистикаМаскирования, Контекст);

		Возврат Observation;
	Исключение
		Возврат ОшибкаВыполненияЗапроса(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool get_functional_options: список функциональных опций конфигурации.
// Читает только опции с булевым хранимым значением (whitelist типов, UNIV-07
// DoD D3) - опции иного типа (ссылка на ПВХ) пропускаются с warnings.
//
// Параметры (JSON): names (опц., Массив строк - фильтр по имени; пусто - все).
//
// Возвращаемое значение:
//  Строка - JSON {"items":[{name,synonym,value}],"count","warnings"}.
//
Функция ФункциональныеОпции(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);
		Предупреждения = Новый Массив;

		ЗапрошенныеИмена = ПолучитьМассивСтрок(Аргс, "names");
		ИндексЗапрошенных = ИндексИменПолей(ЗапрошенныеИмена);

		Смещение = НормализоватьОффсет(Аргс);
		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 100), 1, 500, 100);

		Кандидаты = Новый Массив;
		Для Каждого МД Из Метаданные.ФункциональныеОпции Цикл
			Если ИндексЗапрошенных.Количество() > 0
				И ИндексЗапрошенных.Получить(ВРег(МД.Имя)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Кандидаты.Добавить(МД);
		КонецЦикла;

		ПроверитьНайденныеИменаМД(ЗапрошенныеИмена, Кандидаты, Предупреждения, "fo_not_found");

		Элементы = Новый Массив;
		Для Каждого МД Из Кандидаты Цикл
			Попытка
				// Значение функциональной опции читается глобальной платформенной
				// функцией ПолучитьФункциональнуюОпцию(Имя) - у объекта метаданных
				// ФункциональнаяОпция метода ПолучитьЗначение() нет.
				Значение = ПолучитьФункциональнуюОпцию(МД.Имя);
			Исключение
				Предупреждения.Добавить("fo_read_error: " + МД.Имя);
				Продолжить;
			КонецПопытки;

			Если ТипЗнч(Значение) <> Тип("Булево") Тогда
				Предупреждения.Добавить("fo_type_unsupported: " + МД.Имя);
				Продолжить;
			КонецЕсли;

			Элемент = Новый Структура;
			Элемент.Вставить("name", МД.Имя);
			Элемент.Вставить("synonym", МД.Синоним);
			Элемент.Вставить("value", Значение);
			Элементы.Добавить(Элемент);
		КонецЦикла;

		СортироватьМассивСтруктурПоИмени(Элементы);

		Страница = СрезМассиваСОффсетом(Элементы, Смещение, Лимит);
		ЕстьПродолжение = (Смещение + Страница.Количество()) < Элементы.Количество();
		NextOffset = ?(ЕстьПродолжение, Смещение + Страница.Количество(), Неопределено);

		Результат = Новый Структура;
		Результат.Вставить("items", Страница);
		Результат.Вставить("count", Страница.Количество());
		Результат.Вставить("offset", Смещение);
		Результат.Вставить("next_offset", NextOffset);
		Результат.Вставить("warnings", Предупреждения);
		Возврат ar_JSON.ВЗначениеJSON(Результат);

	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool get_constants: список констант конфигурации со значениями, ОБЯЗАТЕЛЬНО
// маскируемыми через ar_Утилиты.ОчиститьЗначениеПоля (UNIV-07 DoD D4) - константы
// не поддерживают RLS, маскирование по паттерну имени - единственная защита.
// Whitelist типов: Строка/Число/Булево/Дата читаются как примитив, ссылочные -
// как {ref,name}; ХранилищеЗначения исключено полностью.
//
// Параметры (JSON): names (опц., Массив строк - фильтр по имени; пусто - все).
//
// Возвращаемое значение:
//  Строка - JSON {"items":[{name,synonym,value,type}],"count","warnings"}.
//
Функция СписокКонстант(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Аргс = РазобратьАргументы(Аргументы);
		Предупреждения = Новый Массив;

		ЗапрошенныеИмена = ПолучитьМассивСтрок(Аргс, "names");
		ИндексЗапрошенных = ИндексИменПолей(ЗапрошенныеИмена);

		Смещение = НормализоватьОффсет(Аргс);
		Лимит = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 100), 1, 500, 100);

		РежимCompliance = ar_Константы.ComplianceРежим();
		СтатистикаМаскирования = ?(РежимCompliance, НоваяСтатистикаМаскирования(), Неопределено);

		Кандидаты = Новый Массив;
		Для Каждого МД Из Метаданные.Константы Цикл
			Если ИндексЗапрошенных.Количество() > 0
				И ИндексЗапрошенных.Получить(ВРег(МД.Имя)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Кандидаты.Добавить(МД);
		КонецЦикла;

		ПроверитьНайденныеИменаМД(ЗапрошенныеИмена, Кандидаты, Предупреждения, "constant_not_found");

		Элементы = Новый Массив;
		Для Каждого МД Из Кандидаты Цикл

			Если ТипРеквизитаИсключён(МД.Тип) Тогда
				Продолжить;
			КонецЕсли;

			ТипСтрока = ОписатьТипРеквизита(МД.Тип);
			Если ТипСтрока = "unknown" ИЛИ ТипСтрока = "string_unlimited" Тогда
				Предупреждения.Добавить("constant_type_unsupported: " + МД.Имя);
				Продолжить;
			КонецЕсли;

			Попытка
				СырьеЗначение = Константы[МД.Имя].Получить();
			Исключение
				Предупреждения.Добавить("constant_read_error: " + МД.Имя);
				Продолжить;
			КонецПопытки;

			ПредставлениеЗначения = ПредставлениеЗначенияПоля(СырьеЗначение);
			// D4: маскирование обязательно для КАЖДОЙ константы, независимо от
			// РежимCompliance - деньги/секреты в константах не защищены RLS
			// (см. спеку UNIV-07, раздел (e)). ИмяОбъекта = "Константа."+Имя
			// для срабатывания правил PII-01 по объекту, если такие заведены.
			ИмяОбъектаДляМаскирования = "Константа." + МД.Имя;
			ИсходноеПредставление = ПредставлениеЗначения;
			ПредставлениеЗначения = ar_Утилиты.ОчиститьЗначениеПоля(
				ИмяОбъектаДляМаскирования, МД.Имя, ПредставлениеЗначения);
			Если РежимCompliance Тогда
				УчестьМаскирование(СтатистикаМаскирования, ИмяОбъектаДляМаскирования,
					МД.Имя, ИсходноеПредставление, ПредставлениеЗначения);
			КонецЕсли;

			Элемент = Новый Структура;
			Элемент.Вставить("name", МД.Имя);
			Элемент.Вставить("synonym", МД.Синоним);
			Элемент.Вставить("value", ПредставлениеЗначения);
			Элемент.Вставить("type", ТипСтрока);
			Элементы.Добавить(Элемент);
		КонецЦикла;

		СортироватьМассивСтруктурПоИмени(Элементы);

		Страница = СрезМассиваСОффсетом(Элементы, Смещение, Лимит);
		ЕстьПродолжение = (Смещение + Страница.Количество()) < Элементы.Количество();
		NextOffset = ?(ЕстьПродолжение, Смещение + Страница.Количество(), Неопределено);

		ЛогироватьМаскирование("get_constants", СтатистикаМаскирования, Контекст);

		Результат = Новый Структура;
		Результат.Вставить("items", Страница);
		Результат.Вставить("count", Страница.Количество());
		Результат.Вставить("offset", Смещение);
		Результат.Вставить("next_offset", NextOffset);
		Результат.Вставить("warnings", Предупреждения);
		Возврат ar_JSON.ВЗначениеJSON(Результат);

	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool get_current_context: контекст текущей сессии агента - пользователь
// (имя учётной записи, НЕ ФИО физлица), рабочая дата, конфигурация. Поле
// organization не заполняется универсальным слоем (нет БСП-метода без знания
// прикладной конфигурации) - всегда Неопределено (UNIV-07 DoD D5).
//
// Параметры (JSON): {} - без аргументов.
//
// Возвращаемое значение:
//  Строка - JSON {"user","organization","work_date","configuration":{name,version,type},"warnings"}.
//
Функция ТекущийКонтекст(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Предупреждения = Новый Массив;

		ИмяПользователя = "";
		Попытка
			ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
			Если ТекущийПользовательИБ <> Неопределено Тогда
				ИмяПользователя = ТекущийПользовательИБ.Имя;
			КонецЕсли;
		Исключение
			Предупреждения.Добавить("user_read_error");
		КонецПопытки;

		ПрофильКонфигурации = ar_ПрофильКонфигурации.ОпределитьКонфигурацию();
		КонфигурацияОтвет = Новый Структура;
		КонфигурацияОтвет.Вставить("name", ПрофильКонфигурации.Имя);
		КонфигурацияОтвет.Вставить("version", ПрофильКонфигурации.Версия);
		КонфигурацияОтвет.Вставить("type", ПрофильКонфигурации.Тип);

		Результат = Новый Структура;
		Результат.Вставить("user", ИмяПользователя);
		Результат.Вставить("organization", Неопределено);
		Результат.Вставить("work_date", ar_Утилиты.ФорматДата(ТекущаяДатаСеанса()));
		Результат.Вставить("configuration", КонфигурацияОтвет);
		Результат.Вставить("warnings", Предупреждения);
		Возврат ar_JSON.ВЗначениеJSON(Результат);

	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Регистрирует записи 9 универсальных tools в справочнике ar_Tools (upsert).
// Недостающие по имени записи создаёт; существующие - обновляет до актуального
// контракта: ar_Описание и ar_JSONManifest приводятся к текущему манифесту.
// Runtime-изменяемые поля (ar_Включён, ar_ТребуетApproval, ar_RiskLevel и др.)
// у существующих записей НЕ перезаписываются - администратор мог их настроить.
// Идемпотентна: повторный вызов не меняет результат.
// Предназначена для начального заполнения или кнопки «Заполнить реестр».
//
// Привилегированный режим включается локально (запись в служебный реестр ядра)
// и снимается в Попытка/Исключение - это допустимое исключение из правила «без
// привилегий» для процедуры начального заполнения (Plan §1.3, TOOL-02 §Регистрация).
//
// Возвращаемое значение:
//  Число - количество созданных новых записей (обновления не учитываются).
//
Функция ЗарегистрироватьTools() Экспорт

	Создано = 0;
	ОписанияTools = ОписанияУниверсальныхTools();

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Для Каждого Описание Из ОписанияTools Цикл
			СсылкаTool = НайтиЗаписьTool(Описание.Имя);
			Если СсылкаTool = Неопределено Тогда
				СоздатьЗаписьTool(Описание);
				Создано = Создано + 1;
			Иначе
				ОбновитьМанифестTool(СсылкаTool, Описание);
			КонецЕсли;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Создано;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Разбор и чтение аргументов.

// Десериализует JSON-аргументы в Соответствие. Пустые/некорректные → пустое.
Функция РазобратьАргументы(Знач Аргументы)
	Значение = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Новый Соответствие;
КонецФункции

// Читает source из аргументов, принимая синонимы, которые LLM подставляет вместо
// канонического имени (entity/object/table/...). Без этого диалог срывался в
// source_required даже при полностью осмысленном вызове модели.
//
// Параметры:
//  Аргс           - Соответствие - разобранные JSON-аргументы вызова tool.
//  Предупреждения - Массив       - пополняется кодом source_taken_from_<ключ>.
//
// Возвращаемое значение:
//  Строка - имя источника либо "" если ни один из синонимов не заполнен.
//
Функция ПолучитьИсточникССинонимами(Знач Аргс, Предупреждения)

	Источник = ПолучитьСтроку(Аргс, "source");
	Если НЕ ПустаяСтрока(Источник) Тогда
		Возврат Источник;
	КонецЕсли;

	Синонимы = СтрРазделить("entity,object,table,metadata,metadata_name,source_name,type", ",", Ложь);
	Для Каждого Ключ Из Синонимы Цикл
		Значение = ПолучитьСтроку(Аргс, Ключ);
		Если НЕ ПустаяСтрока(Значение) Тогда
			Предупреждения.Добавить("source_taken_from_" + Ключ);
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Читает filters из аргументов, принимая синонимы-объекты (filter/where/...).
// Строковые значения синонимов (LLM иногда шлёт filter как текст условия) не
// принимаются: разбор произвольного текста условия небезопасен - возвращается
// Неопределено, чтобы вызывающий выдал filters_required с подсказкой.
//
// Параметры:
//  Аргс           - Соответствие - разобранные JSON-аргументы вызова tool.
//  Предупреждения - Массив       - пополняется кодом filters_taken_from_<ключ>.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - фильтры либо Неопределено, если их нет.
//
Функция ПолучитьФильтрыССинонимами(Знач Аргс, Предупреждения)

	Фильтры = Аргс.Получить("filters");
	Если ТипЗнч(Фильтры) = Тип("Соответствие") Тогда
		Возврат Фильтры;
	КонецЕсли;

	Синонимы = СтрРазделить("filter,where,conditions,condition", ",", Ложь);
	Для Каждого Ключ Из Синонимы Цикл
		Значение = Аргс.Получить(Ключ);
		Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Предупреждения.Добавить("filters_taken_from_" + Ключ);
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Фильтры;

КонецФункции

// Читает строковое поле из Соответствие аргументов; не-строка → "".
Функция ПолучитьСтроку(Знач Аргс, Знач Ключ)
	Значение = Аргс.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

// Читает числовое поле из Соответствие аргументов; не-число → ЗначениеПоУмолчанию.
Функция ПолучитьЧисло(Знач Аргс, Знач Ключ, Знач ЗначениеПоУмолчанию)
	Значение = Аргс.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Читает булево поле из Соответствие аргументов; не-булево → ЗначениеПоУмолчанию.
Функция ПолучитьБулево(Знач Аргс, Знач Ключ, Знач ЗначениеПоУмолчанию)
	Значение = Аргс.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Читает поле-массив строк из Соответствие аргументов; иначе → пустой массив.
Функция ПолучитьМассивСтрок(Знач Аргс, Знач Ключ)
	Результат = Новый Массив;
	Значение = Аргс.Получить(Ключ);
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			Результат.Добавить(СокрЛП(Элемент));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Читает параметр offset из аргументов: возвращает целое >= 0.
// Отсутствующее, нечисловое или отрицательное значение приводится к 0.
//
// Параметры:
//  Аргс - Соответствие - разобранные JSON-аргументы вызова tool.
//
// Возвращаемое значение:
//  Число - смещение >= 0.
//
Функция НормализоватьОффсет(Знач Аргс)
	Значение = Аргс.Получить("offset");
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Цел = Цел(Значение);
	Если Цел < 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Цел;
КонецФункции

// Возвращает срез массива начиная с позиции Offset длиной не более Лимит элементов.
// Если Offset >= Массив.Количество() - возвращает пустой массив.
//
// Параметры:
//  Массив - Массив - исходный массив.
//  Offset - Число  - начальная позиция (>= 0).
//  Лимит  - Число  - максимальное количество элементов.
//
// Возвращаемое значение:
//  Массив - срез элементов [Offset .. Offset+Лимит-1].
//
Функция СрезМассиваСОффсетом(Знач Массив, Знач Offset, Знач Лимит)
	Результат = Новый Массив;
	Всего = Массив.Количество();
	Если Offset >= Всего Тогда
		Возврат Результат;
	КонецЕсли;
	КонецПозиции = Мин(Offset + Лимит, Всего);
	Для i = Offset По КонецПозиции - 1 Цикл
		Результат.Добавить(Массив[i]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Приводит значение к диапазону [Мин..Макс]; вне диапазона/не-число → ПоУмолчанию.
Функция НормализоватьЛимит(Знач Значение, Знач Мин, Знач Макс, Знач ПоУмолчанию)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Цел = Цел(Значение);
	Если Цел < Мин ИЛИ Цел > Макс Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Цел;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// search_metadata: обход коллекций метаданных.

// Возвращает массив структур {Тип, Коллекция} коллекций метаданных для поиска.
// Если ТипОбъекта задан и распознан - только соответствующая коллекция.
Функция КоллекцииМетаданныхДляПоиска(Знач ТипОбъекта)

	ВсеКоллекции = Новый Массив;
	ДобавитьКоллекцию(ВсеКоллекции, "Catalog", Метаданные.Справочники);
	ДобавитьКоллекцию(ВсеКоллекции, "Document", Метаданные.Документы);
	ДобавитьКоллекцию(ВсеКоллекции, "InformationRegister", Метаданные.РегистрыСведений);
	ДобавитьКоллекцию(ВсеКоллекции, "AccumulationRegister", Метаданные.РегистрыНакопления);
	ДобавитьКоллекцию(ВсеКоллекции, "AccountingRegister", Метаданные.РегистрыБухгалтерии);
	ДобавитьКоллекцию(ВсеКоллекции, "Enum", Метаданные.Перечисления);
	ДобавитьКоллекцию(ВсеКоллекции, "Report", Метаданные.Отчеты);
	ДобавитьКоллекцию(ВсеКоллекции, "DataProcessor", Метаданные.Обработки);

	Если ПустаяСтрока(ТипОбъекта) Тогда
		Возврат ВсеКоллекции;
	КонецЕсли;

	ТипВРег = ВРег(ТипОбъекта);
	Отфильтрованные = Новый Массив;
	Для Каждого Описание Из ВсеКоллекции Цикл
		Если ВРег(Описание.Тип) = ТипВРег Тогда
			Отфильтрованные.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;

	// Неизвестный object_type → ищем по всем коллекциям (graceful).
	Если Отфильтрованные.Количество() = 0 Тогда
		Возврат ВсеКоллекции;
	КонецЕсли;
	Возврат Отфильтрованные;

КонецФункции

// Добавляет в массив описание коллекции метаданных {Тип, Коллекция}.
Процедура ДобавитьКоллекцию(МассивКоллекций, Знач Тип, Знач Коллекция)
	Описание = Новый Структура("Тип, Коллекция", Тип, Коллекция);
	МассивКоллекций.Добавить(Описание);
КонецПроцедуры

// Истина, если имя или синоним объекта метаданных содержит строку поиска
// (без учёта регистра; СтрокаПоискаВРег уже в верхнем регистре).
Функция ОбъектСоответствуетПоиску(Знач МД, Знач СтрокаПоискаВРег)
	Если СтрНайти(ВРег(МД.Имя), СтрокаПоискаВРег) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ВРег(МД.Синоним), СтрокаПоискаВРег) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// list_catalogs / list_documents.

// Возвращает количество предопределённых элементов справочника, являющихся
// группами (для include_groups). При невозможности определить → 0.
Функция КоличествоПредопределённыхГрупп(Знач МД)
	Попытка
		Если НЕ МД.Иерархический Тогда
			Возврат 0;
		КонецЕсли;
		Имена = МД.ПолучитьИменаПредопределенных();
		Возврат Имена.Количество();
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Возвращает массив имён регистров (всех видов), в которые документ делает
// движения.
Функция ИменаРегистровДвижений(Знач МД)
	Имена = Новый Массив;
	Для Каждого Регистр Из МД.Движения Цикл
		Имена.Добавить(Регистр.Имя);
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Сортирует массив структур по полю name по возрастанию (вставками - массивы
// метаданных невелики, до сотен элементов).
Процедура СортироватьМассивСтруктурПоИмени(МассивСтруктур)
	Количество = МассивСтруктур.Количество();
	Для i = 1 По Количество - 1 Цикл
		Текущий = МассивСтруктур[i];
		j = i - 1;
		Пока j >= 0 И ВРег(МассивСтруктур[j].name) > ВРег(Текущий.name) Цикл
			МассивСтруктур[j + 1] = МассивСтруктур[j];
			j = j - 1;
		КонецЦикла;
		МассивСтруктур[j + 1] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Возвращает первые НеБолее элементов массива (или сам массив, если он короче).
Функция ОбрезатьМассив(Знач Массив, Знач НеБолее)
	Если Массив.Количество() <= НеБолее Тогда
		Возврат Массив;
	КонецЕсли;
	Результат = Новый Массив;
	Для i = 0 По НеБолее - 1 Цикл
		Результат.Добавить(Массив[i]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Максимум объектов в выдаче list_catalogs / list_documents (защита от ERP).
Функция МаксимумОбъектовСписка()
	Возврат 200;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// read_object.

// Разыменовывает строку ref в ссылку: навигационная ссылка или UUID + тип.
// Возвращает ссылку или Неопределено.
Функция РазыменоватьСсылку(Знач СтрокаСсылки, Знач ТипОбъекта)

	// UUID + тип объекта.
	Если ar_Утилиты.ЭтоUUID(СтрокаСсылки) И НЕ ПустаяСтрока(ТипОбъекта) Тогда
		Возврат СсылкаПоUUID(СтрокаСсылки, ТипОбъекта);
	КонецЕсли;

	// Навигационная ссылка (e1cib/data/...).
	Объект = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// ОбъектИзНавигационнойСсылки возвращает либо ссылку, либо объект - приводим
	// к ссылке единообразно.
	Возврат СсылкаИзЗначения(Объект);

КонецФункции

// Собирает ссылку по UUID и строке типа объекта ("Справочник.Контрагенты").
// Неизвестный тип → Неопределено.
Функция СсылкаПоUUID(Знач СтрокаUUID, Знач ТипОбъекта)

	ОписаниеТипа = РазобратьТипОбъектаЛюбого(ТипОбъекта);
	Если ОписаниеТипа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Идентификатор = Новый УникальныйИдентификатор(СтрокаUUID);
	Менеджер = МенеджерПоПолномуИмени(ОписаниеТипа.ПолноеИмя);
	Если Менеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Менеджер.ПолучитьСсылку(Идентификатор);

КонецФункции

// Возвращает ссылку из значения: для объекта берёт .Ссылка, для ссылки - как есть.
Функция СсылкаИзЗначения(Знач Значение)
	Попытка
		Возврат Значение.Ссылка;
	Исключение
		Возврат Значение;
	КонецПопытки;
КонецФункции

// Заполняет структуру Поля реквизитами заголовка объекта. Исключает реквизиты
// типов ХранилищеЗначения и Строка неограниченной длины (фиксирует их в
// ОбрезанныеПоля). Ссылочные значения → {ref, name}. Защищённые - пропускаются.
//
// АРХИТЕКТУРНОЕ РЕШЕНИЕ (TOOL-02, TD-01):
//   Здесь намеренно используется Ссылка.ПолучитьОбъект() вместо запроса или
//   ОбщегоНазначения.ЗначенияРеквизитовОбъекта(). Причина: tool read_object
//   работает с единственным объектом за вызов; набор запрошенных полей заранее
//   неизвестен (передаётся агентом динамически), поэтому построить оптимальный
//   точечный запрос на стороне платформы нецелесообразно. Объект, как правило,
//   уже в кэше сессии. Замена на запрос запланирована в TD-01.
//
// Параметр РежимCompliance (TOOL-16): при Истина значения полей маскируются
// через ar_Утилиты.ОчиститьЗначениеПоля. При Ложь — ветка не активируется,
// нулевое влияние на производительность.
// Параметр Статистика (PII-08): структура НоваяСтатистикаМаскирования() или
// Неопределено; пополняется через УчестьМаскирование при каждой замене.
Процедура ЗаполнитьПоляЗаголовка(Знач Ссылка, Знач МетаданныеОбъекта, Знач ЗапрошенныеПоля,
	Поля, ОбрезанныеПоля, Знач РежимCompliance = Ложь, Статистика = Неопределено)

	ИндексЗапрошенных = ИндексИменПолей(ЗапрошенныеПоля);
	ОбъектЗначение = Ссылка.ПолучитьОбъект();
	Если ОбъектЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// PII-04: полное имя объекта вычисляем один раз до цикла (используется
	// на каждой итерации для ar_Утилиты.ОчиститьЗначениеПоля при РежимCompliance).
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();

	Для Каждого РеквизитМД Из МетаданныеОбъекта.Реквизиты Цикл

		Если ИндексЗапрошенных.Количество() > 0
			И ИндексЗапрошенных.Получить(ВРег(РеквизитМД.Имя)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если РеквизитЗащищён(РеквизитМД) Тогда
			Продолжить;
		КонецЕсли;

		Если ТипРеквизитаИсключён(РеквизитМД.Тип) Тогда
			ОбрезанныеПоля.Добавить(РеквизитМД.Имя);
			Продолжить;
		КонецЕсли;

		Попытка
			Значение = ОбъектЗначение[РеквизитМД.Имя];
		Исключение
			Продолжить;
		КонецПопытки;

		ПредставлениеПоля = ПредставлениеЗначенияПоля(Значение);
		Если РежимCompliance Тогда
			ИсходноеПредставление = ПредставлениеПоля;
			ПредставлениеПоля = ar_Утилиты.ОчиститьЗначениеПоля(
				ПолноеИмяОбъекта, РеквизитМД.Имя, ПредставлениеПоля);
			УчестьМаскирование(Статистика, ПолноеИмяОбъекта, РеквизитМД.Имя,
				ИсходноеПредставление, ПредставлениеПоля);
		КонецЕсли;
		Поля.Вставить(РеквизитМД.Имя, ПредставлениеПоля);
	КонецЦикла;

КонецПроцедуры

// Подмешивает в Поля контактную информацию объекта (Email, Телефон, Адрес)
// через подсистему БСП "УправлениеКонтактнойИнформацией" (ROREF-02) - для
// конфигураций, где эти данные хранятся в подчинённом регистре сведений
// КонтактнаяИнформация, а не как прямой реквизит справочника/документа
// (whitelist в ЗаполнитьПоляЗаголовка их не видит по конструкции). Логика
// аналогична ar_ToolCRM.ПрочитатьКИЧерезБСП, но не привязана к контрагентам -
// применяется к любому объекту, для которого БСП вернёт непустую таблицу КИ.
//
// Best-effort: отсутствие подсистемы БСП, ошибка вызова или неожиданный
// формат результата — молча no-op, не влияет на остальные поля объекта.
// Заполняет только запрошенные виды КИ (если ЗапрошенныеПоля непуст) либо все
// три вида (если ЗапрошенныеПоля пуст, аналогично поведению для обычных полей).
//
// Параметры:
//  Ссылка          - произвольная ссылка объекта ИБ.
//  ЗапрошенныеПоля - Массив(Строка) - имена, запрошенные в fields (пустой = все).
//  Поля            - Структура - результат ЧтениеОбъекта.Поля, дополняется на месте.
//  РежимCompliance - Булево - TOOL-16, маскирование Телефон/Адрес при Истина
//                    (Email не маскируется — вне объёма PII-03, симметрично ar_ToolCRM).
//  ПолноеИмяОбъекта - Строка - для ar_Утилиты.ОчиститьЗначениеПоля (правила PII-01
//                    по объекту+полю). По умолчанию "" (правило по объекту не сработает,
//                    маскирование по паттерну имени поля работает независимо).
//
Процедура ДобавитьКонтактнуюИнформациюБСП(Знач Ссылка, Знач ЗапрошенныеПоля, Поля, Знач РежимCompliance,
		Знач ПолноеИмяОбъекта = "", Статистика = Неопределено)

	Если Метаданные.ОбщиеМодули.Найти("УправлениеКонтактнойИнформацией") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИндексЗапрошенных = ИндексИменПолей(ЗапрошенныеПоля);
	НужноПоле = Новый Соответствие;
	НужноПоле.Вставить("EMAIL", ИндексЗапрошенных.Количество() = 0 ИЛИ ИндексЗапрошенных.Получить("EMAIL") <> Неопределено);
	НужноПоле.Вставить("ТЕЛЕФОН", ИндексЗапрошенных.Количество() = 0 ИЛИ ИндексЗапрошенных.Получить("ТЕЛЕФОН") <> Неопределено);
	НужноПоле.Вставить("АДРЕС", ИндексЗапрошенных.Количество() = 0 ИЛИ ИндексЗапрошенных.Получить("АДРЕС") <> Неопределено);

	Если Не НужноПоле.Получить("EMAIL") И Не НужноПоле.Получить("ТЕЛЕФОН") И Не НужноПоле.Получить("АДРЕС") Тогда
		Возврат;
	КонецЕсли;

	// ВАЖНО: 4-й параметр ТолькоПредставление по умолчанию = Истина, и в этом
	// режиме БСП уходит в ветку обратной совместимости, которая без указанного
	// вида/типа КИ всегда возвращает "" (а не таблицу). Нужны все типы КИ,
	// поэтому тип не задаём, но ТолькоПредставление передаём как Ложь.
	Попытка
		ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Ссылка, Неопределено, Неопределено, Ложь);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(ТаблицаКИ) <> Тип("ТаблицаЗначений")
		ИЛИ ТаблицаКИ.Колонки.Найти("Тип") = Неопределено
		ИЛИ ТаблицаКИ.Колонки.Найти("Представление") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаКИ Из ТаблицаКИ Цикл
		Представление = СокрЛП(Строка(СтрокаКИ.Представление));
		Если ПустаяСтрока(Представление) Тогда
			Продолжить;
		КонецЕсли;
		// Пробелы убираем: представление перечисления - "Адрес электронной почты",
		// без этого подстрока "электроннойпочты" никогда не находится.
		ЗаполнитьОдноПолеКИ(СтрЗаменить(НРег(Строка(СтрокаКИ.Тип)), " ", ""), Представление, НужноПоле, Поля,
			РежимCompliance, ПолноеИмяОбъекта, Статистика);
	КонецЦикла;

КонецПроцедуры

// Определяет вид КИ по ИмяТипа (email/телефон/адрес) и, если поле ещё не
// заполнено и было запрошено, вставляет его в Поля. Правило "первое найденное"
// (Поля.Свойство(...) = Ложь) - как в ar_ToolCRM.ЗаполнитьПолеКИ.
Процедура ЗаполнитьОдноПолеКИ(Знач ИмяТипа, Знач Представление, Знач НужноПоле, Поля,
		Знач РежимCompliance, Знач ПолноеИмяОбъекта, Статистика = Неопределено)

	ЭтоEmail = (СтрНайти(ИмяТипа, "email") > 0 ИЛИ СтрНайти(ИмяТипа, "электроннойпочты") > 0);
	ЭтоТелефон = (СтрНайти(ИмяТипа, "телефон") > 0);
	ЭтоАдрес = (СтрНайти(ИмяТипа, "адрес") > 0);

	Если ЭтоEmail И НужноПоле.Получить("EMAIL") И Поля.Свойство("Email") = Ложь Тогда
		// Email вне объёма PII-03 (см. ar_ToolCRM) - без маскирования.
		Поля.Вставить("Email", Представление);
	ИначеЕсли ЭтоТелефон И НужноПоле.Получить("ТЕЛЕФОН") И Поля.Свойство("Телефон") = Ложь Тогда
		ЗначениеПоля = Представление;
		Если РежимCompliance Тогда
			ЗначениеПоля = ar_Утилиты.ОчиститьЗначениеПоля(ПолноеИмяОбъекта, "Телефон", Представление);
			УчестьМаскирование(Статистика, ПолноеИмяОбъекта, "Телефон", Представление, ЗначениеПоля);
		КонецЕсли;
		Поля.Вставить("Телефон", ЗначениеПоля);
	ИначеЕсли ЭтоАдрес И НужноПоле.Получить("АДРЕС") И Поля.Свойство("Адрес") = Ложь Тогда
		ЗначениеПоля = Представление;
		Если РежимCompliance Тогда
			ЗначениеПоля = ar_Утилиты.ОчиститьЗначениеПоля(ПолноеИмяОбъекта, "Адрес", Представление);
			УчестьМаскирование(Статистика, ПолноеИмяОбъекта, "Адрес", Представление, ЗначениеПоля);
		КонецЕсли;
		Поля.Вставить("Адрес", ЗначениеПоля);
	КонецЕсли;

КонецПроцедуры

// Заполняет структуру ТабличныеЧасти: не более 3 ТЧ, по 20 строк каждая.
//
// АРХИТЕКТУРНОЕ РЕШЕНИЕ (TOOL-02, TD-01):
//   Используется Ссылка.ПолучитьОбъект() - аналогично ЗаполнитьПоляЗаголовка.
//   Табличные части не поддаются запросной выборке в том же паттерне (разные
//   имена ТЧ динамически определяются агентом). Рефакторинг на запрос - TD-01.
//
// Параметр РежимCompliance (TOOL-16): при Истина значения полей строк ТЧ
// маскируются через ar_Утилиты.ОчиститьЗначениеПоля. При Ложь — без изменений.
// Параметр Статистика (PII-08): см. ЗаполнитьПоляЗаголовка.
Процедура ЗаполнитьТабличныеЧасти(Знач Ссылка, Знач МетаданныеОбъекта, ТабличныеЧасти,
	Знач РежимCompliance = Ложь, Статистика = Неопределено)

	ОбъектЗначение = Ссылка.ПолучитьОбъект();
	Если ОбъектЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МаксТЧ = 3;
	МаксСтрок = 20;
	СчётчикТЧ = 0;

	// PII-04 DoD D8: ИмяОбъекта для ar_Утилиты.ОчиститьЗначениеПоля -- полное имя
	// объекта-владельца ТЧ (МетаданныеОбъекта, не ТабЧастьМД) -- регистр
	// ar_ПравилаМаскированияПДн не содержит отдельного измерения для табличных
	// частей. Вычисляем один раз до цикла.
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();

	Для Каждого ТабЧастьМД Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Если СчётчикТЧ >= МаксТЧ Тогда
			Прервать;
		КонецЕсли;

		Строки = Новый Массив;
		ТабЧастьЗначение = ОбъектЗначение[ТабЧастьМД.Имя];
		СчётчикСтрок = 0;
		Для Каждого СтрокаТЧ Из ТабЧастьЗначение Цикл
			Если СчётчикСтрок >= МаксСтрок Тогда
				Прервать;
			КонецЕсли;
			СтрокаДанных = Новый Структура;
			Для Каждого РеквизитМД Из ТабЧастьМД.Реквизиты Цикл
				Если РеквизитЗащищён(РеквизитМД) ИЛИ ТипРеквизитаИсключён(РеквизитМД.Тип) Тогда
					Продолжить;
				КонецЕсли;
				ПредставлениеПоля = ПредставлениеЗначенияПоля(СтрокаТЧ[РеквизитМД.Имя]);
				Если РежимCompliance Тогда
					ИсходноеПредставление = ПредставлениеПоля;
					ПредставлениеПоля = ar_Утилиты.ОчиститьЗначениеПоля(
						ПолноеИмяОбъекта, РеквизитМД.Имя, ПредставлениеПоля);
					УчестьМаскирование(Статистика, ПолноеИмяОбъекта,
						ТабЧастьМД.Имя + "." + РеквизитМД.Имя,
						ИсходноеПредставление, ПредставлениеПоля);
				КонецЕсли;
				СтрокаДанных.Вставить(РеквизитМД.Имя, ПредставлениеПоля);
			КонецЦикла;
			Строки.Добавить(СтрокаДанных);
			СчётчикСтрок = СчётчикСтрок + 1;
		КонецЦикла;

		ТабличныеЧасти.Вставить(ТабЧастьМД.Имя, Строки);
		СчётчикТЧ = СчётчикТЧ + 1;
	КонецЦикла;

КонецПроцедуры

// PII-08: Новая структура-счётчик срабатываний маскирования одного вызова tool.
//
// Возвращаемое значение:
//   Структура:
//     Замаскировано - Число  - количество замен значений
//     Поля          - Массив - уникальные имена вида "Объект.Поле" (без значений)
//
Функция НоваяСтатистикаМаскирования()

	Статистика = Новый Структура;
	Статистика.Вставить("Замаскировано", 0);
	Статистика.Вставить("Поля", Новый Массив);
	Возврат Статистика;

КонецФункции

// PII-08: Учитывает одно применение ОчиститьЗначениеПоля: если результат
// отличается от исходного значения — инкремент счётчика и имя поля в список
// (только имя, без значения). При Статистика = Неопределено — no-op.
Процедура УчестьМаскирование(Статистика, Знач ИмяОбъекта, Знач ИмяПоля,
	Знач Исходное, Знач Маскированное)

	Если Статистика = Неопределено ИЛИ Маскированное = Исходное Тогда
		Возврат;
	КонецЕсли;

	Статистика.Замаскировано = Статистика.Замаскировано + 1;

	ПолноеИмя = ?(ЗначениеЗаполнено(ИмяОбъекта), Строка(ИмяОбъекта) + ".", "") + Строка(ИмяПоля);
	Если Статистика.Поля.Найти(ПолноеИмя) = Неопределено Тогда
		Статистика.Поля.Добавить(ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

// PII-08: Одна сводная запись в ar_СлужебныйЛог о срабатываниях маскирования
// за вызов tool. Пишется только при непустой статистике; в лог попадают
// счётчик и имена полей — значения не логируются. Ошибки записи не роняют tool.
Процедура ЛогироватьМаскирование(Знач ИмяTool, Знач Статистика, Знач Контекст)

	Если Статистика = Неопределено ИЛИ Статистика.Замаскировано = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		RunId = "";
		Если ТипЗнч(Контекст) = Тип("Структура") Тогда
			Контекст.Свойство("RunId", RunId);
		КонецЕсли;

		ar_СлужебныйЛог.Записать("ar_ToolUniversal." + ИмяTool, "pii_masked",
			СтрШаблон(НСтр("ru='Полей замаскировано: %1 (%2)';
			|en='Fields masked: %1 (%2)'"),
			Формат(Статистика.Замаскировано, "ЧГ="),
			СтрСоединить(Статистика.Поля, ", ")),
			"Информация", Строка(RunId));
	Исключение
		// Прозрачность не должна ломать работу tool -- ошибка только в ЖР.
		ЗаписьЖурналаРегистрации(НСтр("ru='ar_ToolUniversal'; en='ar_ToolUniversal'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Строит индекс имён полей (ВРег → Истина) для O(1)-проверки запрошенных полей.
Функция ИндексИменПолей(Знач Имена)
	Индекс = Новый Соответствие;
	Для Каждого Имя Из Имена Цикл
		Индекс.Вставить(ВРег(Имя), Истина);
	КонецЦикла;
	Возврат Индекс;
КонецФункции

// Истина, если реквизит помечен как защищённый (свойство есть не во всех
// версиях - при ошибке доступа считаем не защищённым).
Функция РеквизитЗащищён(Знач РеквизитМД)
	Попытка
		Возврат РеквизитМД.Защищенный;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Истина, если описание типа содержит ХранилищеЗначения или строку
// неограниченной длины (защита observation от переполнения).
Функция ТипРеквизитаИсключён(Знач ОписаниеТипов)

	Попытка
		Если ОписаниеТипов.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		// Тип ХранилищеЗначения недоступен в контексте - игнорируем.
		Возврат Ложь;
	КонецПопытки;

	// Строка неограниченной длины: квалификаторы строки с Длина = 0.
	Если ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		КвалификаторыСтроки = ОписаниеТипов.КвалификаторыСтроки;
		Если КвалификаторыСтроки <> Неопределено
			И КвалификаторыСтроки.Длина = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Преобразует значение реквизита в JSON-совместимое представление. Ссылочные
// значения сворачиваются в {ref, name} без рекурсии. Примитивы - как есть
// (дата → ISO-строка).
Функция ПредставлениеЗначенияПоля(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ar_Утилиты.ФорматДата(Значение);
	КонецЕсли;

	Если ЭтоСсылочноеЗначение(Значение) Тогда
		Свёрнутая = Новый Структура;
		Свёрнутая.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Значение));
		Свёрнутая.Вставить("name", Строка(Значение));
		Возврат Свёрнутая;
	КонецЕсли;

	// Перечисления, прочие - строковое представление.
	Возврат Строка(Значение);

КонецФункции

// Истина, если значение является ссылкой на объект ИБ (определяется через
// Метаданные.НайтиПоТипу). Не-объектные типы (число, дата, строка) → Ложь.
Функция ЭтоСсылочноеЗначение(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если МетаданныеЗначения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	// Перечисления - объекты метаданных, но не хранятся в БД: навигационную
	// ссылку по ним получить нельзя. Уходят ниже в ветку "строковое
	// представление" (см. вызывающий код).
	Возврат НЕ Метаданные.Перечисления.Содержит(МетаданныеЗначения);
КонецФункции

// Истина, если объект по ссылке помечен на удаление (без падения на ошибке).
Функция ОбъектПомеченНаУдаление(Знач Ссылка)
	Попытка
		Возврат Ссылка.ПометкаУдаления;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Преобразует русское полное имя метаданных в короткий "Type.Имя".
// "Справочник.Контрагенты" → "Catalog.Контрагенты".
Функция КороткийТипМетаданных(Знач ПолноеИмя)
	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() < 2 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат АнглийскийКлассМетаданных(Части[0]) + "." + Части[1];
КонецФункции

// Соответствие русского класса метаданных английскому (для type в observation).
Функция АнглийскийКлассМетаданных(Знач РусскийКласс)
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Справочник", "Catalog");
	Соответствие.Вставить("Документ", "Document");
	Соответствие.Вставить("РегистрСведений", "InformationRegister");
	Соответствие.Вставить("РегистрНакопления", "AccumulationRegister");
	Соответствие.Вставить("РегистрБухгалтерии", "AccountingRegister");
	Соответствие.Вставить("Перечисление", "Enum");
	Английский = Соответствие.Получить(РусскийКласс);
	Возврат ?(Английский = Неопределено, РусскийКласс, Английский);
КонецФункции

// Ограничивает observation read_object 50 KB: при превышении убирает ТЧ и
// помечает усечение.
Функция ОграничитьРазмерObservation(Знач Результат)

	JSON = ar_JSON.ВЗначениеJSON(Результат);
	Если СтрДлина(JSON) <= 50 * 1024 Тогда
		Возврат JSON;
	КонецЕсли;

	Результат.Вставить("tabular_sections", Новый Структура);
	Результат.Вставить("size_limited", Истина);
	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// get_recent_changes.

// Разбирает "<Тип>.<Имя>" в структуру {Категория, ПолноеИмя, Метаданные} для
// get_recent_changes. Допустимы только Справочники и Документы. Иначе → Неопределено.
Функция РазобратьТипОбъекта(Знач ТипОбъекта)

	Части = СтрРазделить(ТипОбъекта, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Класс = Части[0];
	Имя = Части[1];

	Если Класс = "Справочник" Тогда
		МД = Метаданные.Справочники.Найти(Имя);
		Если МД = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		// ПолноеИмя берётся из самого объекта метаданных (не конкатенацией строк),
		// что гарантирует: в текст запроса подставляется только проверенное имя
		// существующего объекта - исключает риск инъекции через object_type.
		Возврат Новый Структура("Категория, ПолноеИмя, Метаданные", "Справочник", МД.ПолноеИмя(), МД);
	ИначеЕсли Класс = "Документ" Тогда
		МД = Метаданные.Документы.Найти(Имя);
		Если МД = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Категория, ПолноеИмя, Метаданные", "Документ", МД.ПолноеИмя(), МД);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Истина, если справочник имеет реквизит ДатаИзменения (механизм отслеживания).
Функция СправочникОтслеживаетИзменения(Знач МД)
	Возврат МД.Реквизиты.Найти("ДатаИзменения") <> Неопределено;
КонецФункции

// Возвращает массив {ref, name, date} документов с Дата >= ДатаОт.
Функция ПолучитьИзменённыеДокументы(Знач ПолноеИмя, Знач ДатаОт, Знач Лимит)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	Т.Ссылка КАК Ссылка,
		|	Т.Дата КАК Дата
		|ИЗ
		|	" + ПолноеИмя + " КАК Т
		|ГДЕ
		|	Т.Дата >= &ДатаОт
		|УПОРЯДОЧИТЬ ПО
		|	Т.Дата УБЫВ";
	Запрос.УстановитьПараметр("ДатаОт", ДатаОт);

	Возврат СформироватьСписокИзменений(Запрос.Выполнить());

КонецФункции

// Возвращает массив {ref, name, date} справочников с ДатаИзменения >= ДатаОт,
// не помеченных на удаление.
Функция ПолучитьИзменённыеСправочники(Знач ПолноеИмя, Знач ДатаОт, Знач Лимит)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	Т.Ссылка КАК Ссылка,
		|	Т.ДатаИзменения КАК Дата
		|ИЗ
		|	" + ПолноеИмя + " КАК Т
		|ГДЕ
		|	Т.ДатаИзменения >= &ДатаОт
		|	И НЕ Т.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаИзменения УБЫВ";
	Запрос.УстановитьПараметр("ДатаОт", ДатаОт);

	Возврат СформироватьСписокИзменений(Запрос.Выполнить());

КонецФункции

// Превращает результат запроса (Ссылка, Дата) в массив {ref, name, date}.
Функция СформироватьСписокИзменений(Знач РезультатЗапроса)
	Элементы = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Ссылка));
		Элемент.Вставить("name", Строка(Выборка.Ссылка));
		Элемент.Вставить("date", ar_Утилиты.ФорматДата(Выборка.Дата));
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Элементы;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// query (универсальный построитель запросов).

// Нормализует лимит строк запроса: деф. 100, макс. 1000, <1 → 100. При
// превышении 1000 добавляет предупреждение limit_capped_to_1000.
Функция НормализоватьЛимитЗапроса(Знач Аргс, Предупреждения)
	Значение = Аргс.Получить("limit");
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 100;
	КонецЕсли;
	Цел = Цел(Значение);
	Если Цел < 1 Тогда
		Возврат 100;
	КонецЕсли;
	Если Цел > 1000 Тогда
		Предупреждения.Добавить("limit_capped_to_1000");
		Возврат 1000;
	КонецЕсли;
	Возврат Цел;
КонецФункции

// Валидирует источник "<Класс>.<Имя>" по метаданным целевой КФ. Допустимые
// классы: Справочник, Документ, РегистрСведений, РегистрНакопления.
//
// Возвращает Структуру {Категория, ПолноеИмя, Метаданные, ЭтоОбъектРасширения}
// или Неопределено, если источник не найден (в т.ч. не ровно 2 части - защита
// от инъекции вида "Справочник.Контрагенты.ИНН").
Функция ВалидироватьИсточникЗапроса(Знач Источник)

	Части = СтрРазделить(Источник, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Класс = Части[0];
	Имя = Части[1];

	Коллекция = КоллекцияДанныхПоКлассу(Класс);
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Учитываем переопределение имени объекта (ar_ПереопределенияОбъектов) -
	// та же логика, что и в ar_ToolCRM/ar_ToolDispatcher.ИмяОбъектаМетаданных,
	// т.к. в целевых конфигурациях имя объекта может отличаться от логического
	// (например "Контрагенты" -> "_ДемоКонтрагенты" в демо-конфигурации).
	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных(Имя, Имя);
	МД = Коллекция.Найти(ИмяРеальное);
	Если МД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Категория", Класс);
	Описание.Вставить("ПолноеИмя", МД.ПолноеИмя());
	Описание.Вставить("Метаданные", МД);
	Описание.Вставить("ЭтоОбъектРасширения", ИсточникРасширения(МД));
	Возврат Описание;

КонецФункции

// Возвращает коллекцию метаданных-данных по русскому классу источника query.
// Перечисления и прочие классы исключены (нет запрашиваемых данных).
Функция КоллекцияДанныхПоКлассу(Знач Класс)
	Если Класс = "Справочник" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Класс = "Документ" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Класс = "РегистрСведений" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли Класс = "РегистрНакопления" Тогда
		Возврат Метаданные.РегистрыНакопления;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Истина, если объект метаданных принадлежит расширению AgentRunner (имя начинается
// с префикса ar_) - такие источники недоступны для query (инкапсулированы ядром).
Функция ИсточникРасширения(Знач МД)
	Возврат Лев(ВРег(МД.Имя), 3) = "AR_";
КонецФункции

// Строит whitelist доступных полей источника (Соответствие ВРег(Имя) → Имя).
// Имя в значении - каноническое имя поля из метаданных (для текста запроса).
// Исключает ХранилищеЗначения и строки неограниченной длины.
//
// Параметры:
//  МетаданныеОбъекта - объект метаданных источника.
//  Категория         - Строка - "Справочник"/"Документ"/"РегистрСведений"/"РегистрНакопления".
Функция ПолучитьДоступныеПоля(Знач МетаданныеОбъекта, Знач Категория)

	Поля = Новый Соответствие;

	Если Категория = "Справочник" Тогда
		ДобавитьСтандартноеПоле(Поля, "Ссылка");
		ДобавитьСтандартноеПоле(Поля, "Код");
		ДобавитьСтандартноеПоле(Поля, "Наименование");
		ДобавитьСтандартноеПоле(Поля, "ПометкаУдаления");
		ДобавитьСтандартноеПоле(Поля, "Предопределенный");
		Если МетаданныеОбъекта.Иерархический Тогда
			ДобавитьСтандартноеПоле(Поля, "Родитель");
		КонецЕсли;
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Реквизиты);

	ИначеЕсли Категория = "Документ" Тогда
		ДобавитьСтандартноеПоле(Поля, "Ссылка");
		ДобавитьСтандартноеПоле(Поля, "Номер");
		ДобавитьСтандартноеПоле(Поля, "Дата");
		ДобавитьСтандартноеПоле(Поля, "Проведен");
		ДобавитьСтандартноеПоле(Поля, "ПометкаУдаления");
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Реквизиты);

	ИначеЕсли Категория = "РегистрСведений" Тогда
		Если РегистрСведенийПериодический(МетаданныеОбъекта) Тогда
			ДобавитьСтандартноеПоле(Поля, "Период");
		КонецЕсли;
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Измерения);
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Ресурсы);
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Реквизиты);

	ИначеЕсли Категория = "РегистрНакопления" Тогда
		ДобавитьСтандартноеПоле(Поля, "Период");
		ДобавитьСтандартноеПоле(Поля, "Регистратор");
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Измерения);
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Ресурсы);
		ДобавитьРеквизитыВWhitelist(Поля, МетаданныеОбъекта.Реквизиты);
	КонецЕсли;

	Возврат Поля;

КонецФункции

// Добавляет стандартное поле в whitelist (ВРег → каноническое имя).
Процедура ДобавитьСтандартноеПоле(Поля, Знач Имя)
	Поля.Вставить(ВРег(Имя), Имя);
КонецПроцедуры

// Добавляет реквизиты коллекции метаданных в whitelist, исключая
// ХранилищеЗначения и строки неограниченной длины.
Процедура ДобавитьРеквизитыВWhitelist(Поля, Знач КоллекцияРеквизитов)
	Для Каждого РеквизитМД Из КоллекцияРеквизитов Цикл
		Если ТипРеквизитаИсключён(РеквизитМД.Тип) Тогда
			Продолжить;
		КонецЕсли;
		Поля.Вставить(ВРег(РеквизитМД.Имя), РеквизитМД.Имя);
	КонецЦикла;
КонецПроцедуры

// Истина, если регистр сведений периодический (есть поле Период).
Функция РегистрСведенийПериодический(Знач МД)
	Попытка
		Возврат МД.ПериодичностьРегистраСведений
			<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Отбирает поля для выборки: если ЗапрошенныеПоля непусты - пересечение с
// whitelist (несуществующие игнорируются с предупреждением); иначе весь
// whitelist. Возвращает Массив канонических имён полей.
Функция ОтобратьПоляЗапроса(Знач ЗапрошенныеПоля, Знач ДоступныеПоля, Предупреждения)

	Если ЗапрошенныеПоля.Количество() = 0 Тогда
		Возврат ЗначенияWhitelist(ДоступныеПоля);
	КонецЕсли;

	Отобранные = Новый Массив;
	Для Каждого Имя Из ЗапрошенныеПоля Цикл
		Каноническое = ДоступныеПоля.Получить(ВРег(ОчищенноеИмяПоля(Имя)));
		Если Каноническое = Неопределено Тогда
			Предупреждения.Добавить("field_ignored: " + Имя);
			Продолжить;
		КонецЕсли;
		Отобранные.Добавить(Каноническое);
	КонецЦикла;

	Если Отобранные.Количество() = 0 Тогда
		Предупреждения.Добавить("all_fields_ignored_using_defaults");
		Возврат ЗначенияWhitelist(ДоступныеПоля);
	КонецЕсли;

	Возврат Отобранные;

КонецФункции

// Убирает обрамляющие кавычки («ИНН», "ИНН", 'ИНН') из имени поля - LLM
// нередко цитирует имена полей типографскими кавычками, whitelist их не содержит.
Функция ОчищенноеИмяПоля(Знач Имя)

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Имя = СокрЛП(Имя);
	Кавычки = "«»""'";

	Пока СтрДлина(Имя) > 0 И СтрНайти(Кавычки, Лев(Имя, 1)) > 0 Цикл
		Имя = Сред(Имя, 2);
	КонецЦикла;
	Пока СтрДлина(Имя) > 0 И СтрНайти(Кавычки, Прав(Имя, 1)) > 0 Цикл
		Имя = Лев(Имя, СтрДлина(Имя) - 1);
	КонецЦикла;

	Возврат СокрЛП(Имя);

КонецФункции

// Возвращает массив канонических имён полей из whitelist-соответствия.
Функция ЗначенияWhitelist(Знач ДоступныеПоля)
	Имена = Новый Массив;
	Для Каждого КлючИЗначение Из ДоступныеПоля Цикл
		Имена.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Преобразует фильтры (Соответствие) в массив условий текста запроса
// "Т.<Поле> <оператор> &П_<Поле>", устанавливая параметры в Запрос. Имена полей
// берутся только из whitelist; значения - только через УстановитьПараметр.
// Невалидные фильтры пропускаются с предупреждением filter_ignored.
//
// Для ссылочных полей (Ссылка, Контрагент, Родитель, Регистратор и т.п.)
// строковое значение фильтра (навигационная ссылка или UUID) разыменовывается
// в реальную ссылку перед установкой параметра - иначе сравнение ссылочного
// реквизита со Строкой в 1С молча не находит совпадений (не ошибка типов,
// а всегда пустой результат).
//
// Возвращает Массив строк-условий (может быть пустым → блок ГДЕ не добавляется).
Функция СобратьУсловияЗапроса(Запрос, Знач Фильтры, Знач ДоступныеПоля, Знач ОписаниеИсточника, Предупреждения)

	Условия = Новый Массив;
	ИндексПараметра = 0;
	ОбработаноФильтров = 0;
	МаксФильтров = 20;

	Для Каждого КлючИЗначение Из Фильтры Цикл

		Если ОбработаноФильтров >= МаксФильтров Тогда
			Предупреждения.Добавить("filters_limit_exceeded_first_20_used");
			Прервать;
		КонецЕсли;
		ОбработаноФильтров = ОбработаноФильтров + 1;

		ИмяПоля = КлючИЗначение.Ключ;
		Каноническое = ДоступныеПоля.Получить(ВРег(ОчищенноеИмяПоля(ИмяПоля)));
		Если Каноническое = Неопределено Тогда
			ДобавитьПредупреждениеФильтра(Предупреждения, ИмяПоля);
			Продолжить;
		КонецЕсли;

		ОписаниеФильтра = РазобратьФильтр(КлючИЗначение.Значение);
		Если ОписаниеФильтра = Неопределено Тогда
			ДобавитьПредупреждениеФильтра(Предупреждения, ИмяПоля);
			Продолжить;
		КонецЕсли;

		Если НЕ ФильтрПоСсылкеРазрешён(ОписаниеФильтра, ОписаниеИсточника, Каноническое) Тогда
			ДобавитьПредупреждениеФильтра(Предупреждения, ИмяПоля + " (unresolved reference)");
			Продолжить;
		КонецЕсли;

		Если НЕ ФильтрПоДатеПриведён(ОписаниеФильтра, ОписаниеИсточника, Каноническое) Тогда
			ДобавитьПредупреждениеФильтра(Предупреждения, ИмяПоля + " (invalid date)");
			Продолжить;
		КонецЕсли;

		ИмяПараметра = "П_" + Формат(ИндексПараметра, "ЧГ=0");
		Условие = УсловиеФильтра(Каноническое, ОписаниеФильтра, ИмяПараметра);
		Если Условие = Неопределено Тогда
			ДобавитьПредупреждениеФильтра(Предупреждения, ИмяПоля);
			Продолжить;
		КонецЕсли;

		Запрос.УстановитьПараметр(ИмяПараметра, ОписаниеФильтра.Значение);
		Условия.Добавить(Условие);
		ИндексПараметра = ИндексПараметра + 1;

	КонецЦикла;

	Возврат Условия;

КонецФункции

// Для фильтров eq/in по ссылочному полю разыменовывает строковое(ые) значение(я)
// ОписаниеФильтра.Значение в реальную ссылку (изменяет структуру на месте).
// Поля, не являющиеся однозначно ссылочными, и прочие операторы (like/gt/...)
// пропускаются без изменений - Истина. Ложь означает, что ссылочное значение
// не удалось разрешить и фильтр должен быть отброшен вызывающим кодом (иначе
// сравнение ссылки со Строкой в 1С молча не найдёт совпадений).
Функция ФильтрПоСсылкеРазрешён(ОписаниеФильтра, Знач ОписаниеИсточника, Знач Каноническое)

	Если ОписаниеФильтра.Оператор <> "eq" И ОписаниеФильтра.Оператор <> "in" Тогда
		Возврат Истина;
	КонецЕсли;

	ТипСсылкиПоля = ЕдинственныйСсылочныйТипПоля(ОписаниеИсточника, Каноническое);
	Если ТипСсылкиПоля = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат РазыменоватьЗначенияФильтра(ОписаниеФильтра, ТипСсылкиПоля);

КонецФункции

// Определяет единственный ссылочный тип канонического поля источника (для
// операторов eq/in поверх ссылочных реквизитов). Составные (несколько
// типов) и примитивные поля → Неопределено (фильтр обрабатывается как раньше,
// без разыменования - до расширения функциональности достаточно для
// подавляющего большинства реквизитов вида "Контрагент", "Ссылка", "Родитель").
//
// Параметры:
//  ОписаниеИсточника - Структура - {Категория, ПолноеИмя, Метаданные}.
//  Каноническое      - Строка    - имя поля в тексте запроса ("Контрагент", "Ссылка"...).
//
// Возвращаемое значение:
//  Тип - единственный ссылочный тип поля, либо Неопределено.
Функция ЕдинственныйСсылочныйТипПоля(Знач ОписаниеИсточника, Знач Каноническое)

	МД = ОписаниеИсточника.Метаданные;

	Если Каноническое = "Ссылка" ИЛИ Каноническое = "Родитель" Тогда
		Возврат ТипЗнч(МД.ПустаяСсылка());
	КонецЕсли;

	Если Каноническое = "Регистратор" Тогда
		// Регистратор регистра накопления - составной тип (все документы-регистраторы);
		// однозначно определить нельзя без указания object_type - не разыменовываем.
		Возврат Неопределено;
	КонецЕсли;

	РеквизитМД = МД.Реквизиты.Найти(Каноническое);
	Если РеквизитМД = Неопределено Тогда
		// Измерение регистра.
		Попытка
			РеквизитМД = МД.Измерения.Найти(Каноническое);
		Исключение
			РеквизитМД = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если РеквизитМД = Неопределено Тогда
		// Ресурс регистра.
		Попытка
			РеквизитМД = МД.Ресурсы.Найти(Каноническое);
		Исключение
			РеквизитМД = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если РеквизитМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОписаниеТипов = РеквизитМД.Тип;
	Если ОписаниеТипов.Типы().Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЭлемент = ОписаниеТипов.Типы()[0];
	Если Метаданные.НайтиПоТипу(ТипЭлемент) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ТипЭлемент;

КонецФункции

// Для фильтров eq/gt/lt/gte/lte/in по полю типа Дата приводит строковое(ые)
// значение(я) фильтра (ISO 8601 из JSON) к типу Дата (изменяет структуру на
// месте) - иначе сравнение реквизита типа Дата со Строкой в 1С падает с
// ошибкой приведения типов при выполнении запроса. Поля, не являющиеся
// однозначно Дата, и уже приведённые значения пропускаются без изменений -
// Истина. Ложь означает, что строку не удалось разобрать как дату, и фильтр
// должен быть отброшен вызывающим кодом.
Функция ФильтрПоДатеПриведён(ОписаниеФильтра, Знач ОписаниеИсточника, Знач Каноническое)

	Если НЕ ПолеТипаДата(ОписаниеИсточника, Каноническое) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ОписаниеФильтра.Оператор = "in" Тогда
		Приведённые = Новый Массив;
		Для Каждого Элемент Из ОписаниеФильтра.Значение Цикл
			Приведённое = ПривестиЗначениеФильтраКДате(Элемент);
			Если Приведённое <> Неопределено Тогда
				Приведённые.Добавить(Приведённое);
			КонецЕсли;
		КонецЦикла;
		Если Приведённые.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		ОписаниеФильтра.Значение = Приведённые;
		Возврат Истина;
	КонецЕсли;

	Приведённое = ПривестиЗначениеФильтраКДате(ОписаниеФильтра.Значение);
	Если Приведённое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОписаниеФильтра.Значение = Приведённое;
	Возврат Истина;

КонецФункции

// Истина, если каноническое поле источника типизировано единственным типом Дата.
Функция ПолеТипаДата(Знач ОписаниеИсточника, Знач Каноническое)

	МД = ОписаниеИсточника.Метаданные;

	РеквизитМД = МД.Реквизиты.Найти(Каноническое);
	Если РеквизитМД = Неопределено Тогда
		Попытка
			РеквизитМД = МД.Измерения.Найти(Каноническое);
		Исключение
			РеквизитМД = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если РеквизитМД = Неопределено Тогда
		Попытка
			РеквизитМД = МД.Ресурсы.Найти(Каноническое);
		Исключение
			РеквизитМД = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если РеквизитМД = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ОписаниеТипов = РеквизитМД.Тип;
	Возврат ОписаниеТипов.Типы().Количество() = 1
		И ОписаниеТипов.Типы()[0] = Тип("Дата");

КонецФункции

// Приводит одно значение фильтра к типу Дата. Значение, уже являющееся Датой,
// возвращается как есть. Строка разбирается через ar_Утилиты.ДатаИзСтроки;
// неразбираемая строка либо значение иного типа → Неопределено.
Функция ПривестиЗначениеФильтраКДате(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ar_Утилиты.ДатаИзСтроки(Значение);

КонецФункции

// Разыменовывает значение(я) фильтра (Строка → ссылка на объект ИБ) для
// ссылочного поля. Изменяет ОписаниеФильтра.Значение на месте. Для оператора
// "in" разыменовывает каждый элемент массива, пропуская неразрешённые
// значения. Значения, уже являющиеся ссылкой нужного типа (не Строка),
// пропускаются без изменений.
//
// Возвращает Ложь, если после разыменования не осталось ни одного валидного
// значения (фильтр не может быть применён и должен быть отброшен вызывающим
// кодом - иначе появляется риск молчаливого "документы не найдены").
Функция РазыменоватьЗначенияФильтра(ОписаниеФильтра, Знач ТипСсылки)

	Если ОписаниеФильтра.Оператор = "in" Тогда
		Разыменованные = Новый Массив;
		Для Каждого Элемент Из ОписаниеФильтра.Значение Цикл
			Разыменованное = РазыменоватьОдноЗначениеФильтра(Элемент, ТипСсылки);
			Если Разыменованное <> Неопределено Тогда
				Разыменованные.Добавить(Разыменованное);
			КонецЕсли;
		КонецЦикла;
		Если Разыменованные.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		ОписаниеФильтра.Значение = Разыменованные;
		Возврат Истина;
	КонецЕсли;

	// eq.
	Разыменованное = РазыменоватьОдноЗначениеФильтра(ОписаниеФильтра.Значение, ТипСсылки);
	Если Разыменованное = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОписаниеФильтра.Значение = Разыменованное;
	Возврат Истина;

КонецФункции

// Разыменовывает одно значение фильтра в ссылку заданного типа. Не-строковые
// значения возвращаются как есть (совместимость с уже корректными вызовами).
// Строка, которую не удалось разрешить в ссылку - Неопределено (фильтр
// отбрасывается, а не молча сравнивается со Строкой).
Функция РазыменоватьОдноЗначениеФильтра(Знач Значение, Знач ТипСсылки)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	ОписаниеМД = Метаданные.НайтиПоТипу(ТипСсылки);
	Если ОписаниеМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РазыменоватьСсылку(Значение, ОписаниеМД.ПолноеИмя());

КонецФункции

// Добавляет в массив предупреждений признак пропуска фильтра по имени поля.
Процедура ДобавитьПредупреждениеФильтра(Предупреждения, Знач ИмяПоля)
	Предупреждения.Добавить("filter_ignored: " + ИмяПоля);
КонецПроцедуры

// Разбирает значение фильтра в Структуру {Оператор, Значение}. Допустимые
// формы: примитив (eq) либо объект {op, val}. Невалидные → Неопределено.
Функция РазобратьФильтр(Знач СырыеДанные)

	Если ТипЗнч(СырыеДанные) = Тип("Соответствие") Тогда
		Оператор = СырыеДанные.Получить("op");
		Значение = СырыеДанные.Получить("val");
		Если ТипЗнч(Оператор) <> Тип("Строка") Тогда
			Возврат Неопределено;
		КонецЕсли;
		Оператор = НРег(СокрЛП(Оператор));
		Если НЕ ОператорДопустим(Оператор) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Оператор, Значение", Оператор, Значение);
	КонецЕсли;

	// Примитив → eq.
	Если ЗначениеФильтраПримитив(СырыеДанные) Тогда
		Возврат Новый Структура("Оператор, Значение", "eq", СырыеДанные);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Истина для допустимого оператора фильтра.
Функция ОператорДопустим(Знач Оператор)
	Операторы = "eq,gt,lt,gte,lte,like,in";
	Возврат СтрНайти("," + Операторы + ",", "," + Оператор + ",") > 0;
КонецФункции

// Истина, если значение - JSON-примитив (строка/число/булево/дата) либо Null.
Функция ЗначениеФильтраПримитив(Знач Значение)
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата");
КонецФункции

// Строит условие текста запроса для одного фильтра и нормализует его значение
// (в т.ч. конвертирует ссылочные строки и like-шаблоны). Имя поля берётся из
// whitelist (Каноническое), значение уйдёт параметром. Невалидное → Неопределено.
Функция УсловиеФильтра(Знач Каноническое, ОписаниеФильтра, Знач ИмяПараметра)

	Оператор = ОписаниеФильтра.Оператор;
	Значение = ОписаниеФильтра.Значение;

	Если Оператор = "in" Тогда
		Если ТипЗнч(Значение) <> Тип("Массив") ИЛИ Значение.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		ОписаниеФильтра.Значение = НормализоватьМассивЗначений(Значение);
		Если ОписаниеФильтра.Значение.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат "Т." + Каноническое + " В (&" + ИмяПараметра + ")";
	КонецЕсли;

	Если Оператор = "like" Тогда
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Возврат Неопределено;
		КонецЕсли;
		ОписаниеФильтра.Значение = СтрЗаменить(Значение, "*", "%");
		Возврат "Т." + Каноническое + " ПОДОБНО &" + ИмяПараметра;
	КонецЕсли;

	// Скалярные операторы сравнения.
	Если НЕ ЗначениеФильтраПримитив(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗнакСравнения = ЗнакОператора(Оператор);
	Если ЗнакСравнения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат "Т." + Каноническое + " " + ЗнакСравнения + " &" + ИмяПараметра;

КонецФункции

// Возвращает символ сравнения 1С для скалярного оператора фильтра.
Функция ЗнакОператора(Знач Оператор)
	Если Оператор = "eq" Тогда
		Возврат "=";
	ИначеЕсли Оператор = "gt" Тогда
		Возврат ">";
	ИначеЕсли Оператор = "lt" Тогда
		Возврат "<";
	ИначеЕсли Оператор = "gte" Тогда
		Возврат ">=";
	ИначеЕсли Оператор = "lte" Тогда
		Возврат "<=";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Оставляет в массиве значений фильтра in только примитивы, не более 100 элементов.
Функция НормализоватьМассивЗначений(Знач Исходный)
	Результат = Новый Массив;
	Для Каждого Элемент Из Исходный Цикл
		Если Результат.Количество() >= 100 Тогда
			Прервать;
		КонецЕсли;
		Если ЗначениеФильтраПримитив(Элемент) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Собирает безопасный текст запроса. Источник - только МД.ПолноеИмя(); список
// полей и условия - из whitelist/параметров. Блок ГДЕ опускается, если условий нет.
// ПРОПУСТИТЬ добавляется только при Offset > 0 (хотя ПРОПУСТИТЬ 0 в 1С корректно,
// явное добавление только при необходимости делает запрос чище в логах).
//
// Параметры:
//  ОписаниеИсточника - Структура - {Категория, ПолноеИмя, Метаданные}.
//  ПоляЗапроса       - Массив    - канонические имена полей.
//  Условия           - Массив    - строки условий WHERE.
//  Лимит             - Число     - максимальное количество строк (ПЕРВЫЕ N).
//  Offset            - Число     - смещение (ПРОПУСТИТЬ M).
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаДанных(Знач ОписаниеИсточника, Знач ПоляЗапроса, Знач Условия, Знач Лимит, Знач Offset = 0)

	СписокПолей = Новый Массив;
	Для Каждого Поле Из ПоляЗапроса Цикл
		СписокПолей.Добавить("	Т." + Поле + " КАК " + Поле);
	КонецЦикла;

	ВыборкаЗаголовок = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0");
	Если Offset > 0 Тогда
		ВыборкаЗаголовок = ВыборкаЗаголовок + " ПРОПУСТИТЬ " + Формат(Offset, "ЧГ=0");
	КонецЕсли;

	Текст = ВыборкаЗаголовок + Символы.ПС
		+ СтрСоединить(СписокПолей, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	" + ОписаниеИсточника.ПолноеИмя + " КАК Т" + Символы.ПС;

	Если Условия.Количество() > 0 Тогда
		Текст = Текст + "ГДЕ" + Символы.ПС + "	" + СтрСоединить(Условия, Символы.ПС + "	И ") + Символы.ПС;
	КонецЕсли;

	Текст = Текст + ВыражениеСортировки(ОписаниеИсточника.Категория);
	Возврат Текст;

КонецФункции

// Выполняет запрос КОЛИЧЕСТВО(*) к тому же источнику с теми же условиями, что и
// основной запрос данных. Используется для определения next_offset.
// Два запроса выполняются в рамках одного объекта Запрос (параметры уже установлены).
// Параметр Запрос передаётся по ссылке намеренно: устанавливается Запрос.Текст,
// используются ранее установленные параметры фильтра.
//
// Параметры:
//  ОписаниеИсточника - Структура - {ПолноеИмя, Категория, Метаданные}.
//  Условия           - Массив    - массив строк условий WHERE.
//  Запрос            - Запрос    - объект запроса с параметрами фильтра (in/out).
//
// Возвращаемое значение:
//  Число - общее количество записей, соответствующих условиям (без ПЕРВЫЕ/ПРОПУСТИТЬ).
//
Функция ВыполнитьЗапросКоличества(Знач ОписаниеИсточника, Знач Условия, Запрос)
	Попытка
		ТекстCount = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество" + Символы.ПС
			+ "ИЗ" + Символы.ПС
			+ "	" + ОписаниеИсточника.ПолноеИмя + " КАК Т";
		Если Условия.Количество() > 0 Тогда
			ТекстCount = ТекстCount + Символы.ПС + "ГДЕ" + Символы.ПС
				+ "	" + СтрСоединить(Условия, Символы.ПС + "	И ");
		КонецЕсли;
		Запрос.Текст = ТекстCount;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Количество;
		КонецЕсли;
		// COUNT-запрос выполнен, но выборка пуста - значит 0 записей.
		Возврат 0;
	Исключение
		// При ошибке COUNT-запроса (например, источник без поддержки COUNT)
		// возвращаем -1: СериализоватьРезультатЗапроса выставит next_offset
		// на основе фактически полученного количества строк.
		Возврат -1;
	КонецПопытки;
КонецФункции

// Возвращает блок УПОРЯДОЧИТЬ ПО: по Ссылке для ссылочных объектов, по Период УБЫВ
// для регистров.
Функция ВыражениеСортировки(Знач Категория)
	Если Категория = "Справочник" ИЛИ Категория = "Документ" Тогда
		Возврат "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "	Т.Ссылка";
	КонецЕсли;
	Возврат "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "	Т.Период УБЫВ";
КонецФункции

// Обходит результат запроса и формирует observation. Каждая строка → Структура
// с JSON-совместимыми значениями (ссылки → {ref,name}). Суммарный размер
// ограничен 100 KB (truncated:true при достижении).
//
// Параметры:
//  РезультатЗапроса - РезультатЗапроса - выполненный запрос данных.
//  ПоляЗапроса      - Массив           - канонические имена полей.
//  Источник         - Строка           - имя источника (для поля source), как
//                                        передано агентом (может отличаться по
//                                        регистру от канонического МД.ПолноеИмя()).
//  Лимит            - Число            - запрошенный лимит строк.
//  Offset           - Число            - смещение текущей страницы.
//  ВсегоЗаписей     - Число            - полное кол-во записей из COUNT-запроса;
//                                        -1 если COUNT недоступен.
//  Предупреждения   - Массив           - накопленные предупреждения.
//  РежимCompliance  - Булево           - при Истина значения полей маскируются
//                                        через ar_Утилиты.ОчиститьЗначениеПоля
//                                        (TOOL-16, PII-04). По умолчанию Ложь.
//  ИмяОбъекта       - Строка           - PII-04: каноническое полное имя источника
//                                        (ОписаниеИсточника.ПолноеИмя = МД.ПолноеИмя()),
//                                        для правил PII-01 -- НЕ сырая строка агента
//                                        Источник/"source" (DoD D7). Отдельный параметр
//                                        от Источник намеренно: Источник участвует в
//                                        поле "source" итогового JSON и не должен менять
//                                        смысл/контракт ответа.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция СериализоватьРезультатЗапроса(Знач РезультатЗапроса, Знач ПоляЗапроса,
	Знач Источник, Знач Лимит, Знач Offset, Знач ВсегоЗаписей, Знач Предупреждения,
	Знач РежимCompliance = Ложь, Знач ИмяОбъекта = Неопределено, Статистика = Неопределено)

	Элементы = Новый Массив;
	УсеченоПоРазмеру = Ложь;
	НакопленныйРазмер = 0;
	МаксРазмер = 100 * 1024;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Для Каждого Поле Из ПоляЗапроса Цикл
			ПредставлениеПоля = ПредставлениеЗначенияПоля(Выборка[Поле]);
			Если РежимCompliance Тогда
				ИсходноеПредставление = ПредставлениеПоля;
				ПредставлениеПоля = ar_Утилиты.ОчиститьЗначениеПоля(ИмяОбъекта, Поле, ПредставлениеПоля);
				УчестьМаскирование(Статистика, ИмяОбъекта, Поле,
					ИсходноеПредставление, ПредставлениеПоля);
			КонецЕсли;
			Строка.Вставить(Поле, ПредставлениеПоля);
		КонецЦикла;

		РазмерСтроки = СтрДлина(ar_JSON.ВЗначениеJSON(Строка));
		Если Элементы.Количество() > 0 И НакопленныйРазмер + РазмерСтроки > МаксРазмер Тогда
			УсеченоПоРазмеру = Истина;
			Прервать;
		КонецЕсли;

		Элементы.Добавить(Строка);
		НакопленныйРазмер = НакопленныйРазмер + РазмерСтроки;
	КонецЦикла;

	// Вычисляем next_offset: если ВсегоЗаписей известно - точно;
	// если COUNT недоступен (-1) - эвристика: продолжение есть если получено ровно Лимит строк
	// (может ошибиться на последней странице, но безопасна: лишний вызов вернёт пустой items).
	ПолученоЭлементов = Элементы.Количество();
	NextOffset = Неопределено;
	Если ВсегоЗаписей >= 0 Тогда
		// Точный расчёт через COUNT.
		ЕстьПродолжение = (Offset + ПолученоЭлементов) < ВсегоЗаписей;
		Если ЕстьПродолжение Тогда
			NextOffset = Offset + ПолученоЭлементов;
		КонецЕсли;
	ИначеЕсли НЕ УсеченоПоРазмеру И ПолученоЭлементов >= Лимит Тогда
		// Эвристика без COUNT: если получили ровно лимит - вероятно, есть ещё.
		NextOffset = Offset + ПолученоЭлементов;
	Иначе
		// COUNT недоступен и получено меньше лимита - next_offset остаётся Неопределено.
		NextOffset = Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("source", Источник);
	Результат.Вставить("items", Элементы);
	Результат.Вставить("count", ПолученоЭлементов);
	Результат.Вставить("limit", Лимит);
	Результат.Вставить("offset", Offset);
	Результат.Вставить("next_offset", NextOffset);
	Результат.Вставить("truncated", УсеченоПоРазмеру);
	Результат.Вставить("warnings", Предупреждения);
	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// observation неизвестного источника query с подсказкой.
Функция ОшибкаНеизвестногоИсточника()
	Объект = Новый Структура;
	Объект.Вставить("error", "unknown_source");
	Объект.Вставить("hint", "Use search_metadata to find available objects");
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// observation ошибки выполнения запроса query с очищенным для LLM текстом.
Функция ОшибкаВыполненияЗапроса(Знач ИнфоОбОшибке)
	ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнфоОбОшибке));
	Объект = Новый Структура;
	Объект.Вставить("error", "query_execution_error");
	Объект.Вставить("detail", ТекстОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// get_functional_options / get_constants (UNIV-07).

// Добавляет предупреждение "<Префикс>: <Имя>" в Предупреждения для каждого
// запрошенного имени, отсутствующего среди Кандидаты (Массив объектов метаданных
// со свойством Имя). No-op, если ЗапрошенныеИмена пуст (фильтр по имени не
// применялся). Общая логика для get_functional_options и get_constants.
Процедура ПроверитьНайденныеИменаМД(Знач ЗапрошенныеИмена, Знач Кандидаты, Предупреждения, Знач Префикс)

	Если ЗапрошенныеИмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЗапрошенноеИмя Из ЗапрошенныеИмена Цикл
		Найдено = Ложь;
		Для Каждого МД Из Кандидаты Цикл
			Если ВРег(МД.Имя) = ВРег(ЗапрошенноеИмя) Тогда
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдено Тогда
			Предупреждения.Добавить(Префикс + ": " + ЗапрошенноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// aggregate (UNIV-07).

// Лимит групп aggregate: параметр "limit" из аргументов, дефолт 100, потолок
// 500 (ниже, чем у query - 1000, каждая строка группировки дороже вычислительно,
// UNIV-07 спека раздел (a), п.7).
Функция НормализоватьЛимитАгрегатов(Знач Аргс, Предупреждения)
	Значение = Аргс.Получить("limit");
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 100;
	КонецЕсли;
	Цел = Цел(Значение);
	Если Цел < 1 Тогда
		Возврат 100;
	КонецЕсли;
	Если Цел > 500 Тогда
		Предупреждения.Добавить("limit_capped_to_500");
		Возврат 500;
	КонецЕсли;
	Возврат Цел;
КонецФункции

// Фиксированное соответствие имени функции агрегации (англ. и рус. синонимы) ->
// ключевое слово языка запросов 1С. Захардкожено намеренно - не расширяется без
// правки кода (UNIV-07 спека раздел (a), п.4).
Функция СоответствиеФункцийАгрегации()
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("SUM", "СУММА");
	Соответствие.Вставить("СУММА", "СУММА");
	Соответствие.Вставить("COUNT", "КОЛИЧЕСТВО");
	Соответствие.Вставить("КОЛИЧЕСТВО", "КОЛИЧЕСТВО");
	Соответствие.Вставить("MIN", "МИНИМУМ");
	Соответствие.Вставить("МИНИМУМ", "МИНИМУМ");
	Соответствие.Вставить("MAX", "МАКСИМУМ");
	Соответствие.Вставить("МАКСИМУМ", "МАКСИМУМ");
	Соответствие.Вставить("AVG", "СРЕДНЕЕ");
	Соответствие.Вставить("СРЕДНЕЕ", "СРЕДНЕЕ");
	Возврат Соответствие;
КонецФункции

// Разбирает и валидирует массив aggregates[] аргументов tool aggregate.
// Каждый элемент {"func":...,"field":...,"as":...(опц.)}: func маппится через
// СоответствиеФункцийАгрегации (whitelist), field - через whitelist ДоступныеПоля
// (тот же путь, что и в ОтобратьПоляЗапроса). Невалидные элементы отбрасываются
// с warnings "aggregate_ignored: <func>", а не ошибкой (graceful degradation,
// UNIV-07 спека раздел (a), п.4).
//
// Возвращаемое значение:
//  Массив - структур {ФункцияЗапроса, ПолеКанонич, Алиас}.
//
Функция РазобратьАгрегаты(Знач МассивАгрегатов, Знач ДоступныеПоля, Предупреждения)

	СоответствиеФункций = СоответствиеФункцийАгрегации();
	ИспользованныеАлиасы = Новый Соответствие;
	Результат = Новый Массив;

	Для Каждого ЭлементАгрегата Из МассивАгрегатов Цикл

		Если ТипЗнч(ЭлементАгрегата) <> Тип("Соответствие") Тогда
			Предупреждения.Добавить("aggregate_ignored: invalid_item");
			Продолжить;
		КонецЕсли;

		СыраяФункция = ЭлементАгрегата.Получить("func");
		Если ТипЗнч(СыраяФункция) <> Тип("Строка") Тогда
			Предупреждения.Добавить("aggregate_ignored: func_missing");
			Продолжить;
		КонецЕсли;

		ФункцияЗапроса = СоответствиеФункций.Получить(ВРег(СокрЛП(СыраяФункция)));
		Если ФункцияЗапроса = Неопределено Тогда
			Предупреждения.Добавить("aggregate_ignored: " + СыраяФункция);
			Продолжить;
		КонецЕсли;

		СыроеПоле = ЭлементАгрегата.Получить("field");
		Если ТипЗнч(СыроеПоле) <> Тип("Строка") ИЛИ ПустаяСтрока(СокрЛП(СыроеПоле)) Тогда
			Предупреждения.Добавить("aggregate_ignored: field_missing");
			Продолжить;
		КонецЕсли;

		ПолеКанонич = ДоступныеПоля.Получить(ВРег(ОчищенноеИмяПоля(СыроеПоле)));
		Если ПолеКанонич = Неопределено Тогда
			Предупреждения.Добавить("aggregate_ignored: field_unknown " + СыроеПоле);
			Продолжить;
		КонецЕсли;

		СыройАлиас = ЭлементАгрегата.Получить("as");
		Если ТипЗнч(СыройАлиас) = Тип("Строка") И НЕ ПустаяСтрока(СокрЛП(СыройАлиас)) Тогда
			Алиас = ОчищенноеИмяПоля(СыройАлиас);
		Иначе
			Алиас = ФункцияЗапроса + "_" + ПолеКанонич;
		КонецЕсли;

		Если ИспользованныеАлиасы.Получить(ВРег(Алиас)) <> Неопределено Тогда
			// Совпадение алиасов (например два агрегата "as":"итого") -
			// дифференцируем добавлением индекса, чтобы не потерять строку.
			Алиас = Алиас + "_" + Формат(Результат.Количество(), "ЧГ=0");
		КонецЕсли;
		ИспользованныеАлиасы.Вставить(ВРег(Алиас), Истина);

		Агрегат = Новый Структура;
		Агрегат.Вставить("ФункцияЗапроса", ФункцияЗапроса);
		Агрегат.Вставить("ПолеКанонич", ПолеКанонич);
		Агрегат.Вставить("Алиас", Алиас);
		Результат.Добавить(Агрегат);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строит текст запроса СГРУППИРОВАТЬ ПО для tool aggregate. По образцу
// ТекстЗапросаДанных, но ВЫБРАТЬ содержит group_by-поля и агрегатные выражения,
// СГРУППИРОВАТЬ ПО добавляется только если GroupByПоля непустой (иначе агрегаты
// без группировки - одна строка результата, UNIV-07 спека раздел (a), п.6).
Функция ТекстЗапросаАгрегатов(Знач ОписаниеИсточника, Знач GroupByПоля, Знач Агрегаты, Знач Условия, Знач Лимит)

	СписокПолейВыборки = Новый Массив;
	Для Каждого Поле Из GroupByПоля Цикл
		СписокПолейВыборки.Добавить("	Т." + Поле + " КАК " + Поле);
	КонецЦикла;
	Для Каждого Агрегат Из Агрегаты Цикл
		СписокПолейВыборки.Добавить("	" + Агрегат.ФункцияЗапроса + "(Т."
			+ Агрегат.ПолеКанонич + ") КАК " + Агрегат.Алиас);
	КонецЦикла;

	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ СтрСоединить(СписокПолейВыборки, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	" + ОписаниеИсточника.ПолноеИмя + " КАК Т" + Символы.ПС;

	Если Условия.Количество() > 0 Тогда
		Текст = Текст + "ГДЕ" + Символы.ПС + "	" + СтрСоединить(Условия, Символы.ПС + "	И ") + Символы.ПС;
	КонецЕсли;

	Если GroupByПоля.Количество() > 0 Тогда
		СписокГруппировки = Новый Массив;
		Для Каждого Поле Из GroupByПоля Цикл
			СписокГруппировки.Добавить("Т." + Поле);
		КонецЦикла;
		Текст = Текст + "СГРУППИРОВАТЬ ПО" + Символы.ПС + "	" + СтрСоединить(СписокГруппировки, ", ");
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Обходит результат запроса-группировки и формирует observation aggregate.
// Каждая строка -> Структура {<group_by поля>, <алиасы агрегатов>}. group_by-поля
// маскируются тем же вызовом ar_Утилиты.ОчиститьЗначениеПоля, что и в
// СериализоватьРезультатЗапроса (UNIV-07 спека раздел (a), п.8); агрегатные
// (числовые) значения не маскируются - не являются ПДн по построению.
// Пагинация (offset) не реализуется - paginated:false всегда (спека раздел (a), п.7).
Функция СериализоватьРезультатАгрегатов(Знач РезультатЗапроса, Знач Источник,
	Знач GroupByПоля, Знач Агрегаты, Знач Лимит, Знач Предупреждения,
	Знач РежимCompliance = Ложь, Знач ИмяОбъекта = Неопределено, Статистика = Неопределено)

	Элементы = Новый Массив;
	УсеченоПоРазмеру = Ложь;
	НакопленныйРазмер = 0;
	МаксРазмер = 100 * 1024;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;

		Для Каждого Поле Из GroupByПоля Цикл
			ПредставлениеПоля = ПредставлениеЗначенияПоля(Выборка[Поле]);
			Если РежимCompliance Тогда
				ИсходноеПредставление = ПредставлениеПоля;
				ПредставлениеПоля = ar_Утилиты.ОчиститьЗначениеПоля(ИмяОбъекта, Поле, ПредставлениеПоля);
				УчестьМаскирование(Статистика, ИмяОбъекта, Поле,
					ИсходноеПредставление, ПредставлениеПоля);
			КонецЕсли;
			Строка.Вставить(Поле, ПредставлениеПоля);
		КонецЦикла;

		Для Каждого Агрегат Из Агрегаты Цикл
			Строка.Вставить(Агрегат.Алиас, Выборка[Агрегат.Алиас]);
		КонецЦикла;

		РазмерСтроки = СтрДлина(ar_JSON.ВЗначениеJSON(Строка));
		Если Элементы.Количество() > 0 И НакопленныйРазмер + РазмерСтроки > МаксРазмер Тогда
			УсеченоПоРазмеру = Истина;
			Прервать;
		КонецЕсли;

		Элементы.Добавить(Строка);
		НакопленныйРазмер = НакопленныйРазмер + РазмерСтроки;
	КонецЦикла;

	GroupByОтвет = Новый Массив;
	Для Каждого Поле Из GroupByПоля Цикл
		GroupByОтвет.Добавить(Поле);
	КонецЦикла;

	АгрегатыОтвет = Новый Массив;
	Для Каждого Агрегат Из Агрегаты Цикл
		ОписаниеАгрегата = Новый Структура;
		ОписаниеАгрегата.Вставить("func", Агрегат.ФункцияЗапроса);
		ОписаниеАгрегата.Вставить("field", Агрегат.ПолеКанонич);
		ОписаниеАгрегата.Вставить("as", Агрегат.Алиас);
		АгрегатыОтвет.Добавить(ОписаниеАгрегата);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("source", Источник);
	Результат.Вставить("group_by", GroupByОтвет);
	Результат.Вставить("aggregates", АгрегатыОтвет);
	Результат.Вставить("items", Элементы);
	Результат.Вставить("count", Элементы.Количество());
	Результат.Вставить("limit", Лимит);
	Результат.Вставить("paginated", Ложь);
	Результат.Вставить("truncated", УсеченоПоРазмеру);
	Результат.Вставить("warnings", Предупреждения);
	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// search_text (полнотекстовый поиск).

// Истина, если полнотекстовый поиск разрешён в ИБ. Любая ошибка/недоступность
// API в режиме совместимости → Ложь (graceful fallback).
Функция ПолнотекстовыйПоискДоступен()
	Попытка
		Возврат ПолнотекстовыйПоиск.РежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Выполняет полнотекстовый поиск нативным API платформы и формирует observation.
// Параметр ПервыйДокумент платформы задаёт смещение в индексе ПП.
//
// Параметры:
//  СтрокаПоиска - Строка - поисковая строка.
//  ТипОбъекта   - Строка - ограничение по типу объекта (может быть пустым).
//  Лимит        - Число  - максимальное количество результатов.
//  Offset       - Число  - смещение (позиция первого документа в индексе ПП).
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ВыполнитьПолнотекстовыйПоиск(Знач СтрокаПоиска, Знач ТипОбъекта, Знач Лимит, Знач Offset = 0)

	// СоздатьСписок: второй параметр - количество, третий - ПервыйДокумент (смещение).
	// Запрашиваем Лимит+1 строк для определения наличия продолжения.
	КоличествоДляПоиска = Лимит + 1;
	Если Offset > 0 Тогда
		СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоиска, КоличествоДляПоиска, Offset);
	Иначе
		СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоиска, КоличествоДляПоиска);
	КонецЕсли;
	СписокПоиска.ПерваяЧасть();

	Элементы = Новый Массив;
	Для Каждого РезультатПП Из СписокПоиска Цикл
		Если Элементы.Количество() >= Лимит Тогда
			// Нашли Лимит+1 - значит продолжение есть, но в ответ не добавляем.
			Прервать;
		КонецЕсли;

		Значение = РезультатПП.Значение;
		Если НЕ ЗначениеСоответствуетТипу(Значение, ТипОбъекта) Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Значение));
		Элемент.Вставить("name", Строка(Значение));
		Элемент.Вставить("type", ТипЗначенияДляObservation(Значение));
		Элемент.Вставить("highlight", ФрагментРезультата(СписокПоиска, РезультатПП));
		Элементы.Добавить(Элемент);
	КонецЦикла;

	// next_offset: если получили ровно Лимит+1 - продолжение есть.
	ПолученоЭлементов = Элементы.Количество();
	ЕстьПродолжение = СписокПоиска.Количество() > Лимит;
	NextOffset = ?(ЕстьПродолжение, Offset + ПолученоЭлементов, Неопределено);

	РезультатОбъект = Новый Структура;
	РезультатОбъект.Вставить("items", Элементы);
	РезультатОбъект.Вставить("count", ПолученоЭлементов);
	РезультатОбъект.Вставить("offset", Offset);
	РезультатОбъект.Вставить("next_offset", NextOffset);
	Возврат ar_JSON.ВЗначениеJSON(РезультатОбъект);

КонецФункции

// Истина, если найденное значение соответствует ограничению по типу object_type
// (пустой ТипОбъекта → без ограничения).
Функция ЗначениеСоответствуетТипу(Знач Значение, Знач ТипОбъекта)
	Если ПустаяСтрока(ТипОбъекта) Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		МетаданныеЗначения = Значение.Метаданные();
		Возврат ВРег(МетаданныеЗначения.ПолноеИмя()) = ВРег(ТипОбъекта)
			ИЛИ ВРег(КороткийТипМетаданных(МетаданныеЗначения.ПолноеИмя())) = ВРег(ТипОбъекта);
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Возвращает короткий тип найденного значения для observation.
Функция ТипЗначенияДляObservation(Знач Значение)
	Попытка
		Возврат КороткийТипМетаданных(Значение.Метаданные().ПолноеИмя());
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Возвращает текстовый фрагмент результата ПП (highlight). Список ПП
// предоставляет HTML-отображение найденного через ПолучитьОтображение(...);
// при недоступности API (режим совместимости) highlight опускается.
Функция ФрагментРезультата(Знач СписокПоиска, Знач Результат)
	Попытка
		ОтображениеТекста = СписокПоиска.ПолучитьОтображение(Результат);
		Если ОтображениеТекста <> Неопределено Тогда
			Возврат ar_Утилиты.ОбрезатьДо(Строка(ОтображениеТекста), 200);
		КонецЕсли;
	Исключение
		// API отображения недоступно в данной версии - highlight опускаем.
		Возврат "";
	КонецПопытки;
	Возврат "";
КонецФункции

// Fallback при отключённом ПП: поиск по метаданным с пометкой warning.
// Пагинация реализована срезом массива найденных метаданных.
//
// Параметры:
//  СтрокаПоиска - Строка - поисковая строка.
//  ТипОбъекта   - Строка - ограничение по типу объекта (может быть пустым).
//  Лимит        - Число  - максимальное количество результатов.
//  Offset       - Число  - смещение (>= 0).
//
// Возвращаемое значение:
//  Строка - JSON-observation с предупреждением о fallback.
//
Функция FallbackНаПоискМетаданных(Знач СтрокаПоиска, Знач ТипОбъекта, Знач Лимит, Знач Offset = 0)

	// Запрашиваем все найденные элементы без лимита (limit 100 - макс. ПоискМетаданных).
	АргументыМД = Новый Структура;
	АргументыМД.Вставить("query", СтрокаПоиска);
	Если НЕ ПустаяСтрока(ТипОбъекта) Тогда
		АргументыМД.Вставить("object_type", ТипОбъекта);
	КонецЕсли;
	АргументыМД.Вставить("limit", 100);

	JSONМетаданных = ПоискМетаданных(ar_JSON.ВЗначениеJSON(АргументыМД), Неопределено);
	РазобранныйМД = ar_JSON.ИзJSON(JSONМетаданных);

	ВсеЭлементы = Новый Массив;
	Если ТипЗнч(РазобранныйМД) = Тип("Соответствие") Тогда
		Найденные = РазобранныйМД.Получить("items");
		Если ТипЗнч(Найденные) = Тип("Массив") Тогда
			ВсеЭлементы = Найденные;
		КонецЕсли;
	КонецЕсли;

	Страница = СрезМассиваСОффсетом(ВсеЭлементы, Offset, Лимит);
	ЕстьПродолжение = (Offset + Страница.Количество()) < ВсеЭлементы.Количество();
	NextOffset = ?(ЕстьПродолжение, Offset + Страница.Количество(), Неопределено);

	Результат = Новый Структура;
	Результат.Вставить("warning", "fulltext_search_disabled");
	Результат.Вставить("fallback", "metadata_search");
	Результат.Вставить("items", Страница);
	Результат.Вставить("count", Страница.Количество());
	Результат.Вставить("offset", Offset);
	Результат.Вставить("next_offset", NextOffset);
	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// get_object_structure: вспомогательные функции.

// Находит объект метаданных по строке "Класс.Имя" с поддержкой всех классов
// get_object_structure: Справочник, Документ, Перечисление, РегистрСведений,
// РегистрНакопления, РегистрБухгалтерии.
// Возвращает Структуру {Класс, Метаданные} или Неопределено при неудаче.
//
// Параметры:
//  ИмяТипа - Строка - полное имя в формате "Класс.Имя", напр. "Справочник.Контрагенты".
//
// Возвращаемое значение:
//  Структура {Класс, Метаданные} или Неопределено.
//
Функция НайтиОбъектМетаданных(Знач ИмяТипа)
	Части = СтрРазделить(ИмяТипа, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Класс = Части[0];
	Имя = Части[1];

	Если Класс = "Справочник" Тогда
		МД = Метаданные.Справочники.Найти(Имя);
	ИначеЕсли Класс = "Документ" Тогда
		МД = Метаданные.Документы.Найти(Имя);
	ИначеЕсли Класс = "Перечисление" Тогда
		МД = Метаданные.Перечисления.Найти(Имя);
	ИначеЕсли Класс = "РегистрСведений" Тогда
		МД = Метаданные.РегистрыСведений.Найти(Имя);
	ИначеЕсли Класс = "РегистрНакопления" Тогда
		МД = Метаданные.РегистрыНакопления.Найти(Имя);
	ИначеЕсли Класс = "РегистрБухгалтерии" Тогда
		МД = Метаданные.РегистрыБухгалтерии.Найти(Имя);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если МД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Класс, Метаданные", Класс, МД);
КонецФункции

// Собирает массив описаний атрибутов из коллекции реквизитов/измерений/ресурсов.
// Каждый элемент: {name, synonym, type, required}.
//
// Параметры:
//  КоллекцияРеквизитов - коллекция метаданных (МД.Реквизиты, МД.Измерения и т.п.)
//
// Возвращаемое значение:
//  Массив структур {name, synonym, type, required}.
//
Функция СобратьАтрибутыКоллекции(Знач КоллекцияРеквизитов)
	Результат = Новый Массив;
	Для Каждого РеквизитМД Из КоллекцияРеквизитов Цикл
		Атрибут = Новый Структура;
		Атрибут.Вставить("name", РеквизитМД.Имя);
		Атрибут.Вставить("synonym", РеквизитМД.Синоним);
		Атрибут.Вставить("type", ОписатьТипРеквизита(РеквизитМД.Тип));
		ОбязательностьЗаполнения = Ложь;
		Попытка
			ОбязательностьЗаполнения = (РеквизитМД.ПроверкаЗаполнения
				= ПроверкаЗаполнения.Выдавать);
		Исключение
			ОбязательностьЗаполнения = Ложь; // Свойство может быть недоступно для некоторых коллекций.
		КонецПопытки;
		Атрибут.Вставить("required", ОбязательностьЗаполнения);
		Результат.Добавить(Атрибут);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Преобразует ОписаниеТипов реквизита метаданных в строковое представление
// для observation. Примитивы → "string"/"number"/"boolean"/"date"/"datetime"/"storage".
// Ссылочные → "CatalogRef.Имя" и т.п. Составные → через запятую.
// Строка неограниченной длины → "string_unlimited".
//
// Параметры:
//  ОпиТипов - ОписаниеТипов - описание типа реквизита метаданных.
//
// Возвращаемое значение:
//  Строка - строковое описание типа.
//
Функция ОписатьТипРеквизита(Знач ОпиТипов)
	ЧастиТипа = Новый Массив;
	Для Каждого ТипЭлемент Из ОпиТипов.Типы() Цикл
		СтрокаТипа = ПримитивныйТипВСтроку(ТипЭлемент, ОпиТипов);
		Если ПустаяСтрока(СтрокаТипа) Тогда
			СтрокаТипа = СсылочныйТипВСтроку(ТипЭлемент);
		КонецЕсли;
		Если НЕ ПустаяСтрока(СтрокаТипа) Тогда
			ЧастиТипа.Добавить(СтрокаТипа);
		КонецЕсли;
	КонецЦикла;
	Если ЧастиТипа.Количество() = 0 Тогда
		Возврат "unknown";
	КонецЕсли;
	Возврат СтрСоединить(ЧастиТипа, ", ");
КонецФункции

// Возвращает строку примитивного типа ("string", "number", "boolean", "date",
// "datetime", "storage", "string_unlimited") или "" если тип не примитивный.
//
// Параметры:
//  ТипЭлемент - Тип   - проверяемый тип.
//  ОпиТипов   - ОписаниеТипов - для получения квалификаторов строки и даты.
//
// Возвращаемое значение:
//  Строка - обозначение примитивного типа или пустая строка.
//
Функция ПримитивныйТипВСтроку(Знач ТипЭлемент, Знач ОпиТипов)
	Если ТипЭлемент = Тип("Число") Тогда
		Возврат "number";
	ИначеЕсли ТипЭлемент = Тип("Булево") Тогда
		Возврат "boolean";
	ИначеЕсли ТипЭлемент = Тип("ХранилищеЗначения") Тогда
		Возврат "storage";
	ИначеЕсли ТипЭлемент = Тип("Строка") Тогда
		КвалификаторыСтроки = ОпиТипов.КвалификаторыСтроки;
		Если КвалификаторыСтроки <> Неопределено И КвалификаторыСтроки.Длина = 0 Тогда
			Возврат "string_unlimited";
		КонецЕсли;
		Возврат "string";
	ИначеЕсли ТипЭлемент = Тип("Дата") Тогда
		КвалификаторыДаты = ОпиТипов.КвалификаторыДаты;
		Если КвалификаторыДаты <> Неопределено
			И КвалификаторыДаты.ЧастиДаты = ЧастиДаты.ДатаВремя Тогда
			Возврат "datetime";
		КонецЕсли;
		Возврат "date";
	Иначе
		// Тип не является примитивным - будет обработан как ссылочный.
		Возврат "";
	КонецЕсли;
КонецФункции

// Возвращает строку ссылочного типа ("CatalogRef.Имя" и т.п.) через
// Метаданные.НайтиПоТипу. Если тип не ссылочный → "".
//
// Параметры:
//  ТипЭлемент - Тип - проверяемый тип.
//
// Возвращаемое значение:
//  Строка - обозначение ссылочного типа или пустая строка.
//
Функция СсылочныйТипВСтроку(Знач ТипЭлемент)
	ОписаниеМД = Метаданные.НайтиПоТипу(ТипЭлемент);
	Если ОписаниеМД <> Неопределено Тогда
		Возврат КороткийТипМетаданных(ОписаниеМД.ПолноеИмя()) + "Ref";
	КонецЕсли;
	Возврат "";
КонецФункции

// Ограничивает observation get_object_structure 50 KB: при превышении усекает
// атрибуты и ТЧ, проставляет "truncated": true.
//
// Параметры:
//  Результат - Структура - сформированный результат.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ОграничитьРазмерОбзорСтруктуры(Знач Результат)
	JSON = ar_JSON.ВЗначениеJSON(Результат);
	Если СтрДлина(JSON) <= 50 * 1024 Тогда
		Возврат JSON;
	КонецЕсли;

	// Усечение: оставляем первые 50 реквизитов, убираем содержимое ТЧ.
	МаксАтрибутов = 50;
	Атрибуты = Результат.Получить("attributes");
	Если Атрибуты <> Неопределено И Атрибуты.Количество() > МаксАтрибутов Тогда
		НовыеАтрибуты = Новый Массив;
		Для Инд = 0 По МаксАтрибутов - 1 Цикл
			НовыеАтрибуты.Добавить(Атрибуты[Инд]);
		КонецЦикла;
		Результат.Вставить("attributes", НовыеАтрибуты);
	КонецЕсли;

	ТЧ = Результат.Получить("tabular_sections");
	Если ТЧ <> Неопределено Тогда
		Для Каждого ТЧЭлем Из ТЧ Цикл
			ТЧЭлем.Вставить("attributes", Новый Массив);
		КонецЦикла;
	КонецЕсли;

	Результат.Вставить("truncated", Истина);
	Возврат ar_JSON.ВЗначениеJSON(Результат);
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// get_object_history.

// Проверяет доступность подсистемы версионирования и право текущего пользователя
// на чтение информации о версиях. Возвращает JSON-observation ошибки при
// недоступности, или Неопределено, если всё в порядке.
//
// Возвращаемое значение:
//  Строка - JSON-observation ошибки, или Неопределено при успехе.
//
Функция ПроверитьДоступностьВерсионирования()
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ВерсионированиеОбъектов") Тогда
		Результат = Новый Структура;
		Результат.Вставить("error", "no_version_history");
		Результат.Вставить("hint", "Subsystem VersioningObjects is not available in this configuration");
		Возврат ar_JSON.ВЗначениеJSON(Результат);
	КонецЕсли;
	Если НЕ ВерсионированиеОбъектов.ЕстьПравоЧтенияИнформацииОВерсияхОбъектов() Тогда
		Возврат ОшибочныйJSON("access_denied");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Собирает массив структур версий объекта в диапазоне [НомерНачала..НомерПоследней]
// в обратном порядке (от новых к старым). Вызов СведенияОВерсииОбъекта выполняется в
// привилегированном режиме (требование документации БСП, std485). Режим гарантированно
// сбрасывается после каждого вызова через try/finally. Версии, недоступные по исключению
// (очищены регламентом), пропускаются тихо.
//
// Параметры:
//  Ссылка         - ЛюбаяСсылка - ссылка на объект.
//  НомерПоследней - Число        - номер последней (самой новой) версии (>= 1).
//  НомерНачала    - Число        - начальный номер диапазона (>= 1).
//
// Возвращаемое значение:
//  Массив - элементы {version, date, user, comment}.
//
Функция СобратьВерсииОбъекта(Знач Ссылка, Знач НомерПоследней, Знач НомерНачала)
	Версии = Новый Массив;
	НомерВерсии = НомерПоследней;
	Пока НомерВерсии >= НомерНачала Цикл
		// СведенияОВерсииОбъекта требует привилегированного режима (документация БСП std485).
		// Режим включается локально для одного вызова и гарантированно сбрасывается через try/finally.
		Сведения = Неопределено;
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			Сведения = ВерсионированиеОбъектов.СведенияОВерсииОбъекта(Ссылка, НомерВерсии);
		Исключение
			// Версия недоступна (очищена регламентом) - пропустить без ошибки.
			Сведения = Неопределено;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);

		Если Сведения <> Неопределено Тогда
			ЗаписьВерсии = Новый Структура;
			ЗаписьВерсии.Вставить("version", НомерВерсии);
			ЗаписьВерсии.Вставить("date", Формат(Сведения.ДатаВерсии, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			ЗаписьВерсии.Вставить("user", Строка(Сведения.АвторВерсии));
			ЗаписьВерсии.Вставить("comment", "");
			Версии.Добавить(ЗаписьВерсии);
		КонецЕсли;

		НомерВерсии = НомерВерсии - 1;
	КонецЦикла;
	Возврат Версии;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// find_references.

// Преобразует ТаблицаЗначений результата НайтиПоСсылкам в массив структур
// {type, ref, name, field} для JSON-observation. Берёт не более Лимит строк.
// Устаревшая версия без пагинации - оставлена для возможного внутреннего использования.
//
// Параметры:
//  ТаблицаМест - ТаблицаЗначений - результат НайтиПоСсылкам.
//  Лимит       - Число           - максимальное количество строк.
//
// Возвращаемое значение:
//  Массив - элементы {type, ref, name, field}.
//
Функция ПреобразоватьМестаИспользования(Знач ТаблицаМест, Знач Лимит)
	Возврат ПреобразоватьМестаИспользованияСОффсетом(ТаблицаМест, 0, Лимит);
КонецФункции

// Преобразует ТаблицаЗначений результата НайтиПоСсылкам в массив структур
// {type, ref, name, field} с поддержкой смещения (пагинация).
// Берёт строки от Offset до Offset+Лимит-1.
//
// Параметры:
//  ТаблицаМест - ТаблицаЗначений - результат НайтиПоСсылкам.
//  Offset      - Число           - начальная позиция (0-based).
//  Лимит       - Число           - максимальное количество строк.
//
// Возвращаемое значение:
//  Массив - элементы {type, ref, name, field}.
//
Функция ПреобразоватьМестаИспользованияСОффсетом(Знач ТаблицаМест, Знач Offset, Знач Лимит)
	Элементы = Новый Массив;
	Итого = 0;
	ТекущаяПозиция = 0;
	Для Каждого СтрокаМест Из ТаблицаМест Цикл
		Если ТекущаяПозиция < Offset Тогда
			ТекущаяПозиция = ТекущаяПозиция + 1;
			Продолжить;
		КонецЕсли;
		Если Итого >= Лимит Тогда
			Прервать;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("type", ТипВладельцаМестаИспользования(СтрокаМест.Данные));
		Элемент.Вставить("ref", НавигационнаяСсылкаМестаИспользования(СтрокаМест.Данные));
		Элемент.Вставить("name", ПредставлениеМестаИспользования(СтрокаМест.Данные));
		Элемент.Вставить("field", ИмяПоляМестаИспользования(СтрокаМест.Метаданные));

		Элементы.Добавить(Элемент);
		Итого = Итого + 1;
		ТекущаяПозиция = ТекущаяПозиция + 1;
	КонецЦикла;
	Возврат Элементы;
КонецФункции

// Возвращает короткий тип объекта-владельца из НайтиПоСсылкам.
// При исключении (набор записей регистра и пр.) возвращает пустую строку.
Функция ТипВладельцаМестаИспользования(Знач Данные)
	Попытка
		МДВладелец = Данные.Метаданные();
		Возврат КороткийТипМетаданных(МДВладелец.ПолноеИмя());
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Возвращает навигационную ссылку объекта-владельца из НайтиПоСсылкам.
// Для наборов записей регистров (нет единой ссылки) возвращает пустую строку.
Функция НавигационнаяСсылкаМестаИспользования(Знач Данные)
	Попытка
		Возврат ar_Утилиты.НавигационнаяСсылкаОбъекта(Данные);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Возвращает строковое представление объекта-владельца из НайтиПоСсылкам.
// При исключении возвращает пустую строку.
Функция ПредставлениеМестаИспользования(Знач Данные)
	Попытка
		Возврат Строка(Данные);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Возвращает имя поля метаданных (реквизит/измерение/ресурс) из НайтиПоСсылкам.
// При исключении возвращает пустую строку.
Функция ИмяПоляМестаИспользования(Знач МетаданныеПоля)
	Попытка
		Возврат МетаданныеПоля.Имя;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Разбор произвольного типа метаданных (для read_object по UUID).

// Разбирает "<Класс>.<Имя>" любого ссылочного класса в {ПолноеИмя, Метаданные}.
// Неизвестный/некорректный → Неопределено.
Функция РазобратьТипОбъектаЛюбого(Знач ТипОбъекта)

	Части = СтрРазделить(ТипОбъекта, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Класс = Части[0];
	Имя = Части[1];

	Коллекция = КоллекцияПоКлассу(Класс);
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	МД = Коллекция.Найти(Имя);
	Если МД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ПолноеИмя, Метаданные", Класс + "." + Имя, МД);

КонецФункции

// Возвращает коллекцию метаданных по русскому имени ссылочного класса.
Функция КоллекцияПоКлассу(Знач Класс)
	Если Класс = "Справочник" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Класс = "Документ" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Класс = "Перечисление" Тогда
		Возврат Метаданные.Перечисления;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Возвращает менеджер объекта по полному имени ("Справочник.Контрагенты").
Функция МенеджерПоПолномуИмени(Знач ПолноеИмя)
	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Класс = Части[0];
	Имя = Части[1];
	Если Класс = "Справочник" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Класс = "Документ" Тогда
		Возврат Документы[Имя];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Регистрация tools в ar_Tools.

// Возвращает массив структур-описаний 9 универсальных tools для регистрации.
Функция ОписанияУниверсальныхTools()

	Описания = Новый Массив;
	ДобавитьОписаниеTool(Описания, "search_metadata", "ПоискМетаданных",
		"Поиск объектов метаданных конфигурации по части имени или синонима.");
	ДобавитьОписаниеTool(Описания, "list_catalogs", "СписокСправочников",
		"Список справочников конфигурации с признаками иерархии и владельцев.");
	ДобавитьОписаниеTool(Описания, "list_documents", "СписокДокументов",
		"Список документов конфигурации и регистров их движений.");
	ДобавитьОписаниеTool(Описания, "read_object", "ЧтениеОбъекта",
		"Чтение реквизитов объекта ИБ по навигационной ссылке или UUID.");
	ДобавитьОписаниеTool(Описания, "query", "УниверсальныйЗапрос",
		"Чтение данных конфигурации: выборка из справочников, документов, регистров"
		+ " сведений и накопления с фильтрами. Только чтение, без агрегатов, JOIN и"
		+ " виртуальных таблиц регистров.");
	ДобавитьОписаниеTool(Описания, "get_recent_changes", "ПоследниеИзменения",
		"Недавно изменённые справочники и документы за указанный интервал.");
	ДобавитьОписаниеTool(Описания, "search_text", "ПоискТекста",
		"Полнотекстовый поиск по данным ИБ с fallback на поиск метаданных.");
	ДобавитьОписаниеTool(Описания, "get_object_structure", "СтруктураТипаОбъекта",
		"Получение схемы типа объекта конфигурации: реквизиты, табличные части, измерения, ресурсы.");
	ДобавитьОписаниеTool(Описания, "find_references", "НайтиСсылки",
		"Поиск мест использования объекта ИБ (в каких объектах есть ссылки на него).");
	ДобавитьОписаниеTool(Описания, "get_object_history", "ИсторияВерсийОбъекта",
		"История версий объекта ИБ через подсистему Версионирование объектов БСП."
		+ " Возвращает список версий с датой и автором изменения.");
	ДобавитьОписаниеTool(Описания, "aggregate", "Агрегировать",
		"Агрегация данных источника (СУММА/КОЛИЧЕСТВО/МИНИМУМ/МАКСИМУМ/СРЕДНЕЕ) с"
		+ " группировкой. Тот же whitelist источников/полей и формат filters, что у"
		+ " query, без текста запроса от LLM.");
	ДобавитьОписаниеTool(Описания, "get_functional_options", "ФункциональныеОпции",
		"Список функциональных опций конфигурации (только булевы значения).");
	ДобавитьОписаниеTool(Описания, "get_constants", "СписокКонстант",
		"Список констант конфигурации со значениями. Значения маскируются по"
		+ " паттерну имени (пароли/токены/секреты) независимо от режима compliance.");
	ДобавитьОписаниеTool(Описания, "get_current_context", "ТекущийКонтекст",
		"Контекст текущей сессии: имя пользователя (учётной записи), рабочая дата,"
		+ " определение целевой конфигурации. organization не определяется"
		+ " универсальным слоем (null).");
	Возврат Описания;

КонецФункции

// Добавляет описание tool в массив (Имя, ИмяПроцедуры, Описание, Манифест).
Процедура ДобавитьОписаниеTool(Описания, Знач Имя, Знач ИмяПроцедуры, Знач Описание)
	Структура = Новый Структура;
	Структура.Вставить("Имя", Имя);
	Структура.Вставить("ИмяПроцедуры", ИмяПроцедуры);
	Структура.Вставить("Описание", Описание);
	Структура.Вставить("Манифест", МанифестTool(Имя, Описание));
	Описания.Добавить(Структура);
КонецПроцедуры

// Строит OpenAI tool-format манифест (JSON-строка) для tool по его имени.
Функция МанифестTool(Знач Имя, Знач Описание)

	Параметры = СхемаПараметровTool(Имя);

	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", Имя);
	ФункцияОписание.Вставить("description", Описание);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);
	Возврат ar_JSON.ВЗначениеJSON(Манифест);

КонецФункции

// Возвращает JSON Schema параметров (Структура) для tool по имени.
Функция СхемаПараметровTool(Знач Имя)

	Если Имя = "search_metadata" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("query", СвойствоСхемы("string", "Поисковая строка (часть имени или синонима)"));
		Свойства.Вставить("object_type", СвойствоСхемы("string", "Тип объекта: Catalog, Document и т.д. (опционально)"));
		Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум результатов (1-100)"));
		Возврат ОбъектСхемы(Свойства, "query");

	ИначеЕсли Имя = "list_catalogs" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("include_groups", СвойствоСхемы("boolean", "Включать число предопределённых групп"));
		Свойства.Вставить("offset", СвойствоСхемы("integer",
			"Смещение (пагинация). 0 = начало. Используй next_offset из предыдущего ответа."));
		Возврат ОбъектСхемы(Свойства, "");

	ИначеЕсли Имя = "list_documents" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("offset", СвойствоСхемы("integer",
			"Смещение (пагинация). 0 = начало. Используй next_offset из предыдущего ответа."));
		Возврат ОбъектСхемы(Свойства, "");

	ИначеЕсли Имя = "read_object" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("ref", СвойствоСхемы("string", "Навигационная ссылка или UUID объекта"));
		Свойства.Вставить("object_type", СвойствоСхемы("string", "Тип объекта (нужен если ref - UUID)"));
		Свойства.Вставить("fields", СвойствоСхемыМассив("string", "Список реквизитов (пусто = все стандартные)"));
		Свойства.Вставить("include_tabular", СвойствоСхемы("boolean", "Включать табличные части"));
		Возврат ОбъектСхемы(Свойства, "ref");

	ИначеЕсли Имя = "query" Тогда
		Возврат СхемаПараметровQuery();

	ИначеЕсли Имя = "get_recent_changes" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("object_type", СвойствоСхемы("string", "Тип объекта (например Справочник.Контрагенты)"));
		Свойства.Вставить("minutes", СвойствоСхемы("integer", "Глубина поиска в минутах (1-1440)"));
		Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум результатов"));
		Возврат ОбъектСхемы(Свойства, "object_type");

	ИначеЕсли Имя = "search_text" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("query", СвойствоСхемы("string", "Строка поиска (>= 3 символов)"));
		Свойства.Вставить("object_type", СвойствоСхемы("string", "Ограничить поиск типом объекта (опционально)"));
		Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум результатов"));
		Свойства.Вставить("offset", СвойствоСхемы("integer",
			"Смещение (пагинация). 0 = начало. Используй next_offset из предыдущего ответа."
			+ " Примечание: при обновлении индекса ПП между вызовами возможны пропуски."));
		Возврат ОбъектСхемы(Свойства, "query");

	ИначеЕсли Имя = "get_object_structure" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("object_type", СвойствоСхемы("string",
			"Полное имя типа метаданных: Справочник.Контрагенты,"
			+ " Документ.РеализацияТоваровУслуг, РегистрНакопления.Продажи и т.п."));
		Возврат ОбъектСхемы(Свойства, "object_type");

	ИначеЕсли Имя = "find_references" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("ref", СвойствоСхемы("string",
			"Навигационная ссылка (e1cib/data/...) или UUID объекта"));
		Свойства.Вставить("object_type", СвойствоСхемы("string",
			"Тип объекта: Справочник.Контрагенты и т.п. Обязателен если ref - UUID"));
		Свойства.Вставить("limit", СвойствоСхемы("integer",
			"Максимум результатов (1-100, дефолт 20)"));
		Свойства.Вставить("offset", СвойствоСхемы("integer",
			"Смещение (пагинация). 0 = начало. Используй next_offset из предыдущего ответа."));
		Возврат ОбъектСхемы(Свойства, "ref");

	ИначеЕсли Имя = "get_object_history" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("ref", СвойствоСхемы("string",
			"Навигационная ссылка (e1cib/data/...) или UUID объекта"));
		Свойства.Вставить("object_type", СвойствоСхемы("string",
			"Тип объекта: Справочник.Контрагенты и т.п. Обязателен если ref - UUID"));
		Свойства.Вставить("limit", СвойствоСхемы("integer",
			"Максимум версий в ответе (1-50, дефолт 10). Версии возвращаются от новых к старым"));
		Возврат ОбъектСхемы(Свойства, "ref");

	ИначеЕсли Имя = "aggregate" Тогда
		Возврат СхемаПараметровАгрегата();

	ИначеЕсли Имя = "get_functional_options" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("names", СвойствоСхемыМассив("string",
			"Список имён функциональных опций. Пусто - все опции"));
		Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум результатов (1-500, дефолт 100)"));
		Свойства.Вставить("offset", СвойствоСхемы("integer",
			"Смещение (пагинация). 0 = начало. Используй next_offset из предыдущего ответа."));
		Возврат ОбъектСхемы(Свойства, "");

	ИначеЕсли Имя = "get_constants" Тогда
		Свойства = Новый Структура;
		Свойства.Вставить("names", СвойствоСхемыМассив("string",
			"Список имён констант. Пусто - все константы"));
		Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум результатов (1-500, дефолт 100)"));
		Свойства.Вставить("offset", СвойствоСхемы("integer",
			"Смещение (пагинация). 0 = начало. Используй next_offset из предыдущего ответа."));
		Возврат ОбъектСхемы(Свойства, "");

	ИначеЕсли Имя = "get_current_context" Тогда
		Возврат ОбъектСхемы(Новый Структура, "");

	КонецЕсли;

	Возврат ОбъектСхемы(Новый Структура, "");

КонецФункции

// Возвращает полную JSON Schema параметров tool query (source, filters, fields,
// limit, offset) с required = [source, filters] и additionalProperties = false.
Функция СхемаПараметровQuery()

	Свойства = Новый Структура;
	Свойства.Вставить("source", СвойствоСхемы("string",
		"Источник данных в формате '<Класс>.<Имя>', например Справочник.Контрагенты."
		+ " Класс: Справочник, Документ, РегистрСведений, РегистрНакопления"));
	Свойства.Вставить("filters", СвойствоСхемы("object",
		"Условия отбора. Ключ - имя поля, значение - примитив (равенство) или"
		+ " {""op"":<eq|gt|lt|gte|lte|like|in>,""val"":<значение>}. Для like ""*"" -"
		+ " подстановка, для in - массив значений"));
	Свойства.Вставить("fields", СвойствоСхемыМассив("string",
		"Список реквизитов в результат. Пусто - все стандартные поля"));
	Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум строк. Дефолт 100, максимум 1000"));
	Свойства.Вставить("offset", СвойствоСхемы("integer",
		"Смещение (пагинация). 0 = начало. Используй next_offset из предыдущего ответа."
		+ " Важно: ПРОПУСТИТЬ на больших таблицах без сортировки по индексу может быть медленным."));

	Обязательные = Новый Массив;
	Обязательные.Добавить("source");
	Обязательные.Добавить("filters");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;

КонецФункции

// Возвращает полную JSON Schema параметров tool aggregate (source, filters,
// group_by, aggregates, limit) с required = [source, aggregates] и
// additionalProperties = false (UNIV-07 DoD D8).
Функция СхемаПараметровАгрегата()

	СвойстваЭлементаАгрегата = Новый Структура;
	СвойстваЭлементаАгрегата.Вставить("func", СвойствоСхемы("string",
		"Функция агрегации: SUM/COUNT/MIN/MAX/AVG (или СУММА/КОЛИЧЕСТВО/МИНИМУМ/МАКСИМУМ/СРЕДНЕЕ)"));
	СвойстваЭлементаАгрегата.Вставить("field", СвойствоСхемы("string", "Имя агрегируемого поля"));
	СвойстваЭлементаАгрегата.Вставить("as", СвойствоСхемы("string",
		"Алиас результата (опционально, по умолчанию func_field)"));

	СхемаЭлементаАгрегата = Новый Структура;
	СхемаЭлементаАгрегата.Вставить("type", "object");
	СхемаЭлементаАгрегата.Вставить("properties", СвойстваЭлементаАгрегата);

	СвойствоАгрегатов = Новый Структура;
	СвойствоАгрегатов.Вставить("type", "array");
	СвойствоАгрегатов.Вставить("items", СхемаЭлементаАгрегата);
	СвойствоАгрегатов.Вставить("description",
		"Список агрегатов, например [{""func"":""СУММА"",""field"":""СуммаДокумента"",""as"":""итого""}]");

	Свойства = Новый Структура;
	Свойства.Вставить("source", СвойствоСхемы("string",
		"Источник данных в формате '<Класс>.<Имя>', например Документ.РеализацияТоваровУслуг."
		+ " Класс: Справочник, Документ, РегистрСведений, РегистрНакопления"));
	Свойства.Вставить("filters", СвойствоСхемы("object",
		"Условия отбора, тот же формат, что у query. Ключ - имя поля, значение -"
		+ " примитив (равенство) или {""op"":<eq|gt|lt|gte|lte|like|in>,""val"":<значение>}"));
	Свойства.Вставить("group_by", СвойствоСхемыМассив("string",
		"Поля группировки (СГРУППИРОВАТЬ ПО). Пусто - агрегаты без группировки, одна строка результата"));
	Свойства.Вставить("aggregates", СвойствоАгрегатов);
	Свойства.Вставить("limit", СвойствоСхемы("integer", "Максимум строк группировки. Дефолт 100, максимум 500"));

	Обязательные = Новый Массив;
	Обязательные.Добавить("source");
	Обязательные.Добавить("aggregates");

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", Обязательные);
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;

КонецФункции

// Возвращает структуру свойства схемы {type, description}.
Функция СвойствоСхемы(Знач Тип, Знач Описание)
	Возврат Новый Структура("type, description", Тип, Описание);
КонецФункции

// Возвращает структуру свойства-массива схемы {type:array, items:{type}, description}.
Функция СвойствоСхемыМассив(Знач ТипЭлемента, Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", "array");
	Свойство.Вставить("items", Новый Структура("type", ТипЭлемента));
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Собирает объектную схему {type:object, properties, required[], additionalProperties:false}.
Функция ОбъектСхемы(Знач Свойства, Знач ОбязательноеПоле)
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Если НЕ ПустаяСтрока(ОбязательноеПоле) Тогда
		Обязательные = Новый Массив;
		Обязательные.Добавить(ОбязательноеПоле);
		Схема.Вставить("required", Обязательные);
	КонецЕсли;
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;
КонецФункции

// Возвращает ссылку записи tool с таким ar_Имя или Неопределено.
Функция НайтиЗаписьTool(Знач Имя)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя";
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Обновляет манифест-определяющие поля существующей записи tool (ar_Описание,
// ar_JSONManifest) до актуального контракта. Runtime-поля не трогает.
Процедура ОбновитьМанифестTool(Знач СсылкаTool, Знач Описание)
	Объект = СсылкаTool.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НовоеОписание = ar_Утилиты.ОбрезатьДо(Описание.Описание, 500);
	// UNIV-07 DoD D7: ar_ТребуемыеОбъекты чинится идемпотентно и для уже
	// существующих записей (созданных до этой итерации без явного заполнения
	// поля) - все universal-tools безусловно доступны (UNIV-03), поле должно
	// быть детерминированной строкой "[]", а не Null/пусто.
	ТребуетсяОбновлениеТребуемыхОбъектов = (Объект.ar_ТребуемыеОбъекты <> "[]");
	Если Объект.ar_Описание = НовоеОписание И Объект.ar_JSONManifest = Описание.Манифест
		И НЕ ТребуетсяОбновлениеТребуемыхОбъектов Тогда
		Возврат;
	КонецЕсли;
	Объект.ar_Описание = НовоеОписание;
	Объект.ar_JSONManifest = Описание.Манифест;
	Объект.ar_ТребуемыеОбъекты = "[]";
	Объект.Записать();
КонецПроцедуры

// Создаёт новую запись tool в справочнике ar_Tools по описанию.
Процедура СоздатьЗаписьTool(Знач Описание)
	Элемент = Справочники.ar_Tools.СоздатьЭлемент();
	Элемент.Наименование = Описание.Имя;
	Элемент.ar_Имя = Описание.Имя;
	Элемент.ar_Описание = ar_Утилиты.ОбрезатьДо(Описание.Описание, 500);
	Элемент.ar_JSONManifest = Описание.Манифест;
	Элемент.ar_RiskLevel = Перечисления.ar_RiskLevel.Read;
	Элемент.ar_ОбщийМодуль = "ar_ToolUniversal";
	Элемент.ar_ИмяПроцедуры = Описание.ИмяПроцедуры;
	Элемент.ar_ТребуетApproval = Ложь;
	Элемент.ar_Включён = Истина;
	Элемент.ar_Версия = "1.0.0";
	Элемент.ar_ИсточникРасширение = "";
	// UNIV-07 DoD D7: все universal-tools безусловно доступны (UNIV-03) -
	// ar_ТребуемыеОбъекты детерминирован как пустой JSON-массив, а не Null/пусто.
	Элемент.ar_ТребуемыеОбъекты = "[]";
	Элемент.Записать();
КонецПроцедуры

