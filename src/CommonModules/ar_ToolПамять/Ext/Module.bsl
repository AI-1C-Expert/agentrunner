////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolПамять (AOS Tool - Память агента).
//
// Реализует tool `remember` — запись фактов, предпочтений, правил и заметок
// в долгосрочную память агента (справочник ar_ПамятьАгента, META-25).
//
// PAY-01: реализует также get_settings/set_setting — read/write доступ к
// универсальному key-value справочнику настроек расширения
// ar_ДополнительныеНастройки (фасад ar_Настройки). set_setting — двухстадийный
// (стадия 1 в этом модуле: валидация + постановка в очередь approval; стадия 2
// ИсполнитьУстановкуНастройки, вызывается из ar_Approval.ИсполнитьApprovedДействие).
//
// Контракт tool-функции:
//   Вход:  Аргументы (Строка) — JSON-объект аргументов от LLM.
//          Контекст (Структура) — КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//   Выход: Строка JSON — observation для добавления в контекст как role:tool.
//
// Контракт DryRun (DISP-03):
//   Запомнить — mutating-функция (RiskLevel = Write). ОБЯЗАНА:
//   1. Вызвать ar_ToolDispatcher.ИзвлечьDryRun(Аргументы).
//   2. При Истина — вернуть ar_ToolDispatcher.СформироватьDryRunJSON(...)
//      БЕЗ записи в ar_ПамятьАгента.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Tool выполняется в правах пользователя сессии (RLS работает естественно).
//
// См. спеку: .docs/specs/MEM-01.md, Plan §5 этап 2.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня модуля ar_ToolПамять. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolПамять.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры ("Запомнить" / "ВспомнитьПамять" /
//                 "ПолучитьНастройки" / "УстановитьНастройку").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "Запомнить" Тогда
		Возврат Запомнить(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ВспомнитьПамять" Тогда
		Возврат ВспомнитьПамять(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПолучитьНастройки" Тогда
		Возврат ПолучитьНастройки(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "УстановитьНастройку" Тогда
		Возврат УстановитьНастройку(Аргументы, Контекст);
	// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
	// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Tool recall_memory: поиск ранее сохранённых записей в памяти агента (MEM-02).
// MEM-03: в режиме «без агента» (Контекст.Агент пуст) ищет по владельцу-пользователю
// через Контекст.ПользовательUUID.
//
// RiskLevel = Read, ТребуетApproval = Ложь. Read-only: не пишет в ИБ.
//
// Параметры:
//  Аргументы - Строка    - JSON аргументов tool:
//                          {"pattern":..., "type_filter":..., "period":...,
//                           "include_run_history":...}.
//  Контекст  - Структура - КонтекстЗапуска. Поля Агент/ПользовательUUID определяют
//                          владельца памяти (MEM-03).
//
// Возвращаемое значение:
//  Строка - JSON-observation:
//           {"results":[...], "total": N, "message": "..."} или
//           {"error": "..."}.
//
Функция ВспомнитьПамять(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ВспомнитьПамятьВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool remember: сохранить факт, предпочтение, правило или заметку в
// долгосрочную память агента (справочник ar_ПамятьАгента).
// MEM-03: в режиме «без агента» (Контекст.Агент пуст) запись привязывается
// к владельцу-пользователю через Контекст.ПользовательUUID (ar_ВладелецКлюч =
// "ibuser:<uuid>").
//
// RiskLevel = Write, ТребуетApproval = Ложь.
//
// Параметры:
//  Аргументы - Строка    - JSON аргументов tool:
//                          {"text":..., "type":..., "keywords":...}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено. Поля
//                          Агент/ПользовательUUID определяют владельца записи (MEM-03).
//
// Возвращаемое значение:
//  Строка - JSON-observation:
//           {"saved": true, "ref": "...", "message": "Запомнено"} или
//           {"error": "..."}.
//
Функция Запомнить(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ЗапомнитьВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

// Идемпотентно создаёт/обновляет записи реестра ar_Tools для tools
// `remember` (MEM-01) и `recall_memory` (MEM-02).
// Безопасно вызывать повторно: запись ищется по реквизиту ar_Имя, при наличии
// обновляется, иначе создаётся.
//
// Привилегированный режим: запись в служебный справочник ar_Tools требует прав;
// реестр заполняется при разворачивании/обновлении расширения. Поднятие привилегий
// локальное, с парным сбросом в блоке Исключение (Plan §1.3).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } — статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинИнструмент(ОписаниеЗапомнитьИнфо(),   Статистика);
		ЗарегистрироватьОдинИнструмент(ОписаниеВспомнитьИнфо(),   Статистика);
		ЗарегистрироватьОдинИнструмент(ОписаниеToolПолучитьНастройки(), Статистика);
		ЗарегистрироватьОдинИнструмент(ОписаниеToolУстановитьНастройку(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

// Tool get_settings (PAY-01): read-only чтение справочника настроек
// ar_ДополнительныеНастройки. RiskLevel = Read, ТребуетApproval = Ложь.
//
// Параметры:
//  Аргументы - Строка    - JSON: {"key":..., "include_disabled":...}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. .docs/specs/PAY-01.md, §get_settings).
//
Функция ПолучитьНастройки(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ПолучитьНастройкиВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool set_setting (PAY-01): стадия 1 - валидация аргументов, разыменование
// строковых ссылок в значениях, постановка действия в очередь approval.
// RiskLevel = Write, ТребуетApproval = Истина.
//
// Параметры:
//  Аргументы - Строка    - JSON: {"key":..., "value":...|"values":[...],
//              "create_if_missing":...}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: {"status":"queued_for_approval","approval_id":...}
//           либо {"error":"..."}.
//
Функция УстановитьНастройку(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат УстановитьНастройкуВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика tool recall_memory. Выделена из ВспомнитьПамять, чтобы внешний
// Попытка/Исключение ловил любые непредвиденные ошибки.
//
Функция ВспомнитьПамятьВнутр(Знач Аргументы, Знач Контекст)

	// 1. DryRun (DISP-03): tool read-only, но контракт должен соблюдаться.
	Если ar_ToolDispatcher.ИзвлечьDryRun(Аргументы) Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("dry_run", Истина);
		Ответ.Вставить("results", Новый Массив);
		Ответ.Вставить("total", 0);
		Ответ.Вставить("message",
			НСтр("ru = 'DryRun: поиск не выполнен'; en = 'DryRun: search not performed'"));
		Возврат ar_JSON.ВЗначениеJSON(Ответ);
	КонецЕсли;

	// 2. Десериализация аргументов.
	ДанныеJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	// 3. Извлечение и валидация параметра pattern.
	Шаблон = СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "pattern", "")));
	Если ПустаяСтрока(Шаблон) Тогда
		Возврат ОшибочныйJSON("invalid arguments: pattern is required");
	КонецЕсли;
	Если СтрДлина(Шаблон) > МаксДлинаШаблонаПоиска() Тогда
		Возврат ОшибочныйJSON("invalid arguments: pattern too long (max "
			+ МаксДлинаШаблонаПоиска() + ")");
	КонецЕсли;

	// 4. Параметры с мягкой деградацией.
	ФильтрТипа = НормализоватьФильтрТипа(
		СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "type_filter", "all"))));
	Период     = НормализоватьПериод(
		СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "period", "all"))));
	ВключатьИсторию = ЗначениеПоКлючу(ДанныеJSON, "include_run_history", Ложь);
	Если ТипЗнч(ВключатьИсторию) <> Тип("Булево") Тогда
		ВключатьИсторию = Ложь;
	КонецЕсли;

	// 5. Определение владельца контекста (MEM-03): агент ИЛИ пользователь ИБ
	// в режиме «без агента» (UI-22).
	Владелец = ИзвлечьВладельцаИзКонтекста(Контекст);
	Агент = Владелец.Агент;
	ПользовательUUID = Владелец.ПользовательUUID;
	// Граничный случай (MEM-03 §Граничные случаи): и агент, и пользователь пусты -
	// полностью анонимный контекст (например, webhook без интерактивного инициатора).
	Если Не Владелец.ЕстьАгент И ПустаяСтрока(ПользовательUUID) Тогда
		Возврат ОшибочныйJSON("agent context missing");
	КонецЕсли;

	// 6. Вычисление дат периода.
	НачалоПериода = ВычислитьНачалоПериода(Период);
	КонецПериода  = Неопределено; // Всегда не ограничиваем сверху.

	// 7. Поиск через ar_Память.ИскатьЗапуски (владелец: агент либо пользователь ИБ).
	Результаты = ar_Память.ИскатьЗапуски(
		Агент, Шаблон, НачалоПериода, КонецПериода, ФильтрТипа, ВключатьИсторию, ПользовательUUID);

	// 8. Формирование ответа.
	МассивРезультатов = Новый Массив;
	Для Каждого Стр Из Результаты Цикл
		ЭлементРез = Новый Структура;
		ЭлементРез.Вставить("type",     Стр.Тип);
		ЭлементРез.Вставить("text",     Стр.Текст);
		ЭлементРез.Вставить("keywords", СокрЛП(Стр.КлючевыеСлова));
		// Обновлено → строка ISO 8601.
		Если ТипЗнч(Стр.Обновлено) = Тип("Дата") И ЗначениеЗаполнено(Стр.Обновлено) Тогда
			ЭлементРез.Вставить("updated", Формат(Стр.Обновлено, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Иначе
			ЭлементРез.Вставить("updated", "");
		КонецЕсли;
		ЭлементРез.Вставить("source",   Стр.Источник);
		МассивРезультатов.Добавить(ЭлементРез);
	КонецЦикла;

	Итого = МассивРезультатов.Количество();
	Если Итого = 0 Тогда
		Сообщение = НСтр("ru = 'Ничего не найдено'; en = 'Nothing found'");
	Иначе
		Сообщение = НСтр("ru = 'Найдено записей: '; en = 'Found: '") + Итого;
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("results", МассивРезультатов);
	Ответ.Вставить("total",   Итого);
	Ответ.Вставить("message", Сообщение);

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Максимальная длина шаблона поиска recall_memory (символов).
Функция МаксДлинаШаблонаПоиска()
	Возврат 200;
КонецФункции

// Нормализовать фильтр по типу записи. Допустимые: fact, preference, rule, note, all.
// Мягкая деградация: неизвестное значение → "all".
//
Функция НормализоватьФильтрТипа(Знач ФильтрТипа)
	Если ФильтрТипа = "fact"
		Или ФильтрТипа = "preference"
		Или ФильтрТипа = "rule"
		Или ФильтрТипа = "note"
		Или ФильтрТипа = "all" Тогда
		Возврат ФильтрТипа;
	КонецЕсли;
	Возврат "all";
КонецФункции

// Нормализовать значение периода поиска. Допустимые: day, week, month, quarter, year, all.
// Мягкая деградация: неизвестное → "all".
//
Функция НормализоватьПериод(Знач Период)
	Если Период = "day"
		Или Период = "week"
		Или Период = "month"
		Или Период = "quarter"
		Или Период = "year"
		Или Период = "all" Тогда
		Возврат Период;
	КонецЕсли;
	Возврат "all";
КонецФункции

// Вычислить нижнюю границу скользящего окна поиска от текущей даты сеанса.
// Реализует СКОЛЬЗЯЩЕЕ ОКНО (rolling window), а не начало календарного периода:
// например, "month" = сегодня минус 30 дней, не начало текущего месяца.
// Это намеренное поведение по спеке MEM-02 §Преобразование period в даты.
//
// Параметры:
//  Период - Строка - код окна: "day"(1 сут.), "week"(7 сут.), "month"(30 сут.),
//                   "quarter"(90 сут.), "year"(365 сут.), "all"(без ограничения).
//
// Возвращаемое значение:
//  Дата, Неопределено - дата начала скользящего окна или Неопределено (без фильтра).
//
Функция ВычислитьНачалоПериода(Знач Период)
	Если Период = "all" Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекДата = НачалоДня(ТекущаяДатаСеанса());
	СекундВДне = 86400; // Количество секунд в сутках.
	Если Период = "day" Тогда
		Возврат ТекДата - СекундВДне;          // скользящее окно: 1 сутки
	ИначеЕсли Период = "week" Тогда
		Возврат ТекДата - 7 * СекундВДне;      // скользящее окно: 7 суток
	ИначеЕсли Период = "month" Тогда
		Возврат ТекДата - 30 * СекундВДне;     // скользящее окно: 30 суток
	ИначеЕсли Период = "quarter" Тогда
		Возврат ТекДата - 90 * СекундВДне;     // скользящее окно: 90 суток
	ИначеЕсли Период = "year" Тогда
		Возврат ТекДата - 365 * СекундВДне;    // скользящее окно: 365 суток
	Иначе
		// Неизвестный код периода: мягкая деградация, без фильтра.
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Описание tool recall_memory для регистрации в ar_Tools (MEM-02).
//
Функция ОписаниеВспомнитьИнфо()

	// OpenAI tool-format (parameters, не Anthropic input_schema) - единый
	// контракт для всех LLM-провайдеров, включая OpenAI-совместимые локальные
	// (LM Studio и т.п.). Без него провайдер возвращает 400 на список tools
	// (см. ar_ToolUniversal.МанифестTool - образец контракта).
	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""recall_memory"",
	|    ""description"": ""Ищет ранее сохранённые факты, предпочтения, правила или заметки. Используй, когда нужно найти конкретную информацию по теме — не полагайся только на автоматически загруженный Memory Index."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""pattern""],
	|      ""properties"": {
	|        ""pattern"": {
	|          ""type"": ""string"",
	|          ""description"": ""Шаблон поиска (подстрока или ключевое слово). Максимум 200 символов."",
	|          ""maxLength"": 200
	|        },
	|        ""type_filter"": {
	|          ""type"": ""string"",
	|          ""enum"": [""fact"", ""preference"", ""rule"", ""note"", ""all""],
	|          ""description"": ""Фильтр по типу записи. По умолчанию all."",
	|          ""default"": ""all""
	|        },
	|        ""period"": {
	|          ""type"": ""string"",
	|          ""enum"": [""day"", ""week"", ""month"", ""quarter"", ""year"", ""all""],
	|          ""description"": ""Период поиска. По умолчанию all."",
	|          ""default"": ""all""
	|        },
	|        ""include_run_history"": {
	|          ""type"": ""boolean"",
	|          ""description"": ""Если true — также ищет по PayloadJSON событий аудита. Медленнее, включается только при < 5 результатах из memory index."",
	|          ""default"": false
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя",              "recall_memory");
	Описание.Вставить("Описание",
		НСтр("ru = 'Найти ранее сохранённые факты, предпочтения, правила или заметки в памяти агента.';
		|en = 'Find previously saved facts, preferences, rules, or notes in agent memory.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Найти ранее сохранённую заметку, факт';
		|en = 'Find a previously saved note or fact'"));
	Описание.Вставить("ОбщийМодуль",      "ar_ToolПамять");
	Описание.Вставить("ИмяПроцедуры",     "ВспомнитьПамять");
	Описание.Вставить("RiskLevel",        "Read");
	Описание.Вставить("ТребуетApproval",  Ложь);
	Описание.Вставить("Включён",          Истина);
	Описание.Вставить("Версия",           "1.0.0");
	Описание.Вставить("JSONManifest",     МанифестJSON);
	Возврат Описание;

КонецФункции

// Основная логика tool remember. Выделена из Запомнить, чтобы внешний
// Попытка/Исключение ловил любые непредвиденные ошибки.
//
Функция ЗапомнитьВнутр(Знач Аргументы, Знач Контекст)

	// 1. DryRun (DISP-03): при Истина — симулированный ответ без записи в ИБ.
	Если ar_ToolDispatcher.ИзвлечьDryRun(Аргументы) Тогда
		СимулированныеДанные = Новый Структура;
		СимулированныеДанные.Вставить("saved", Истина);
		СимулированныеДанные.Вставить("ref", "");
		СимулированныеДанные.Вставить("message",
			НСтр("ru = 'DryRun: запись не создана'; en = 'DryRun: record not created'"));
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("remember", СимулированныеДанные);
	КонецЕсли;

	// 2. Десериализация аргументов.
	ДанныеJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	// 3. Извлечение и валидация аргументов.
	Текст = СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "text", "")));
	Если ПустаяСтрока(Текст) Тогда
		Возврат ОшибочныйJSON("invalid arguments: text is required");
	КонецЕсли;
	Если СтрДлина(Текст) > МаксДлинаТекстаПамяти() Тогда
		Возврат ОшибочныйJSON("invalid arguments: text too long (max "
			+ МаксДлинаТекстаПамяти() + ")");
	КонецЕсли;

	ТипЗаписи = НормализоватьТипЗаписи(
		СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "type", "note"))));

	КлючевыеСлова = СокрЛП(Строка(ЗначениеПоКлючу(ДанныеJSON, "keywords", "")));
	Если СтрДлина(КлючевыеСлова) > МаксДлинаКлючевыхСлов() Тогда
		// Усечение до максимальной длины, не ошибка.
		КлючевыеСлова = Лев(КлючевыеСлова, МаксДлинаКлючевыхСлов());
	КонецЕсли;

	// 4. Определение владельца контекста (MEM-03): агент ИЛИ пользователь ИБ
	// в режиме «без агента» (UI-22).
	Владелец = ИзвлечьВладельцаИзКонтекста(Контекст);
	Агент = Владелец.Агент;
	ЕстьАгент = Владелец.ЕстьАгент;
	ПользовательUUID = Владелец.ПользовательUUID;
	// Граничный случай (MEM-03 §Граничные случаи): и агент, и пользователь пусты -
	// полностью анонимный контекст (например, webhook без интерактивного инициатора).
	Если Не ЕстьАгент И ПустаяСтрока(ПользовательUUID) Тогда
		Возврат ОшибочныйJSON("agent context missing");
	КонецЕсли;

	ВладелецКлюч = ar_Память.СформироватьВладелецКлюч(Агент, ПользовательUUID);

	// 5. Извлечение идентификатора запуска.
	ИдЗапуска = "";
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("RunId", ИдЗапуска);
	КонецЕсли;
	ИдЗапуска = ?(ТипЗнч(ИдЗапуска) = Тип("Строка"), ИдЗапуска, "");

	// 6. Создание объекта справочника в транзакции.
	НовыйОбъект = Неопределено;
	НачатьТранзакцию();
	Попытка
		НовыйОбъект = Справочники.ar_ПамятьАгента.СоздатьЭлемент();
		// ar_Агент заполняется только в агентном режиме (ПустаяСсылка для
		// no-agent - реквизит больше не обязателен, FillChecking=DontCheck, MEM-03).
		НовыйОбъект.ar_Агент         = ?(ЕстьАгент, Агент, Справочники.ar_Агенты.ПустаяСсылка());
		НовыйОбъект.ar_ВладелецКлюч  = ВладелецКлюч;
		НовыйОбъект.ar_Текст         = Текст;
		НовыйОбъект.ar_Тип           = ТипЗаписи;
		НовыйОбъект.ar_КлючевыеСлова = КлючевыеСлова;
		НовыйОбъект.ar_Источник      = "manual";
		НовыйОбъект.ar_ИсточникRunId = Лев(ИдЗапуска, МаксДлинаИдЗапуска());
		НовыйОбъект.ar_Создано       = ТекущаяДатаСеанса();
		НовыйОбъект.ar_Обновлено     = ТекущаяДатаСеанса();
		// Наименование: первые N символов текста (автозаполняется в ПередЗаписью
		// объектного модуля, но устанавливаем явно как fallback).
		НовыйОбъект.Наименование      = Лев(Текст, МаксДлинаНаименования());
		// Справочник записывается без параметров (параметры только у документов).
		НовыйОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	// 7. Формирование ответа.
	// Навигационная ссылка формируется после успешной фиксации транзакции.
	НавСсылка = "";
	Если НовыйОбъект <> Неопределено Тогда
		Попытка
			НавСсылка = ПолучитьНавигационнуюСсылку(НовыйОбъект.Ссылка);
		Исключение
			// Навигационная ссылка — удобство, не критика; не прерываем при ошибке.
			НавСсылка = "";
		КонецПопытки;
	КонецЕсли;

	РезультатОтвет = Новый Структура;
	РезультатОтвет.Вставить("saved", Истина);
	РезультатОтвет.Вставить("ref", НавСсылка);
	РезультатОтвет.Вставить("message",
		НСтр("ru = 'Запомнено'; en = 'Remembered'"));

	Возврат ar_JSON.ВЗначениеJSON(РезультатОтвет);

КонецФункции

// Максимальная длина поля text (символов).
Функция МаксДлинаТекстаПамяти()
	Возврат 1000;
КонецФункции

// Максимальная длина поля keywords (символов).
Функция МаксДлинаКлючевыхСлов()
	Возврат 300;
КонецФункции

// Максимальная длина поля ar_ИсточникRunId (символов).
Функция МаксДлинаИдЗапуска()
	Возврат 36;
КонецФункции

// Максимальная длина наименования (первые N символов текста).
Функция МаксДлинаНаименования()
	Возврат 50;
КонецФункции

// Нормализовать тип записи памяти. Допустимые значения: fact, preference, rule, note.
// Мягкая деградация: неизвестный тип → "note" (спека §Граничные случаи).
//
Функция НормализоватьТипЗаписи(Знач ТипЗаписи)
	Если ТипЗаписи = "fact"
		Или ТипЗаписи = "preference"
		Или ТипЗаписи = "rule"
		Или ТипЗаписи = "note" Тогда
		Возврат ТипЗаписи;
	КонецЕсли;
	Возврат "note";
КонецФункции

// Извлекает владельца записи/поиска памяти из КонтекстЗапуска (MEM-03).
// Единая точка для ВспомнитьПамятьВнутр/ЗапомнитьВнутр - устраняет дублирование
// логики определения владельца (агент либо пользователь ИБ в режиме «без
// агента», UI-22). Приоритет у агента: если задана непустая ссылка на
// ar_Агенты, ПользовательUUID из результата не используется вызывающей
// стороной для формирования ключа (см. ar_Память.СформироватьВладелецКлюч),
// но возвращается как есть - для передачи дальше в ar_Память.ИскатьЗапуски.
//
// Параметры:
//  Контекст - Структура, Неопределено - КонтекстЗапуска {Агент, ПользовательUUID, ...}.
//
// Возвращаемое значение:
//  Структура {Агент - СправочникСсылка.ar_Агенты, Неопределено;
//             ПользовательUUID - Строка (СокрЛП, "" по умолчанию);
//             ЕстьАгент - Булево - Истина, если Агент - непустая ссылка на ar_Агенты}.
//
Функция ИзвлечьВладельцаИзКонтекста(Знач Контекст)

	Агент = Неопределено;
	ПользовательUUID = "";
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Агент", Агент);
		Контекст.Свойство("ПользовательUUID", ПользовательUUID);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Агент", Агент);
	Результат.Вставить("ЕстьАгент", Агент <> Неопределено
		И ТипЗнч(Агент) = Тип("СправочникСсылка.ar_Агенты")
		И Не Агент.Пустая());
	Результат.Вставить("ПользовательUUID",
		СокрЛП(?(ТипЗнч(ПользовательUUID) = Тип("Строка"), ПользовательUUID, "")));

	Возврат Результат;

КонецФункции

// Безопасно получить значение из Соответствия по ключу с дефолтом.
//
Функция ЗначениеПоКлючу(Знач Соответствие, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(Соответствие) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Соответствие.Получить(Ключ);
	Возврат ?(Значение = Неопределено, Дефолт, Значение);
КонецФункции

// JSON-строка ошибки-observation: {"error":"<текст>"}.
//
Функция ОшибочныйJSON(Знач ТекстОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""tool_error""}", Результат);
КонецФункции

// JSON-строка ошибки-observation с уточнением: {"error":"<код>","detail":"<деталь>"}.
// Парная к ОшибочныйJSON; тот же контракт, что и в ar_ToolФинансы /
// ar_ToolКоммуникации - код ошибки машиночитаемый, detail для оператора и LLM.
//
Функция ОшибочныйJSONСДеталью(Знач КодОшибки, Знач Деталь)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(КодОшибки) = Тип("Строка"), КодОшибки, ""));
	Объект.Вставить("detail", ?(ТипЗнч(Деталь) = Тип("Строка"), Деталь, Строка(Деталь)));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""tool_error""}", Результат);
КонецФункции

// Описание tool remember для регистрации в ar_Tools.
//
Функция ОписаниеЗапомнитьИнфо()

	// OpenAI tool-format (parameters, не Anthropic input_schema) - единый
	// контракт для всех LLM-провайдеров, включая OpenAI-совместимые локальные
	// (LM Studio и т.п.). Без него провайдер возвращает 400 на список tools
	// (см. ar_ToolUniversal.МанифестTool - образец контракта).
	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""remember"",
	|    ""description"": ""Сохраняет факт, предпочтение, правило или заметку в долгосрочную память агента."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""text""],
	|      ""properties"": {
	|        ""text"": {
	|          ""type"": ""string"",
	|          ""description"": ""Текст для запоминания. Максимум 1000 символов."",
	|          ""maxLength"": 1000
	|        },
	|        ""type"": {
	|          ""type"": ""string"",
	|          ""enum"": [""fact"", ""preference"", ""rule"", ""note""],
	|          ""description"": ""Тип записи: fact — факт, preference — предпочтение, rule — правило, note — заметка."",
	|          ""default"": ""note""
	|        },
	|        ""keywords"": {
	|          ""type"": ""string"",
	|          ""description"": ""Ключевые слова через запятую для ускорения поиска (опционально). Максимум 300 символов."",
	|          ""maxLength"": 300
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя",               "remember");
	Описание.Вставить("Описание",
		НСтр("ru = 'Запомнить факт, предпочтение, правило или заметку для будущих запусков агента.';
		|en = 'Remember a fact, preference, rule, or note for future agent runs.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Сохранить факт, заметку, предпочтение на будущее';
		|en = 'Save a fact, note or preference for later'"));
	Описание.Вставить("ОбщийМодуль",       "ar_ToolПамять");
	Описание.Вставить("ИмяПроцедуры",      "Запомнить");
	Описание.Вставить("RiskLevel",         "Write");
	Описание.Вставить("ТребуетApproval",   Ложь);
	Описание.Вставить("Включён",           Истина);
	Описание.Вставить("Версия",            "1.0.0");
	Описание.Вставить("JSONManifest",      МанифестJSON);
	Возврат Описание;

КонецФункции

// Создать или обновить одну запись в ar_Tools по описанию.
// Ищет по ar_Имя среди непомеченных. При нахождении — обновляет, иначе создаёт.
//
Процедура ЗарегистрироватьОдинИнструмент(Знач Описание, Статистика)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", Описание.Имя);

	Выборка = Запрос.Выполнить().Выбрать();

	НачатьТранзакцию();
	Попытка
		Если Выборка.Следующий() Тогда
			ОбъектИнструмент = Выборка.Ссылка.ПолучитьОбъект();
			Статистика.Обновлено = Статистика.Обновлено + 1;
		Иначе
			ОбъектИнструмент = Справочники.ar_Tools.СоздатьЭлемент();
			Статистика.Создано = Статистика.Создано + 1;
		КонецЕсли;

		ОбъектИнструмент.Наименование     = Описание.Имя;
		ОбъектИнструмент.ar_Имя          = Описание.Имя;
		ОбъектИнструмент.ar_Описание     = Описание.Описание;
		ОбъектИнструмент.ar_КраткоеОписание = Описание.КраткоеОписание;
		ОбъектИнструмент.ar_ОбщийМодуль  = Описание.ОбщийМодуль;
		ОбъектИнструмент.ar_ИмяПроцедуры = Описание.ИмяПроцедуры;
		ОбъектИнструмент.ar_ТребуетApproval = Описание.ТребуетApproval;
		ОбъектИнструмент.ar_Включён      = Описание.Включён;
		ОбъектИнструмент.ar_Версия       = Описание.Версия;
		ОбъектИнструмент.ar_JSONManifest = Описание.JSONManifest;

		// Установка RiskLevel через перечисление.
		ОбъектИнструмент.ar_RiskLevel = ПолучитьУровеньРиска(Описание.RiskLevel);

		// Справочник записывается без параметров.
		ОбъектИнструмент.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Получить ссылку перечисления ar_RiskLevel по строковому имени.
// При неизвестном имени возвращает Read (безопасный дефолт).
//
Функция ПолучитьУровеньРиска(Знач ИмяЗначения)
	Если ТипЗнч(ИмяЗначения) <> Тип("Строка") Тогда
		Возврат Перечисления.ar_RiskLevel.Read;
	КонецЕсли;
	Для Каждого ЗначМД Из Метаданные.Перечисления.ar_RiskLevel.ЗначенияПеречисления Цикл
		Если ЗначМД.Имя = ИмяЗначения Тогда
			Возврат Перечисления.ar_RiskLevel[ЗначМД.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Перечисления.ar_RiskLevel.Read;
КонецФункции

#КонецОбласти

#Область НастройкиАгента

// Основная логика get_settings (PAY-01). Выделена из ПолучитьНастройки, чтобы
// внешний Попытка/Исключение ловил любые непредвиденные ошибки.
//
Функция ПолучитьНастройкиВнутр(Знач Аргументы, Знач Контекст)

	// DryRun (DISP-03): read-only, но контракт диспетчера соблюдается.
	Если ar_ToolDispatcher.ИзвлечьDryRun(Аргументы) Тогда
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("get_settings", Неопределено);
	КонецЕсли;

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Объект = Новый Соответствие;
	КонецЕсли;

	Ключ = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "key", "")));
	ВключатьВыключенные = (ЗначениеПоКлючу(Объект, "include_disabled", Ложь) = Истина);

	Запрос = Новый Запрос;
	Если ПустаяСтрока(Ключ) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Настройки.Ссылка КАК Ссылка,
			|	Настройки.Код КАК Код,
			|	Настройки.Наименование КАК Наименование,
			|	Настройки.ar_Описание КАК Описание,
			|	Настройки.ar_Включено КАК Включено,
			|	Настройки.ar_Значение КАК Значение,
			|	Настройки.ar_ЗначениеСтрока КАК ЗначениеСтрока
			|ИЗ
			|	Справочник.ar_ДополнительныеНастройки КАК Настройки
			|ГДЕ
			|	НЕ Настройки.ПометкаУдаления
			|	И (&ВключатьВыключенные ИЛИ Настройки.ar_Включено)
			|УПОРЯДОЧИТЬ ПО
			|	Настройки.Код";
		Запрос.УстановитьПараметр("ВключатьВыключенные", ВключатьВыключенные);
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Настройки.Ссылка КАК Ссылка,
			|	Настройки.Код КАК Код,
			|	Настройки.Наименование КАК Наименование,
			|	Настройки.ar_Описание КАК Описание,
			|	Настройки.ar_Включено КАК Включено,
			|	Настройки.ar_Значение КАК Значение,
			|	Настройки.ar_ЗначениеСтрока КАК ЗначениеСтрока
			|ИЗ
			|	Справочник.ar_ДополнительныеНастройки КАК Настройки
			|ГДЕ
			|	НЕ Настройки.ПометкаУдаления
			|	И Настройки.Код = &Ключ
			|	И (&ВключатьВыключенные ИЛИ Настройки.ar_Включено)";
		Запрос.УстановитьПараметр("Ключ", Ключ);
		Запрос.УстановитьПараметр("ВключатьВыключенные", ВключатьВыключенные);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не ПустаяСтрока(Ключ) И Выборка.Количество() = 0 Тогда
		Возврат ОшибочныйJSON("setting_not_found: available keys: " + ДоступныеКлючиНастроекСтрокой());
	КонецЕсли;

	СписокНастроек = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СписокНастроек.Добавить(ОписаниеОднойНастройкиДляОтвета(Выборка));
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("settings", СписокНастроек);
	Ответ.Вставить("total_found", СписокНастроек.Количество());

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Собирает элемент ответа get_settings по одной строке выборки запроса
// (скалярная часть + при непустой ТЧ - values).
//
// kind определяется по факту непустого списка (values) - настройка-список.
// Иначе - "scalar": Булево=Ложь/Число=0/пустая Дата - ЗАКОННЫЕ скалярные
// значения (та же логика, что ar_Настройки.ЗначениеНастройки - см. её
// докстринг), проверять "не равно ли дефолту типа" здесь нельзя.
//
Функция ОписаниеОднойНастройкиДляОтвета(Знач ВыборкаСтроки)

	СписокЗначений = ar_Настройки.СписокЗначений(ВыборкаСтроки.Код);
	МассивОтвет = Новый Массив;
	Для Каждого Элемент Из СписокЗначений Цикл
		СтрокаЭлемент = Новый Структура;
		// Ссылочные значения (ar_Значение имеет тип ЛюбаяСсылка) отдаём
		// навигационной ссылкой, а не самим объектом: сериализатор ar_JSON
		// ссылку не разбирает, а LLM должна получать значение в том же формате,
		// в котором может вернуть его обратно в set_setting (DoD D8).
		СтрокаЭлемент.Вставить("value", ЗначениеНастройкиДляОтвета(Элемент));
		СтрокаЭлемент.Вставить("value_presentation", Строка(Элемент));
		МассивОтвет.Добавить(СтрокаЭлемент);
	КонецЦикла;

	ЭтоСписок = (МассивОтвет.Количество() > 0);

	ЗначениеОтвет = Неопределено;
	ПредставлениеОтвет = "";
	Если Не ЭтоСписок Тогда
		Если Не ПустаяСтрока(ВыборкаСтроки.ЗначениеСтрока) Тогда
			ЗначениеОтвет = ВыборкаСтроки.ЗначениеСтрока;
			ПредставлениеОтвет = ВыборкаСтроки.ЗначениеСтрока;
		ИначеЕсли ТипЗнч(ВыборкаСтроки.Значение) = Тип("Дата") Тогда
			ЗначениеОтвет = ar_Утилиты.ФорматДата(ВыборкаСтроки.Значение);
			ПредставлениеОтвет = ar_Утилиты.ФорматДатаПользователю(ВыборкаСтроки.Значение);
		Иначе
			ЗначениеОтвет = ЗначениеНастройкиДляОтвета(ВыборкаСтроки.Значение);
			ПредставлениеОтвет = Строка(ВыборкаСтроки.Значение);
		КонецЕсли;
	КонецЕсли;

	Элемент = Новый Структура;
	Элемент.Вставить("key", ВыборкаСтроки.Код);
	Элемент.Вставить("name", ВыборкаСтроки.Наименование);
	Элемент.Вставить("description", ВыборкаСтроки.Описание);
	Элемент.Вставить("kind", ?(ЭтоСписок, "list", "scalar"));
	Элемент.Вставить("value", ЗначениеОтвет);
	Элемент.Вставить("value_presentation", ПредставлениеОтвет);
	Элемент.Вставить("values", МассивОтвет);
	Элемент.Вставить("enabled", ВыборкаСтроки.Включено);

	Возврат Элемент;

КонецФункции

// Приводит значение настройки к виду, пригодному для JSON-ответа tool.
//
// Ссылочные значения (реквизит ar_Значение имеет тип ЛюбаяСсылка - администратор
// выбирает объект подбором в форме) сериализатор ar_JSON не разбирает, поэтому
// отдаём их навигационной ссылкой "e1cib/data/...". Это тот же формат, который
// принимает set_setting - LLM может вернуть полученное значение обратно без
// преобразований (DoD D8/D9). Скаляры (Булево/Число/Строка) возвращаются как есть.
//
// Параметры:
//  Значение - Произвольный - значение из ar_Значение / ar_ЗначениеСтрока.
//
// Возвращаемое значение:
//  Произвольный - навигационная ссылка (Строка) для ссылочных типов,
//                 исходное значение для остальных.
//
Функция ЗначениеНастройкиДляОтвета(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	// Осталось ссылочное значение - отдаём навигационной ссылкой. Утилита
	// сама возвращает "" на неподдерживаемых типах, исключение не бросает.
	Возврат ar_Утилиты.НавигационнаяСсылкаОбъекта(Значение);

КонецФункции

// Список всех Код существующих настроек (для подсказки в ошибке
// setting_not_found), через запятую.
//
Функция ДоступныеКлючиНастроекСтрокой()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Настройки.Код КАК Код
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки КАК Настройки
		|ГДЕ
		|	НЕ Настройки.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Настройки.Код";

	Ключи = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключи.Добавить(Выборка.Код);
	КонецЦикла;

	Если Ключи.Количество() = 0 Тогда
		Возврат НСтр("ru = '(нет ни одной настройки)'; en = '(no settings yet)'");
	КонецЕсли;

	Возврат СтрСоединить(Ключи, ", ");

КонецФункции

// Основная логика set_setting, стадия 1 (PAY-01). Выделена из
// УстановитьНастройку, чтобы внешний Попытка/Исключение ловил любые
// непредвиденные ошибки.
//
// Алгоритм:
//  1. DryRun (DISP-03).
//  2. Десериализация + валидация: key обязателен, ровно одно из value/values.
//  3. Ключ существует ИЛИ create_if_missing=true, иначе setting_not_found.
//  4. Каждое значение (скалярное value ИЛИ каждый элемент values), которое
//     ВЫГЛЯДИТ как навигационная ссылка (ВыглядитКакНавигационнаяСсылка),
//     обязано разыменоваться (ar_Утилиты.ОбъектИзНавигационнойСсылки) - иначе
//     value_not_resolvable без постановки в очередь. Проверка ОБЩАЯ - НЕ
//     завязана на конкретный Ключ (Замечания ревью 1, желательное замечание):
//     любая будущая ссылочная настройка через этот же справочник получает
//     защиту от "мусор в value тихо ляжет как обычный текст" бесплатно.
//     Обычные строки/числа/даты/булевы, не похожие на ссылку, проходят без
//     попытки разыменования - тексту настройки формат ссылки не грозит.
//  5. Payload {action, key, value/values, old_value} → ar_Approval.Поставить.
//
Функция УстановитьНастройкуВнутр(Знач Аргументы, Знач Контекст)

	Если ar_ToolDispatcher.ИзвлечьDryRun(Аргументы) Тогда
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("set_setting", Неопределено);
	КонецЕсли;

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	Ключ = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "key", "")));
	Если ПустаяСтрока(Ключ) Тогда
		Возврат ОшибочныйJSON("invalid arguments: key is required");
	КонецЕсли;

	ЕстьValue = (Объект.Получить("value") <> Неопределено);
	ЕстьValues = (Объект.Получить("values") <> Неопределено);
	Если ЕстьValue = ЕстьValues Тогда
		// Оба заданы или ни одного - ровно одно обязательно.
		Возврат ОшибочныйJSON("invalid arguments: exactly one of value/values is required");
	КонецЕсли;

	СоздатьЕслиНеНайден = (ЗначениеПоКлючу(Объект, "create_if_missing", Ложь) = Истина);

	ТекущаяЗаписьЕсть = (НайтиСсылкуНастройкиПоКоду(Ключ) <> Неопределено);
	Если Не ТекущаяЗаписьЕсть И Не СоздатьЕслиНеНайден Тогда
		Возврат ОшибочныйJSONСДеталью("setting_not_found",
			"key """ + Ключ + """ not found; pass create_if_missing=true to create it");
	КонецЕсли;

	// Общая проверка ссылок - НЕ завязана на имя ключа, применяется одинаково
	// к скалярному value и к каждому элементу values (см. докстринг выше).
	Если ЕстьValue Тогда
		СтрокаЗначения = СокрЛП(Строка(Объект.Получить("value")));
		Если ВыглядитКакНавигационнаяСсылка(СтрокаЗначения)
			И ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаЗначения) = Неопределено Тогда
			Возврат ОшибочныйJSONСДеталью("value_not_resolvable", СтрокаЗначения);
		КонецЕсли;
	Иначе
		Массив = Объект.Получить("values");
		Если ТипЗнч(Массив) <> Тип("Массив") Тогда
			Возврат ОшибочныйJSON("invalid arguments: values must be an array");
		КонецЕсли;
		Для Каждого Элемент Из Массив Цикл
			СтрокаЭлемента = СокрЛП(Строка(Элемент));
			Если ВыглядитКакНавигационнаяСсылка(СтрокаЭлемента)
				И ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаЭлемента) = Неопределено Тогда
				Возврат ОшибочныйJSONСДеталью("value_not_resolvable", СтрокаЭлемента);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// old_value - для читаемости карточки approval (ar_Диалог.ЧитаемыеПараметрыApproval).
	СтараяЗапись = НайтиЗаписьНастройкиПоКодуДляPayload(Ключ);

	Payload = Новый Структура;
	Payload.Вставить("action", "set_setting");
	Payload.Вставить("key", Ключ);
	Если ЕстьValue Тогда
		Payload.Вставить("value", Объект.Получить("value"));
	Иначе
		Payload.Вставить("values", Объект.Получить("values"));
	КонецЕсли;
	Payload.Вставить("create_if_missing", СоздатьЕслиНеНайден);
	Payload.Вставить("old_value", СтараяЗапись);

	КонтекстЗапуска = ?(ТипЗнч(Контекст) = Тип("Структура"), Контекст, Новый Структура);
	IdempotencyKey = ar_ToolDispatcher.ИзвлечьIdempotencyKey(Аргументы);

	Действие = Новый Структура;
	Действие.Вставить("Имя", "set_setting");
	Действие.Вставить("ИдВызова", "");
	Действие.Вставить("Аргументы", Payload);
	Действие.Вставить("IdempotencyKey", IdempotencyKey);
	Действие.Вставить("RiskLevel", "Write");

	ApprovalИД = ar_Approval.Поставить(КонтекстЗапуска, Действие);

	Результат = Новый Структура;
	Результат.Вставить("status", "queued_for_approval");
	Результат.Вставить("approval_id", ApprovalИД);
	Результат.Вставить("payload", Payload);

	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Эвристика "строка похожа на навигационную ссылку объекта ИБ" - используется
// set_setting (стадия 1), чтобы понять, нужно ли вообще пытаться разыменовать
// значение (ar_Утилиты.ОбъектИзНавигационнойСсылки), а не проверять КАЖДУЮ
// строку/число/дату/булево как потенциальную ссылку. Признак - формат
// "e1cib/data/...?ref=..." (единственный формат, который умеет разбирать
// ar_Утилиты.ОбъектИзНавигационнойСсылки; голый UUID без класса объекта
// разыменовать в общем случае невозможно - тип объекта неизвестен заранее,
// поэтому такие строки НЕ считаются похожими на ссылку и проходят как текст).
//
// Параметры:
//  Знач Строка - Строка - проверяемое значение (уже приведено к строке и СокрЛП).
//
// Возвращаемое значение:
//  Булево.
//
Функция ВыглядитКакНавигационнаяСсылка(Знач Строка)

	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(НРег(Строка), "e1cib/") > 0;

КонецФункции

// Ссылка на элемент справочника по Код (без учёта ar_Включено - для проверки
// "существует ли ключ вообще"). Неопределено, если не найден.
//
Функция НайтиСсылкуНастройкиПоКоду(Знач Ключ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки КАК Настройки
		|ГДЕ
		|	Настройки.Код = &Ключ
		|	И НЕ Настройки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ключ", Ключ);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Текущее значение настройки (для payload.old_value - читаемость карточки
// approval). Best-effort: любая ошибка чтения - пустая строка, не блокирует
// постановку в очередь.
//
Функция НайтиЗаписьНастройкиПоКодуДляPayload(Знач Ключ)

	Попытка
		Маркер = Неопределено;
		Значение = ar_Настройки.ЗначениеНастройки(Ключ, Маркер);
		Если Значение <> Маркер Тогда
			Возврат Строка(Значение);
		КонецЕсли;
		Список = ar_Настройки.СписокЗначений(Ключ);
		Если Список.Количество() > 0 Тогда
			Возврат СтрСоединить(Список, ", ");
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ИсполнениеУстановкиНастройки

// PAY-01: стадия 2 approved-действия set_setting. Вызывается из
// ar_Approval.ИсполнитьApprovedДействие после перевода записи очереди в
// approved. Разбирает Payload, вызывает ar_Настройки.УстановитьЗначение/
// УстановитьСписок. Работает в правах пользователя, подтвердившего действие -
// привилегированный режим НЕ поднимается (тот же контракт, что и
// ar_ToolКоммуникации.ИсполнитьПодготовкуПисьма).
//
// Параметры:
//  ApprovalId        - Строка - идентификатор записи очереди (для лога).
//  ActionPayloadJSON - Строка - JSON, сохранённый в ar_ОчередьApproval.
//
// Возвращаемое значение:
//  Структура - {Выполнено: Булево, Сообщение: Строка, DocumentRef: Неопределено} -
//  DocumentRef не применим (справочник, не документ), тот же контракт, что
//  ar_Approval.ИсполнитьApprovedДействие ожидает от всех исполнителей.
//
Функция ИсполнитьУстановкуНастройки(Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Итог = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	РазобраноActionPayload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Если ТипЗнч(РазобраноActionPayload) <> Тип("Соответствие") Тогда
		Итог.Сообщения.Добавить("invalid_action_payload_json");
		Возврат Итог;
	КонецЕсли;

	ToolName = СокрЛП(Строка(ЗначениеПоКлючу(РазобраноActionPayload, "tool_name", "")));
	Если ToolName <> "set_setting" Тогда
		Итог.Сообщения.Добавить("no_executor_for_action:" + ToolName);
		Возврат Итог;
	КонецЕсли;

	Payload = ЗначениеПоКлючу(РазобраноActionPayload, "arguments", Неопределено);
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Итог.Сообщения.Добавить("invalid_action_payload_arguments");
		Возврат Итог;
	КонецЕсли;

	Ключ = СокрЛП(Строка(ЗначениеПоКлючу(Payload, "key", "")));
	Если ПустаяСтрока(Ключ) Тогда
		Итог.Сообщения.Добавить("key_required");
		Возврат Итог;
	КонецЕсли;

	СоздатьЕслиНеНайден = (ЗначениеПоКлючу(Payload, "create_if_missing", Ложь) = Истина);

	Попытка

		Если Payload.Получить("values") <> Неопределено Тогда
			МассивЗначений = Payload.Получить("values");
			Если ТипЗнч(МассивЗначений) <> Тип("Массив") Тогда
				Итог.Сообщения.Добавить("invalid_values");
				Возврат Итог;
			КонецЕсли;
			ar_Настройки.УстановитьСписок(Ключ, МассивЗначений, СоздатьЕслиНеНайден, Ключ);
		Иначе
			Значение = Payload.Получить("value");
			ar_Настройки.УстановитьЗначение(Ключ, Значение, СоздатьЕслиНеНайден, Ключ);
		КонецЕсли;

	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Сообщения.Добавить(ТекстОшибки);
		ar_СлужебныйЛог.Записать("ar_ToolПамять.ИсполнитьУстановкуНастройки",
			"set_setting_write_failed",
			"ApprovalId=" + ApprovalId + ": " + ТекстОшибки, "Ошибка");
		Возврат Итог;
	КонецПопытки;

	Итог.Выполнено = Истина;
	ar_СлужебныйЛог.Записать("ar_ToolПамять.ИсполнитьУстановкуНастройки",
		"set_setting_written", "ApprovalId=" + ApprovalId + "; key=" + Ключ, "Информация");

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область РегистрацияTools

// Описание tool get_settings для реестра ar_Tools.
Функция ОписаниеToolПолучитьНастройки()

	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""get_settings"",
	|    ""description"": ""Возвращает настройки расширения из справочника ar_ДополнительныеНастройки. Без key - список всех активных настроек; с key - конкретную настройку."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""properties"": {
	|        ""key"": {
	|          ""type"": ""string"",
	|          ""description"": ""Ключ конкретной настройки (опционально). Без него возвращается список всех.""
	|        },
	|        ""include_disabled"": {
	|          ""type"": ""boolean"",
	|          ""description"": ""Включить выключенные (ar_Включено=Ложь) настройки в выдачу. По умолчанию false."",
	|          ""default"": false
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя", "get_settings");
	Описание.Вставить("Описание",
		НСтр("ru = 'Читает настройки расширения (справочник ar_ДополнительныеНастройки).';
		|en = 'Reads extension settings (ar_ДополнительныеНастройки catalog).'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Прочитать настройки AgentRunner';
		|en = 'Read AgentRunner settings'"));
	Описание.Вставить("ОбщийМодуль", "ar_ToolПамять");
	Описание.Вставить("ИмяПроцедуры", "ПолучитьНастройки");
	Описание.Вставить("RiskLevel", "Read");
	Описание.Вставить("ТребуетApproval", Ложь);
	Описание.Вставить("Включён", Истина);
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("JSONManifest", МанифестJSON);
	Возврат Описание;

КонецФункции

// Описание tool set_setting для реестра ar_Tools.
Функция ОписаниеToolУстановитьНастройку()

	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""set_setting"",
	|    ""description"": ""Изменяет настройку расширения (ar_ДополнительныеНастройки). Требует подтверждения оператора. Передай ровно одно из value/values."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""key""],
	|      ""properties"": {
	|        ""key"": {
	|          ""type"": ""string"",
	|          ""description"": ""Ключ настройки (Код элемента ar_ДополнительныеНастройки).""
	|        },
	|        ""value"": {
	|          ""description"": ""Скалярное значение (строка/число/дата/булево). Взаимоисключимо с values.""
	|        },
	|        ""values"": {
	|          ""type"": ""array"",
	|          ""description"": ""Список значений (перезаписывает табличную часть целиком). Взаимоисключимо с value.""
	|        },
	|        ""create_if_missing"": {
	|          ""type"": ""boolean"",
	|          ""description"": ""Создать настройку, если ключ не существует. По умолчанию false."",
	|          ""default"": false
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя", "set_setting");
	Описание.Вставить("Описание",
		НСтр("ru = 'Изменяет настройку расширения. Действие уходит на подтверждение оператору.';
		|en = 'Changes an extension setting. The action requires operator approval.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Изменить параметр настройки AgentRunner';
		|en = 'Change an AgentRunner setting value'"));
	Описание.Вставить("ОбщийМодуль", "ar_ToolПамять");
	Описание.Вставить("ИмяПроцедуры", "УстановитьНастройку");
	Описание.Вставить("RiskLevel", "Write");
	Описание.Вставить("ТребуетApproval", Истина);
	Описание.Вставить("Включён", Истина);
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("JSONManifest", МанифестJSON);
	Возврат Описание;

КонецФункции

#КонецОбласти
