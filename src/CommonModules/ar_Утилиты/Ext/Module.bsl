////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Утилиты (Утилиты AgentRunner).
//
// Публичные строковые и сервисные функции AgentRunner, не имеющие внешних зависимостей
// от ИБ и применимые как на сервере, так и на клиенте.
//
// SEC-02: первая публичная функция — МаскироватьСекреты — маскирует API-ключи
// и Bearer-токены в произвольной строке. Используется всеми точками вывода
// (журнал регистрации, аудит-регистры, observation к LLM) перед сохранением
// или передачей наружу, чтобы исключить утечку секретов.
//
// UTIL-04 расширяет модуль четырьмя группами вспомогательных функций:
//   * UUID:           НовыйUUID, ЭтоUUID
//   * Навигация:      НавигационнаяСсылкаОбъекта, ОбъектИзНавигационнойСсылки (только сервер)
//   * Форматирование: ФорматДата, ФорматЧисло, ОбрезатьДо
//   * Маскировка PII: МаскироватьINN (вызывается только в compliance-режиме)
//
// Дальнейшая задача UTIL-05 добавит ОчиститьОшибкуДляLLM поверх МаскироватьСекреты.
//
// Свойства модуля: Сервер + Клиент (управляемое приложение), без привилегий,
// без повторного использования. Логика чистая (без состояния, без обращений
// к ИБ) — клиент-серверная доступность безопасна.
//
// См. спеку: .docs/specs/SEC-02.md, Plan §3.9, §3.11.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Маскирует секреты в произвольной строке (для использования в сообщениях об ошибках,
// журнале регистрации, observation к LLM, аудит-регистрах).
//
// Покрываемые паттерны:
//   * "sk-XXXX"     → "sk-***"     (OpenAI и совместимые форматы вида sk-, sk-proj- и т.п.)
//   * "ya29.XXXX"   → "ya29.***"   (Google Cloud access tokens)
//   * "Bearer XXX"  → "Bearer ***" (регистронезависимо)
//
// Параметры:
//   Текст - Строка - произвольный текст. Не-строка, Неопределено и пустая строка → "".
//
// Возвращаемое значение:
//   Строка - текст с замаскированными секретами, без изменения длины.
//            Функция не выбрасывает исключений (вызывается из блоков Исключение).
//            Обрезка длины - забота вызывающего кода (см. ОбрезатьДо), а не этой
//            функции: обрезка ЗДЕСЬ ломала бы сериализованный JSON произвольных
//            payload (например, ar_AuditСобытия.БезопасноЗамаскироватьСтроку
//            применяет маскирование к целому PayloadJSON события) - длинный,
//            но легитимный текст (ответ LLM) обрубался на полуслове, JSON
//            переставал парситься, и данные молча терялись при чтении.
//
Функция МаскироватьСекреты(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Результат = Текст;
	Результат = ЗаменитьBearerТокены(Результат);
	Результат = ЗаменитьТокеныПоПрефиксу(Результат, "sk-", "sk-***");
	Результат = ЗаменитьТокеныПоПрефиксу(Результат, "ya29.", "ya29.***");

	Возврат Результат;

КонецФункции

// Генерирует новый UUID и возвращает его строкой нижнего регистра.
//
// Формат результата: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" (36 символов).
// Платформа 1С отдаёт UUID в нижнем регистре с дефисами; нормализация не требуется.
// Используется для генерации RunId, ApprovalId, IdempotencyKey.
//
// Возвращаемое значение:
//   Строка - UUID. При непредвиденной ошибке возвращает "".
//
Функция НовыйUUID() Экспорт

	Попытка
		Возврат Строка(Новый УникальныйИдентификатор);
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Версия загруженного в базу расширения AgentRunner (Configuration.xml.Version).
// Используется для диагностики рассинхронизации src/ и фактически загруженного
// в информационную базу кода (см. ar_Диалог, лог run_started).
//
// Возвращаемое значение:
//   Строка - версия расширения (например "0.1.0.1") либо "?", если
//   расширение не найдено среди подключённых (не должно происходить в норме).
//
Функция ВерсияРасширения() Экспорт

	Попытка
		Расширения = РасширенияКонфигурации.Получить(
			Новый Структура("Имя", "AgentRunner"));
		Если Расширения.Количество() > 0 Тогда
			Возврат Расширения[0].Версия;
		КонецЕсли;
		Возврат "?";
	Исключение
		Возврат "?";
	КонецПопытки;

КонецФункции

// Проверяет, что переданное значение — строка в формате UUID
// (36 символов, дефисы в позициях 9, 14, 19, 24, остальные — hex-символы).
//
// Принимаются оба регистра hex-символов (a-f и A-F): платформенный Строка(УникальныйИдентификатор)
// даёт нижний регистр, но входящие значения из внешних API могут быть в верхнем.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение. Не-строка → Ложь.
//
// Возвращаемое значение:
//   Булево - Истина, если значение является строкой формата UUID.
//
Функция ЭтоUUID(Знач Значение) Экспорт

	Попытка
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;

		Если СтрДлина(Значение) <> 36 Тогда
			Возврат Ложь;
		КонецЕсли;

		HexСимволы = "0123456789abcdefABCDEF";
		Для НомерСимвола = 1 По 36 Цикл
			Символ = Сред(Значение, НомерСимвола, 1);
			Если НомерСимвола = 9 ИЛИ НомерСимвола = 14 ИЛИ НомерСимвола = 19 ИЛИ НомерСимвола = 24 Тогда
				Если Символ <> "-" Тогда
					Возврат Ложь;
				КонецЕсли;
			ИначеЕсли СтрНайти(HexСимволы, Символ) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;

		Возврат Истина;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Проверяет, что переданное значение — строка в XML-формате GUID
// (32 hex-символа без разделителей, регистронезависимо).
//
// Отличие от ЭтоUUID (36 символов, дефисы в позициях 9/14/19/24): значение
// после "?ref=" в навигационной ссылке (e1cib/data/...?ref=...) платформа
// отдаёт именно в этом, "плоском" формате — это тот же GUID, что принимает
// XMLЗначение(Тип(...), Строка) для построения ссылки. Использование ЭтоUUID
// для такой строки ошибочно бракует валидный GUID (ROREF-01).
//
// Параметры:
//   Значение - Произвольный - проверяемое значение. Не-строка → Ложь.
//
// Возвращаемое значение:
//   Булево - Истина, если значение — 32-символьный hex-GUID без разделителей.
//
Функция ЭтоXMLGUID(Знач Значение) Экспорт

	Попытка
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;

		Если СтрДлина(Значение) <> 32 Тогда
			Возврат Ложь;
		КонецЕсли;

		HexСимволы = "0123456789abcdefABCDEF";
		Для НомерСимвола = 1 По 32 Цикл
			Символ = Сред(Значение, НомерСимвола, 1);
			Если СтрНайти(HexСимволы, Символ) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;

		Возврат Истина;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает навигационную ссылку (e1cib/data/...) для переданного объекта.
//
// Параметры:
//   Объект - Произвольный - источник ссылки:
//     * ссылочный тип (СправочникСсылка, ДокументСсылка и т.п.) → ПолучитьНавигационнуюСсылку(Объект);
//     * Строка → возвращается как есть (уже готовая ссылка);
//     * Неопределено / прочий тип → "".
//
// Используется в ar_AuditДействия.Записать для заполнения ResultRef.
//
// Возвращаемое значение:
//   Строка - навигационная ссылка либо "".
//
Функция НавигационнаяСсылкаОбъекта(Знач Объект) Экспорт

	Попытка
		Если ТипЗнч(Объект) = Тип("Строка") Тогда
			Возврат Объект;
		КонецЕсли;

		Если Объект = Неопределено Тогда
			Возврат "";
		КонецЕсли;

		// ПолучитьНавигационнуюСсылку поддерживает ссылочные значения; для прочих
		// типов (число, дата и т.п.) даёт неинформативный результат, поэтому
		// явно ограничиваемся ссылочными типами.
		Если НЕ ЭтоСсылочныйТип(Объект) Тогда
			Возврат "";
		КонецЕсли;

		Возврат ПолучитьНавигационнуюСсылку(Объект);
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Разыменовывает навигационную ссылку в ссылку на объект ИБ.
// Платформа не предоставляет обратной функции (объект→ссылку строит
// ПолучитьНавигационнуюСсылку, но парного метода ссылка→объект нет),
// поэтому разбираем строку "e1cib/data/<Класс>.<Объект>?ref=<GUID>" вручную.
//
// GUID после "?ref=" - "плоский" внутренний формат (32 hex-символа без дефисов)
// с иной раскладкой байт, чем строковый UUID; XMLЗначение(Тип(...), ...) его НЕ
// принимает и даёт битую ссылку → object_not_found (баг round-trip, ROREF-03).
// Надёжный способ - подменить нулевой GUID во внутреннем строковом представлении
// ПУСТОЙ ссылки нужного типа и восстановить значение через ЗначениеИзСтрокиВнутр:
// платформа сама раскладывает байты. Это тот же приём, что применяет БСП на
// сервере [Реф: БСП/ЖурналРегистрации.ПользователиИБДляОтбора] - без Вычислить().
//
// Параметры:
//   НавигационнаяСсылка - Строка - ссылка вида "e1cib/data/...". Пустая строка / не-строка → Неопределено.
//
// Используется в UI Approval Queue для открытия превью draft-объектов по ResultRef
// и tool-модулями (read_object, find_references и т.п.) для приёма ref от LLM.
//
// Возвращаемое значение:
//   Произвольный - ссылка на объект ИБ либо Неопределено при некорректной ссылке.
//
Функция ОбъектИзНавигационнойСсылки(Знач НавигационнаяСсылка) Экспорт

	Попытка
		Если ТипЗнч(НавигационнаяСсылка) <> Тип("Строка") ИЛИ ПустаяСтрока(НавигационнаяСсылка) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ПрефиксДанных = "e1cib/data/";
		ПозицияПрефикса = СтрНайти(НавигационнаяСсылка, ПрефиксДанных);
		ПозицияПараметра = СтрНайти(НавигационнаяСсылка, "?ref=");
		Если ПозицияПрефикса = 0 ИЛИ ПозицияПараметра = 0 ИЛИ ПозицияПараметра < ПозицияПрефикса Тогда
			ЗаписатьПредупреждение(СтрШаблон(
				НСтр("ru='Навигационная ссылка не разыменована: %1';
				|en='Navigation link could not be resolved: %1'"),
				НавигационнаяСсылка));
			Возврат Неопределено;
		КонецЕсли;

		НачалоИмениТипа = ПозицияПрефикса + СтрДлина(ПрефиксДанных);
		ПолноеИмяОбъекта = СокрЛП(Сред(НавигационнаяСсылка, НачалоИмениТипа, ПозицияПараметра - НачалоИмениТипа));
		ЗначениеGUID    = СокрЛП(Сред(НавигационнаяСсылка, ПозицияПараметра + СтрДлина("?ref=")));

		// Пустая ссылка нужного типа - источник корректного внутреннего представления.
		ПустаяСсылка = ПустаяСсылкаПоПолномуИмениОбъекта(ПолноеИмяОбъекта);
		// ROREF-01: значение после "?ref=" - 32-символьный плоский GUID (не UUID
		// с дефисами) - проверяем ЭтоXMLGUID, не ЭтоUUID.
		Если ПустаяСсылка = Неопределено ИЛИ НЕ ЭтоXMLGUID(ЗначениеGUID) Тогда
			ЗаписатьПредупреждение(СтрШаблон(
				НСтр("ru='Навигационная ссылка не разыменована: %1';
				|en='Navigation link could not be resolved: %1'"),
				НавигационнаяСсылка));
			Возврат Неопределено;
		КонецЕсли;

		// ROREF-03: подмена нулевого GUID во внутреннем представлении пустой ссылки.
		// Сравнение/замена в нижнем регистре - GUID платформа хранит строчными hex.
		НулевойGUID = "00000000000000000000000000000000";
		ВнутренняяСтрока = ЗначениеВСтрокуВнутр(ПустаяСсылка);
		ВосстановленнаяСтрока = СтрЗаменить(ВнутренняяСтрока, НулевойGUID, НРег(ЗначениеGUID));
		Если ВосстановленнаяСтрока = ВнутренняяСтрока Тогда
			// Нулевой GUID не найден в шаблоне (неожиданный формат) - не рискуем.
			ЗаписатьПредупреждение(СтрШаблон(
				НСтр("ru='Навигационная ссылка не разыменована: %1';
				|en='Navigation link could not be resolved: %1'"),
				НавигационнаяСсылка));
			Возврат Неопределено;
		КонецЕсли;

		Возврат ЗначениеИзСтрокиВнутр(ВосстановленнаяСтрока);
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Форматирует дату в строку ISO 8601: "YYYY-MM-DDTHH:MM:SS".
//
// Параметры:
//   Дата - Дата - значение для форматирования. Не-дата или пустая дата ('00010101') → "".
//
// Возвращаемое значение:
//   Строка - дата в формате ISO 8601 либо "".
//
Функция ФорматДата(Знач Дата) Экспорт

	Попытка
		Если ТипЗнч(Дата) <> Тип("Дата") Тогда
			Возврат "";
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Дата) Тогда
			Возврат "";
		КонецЕсли;

		Возврат Формат(Дата, "ДФ='yyyy-MM-ddTHH:mm:ss'");
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Форматирует дату для показа ЧЕЛОВЕКУ (текст письма, заголовок, сообщение).
// В отличие от ФорматДата (ISO 8601, машинный обмен с LLM/JSON) использует
// локальный формат даты без времени: "01.01.2008".
//
// Параметры:
//   Дата - Дата - форматируемое значение.
//
// Возвращаемое значение:
//   Строка - представление вида "дд.ММ.гггг" либо "" для пустой/нечисловой даты.
//
Функция ФорматДатаПользователю(Знач Дата) Экспорт

	Попытка
		Если ТипЗнч(Дата) <> Тип("Дата") Или НЕ ЗначениеЗаполнено(Дата) Тогда
			Возврат "";
		КонецЕсли;

		Возврат Формат(Дата, "ДЛФ=D");
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Разбирает строку даты/времени ISO 8601 ("YYYY-MM-DD" либо "YYYY-MM-DDTHH:MM:SS")
// в значение типа Дата. Обратная операция к ФорматДата.
//
// Параметры:
//   СтрокаДаты - Строка - значение для разбора.
//
// Возвращаемое значение:
//   Дата - разобранное значение, либо Неопределено при невалидной строке.
//
Функция ДатаИзСтроки(Знач СтрокаДаты) Экспорт

	Если ТипЗнч(СтрокаДаты) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	СтрокаДаты = СокрЛП(СтрокаДаты);
	Если НЕ СтрНайти(СтрокаДаты, "T") > 0 Тогда
		СтрокаДаты = СтрокаДаты + "T00:00:00";
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), СтрокаДаты);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Форматирует число с заданным числом знаков после запятой, без разделителей тысяч,
// с точкой как разделителем дробной части. Результат: "1234.56".
//
// LLM ожидает числа в формате с точкой; формат используется при сериализации сумм в JSON.
//
// Параметры:
//   Число             - Число   - значение. Не-число → "".
//   ЗнаковПослеЗапятой - Число   - число знаков дробной части (>= 0). Отрицательное → 0.
//
// Возвращаемое значение:
//   Строка - отформатированное число либо "".
//
Функция ФорматЧисло(Знач Число, Знач ЗнаковПослеЗапятой = 2) Экспорт

	Попытка
		Если ТипЗнч(Число) <> Тип("Число") Тогда
			Возврат "";
		КонецЕсли;

		Разрядность = Макс(0, ЗнаковПослеЗапятой);
		Возврат Формат(Число, "ЧДЦ=" + Формат(Разрядность, "ЧГ=0") + "; ЧРД=.; ЧГ=0; ЧН=0");
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Обрезает строку до МаксДлина символов. Если строка длиннее — обрезает
// и добавляет "..." так, что итоговая длина равна МаксДлина.
//
// Параметры:
//   Строка   - Строка - исходная строка. Не-строка → "".
//   МаксДлина - Число  - максимальная длина результата (>= 0).
//
// Возвращаемое значение:
//   Строка - обрезанная строка.
//
Функция ОбрезатьДо(Знач Строка, Знач МаксДлина) Экспорт

	Попытка
		Если ТипЗнч(Строка) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Предел = Макс(0, МаксДлина);
		Если СтрДлина(Строка) <= Предел Тогда
			Возврат Строка;
		КонецЕсли;

		Если Предел <= 3 Тогда
			Возврат Лев("...", Предел);
		КонецЕсли;

		Возврат Лев(Строка, Предел - 3) + "...";
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Очищает текст ошибки 1С перед передачей в LLM или записью в audit.
//
// Эта функция — единственная точка санации текстов ошибок. Не создавать inline-копии.
// Все runtime-модули должны вызывать её перед сохранением observation в audit
// или передачей текста ошибки в контекст модели.
//
// Алгоритм (строгая последовательность):
//   1. Не-строка → "" (безопасный дефолт).
//   2. УдалитьСтекиИПути — убрать строки с файловыми путями и маркерами стека.
//   3. МаскироватьСекреты — замаскировать sk-*, ya29.*, Bearer * (SEC-02).
//   4. Если ВключитьPII = Истина — МаскироватьПаспорт → МаскироватьСНИЛС →
//      МаскироватьINN (compliance-режим, UTIL-04 + PII-02).
//   5. ОбрезатьДо(500) — итоговая длина не превышает 500 символов.
//
// Функция обёрнута в Попытка/Исключение и не выбрасывает исключений — вызывается
// из блоков Исключение и не должна сама ломать обработку ошибок. При внутренней
// ошибке возвращает "" и пишет запись в журнал регистрации.
//
// Рекомендуется вызывать на сервере: входной текст обычно приходит от
// ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()).
//
// Параметры:
//   Текст       - Строка - исходный текст ошибки (КраткоеПредставлениеОшибки,
//                          ПодробноеПредставлениеОшибки либо произвольная строка).
//                          Не-строка / Неопределено → "".
//   ВключитьPII - Булево - если Истина, дополнительно маскируются паспорт/СНИЛС/
//                          ИНН/ОГРН через МаскироватьПаспорт/МаскироватьСНИЛС/
//                          МаскироватьINN (compliance-режим, PII-02).
//                          По умолчанию Ложь — возможны ложные срабатывания
//                          на суммах/кодах/номерах телефонов соответствующих длин.
//
// Возвращаемое значение:
//   Строка - очищенный текст не длиннее 500 символов либо "" при ошибке/пустом входе.
//
Функция ОчиститьОшибкуДляLLM(Знач Текст, Знач ВключитьPII = Ложь) Экспорт

	Попытка
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Если ПустаяСтрока(Текст) Тогда
			Возврат "";
		КонецЕсли;

		Результат = УдалитьСтекиИПути(Текст);
		Результат = МаскироватьСекреты(Результат);

		// PII-02: порядок вызовов зафиксирован в спеке — от наиболее специфичного
		// формата, требующего разделителя (паспорт), к наименее специфичному,
		// работающему по чистой длине цифровой последовательности (ИНН/ОГРН).
		// Функциональной коллизии нет (форматы не пересекаются по паттернам),
		// порядок важен только для читаемости/консистентности.
		Если ВключитьPII Тогда
			Результат = МаскироватьПаспорт(Результат);
			Результат = МаскироватьСНИЛС(Результат);
			Результат = МаскироватьINN(Результат);
		КонецЕсли;

		Результат = ОбрезатьДо(Результат, 500);
		Возврат Результат;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Маскирует значение поля объекта в observation, если для поля действует
// пользовательское правило полного сокрытия (PII-01), либо имя поля/само
// значение соответствует паттерну чувствительных данных (TOOL-16, PII-02).
//
// Вызывается в точках сериализации fields из read_object, query, табличных частей
// только при ar_Константы.ComplianceРежим() = Истина.
//
// PII-04: сигнатура расширена параметром ИмяОбъекта (BREAKING CHANGE относительно
// TOOL-16-сигнатуры ОчиститьЗначениеПоля(ИмяПоля, Значение)) — требуется для
// подключения пользовательских правил PII-01 (aosPersonalData), которые матчатся
// по паре (Объект, ИмяПоля), а не только по имени поля. Все вызывающие места
// обновлены в этом же тикете (см. .docs/specs/PII-04.md, 3 call site в
// ar_ToolUniversal).
//
// Алгоритм (без Выполнить/Вычислить, без regexp), каждый шаг — самостоятельная
// ранняя развилка, не влияющая на последующие при отрицательном результате:
//   0. Значение не строка (Неопределено, Null, структура {ref,name}) -- возвращается
//      без изменений. ПРИМЕЧАНИЕ (PII-04, осознанное решение): проверка типа
//      выполняется ПЕРВОЙ, раньше правила PII-01 -- т.е. правило ПолностьюСкрыть
//      не скрывает ссылочные/нестроковые реквизиты целиком, только строковые
//      представления. Изменение этого порядка (проверка правила до проверки типа)
//      расширило бы контракт ЕстьПравилоПолногоСокрытия на нестроковые значения --
//      вне объёма этого тикета, см. .docs/specs/PII-04.md, "Открытые вопросы".
//   1. PII-01: пользовательское правило ПолностьюСкрыть -- aosPersonalData.
//      ЕстьПравилоПолногоСокрытия(ИмяОбъекта, ИмяПоля) = Истина -- [REDACTED].
//      Геттер fail-open и регистронезависим по ИмяПоля, поддерживает wildcard "*"
//      по Объекту. Проверяется РАНЬШЕ паттернов имени поля (п.2), т.к. явное
//      администраторское правило имеет приоритет над встроенной эвристикой.
//   2. Проверка имени поля: НРег(ИмяПоля) содержит один из 18 паттернов
//      (7 TOOL-16 + 11 PII-02: ФИО/дата рождения) -- [REDACTED].
//   3. PII-02: значение похоже на паспорт или СНИЛС (МаскироватьПаспорт/
//      МаскироватьСНИЛС) -- возвращается результат маскирующей функции
//      ("***ПАСПОРТ***"/"***СНИЛС***"), НЕ общий [REDACTED] -- сохраняет
//      диагностируемость типа данных (аналогично МаскироватьINN).
//   4. Проверка значения через МаскироватьСекреты и МаскироватьINN: если любой
//      из маскировщиков изменил строку -- [REDACTED] (sk-*, ya29.*, Bearer *,
//      ИНН/ОГРН-подобные числа). PII-04: МаскироватьINN добавлен в этот шаг —
//      осознанное РАСШИРЕНИЕ поведения относительно TOOL-16 (ранее
//      ОчиститьЗначениеПоля вызывала только МаскироватьСекреты; МаскироватьINN
//      вызывалась только внутри ОчиститьОшибкуДляLLM). Следствие: строковые
//      реквизиты объектов с 10/12/13/15-значными числовыми последовательностями
//      теперь маскируются в read_object/query при ComplianceРежим=Истина, даже
//      если раньше не маскировались (см. .docs/specs/PII-04.md, "Риски").
//   5. Иначе -- исходное значение без изменений.
//
// Контактная информация (PII-03, ar_ToolCRM.ПрочитатьКИЧерезБСП) через эту
// функцию не проходит -- отдельный путь, не входит в объём PII-04.
//
// Параметры:
//   ИмяОбъекта - Строка - полное имя метаданных объекта-владельца поля
//                (например "Справочник.Контрагенты"), результат МД.ПолноеИмя().
//                Для полей табличных частей -- полное имя объекта-владельца ТЧ,
//                НЕ составное имя вида "Справочник.Контрагенты.ТабличнаяЧасть"
//                (регистр ar_ПравилаМаскированияПДн не содержит измерения ТЧ).
//                При Неопределено/пустой строке шаг 1 (PII-01) просто не находит
//                правил (fail-open в aosPersonalData) -- не требует отдельной
//                защиты здесь.
//   ИмяПоля - Строка - имя реквизита (регистронезависимо). При Неопределено/Null
//             защита по имени (шаги 1, 2) пропускается, проверяется только значение.
//   Значение - Произвольный - значение поля. При не-строке возвращается без изменений.
//
// Возвращаемое значение:
//   Строка - "[REDACTED]" при совпадении правила PII-01, имени поля или секрета/ИНН;
//            "***СНИЛС***"/"***ПАСПОРТ***" при совпадении с соответствующим форматом.
//   Произвольный - исходное значение при отсутствии совпадений (тип сохраняется).
//
Функция ОчиститьЗначениеПоля(Знач ИмяОбъекта, Знач ИмяПоля, Знач Значение) Экспорт

	ЗначениеСкрыто = "[REDACTED]";

	Попытка
		// 0. Значение не строка -- возвращаем без изменений ({ref, name} -- структура).
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Возврат Значение;
		КонецЕсли;

		// 1. PII-01: пользовательское правило полного сокрытия (по объекту+полю).
		Если aosPersonalData.ЕстьПравилоПолногоСокрытия(ИмяОбъекта, ИмяПоля) Тогда
			Возврат ЗначениеСкрыто;
		КонецЕсли;

		// 2. Проверка имени поля по 18 паттернам (TOOL-16 + PII-02, DoD D4).
		Если НЕ ПустаяСтрока(ИмяПоля) Тогда
			НижнееИмя = НРег(ИмяПоля);
			МассивПаттернов = ПаттерныЧувствительныхПолей();
			Для Каждого Паттерн Из МассивПаттернов Цикл
				Если СтрНайти(НижнееИмя, Паттерн) > 0 Тогда
					Возврат ЗначениеСкрыто;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// 3. PII-02: СНИЛС/паспорт по значению -- сохраняем диагностируемость типа,
		//    не заменяем на общий [REDACTED] (форматы взаимоисключающие по маркерам).
		МаскированноеЗначение = МаскироватьПаспорт(Значение);
		Если МаскированноеЗначение <> Значение Тогда
			Возврат МаскированноеЗначение;
		КонецЕсли;
		МаскированноеЗначение = МаскироватьСНИЛС(Значение);
		Если МаскированноеЗначение <> Значение Тогда
			Возврат МаскированноеЗначение;
		КонецЕсли;

		// 4. Проверка значения через МаскироватьСекреты (SEC-02) и МаскироватьINN
		//    (PII-04: расширение поведения относительно TOOL-16, см. докстринг выше).
		МаскированноеЗначение = МаскироватьСекреты(Значение);
		Если МаскированноеЗначение <> Значение Тогда
			Возврат ЗначениеСкрыто;
		КонецЕсли;
		МаскированноеЗначение = МаскироватьINN(Значение);
		Если МаскированноеЗначение <> Значение Тогда
			Возврат ЗначениеСкрыто;
		КонецЕсли;

		// 5. Без изменений.
		Возврат Значение;
	Исключение
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru='ОчиститьЗначениеПоля: ошибка при обработке поля %1 объекта %2';
			|en='ОчиститьЗначениеПоля: error processing field %1 of object %2'"),
			ИмяПоля, ИмяОбъекта);
		ЗаписатьПредупреждение(ТекстПредупреждения);
		Возврат Значение;
	КонецПопытки;

КонецФункции

// Маскирует последовательности цифр, похожие на ИНН/ОГРН, заменяя их на
// "***ИНН***" / "***ОГРН***".
//
// Семантика длин (по правилам РФ):
//   * 10 цифр  → ***ИНН***  (ИНН организации)
//   * 12 цифр  → ***ИНН***  (ИНН физлица / ИП)
//   * 13 цифр  → ***ОГРН***  (ОГРН организации)
//   * 15 цифр  → ***ОГРН***  (ОГРНИП)
// Прочие длины не затрагиваются.
//
// Опциональная PII-защита. Вызывается только при включённом compliance-режиме
// (явный вызов из UTIL-05), не автоматически. Возможны ложные срабатывания на
// суммах/кодах соответствующей длины — приемлемый компромисс.
//
// Параметры:
//   Текст - Строка - произвольный текст. Не-строка → "".
//
// Возвращаемое значение:
//   Строка - текст с замаскированными ИНН/ОГРН.
//
Функция МаскироватьINN(Знач Текст) Экспорт

	Попытка
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Если ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;

		Цифры = "0123456789";
		Результат = "";
		Позиция = 1;
		ДлинаТекста = СтрДлина(Текст);

		Пока Позиция <= ДлинаТекста Цикл
			Символ = Сред(Текст, Позиция, 1);
			Если СтрНайти(Цифры, Символ) = 0 Тогда
				Результат = Результат + Символ;
				Позиция = Позиция + 1;
				Продолжить;
			КонецЕсли;

			// Считываем непрерывную последовательность цифр.
			НачалоЧисла = Позиция;
			Пока Позиция <= ДлинаТекста И СтрНайти(Цифры, Сред(Текст, Позиция, 1)) > 0 Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			ДлинаЧисла = Позиция - НачалоЧисла;
			Последовательность = Сред(Текст, НачалоЧисла, ДлинаЧисла);

			Если ДлинаЧисла = 13 ИЛИ ДлинаЧисла = 15 Тогда
				Результат = Результат + "***ОГРН***";
			ИначеЕсли ДлинаЧисла = 10 ИЛИ ДлинаЧисла = 12 Тогда
				Результат = Результат + "***ИНН***";
			Иначе
				Результат = Результат + Последовательность;
			КонецЕсли;
		КонецЦикла;

		Возврат Результат;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// PII-02: Маскирует вхождения СНИЛС (страховой номер индивидуального лицевого счёта РФ)
// в тексте, заменяя их на "***СНИЛС***".
//
// Распознаваемые форматы (11 цифр в двух представлениях):
//   * С разделителями: "XXX-XXX-XXX YY" (3 группы по 3 цифры через дефис,
//     пробел, 2 контрольные цифры). Пример: "112-233-445 95".
//   * Слитно: 11 цифр подряд без разделителей. Пример: "11223344595".
// Формат с разделителями проверяется первым (более специфичный, не даёт
// ложных срабатываний на произвольных числах с дефисами), затем — слитный.
//
// Контрольное число СНИЛС не проверяется — валидация контрольной суммы избыточна
// для эвристики маскирования наружу; задача — не пропустить похожий на СНИЛС
// паттерн, а не подтвердить его валидность. Ложные срабатывания на случайных
// 11-значных числах — приемлемый компромисс, симметричный МаскироватьINN.
//
// 11 цифр не пересекаются по длине с ИНН/ОГРН (10/12/13/15), коллизий с
// МаскироватьINN нет.
//
// Параметры:
//   Текст - Строка - произвольный текст. Не-строка, Неопределено и пустая строка → "".
//
// Возвращаемое значение:
//   Строка - текст с замаскированными СНИЛС. Функция не выбрасывает исключений.
//
Функция МаскироватьСНИЛС(Знач Текст) Экспорт

	Попытка
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Если ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;

		Цифры = "0123456789";
		Результат = "";
		Позиция = 1;
		ДлинаТекста = СтрДлина(Текст);

		Пока Позиция <= ДлинаТекста Цикл

			// Вариант А: с разделителями "XXX-XXX-XXX YY" (ровно 14 символов).
			Если ЭтоСНИЛССРазделителями(Текст, Позиция) Тогда
				Результат = Результат + "***СНИЛС***";
				Позиция = Позиция + 14;
				Продолжить;
			КонецЕсли;

			Символ = Сред(Текст, Позиция, 1);
			Если СтрНайти(Цифры, Символ) = 0 Тогда
				Результат = Результат + Символ;
				Позиция = Позиция + 1;
				Продолжить;
			КонецЕсли;

			// Вариант Б: слитная последовательность цифр — считаем длину.
			НачалоЧисла = Позиция;
			Пока Позиция <= ДлинаТекста И СтрНайти(Цифры, Сред(Текст, Позиция, 1)) > 0 Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			ДлинаЧисла = Позиция - НачалоЧисла;
			Последовательность = Сред(Текст, НачалоЧисла, ДлинаЧисла);

			Если ДлинаЧисла = 11 Тогда
				Результат = Результат + "***СНИЛС***";
			Иначе
				Результат = Результат + Последовательность;
			КонецЕсли;
		КонецЦикла;

		Возврат Результат;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// PII-02: Маскирует вхождения серии и номера паспорта гражданина РФ в тексте,
// заменяя их на "***ПАСПОРТ***".
//
// Распознаётся только формат «4 цифры, ровно один пробел, 6 цифр» (XXXX XXXXXX,
// 11 символов) — стандартное представление серии+номера на бланке паспорта РФ,
// где по обе стороны от последовательности — начало/конец строки или не-цифровой
// разделитель (чтобы не захватить хвост более длинной цифровой последовательности,
// например номер телефона с пробелами).
//
// 10 цифр слитно без пробела НАМЕРЕННО не распознаются этой функцией — такая
// последовательность уже перехватывается МаскироватьINN как ИНН организации,
// и различить программно "слитно записанный паспорт" от ИНН невозможно.
// Явный пробел-разделитель — единственный надёжный маркер паспорта. Иные
// разделители (№, дефис) и загранпаспорт РФ (2 буквы + 7 цифр) — out of scope
// для первой итерации (см. .docs/specs/PII-02.md).
//
// Контрольная сумма / валидность серии (регион выдачи) не проверяется — тот же
// компромисс, что и для МаскироватьСНИЛС/МаскироватьINN.
//
// Параметры:
//   Текст - Строка - произвольный текст. Не-строка, Неопределено и пустая строка → "".
//
// Возвращаемое значение:
//   Строка - текст с замаскированными номерами паспорта. Функция не выбрасывает исключений.
//
Функция МаскироватьПаспорт(Знач Текст) Экспорт

	Попытка
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Если ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;

		Результат = "";
		Позиция = 1;
		ДлинаТекста = СтрДлина(Текст);

		Пока Позиция <= ДлинаТекста Цикл
			Если ЭтоПаспортСРазделителем(Текст, Позиция) Тогда
				Результат = Результат + "***ПАСПОРТ***";
				Позиция = Позиция + 11;
				Продолжить;
			КонецЕсли;

			Результат = Результат + Сред(Текст, Позиция, 1);
			Позиция = Позиция + 1;
		КонецЦикла;

		Возврат Результат;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// PII-07: Маскирует российские номера телефонов, заменяя их на "***ТЕЛЕФОН***".
//
// Распознаётся номер из ровно 11 цифр с ведущей 7 или 8, с необязательным "+"
// в начале и произвольными разделителями " ", "(", ")", "-" между цифрами.
// Покрывает формы, в которых телефон реально хранится в 1С и встречается в
// свободном тексте: "+7 (495) 123-45-67", "8-926-123-45-67", "8 800 555 35 35",
// "89261234567", "+7(926)1234567".
//
// Ограничение по ведущей цифре (7/8) и по точной длине 11 — то, что удерживает
// уровень ложных срабатываний: ИНН (10/12), ОГРН (13/15), номера версий
// ("8.3.26" — точка не разделитель), суммы и количества под паттерн не
// подпадают. Проверено симуляцией на позитивных и негативных наборах.
//
// Порядок в МаскироватьПДнВТексте — ДО МаскироватьСНИЛС/МаскироватьINN:
// слитный 11-значный номер иначе перехватывается СНИЛС по совпадению длины и
// маскируется неверным ярлыком, а 10-значный — как ИНН.
//
// Международные номера (кроме РФ) вне объёма — тот же компромисс эвристик,
// что в МаскироватьСНИЛС/МаскироватьПаспорт.
//
// Параметры:
//   Текст - Строка - произвольный текст. Не-строка → "".
//
// Возвращаемое значение:
//   Строка - текст с замаскированными телефонами. Функция не выбрасывает
//            исключений; при внутренней ошибке возвращает "" (fail-closed,
//            как остальные маскировщики).
//
Функция МаскироватьТелефон(Знач Текст) Экспорт

	Попытка
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Если ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;

		Результат = "";
		Позиция = 1;
		ДлинаТекста = СтрДлина(Текст);

		Пока Позиция <= ДлинаТекста Цикл

			ДлинаНомера = ДлинаТелефонаСПозиции(Текст, Позиция);
			Если ДлинаНомера > 0 Тогда
				Результат = Результат + "***ТЕЛЕФОН***";
				Позиция = Позиция + ДлинаНомера;
				Продолжить;
			КонецЕсли;

			Результат = Результат + Сред(Текст, Позиция, 1);
			Позиция = Позиция + 1;
		КонецЦикла;

		Возврат Результат;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// PII-07: Маскирует вхождения email-адресов в тексте, заменяя их на "***EMAIL***".
//
// Распознавание: максимальная последовательность допустимых для email символов
// (латиница, цифры, "._%+-@") считается email-адресом, если содержит ровно один
// "@", непустую локальную часть и домен с точкой, где зона после последней
// точки — минимум 2 латинские буквы. Хвостовые разделители ("a@b.ru." в конце
// предложения) отсекаются до проверки и сохраняются в тексте.
//
// Кириллические домены (IDN) не распознаются — out of scope, тот же компромисс
// эвристик, что в МаскироватьСНИЛС/МаскироватьПаспорт.
//
// Параметры:
//   Текст - Строка - произвольный текст. Не-строка → "".
//
// Возвращаемое значение:
//   Строка - текст с замаскированными email. Функция не выбрасывает исключений;
//            при внутренней ошибке возвращает "" (fail-closed, как остальные
//            маскировщики).
//
Функция МаскироватьEmail(Знач Текст) Экспорт

	Попытка
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Если ПустаяСтрока(Текст) ИЛИ СтрНайти(Текст, "@") = 0 Тогда
			Возврат Текст;
		КонецЕсли;

		ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyz0123456789._%+-@";
		Результат = "";
		Позиция = 1;
		ДлинаТекста = СтрДлина(Текст);

		Пока Позиция <= ДлинаТекста Цикл
			Символ = Сред(Текст, Позиция, 1);
			Если СтрНайти(ДопустимыеСимволы, НРег(Символ)) = 0 Тогда
				Результат = Результат + Символ;
				Позиция = Позиция + 1;
				Продолжить;
			КонецЕсли;

			// Считываем максимальный фрагмент из допустимых символов.
			НачалоФрагмента = Позиция;
			Пока Позиция <= ДлинаТекста
				И СтрНайти(ДопустимыеСимволы, НРег(Сред(Текст, Позиция, 1))) > 0 Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Фрагмент = Сред(Текст, НачалоФрагмента, Позиция - НачалоФрагмента);

			// Отсекаем хвостовые разделители (точка в конце предложения и т.п.).
			Хвост = "";
			Пока СтрДлина(Фрагмент) > 0 И СтрНайти("._%+-@", Прав(Фрагмент, 1)) > 0 Цикл
				Хвост = Прав(Фрагмент, 1) + Хвост;
				Фрагмент = Лев(Фрагмент, СтрДлина(Фрагмент) - 1);
			КонецЦикла;

			Если ЭтоEmailФрагмент(Фрагмент) Тогда
				Результат = Результат + "***EMAIL***" + Хвост;
			Иначе
				Результат = Результат + Фрагмент + Хвост;
			КонецЕсли;
		КонецЦикла;

		Возврат Результат;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// PII-07: Маскирует ПДн и секреты в произвольном свободном тексте (сообщения
// LLM-контекста: реплики пользователя, system prompt, история, аргументы
// tool_calls). «Последний рубеж» перед отправкой во внешнюю модель — точечные
// inline-замены, в отличие от ОчиститьЗначениеПоля, которая заменяет значение
// поля целиком (здесь нет привязки к объекту/полю, правила регистра
// ar_ПравилаМаскированияПДн неприменимы).
//
// Композиция маскировщиков (порядок как в ОчиститьЗначениеПоля, email до
// цифровых, чтобы не важно было — цифровая локальная часть замаскируется
// любым из них):
//   МаскироватьПаспорт → МаскироватьСНИЛС → МаскироватьEmail →
//   МаскироватьСекреты → МаскироватьINN.
//
// Телефоны намеренно вне объёма: слитные 11-значные номера уже перехватываются
// МаскироватьСНИЛС (совпадение длины), а форматированные номера (+7 (495) ...)
// дают недопустимый уровень ложных срабатываний на произвольных числах.
//
// Fail-closed: каждый внутренний маскировщик при своей ошибке возвращает "",
// поэтому при сбое любого шага результат — пустая строка, а не утечка
// исходного текста.
//
// Параметры:
//   Текст - Строка - произвольный текст. Не-строка → "".
//
// Возвращаемое значение:
//   Строка - текст с замаскированными ПДн/секретами.
//
Функция МаскироватьПДнВТексте(Знач Текст) Экспорт

	Попытка
		Если ТипЗнч(Текст) <> Тип("Строка") Тогда
			Возврат "";
		КонецЕсли;

		Если ПустаяСтрока(Текст) Тогда
			Возврат Текст;
		КонецЕсли;

		Результат = МаскироватьПаспорт(Текст);
		Результат = МаскироватьТелефон(Результат);
		Результат = МаскироватьСНИЛС(Результат);
		Результат = МаскироватьEmail(Результат);
		Результат = МаскироватьСекреты(Результат);
		Результат = МаскироватьINN(Результат);
		Возврат Результат;
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает массив паттернов имен чувствительных полей (TOOL-16, PII-02).
// Паттерны вынесены в отдельную функцию для повторного использования.
// Первые 7 паттернов (TOOL-16) покрывают latin и кириллические имена
// реквизитов с секретами. Следующие 11 паттернов (PII-02) покрывают
// ФИО и дату рождения — по имени поля, а не по значению (эвристика
// по свободному тексту дала бы слишком много ложных срабатываний/пропусков
// на естественном языке, см. .docs/specs/PII-02.md).
//
// Проверка регистронезависимая и работает как поиск подстроки
// (СтрНайти(НРег(ИмяПоля), Паттерн) > 0 в ОчиститьЗначениеПоля), а не
// точное сравнение имени поля целиком.
//
// PII-02 trade-off #1 (осознанный, не баг): паттерн "имя" — широкий,
// совпадёт не только с желаемым (Имя, ИмяКонтрагента, ИмяПользователя),
// но и с техническими полями, содержащими подстроку "имя" (ИмяФайла,
// ИмяПоля, ИмяОбъекта). Та же категория компромисса, что уже принята
// для "ключ"/"токен". Если на практике это создаст проблему избыточного
// сокрытия служебных полей — сузить паттерн отдельным тикетом (граница
// слова потребует доп. разбора по не-буквенным разделителям).
//
// PII-02 trade-off #2 (пересмотрено в PII-04, решение не изменилось): эвристика
// "поле типа Дата → считать датой рождения" НЕ добавлена. Причина: шаг 0
// ОчиститьЗначениеПоля по-прежнему отсекает все не-строковые значения (Возврат
// Значение без маскировки) раньше проверки имени поля и правила PII-01 — то есть
// дата, приходящая как тип Дата (не строка), не попадает в маскирование независимо
// от паттернов имени. Введение проверки типа — расширение контракта функции ради
// одного частного случая, осознанно оставлено вне объёма PII-04 (см.
// .docs/specs/PII-04.md, "Открытые вопросы").
//
// Возвращаемое значение:
//   Массив из Строка - 18 строковых паттернов в нижнем регистре
//   (7 TOOL-16 + 11 PII-02).
//
Функция ПаттерныЧувствительныхПолей()

	Паттерны = Новый Массив;
	Паттерны.Добавить("key");       // APIKey, PrivateKey, SecretKey
	Паттерны.Добавить("token");     // Token, AccessToken, RefreshToken
	Паттерны.Добавить("password");  // Password
	Паттерны.Добавить("secret");    // Secret, ClientSecret
	Паттерны.Добавить("пароль");    // Пароль, ПарольПодключения
	Паттерны.Добавить("токен");     // Токен, ТокенДоступа
	Паттерны.Добавить("ключ");      // КлючAPI, СекретныйКлюч

	// PII-02: ФИО и дата рождения (по имени поля).
	Паттерны.Добавить("фамилия");     // Фамилия
	Паттерны.Добавить("имя");         // Имя, ИмяКонтрагента (см. trade-off #1 выше)
	Паттерны.Добавить("отчество");    // Отчество
	Паттерны.Добавить("фио");         // ФИО, ФИОКонтактногоЛица
	Паттерны.Добавить("датарождения"); // ДатаРождения (регистронезависимый СтрНайти без разделителей)
	Паттерны.Добавить("birthdate");   // BirthDate
	Паттерны.Добавить("birthday");    // Birthday
	Паттерны.Добавить("lastname");    // LastName
	Паттерны.Добавить("firstname");   // FirstName
	Паттерны.Добавить("middlename");  // MiddleName
	Паттерны.Добавить("fullname");    // FullName

	Возврат Паттерны;

КонецФункции

// Удаляет из текста строки, содержащие файловые пути или маркеры стек-трейса.
// Используется как первый шаг ОчиститьОшибкуДляLLM.
//
// Удаляются целые строки (по разбиению на Символы.ПС), в которых найдены:
//   * признаки файловых путей: "C:\", "D:\", "/Users/", "/home/", "/var/", "/opt/",
//                              "\\" (UNC), последовательность ".\" или "./" с продолжением;
//   * маркеры стека (регистронезависимо): "в процедуре", "в функции", "stack trace",
//                                          "traceback", "at line", "{Модуль", "{module".
//
// Эвристика по целым строкам: если маркер найден — строка удаляется полностью,
// чтобы не срезать осмысленные подстроки внутри пользовательского сообщения.
// Полезная часть ошибки обычно находится в первой строке, стек — в последующих.
//
// Параметры:
//   Текст - Строка - исходный текст (не-строка → "").
//
// Возвращаемое значение:
//   Строка - текст без строк-стеков и строк с путями. Оставшиеся строки склеены
//            через пробел (без переводов строки). Если все строки удалены —
//            возвращает локализованную заглушку "ошибка (текст скрыт)".
//
Функция УдалитьСтекиИПути(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	// Нормализуем переводы строк: CR/LF/CRLF → одиночный LF.
	Нормализованный = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Нормализованный = СтрЗаменить(Нормализованный, Символы.ВК, Символы.ПС);

	Строки = СтрРазделить(Нормализованный, Символы.ПС, Истина);
	Сохранённые = Новый Массив;

	Для Каждого ОчереднаяСтрока Из Строки Цикл
		Если СтрокаСодержитСтекИлиПуть(ОчереднаяСтрока) Тогда
			Продолжить;
		КонецЕсли;
		ОчищеннаяСтрока = СокрЛП(ОчереднаяСтрока);
		Если НЕ ПустаяСтрока(ОчищеннаяСтрока) Тогда
			Сохранённые.Добавить(ОчищеннаяСтрока);
		КонецЕсли;
	КонецЦикла;

	Если Сохранённые.Количество() = 0 Тогда
		Возврат НСтр("ru='ошибка (текст скрыт)'; en='error (text hidden)'");
	КонецЕсли;

	Возврат СтрСоединить(Сохранённые, " ");

КонецФункции

// Проверяет, что строка содержит файловый путь или маркер стек-трейса.
// Все проверки регистронезависимые (через НРег).
Функция СтрокаСодержитСтекИлиПуть(Знач Строка)

	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;

	НижняяСтрока = НРег(Строка);

	// Маркеры стек-трейсов.
	МаркерыСтека = Новый Массив;
	МаркерыСтека.Добавить("в процедуре");
	МаркерыСтека.Добавить("в функции");
	МаркерыСтека.Добавить("stack trace");
	МаркерыСтека.Добавить("traceback");
	МаркерыСтека.Добавить("at line");
	МаркерыСтека.Добавить("{модуль");
	МаркерыСтека.Добавить("{module");

	Для Каждого Маркер Из МаркерыСтека Цикл
		Если СтрНайти(НижняяСтрока, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	// UNC-пути: "\\server\share".
	Если СтрНайти(Строка, "\\") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	// Unix-пути: "/Users/", "/home/", "/var/", "/opt/", "/tmp/", "/etc/".
	UnixПрефиксы = Новый Массив;
	UnixПрефиксы.Добавить("/users/");
	UnixПрефиксы.Добавить("/home/");
	UnixПрефиксы.Добавить("/var/");
	UnixПрефиксы.Добавить("/opt/");
	UnixПрефиксы.Добавить("/tmp/");
	UnixПрефиксы.Добавить("/etc/");
	UnixПрефиксы.Добавить("/usr/");
	UnixПрефиксы.Добавить("/srv/");

	Для Каждого Префикс Из UnixПрефиксы Цикл
		Если СтрНайти(НижняяСтрока, Префикс) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	// Windows-пути: буква диска + ":\" (например "C:\", "D:\").
	АлфавитНижний = "abcdefghijklmnopqrstuvwxyz";
	Для НомерБуквы = 1 По СтрДлина(АлфавитНижний) Цикл
		ПрефиксДиска = Сред(АлфавитНижний, НомерБуквы, 1) + ":\";
		Если СтрНайти(НижняяСтрока, ПрефиксДиска) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// PII-02: Проверяет, что начиная с позиции Позиция в тексте расположена
// последовательность формата СНИЛС с разделителями: "XXX-XXX-XXX YY"
// (3 цифры, "-", 3 цифры, "-", 3 цифры, " ", 2 цифры — ровно 14 символов).
//
// Параметры:
//   Текст    - Строка - исходный текст.
//   Позиция  - Число  - позиция (1-based), с которой проверяется совпадение.
//
// Возвращаемое значение:
//   Булево - Истина, если с указанной позиции начинается СНИЛС с разделителями.
//
Функция ЭтоСНИЛССРазделителями(Знач Текст, Знач Позиция)

	Цифры = "0123456789";
	ДлинаТекста = СтрДлина(Текст);

	Если Позиция + 13 > ДлинаТекста Тогда
		Возврат Ложь;
	КонецЕсли;

	Фрагмент = Сред(Текст, Позиция, 14);

	Для НомерСимвола = 1 По 14 Цикл
		Символ = Сред(Фрагмент, НомерСимвола, 1);

		Если НомерСимвола = 4 ИЛИ НомерСимвола = 8 Тогда
			// Позиции дефисов-разделителей групп.
			Если Символ <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если НомерСимвола = 12 Тогда
			// Позиция пробела перед контрольными цифрами.
			Если Символ <> " " Тогда
				Возврат Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// Все прочие позиции — цифры.
		Если СтрНайти(Цифры, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// PII-02: Проверяет, что начиная с позиции Позиция в тексте расположена
// последовательность формата паспорта РФ с разделителем-пробелом:
// "XXXX XXXXXX" (4 цифры, ровно один пробел, 6 цифр — 11 символов),
// и что по обе стороны от неё — начало/конец строки либо не-цифровой
// символ (чтобы не захватить фрагмент более длинной цифровой
// последовательности, разбитой случайным пробелом).
//
// Параметры:
//   Текст    - Строка - исходный текст.
//   Позиция  - Число  - позиция (1-based), с которой проверяется совпадение.
//
// Возвращаемое значение:
//   Булево - Истина, если с указанной позиции начинается серия+номер паспорта.
//
// PII-07: Длина вхождения телефона РФ, начинающегося с указанной позиции.
//
// Номер = необязательный "+", затем ровно 11 цифр с ведущей 7 или 8,
// между цифрами допустимы разделители " ", "(", ")", "-". Хвостовые
// разделители в длину не включаются: "8 (495) 123-45-67." вернёт длину до
// последней цифры, точка останется в тексте.
//
// Параметры:
//   Текст   - Строка - обрабатываемый текст.
//   Позиция - Число  - позиция предполагаемого начала номера (с 1).
//
// Возвращаемое значение:
//   Число - длина вхождения в символах, либо 0, если с этой позиции номер
//           не начинается.
//
Функция ДлинаТелефонаСПозиции(Знач Текст, Знач Позиция)

	Цифры = "0123456789";
	Разделители = " ()-";
	ДлинаТекста = СтрДлина(Текст);

	Индекс = Позиция;

	// Необязательный ведущий "+".
	Если Индекс <= ДлинаТекста И Сред(Текст, Индекс, 1) = "+" Тогда
		Индекс = Индекс + 1;
	КонецЕсли;

	Если Индекс > ДлинаТекста Тогда
		Возврат 0;
	КонецЕсли;

	// Ведущая цифра российского номера — только 7 или 8.
	ПерваяЦифра = Сред(Текст, Индекс, 1);
	Если ПерваяЦифра <> "7" И ПерваяЦифра <> "8" Тогда
		Возврат 0;
	КонецЕсли;

	КоличествоЦифр = 0;
	ПоследняяЦифраИндекс = 0;

	// Набираем ровно 11 цифр и останавливаемся. Важно не отбрасывать всё
	// вхождение при 12-й цифре: два номера подряд ("8 495 ... 8 495 ...")
	// читались бы как одна длинная цепочка, и первый номер утёк бы открытым.
	Пока Индекс <= ДлинаТекста И КоличествоЦифр < 11 Цикл
		Символ = Сред(Текст, Индекс, 1);

		Если СтрНайти(Цифры, Символ) > 0 Тогда
			КоличествоЦифр = КоличествоЦифр + 1;
			ПоследняяЦифраИндекс = Индекс;
			Индекс = Индекс + 1;

		ИначеЕсли СтрНайти(Разделители, Символ) > 0 Тогда
			Индекс = Индекс + 1;

		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоЦифр <> 11 Тогда
		Возврат 0;
	КонецЕсли;

	// 12-я цифра ВПЛОТНУЮ (без разделителя) — значит это длинное число
	// (ОГРН, артикул, номер счёта), а не телефон. Цифра через разделитель —
	// это уже соседний номер, текущее вхождение остаётся телефоном.
	Если ПоследняяЦифраИндекс + 1 <= ДлинаТекста
		И СтрНайти(Цифры, Сред(Текст, ПоследняяЦифраИндекс + 1, 1)) > 0 Тогда
		Возврат 0;
	КонецЕсли;

	// Длина — до последней цифры включительно, без хвостовых разделителей.
	Возврат ПоследняяЦифраИндекс - Позиция + 1;

КонецФункции

Функция ЭтоПаспортСРазделителем(Знач Текст, Знач Позиция)

	Цифры = "0123456789";
	ДлинаТекста = СтрДлина(Текст);

	Если Позиция + 10 > ДлинаТекста Тогда
		Возврат Ложь;
	КонецЕсли;

	Фрагмент = Сред(Текст, Позиция, 11);

	Для НомерСимвола = 1 По 11 Цикл
		Символ = Сред(Фрагмент, НомерСимвола, 1);

		Если НомерСимвола = 5 Тогда
			// Позиция обязательного пробела между серией и номером.
			Если Символ <> " " Тогда
				Возврат Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// Все прочие позиции — цифры.
		Если СтрНайти(Цифры, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	// Слева от найденной последовательности — начало строки либо не-цифра
	// (чтобы не захватить хвост более длинного числа с пробелом внутри).
	Если Позиция > 1 Тогда
		СимволСлева = Сред(Текст, Позиция - 1, 1);
		Если СтрНайти(Цифры, СимволСлева) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	// Справа от найденной последовательности — конец строки либо не-цифра.
	ПозицияСправа = Позиция + 11;
	Если ПозицияСправа <= ДлинаТекста Тогда
		СимволСправа = Сред(Текст, ПозицияСправа, 1);
		Если СтрНайти(Цифры, СимволСправа) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Заменяет последовательности вида <Префикс><Токен> на <Замена>.
// Токен — до первого разделителя или конца строки.
Функция ЗаменитьТокеныПоПрефиксу(Текст, Префикс, Замена)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	РазделителиТокена = " " + Символы.Таб + Символы.ПС + Символы.ВК + """'<>,;)]}";

	Результат = "";
	Позиция = 1;
	ДлинаТекста = СтрДлина(Текст);
	ДлинаПрефикса = СтрДлина(Префикс);

	Пока Позиция <= ДлинаТекста Цикл
		ИндексПрефикса = СтрНайти(Текст, Префикс, НаправлениеПоиска.СНачала, Позиция);
		Если ИндексПрефикса = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;

		Результат = Результат + Сред(Текст, Позиция, ИндексПрефикса - Позиция);

		// Определяем конец токена.
		КонецТокена = ДлинаТекста + 1;
		Для НомерСимвола = ИндексПрефикса + ДлинаПрефикса По ДлинаТекста Цикл
			Если СтрНайти(РазделителиТокена, Сред(Текст, НомерСимвола, 1)) > 0 Тогда
				КонецТокена = НомерСимвола;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		// Заменяем токен только если за префиксом есть хотя бы один не-разделитель.
		Если КонецТокена > ИндексПрефикса + ДлинаПрефикса Тогда
			Результат = Результат + Замена;
		Иначе
			Результат = Результат + Сред(Текст, ИндексПрефикса, КонецТокена - ИндексПрефикса);
		КонецЕсли;

		Позиция = КонецТокена;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет "Bearer <токен>" на "Bearer ***" с учётом регистра префикса.
Функция ЗаменитьBearerТокены(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	РазделителиТокена = " " + Символы.Таб + Символы.ПС + Символы.ВК + """'<>,;)]}";

	Результат = "";
	Позиция = 1;
	ДлинаТекста = СтрДлина(Текст);

	Пока Позиция <= ДлинаТекста Цикл
		// Ищем без учёта регистра.
		НижнийОстаток = НРег(Сред(Текст, Позиция));
		ОтносительныйИндекс = СтрНайти(НижнийОстаток, "bearer ");
		Если ОтносительныйИндекс = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;

		ИндексBearer = Позиция + ОтносительныйИндекс - 1;
		Результат = Результат + Сред(Текст, Позиция, ИндексBearer - Позиция);
		Результат = Результат + Сред(Текст, ИндексBearer, 7); // "Bearer " с оригинальным регистром

		НачалоТокена = ИндексBearer + 7;
		КонецТокена = ДлинаТекста + 1;
		Для НомерСимвола = НачалоТокена По ДлинаТекста Цикл
			Если СтрНайти(РазделителиТокена, Сред(Текст, НомерСимвола, 1)) > 0 Тогда
				КонецТокена = НомерСимвола;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если КонецТокена > НачалоТокена Тогда
			Результат = Результат + "***";
		КонецЕсли;

		Позиция = КонецТокена;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, что значение принадлежит ссылочному типу, хранящемуся в БД
// (справочник, документ, план видов характеристик и т.п.), то есть такому,
// для которого работает ПолучитьНавигационнуюСсылку.
// Перечисления НЕ считаются таковыми - см. тело функции.
Функция ЭтоСсылочныйТип(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если МетаданныеЗначения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// Перечисления - тоже объекты метаданных, но НЕ хранятся в БД: для них
	// ПолучитьНавигационнуюСсылку падает с "Cannot get a URL by a value of
	// <...> type". Исключаем явно.
	Если Метаданные.Перечисления.Содержит(МетаданныеЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Сопоставляет полное имя объекта метаданных ("Справочник.ar_Агенты")
// с именем типа ссылки на него ("СправочникСсылка.ar_Агенты").
// Используется в ОбъектИзНавигационнойСсылки для разбора "e1cib/data/...".
//
// Параметры:
//   ПолноеИмяОбъекта - Строка - вида "<КлассМетаданных>.<ИмяОбъекта>".
//
// Возвращаемое значение:
//   Строка - имя типа ссылки, либо "" если класс метаданных не ссылочный/не распознан.
//
// Возвращает пустую ссылку объекта по полному имени "<Класс>.<Имя>" (например
// "Справочник._ДемоБанковскиеСчета") через менеджер соответствующей коллекции.
// Пустая ссылка нужна как источник корректного внутреннего представления в
// ОбъектИзНавигационнойСсылки (ROREF-03). Неизвестный класс / несуществующий
// объект → Неопределено. Не выбрасывает (менеджер по несуществующему имени -
// через .Найти, а не индексатор, который бросает исключение).
//
Функция ПустаяСсылкаПоПолномуИмениОбъекта(Знач ПолноеИмяОбъекта)

	ПозицияТочки = СтрНайти(ПолноеИмяОбъекта, ".");
	Если ПозицияТочки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КлассМетаданных = Лев(ПолноеИмяОбъекта, ПозицияТочки - 1);
	ИмяОбъекта      = Сред(ПолноеИмяОбъекта, ПозицияТочки + 1);
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если КлассМетаданных = "Справочник" Тогда
		Коллекция = Справочники;
		МетаКоллекция = Метаданные.Справочники;
	ИначеЕсли КлассМетаданных = "Документ" Тогда
		Коллекция = Документы;
		МетаКоллекция = Метаданные.Документы;
	ИначеЕсли КлассМетаданных = "ПланВидовХарактеристик" Тогда
		Коллекция = ПланыВидовХарактеристик;
		МетаКоллекция = Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли КлассМетаданных = "ПланСчетов" Тогда
		Коллекция = ПланыСчетов;
		МетаКоллекция = Метаданные.ПланыСчетов;
	ИначеЕсли КлассМетаданных = "ПланВидовРасчета" Тогда
		Коллекция = ПланыВидовРасчета;
		МетаКоллекция = Метаданные.ПланыВидовРасчета;
	ИначеЕсли КлассМетаданных = "ПланОбмена" Тогда
		Коллекция = ПланыОбмена;
		МетаКоллекция = Метаданные.ПланыОбмена;
	ИначеЕсли КлассМетаданных = "БизнесПроцесс" Тогда
		Коллекция = БизнесПроцессы;
		МетаКоллекция = Метаданные.БизнесПроцессы;
	ИначеЕсли КлассМетаданных = "Задача" Тогда
		Коллекция = Задачи;
		МетаКоллекция = Метаданные.Задачи;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	// Проверяем существование объекта по метаданным - индексатор Коллекция[Имя]
	// на несуществующем имени бросает исключение.
	Если МетаКоллекция.Найти(ИмяОбъекта) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Коллекция[ИмяОбъекта].ПустаяСсылка();

КонецФункции

// PII-07: Проверяет, похож ли фрагмент (последовательность допустимых для
// email символов, уже без хвостовых разделителей) на email-адрес.
//
// Критерии: ровно один "@", непустая локальная часть, домен из непустых
// частей через ".", зона (после последней точки) — минимум 2 латинские буквы.
//
// Параметры:
//   Фрагмент - Строка - кандидат из МаскироватьEmail.
//
// Возвращаемое значение:
//   Булево - Истина, если фрагмент следует замаскировать как email.
//
Функция ЭтоEmailФрагмент(Знач Фрагмент)

	Если СтрЧислоВхождений(Фрагмент, "@") <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПозицияЭт = СтрНайти(Фрагмент, "@");
	ЛокальнаяЧасть = Лев(Фрагмент, ПозицияЭт - 1);
	Домен = Сред(Фрагмент, ПозицияЭт + 1);

	Если ПустаяСтрока(ЛокальнаяЧасть) ИЛИ СтрНайти(Домен, ".") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ЧастиДомена = СтрРазделить(Домен, ".");
	Для Каждого Часть Из ЧастиДомена Цикл
		Если ПустаяСтрока(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Зона = ЧастиДомена[ЧастиДомена.ВГраница()];
	Если СтрДлина(Зона) < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Буквы = "abcdefghijklmnopqrstuvwxyz";
	Для Ном = 1 По СтрДлина(Зона) Цикл
		Если СтрНайти(Буквы, НРег(Сред(Зона, Ном, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Записывает ошибку в журнал регистрации с маскировкой секретов.
Процедура ЗаписатьОшибку(Знач ИнформацияОбОшибке)

	ТекстОшибки = МаскироватьСекреты(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	ЗаписьЖурналаРегистрации(
		НСтр("ru='ar_Утилиты'; en='aosUtilities'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);

КонецПроцедуры

// Записывает предупреждение в журнал регистрации с маскировкой секретов.
Процедура ЗаписатьПредупреждение(Знач Текст)

	ЗаписьЖурналаРегистрации(
		НСтр("ru='ar_Утилиты'; en='aosUtilities'"),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		МаскироватьСекреты(Текст));

КонецПроцедуры

#КонецОбласти
