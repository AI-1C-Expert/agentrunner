////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolПакеты (PKG-03).
//
// Единственное место, где ядро AgentRunner ЧИТАЕТ внешний пакет tools
// (доп. обработку БСП "Дополнительные отчёты и обработки"): находит
// кандидатов, загружает манифест, валидирует его и заводит записи в
// Справочник.ar_Tools / РегистрСведений.ar_ПакетыTools.
//
// Решение (см. .docs/specs/PKG-03.md): пакеты регистрируются ТОЛЬКО явным
// действием администратора - через ЗарегистрироватьПакет по команде из формы
// настроек (PKG-06). ar_ToolDispatcher.АвтоЗаполнитьРеестрToolsПриЗапуске НЕ
// вызывает ничего из этого модуля - см. комментарий в её шапке. Загрузка
// внешнего кода при старте системы без ведома администратора недопустима:
// ВнешниеОбработки.Создать() - это исполнение чужого кода.
//
// Предусловие доступности механизма - ОБА условия:
//   1. ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки")
//   2. ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеОтчетыИОбработки")
// Пункт 2 - прямое требование БСП (см. описание
// ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки: "проверка функциональной
// опции должна выполняться вызывающим кодом"). Обращение к модулю БСП -
// ТОЛЬКО через ОбщегоНазначения.ОбщийМодуль(...), без прямой ссылки в тексте
// модуля - иначе расширение не загрузится в конфигурацию без подсистемы
// (тот же приём для ВерсионированиеОбъектов - см. ar_ToolUniversal).
//
// НайтиКандидатов() отбирает потенциальные пакеты ЗАПРОСОМ по ТЧ Команды
// справочника ДополнительныеОтчетыИОбработки (маркер "ar_ToolPack") - без
// единого вызова ВнешниеОбработки.Создать(). Загрузка бинарника происходит
// только для отобранных кандидатов и только по явной команде
// (ПрочитатьМанифестКандидата / ЗарегистрироватьПакет).
//
// Свойства модуля: Сервер, без вызова с клиента, без привилегированного
// режима по умолчанию (поднимается точечно там, где требует запись аудита -
// парой Истина/Ложь через try/finally).
//
// Запрещено: Выполнить(), Вычислить().
//
// См. спеку: .docs/specs/PKG-03.md, .docs/План-гибкие-tools.md §2.3, §2.6,
// Часть 4 блок A, Часть 5 решения 2-3.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет доступность механизма пакетов tools: наличие подсистемы БСП
// "Дополнительные отчёты и обработки" в конфигурации и включённость
// одноимённой функциональной опции.
//
// Возвращаемое значение:
//  Структура:
//   * Доступен - Булево - Истина, если механизм можно использовать.
//   * Причина  - Строка - код причины недоступности ("" при Доступен = Истина):
//                "subsystem_missing" / "functional_option_disabled".
//
Функция МеханизмПакетовДоступен() Экспорт

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки") Тогда
		Возврат НовыйРезультатДоступности(Ложь, "subsystem_missing");
	КонецЕсли;

	ОпцияВключена = Ложь;
	Попытка
		ОпцияВключена = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеОтчетыИОбработки");
	Исключение
		// Функциональная опция отсутствует в конфигурации либо иная ошибка
		// платформы при обращении к ней - трактуем как недоступность механизма,
		// а не как падение ядра.
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.МеханизмПакетовДоступен", "functional_option_check_error",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
		Возврат НовыйРезультатДоступности(Ложь, "functional_option_disabled");
	КонецПопытки;

	Если Не ОпцияВключена Тогда
		Возврат НовыйРезультатДоступности(Ложь, "functional_option_disabled");
	КонецЕсли;

	Возврат НовыйРезультатДоступности(Истина, "");

КонецФункции

// Находит кандидатов на регистрацию как пакет tools - ЗАПРОСОМ по ТЧ Команды
// справочника ДополнительныеОтчетыИОбработки, БЕЗ загрузки бинарников
// (ВнешниеОбработки.Создать() здесь не вызывается ни разу).
//
// Отбор идёт по маркерной команде с Идентификатор = "ar_ToolPack" (контракт
// PKG-01, см. examples/ar_ПакетПример) - исключены обработки с пометкой
// удаления и с Публикация = Отключена.
//
// Текст запроса обращается к справочнику ДополнительныеОтчетыИОбработки,
// которого нет в конфигурации без соответствующей подсистемы БСП - поэтому
// вызов ГАРАНТИРОВАННО предваряется проверкой МеханизмПакетовДоступен(), а
// Выполнить() запроса дополнительно обёрнут в Попытка на случай, если
// проверка предусловия и фактическое состояние метаданных разошлись.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ссылка / ИмяОбъекта / БезопасныйРежим / Версия.
//  Пустая таблица, если механизм недоступен или запрос завершился ошибкой.
//
Функция НайтиКандидатов() Экспорт

	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Ссылка");
	ПустаяТаблица.Колонки.Добавить("ИмяОбъекта");
	ПустаяТаблица.Колонки.Добавить("БезопасныйРежим");
	ПустаяТаблица.Колонки.Добавить("Версия");

	Доступность = МеханизмПакетовДоступен();
	Если Не Доступность.Доступен Тогда
		Возврат ПустаяТаблица;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МаркерПакета", МаркерПакетаToolPack());
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Команды.Ссылка.Ссылка КАК Ссылка,
		|	Команды.Ссылка.ИмяОбъекта КАК ИмяОбъекта,
		|	Команды.Ссылка.БезопасныйРежим КАК БезопасныйРежим,
		|	Команды.Ссылка.Версия КАК Версия
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК Команды
		|ГДЕ
		|	Команды.Идентификатор = &МаркерПакета
		|	И НЕ Команды.Ссылка.ПометкаУдаления
		|	И Команды.Ссылка.Публикация <> ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена)";

	Попытка
		Возврат Запрос.Выполнить().Выгрузить();
	Исключение
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.НайтиКандидатов", "candidates_query_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат ПустаяТаблица;
	КонецПопытки;

КонецФункции

// Загружает манифест пакета у ОТОБРАННОГО кандидата: поднимает объект внешней
// обработки через БСП и вызывает её контрактный метод ar_ОписаниеTools().
// Единственная точка, где для пакета вызывается загрузка бинарника
// (МодульДопОбработки.ОбъектВнешнейОбработки) - вызывается только явно, не из
// НайтиКандидатов().
//
// Изолирована в Попытка целиком: отсутствие метода в пакете, исключение
// внутри пакета, возврат не-Структуры - всё это не должно ронять ядро.
//
// Параметры:
//  ИдентификаторОбработки - Строка - строковое представление UUID ссылки на
//                           элемент справочника ДополнительныеОтчетыИОбработки.
//
// Возвращаемое значение:
//  Структура:
//   * Успех    - Булево  - Истина, если манифест получен и это Структура.
//   * Манифест - Структура - манифест пакета (см. контракт PKG-01), либо
//                Неопределено при Успех = Ложь.
//   * Причина  - Строка - код причины отказа при Успех = Ложь:
//                "package_contract_violation:ar_ОписаниеTools" /
//                "manifest_read_error" / "manifest_not_structure" /
//                "mechanism_unavailable" / "reference_not_found".
//
Функция ПрочитатьМанифестКандидата(Знач ИдентификаторОбработки) Экспорт

	Доступность = МеханизмПакетовДоступен();
	Если Не Доступность.Доступен Тогда
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "mechanism_unavailable");
	КонецЕсли;

	СсылкаОбработки = СсылкаПоИдентификатору(ИдентификаторОбработки);
	Если Не ЗначениеЗаполнено(СсылкаОбработки) Тогда
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "reference_not_found");
	КонецЕсли;

	Попытка
		МодульДопОбработки = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
		ВнешнийОбъект = МодульДопОбработки.ОбъектВнешнейОбработки(СсылкаОбработки);
	Исключение
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ПрочитатьМанифестКандидата", "manifest_read_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "manifest_read_error");
	КонецПопытки;

	Если ВнешнийОбъект = Неопределено Тогда
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ПрочитатьМанифестКандидата", "manifest_read_error",
			ИдентификаторОбработки + ": " + НСтр("ru = 'ссылка не разыменована в объект внешней обработки'"), "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "manifest_read_error");
	КонецЕсли;

	Попытка
		Манифест = ВнешнийОбъект.ar_ОписаниеTools();
	Исключение
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ПрочитатьМанифестКандидата", "package_contract_violation",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "package_contract_violation:ar_ОписаниеTools");
	КонецПопытки;

	Если ТипЗнч(Манифест) <> Тип("Структура") Тогда
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ПрочитатьМанифестКандидата", "manifest_not_structure",
			ИдентификаторОбработки, "Ошибка");
		Возврат НовыйРезультатЧтенияМанифеста(Ложь, Неопределено, "manifest_not_structure");
	КонецЕсли;

	Возврат НовыйРезультатЧтенияМанифеста(Истина, Манифест, "");

КонецФункции

// Валидирует манифест пакета по полному набору проверок контракта PKG-01
// (см. .docs/specs/PKG-03.md §3): schema_version, namespace, версия пакета,
// состав Tools, namespacing имён, коллизии с реестром ar_Tools, структура
// OpenAI tool-format каждого JSONManifest, RiskLevel, ТребуетApproval для
// рискованных операций, форматы ТребуемыеОбъекты/ТребуемыеПодсистемы.
//
// Возвращает ВСЕ найденные ошибки массивом, а не первую - администратор
// должен увидеть полный список несоответствий, а не чинить их по одной.
//
// Параметры:
//  Манифест               - Структура - манифест пакета (см.
//                            ПрочитатьМанифестКандидата).
//  ИдентификаторОбработки - Строка - идентификатор пакета, который
//                            проверяется - используется для правила
//                            "повторная регистрация того же пакета не
//                            считается коллизией со своими же именами".
//
// Возвращаемое значение:
//  Структура:
//   * Корректно - Булево - Истина, если ошибок нет.
//   * Ошибки    - Массив строк - коды причин отказа (см. таблицу в §3 спеки).
//
Функция ВалидироватьМанифест(Знач Манифест, Знач ИдентификаторОбработки) Экспорт

	Ошибки = Новый Массив;

	Если ТипЗнч(Манифест) <> Тип("Структура") Тогда
		Ошибки.Добавить("manifest_not_structure");
		Возврат РезультатВалидации(Ложь, Ошибки);
	КонецЕсли;

	// 1. schema_version.
	SchemaVersion = Неопределено;
	Манифест.Свойство("schema_version", SchemaVersion);
	Если Не ЭтоЧисло(SchemaVersion) Тогда
		Ошибки.Добавить("unsupported_schema_version:" + ПредставлениеЗначенияПакета(SchemaVersion));
	ИначеЕсли SchemaVersion > ПоддерживаемаяВерсияСхемы() Тогда
		Ошибки.Добавить("unsupported_schema_version:" + Формат(SchemaVersion, "ЧГ=0"));
	Иначе
		// schema_version корректна - ошибок нет.
	КонецЕсли;

	// 2-3. namespace: формат + коллизия с другим пакетом.
	Namespace = Неопределено;
	Манифест.Свойство("namespace", Namespace);
	Если ТипЗнч(Namespace) <> Тип("Строка") Или Не СоответствуетФорматуNamespace(Namespace) Тогда
		Ошибки.Добавить("invalid_namespace:" + ПредставлениеЗначенияПакета(Namespace));
	ИначеЕсли NamespaceЗанятДругимПакетом(Namespace, ИдентификаторОбработки) Тогда
		Ошибки.Добавить("namespace_collision:" + Namespace);
	Иначе
		// namespace корректен и свободен - ошибок нет.
	КонецЕсли;

	// 4. Версия пакета.
	ВерсияПакета = Неопределено;
	Манифест.Свойство("Версия", ВерсияПакета);
	Если ТипЗнч(ВерсияПакета) <> Тип("Строка") Или ПустаяСтрока(ВерсияПакета) Тогда
		Ошибки.Добавить("invalid_package_version");
	КонецЕсли;

	// 5. Tools - непустой массив.
	Tools = Неопределено;
	Манифест.Свойство("Tools", Tools);
	Если ТипЗнч(Tools) <> Тип("Массив") Или Tools.Количество() = 0 Тогда
		Ошибки.Добавить("package_has_no_tools");
		// Дальше по манифесту (проверки 6-11) нечего валидировать без Tools.
		Возврат РезультатВалидации(Ошибки.Количество() = 0, Ошибки);
	КонецЕсли;

	NamespaceДляПроверки = ?(ТипЗнч(Namespace) = Тип("Строка"), Namespace, "");

	Для Каждого ОписаниеTool Из Tools Цикл
		ВалидироватьОдинTool(ОписаниеTool, NamespaceДляПроверки, ИдентификаторОбработки, Ошибки);
	КонецЦикла;

	Возврат РезультатВалидации(Ошибки.Количество() = 0, Ошибки);

КонецФункции

// Полный цикл регистрации пакета: чтение манифеста -> валидация -> запись
// РегистрСведений.ar_ПакетыTools + Справочник.ar_Tools -> пересчёт
// доступности всех tools. Транзакционно: полурегистрация пакета хуже отказа.
//
// Параметры:
//  ИдентификаторОбработки - Строка - идентификатор кандидата (см.
//                           НайтиКандидатов).
//
// Возвращаемое значение:
//  Структура:
//   * Успех         - Булево - Истина при успешной регистрации.
//   * Статус        - Строка - "Зарегистрирован" / "Отклонён".
//   * ПричинаОтказа - Строка - при Статус = "Отклонён": первая или сводная
//                     причина (полный список - в ar_СлужебныйЛог).
//   * КоличествоTools - Число - число зарегистрированных tools пакета.
//
Функция ЗарегистрироватьПакет(Знач ИдентификаторОбработки) Экспорт

	ЧтениеМанифеста = ПрочитатьМанифестКандидата(ИдентификаторОбработки);
	Если Не ЧтениеМанифеста.Успех Тогда
		ЗафиксироватьОтклонённыйПакет(ИдентификаторОбработки, ЧтениеМанифеста.Причина);
		Возврат РезультатРегистрации(Ложь, "Отклонён", ЧтениеМанифеста.Причина, 0);
	КонецЕсли;

	Валидация = ВалидироватьМанифест(ЧтениеМанифеста.Манифест, ИдентификаторОбработки);
	Если Не Валидация.Корректно Тогда
		ПричинаСводная = СтрСоединить(Валидация.Ошибки, "; ");
		ЗафиксироватьОтклонённыйПакет(ИдентификаторОбработки, ПричинаСводная);
		Возврат РезультатРегистрации(Ложь, "Отклонён", ПричинаСводная, 0);
	КонецЕсли;

	Кандидат = СведенияОКандидате(ИдентификаторОбработки);

	НачатьТранзакцию();
	Попытка
		КоличествоTools = ЗаписатьПакетИTools(ИдентификаторОбработки, ЧтениеМанифеста.Манифест, Кандидат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ЗарегистрироватьПакет", "package_registration_write_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат РезультатРегистрации(Ложь, "Отклонён", "registration_write_error", 0);
	КонецПопытки;

	// Пересчёт доступности выполняется ПОСЛЕ фиксации транзакции регистрации
	// намеренно (см. спеку §5): транзакция покрывает только запись
	// ar_ПакетыTools + ar_Tools пакета, пересчёт по всему реестру - отдельная,
	// более широкая операция без прямого отношения к атомарности регистрации
	// одного пакета; если он упадёт, пакет уже зарегистрирован корректно, а
	// доступность будет пересчитана при следующем изменении реестра.
	ar_ToolDispatcher.ПересчитатьДоступностьВсехTools();

	// Свойство() вместо доступа через точку - на этом шаге манифест уже прошёл
	// ВалидироватьМанифест (namespace гарантированно есть), но безопасный доступ
	// дешевле, чем риск падения в строке лога после успешной записи.
	NamespaceДляЛога = "";
	ЧтениеМанифеста.Манифест.Свойство("namespace", NamespaceДляЛога);
	ar_СлужебныйЛог.Записать("ar_ToolПакеты.ЗарегистрироватьПакет", "package_registered",
		ИдентификаторОбработки + " (namespace=" + NamespaceДляЛога + ")", "Информация");

	Если Не Кандидат.БезопасныйРежим Тогда
		// PKG-05 §3: регистрация пакета с БезопасныйРежим = Ложь ПРОХОДИТ
		// (решение 2 Части 5 - барьерной константы нет), но фиксируется двумя
		// независимыми механизмами - служебный лог для оперативной диагностики
		// и отдельное событие аудита package_registered_unsafe (администратор
		// сознательно допустил пакет с доступом к файловой системе/сети/внешним
		// компонентам).
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ЗарегистрироватьПакет", "package_registered_unsafe_mode",
			ИдентификаторОбработки, "Предупреждение");

		ВерсияПакетаДляАудита = "";
		ЧтениеМанифеста.Манифест.Свойство("Версия", ВерсияПакетаДляАудита);
		ПолезнаяНагрузкаНебезопасно = Новый Структура;
		ПолезнаяНагрузкаНебезопасно.Вставить("package", ИдентификаторОбработки);
		ПолезнаяНагрузкаНебезопасно.Вставить("namespace", NamespaceДляЛога);
		ПолезнаяНагрузкаНебезопасно.Вставить("version", ВерсияПакетаДляАудита);
		ПолезнаяНагрузкаНебезопасно.Вставить("tools_count", КоличествоTools);
		ПолезнаяНагрузкаНебезопасно.Вставить("actor", ИмяТекущегоПользователяПакетов());
		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", "package_registered_unsafe",
			ПолезнаяНагрузкаНебезопасно);
	КонецЕсли;

	Возврат РезультатРегистрации(Истина, "Зарегистрирован", "", КоличествоTools);

КонецФункции

// Отключает зарегистрированный пакет: статус -> "Отключён", все tools пакета
// -> ar_Включён = Ложь. Запись ar_ПакетыTools остаётся (история), записи
// ar_Tools не удаляются - на них ссылается история вызовов ar_ДействияАгента.
//
// Параметры:
//  ИдентификаторОбработки - Строка - идентификатор пакета.
//
// Возвращаемое значение:
//  Булево - Истина, если запись пакета найдена и отключена.
//
Функция ОтключитьПакет(Знач ИдентификаторОбработки) Экспорт

	НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запись = НаборЗаписей[0];
		Запись.ar_Статус = "Отключён";
		НаборЗаписей.Записать(Истина);

		ОтключитьToolsПакета(ИдентификаторОбработки);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ОтключитьПакет", "package_disable_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат Ложь;
	КонецПопытки;

	ar_ToolDispatcher.ПересчитатьДоступностьВсехTools();

	ar_СлужебныйЛог.Записать("ar_ToolПакеты.ОтключитьПакет", "package_disabled", ИдентификаторОбработки, "Информация");

	Возврат Истина;

КонецФункции

// Обходит все зарегистрированные пакеты (статус "Зарегистрирован" или
// "ТребуетПереподтверждения") и сверяет хеш их текущего манифеста с
// сохранённым в ar_ПакетыTools.ar_ХешМанифеста. Дорогая операция (грузит
// бинарник каждого пакета) - вызывается только из формы настроек (PKG-06),
// не из горячего пути вызова tool.
//
// Расхождение хеша -> статус "ТребуетПереподтверждения", tools пакета
// получают ar_Доступен = Ложь (не ar_Включён - доступность вычисляемая, воля
// администратора не трогается, см. разделение полей в UNIV-03).
//
// Возвращаемое значение:
//  Структура:
//   * Проверено   - Число - количество проверенных пакетов.
//   * Изменилось  - Число - количество пакетов, у которых обнаружено
//                   расхождение хеша.
//
Функция ПроверитьХешиПакетов() Экспорт

	Проверено = 0;
	Изменилось = 0;

	Для Каждого ИдентификаторОбработки Из СписокЗарегистрированныхПакетов() Цикл

		Проверено = Проверено + 1;

		ЧтениеМанифеста = ПрочитатьМанифестКандидата(ИдентификаторОбработки);
		Если Не ЧтениеМанифеста.Успех Тогда
			// Пакет, который перестал читаться (удалён/сломан) - фиксируем
			// отклонение, но не удаляем историю регистрации.
			ЗафиксироватьОтклонённыйПакет(ИдентификаторОбработки, ЧтениеМанифеста.Причина);
			Изменилось = Изменилось + 1;
			Продолжить;
		КонецЕсли;

		НовыйХеш = ХешМанифеста(ЧтениеМанифеста.Манифест);
		ТекущийХеш = ХешПакетаИзРегистра(ИдентификаторОбработки);

		Если НовыйХеш <> ТекущийХеш Тогда
			ЗафиксироватьТребуетПереподтверждения(ИдентификаторОбработки, НовыйХеш);
			Изменилось = Изменилось + 1;
		КонецЕсли;

	КонецЦикла;

	Если Изменилось > 0 Тогда
		ar_ToolDispatcher.ПересчитатьДоступностьВсехTools();
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ToolПакеты.ПроверитьХешиПакетов", "packages_hash_checked",
		"Проверено: " + Проверено + ", изменилось: " + Изменилось, "Информация");

	Результат = Новый Структура;
	Результат.Вставить("Проверено", Проверено);
	Результат.Вставить("Изменилось", Изменилось);
	Возврат Результат;

КонецФункции

// Список tools, зарегистрированных из указанного пакета - для UI (PKG-06).
//
// Параметры:
//  ИдентификаторОбработки - Строка - идентификатор пакета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ссылка / Имя / RiskLevel / Включён / Доступен.
//
Функция ToolsПакета(Знач ИдентификаторОбработки) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПакета", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_RiskLevel КАК RiskLevel,
		|	Tools.ar_Включён КАК Включён,
		|	Tools.ar_Доступен КАК Доступен
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_ИсточникТип = ""Пакет""
		|	И Tools.ar_ИдентификаторПакета = &ИдентификаторПакета
		|	И НЕ Tools.ПометкаУдаления";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает ВСЕ известные реестру namespace пакетов (независимо от текущего
// статуса - "Зарегистрирован"/"ТребуетПереподтверждения"/"Отключён"/"Отклонён")
// вместе с признаком активности. PKG-05 §6: guard импорта пресетов
// (ar_ПресетыИмпорт.ЗаполнитьTools) отличает "имя похоже на tool ИЗВЕСТНОГО,
// но сейчас неактивного пакета" (диагностируемый отказ
// package_not_installed:<ns>) от "имя вообще не относится ни к одному
// известному пакету" (обычный tool_not_found, как и раньше).
//
// Возвращаемое значение:
//  Соответствие - Namespace (Строка) -> Активен (Булево, Истина для статусов
//  "Зарегистрирован"/"ТребуетПереподтверждения"). Namespace, встречающийся в
//  нескольких записях реестра, считается активным, если активна хотя бы одна.
//
Функция ВсеИзвестныеNamespace() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_Namespace КАК Namespace,
		|	Пакеты.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace <> """"";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Активен = (Выборка.Статус = "Зарегистрирован" Или Выборка.Статус = "ТребуетПереподтверждения");
		ТекущееЗначение = Результат.Получить(Выборка.Namespace);
		Если ТекущееЗначение = Неопределено Тогда
			Результат.Вставить(Выборка.Namespace, Активен);
		ИначеЕсли Активен И Не ТекущееЗначение Тогда
			Результат.Вставить(Выборка.Namespace, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Маркерное значение реквизита Идентификатор ТЧ Команды - контракт PKG-01
// (см. examples/ar_ПакетПример). Регистрозависимое и фиксированное.
Функция МаркерПакетаToolPack()
	Возврат "ar_ToolPack";
КонецФункции

// Версия схемы контракта манифеста, поддерживаемая текущим ядром.
Функция ПоддерживаемаяВерсияСхемы()
	Возврат 1;
КонецФункции

// Конструктор результата МеханизмПакетовДоступен().
Функция НовыйРезультатДоступности(Знач Доступен, Знач Причина)
	Возврат Новый Структура("Доступен, Причина", Доступен, Причина);
КонецФункции

// Конструктор результата ПрочитатьМанифестКандидата().
Функция НовыйРезультатЧтенияМанифеста(Знач Успех, Знач Манифест, Знач Причина)
	Возврат Новый Структура("Успех, Манифест, Причина", Успех, Манифест, Причина);
КонецФункции

// Конструктор результата ВалидироватьМанифест().
Функция РезультатВалидации(Знач Корректно, Знач Ошибки)
	Возврат Новый Структура("Корректно, Ошибки", Корректно, Ошибки);
КонецФункции

// Конструктор результата ЗарегистрироватьПакет().
Функция РезультатРегистрации(Знач Успех, Знач Статус, Знач ПричинаОтказа, Знач КоличествоTools)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("ПричинаОтказа", ПричинаОтказа);
	Результат.Вставить("КоличествоTools", КоличествоTools);
	Возврат Результат;
КонецФункции

// Возвращает ссылку на элемент справочника ДополнительныеОтчетыИОбработки по
// строковому идентификатору (UUID). Справочник НЕ заимствован в расширение
// (см. PKG-02) - разыменование через универсальную коллекцию Справочники по
// имени, а не через типизированное свойство Справочники.ДополнительныеОтчетыИОбработки,
// чтобы модуль оставался компилируемым в конфигурации без подсистемы БСП.
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - ссылка, либо
//  Неопределено при некорректном UUID.
//
Функция СсылкаПоИдентификатору(Знач ИдентификаторОбработки)

	Попытка
		UUID = Новый УникальныйИдентификатор(ИдентификаторОбработки);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		МенеджерСправочника = Справочники["ДополнительныеОтчетыИОбработки"];
		Возврат МенеджерСправочника.ПолучитьСсылку(UUID);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Проверяет тип "число" без привязки к конкретному числовому подтипу JSON
// (schema_version может прийти как Число из ar_JSON.ИзJSON).
Функция ЭтоЧисло(Знач Значение)
	Возврат ТипЗнч(Значение) = Тип("Число");
КонецФункции

// Формат namespace: [a-z][a-z0-9_]{1,30} - латиница в нижнем регистре, первый
// символ - буква, длина 2-31 символ. Без РегулярныеВыражения (нет в 1С
// глобальном контексте) - посимвольная проверка.
Функция СоответствуетФорматуNamespace(Знач Namespace)

	Длина = СтрДлина(Namespace);
	Если Длина < 2 Или Длина > 31 Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрочныеБуквы = "abcdefghijklmnopqrstuvwxyz";
	Цифры = "0123456789";

	ПервыйСимвол = Сред(Namespace, 1, 1);
	Если СтрНайти(СтрочныеБуквы, ПервыйСимвол) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 2 По Длина Цикл
		Символ = Сред(Namespace, Позиция, 1);
		Если СтрНайти(СтрочныеБуквы, Символ) = 0 И СтрНайти(Цифры, Символ) = 0 И Символ <> "_" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет, занят ли namespace ДРУГИМ зарегистрированным пакетом. Повторная
// регистрация того же пакета (тот же ИдентификаторОбработки) коллизией не
// считается - иначе обновление пакета стало бы невозможным.
Функция NamespaceЗанятДругимПакетом(Знач Namespace, Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Namespace", Namespace);
	Запрос.УстановитьПараметр("ИдентификаторОбработки", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Namespace = &Namespace
		|	И Пакеты.ar_ИдентификаторОбработки <> &ИдентификаторОбработки
		|	И Пакеты.ar_Статус <> ""Отклонён""";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

// Проверяет один элемент массива Tools манифеста - проверки 6-11 из §3
// спеки. Найденные ошибки добавляются в МассивОшибок (передан по ссылке).
Процедура ВалидироватьОдинTool(Знач ОписаниеTool, Знач Namespace, Знач ИдентификаторОбработки, МассивОшибок)

	Если ТипЗнч(ОписаниеTool) <> Тип("Структура") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest::not_a_structure");
		Возврат;
	КонецЕсли;

	Имя = Неопределено;
	ОписаниеTool.Свойство("Имя", Имя);
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest::Имя");
		Возврат;
	КонецЕсли;

	// 4а. Описание tool - обязательное поле контракта PKG-01 (§1.5, строка 167):
	// "Описание - Строка(до 500 симв.), да". Без этой проверки манифест без
	// Описания проходил бы валидацию и падал уже в ЗаписатьПакетИTools при
	// прямом обращении ОписаниеTool.Описание.
	Описание = Неопределено;
	ОписаниеTool.Свойство("Описание", Описание);
	Если ТипЗнч(Описание) <> Тип("Строка") Или ПустаяСтрока(Описание) Тогда
		МассивОшибок.Добавить("invalid_tool_description:" + Имя);
	КонецЕсли;

	// 4б. Версия tool - обязательное поле контракта PKG-01 (§1.5, строка 172):
	// "Версия - Строка, да" (SemVer, версионируется независимо от Версии пакета).
	ВерсияTool = Неопределено;
	ОписаниеTool.Свойство("Версия", ВерсияTool);
	Если ТипЗнч(ВерсияTool) <> Тип("Строка") Или ПустаяСтрока(ВерсияTool) Тогда
		МассивОшибок.Добавить("invalid_tool_version:" + Имя);
	КонецЕсли;

	// 6. namespacing имени.
	ПрефиксОжидаемый = Namespace + "_";
	Если Лев(Имя, СтрДлина(ПрефиксОжидаемый)) <> ПрефиксОжидаемый Тогда
		МассивОшибок.Добавить("name_not_namespaced:" + Имя);
	КонецЕсли;

	// 7. коллизия имени с существующим tool другого источника.
	Если ИмяЗанятоДругимИсточником(Имя, ИдентификаторОбработки) Тогда
		МассивОшибок.Добавить("name_collision:" + Имя);
	КонецЕсли;

	// 8/8а. JSONManifest: разбор, соответствие function.name, структура OpenAI tool-format.
	JSONManifest = Неопределено;
	ОписаниеTool.Свойство("JSONManifest", JSONManifest);
	ВалидироватьJSONManifest(JSONManifest, Имя, МассивОшибок);

	// 9. RiskLevel.
	RiskLevel = Неопределено;
	ОписаниеTool.Свойство("RiskLevel", RiskLevel);
	Если Не РискУровеньДопустим(RiskLevel) Тогда
		МассивОшибок.Добавить("invalid_risk_level:" + Имя);
	Иначе
		// 10. RiskLevel Write/Commit требует ТребуетApproval = Истина.
		Если (RiskLevel = "Write" Или RiskLevel = "Commit") Тогда
			ТребуетApproval = Неопределено;
			ОписаниеTool.Свойство("ТребуетApproval", ТребуетApproval);
			Если ТребуетApproval <> Истина Тогда
				МассивОшибок.Добавить("approval_required_for_risk:" + Имя);
			КонецЕсли;
		ИначеЕсли RiskLevel = "Read" Тогда
			// PKG-05 §1: RiskLevel = Read с ТребуетApproval = Истина -
			// противоречивая декларация (read-only tool не должен требовать
			// approval-подтверждения). Draft сюда не попадает - для него
			// ТребуетApproval = Истина осознанно допустим (PKG-03, проверка 9).
			ТребуетApprovalRead = Неопределено;
			ОписаниеTool.Свойство("ТребуетApproval", ТребуетApprovalRead);
			Если ТребуетApprovalRead = Истина Тогда
				МассивОшибок.Добавить("contradictory_risk_declaration:" + Имя);
			КонецЕсли;
		Иначе
			// RiskLevel = Draft - ТребуетApproval любой (Истина/Ложь) допустим,
			// проверка не применяется (PKG-03, проверка 9).
		КонецЕсли;
	КонецЕсли;

	// 11. ТребуемыеОбъекты / ТребуемыеПодсистемы - массивы строк либо отсутствуют.
	Если Не МассивСтрокИлиОтсутствует(ОписаниеTool, "ТребуемыеОбъекты") Тогда
		МассивОшибок.Добавить("invalid_required_objects:" + Имя);
	КонецЕсли;
	Если Не МассивСтрокИлиОтсутствует(ОписаниеTool, "ТребуемыеПодсистемы") Тогда
		МассивОшибок.Добавить("invalid_required_objects:" + Имя);
	КонецЕсли;

КонецПроцедуры

// Проверяет структуру OpenAI tool-format JSONManifest (шаг 8/8а спеки):
// {"type":"function","function":{"name","description","parameters":{"type":"object","properties":{...},"required":[...]}}}.
Процедура ВалидироватьJSONManifest(Знач JSONManifest, Знач Имя, МассивОшибок)

	Если ТипЗнч(JSONManifest) <> Тип("Строка") Или ПустаяСтрока(JSONManifest) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":JSONManifest");
		Возврат;
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(JSONManifest);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":parse_error");
		Возврат;
	КонецЕсли;

	ЗначениеТипа = Разобрано.Получить("type");
	Если ЗначениеТипа <> "function" Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":type");
	КонецЕсли;

	ОписаниеФункции = Разобрано.Получить("function");
	Если ТипЗнч(ОписаниеФункции) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function");
		Возврат;
	КонецЕсли;

	FunctionName = ОписаниеФункции.Получить("name");
	Если ТипЗнч(FunctionName) <> Тип("Строка") Или ПустаяСтрока(FunctionName) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.name");
	ИначеЕсли FunctionName <> Имя Тогда
		МассивОшибок.Добавить("manifest_name_mismatch:" + Имя);
	Иначе
		// function.name совпадает с Имя - ошибок нет.
	КонецЕсли;

	Description = ОписаниеФункции.Получить("description");
	Если ТипЗнч(Description) <> Тип("Строка") Или ПустаяСтрока(Description) Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.description");
	КонецЕсли;

	Параметры = ОписаниеФункции.Получить("parameters");
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.parameters");
		Возврат;
	КонецЕсли;

	ТипПараметров = Параметры.Получить("type");
	Свойства = Параметры.Получить("properties");
	Если ТипПараметров <> "object" Или ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":function.parameters");
		Возврат;
	КонецЕсли;

	// Каждое свойство в properties имеет type.
	Для Каждого ЭлементСвойства Из Свойства Цикл
		ОписаниеСвойства = ЭлементСвойства.Значение;
		Если ТипЗнч(ОписаниеСвойства) <> Тип("Соответствие") Или ОписаниеСвойства.Получить("type") = Неопределено Тогда
			МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":properties." + ЭлементСвойства.Ключ);
		КонецЕсли;
	КонецЦикла;

	// required, если есть, - массив строк, каждая присутствует в properties.
	Обязательные = Параметры.Получить("required");
	Если Обязательные <> Неопределено Тогда
		Если ТипЗнч(Обязательные) <> Тип("Массив") Тогда
			МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":required");
		Иначе
			Для Каждого ИмяОбязательного Из Обязательные Цикл
				Если ТипЗнч(ИмяОбязательного) <> Тип("Строка") Или Свойства.Получить(ИмяОбязательного) = Неопределено Тогда
					МассивОшибок.Добавить("invalid_tool_manifest:" + Имя + ":required");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Допустимые значения RiskLevel манифеста (контракт PKG-01) - должны
// соответствовать значениям Перечисление.ar_RiskLevel.
Функция РискУровеньДопустим(Знач RiskLevel)
	Возврат RiskLevel = "Read" Или RiskLevel = "Draft" Или RiskLevel = "Write" Или RiskLevel = "Commit";
КонецФункции

// Проверяет, что реквизит структуры ИмяРеквизита - массив строк, либо
// отсутствует/Неопределено.
Функция МассивСтрокИлиОтсутствует(Знач Структура, Знач ИмяРеквизита)

	Значение = Неопределено;
	Структура.Свойство(ИмяРеквизита, Значение);

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет, занято ли имя tool ДРУГИМ источником (ядровым модулем или другим
// пакетом), включая ядровые имена (query, ask_user и т.п.). Повторная
// регистрация того же пакета своими же именами коллизией не считается.
Функция ИмяЗанятоДругимИсточником(Знач Имя, Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ИдентификаторОбработки", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления
		|	И (Tools.ar_ИсточникТип <> ""Пакет""
		|		ИЛИ Tools.ar_ИдентификаторПакета <> &ИдентификаторОбработки)";

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

// Собирает сведения о кандидате (БезопасныйРежим, ИмяОбъекта, Версия) из
// НайтиКандидатов() по ИдентификаторОбработки - используется при регистрации
// для заполнения РегистрСведений.ar_ПакетыTools.
Функция СведенияОКандидате(Знач ИдентификаторОбработки)

	Кандидаты = НайтиКандидатов();
	Для Каждого СтрокаКандидата Из Кандидаты Цикл
		Если Строка(СтрокаКандидата.Ссылка.УникальныйИдентификатор()) = ИдентификаторОбработки Тогда
			Результат = Новый Структура;
			Результат.Вставить("ИмяОбъекта", СтрокаКандидата.ИмяОбъекта);
			Результат.Вставить("БезопасныйРежим", СтрокаКандидата.БезопасныйРежим);
			Результат.Вставить("Версия", СтрокаКандидата.Версия);
			Результат.Вставить("НайденВНайтиКандидатов", Истина);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	// Кандидат уже не проходит фильтр НайтиКандидатов (например, снят с
	// публикации между чтением манифеста и записью) - используем значения по
	// умолчанию, регистрация продолжается на основе уже прочитанного манифеста.
	Результат = Новый Структура;
	Результат.Вставить("ИмяОбъекта", "");
	Результат.Вставить("БезопасныйРежим", Истина);
	Результат.Вставить("Версия", "");
	Результат.Вставить("НайденВНайтиКандидатов", Ложь);
	Возврат Результат;

КонецФункции

// Записывает РегистрСведений.ar_ПакетыTools и все tools пакета в
// Справочник.ar_Tools. Вызывается внутри уже открытой транзакции
// (ЗарегистрироватьПакет) - без собственного НачатьТранзакцию.
//
// Возвращаемое значение:
//  Число - количество записанных tools.
//
Функция ЗаписатьПакетИTools(Знач ИдентификаторОбработки, Знач Манифест, Знач Кандидат)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
		Запись = НаборЗаписей.Добавить();
		Запись.ar_ИдентификаторОбработки = ИдентификаторОбработки;
		Запись.ar_Namespace = Манифест.namespace;
		Запись.ar_ВерсияПакета = Манифест.Версия;
		Запись.ar_SchemaVersion = Манифест.schema_version;
		Запись.ar_ХешМанифеста = ХешМанифеста(Манифест);
		Запись.ar_Статус = "Зарегистрирован";
		Запись.ar_ПричинаОтказа = "";
		Запись.ar_КоличествоTools = Манифест.Tools.Количество();
		Запись.ar_БезопасныйРежим = Кандидат.БезопасныйРежим;
		Запись.ar_ИмяОбъектаОбработки = Кандидат.ИмяОбъекта;
		Запись.ar_ДатаРегистрации = ТекущаяДатаСеанса();
		Запись.ar_Пользователь = ИмяТекущегоПользователяПакетов();
		НаборЗаписей.Записать(Истина);

		Для Каждого ОписаниеTool Из Манифест.Tools Цикл
			ЗарегистрироватьОдинToolПакета(ОписаниеTool, ИдентификаторОбработки, Манифест.namespace);
		КонецЦикла;

		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Манифест.Tools.Количество();

КонецФункции

// Идемпотентно создаёт/обновляет запись Справочник.ar_Tools для одного tool
// пакета - тот же паттерн, что и ar_ToolCRM.ЗарегистрироватьОдинTool.
// Выполняется в уже поднятом привилегированном режиме (см. ЗаписатьПакетИTools).
Процедура ЗарегистрироватьОдинToolПакета(Знач ОписаниеTool, Знач ИдентификаторОбработки, Знач Namespace)

	// Безопасный доступ через Свойство() везде, а не через точку: манифест на
	// этом шаге уже прошёл ВалидироватьМанифест (обязательные поля проверены
	// в ВалидироватьОдинTool), но защитный доступ здесь дешевле, чем риск
	// падения платформенным исключением "Поле объекта не обнаружено" уже
	// внутри открытой транзакции регистрации.
	Имя = "";
	ОписаниеTool.Свойство("Имя", Имя);

	СсылкаTool = НайтиСсылкуToolПоИмениПакета(Имя);

	Если ЗначениеЗаполнено(СсылкаTool) Тогда
		Объект = СсылкаTool.ПолучитьОбъект();
	Иначе
		Объект = Справочники.ar_Tools.СоздатьЭлемент();
	КонецЕсли;

	КраткоеОписание = "";
	ОписаниеTool.Свойство("КраткоеОписание", КраткоеОписание);

	Описание = "";
	ОписаниеTool.Свойство("Описание", Описание);
	JSONManifest = "";
	ОписаниеTool.Свойство("JSONManifest", JSONManifest);
	RiskLevel = Неопределено;
	ОписаниеTool.Свойство("RiskLevel", RiskLevel);
	ТребуетApproval = Ложь;
	ОписаниеTool.Свойство("ТребуетApproval", ТребуетApproval);
	ВерсияTool = "";
	ОписаниеTool.Свойство("Версия", ВерсияTool);

	Объект.Наименование = Имя;
	Объект.ar_Имя = Имя;
	Объект.ar_Описание = Описание;
	Объект.ar_JSONManifest = JSONManifest;
	Объект.ar_RiskLevel = Перечисления.ar_RiskLevel[RiskLevel];
	Объект.ar_ОбщийМодуль = "";
	Объект.ar_ИмяПроцедуры = "";
	Объект.ar_ТребуетApproval = ТребуетApproval;
	Объект.ar_Версия = ВерсияTool;
	Объект.ar_ИсточникРасширение = "";
	Объект.ar_Включён = Истина;
	Объект.ar_ИсточникТип = "Пакет";
	Объект.ar_ИдентификаторПакета = ИдентификаторОбработки;
	Объект.ar_Namespace = Namespace;
	Объект.ar_КраткоеОписание = КраткоеОписание;

	ТребуемыеОбъекты = Неопределено;
	ОписаниеTool.Свойство("ТребуемыеОбъекты", ТребуемыеОбъекты);
	Если ТипЗнч(ТребуемыеОбъекты) = Тип("Массив") Тогда
		Объект.ar_ТребуемыеОбъекты = ar_JSON.ВЗначениеJSON(ТребуемыеОбъекты);
	Иначе
		Объект.ar_ТребуемыеОбъекты = "[]";
	КонецЕсли;

	Объект.Записать();

КонецПроцедуры

// Находит ссылку ar_Tools по реквизиту ar_Имя. Неопределено, если нет записи.
Функция НайтиСсылкуToolПоИмениПакета(Знач ИмяTool)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", ИмяTool);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Фиксирует отклонённый пакет в РегистрСведений.ar_ПакетыTools (статус
// "Отклонён" с причиной). Повреждённый пакет НЕ роняет ядро - вызывается из
// ЗарегистрироватьПакет/ПроверитьХешиПакетов при неуспешном чтении манифеста
// или провале валидации.
Процедура ЗафиксироватьОтклонённыйПакет(Знач ИдентификаторОбработки, Знач Причина)

	ДлинаПоляПричина = 500;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
		Запись = НаборЗаписей.Добавить();
		Запись.ar_ИдентификаторОбработки = ИдентификаторОбработки;
		Запись.ar_Статус = "Отклонён";
		Запись.ar_ПричинаОтказа = Лев(Причина, ДлинаПоляПричина);
		Запись.ar_ДатаРегистрации = ТекущаяДатаСеанса();
		Запись.ar_Пользователь = ИмяТекущегоПользователяПакетов();
		НаборЗаписей.Записать(Истина);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ЗафиксироватьОтклонённыйПакет", "package_rejection_write_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
	КонецПопытки;

	ar_СлужебныйЛог.Записать("ar_ToolПакеты.ЗафиксироватьОтклонённыйПакет", "package_rejected",
		ИдентификаторОбработки + ": " + Причина, "Ошибка");

КонецПроцедуры

// Фиксирует расхождение хеша: статус -> "ТребуетПереподтверждения",
// сохраняет новый хеш, tools пакета -> ar_Доступен = Ложь.
Процедура ЗафиксироватьТребуетПереподтверждения(Знач ИдентификаторОбработки, Знач НовыйХеш)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
		Если НаборЗаписей.Количество() > 0 Тогда
			Запись = НаборЗаписей[0];
			Запись.ar_Статус = "ТребуетПереподтверждения";
			Запись.ar_ХешМанифеста = НовыйХеш;
			НаборЗаписей.Записать(Истина);
		КонецЕсли;

		СделатьToolsПакетаНедоступными(ИдентификаторОбработки);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ToolПакеты.ЗафиксироватьТребуетПереподтверждения", "package_hash_update_error",
			ИдентификаторОбработки + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
	КонецПопытки;

	ar_СлужебныйЛог.Записать("ar_ToolПакеты.ЗафиксироватьТребуетПереподтверждения", "package_hash_mismatch",
		ИдентификаторОбработки, "Предупреждение");

КонецПроцедуры

// Выставляет ar_Доступен = Ложь для всех tools пакета (расхождение хеша -
// доверие пакету приостановлено до переподтверждения администратором).
// Выполняется в уже поднятом привилегированном режиме вызывающей процедуры.
Процедура СделатьToolsПакетаНедоступными(Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПакета", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_ИсточникТип = ""Пакет""
		|	И Tools.ar_ИдентификаторПакета = &ИдентификаторПакета
		|	И НЕ Tools.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.ar_Доступен = Ложь;
			Объект.ar_ПричинаНедоступности = "package_hash_mismatch";
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Выставляет ar_Включён = Ложь для всех tools пакета (ОтключитьПакет) -
// осознанное действие администратора, в отличие от ar_Доступен.
// Выполняется в уже поднятом привилегированном режиме вызывающей процедуры.
Процедура ОтключитьToolsПакета(Знач ИдентификаторОбработки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПакета", ИдентификаторОбработки);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_ИсточникТип = ""Пакет""
		|	И Tools.ar_ИдентификаторПакета = &ИдентификаторПакета
		|	И НЕ Tools.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.ar_Включён = Ложь;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает набор записей регистра ar_ПакетыTools по идентификатору
// обработки (отбор по измерению, набор из 0 или 1 записи - регистр
// непериодический, независимый).
Функция НаборЗаписейПакета(Знач ИдентификаторОбработки)

	НаборЗаписей = РегистрыСведений.ar_ПакетыTools.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ar_ИдентификаторОбработки.Установить(ИдентификаторОбработки);
	НаборЗаписей.Прочитать();
	Возврат НаборЗаписей;

КонецФункции

// Список идентификаторов пакетов со статусом "Зарегистрирован" или
// "ТребуетПереподтверждения" - кандидаты на проверку хеша.
Функция СписокЗарегистрированныхПакетов()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_ИдентификаторОбработки КАК ИдентификаторОбработки
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_Статус В (""Зарегистрирован"", ""ТребуетПереподтверждения"")";

	Список = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.ИдентификаторОбработки);
	КонецЦикла;
	Возврат Список;

КонецФункции

// Текущий сохранённый хеш манифеста пакета из регистра. Пустая строка, если
// записи ещё нет.
Функция ХешПакетаИзРегистра(Знач ИдентификаторОбработки)

	НаборЗаписей = НаборЗаписейПакета(ИдентификаторОбработки);
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат НаборЗаписей[0].ar_ХешМанифеста;

КонецФункции

// Вычисляет SHA-256 хеш нормализованного JSON манифеста в виде hex-строки
// (64 символа) - ar_ПакетыTools.ar_ХешМанифеста (Строка(64)). Готового
// хелпера хеширования в проекте нет (grep по src/ на ХешированиеДанных пуст) -
// используется платформенный ХешированиеДанных с ХешФункция.SHA256, тот же
// приём, что и в БСП (см. ДополнительныеОтчетыИОбработки.РежимПодключенияОтчетаОбработки).
Функция ХешМанифеста(Знач Манифест)

	JSONТекст = ar_JSON.ВЗначениеJSON(Манифест);
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(JSONТекст, КодировкаТекста.UTF8, Ложь);

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);

	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

// Человекочитаемое представление значения для подстановки в код причины
// отказа (unsupported_schema_version:<N>, invalid_namespace:<значение>).
Функция ПредставлениеЗначенияПакета(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат "undefined";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Имя текущего пользователя ИБ для записей регистра ar_ПакетыTools и audit
// payload package_registered_unsafe. Не Пользователи.ТекущийПользователь()
// (справочник Пользователи не заимствован в расширение) - платформенный
// ПользователиИнформационнойБазы, как в ar_ДиагностикаОчистка.ИмяТекущегоПользователя()
// (та функция не экспортная - вызвать её отсюда нельзя, поэтому копия).
Функция ИмяТекущегоПользователяПакетов()

	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийПользовательИБ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТекущийПользовательИБ.Имя;

КонецФункции

#КонецОбласти
