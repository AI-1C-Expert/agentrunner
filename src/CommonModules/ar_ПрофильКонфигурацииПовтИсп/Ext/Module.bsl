////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПрофильКонфигурацииПовтИсп (Профиль конфигурации, ПовтИсп).
//
// Тонкая кеширующая обёртка над ar_ПрофильКонфигурации.ЗначениеБезКэша.
// Единственная экспортная функция - без бизнес-логики, по конвенции модулей
// ПовтИсп (см. mcp__onemcp__get_1c_code_pattern(task_type=
// "common_module_reuse"), "Common Mistakes"). UNIV-01.
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, ServerCall = false, Privileged = false,
//   ReturnValuesReuse = НаВремяВызова (DuringRequest).
//
// Кеш «НаВремяВызова» живёт в пределах одного серверного вызова и автоматически
// исчезает на его границе - следующий отдельный tool-вызов агента / HTTP-запрос
// всегда видит актуальный профиль без какого-либо явного сброса. Платформа не
// даёт выборочной инвалидации по ключу - только полный сброс кеша ПовтИсп
// сеанса методом ОбновитьПовторноИспользуемыеЗначения() (см. RecordSetModule
// регистра ar_ПрофильКонфигурации - вызывается как дополнительная подстраховка
// на случай записи значения и чтения его же в рамках одного серверного вызова,
// не как основной механизм инвалидации).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Кеширующая (на время текущего серверного вызова) выборка значения профиля
// конфигурации по ключу. Тонкая обёртка - делегирует всю логику в
// ar_ПрофильКонфигурации.ЗначениеБезКэша, платформа запоминает результат по
// параметру Ключ и возвращает его без повторного обращения к регистру при
// повторном вызове с тем же ключом в рамках того же серверного вызова.
//
// Параметры:
//   Ключ - Строка - логический ключ настройки профиля, например
//          "configuration.type" или "invoice.client_attribute".
//
// Возвращаемое значение:
//   Строка, Неопределено - значение ar_Значение найденной записи, либо
//          Неопределено, если запись с таким ключом отсутствует.
//
Функция ЗначениеБезКэша(Знач Ключ) Экспорт

	Возврат ar_ПрофильКонфигурации.ЗначениеБезКэшаПовтИсп(Ключ);

КонецФункции

#КонецОбласти
