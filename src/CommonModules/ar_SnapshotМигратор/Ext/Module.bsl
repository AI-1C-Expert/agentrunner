////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_SnapshotМигратор (AOS Snapshot Migrator).
//
// Отвечает исключительно за трансформацию данных снимка состояния цикла
// рассуждения (StateSnapshot) между версиями формата {v, state}. Модуль НЕ
// пишет в регистры и НЕ вызывает аудит — только читает входной снимок,
// последовательно применяет шаги миграции v_old -> v_old+1 -> ... -> v_current
// и возвращает результат.
//
// Свойства модуля: Сервер + НеГлобальный + НЕпривилегированный — выставлены в
// манифесте. Привилегии не нужны: модуль работает только с переданными данными.
// Привилегированный вызывающий код (ar_AuditЗапуски) может вызывать этот модуль
// без ограничений (RT-09, Plan §3.2).
//
// Политика совместимости (см. RT-09.md):
//   ИсходнаяВерсия = ТекущаяВерсия()                 -> совместим, миграция не нужна.
//   ИсходнаяВерсия < ТекущаяВерсия()                 -> цепочка миграций до текущей.
//   ИсходнаяВерсия > ТекущаяВерсия()                 -> отказ (снимок новее ядра).
//   ИсходнаяВерсия = Неопределено / не число / <= 0  -> отказ (формат неизвестен).
//
// ИНСТРУКЦИЯ ПРИ ДОБАВЛЕНИИ НОВОЙ ВЕРСИИ ФОРМАТА:
//   1. Увеличить значение в ТекущаяВерсия() (например, до 2).
//   2. Создать функцию-шаг МигрироватьV1ВV2(Снимок) с трансформацией state,
//      которая обновляет поле "v" мигрированного снимка.
//   3. Добавить ветвь в цикл Мигрировать, вызывающую новый шаг.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Текущая версия формата StateSnapshot в этой сборке ядра.
// Увеличивается при мажорных изменениях структуры state.
//
// Версия формата хранится в коде (а не в ar_Константы), так как это свойство
// бинарного артефакта .cfe, а не пользовательская настройка ИБ (RT-09.md).
//
// Возвращаемое значение:
//  Число - текущая версия (сейчас 1).
//
Функция ТекущаяВерсия() Экспорт
	Возврат 1;
КонецФункции

// Мигрировать содержимое снимка от версии ИсходнаяВерсия до ТекущаяВерсия().
//
// Параметры:
//  Снимок           - Структура, Соответствие - объект {v, state} из ХранилищеЗначения.
//  ИсходнаяВерсия   - Число - значение поля v прочитанного снимка
//                     (или Неопределено / иной тип при повреждённом снимке).
//
// Возвращаемое значение:
//  Структура - {
//    Успех   - Булево - Истина при успешной миграции или отсутствии необходимости.
//    Снимок  - Структура, Соответствие - мигрированный снимок (может быть изменён).
//    Причина - Строка - при Успех=Ложь — причина отказа.
//  }
//
Функция Мигрировать(Снимок, ИсходнаяВерсия) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Снимок", Снимок);
	Результат.Вставить("Причина", "");

	// Версия должна быть положительным целым числом.
	Если ТипЗнч(ИсходнаяВерсия) <> Тип("Число") Или ИсходнаяВерсия <= 0 Тогда
		Результат.Причина = НСтр("ru = 'snapshot_version_unknown';
								|en = 'snapshot_version_unknown'");
		Возврат Результат;
	КонецЕсли;

	Текущая = ТекущаяВерсия();

	// Совместимая версия — миграция не нужна.
	Если ИсходнаяВерсия = Текущая Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	// Снимок сохранён более новым ядром — мигрировать вниз невозможно.
	Если ИсходнаяВерсия > Текущая Тогда
		ШаблонСлишкомНовый = НСтр("ru = 'snapshot_version_too_new: %1 > %2';
								|en = 'snapshot_version_too_new: %1 > %2'");
		Результат.Причина = СтрШаблон(ШаблонСлишкомНовый, ИсходнаяВерсия, Текущая);
		Возврат Результат;
	КонецЕсли;

	// ИсходнаяВерсия < Текущая — применяем цепочку шагов v_old -> ... -> v_current.
	// Каждый шаг увеличивает Версия и преобразует state. Вся цепочка обёрнута в
	// Попытку: исключение наружу не пробрасывается, а преобразуется в
	// {Успех=Ложь, Причина="migration_error: ..."}.
	ТекущийСнимок = Снимок;
	Версия = ИсходнаяВерсия;
	Попытка
		Пока Версия < Текущая Цикл
			СледующаяВерсия = Версия + 1;

			// Ладдер шагов миграции. На этапе 1 (ТекущаяВерсия() = 1) переходов
			// между версиями ещё нет, поэтому при любом валидном снимке тело цикла
			// не выполняется. Когда появится формат v2, перед этим ВызватьИсключение
			// добавляется ветвь, которая при Версия = 1 присваивает ТекущийСнимок
			// результат функции-шага МигрироватьV1ВV2 и переходит к следующей версии.
			ШаблонНетШага = НСтр("ru = 'не реализован шаг миграции v%1 -> v%2';
								|en = 'migration step v%1 -> v%2 is not implemented'");
			ВызватьИсключение СтрШаблон(ШаблонНетШага, Версия, СледующаяВерсия);
		КонецЦикла;
	Исключение
		ШаблонОшибкиМиграции = НСтр("ru = 'migration_error: %1';
									|en = 'migration_error: %1'");
		Результат.Причина = СтрШаблон(ШаблонОшибкиМиграции,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	Результат.Снимок = ТекущийСнимок;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функции-шаги миграции (МигрироватьV1ВV2 и т. п.) добавляются в эту область по
// одной на каждый переход версии формата. Каждый шаг принимает снимок версии N,
// трансформирует поле state к схеме N+1, обновляет поле "v" и возвращает снимок.
// Вызовы шагов располагаются в ладдере внутри цикла функции Мигрировать.
// На этапе 1 (ТекущаяВерсия() = 1) шагов нет: версия одна.

#КонецОбласти
