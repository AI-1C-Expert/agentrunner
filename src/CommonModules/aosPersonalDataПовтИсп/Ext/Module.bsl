////////////////////////////////////////////////////////////////////////////////
// Общий модуль aosPersonalDataПовтИсп (Персональные данные AgentRunner, ПовтИсп).
//
// Тонкая кеширующая обёртка над aosPersonalData.ЕстьПравилоПолногоСокрытияБезКэша
// (PII-05). Единственная экспортная функция - без бизнес-логики, по конвенции
// модулей ПовтИсп (см. mcp__onemcp__get_1c_code_pattern(task_type=
// "common_module_reuse"), "Common Mistakes").
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, ServerCall = false, Privileged = false,
//   ReturnValuesReuse = НаВремяВызова (DuringRequest).
//
// Кеш «НаВремяВызова» живёт в пределах одного серверного вызова и автоматически
// исчезает на его границе - следующий серверный вызов (следующий tool-вызов
// агента, следующий HTTP-запрос) всегда видит актуальные правила без какого-либо
// явного сброса. Платформа не даёт выборочной инвалидации по ключу параметров -
// только полный сброс кеша ПовтИсп сеанса методом
// ОбновитьПовторноИспользуемыеЗначения() (см. RecordSetModule регистра
// ar_ПравилаМаскированияПДн - вызывается как дополнительная подстраховка на
// случай записи правила и чтения данных в рамках одного серверного вызова,
// не как основной механизм инвалидации).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Кеширующая (на время текущего серверного вызова) проверка наличия включённого
// правила полного сокрытия для указанного поля объекта. Тонкая обёртка -
// делегирует всю логику в aosPersonalData.ЕстьПравилоПолногоСокрытияБезКэша,
// платформа запоминает результат по паре параметров (ИмяОбъекта, ИмяПоля) и
// возвращает его без повторного обращения к регистру при повторном вызове с
// теми же параметрами в рамках того же серверного вызова.
//
// Параметры:
//   ИмяОбъекта - Строка - полное имя метаданных объекта, например "Справочник.Контрагенты".
//   ИмяПоля    - Строка - имя реквизита/поля объекта (точное имя, без wildcard).
//
// Возвращаемое значение:
//   Булево - Истина, если поле должно быть полностью скрыто.
//
Функция ЕстьПравилоПолногоСокрытияКэшируемая(ИмяОбъекта, ИмяПоля) Экспорт

	Возврат aosPersonalData.ЕстьПравилоПолногоСокрытияБезКэша(ИмяОбъекта, ИмяПоля);

КонецФункции

#КонецОбласти
