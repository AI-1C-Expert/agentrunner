	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Описание",
		"Создаёт черновик документа «Счёт на оплату» без проведения. Документ не"
		+ " записывается до одобрения оператором.");
	Описание.Вставить("JSONManifest", МанифестСоздатьЧерновикСчёта());
	// UNIV-03: логические имена объектов метаданных, без которых tool не может
	// отработать (см. ar_ToolDispatcher.ПроверитьДоступностьTool). Значения - те
	// же логические имена, что переданы ИмяОбъектаМетаданных внутри реализации
	// СоздатьЧерновикСчётаВнутр (строка ~214).
	Описание.Вставить("ТребуемыеОбъекты", СписокИзСтрок2("СчетНаОплатуПокупателю"));
	// UNIV-06: tool делегирует заполнение документа в ar_АдаптерЗаполнения -
	// доступность дополнительно зависит от наличия зарегистрированного и
	// включённого адаптера для текущего типа конфигурации (третий, независимый
	// критерий ar_ToolDispatcher.РезультатПроверкиДоступности).
	Описание.Вставить("ТребуетАдаптер", Истина);
	Возврат Описание;
КонецФункции

