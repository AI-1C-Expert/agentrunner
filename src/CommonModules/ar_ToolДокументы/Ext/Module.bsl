// JSON Schema аргументов create_reconciliation_act (RECON-01), обёрнутая в
// OpenAI tool-format.
Функция МанифестСоздатьАктСверки()

	СхемаСчетов = Новый Структура;
	СхемаСчетов.Вставить("type", "array");
	СхемаСчетов.Вставить("description",
		"Счета учёта расчётов для СчетаУчетаРасчетов (коды плана счетов"
		+ " Хозрасчетный, например ['62']). По умолчанию - типовой набор.");
	СхемаЭлементаСчёт = Новый Структура;
	СхемаЭлементаСчёт.Вставить("type", "string");
	СхемаСчетов.Вставить("items", СхемаЭлементаСчёт);

	Свойства = Новый Структура;
	Свойства.Вставить("client_ref", СвойствоСхемы("string",
		"Навигационная ссылка или UUID контрагента (Справочник.Контрагенты)"));
	Свойства.Вставить("organization_inn", СвойствоСхемы("string",
		"ОБЯЗАТЕЛЬНО. ИНН ОРГАНИЗАЦИИ - нашего юрлица, по которому у"
		+ " контрагента есть сальдо. Единственный способ задать организацию:"
		+ " ссылки (organization_ref) НЕ принимаются. Возьми значение из поля"
		+ " organization_inn в by_contragent (find_overdue_receivables)."
		+ " ИНН контрагента из search_clients сюда класть НЕЛЬЗЯ - это разные"
		+ " сущности. Не угадывай: у контрагента бывает сальдо по одному"
		+ " юрлицу и ничего по другому, и акт по неверной организации будет"
		+ " пустым."));
	Свойства.Вставить("stale_after_months", СвойствоСхемы("integer",
		"Порог 'последний акт старше N месяцев' (по умолчанию 1)"));
	Свойства.Вставить("accounts", СхемаСчетов);
	Свойства.Вставить("force", СвойствоСхемы("boolean",
		"Создать акт даже если свежий акт есть (игнорировать порог)"));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	// В required только client_ref: организацию можно задать ЛИБО
	// organization_inn, ЛИБО organization_ref - JSON Schema "один из двух"
	// в tool-манифестах не выражается, поэтому требование проверяет сам tool
	// (ошибка organization_required с подсказкой).
	Параметры.Вставить("required", СписокИзСтрок2("client_ref"));
	Параметры.Вставить("properties", Свойства);

	Возврат ОбернутьВOpenAIФормат("create_reconciliation_act",
		"Создаёт и записывает (без проведения) акт сверки взаиморасчётов родным"
		+ " заполнением по данным ИБ. Требует И контрагента, И организацию:"
		+ " сначала узнай по контрагенту организацию с сальдо через"
		+ " find_overdue_receivables, потом вызывай этот tool. Пропускает"
		+ " создание, если у контрагента уже есть свежий акт (порог"
		+ " stale_after_months).",
		Параметры);

КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
// Формат обязателен для всех LLM-провайдеров (OpenAI-совместимые API, включая
// локальные - LM Studio и т.п.) - без обёртки провайдер возвращает 400 на
// список tools (см. ar_ToolUniversal.МанифестTool - образец контракта).
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)
	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", Имя);
	ФункцияОписание.Вставить("description", Описание);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);
	Возврат СтруктуруВJSON(Манифест);
КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
Функция СвойствоСхемы(Знач Тип, Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Массив строк для поля required JSON Schema (1..3 значения).
Функция СписокИзСтрок2(Знач Значение1, Знач Значение2 = Неопределено, Знач Значение3 = Неопределено)
	Список = Новый Массив;
	Список.Добавить(Значение1);
	Если Значение2 <> Неопределено Тогда
		Список.Добавить(Значение2);
	КонецЕсли;
	Если Значение3 <> Неопределено Тогда
		Список.Добавить(Значение3);
	КонецЕсли;
	Возврат Список;
КонецФункции

// Идемпотентно создаёт/обновляет запись ar_Tools по описанию.
// Выполняется в уже поднятом привилегированном режиме (см. ЗарегистрироватьTools).
//
Процедура ЗарегистрироватьОдинTool(Знач Описание, Статистика)

	СсылкаTool = НайтиСсылкуToolПоИмени(Описание.Имя);

	Если ЗначениеЗаполнено(СсылкаTool) Тогда
		Объект = СсылкаTool.ПолучитьОбъект();
		Создаётся = Ложь;
	Иначе
		Объект = Справочники.ar_Tools.СоздатьЭлемент();
		Создаётся = Истина;
	КонецЕсли;

	Объект.Наименование = Описание.Имя;
	Объект.ar_Имя = Описание.Имя;
	Объект.ar_Описание = Описание.Описание;
	Объект.ar_JSONManifest = Описание.JSONManifest;
	Объект.ar_RiskLevel = Перечисления.ar_RiskLevel[Описание.RiskLevel];
	Объект.ar_ОбщийМодуль = Описание.ОбщийМодуль;
	Объект.ar_ИмяПроцедуры = Описание.ИмяПроцедуры;
	Объект.ar_ТребуетApproval = Описание.ТребуетApproval;
	Объект.ar_Версия = Описание.Версия;
	Объект.ar_ИсточникРасширение = "";
	Объект.ar_Включён = Истина;
	// UNIV-03: ТребуемыеОбъекты - необязательное поле описания (Массив строк).
	// Отсутствует → пустой JSON-массив (tool универсальный, не привязан к
	// предметным объектам). ar_Доступен здесь НЕ выставляется - пересчитывается
	// отдельным проходом в ar_ToolDispatcher.ЗарегистрироватьВсеTools/
	// ПересчитатьДоступностьВсехTools после регистрации всех модулей.
	ТребуемыеОбъекты = Неопределено;
	Описание.Свойство("ТребуемыеОбъекты", ТребуемыеОбъекты);
	Если ТипЗнч(ТребуемыеОбъекты) = Тип("Массив") Тогда
		Объект.ar_ТребуемыеОбъекты = ar_JSON.ВЗначениеJSON(ТребуемыеОбъекты);
	Иначе
		Объект.ar_ТребуемыеОбъекты = "[]";
	КонецЕсли;
	// UNIV-06: ТребуетАдаптер - необязательное поле описания (Булево).
	// Отсутствует → Ложь (tool не делегирует заполнение в ar_АдаптерЗаполнения,
	// по умолчанию доступность им не ограничена). Читается тем же паттерном,
	// что ТребуемыеОбъекты выше.
	ТребуетАдаптер = Неопределено;
	Описание.Свойство("ТребуетАдаптер", ТребуетАдаптер);
	Объект.ar_ТребуетАдаптер = (ТипЗнч(ТребуетАдаптер) = Тип("Булево") И ТребуетАдаптер);
	Объект.Записать();

	Если Создаётся Тогда
		Статистика.Создано = Статистика.Создано + 1;
	Иначе
		Статистика.Обновлено = Статистика.Обновлено + 1;
	КонецЕсли;

КонецПроцедуры

// Находит ссылку ar_Tools по реквизиту ar_Имя. Неопределено, если нет записи.
Функция НайтиСсылкуToolПоИмени(Знач ИмяTool)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя";
	Запрос.УстановитьПараметр("Имя", ИмяTool);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область ОбщиеСлужебные

// Сериализует структуру/массив в компактную JSON-строку.
Функция СтруктуруВJSON(Знач Значение)
	Возврат ar_JSON.ВЗначениеJSON(Значение);
КонецФункции

// Безопасно читает значение по ключу из Соответствия/Структуры с дефолтом.
Функция ЗначениеПоКлючу(Знач Коллекция, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Значение = Коллекция.Получить(Ключ);
		Возврат ?(Значение = Неопределено, Дефолт, Значение);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Возврат ?(Коллекция.Свойство(Ключ, Значение), Значение, Дефолт);
	КонецЕсли;
	Возврат Дефолт;
КонецФункции

// JSON-строка ошибки-observation: {"error":"<код>"}.
Функция ОшибочныйJSON(Знач КодОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// JSON-строка ошибки с деталью: {"error":"<код>","detail":"<текст>"}.
Функция ОшибочныйJSONСДеталью(Знач КодОшибки, Знач Деталь)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("detail", Деталь);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// JSON-строка ошибки с произвольным полем: {"error":"<код>","<поле>":"<значение>"}.
Функция ОшибочныйJSONСПолем(Знач КодОшибки, Знач Поле, Знач Значение)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить(Поле, Значение);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// Классифицировать исключение чтения документа: отличить структурную ошибку
// (несуществующий реквизит/поле - типично при несовпадении имён реквизитов
// целевой конфигурации с зашитыми в tool) от реального отказа доступа (RLS).
// Раньше ЛЮБОЕ исключение возвращалось как access_denied, маскируя причину и
// сбивая LLM/пользователя с толку. Текст ошибки очищается для LLM.
//
// Параметры:
//  ИнфоОбОшибке - ИнформацияОбОшибке - перехваченное исключение.
//
// Возвращаемое значение:
//  Строка - JSON: {"error":"document_read_error","detail":"..."} для структурных
//           ошибок либо {"error":"access_denied"} для отказов доступа.
//
Функция КлассифицироватьОшибкуЧтения(Знач ИнфоОбОшибке)

	ТекстПодробно = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
	ТекстНРег = НРег(ТекстПодробно);

	// Признаки отказа доступа (RLS / права).
	ПризнакиДоступа = "право доступа,недостаточно прав,access,rls,запрещено выполнять";
	Для Каждого Признак Из СтрРазделить(ПризнакиДоступа, ",") Цикл
		Если СтрНайти(ТекстНРег, СокрЛП(Признак)) > 0 Тогда
			Возврат ОшибочныйJSON("access_denied");
		КонецЕсли;
	КонецЦикла;

	// Иначе - структурная/иная ошибка чтения: отдаём реальный (очищенный) текст.
	ЧистыйТекст = ar_Утилиты.ОчиститьОшибкуДляLLM(ТекстПодробно);
	Возврат ОшибочныйJSONСДеталью("document_read_error", ЧистыйТекст);

КонецФункции

#КонецОбласти

#КонецОбласти
