// JSON Schema аргументов create_invoice_draft, обёрнутая в OpenAI tool-format
// (см. ОбернутьВOpenAIФормат - единый контракт для всех tool-модулей).
Функция МанифестСоздатьЧерновикСчёта()

	СвойстваПозиции = Новый Структура;
	СвойстваПозиции.Вставить("nomenclature_ref", СвойствоСхемы("string",
		"Навигационная ссылка или UUID номенклатуры"));
	СвойстваПозиции.Вставить("quantity", СвойствоСхемы("number", "Количество (> 0)"));
	СвойстваПозиции.Вставить("price", СвойствоСхемы("number", "Цена за единицу (>= 0)"));
	СвойстваПозиции.Вставить("vat_rate", СвойствоСхемы("string",
		"Ставка НДС: 'НДС20', 'НДС10', 'БезНДС' и пр. (опционально)"));

	СхемаПозиции = Новый Структура;
	СхемаПозиции.Вставить("type", "object");
	СхемаПозиции.Вставить("required", СписокИзСтрок2("nomenclature_ref", "quantity", "price"));
	СхемаПозиции.Вставить("properties", СвойстваПозиции);

	СхемаItems = Новый Структура;
	СхемаItems.Вставить("type", "array");
	СхемаItems.Вставить("description", "Позиции счёта");
	СхемаItems.Вставить("items", СхемаПозиции);

	Свойства = Новый Структура;
	Свойства.Вставить("client_ref", СвойствоСхемы("string",
		"Навигационная ссылка или UUID контрагента (Справочник.Контрагенты)"));
	Свойства.Вставить("items", СхемаItems);
	Свойства.Вставить("organization_ref", СвойствоСхемы("string",
		"Навигационная ссылка на организацию (опционально)"));
	Свойства.Вставить("contract_ref", СвойствоСхемы("string",
		"Навигационная ссылка на договор контрагента (опционально)"));
	Свойства.Вставить("comment", СвойствоСхемы("string",
		"Комментарий к счёту (опционально, до 1000 симв.)"));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("required", СписокИзСтрок2("client_ref", "items"));
	Параметры.Вставить("properties", Свойства);

	Возврат ОбернутьВOpenAIФормат("create_invoice_draft",
		"Создаёт черновик документа «Счёт на оплату» без проведения. Документ не"
		+ " записывается до одобрения оператором.",
		Параметры);

КонецФункции

