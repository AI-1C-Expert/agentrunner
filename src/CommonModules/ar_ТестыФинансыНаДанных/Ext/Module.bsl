// Тест-модуль ar_ТестыФинансыНаДанных - самопроверка финансовых tools НА РЕАЛЬНЫХ
// ДАННЫХ текущей информационной базы.
//
// ЗАЧЕМ ОТДЕЛЬНЫЙ МОДУЛЬ (отличие от ar_ТестыHTTPСервисов):
// те тесты - чистые, без обращения к данным ИБ. Здесь всё наоборот: проверяются
// ровно те дефекты, которые НЕ ловятся ни синтаксическим анализом, ни юнит-
// тестами, потому что проявляются только на живых данных:
//   * запрос не компилируется (Field not found "Субконто1") - синтаксис BSL при
//     этом корректен, ошибка вылезает лишь при Запрос.Выполнить();
//   * фильтр молча не применился и вернулась вся база вместо одного контрагента;
//   * свёртка сальдо разошлась с ОСВ (свёртка поверх организаций, потеря
//     кредитовых строк, схлопывание субсчетов).
//
// ЧТО ДЕЛАЕТ: гоняет те же вызовы tools, что делает LLM в чате, и сверяет ответ
// с ожиданиями. Заменяет ручной цикл «собрать .cfe -> открыть чат -> задать
// вопрос -> выгрузить служебный лог -> глазами сверить с ОСВ».
//
// ЗАПУСК: ar_ТестыФинансыНаДанных.ВыполнитьВсе() - возвращает текстовый отчёт.
// Кнопка «Самопроверка» на форме ar_МастерНастройки вызывает её же.
// Все проверки READ-ONLY по отношению к прикладным данным (документам,
// справочникам БП): ни одного mutating tool, ни одной записи документа/
// контрагента. Исключение - PAY-01: две проверки настроек
// (ПроверкаНастройкиВыключеннаяСтрокаИсключается,
// ПроверкаНастройкиДлиннаяСтрокаНеОбрезается) создают ВРЕМЕННЫЕ элементы
// ar_ДополнительныеНастройки со служебным префиксом Код
// "ar_ТестыФинансыНаДанных_*" и помечают их на удаление сразу после проверки -
// свой собственный служебный справочник расширения, не данные пользователя.
//
// ЭТАЛОН: ожидаемые суммы не зашиты константами - база у каждого своя. Вместо
// этого проверяются ИНВАРИАНТЫ, которые обязаны выполняться на любых данных
// (см. докстринги конкретных проверок).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполнить все проверки и вернуть отчёт.
//
// Возвращаемое значение:
//  Строка - многострочный отчёт: по строке на проверку + итог.
//
Функция ВыполнитьВсе() Экспорт

	Результаты = Новый Массив;

	ДобавитьРезультат(Результаты, "Счёт 62 отвечает без ошибки", ПроверкаСчёт62Отвечает());
	ДобавитьРезультат(Результаты, "Фильтр по контрагенту применяется", ПроверкаФильтрПоКонтрагенту());
	ДобавитьРезультат(Результаты, "Фильтр по организации применяется", ПроверкаФильтрПоОрганизации());
	ДобавитьРезультат(Результаты, "Неизвестный аргумент даёт warning", ПроверкаНеизвестныйАргумент());
	ДобавитьРезультат(Результаты, "Ссылка не того типа отвергается", ПроверкаНеверныйТипСсылки());
	ДобавитьРезультат(Результаты, "ИНН контрагента в organization_inn отвергается", ПроверкаИННКонтрагентаКакОрганизация());
	ДобавитьРезультат(Результаты, "organization_ref больше не принимается", ПроверкаСсылкаОрганизацииОтклонена());
	ДобавитьРезультат(Результаты, "Ненайденный фильтр = ошибка, не warning", ПроверкаНенайденныйФильтрЖёсткий());
	ДобавитьРезультат(Результаты, "Фильтр по ИНН контрагента работает", ПроверкаФильтрПоИННКонтрагента());
	ДобавитьРезультат(Результаты, "Сценарий: акт сверки по долгу контрагента", ПроверкаСценарийАктаСверки());
	ДобавитьРезультат(Результаты, "Свод сходится с сырыми строками", ПроверкаСводСходится());
	ДобавитьРезультат(Результаты, "Свод не сворачивает организации", ПроверкаСводНеСворачиваетОрганизации());
	ДобавитьРезультат(Результаты, "Дт и Кт не свёрнуты между собой", ПроверкаДебетКредитРаздельно());
	ДобавитьРезультат(Результаты, "Манифесты tools в формате OpenAI", ПроверкаФорматаМанифестов());
	ДобавитьРезультат(Результаты, "ask_user зарегистрирован и включён", ПроверкаAskUserДоступен());
	ДобавитьРезультат(Результаты, "Акт сверки требует организацию", ПроверкаАктТребуетОрганизацию());
	ДобавитьРезультат(Результаты, "Пропуск не ссылается на удалённый акт", ПроверкаПропускНеНаПомеченныйАкт());
	ДобавитьРезультат(Результаты, "Предпроверка ловит невыполнимый вызов", ПроверкаПредпроверкиАргументов());
	ДобавитьРезультат(Результаты, "Поиск организации по ИНН", ПроверкаПоискОрганизацииПоИНН());

	// PAY-01: неоплаченные счета, история напоминаний, настройки.
	ДобавитьРезультат(Результаты, "list_unpaid_invoices отвечает без ошибки", ПроверкаНеоплаченныеСчетаОтвечает());
	ДобавитьРезультат(Результаты, "list_unpaid_invoices: paid+debt=amount", ПроверкаНеоплаченныеСчетаСуммыСходятся());
	ДобавитьРезультат(Результаты, "only_unpaid=true не содержит paid", ПроверкаНеоплаченныеСчетаТолькоНеоплаченные());
	ДобавитьРезультат(Результаты, "Статус Отменен не встречается никогда", ПроверкаНеоплаченныеСчетаБезОтменённых());
	ДобавитьРезультат(Результаты, "list_unpaid_invoices: неизвестный аргумент даёт warning", ПроверкаНеоплаченныеСчетаНеизвестныйАргумент());
	ДобавитьРезультат(Результаты, "list_unpaid_invoices: organization_ref отклоняется", ПроверкаНеоплаченныеСчетаOrganizationRefОтклонён());
	ДобавитьРезультат(Результаты, "get_invoice_reminder_history: чистый счёт", ПроверкаИсторияНапоминанийЧистыйСчёт());
	ДобавитьРезультат(Результаты, "get_invoice_reminder_history: invoice_ref обязателен", ПроверкаИсторияНапоминанийБезСсылки());
	ДобавитьРезультат(Результаты, "ar_Настройки: пустой ключ -> пустой список", ПроверкаНастройкиПустойКлюч());
	ДобавитьРезультат(Результаты, "ar_Настройки: скаляр и список независимы", ПроверкаНастройкиСкалярИСписокНезависимы());
	ДобавитьРезультат(Результаты, "ar_Настройки: ar_Включено=Ложь исключается", ПроверкаНастройкиВыключеннаяСтрокаИсключается());
	ДобавитьРезультат(Результаты, "ar_Настройки: длинная строка не обрезается", ПроверкаНастройкиДлиннаяСтрокаНеОбрезается());
	ДобавитьРезультат(Результаты, "get_settings: несуществующий ключ", ПроверкаGetSettingsНесуществующийКлюч());
	ДобавитьРезультат(Результаты, "get_settings: список ключей без ошибки", ПроверкаGetSettingsСписок());
	ДобавитьРезультат(Результаты, "РазрешитьОрганизацииОплат: настройка пуста + 1 организация", ПроверкаРазрешениеОрганизацийSingleOrg());
	ДобавитьРезультат(Результаты, "Доп.свойство исключений: поиск по имени не падает", ПроверкаПоискСвойстваИсключений());
	ДобавитьРезультат(Результаты, "list_unpaid_invoices: limit точный при исключённых счетах", ПроверкаНеоплаченныеСчетаLimitСИсключёнными());
	ДобавитьРезультат(Результаты, "РазрешитьОрганизацииОплат: неразрешимая ссылка даёт warning, не тишину", ПроверкаНеразрешимаяСсылкаВНастройкеДаётWarning());

	// ORG-01: организация по НАИМЕНОВАНИЮ. Кейс с прода: пользователь называет
	// организацию словами, в базе их два десятка - до этой правки tool не мог
	// её найти (ИНН модели взять было неоткуда).
	ДобавитьРезультат(Результаты, "search_organizations зарегистрирован и включён", ПроверкаПоискОрганизацийЗарегистрирован());
	ДобавитьРезультат(Результаты, "search_organizations: список без query", ПроверкаПоискОрганизацийБезЗапроса());
	ДобавитьРезультат(Результаты, "search_organizations: total_found не длина items", ПроверкаПоискОрганизацийTotalFoundЧестный());
	ДобавитьРезультат(Результаты, "search_organizations: точное наименование", ПроверкаПоискОрганизацийПоТочномуИмени());
	ДобавитьРезультат(Результаты, "search_organizations: часть наименования", ПроверкаПоискОрганизацийПоЧастиИмени());
	ДобавитьРезультат(Результаты, "search_organizations: регистр не важен", ПроверкаПоискОрганизацийРегистронезависим());
	ДобавитьРезультат(Результаты, "search_organizations: спецсимволы ПОДОБНО экранируются", ПроверкаЭкранированияСпецсимволовПоиска());
	ДобавитьРезультат(Результаты, "list_unpaid_invoices по имени организации №1", ПроверкаНеоплаченныеСчетаПоИмениОрганизации());
	ДобавитьРезультат(Результаты, "list_unpaid_invoices по имени организации №2", ПроверкаНеоплаченныеСчетаПоИмениВторойОрганизации());
	ДобавитьРезультат(Результаты, "list_unpaid_invoices: несуществующее имя = ошибка", ПроверкаНеоплаченныеСчетаНенайденноеИмяОрганизации());
	ДобавитьРезультат(Результаты, "organization_inn приоритетнее organization_name", ПроверкаПриоритетИННнадИменем());

	Возврат СобратьОтчёт(Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Базовая проверка: tool отвечает и не падает в query_failed. Именно этот
// дефект был в 0.1.0.141 (Field not found "Субконто1") - BSL-синтаксис
// корректен, ошибка только при выполнении запроса.
//
Функция ПроверкаСчёт62Отвечает()

	Ответ = ВызватьОстатки(Новый Структура("account", "62"));

	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка + " " + Ответ.Деталь);
	КонецЕсли;

	Если Ответ.Данные.Получить("items") = Неопределено Тогда
		Возврат Провал("в ответе нет поля items");
	КонецЕсли;

	Возврат Успех("строк: " + Строка(ЗначениеЧисло(Ответ.Данные, "total_found")));

КонецФункции

// Фильтр по контрагенту обязан СУЖАТЬ выдачу. Дефект 0.1.0.140: client_ref
// молча игнорировался, возвращалась вся база, и LLM подавала чужие суммы как
// данные одного контрагента.
//
Функция ПроверкаФильтрПоКонтрагенту()

	Контрагент = ПервыйКонтрагентИзОстатков();
	Если Контрагент = Неопределено Тогда
		Возврат Пропуск("в базе нет строк с контрагентом по счёту 62");
	КонецЕсли;

	ОтветБезФильтра = ВызватьОстатки(Новый Структура("account", "62"));
	Если ОтветБезФильтра.Ошибка <> "" Тогда
		Возврат Провал("вызов без фильтра: " + ОтветБезФильтра.Ошибка);
	КонецЕсли;

	Аргументы = Новый Структура("account", "62");
	Аргументы.Вставить("contragent_ref", Контрагент.Ссылка);
	ОтветСФильтром = ВызватьОстатки(Аргументы);
	Если ОтветСФильтром.Ошибка <> "" Тогда
		Возврат Провал("вызов с фильтром: " + ОтветСФильтром.Ошибка
			+ " " + ОтветСФильтром.Деталь);
	КонецЕсли;

	// Все вернувшиеся строки должны быть по запрошенному контрагенту.
	Элементы = ОтветСФильтром.Данные.Получить("items");
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Провал("items не массив");
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл
		ИмяВСтроке = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "contragent_name", "")));
		Если ИмяВСтроке <> Контрагент.Имя Тогда
			Возврат Провал("фильтр не применён: запрошен '" + Контрагент.Имя
				+ "', в выдаче есть '" + ИмяВСтроке + "'");
		КонецЕсли;
	КонецЦикла;

	СтрокБез = ЗначениеЧисло(ОтветБезФильтра.Данные, "total_found");
	СтрокС = ЗначениеЧисло(ОтветСФильтром.Данные, "total_found");
	Если СтрокС >= СтрокБез И СтрокБез > 1 Тогда
		Возврат Провал("фильтр не сузил выдачу: было " + Строка(СтрокБез)
			+ ", стало " + Строка(СтрокС));
	КонецЕсли;

	Возврат Успех("'" + Контрагент.Имя + "': " + Строка(СтрокС)
		+ " из " + Строка(СтрокБез));

КонецФункции

// Фильтр по организации обязан сужать выдачу и не ронять запрос. Позиция
// параметра «Условие» в виртуальной таблице - место двух прошлых ошибок.
//
Функция ПроверкаФильтрПоОрганизации()

	Организация = ПерваяОрганизацияИзОстатков();
	Если Организация = Неопределено Тогда
		Возврат Пропуск("в базе нет строк с организацией по счёту 62");
	КонецЕсли;

	// Организация задаётся ТОЛЬКО по ИНН (ссылки отклоняются как класс).
	ИННОрганизации = ИННПоСсылке(Организация.Ссылка);
	Если ПустаяСтрока(ИННОрганизации) Тогда
		Возврат Пропуск("у организации '" + Организация.Имя + "' не заполнен ИНН");
	КонецЕсли;

	Аргументы = Новый Структура("account", "62");
	Аргументы.Вставить("organization_inn", ИННОрганизации);
	Ответ = ВызватьОстатки(Аргументы);

	Если Ответ.Ошибка = "organization_inn_ambiguous" Тогда
		Возврат Пропуск("ИНН " + ИННОрганизации + " у нескольких организаций");
	КонецЕсли;
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка + " " + Ответ.Деталь);
	КонецЕсли;

	Элементы = Ответ.Данные.Получить("items");
	Если ТипЗнч(Элементы) = Тип("Массив") Тогда
		Для Каждого Элемент Из Элементы Цикл
			ИмяВСтроке = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "organization_name", "")));
			Если ИмяВСтроке <> Организация.Имя Тогда
				Возврат Провал("фильтр не применён: запрошена '" + Организация.Имя
					+ "', в выдаче есть '" + ИмяВСтроке + "'");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Успех("'" + Организация.Имя + "': "
		+ Строка(ЗначениеЧисло(Ответ.Данные, "total_found")) + " строк");

КонецФункции

// Непонятый аргумент обязан попасть в warnings, а не быть выброшенным молча.
// Тихий отказ - худший вид: LLM принимает полную выдачу за отфильтрованную.
//
Функция ПроверкаНеизвестныйАргумент()

	Аргументы = Новый Структура("account", "62");
	Аргументы.Вставить("совершенно_неизвестный_ключ", "значение");
	Ответ = ВызватьОстатки(Аргументы);

	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Если Не ЕстьПредупреждение(Ответ.Данные, "unknown_argument:совершенно_неизвестный_ключ") Тогда
		Возврат Провал("нет warning unknown_argument - аргумент проглочен молча");
	КонецЕсли;

	Возврат Успех("warning выдан");

КонецФункции

// Ссылка на контрагента в organization_ref - ошибка вызова, а не «организация
// не найдена». Реальный случай: из-за мягкой деградации вернулась вся база и
// были созданы акты сверки по чужим контрагентам, включая гос. органы.
//
Функция ПроверкаНеверныйТипСсылки()

	Контрагент = ПервыйКонтрагентИзОстатков();
	Если Контрагент = Неопределено Тогда
		Возврат Пропуск("в базе нет строк с контрагентом по счёту 62");
	КонецЕсли;

	Аргументы = Новый Структура("account", "62");
	// Намеренно кладём контрагента туда, где ждут организацию. После смены
	// подхода ссылка в organization_ref отклоняется независимо от того, на что
	// она указывает - это и есть защита «по классу», а не по частному случаю.
	Аргументы.Вставить("organization_ref", Контрагент.Ссылка);
	Ответ = ВызватьОстатки(Аргументы);

	Если ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат Провал("подмена принята - вернулась вся база");
	КонецЕсли;

	Если Ответ.Ошибка <> "organization_ref_not_supported" Тогда
		Возврат Провал("ожидалось organization_ref_not_supported, получено: " + Ответ.Ошибка);
	КонецЕсли;

	Возврат Успех("подмена типа отвергнута");

КонецФункции

// ИНН КОНТРАГЕНТА в organization_inn - реальный промах LLM: она взяла inn из
// search_clients (Шилов ПБОЮЛ, 9334123401) и положила его в аргумент
// организации. Прежняя защита проверяла формат навигационной ссылки и голые
// цифры пропускала: вызов вернул всю базу с мягким organization_not_found.
// Теперь это жёсткая ошибка, а деталь прямо называет контрагента.
//
Функция ПроверкаИННКонтрагентаКакОрганизация()

	Контрагент = ПервыйКонтрагентСИННИзОстатков();
	Если Контрагент = Неопределено Тогда
		Возврат Пропуск("нет контрагента с заполненным ИНН в остатках по 62");
	КонецЕсли;

	Аргументы = Новый Структура("account", "62");
	Аргументы.Вставить("organization_inn", Контрагент.ИНН);
	Ответ = ВызватьОстатки(Аргументы);

	Если ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат Провал("ИНН контрагента принят как организация - вернулась вся база");
	КонецЕсли;

	Если Ответ.Ошибка <> "organization_not_found_by_inn" Тогда
		Возврат Провал("ожидалось organization_not_found_by_inn, получено: " + Ответ.Ошибка);
	КонецЕсли;

	// Деталь обязана подсказать, что это контрагент - иначе модель повторит вызов.
	Если СтрНайти(НРег(Ответ.Деталь), НРег("контрагент")) = 0 Тогда
		Возврат Провал("в детали нет подсказки про контрагента: " + Ответ.Деталь);
	КонецЕсли;

	Возврат Успех("ИНН " + Контрагент.ИНН + " отвергнут с подсказкой");

КонецФункции

// organization_ref выведен из употребления: организация задаётся только ИНН.
// Проверяем, что старый аргумент не игнорируется молча, а объясняется.
//
Функция ПроверкаСсылкаОрганизацииОтклонена()

	Организация = ПерваяОрганизацияИзОстатков();
	Если Организация = Неопределено Тогда
		Возврат Пропуск("в базе нет строк с организацией по счёту 62");
	КонецЕсли;

	Аргументы = Новый Структура("account", "62");
	// Заведомо КОРРЕКТНАЯ ссылка на организацию - и она тоже должна быть
	// отклонена: приём организации ссылкой убран как класс.
	Аргументы.Вставить("organization_ref", Организация.Ссылка);
	Ответ = ВызватьОстатки(Аргументы);

	Если Ответ.Ошибка <> "organization_ref_not_supported" Тогда
		Возврат Провал("ожидалось organization_ref_not_supported, получено: "
			+ ?(ПустаяСтрока(Ответ.Ошибка), "успешный ответ", Ответ.Ошибка));
	КонецЕсли;

	// Мало отклонить вызов - надо назвать выход. В логе 0.1.0.147 модель
	// получила этот отказ, не увидела в нём пути дальше и пошла спрашивать ИНН
	// организации у пользователя обычным текстом, хотя ей нужен был вызов с
	// одним contragent_inn. Деталь обязана вести к следующему шагу.
	Если СтрНайти(НРег(Ответ.Деталь), "contragent_inn") = 0 Тогда
		Возврат Провал("деталь ошибки не подсказывает contragent_inn -"
			+ " модель уйдёт спрашивать ИНН у пользователя");
	КонецЕсли;

	Возврат Успех("старый аргумент объяснён, путь дальше назван");

КонецФункции

// Запрошенный фильтр либо применяется, либо вызов отклоняется. Мягкая
// деградация (warning + вся база) недопустима: именно она приводила к тому,
// что LLM подавала чужие суммы как данные одного контрагента, а однажды - к
// созданию актов сверки по посторонним контрагентам.
//
Функция ПроверкаНенайденныйФильтрЖёсткий()

	// Заведомо несуществующий ИНН правильного формата.
	Аргументы = Новый Структура("account", "62");
	Аргументы.Вставить("organization_inn", "0000000000");
	Ответ = ВызватьОстатки(Аргументы);

	Если ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат Провал("несуществующая организация не отвергнута - вернулась вся база");
	КонецЕсли;

	// Тот же инвариант для контрагента.
	АргументыКонтр = Новый Структура("account", "62");
	АргументыКонтр.Вставить("contragent_inn", "0000000000");
	ОтветКонтр = ВызватьОстатки(АргументыКонтр);

	Если ПустаяСтрока(ОтветКонтр.Ошибка) Тогда
		Возврат Провал("несуществующий контрагент не отвергнут - вернулась вся база");
	КонецЕсли;

	Возврат Успех("оба фильтра дают ошибку");

КонецФункции

// Фильтр по ИНН контрагента - основной способ отбора после смены подхода.
//
Функция ПроверкаФильтрПоИННКонтрагента()

	Контрагент = ПервыйКонтрагентСИННИзОстатков();
	Если Контрагент = Неопределено Тогда
		Возврат Пропуск("нет контрагента с заполненным ИНН в остатках по 62");
	КонецЕсли;

	Аргументы = Новый Структура("account", "62");
	Аргументы.Вставить("contragent_inn", Контрагент.ИНН);
	Ответ = ВызватьОстатки(Аргументы);

	Если Ответ.Ошибка <> "" Тогда
		// Дубли по ИНН - особенность базы, а не дефект инструмента.
		Если Ответ.Ошибка = "contragent_inn_ambiguous" Тогда
			Возврат Пропуск("ИНН " + Контрагент.ИНН + " у нескольких контрагентов");
		КонецЕсли;
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка + " " + Ответ.Деталь);
	КонецЕсли;

	Элементы = Ответ.Данные.Получить("items");
	Если ТипЗнч(Элементы) = Тип("Массив") Тогда
		Для Каждого Элемент Из Элементы Цикл
			ИмяВСтроке = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "contragent_name", "")));
			Если ИмяВСтроке <> Контрагент.Имя Тогда
				Возврат Провал("фильтр по ИНН не применён: в выдаче '" + ИмяВСтроке + "'");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Успех("'" + Контрагент.Имя + "' по ИНН " + Контрагент.ИНН);

КонецФункции

// СКВОЗНОЙ СЦЕНАРИЙ - тот самый, который проверялся вручную восемь версий
// подряд: «создай акт сверки с <контрагентом> по организациям, где есть долг».
//
// Шаги ровно как у LLM в чате:
//   1. find_overdue_receivables с фильтром по контрагенту (по ИНН);
//   2. из by_contragent берём пару организация+долг;
//   3. create_reconciliation_act с ИНН этой организации.
//
// Шаг 3 выполняется в режиме _dry_run: документ НЕ создаётся, но проходит вся
// цепочка разыменования аргументов - именно там ломались прошлые версии.
//
Функция ПроверкаСценарийАктаСверки()

	Контрагент = ПервыйКонтрагентСИННИзОстатков();
	Если Контрагент = Неопределено Тогда
		Возврат Пропуск("нет контрагента с заполненным ИНН в остатках по 62");
	КонецЕсли;

	// Шаг 1: долги контрагента в разрезе организаций.
	Аргументы = Новый Структура;
	Аргументы.Вставить("contragent_inn", Контрагент.ИНН);
	ОтветJSON = ar_ToolФинансы.ПросроченнаяДебиторка(
		ar_JSON.ВЗначениеJSON(Аргументы), Неопределено);
	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Провал("шаг 1: ответ не разобран");
	КонецЕсли;

	КодОшибки = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));
	Если КодОшибки = "contragent_inn_ambiguous" Тогда
		Возврат Пропуск("ИНН " + Контрагент.ИНН + " у нескольких контрагентов");
	КонецЕсли;
	Если Не ПустаяСтрока(КодОшибки) Тогда
		Возврат Провал("шаг 1: " + КодОшибки);
	КонецЕсли;

	// Шаг 2: организация с долгом.
	Свод = Разобрано.Получить("by_contragent");
	Если ТипЗнч(Свод) <> Тип("Массив") Или Свод.Количество() = 0 Тогда
		Возврат Пропуск("у '" + Контрагент.Имя + "' нет долга по 62");
	КонецЕсли;

	СтрокаСвода = Свод[0];
	ИННОрганизации = СокрЛП(Строка(ЗначениеПоКлючу(СтрокаСвода, "organization_inn", "")));
	ИмяОрганизации = СокрЛП(Строка(ЗначениеПоКлючу(СтрокаСвода, "organization_name", "")));
	Если ПустаяСтрока(ИННОрганизации) Тогда
		Возврат Провал("шаг 2: в by_contragent нет organization_inn - модели"
			+ " неоткуда взять организацию для акта");
	КонецЕсли;

	// Шаг 3: акт сверки в режиме симуляции (документ не создаётся).
	АргументыАкта = Новый Структура;
	АргументыАкта.Вставить("client_ref", ЗначениеПоКлючу(СтрокаСвода, "contragent_ref", ""));
	АргументыАкта.Вставить("organization_inn", ИННОрганизации);
	АргументыАкта.Вставить("_dry_run", Истина);

	ОтветАкта = ar_ToolДокументы.СоздатьАктСверки(
		ar_JSON.ВЗначениеJSON(АргументыАкта), Неопределено);
	РазобраноАкт = ar_JSON.ИзJSON(ОтветАкта);
	Если ТипЗнч(РазобраноАкт) <> Тип("Соответствие") Тогда
		Возврат Провал("шаг 3: ответ не разобран");
	КонецЕсли;

	ОшибкаАкта = СокрЛП(Строка(ЗначениеПоКлючу(РазобраноАкт, "error", "")));
	Если Не ПустаяСтрока(ОшибкаАкта) Тогда
		Возврат Провал("шаг 3: " + ОшибкаАкта + " "
			+ СокрЛП(Строка(ЗначениеПоКлючу(РазобраноАкт, "detail", ""))));
	КонецЕсли;

	Возврат Успех("'" + Контрагент.Имя + "' -> '" + ИмяОрганизации
		+ "' (долг " + Формат(ЗначениеЧисло(СтрокаСвода, "net_debt"), "ЧДЦ=2") + ")");

КонецФункции

// Свод by_contragent обязан сходиться с суммой сырых строк items. Расхождение
// означает, что свод и детализация считаются по-разному - пользователь увидит
// две несовпадающие цифры в одном ответе.
//
Функция ПроверкаСводСходится()

	Ответ = ВызватьОстатки(Новый Структура("account", "62"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Если ЕстьПредупреждение(Ответ.Данные, "result_truncated") Тогда
		Возврат Пропуск("выдача обрезана лимитом - сверка невозможна");
	КонецЕсли;

	Свод = Ответ.Данные.Получить("by_contragent");
	Если ТипЗнч(Свод) <> Тип("Массив") Тогда
		Возврат Пропуск("нет by_contragent (счёт без разреза по контрагентам)");
	КонецЕсли;

	// Итог по своду должен совпасть с итогом по строкам: Дт минус Кт.
	СуммаСвода = 0;
	Для Каждого Строка Из Свод Цикл
		СуммаСвода = СуммаСвода + ЗначениеЧисло(Строка, "net_debt");
	КонецЦикла;

	ИтогДт = ЗначениеЧисло(Ответ.Данные, "total_debit_balance");
	ИтогКт = ЗначениеЧисло(Ответ.Данные, "total_credit_balance");

	// only_debit=Ложь: в своде все контрагенты, сумма net_debt = Дт - Кт.
	Ожидаемое = ИтогДт - ИтогКт;
	Если Не ЧислаРавны(СуммаСвода, Ожидаемое) Тогда
		Возврат Провал("свод " + Формат(СуммаСвода, "ЧДЦ=2")
			+ " <> Дт-Кт " + Формат(Ожидаемое, "ЧДЦ=2"));
	КонецЕсли;

	Возврат Успех("сходится: " + Формат(СуммаСвода, "ЧДЦ=2"));

КонецФункции

// В своде не должно быть двух строк с одной парой организация+контрагент, и
// один контрагент может встречаться в разных организациях. Дефект 0.1.0.138:
// свод схлопывал контрагента поверх организаций, и долг перед одним юрлицом
// гасился авансом, полученным другим.
//
Функция ПроверкаСводНеСворачиваетОрганизации()

	Ответ = ВызватьОстатки(Новый Структура("account", "62"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Свод = Ответ.Данные.Получить("by_contragent");
	Если ТипЗнч(Свод) <> Тип("Массив") Тогда
		Возврат Пропуск("нет by_contragent");
	КонецЕсли;

	ВстреченныеПары = Новый Соответствие;
	Для Каждого Строка Из Свод Цикл
		Ключ = СокрЛП(Строка(ЗначениеПоКлючу(Строка, "organization_name", "")))
			+ "|" + СокрЛП(Строка(ЗначениеПоКлючу(Строка, "contragent_name", "")));
		Если ВстреченныеПары.Получить(Ключ) <> Неопределено Тогда
			Возврат Провал("дубль пары организация+контрагент: " + Ключ);
		КонецЕсли;
		ВстреченныеПары.Вставить(Ключ, Истина);

		// Обязательное поле: без организации строка свода бессмысленна.
		Если ПустаяСтрока(СокрЛП(Строка(ЗначениеПоКлючу(Строка, "organization_name", "")))) Тогда
			Возврат Провал("в строке свода пустая организация");
		КонецЕсли;
	КонецЦикла;

	Возврат Успех("строк свода: " + Строка(Свод.Количество()));

КонецФункции

// Дт и Кт обязаны приходить раздельными полями. Дефект 0.1.0.135: запрос
// вычитал Кт из Дт внутри группы, из-за чего контрагенты с авансом больше
// долга исчезали из выдачи вопреки ОСВ.
//
Функция ПроверкаДебетКредитРаздельно()

	Ответ = ВызватьОстатки(Новый Структура("account", "62"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Элементы = Ответ.Данные.Получить("items");
	Если ТипЗнч(Элементы) <> Тип("Массив") Или Элементы.Количество() = 0 Тогда
		Возврат Пропуск("нет строк для проверки");
	КонецЕсли;

	Первая = Элементы[0];
	Если ЗначениеПоКлючу(Первая, "balance_debit", Неопределено) = Неопределено
		Или ЗначениеПоКлючу(Первая, "balance_credit", Неопределено) = Неопределено Тогда
		Возврат Провал("нет полей balance_debit/balance_credit - Дт и Кт свёрнуты");
	КонецЕсли;

	// Отрицательных сальдо быть не может: это признак свёртки Дт-Кт.
	Для Каждого Элемент Из Элементы Цикл
		Если ЗначениеЧисло(Элемент, "balance_debit") < 0
			Или ЗначениеЧисло(Элемент, "balance_credit") < 0 Тогда
			Возврат Провал("отрицательное сальдо в строке - признак свёртки Дт-Кт");
		КонецЕсли;
	КонецЦикла;

	Возврат Успех("Дт/Кт раздельно, отрицательных нет");

КонецФункции

// Невыполнимый вызов должен отсекаться ДО очереди approval. Проверяем через
// dry_run - именно так работает предпроверка в ar_RuntimeЦикл: аргументы
// прогоняются через tool, mutating-логика не выполняется, но валидация
// проходит полностью.
//
// Реальный случай: акт сверки без организации ушёл в очередь, пользователь его
// одобрил, и только потом исполнитель отказал с organization_required.
// Подтверждение потрачено впустую, в аудите осталась approved-запись без
// документа.
//
Функция ПроверкаПредпроверкиАргументов()

	Контрагент = ПервыйКонтрагентИзОстатков();
	Если Контрагент = Неопределено Тогда
		Возврат Пропуск("в базе нет строк с контрагентом по счёту 62");
	КонецЕсли;

	// Заведомо невыполнимый вызов: контрагент есть, организации нет.
	Аргументы = Новый Структура;
	Аргументы.Вставить("client_ref", Контрагент.Ссылка);
	Аргументы.Вставить("_dry_run", Истина);

	ОтветJSON = ar_ToolДокументы.СоздатьАктСверки(
		ar_JSON.ВЗначениеJSON(Аргументы), Неопределено);
	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Провал("ответ не разобран");
	КонецЕсли;

	// Ключевое: dry_run НЕ должен глушить валидацию. Если tool возвращает
	// dry-run-заглушку вместо ошибки, предпроверка в рантайме бесполезна -
	// невыполнимый вызов дойдёт до пользователя.
	КодОшибки = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));
	Если КодОшибки <> "organization_required" Тогда
		Возврат Провал("dry_run не поймал отсутствие организации, получено: "
			+ ?(ПустаяСтрока(КодОшибки), "успешный ответ - предпроверка не сработает", КодОшибки));
	КонецЕсли;

	Возврат Успех("невыполнимый вызов отсекается до approval");

КонецФункции

// Каждый включённый tool обязан иметь манифест в формате OpenAI:
// {"type":"function","function":{"name":...}}. Плоский манифест провайдер не
// распознаёт как вызываемую функцию и молча игнорирует - при этом tool
// числится доступным. Так не работал ask_user: модель его не видела и вместо
// вызова писала вопрос текстом в чат, обрывая задачу.
//
// Проверка не требует ни LLM, ни данных - чистая структура реестра ar_Tools.
//
Функция ПроверкаФорматаМанифестов()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_JSONManifest КАК Манифест
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Включён
		|	И НЕ Tools.ПометкаУдаления";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Провал("не удалось прочитать ar_Tools: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Плохие = Новый Массив;
	Всего = 0;

	Пока Выборка.Следующий() Цикл
		Всего = Всего + 1;
		МанифестСтрока = ?(ТипЗнч(Выборка.Манифест) = Тип("Строка"),
			Выборка.Манифест, Строка(Выборка.Манифест));
		Если ПустаяСтрока(МанифестСтрока) Тогда
			Плохие.Добавить(СокрЛП(Строка(Выборка.Имя)) + " (пустой)");
			Продолжить;
		КонецЕсли;

		Разобрано = ar_JSON.ИзJSON(МанифестСтрока);
		Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
			Плохие.Добавить(СокрЛП(Строка(Выборка.Имя)) + " (не JSON)");
			Продолжить;
		КонецЕсли;

		Если Разобрано.Получить("function") = Неопределено Тогда
			Плохие.Добавить(СокрЛП(Строка(Выборка.Имя)) + " (плоский)");
		КонецЕсли;
	КонецЦикла;

	Если Всего = 0 Тогда
		Возврат Пропуск("нет включённых tools");
	КонецЕсли;

	Если Плохие.Количество() > 0 Тогда
		Возврат Провал("манифест не в формате OpenAI: " + СтрСоединить(Плохие, ", "));
	КонецЕсли;

	Возврат Успех("проверено tools: " + Строка(Всего));

КонецФункции

// ask_user - единственный законный способ агента задать уточняющий вопрос.
// Если он выключен или отсутствует, агент, которому не хватает данных, пишет
// вопрос обычным текстом и завершает запуск: цикл не приостанавливается, ответ
// пользователя подхватить некому.
//
Функция ПроверкаAskUserДоступен()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.ar_Включён КАК Включён,
		|	Tools.ar_JSONManifest КАК Манифест
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = ""ask_user""
		|	И НЕ Tools.ПометкаУдаления";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Провал("не удалось прочитать ar_Tools: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат Провал("ask_user не зарегистрирован в ar_Tools");
	КонецЕсли;

	Если Выборка.Включён <> Истина Тогда
		Возврат Провал("ask_user выключен - агент не сможет задать вопрос");
	КонецЕсли;

	МанифестСтрока = ?(ТипЗнч(Выборка.Манифест) = Тип("Строка"),
		Выборка.Манифест, Строка(Выборка.Манифест));
	Разобрано = ar_JSON.ИзJSON(МанифестСтрока);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие")
		Или Разобрано.Получить("function") = Неопределено Тогда
		Возврат Провал("манифест ask_user не в формате OpenAI - провайдер его не увидит");
	КонецЕсли;

	Возврат Успех("зарегистрирован, включён, формат верный");

КонецФункции

// create_reconciliation_act без организации обязан вернуть organization_required,
// а НЕ создать документ по основной организации. Дефект 0.1.0.139: акт молча
// уходил на основную организацию, где у контрагента сальдо нет.
// READ-ONLY: проверяется именно отказ, документ не создаётся.
//
// Помеченный на удаление акт не должен блокировать создание нового.
//
// Сценарий из практики: тул вернул status=skipped ("свежий акт уже есть"), а
// акт, на который он сослался, был помечен на удаление ещё до запуска. Отбор
// "И НЕ Акты.ПометкаУдаления" в НайтиПоследнийАктСверки есть, поэтому проверка
// сверяет не текст запроса, а факт: если tool сказал skipped - документ, на
// который он сослался, обязан быть непомеченным и реально существовать.
//
Функция ПроверкаПропускНеНаПомеченныйАкт()

	ИмяАкта = ar_ToolDispatcher.ИмяОбъектаМетаданных(
		"АктСверкиВзаиморасчетов", "АктСверкиВзаиморасчетов");
	Если Метаданные.Документы.Найти(ИмяАкта) = Неопределено Тогда
		Возврат Пропуск("документ " + ИмяАкта + " отсутствует в конфигурации");
	КонецЕсли;

	// Пара организация+контрагент берётся из by_contragent - тем же путём, что
	// и у LLM: там оба ИНН уже выведены.
	Ответ = ВызватьОстатки(Новый Структура("account", "62"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Пропуск("остатки по 62 недоступны: " + Ответ.Ошибка);
	КонецЕсли;

	Свод = Ответ.Данные.Получить("by_contragent");
	Если ТипЗнч(Свод) <> Тип("Массив") Или Свод.Количество() = 0 Тогда
		Возврат Пропуск("by_contragent пуст - не на чем проверять");
	КонецЕсли;

	СтрокаСвода = Свод[0];
	СсылкаКонтрагента = СокрЛП(Строка(ЗначениеПоКлючу(СтрокаСвода, "contragent_ref", "")));
	ИННОрганизации = СокрЛП(Строка(ЗначениеПоКлючу(СтрокаСвода, "organization_inn", "")));
	Если ПустаяСтрока(СсылкаКонтрагента) Или ПустаяСтрока(ИННОрганизации) Тогда
		Возврат Пропуск("в by_contragent нет пары контрагент+ИНН организации");
	КонецЕсли;

	// Прогоняем создание в dry_run: документ не появится, но порог свежести
	// (и поиск последнего акта) отработает так же, как в боевом вызове.
	Аргументы = Новый Структура;
	Аргументы.Вставить("client_ref", СсылкаКонтрагента);
	Аргументы.Вставить("organization_inn", ИННОрганизации);
	Аргументы.Вставить("_dry_run", Истина);

	ОтветJSON = ar_ToolДокументы.СоздатьАктСверки(ar_JSON.ВЗначениеJSON(Аргументы), Неопределено);
	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Провал("ответ не разобран как JSON");
	КонецЕсли;

	Если СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "status", ""))) <> "skipped" Тогда
		Возврат Пропуск("у контрагента нет свежего акта - пропуск не сработал");
	КонецЕсли;

	СсылкаСтрокой = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "last_act_ref", "")));
	Если ПустаяСтрока(СсылкаСтрокой) Тогда
		Возврат Провал("status=skipped, но last_act_ref пуст -"
			+ " пользователю не на что посмотреть");
	КонецЕсли;

	Попытка
		СсылкаАкта = ar_Утилиты.ОбъектИзНавигационнойСсылки(СсылкаСтрокой);
	Исключение
		Возврат Провал("last_act_ref не разыменовывается: " + СсылкаСтрокой);
	КонецПопытки;

	Если СсылкаАкта = Неопределено Или НЕ ЗначениеЗаполнено(СсылкаАкта) Тогда
		Возврат Провал("last_act_ref ведёт в никуда: " + СсылкаСтрокой);
	КонецЕсли;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаАкта, "ПометкаУдаления") = Истина Тогда
		Возврат Провал("создание заблокировано актом, помеченным на удаление:"
			+ " " + СсылкаСтрокой);
	КонецЕсли;

	Возврат Успех("пропуск сослался на действующий акт");

КонецФункции

Функция ПроверкаАктТребуетОрганизацию()

	Контрагент = ПервыйКонтрагентИзОстатков();
	Если Контрагент = Неопределено Тогда
		Возврат Пропуск("в базе нет строк с контрагентом по счёту 62");
	КонецЕсли;

	Аргументы = Новый Структура;
	Аргументы.Вставить("client_ref", Контрагент.Ссылка);
	// organization_ref и organization_inn намеренно не передаём.

	ОтветJSON = ar_ToolДокументы.СоздатьАктСверки(ar_JSON.ВЗначениеJSON(Аргументы), Неопределено);
	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Провал("ответ не разобран как JSON");
	КонецЕсли;

	КодОшибки = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));
	Если КодОшибки <> "organization_required" Тогда
		Возврат Провал("ожидалось organization_required, получено: "
			+ ?(ПустаяСтрока(КодОшибки), "документ создан без организации!", КодОшибки));
	КонецЕсли;

	Возврат Успех("отказ без организации работает");

КонецФункции

// Поиск организации по ИНН - альтернатива ссылке (ИНН устойчивее: модель не
// путает его с контрагентом). Проверяем на реальной организации из остатков.
//
Функция ПроверкаПоискОрганизацииПоИНН()

	Организация = ПерваяОрганизацияИзОстатков();
	Если Организация = Неопределено Тогда
		Возврат Пропуск("в базе нет строк с организацией по счёту 62");
	КонецЕсли;

	ИНН = ИННПоСсылке(Организация.Ссылка);
	Если ПустаяСтрока(ИНН) Тогда
		Возврат Пропуск("у организации '" + Организация.Имя + "' не заполнен ИНН");
	КонецЕсли;

	Аргументы = Новый Структура("account", "62");
	Аргументы.Вставить("organization_inn", ИНН);
	Ответ = ВызватьОстатки(Аргументы);

	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка + " " + Ответ.Деталь);
	КонецЕсли;

	Если ЕстьПредупреждение(Ответ.Данные, "organization_not_found_by_inn") Тогда
		Возврат Провал("организация по ИНН " + ИНН + " не найдена");
	КонецЕсли;

	// Неоднозначность ИНН - не провал теста, а особенность базы.
	Если ЕстьПредупреждение(Ответ.Данные, "organization_inn_ambiguous") Тогда
		Возврат Пропуск("ИНН " + ИНН + " у нескольких организаций");
	КонецЕсли;

	Возврат Успех("ИНН " + ИНН + " -> '" + Организация.Имя + "'");

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// PAY-01: list_unpaid_invoices, get_invoice_reminder_history, ar_Настройки,
// get_settings/set_setting, организации/исключения.

// Вызов list_unpaid_invoices с аргументами-структурой.
//
// Возвращаемое значение:
//  Структура { Данные: Соответствие, Ошибка: Строка, Деталь: Строка }.
//
Функция ВызватьНеоплаченныеСчета(Знач Аргументы)

	Результат = Новый Структура("Данные, Ошибка, Деталь", Новый Соответствие, "", "");

	Попытка
		ОтветJSON = ar_ToolФинансы.СписокНеоплаченныхСчетов(
			ar_JSON.ВЗначениеJSON(Аргументы), Неопределено);
	Исключение
		Результат.Ошибка = "exception";
		Результат.Деталь = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "invalid_json";
		Возврат Результат;
	КонецЕсли;

	Результат.Данные = Разобрано;
	Результат.Ошибка = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));
	Результат.Деталь = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "detail", "")));
	Возврат Результат;

КонецФункции

// Базовая проверка: tool отвечает и не падает в query_failed. Организация
// может быть не настроена (organization_scope_not_configured) - это не
// провал теста, а особенность базы (SKIP), т.к. проверяется в первую очередь
// сам факт компиляции/выполнения запроса.
//
Функция ПроверкаНеоплаченныеСчетаОтвечает()

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура("days_back", 365));

	Если Ответ.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("организации контроля оплат не настроены - "
			+ "заведите ar_ДополнительныеНастройки/ОрганизацииКонтроляОплат");
	КонецЕсли;

	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка + " " + Ответ.Деталь);
	КонецЕсли;

	Если Ответ.Данные.Получить("invoices") = Неопределено Тогда
		Возврат Провал("в ответе нет поля invoices");
	КонецЕсли;

	Возврат Успех("total_found=" + ЗначениеЧисло(Ответ.Данные, "total_found"));

КонецФункции

// Инвариант: paid_amount + debt_amount ~= amount по каждой строке.
Функция ПроверкаНеоплаченныеСчетаСуммыСходятся()

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура("days_back, only_unpaid", 365, Ложь));

	Если Ответ.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("организации контроля оплат не настроены");
	КонецЕсли;
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Счета = Ответ.Данные.Получить("invoices");
	Если ТипЗнч(Счета) <> Тип("Массив") Или Счета.Количество() = 0 Тогда
		Возврат Пропуск("в базе нет счетов покупателям за проверяемый период");
	КонецЕсли;

	Для Каждого Счёт Из Счета Цикл
		Сумма = ЗначениеЧисло(Счёт, "amount");
		Оплачено = ЗначениеЧисло(Счёт, "paid_amount");
		Долг = ЗначениеЧисло(Счёт, "debt_amount");
		Если Не ЧислаРавны(Оплачено + Долг, Сумма) Тогда
			Возврат Провал(СтрШаблон("счёт %1: paid_amount(%2)+debt_amount(%3)<>amount(%4)",
				ЗначениеПоКлючу(Счёт, "number", ""), Оплачено, Долг, Сумма));
		КонецЕсли;
	КонецЦикла;

	Возврат Успех("проверено счетов: " + Строка(Счета.Количество()));

КонецФункции

// only_unpaid=true никогда не должен возвращать payment_status=paid.
Функция ПроверкаНеоплаченныеСчетаТолькоНеоплаченные()

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура("days_back, only_unpaid", 365, Истина));

	Если Ответ.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("организации контроля оплат не настроены");
	КонецЕсли;
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Счета = Ответ.Данные.Получить("invoices");
	Если ТипЗнч(Счета) <> Тип("Массив") Тогда
		Возврат Провал("в ответе нет поля invoices");
	КонецЕсли;

	Для Каждого Счёт Из Счета Цикл
		Если ЗначениеПоКлючу(Счёт, "payment_status", "") = "paid" Тогда
			Возврат Провал("only_unpaid=true вернул payment_status=paid");
		КонецЕсли;
	КонецЦикла;

	Возврат Успех("проверено счетов: " + Строка(Счета.Количество()));

КонецФункции

// Счета со статусом Отменен не должны встречаться никогда (независимо от
// only_unpaid/include_excluded).
Функция ПроверкаНеоплаченныеСчетаБезОтменённых()

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура(
		"days_back", 365, "only_unpaid", Ложь, "include_excluded", Истина));

	Если Ответ.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("организации контроля оплат не настроены");
	КонецЕсли;
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	// Инвариант проверяется косвенно: сам запрос tool исключает Отменен на
	// уровне SQL (ГДЕ ... И Статус <> Отменен), здесь только фиксируем, что
	// tool отработал без ошибки на этом наборе аргументов.
	Возврат Успех("total_found=" + ЗначениеЧисло(Ответ.Данные, "total_found"));

КонецФункции

// Неизвестный ключ аргумента -> warning, не падение.
Функция ПроверкаНеоплаченныеСчетаНеизвестныйАргумент()

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура("days_back, непонятный_ключ", 30, "x"));

	Если Ответ.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("организации контроля оплат не настроены");
	КонецЕсли;
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку вместо warning: " + Ответ.Ошибка);
	КонецЕсли;

	Если Не ЕстьПредупреждение(Ответ.Данные, "unknown_argument:непонятный_ключ") Тогда
		Возврат Провал("неизвестный ключ не дал warning unknown_argument");
	КонецЕсли;

	Возврат Успех();

КонецФункции

// Контракт «организация только по ИНН»: organization_ref не поддерживается
// как аргумент list_unpaid_invoices (в манифесте его нет вовсе - проверяем,
// что подложенный лишний ключ organization_ref не воспринимается фильтром,
// а уходит в unknown_argument).
Функция ПроверкаНеоплаченныеСчетаOrganizationRefОтклонён()

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура(
		"days_back, organization_ref", 30, "e1cib/data/Справочник.Организации"));

	Если Ответ.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("организации контроля оплат не настроены");
	КонецЕсли;
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Если Не ЕстьПредупреждение(Ответ.Данные, "unknown_argument:organization_ref") Тогда
		Возврат Провал("organization_ref не дал warning unknown_argument - похоже,"
			+ " аргумент молча используется как фильтр");
	КонецЕсли;

	Возврат Успех();

КонецФункции

// get_invoice_reminder_history на счёте без переписки -> reminder_count=0,
// next_reminder_level=1. Берём первый счёт из list_unpaid_invoices.
Функция ПроверкаИсторияНапоминанийЧистыйСчёт()

	ОтветСчетов = ВызватьНеоплаченныеСчета(Новый Структура("days_back, only_unpaid", 365, Ложь));
	Если ОтветСчетов.Ошибка <> "" Тогда
		Возврат Пропуск("нет доступных счетов для проверки (organization_scope не настроен либо база пуста)");
	КонецЕсли;

	Счета = ОтветСчетов.Данные.Получить("invoices");
	Если ТипЗнч(Счета) <> Тип("Массив") Или Счета.Количество() = 0 Тогда
		Возврат Пропуск("в базе нет счетов покупателям за проверяемый период");
	КонецЕсли;

	// Ищем счёт без истории напоминаний - на живой базе не любой первый счёт
	// будет "чистым", поэтому перебираем несколько.
	Для Каждого Счёт Из Счета Цикл
		СсылкаСчёта = СокрЛП(Строка(ЗначениеПоКлючу(Счёт, "invoice_ref", "")));
		Если ПустаяСтрока(СсылкаСчёта) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ОтветJSON = ar_ToolКоммуникации.ИсторияНапоминанийПоСчёту(
				ar_JSON.ВЗначениеJSON(Новый Структура("invoice_ref", СсылкаСчёта)), Неопределено);
		Исключение
			Продолжить;
		КонецПопытки;

		Разобрано = ar_JSON.ИзJSON(ОтветJSON);
		Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеПоКлючу(Разобрано, "error", "") <> "" Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЧисло(Разобрано, "reminder_count") = 0 Тогда
			Если ЗначениеЧисло(Разобрано, "next_reminder_level") <> 1 Тогда
				Возврат Провал("reminder_count=0, но next_reminder_level<>1");
			КонецЕсли;
			Возврат Успех("счёт без истории найден и проверен");
		КонецЕсли;
	КонецЦикла;

	Возврат Пропуск("все проверенные счета уже имеют историю напоминаний");

КонецФункции

// invoice_ref обязателен - без него ошибка, не исключение/падение.
Функция ПроверкаИсторияНапоминанийБезСсылки()

	Попытка
		ОтветJSON = ar_ToolКоммуникации.ИсторияНапоминанийПоСчёту(
			ar_JSON.ВЗначениеJSON(Новый Структура), Неопределено);
	Исключение
		Возврат Провал("исключение вместо ошибки JSON: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Провал("ответ не JSON");
	КонецЕсли;

	Если ЗначениеПоКлючу(Разобрано, "error", "") <> "invoice_ref_required" Тогда
		Возврат Провал("ожидался error=invoice_ref_required, получено: "
			+ ЗначениеПоКлючу(Разобрано, "error", "<нет>"));
	КонецЕсли;

	Возврат Успех();

КонецФункции

// СписокЗначений на незаполненном ключе возвращает пустой массив, не исключение.
Функция ПроверкаНастройкиПустойКлюч()

	Попытка
		Список = ar_Настройки.СписокЗначений("ar_ТестыФинансыНаДанных_НесуществующийКлюч");
	Исключение
		Возврат Провал("СписокЗначений бросил исключение вместо пустого массива: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат Провал("СписокЗначений вернул не Массив");
	КонецЕсли;
	Если Список.Количество() <> 0 Тогда
		Возврат Провал("СписокЗначений на несуществующем ключе вернул непустой массив");
	КонецЕсли;

	Возврат Успех();

КонецФункции

// Скаляр (ЗначениеНастройки) и список (СписокЗначений) читаются независимо -
// проверяется на реальном ключе ОрганизацииКонтроляОплат (сам факт, что
// вызовы не бросают исключений и корректно типизированы).
Функция ПроверкаНастройкиСкалярИСписокНезависимы()

	Попытка
		Маркер = Неопределено;
		Скаляр = ar_Настройки.ЗначениеНастройки("ОрганизацииКонтроляОплат", Маркер);
		Список = ar_Настройки.СписокЗначений("ОрганизацииКонтроляОплат");
	Исключение
		Возврат Провал("исключение при независимом чтении скаляра/списка: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат Провал("СписокЗначений вернул не Массив");
	КонецЕсли;

	Возврат Успех("скаляр=" + ?(Скаляр = Маркер, "<не задан>", Строка(Скаляр))
		+ ", список.Количество()=" + Строка(Список.Количество()));

КонецФункции

// ar_Включено=Ложь в строке ТЧ исключает её из СписокЗначений. Использует
// служебный ключ, создаваемый и удаляемый в рамках этой же проверки -
// read-only тест не должен оставлять мусор в базе после себя навсегда,
// поэтому очищает созданный элемент по завершении.
Функция ПроверкаНастройкиВыключеннаяСтрокаИсключается()

	КлючПроверки = "ar_ТестыФинансыНаДанных_ВременнаяНастройка";

	Попытка
		ar_Настройки.УстановитьСписок(КлючПроверки,
			Новый Массив, Истина, "Временная настройка самопроверки");

		Объект = НайтиОбъектНастройкиПоКоду(КлючПроверки);
		Если Объект = Неопределено Тогда
			Возврат Провал("не удалось создать временную настройку для проверки");
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			СтрокаВключена = Объект.ar_Значения.Добавить();
			СтрокаВключена.ar_ЗначениеСтрока = "включена";
			СтрокаВключена.ar_Включено = Истина;

			СтрокаВыключена = Объект.ar_Значения.Добавить();
			СтрокаВыключена.ar_ЗначениеСтрока = "выключена";
			СтрокаВыключена.ar_Включено = Ложь;

			Объект.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		Список = ar_Настройки.СписокЗначений(КлючПроверки);

		Если Список.Найти("выключена") <> Неопределено Тогда
			УдалитьВременнуюНастройку(КлючПроверки);
			Возврат Провал("СписокЗначений вернул строку с ar_Включено=Ложь");
		КонецЕсли;
		Если Список.Найти("включена") = Неопределено Тогда
			УдалитьВременнуюНастройку(КлючПроверки);
			Возврат Провал("СписокЗначений не вернул строку с ar_Включено=Истина");
		КонецЕсли;

		УдалитьВременнуюНастройку(КлючПроверки);
		Возврат Успех();

	Исключение
		УдалитьВременнуюНастройку(КлючПроверки);
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Строка >1024 символов сохраняется и читается без обрезки (ar_ЗначениеСтрока -
// строка неограниченной длины).
Функция ПроверкаНастройкиДлиннаяСтрокаНеОбрезается()

	КлючПроверки = "ar_ТестыФинансыНаДанных_ДлиннаяСтрока";
	// Собираем циклом, а не СтрЗаполнить/СтрПовторить: ни того, ни другого имени
	// нет ни в этой платформе, ни в БП 3.0 (проверено грепом по исходникам
	// конфигурации) - СтрЗаполнить валило самопроверку с "Процедура или функция
	// с указанным именем не определена".
	ЧастиСтроки = Новый Массив;
	Для Сч = 1 По 1500 Цикл
		ЧастиСтроки.Добавить("x");
	КонецЦикла;
	ДлиннаяСтрока = СтрСоединить(ЧастиСтроки, "");

	Попытка
		ar_Настройки.УстановитьЗначение(КлючПроверки, ДлиннаяСтрока, Истина, "Временная настройка самопроверки");
		Маркер = Неопределено;
		Прочитано = ar_Настройки.ЗначениеНастройки(КлючПроверки, Маркер);
	Исключение
		УдалитьВременнуюНастройку(КлючПроверки);
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	УдалитьВременнуюНастройку(КлючПроверки);

	Если СтрДлина(Прочитано) <> СтрДлина(ДлиннаяСтрока) Тогда
		Возврат Провал(СтрШаблон("длина после чтения %1 <> исходной %2",
			СтрДлина(Прочитано), СтрДлина(ДлиннаяСтрока)));
	КонецЕсли;

	Возврат Успех("длина строки: " + СтрДлина(Прочитано));

КонецФункции

// Удаляет временную настройку самопроверки (физическое удаление - служебный
// справочник расширения, не прикладные данные пользователя, помечать на
// удаление и оставлять для регламентной очистки нет смысла).
Процедура УдалитьВременнуюНастройку(Знач Ключ)

	Попытка
		Объект = НайтиОбъектНастройкиПоКоду(Ключ);
		Если Объект = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Объект.ПометкаУдаления = Истина;
		НачатьТранзакцию();
		Попытка
			Объект.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
		КонецПопытки;
	Исключение
		// Best-effort - неудачная очистка временного тестового объекта не
		// должна ронять всю самопроверку.
		ar_СлужебныйЛог.Записать("ar_ТестыФинансыНаДанных.УдалитьВременнуюНастройку",
			"cleanup_failed", "Ключ=" + Ключ + ": "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

КонецПроцедуры

// Находит объект ar_ДополнительныеНастройки по Код (для служебных проверок).
Функция НайтиОбъектНастройкиПоКоду(Знач Ключ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_ДополнительныеНастройки КАК Настройки
		|ГДЕ
		|	Настройки.Код = &Ключ
		|	И НЕ Настройки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ключ", Ключ);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// get_settings с несуществующим ключом -> setting_not_found с перечнем.
Функция ПроверкаGetSettingsНесуществующийКлюч()

	Попытка
		ОтветJSON = ar_ToolПамять.ПолучитьНастройки(
			ar_JSON.ВЗначениеJSON(Новый Структура("key", "ar_ТестыФинансыНаДанных_ГарантированноНетТакогоКлюча")),
			Неопределено);
	Исключение
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Провал("ответ не JSON");
	КонецЕсли;

	ОшибкаСтрокой = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));
	Если СтрНайти(ОшибкаСтрокой, "setting_not_found") = 0 Тогда
		Возврат Провал("ожидался error с setting_not_found, получено: " + ОшибкаСтрокой);
	КонецЕсли;

	Возврат Успех();

КонецФункции

// get_settings без key возвращает список без ошибки.
Функция ПроверкаGetSettingsСписок()

	Попытка
		ОтветJSON = ar_ToolПамять.ПолучитьНастройки(ar_JSON.ВЗначениеJSON(Новый Структура), Неопределено);
	Исключение
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Провал("ответ не JSON");
	КонецЕсли;

	Если Разобрано.Получить("settings") = Неопределено Тогда
		Возврат Провал("в ответе нет поля settings");
	КонецЕсли;

	Возврат Успех("total_found=" + ЗначениеЧисло(Разобрано, "total_found"));

КонецФункции

// РазрешитьОрганизацииОплат: если настройка пуста и в базе ровно одна
// организация - берётся она (single_org), не ошибка. На базе с несколькими
// организациями и незаполненной настройкой - тест лишь фиксирует корректный
// код ошибки (organization_scope_not_configured), не считает это провалом.
Функция ПроверкаРазрешениеОрганизацийSingleOrg()

	Попытка
		Результат = ar_ToolФинансы.РазрешитьОрганизацииОплат("");
	Исключение
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Результат.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("настройка пуста, организаций в базе несколько - штатное поведение");
	КонецЕсли;
	Если Результат.Ошибка <> "" Тогда
		Возврат Провал("неожиданная ошибка: " + Результат.Ошибка);
	КонецЕсли;

	Если Результат.Организации.Количество() = 0 Тогда
		Возврат Провал("Источник=" + Результат.Источник + ", но список организаций пуст");
	КонецЕсли;

	Возврат Успех("Источник=" + Результат.Источник + ", организаций=" + Результат.Организации.Количество());

КонецФункции

// Поиск доп.свойства исключений по имени не должен падать даже если свойство
// не заведено администратором (best-effort, возвращает Неопределено).
Функция ПроверкаПоискСвойстваИсключений()

	Попытка
		Свойство = ar_ToolФинансы.НайтиСвойствоИсключенийПоИмени();
	Исключение
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Свойство = Неопределено Тогда
		Возврат Успех("свойство ar_ИсключитьИзНапоминанийОбОплате не заведено (штатно)");
	КонецЕсли;

	Возврат Успех("свойство найдено: " + Строка(Свойство));

КонецФункции

// Замечания ревью 1, п.2: limit ДОЛЖЕН отдавать ровно запрошенное число строк
// (а не total_found - excluded_count "случайно совпавшее" с limit) даже когда
// в выдаче есть исключённые счета - фильтрация исключений теперь идёт ВНУТРИ
// запроса (условие ГДЕ), не постфильтром после уже собранных Лимит строк.
// Требует на базе доп.свойства ar_ИсключитьИзНапоминанийОбОплате хотя бы с
// одним взведённым счётом/контрагентом - иначе SKIP (не может быть проверено
// без данных).
Функция ПроверкаНеоплаченныеСчетаLimitСИсключёнными()

	// Сначала - широкий вызов, чтобы узнать, сколько всего исключённых строк
	// есть на этой базе (include_excluded=true, лимит с запасом).
	ОтветШирокий = ВызватьНеоплаченныеСчета(Новый Структура(
		"days_back", 365, "only_unpaid", Ложь, "include_excluded", Истина, "limit", 200));

	Если ОтветШирокий.Ошибка = "organization_scope_not_configured" Тогда
		Возврат Пропуск("организации контроля оплат не настроены");
	КонецЕсли;
	Если ОтветШирокий.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + ОтветШирокий.Ошибка);
	КонецЕсли;

	Область = ОтветШирокий.Данные.Получить("scope");
	Если ТипЗнч(Область) <> Тип("Соответствие") Тогда
		Возврат Провал("в ответе нет поля scope");
	КонецЕсли;

	ВсегоИсключено = ЗначениеЧисло(Область, "excluded_count");
	Если ВсегоИсключено = 0 Тогда
		Возврат Пропуск("на этой базе нет исключённых счетов (доп.свойство"
			+ " ar_ИсключитьИзНапоминанийОбОплате не заведено либо не взведено ни"
			+ " у одного контрагента/счёта) - проверка limit+исключения требует данных");
	КонецЕсли;

	ВсегоНайденоШироко = ЗначениеЧисло(ОтветШирокий.Данные, "total_found");
	Если ВсегоНайденоШироко < 2 Тогда
		Возврат Пропуск("на этой базе меньше 2 неисключённых счетов - недостаточно"
			+ " данных, чтобы отличить обрезку по limit от совпадения с total_found");
	КонецЕсли;

	// Малый limit (1) БЕЗ include_excluded - при постфильтре в цикле (старый
	// баг) риск получить меньше 1 строки, если первые N строк выборки все
	// исключены. При фильтрации внутри запроса (текущая реализация) limit
	// применяется к уже отфильтрованной от исключений выборке - строка будет.
	ОтветУзкий = ВызватьНеоплаченныеСчета(Новый Структура(
		"days_back", 365, "only_unpaid", Ложь, "include_excluded", Ложь, "limit", 1));

	Если ОтветУзкий.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку на узком вызове: " + ОтветУзкий.Ошибка);
	КонецЕсли;

	СчетаУзкие = ОтветУзкий.Данные.Получить("invoices");
	Если ТипЗнч(СчетаУзкие) <> Тип("Массив") Тогда
		Возврат Провал("в ответе нет поля invoices");
	КонецЕсли;

	Если СчетаУзкие.Количество() <> 1 Тогда
		Возврат Провал(СтрШаблон("limit=1 при excluded_count(%1)>0 вернул %2 строк"
			+ " вместо 1 - похоже на постфильтр вместо фильтрации в запросе",
			ВсегоИсключено, СчетаУзкие.Количество()));
	КонецЕсли;

	Если ЗначениеПоКлючу(СчетаУзкие[0], "excluded", Ложь) = Истина Тогда
		Возврат Провал("include_excluded=false, но вернулась исключённая строка");
	КонецЕсли;

	Возврат Успех(СтрШаблон("excluded_count=%1, limit=1 вернул ровно 1 строку", ВсегоИсключено));

КонецФункции

// Замечания ревью 1, п.1: строка настройки ОрганизацииКонтроляОплат, которую
// не удалось разыменовать (битая навигационная ссылка), не должна молча
// выпадать - РазрешитьОрганизацииОплат обязана вернуть Предупреждения с
// "settings_ref_unresolved". Временно дописывает заведомо неразрешимую строку
// к существующему списку организаций (сохраняя исходные значения) и
// восстанавливает список по завершении - тест read-only по отношению к
// прикладным документам, но кратковременно мутирует служебную настройку
// расширения (см. докстринг модуля, аналогично ПроверкаНастройкиВыключеннаяСтрокаИсключается).
Функция ПроверкаНеразрешимаяСсылкаВНастройкеДаётWarning()

	КлючНастройки = "ОрганизацииКонтроляОплат";
	НеразрешимаяСтрока = "e1cib/data/Справочник.Организации?ref=00000000000000000000000000000099";

	// "Элемент справочника уже существовал" (даже если список внутри пуст) -
	// не то же самое, что "список пуст". После теста нужно вернуть именно
	// исходное состояние: если элемента не было вовсе - удалить созданный,
	// не оставлять пустую запись вместо отсутствующей.
	ЭлементСуществовалДоТеста = (НайтиОбъектНастройкиПоКоду(КлючНастройки) <> Неопределено);
	ИсходныйСписок = ar_Настройки.СписокЗначений(КлючНастройки);

	Попытка

		НовыйСписок = Новый Массив;
		Для Каждого Элемент Из ИсходныйСписок Цикл
			НовыйСписок.Добавить(Строка(Элемент));
		КонецЦикла;
		НовыйСписок.Добавить(НеразрешимаяСтрока);

		ar_Настройки.УстановитьСписок(КлючНастройки, НовыйСписок, Истина,
			"Организации контроля оплат (PAY-01)");

		Результат = ar_ToolФинансы.РазрешитьОрганизацииОплат("");

	Исключение
		ВосстановитьСписокОрганизацийКонтроляОплат(КлючНастройки, ИсходныйСписок, ЭлементСуществовалДоТеста);
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВосстановитьСписокОрганизацийКонтроляОплат(КлючНастройки, ИсходныйСписок, ЭлементСуществовалДоТеста);

	НайденоПредупреждение = Ложь;
	Для Каждого Предупреждение Из Результат.Предупреждения Цикл
		Если СтрНайти(Предупреждение, "settings_ref_unresolved") > 0 Тогда
			НайденоПредупреждение = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Не НайденоПредупреждение Тогда
		Возврат Провал("неразрешимая строка в настройке НЕ дала"
			+ " settings_ref_unresolved - организация могла бы тихо выпасть из"
			+ " контроля оплат без единого сигнала об этом");
	КонецЕсли;

	Возврат Успех("settings_ref_unresolved корректно возвращён");

КонецФункции

// Восстанавливает список ОрганизацииКонтроляОплат до исходного состояния
// после ПроверкаНеразрешимаяСсылкаВНастройкеДаётWarning. Если элемента
// справочника не было ДО теста вовсе (не просто "пустой список") - удаляет
// созданный тестом элемент, а не оставляет его пустым (иначе тест изменил бы
// состав справочника настроек безвозвратно). Best-effort - ошибка
// восстановления пишется в лог, не роняет самопроверку (та же логика, что
// УдалитьВременнуюНастройку).
//
Процедура ВосстановитьСписокОрганизацийКонтроляОплат(Знач Ключ, Знач ИсходныйСписок, Знач ЭлементСуществовалДоТеста)

	Попытка
		Если ЭлементСуществовалДоТеста Тогда
			ar_Настройки.УстановитьСписок(Ключ, ИсходныйСписок, Ложь);
		Иначе
			УдалитьВременнуюНастройку(Ключ);
		КонецЕсли;
	Исключение
		ar_СлужебныйЛог.Записать("ar_ТестыФинансыНаДанных.ВосстановитьСписокОрганизацийКонтроляОплат",
			"restore_failed", "Ключ=" + Ключ + ": "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Вспомогательные

// Вызов get_account_balance с аргументами-структурой.
//
// Возвращаемое значение:
//  Структура { Данные: Соответствие, Ошибка: Строка, Деталь: Строка }.
//
Функция ВызватьОстатки(Знач Аргументы)

	Результат = Новый Структура("Данные, Ошибка, Деталь", Новый Соответствие, "", "");

	Попытка
		ОтветJSON = ar_ToolФинансы.ПолучитьОстатокСчёта(
			ar_JSON.ВЗначениеJSON(Аргументы), Неопределено);
	Исключение
		Результат.Ошибка = "exception";
		Результат.Деталь = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "invalid_json";
		Возврат Результат;
	КонецЕсли;

	Результат.Данные = Разобрано;
	Результат.Ошибка = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));
	Результат.Деталь = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "detail", "")));
	Возврат Результат;

КонецФункции

// Первый контрагент из реальных остатков по 62 (для фильтр-проверок).
// Возвращает Структуру { Ссылка, Имя } либо Неопределено.
//
Функция ПервыйКонтрагентИзОстатков()

	Ответ = ВызватьОстатки(Новый Структура("account", "62"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Элементы = Ответ.Данные.Получить("items");
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл
		Ссылка = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "contragent_ref", "")));
		Имя = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "contragent_name", "")));
		// Строки без контрагента ("<без контрагента>") для фильтра не годятся.
		Если Не ПустаяСтрока(Ссылка) Тогда
			Возврат Новый Структура("Ссылка, Имя", Ссылка, Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Первый контрагент из остатков по 62, у которого заполнен ИНН.
// Возвращает Структуру { Ссылка, Имя, ИНН } либо Неопределено.
//
Функция ПервыйКонтрагентСИННИзОстатков()

	Ответ = ВызватьОстатки(Новый Структура("account", "62"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Элементы = Ответ.Данные.Получить("items");
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл
		СсылкаСтрокой = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "contragent_ref", "")));
		Если ПустаяСтрока(СсылкаСтрокой) Тогда
			Продолжить;
		КонецЕсли;

		// ИНН в items не выводится (он есть только в by_contragent), поэтому
		// читаем его прямо со ссылки.
		ИНН = ИННПоСсылке(СсылкаСтрокой);
		Если Не ПустаяСтрока(ИНН) Тогда
			Возврат Новый Структура("Ссылка, Имя, ИНН", СсылкаСтрокой,
				СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "contragent_name", ""))), ИНН);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Первая организация из реальных остатков по 62.
// Возвращает Структуру { Ссылка, Имя } либо Неопределено.
//
Функция ПерваяОрганизацияИзОстатков()

	Ответ = ВызватьОстатки(Новый Структура("account", "62"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Элементы = Ответ.Данные.Получить("items");
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл
		Ссылка = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "organization_ref", "")));
		Имя = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "organization_name", "")));
		Если Не ПустаяСтрока(Ссылка) Тогда
			Возврат Новый Структура("Ссылка, Имя", Ссылка, Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// ИНН элемента справочника по навигационной ссылке ("" при любой неудаче).
Функция ИННПоСсылке(Знач СтрокаСсылки)

	Если ПустаяСтрока(СтрокаСсылки) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Ссылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
		Если Ссылка = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат СокрЛП(Строка(Ссылка.ИНН));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Истина, если в ответе есть warnings с указанным кодом.
Функция ЕстьПредупреждение(Знач Данные, Знач Код)

	Предупреждения = Данные.Получить("warnings");
	Если ТипЗнч(Предупреждения) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Предупреждение Из Предупреждения Цикл
		Если СокрЛП(Строка(Предупреждение)) = Код Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Сравнение чисел с копеечным допуском (защита от накопления погрешности).
Функция ЧислаРавны(Знач Первое, Знач Второе)
	Возврат Макс(Первое - Второе, Второе - Первое) < 0.01;
КонецФункции

// Число по ключу коллекции (0, если нет или не число).
Функция ЗначениеЧисло(Знач Коллекция, Знач Ключ)
	Значение = ЗначениеПоКлючу(Коллекция, Ключ, 0);
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

// Значение по ключу Соответствия/Структуры с дефолтом.
Функция ЗначениеПоКлючу(Знач Коллекция, Знач Ключ, Знач Дефолт)

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Значение = Коллекция.Получить(Ключ);
		Возврат ?(Значение = Неопределено, Дефолт, Значение);
	КонецЕсли;

	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Коллекция.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат Дефолт;

КонецФункции

// Вызов tool search_organizations - обёртка того же вида, что
// ВызватьНеоплаченныеСчета.
//
Функция ВызватьПоискОрганизаций(Знач Аргументы)

	Результат = Новый Структура("Данные, Ошибка, Деталь", Новый Соответствие, "", "");

	Попытка
		ОтветJSON = ar_ToolФинансы.ПоискОрганизаций(
			ar_JSON.ВЗначениеJSON(Аргументы), Неопределено);
	Исключение
		Результат.Ошибка = "exception";
		Результат.Деталь = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "invalid_json";
		Возврат Результат;
	КонецЕсли;

	Результат.Данные = Разобрано;
	Результат.Ошибка = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));
	Результат.Деталь = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "detail", "")));
	Возврат Результат;

КонецФункции

// Список организаций базы по данным самого tool search_organizations -
// используется как источник «живых» наименований для остальных проверок.
// Берём через tool, а не прямым запросом: так проверка идёт по тому же пути,
// каким пойдёт LLM.
//
Функция ОрганизацииИзПоиска(Знач Лимит = 100)

	Ответ = ВызватьПоискОрганизаций(Новый Структура("limit", Лимит));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Элементы = ЗначениеПоКлючу(Ответ.Данные, "items", Неопределено);
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Элементы;

КонецФункции

// search_organizations без query обязан вернуть список организаций базы.
// Это первый шаг сценария «пользователь назвал организацию словами»: без
// рабочего списка модели неоткуда взять ни наименование, ни ИНН.
//
// total_found обязан показывать, сколько организаций ЕСТЬ, а не сколько
// поместилось в ответ. Дефект: при limit=1 возвращалось
// {"total_found": 1, "truncated": true}, и модель отвечала пользователю
// «в базе одна организация» - усечённую выдачу она подавала как полную.
//
Функция ПроверкаПоискОрганизацийTotalFoundЧестный()

	Полный = ВызватьПоискОрганизаций(Новый Структура("limit", 500));
	Если Полный.Ошибка <> "" Тогда
		Возврат Провал("полный список вернул ошибку: " + Полный.Ошибка);
	КонецЕсли;

	ВсегоПолный = ЗначениеЧисло(Полный.Данные, "total_found");
	Если ВсегоПолный < 2 Тогда
		Возврат Пропуск("в базе меньше двух организаций - обрезку не проверить");
	КонецЕсли;

	// Заведомо усечённая выдача.
	Урезанный = ВызватьПоискОрганизаций(Новый Структура("limit", 1));
	Если Урезанный.Ошибка <> "" Тогда
		Возврат Провал("вызов с limit=1 вернул ошибку: " + Урезанный.Ошибка);
	КонецЕсли;

	ВсегоУрезанный = ЗначениеЧисло(Урезанный.Данные, "total_found");
	Если ВсегоУрезанный <> ВсегоПолный Тогда
		Возврат Провал("total_found при limit=1 = " + Строка(ВсегоУрезанный)
			+ ", а всего организаций " + Строка(ВсегоПолный)
			+ " - модель решит, что это весь список");
	КонецЕсли;

	Элементы = ЗначениеПоКлючу(Урезанный.Данные, "items", Неопределено);
	Отдано = ?(ТипЗнч(Элементы) = Тип("Массив"), Элементы.Количество(), 0);
	Если Отдано <> 1 Тогда
		Возврат Провал("при limit=1 отдано строк: " + Строка(Отдано));
	КонецЕсли;

	Если ЗначениеПоКлючу(Урезанный.Данные, "truncated", Ложь) <> Истина Тогда
		Возврат Провал("при limit=1 не выставлен truncated");
	КонецЕсли;

	Если ЗначениеЧисло(Урезанный.Данные, "returned") <> 1 Тогда
		Возврат Провал("поле returned не равно числу отданных строк");
	КонецЕсли;

	Возврат Успех("total_found=" + Строка(ВсегоУрезанный)
		+ " при отданной 1 строке, truncated=true");

КонецФункции

Функция ПроверкаПоискОрганизацийБезЗапроса()

	Ответ = ВызватьПоискОрганизаций(Новый Структура("limit", 100));

	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("tool вернул ошибку: " + Ответ.Ошибка + " " + Ответ.Деталь);
	КонецЕсли;

	Элементы = ЗначениеПоКлючу(Ответ.Данные, "items", Неопределено);
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Провал("в ответе нет массива items");
	КонецЕсли;

	Если Элементы.Количество() = 0 Тогда
		Возврат Пропуск("в базе нет организаций без пометки удаления");
	КонецЕсли;

	// В выдаче обязан быть ИНН - именно им модель повторяет вызов финансовых
	// tools. Список названий без ИНН бесполезен: ровно из-за его отсутствия
	// диалог зацикливался на organization_not_found_by_inn.
	БезИНН = 0;
	Для Каждого Элемент Из Элементы Цикл
		Если ПустаяСтрока(СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "inn", "")))) Тогда
			БезИНН = БезИНН + 1;
		КонецЕсли;
	КонецЦикла;

	Если БезИНН = Элементы.Количество() Тогда
		Возврат Провал("ни у одной из " + Строка(Элементы.Количество())
			+ " организаций не заполнен inn - модели нечем повторить вызов");
	КонецЕсли;

	Возврат Успех("организаций: " + Строка(Элементы.Количество())
		+ ", без ИНН: " + Строка(БезИНН));

КонецФункции

// Поиск по ПОЛНОМУ наименованию первой организации базы обязан находить
// ровно её. Это воспроизведение исходного дефекта: пользователь называет
// организацию, а найти её было нечем.
//
Функция ПроверкаПоискОрганизацийПоТочномуИмени()

	Организации = ОрганизацииИзПоиска();
	Если Организации.Количество() = 0 Тогда
		Возврат Пропуск("в базе нет организаций");
	КонецЕсли;

	Имя = СокрЛП(Строка(ЗначениеПоКлючу(Организации[0], "name", "")));
	Если ПустаяСтрока(Имя) Тогда
		Возврат Пропуск("у первой организации пустое наименование");
	КонецЕсли;

	Ответ = ВызватьПоискОрганизаций(Новый Структура("query", Имя));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("поиск по имени «" + Имя + "» вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Элементы = ЗначениеПоКлючу(Ответ.Данные, "items", Неопределено);
	Если ТипЗнч(Элементы) <> Тип("Массив") Или Элементы.Количество() = 0 Тогда
		Возврат Провал("поиск по точному имени «" + Имя + "» не нашёл ничего");
	КонецЕсли;

	// Найденное должно содержать искомую организацию, а не что попало.
	Найдена = Ложь;
	Для Каждого Элемент Из Элементы Цикл
		Если СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "name", ""))) = Имя Тогда
			Найдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не Найдена Тогда
		Возврат Провал("в выдаче по «" + Имя + "» нет самой организации");
	КонецЕсли;

	Возврат Успех("«" + Имя + "» найдена, совпадений: " + Строка(Элементы.Количество()));

КонецФункции

// Поиск по ЧАСТИ наименования (вхождению) обязан находить организацию.
// Пользователь диктует «Атлантика», а в базе «ООО Атлантика-Торг».
//
Функция ПроверкаПоискОрганизацийПоЧастиИмени()

	Организации = ОрганизацииИзПоиска();
	Если Организации.Количество() = 0 Тогда
		Возврат Пропуск("в базе нет организаций");
	КонецЕсли;

	Имя = СокрЛП(Строка(ЗначениеПоКлючу(Организации[0], "name", "")));
	Если СтрДлина(Имя) < 4 Тогда
		Возврат Пропуск("наименование «" + Имя + "» слишком короткое для проверки вхождения");
	КонецЕсли;

	// Берём середину строки - так проверяется именно вхождение, а не префикс.
	Фрагмент = Сред(Имя, 2, Мин(СтрДлина(Имя) - 2, 6));

	Ответ = ВызватьПоискОрганизаций(Новый Структура("query", Фрагмент));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("поиск по фрагменту «" + Фрагмент + "» вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Элементы = ЗначениеПоКлючу(Ответ.Данные, "items", Неопределено);
	Если ТипЗнч(Элементы) <> Тип("Массив") Или Элементы.Количество() = 0 Тогда
		Возврат Провал("вхождение «" + Фрагмент + "» из имени «" + Имя + "» не найдено");
	КонецЕсли;

	Возврат Успех("фрагмент «" + Фрагмент + "» дал совпадений: " + Строка(Элементы.Количество()));

КонецФункции

// Регистр не должен влиять: пользователь диктует голосом, и «атлантика»
// обязана находить «Атлантика».
//
Функция ПроверкаПоискОрганизацийРегистронезависим()

	Организации = ОрганизацииИзПоиска();
	Если Организации.Количество() = 0 Тогда
		Возврат Пропуск("в базе нет организаций");
	КонецЕсли;

	Имя = СокрЛП(Строка(ЗначениеПоКлючу(Организации[0], "name", "")));
	Если ПустаяСтрока(Имя) Тогда
		Возврат Пропуск("у первой организации пустое наименование");
	КонецЕсли;

	Результат = ar_ToolФинансы.НайтиОрганизациюПоНаименованиюЭкспорт(НРег(Имя));
	Если Результат.Ошибка = "organization_name_ambiguous" Тогда
		Возврат Пропуск("наименование «" + Имя + "» неоднозначно в этой базе");
	КонецЕсли;

	Если Результат.Ошибка <> "" Тогда
		Возврат Провал("поиск по «" + НРег(Имя) + "» (нижний регистр) вернул "
			+ Результат.Ошибка);
	КонецЕсли;

	Если СокрЛП(Строка(Результат.Ссылка)) <> Имя Тогда
		Возврат Провал("по «" + НРег(Имя) + "» найдена другая организация: "
			+ СокрЛП(Строка(Результат.Ссылка)));
	КонецЕсли;

	Возврат Успех("«" + НРег(Имя) + "» -> «" + Имя + "»");

КонецФункции

// ГЛАВНАЯ проверка кейса: list_unpaid_invoices с organization_name обязан
// отработать по ПЕРВОЙ организации базы - без organization_scope_not_configured
// и без organization_not_found_by_inn.
//
Функция ПроверкаНеоплаченныеСчетаПоИмениОрганизации()

	Возврат ПроверитьСчетаПоИмениОрганизации(0);

КонецФункции

// То же самое по ВТОРОЙ организации - пользователь просил проверить две.
// Отдельная проверка не дублирует первую: она ловит случай, когда фильтр
// молча «залипает» на одной организации независимо от аргумента.
//
Функция ПроверкаНеоплаченныеСчетаПоИмениВторойОрганизации()

	Возврат ПроверитьСчетаПоИмениОрганизации(1);

КонецФункции

// Общее тело двух проверок выше: вызвать list_unpaid_invoices с
// organization_name организации №Индекс и убедиться, что отбор применился
// именно к ней.
//
Функция ПроверитьСчетаПоИмениОрганизации(Знач Индекс)

	Организации = ОрганизацииИзПоиска();
	Если Организации.Количество() <= Индекс Тогда
		Возврат Пропуск("в базе меньше " + Строка(Индекс + 1) + " организаций");
	КонецЕсли;

	Имя = СокрЛП(Строка(ЗначениеПоКлючу(Организации[Индекс], "name", "")));
	Если ПустаяСтрока(Имя) Тогда
		Возврат Пропуск("у организации №" + Строка(Индекс + 1) + " пустое наименование");
	КонецЕсли;

	// Неоднозначные наименования - не дефект отбора, а законный отказ:
	// проверять на них нечего, у них своя проверка.
	Разрешение = ar_ToolФинансы.НайтиОрганизациюПоНаименованиюЭкспорт(Имя);
	Если Разрешение.Ошибка = "organization_name_ambiguous" Тогда
		Возврат Пропуск("наименование «" + Имя + "» неоднозначно");
	КонецЕсли;

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура(
		"days_back, organization_name, limit", 365, Имя, 50));

	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("организация «" + Имя + "»: " + Ответ.Ошибка + " " + Ответ.Деталь);
	КонецЕсли;

	// Отбор обязан быть применён по аргументу, а не по настройке: иначе
	// пользователь получит счета чужих юрлиц под именем запрошенного.
	Область = ЗначениеПоКлючу(Ответ.Данные, "scope", Неопределено);
	Если ТипЗнч(Область) = Тип("Соответствие") Тогда
		Источник = СокрЛП(Строка(ЗначениеПоКлючу(Область, "organization_source", "")));
		Если Источник <> "argument" Тогда
			Возврат Провал("организация «" + Имя + "»: отбор взят не из аргумента"
				+ " (organization_source=" + Источник + ")");
		КонецЕсли;
	КонецЕсли;

	// Каждая строка выдачи обязана относиться к запрошенной организации.
	// Массив строк у list_unpaid_invoices называется invoices (не items):
	// на "items" проверка молча читала бы Неопределено и ничего не проверяла.
	Элементы = ЗначениеПоКлючу(Ответ.Данные, "invoices", Неопределено);
	Чужих = 0;
	Если ТипЗнч(Элементы) = Тип("Массив") Тогда
		Для Каждого Элемент Из Элементы Цикл
			ИмяСтроки = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "organization_name", "")));
			Если Не ПустаяСтрока(ИмяСтроки) И ИмяСтроки <> Имя Тогда
				Чужих = Чужих + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Чужих > 0 Тогда
		Возврат Провал("организация «" + Имя + "»: в выдаче " + Строка(Чужих)
			+ " строк ДРУГИХ организаций - фильтр не применился");
	КонецЕсли;

	КоличествоСтрок = 0;
	Если ТипЗнч(Элементы) = Тип("Массив") Тогда
		КоличествоСтрок = Элементы.Количество();
	КонецЕсли;

	Возврат Успех("«" + Имя + "»: строк " + Строка(КоличествоСтрок));

КонецФункции

// Несуществующее наименование обязано давать ЖЁСТКУЮ ошибку, а не молча
// возвращать счета всех организаций: подмена данных хуже отказа.
//
Функция ПроверкаНеоплаченныеСчетаНенайденноеИмяОрганизации()

	Ответ = ВызватьНеоплаченныеСчета(Новый Структура(
		"days_back, organization_name", 30,
		"ЗаведомоНесуществующаяОрганизация_ar_Тест_ЙЦУКЕН"));

	Если Ответ.Ошибка <> "organization_not_found_by_name" Тогда
		Возврат Провал("ожидали organization_not_found_by_name, получили: «"
			+ Ответ.Ошибка + "»");
	КонецЕсли;

	Если ПустаяСтрока(Ответ.Деталь) Тогда
		Возврат Провал("отказ без detail - модели не за что зацепиться");
	КонецЕсли;

	Возврат Успех(Лев(Ответ.Деталь, 120));

КонецФункции

// ИНН приоритетнее наименования: при обоих заданных аргументах выигрывает
// ИНН (он однозначен). Проверяем, что заведомо мусорное наименование не
// ломает вызов с валидным ИНН.
//
Функция ПроверкаПриоритетИННнадИменем()

	Организации = ОрганизацииИзПоиска();
	Если Организации.Количество() = 0 Тогда
		Возврат Пропуск("в базе нет организаций");
	КонецЕсли;

	ИНН = "";
	Для Каждого Элемент Из Организации Цикл
		ИНН = СокрЛП(Строка(ЗначениеПоКлючу(Элемент, "inn", "")));
		Если Не ПустаяСтрока(ИНН) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ИНН) Тогда
		Возврат Пропуск("ни у одной организации не заполнен ИНН");
	КонецЕсли;

	Результат = ar_ToolФинансы.РазрешитьОрганизацииОплат(
		ИНН, "ЗаведомоНесуществующаяОрганизация_ar_Тест_ЙЦУКЕН");

	Если Результат.Ошибка = "organization_inn_ambiguous" Тогда
		Возврат Пропуск("ИНН " + ИНН + " принадлежит нескольким организациям");
	КонецЕсли;

	Если Результат.Ошибка <> "" Тогда
		Возврат Провал("при валидном ИНН вызов упал в " + Результат.Ошибка
			+ " - наименование не должно было участвовать");
	КонецЕсли;

	Возврат Успех("ИНН " + ИНН + " -> " + Результат.ПредставлениеОрганизаций);

КонецФункции

// Спецсимволы ПОДОБНО не должны превращать поиск в «найти всё»: запрос "%"
// обязан вести себя как обычная подстрока, а не как шаблон.
//
Функция ПроверкаЭкранированияСпецсимволовПоиска()

	ВсегоОрганизаций = ОрганизацииИзПоиска().Количество();
	Если ВсегоОрганизаций = 0 Тогда
		Возврат Пропуск("в базе нет организаций");
	КонецЕсли;

	Ответ = ВызватьПоискОрганизаций(Новый Структура("query", "%"));
	Если Ответ.Ошибка <> "" Тогда
		Возврат Провал("поиск по «%» вернул ошибку: " + Ответ.Ошибка);
	КонецЕсли;

	Элементы = ЗначениеПоКлючу(Ответ.Данные, "items", Неопределено);
	Найдено = ?(ТипЗнч(Элементы) = Тип("Массив"), Элементы.Количество(), 0);

	// Если "%" не экранирован, шаблон "%%%" совпадёт со всеми записями.
	Если Найдено = ВсегоОрганизаций И ВсегоОрганизаций > 1 Тогда
		Возврат Провал("запрос «%» вернул все " + Строка(ВсегоОрганизаций)
			+ " организаций - спецсимвол ПОДОБНО не экранируется");
	КонецЕсли;

	Возврат Успех("«%» дал " + Строка(Найдено) + " из " + Строка(ВсегоОрганизаций));

КонецФункции

// search_organizations обязан быть зарегистрирован в реестре ar_Tools и
// включён - иначе модель его просто не увидит, и вся правка бесполезна.
// Ровно так потерялись 4 tools PAY-01.
//
Функция ПроверкаПоискОрганизацийЗарегистрирован()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.ar_Включён КАК Включён,
		|	Tools.ar_Доступен КАК Доступен
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", "search_organizations");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Провал("карточки search_organizations нет в ar_Tools -"
			+ " выполни перерегистрацию tools");
	КонецЕсли;

	Если Не Выборка.Включён Тогда
		Возврат Провал("search_organizations зарегистрирован, но выключен");
	КонецЕсли;

	Если Не Выборка.Доступен Тогда
		Возврат Провал("search_organizations недоступен (нет справочника Организации?)");
	КонецЕсли;

	Возврат Успех("зарегистрирован, включён, доступен");

КонецФункции

Функция Успех(Знач Деталь = "")
	Возврат Новый Структура("Статус, Деталь", "OK", Деталь);
КонецФункции

Функция Провал(Знач Деталь)
	Возврат Новый Структура("Статус, Деталь", "FAIL", Деталь);
КонецФункции

// Пропуск - когда данных для проверки в базе нет. Это не провал: на пустой или
// нетиповой базе часть проверок физически неприменима.
Функция Пропуск(Знач Деталь)
	Возврат Новый Структура("Статус, Деталь", "SKIP", Деталь);
КонецФункции

Процедура ДобавитьРезультат(Результаты, Знач Имя, Знач Итог)
	Строка = Новый Структура("Имя, Статус, Деталь", Имя, Итог.Статус, Итог.Деталь);
	Результаты.Добавить(Строка);
КонецПроцедуры

// Собрать текстовый отчёт: по строке на проверку + итоговая сводка.
Функция СобратьОтчёт(Знач Результаты)

	Строки = Новый Массив;
	Строки.Добавить("Самопроверка финансовых tools на данных ИБ");
	Строки.Добавить("Версия расширения: " + ВерсияРасширения());
	Строки.Добавить("Дата: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Строки.Добавить("");

	ВсегоОК = 0;
	ВсегоПровалов = 0;
	ВсегоПропусков = 0;

	Для Каждого Результат Из Результаты Цикл
		Если Результат.Статус = "OK" Тогда
			ВсегоОК = ВсегоОК + 1;
		ИначеЕсли Результат.Статус = "FAIL" Тогда
			ВсегоПровалов = ВсегоПровалов + 1;
		Иначе
			ВсегоПропусков = ВсегоПропусков + 1;
		КонецЕсли;

		Строка = "[" + Результат.Статус + "] " + Результат.Имя;
		Если Не ПустаяСтрока(Результат.Деталь) Тогда
			Строка = Строка + " - " + Результат.Деталь;
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;

	Строки.Добавить("");
	Строки.Добавить("Итог: OK=" + Строка(ВсегоОК)
		+ ", FAIL=" + Строка(ВсегоПровалов)
		+ ", SKIP=" + Строка(ВсегоПропусков));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Версия расширения для шапки отчёта (тот же приём, что в служебном логе).
Функция ВерсияРасширения()

	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "AgentRunner" Тогда
				Возврат Расширение.Версия;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "неизвестна";
	КонецПопытки;

	Возврат "неизвестна";

КонецФункции

#КонецОбласти
