// Общий модуль ar_Approval (Approval Flow).
//
// Approval-flow - критический слой безопасности AgentRunner (Plan §2.8, §3.2): все
// мутирующие действия агента с RiskLevel = Draft/Write/Commit НЕ исполняются
// немедленно, а ставятся в очередь ar_ОчередьApproval для ручного подтверждения
// оператором. Метод Поставить - единственная точка входа в этот механизм.
//
// Обязанности модуля (APPR-01):
//   * Поставить - создать запись очереди (pending), перевести запуск в
//     paused_for_approval, сохранить StateSnapshot, записать событие
//     approval_requested. Идемпотентно по IdempotencyKey (executed → дубля нет).
//   * ОбновитьЗаписьApproval - служебный перевод записи в executed/rejected/expired.
//   * НайтиПредыдущийРезультат / ПометитьApprovalВыполненным - кэш идемпотентности
//     commit-tools (перенесены из ar_ToolDispatcher, DISP-04).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Запись/чтение служебных регистров approval-очереди и ar_Запуски недоступны в
// правах пользователя. С AUD-04 этот модуль САМ НЕ переключает привилегированный
// режим: всё точечное повышение привилегий вынесено в фасад
// ar_AuditЗащищённыйРежим, который под привилегиями вызывает обратно служебные
// процедуры этого модуля (область СлужебныйПрограммныйИнтерфейс, суффикс
// БезПривилегий). Сами tools остаются непривилегированными.
//
// См. спеку: .docs/specs/APPR-01.md, .docs/specs/AUD-04.md, Plan §1.3, §2.8, §3.2.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Поставить действие в очередь approval (основная точка входа из ar_RuntimeЦикл).
//
// Создаёт запись в ar_ОчередьApproval со статусом "pending", переводит запуск
// в paused_for_approval и сохраняет StateSnapshot. Идемпотентно: при наличии
// записи с тем же непустым IdempotencyKey в статусе "executed" возвращает её
// ApprovalId без создания дубля.
//
// Параметры:
//  КонтекстЗапуска - Структура - {RunId, [Sequence], [Состояние], ...}. RunId
//                    обязателен. Sequence - порядковый номер действия (дефолт 0).
//                    Состояние - снимок цикла рассуждения для resume (опционально).
//  Действие        - Структура - описание tool-действия:
//                    {Имя, ИдВызова, Аргументы, [IdempotencyKey], [Обоснование],
//                     [RiskLevel]}. Аргументы - Соответствие/Структура или JSON-строка.
//
// Возвращаемое значение:
//  Строка - ApprovalId (UUID) поставленной/найденной записи; "" если запуск уже
//           в финальном статусе (постановка не выполнена - см. граничные случаи).
//
// Исключения: при пустом RunId или ошибке записи в регистр - пробрасывается
//             наружу (цикл RT-06 переведёт запуск в failed).
//
Функция Поставить(Знач КонтекстЗапуска, Знач Действие) Экспорт

	RunId = ЗначениеКонтекста(КонтекстЗапуска, "RunId", "");
	Если ТипЗнч(RunId) <> Тип("Строка") Или ПустаяСтрока(RunId) Тогда
		ВызватьИсключение НСтр("ru = 'APPR-01: RunId обязателен';
								|en = 'APPR-01: RunId is required'");
	КонецЕсли;

	// Граничный случай: запуск уже завершён (completed/failed/...) - не паузим.
	Если ЗапускВФинальномСтатусе(RunId) Тогда
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-01: запуск %1 в финальном статусе, постановка в очередь пропущена';
				|en = 'APPR-01: run %1 is final, approval enqueue skipped'"),
			RunId));
		Возврат "";
	КонецЕсли;

	IdempotencyKey = ЗначениеДействия(Действие, "IdempotencyKey", "");

	// Идемпотентность: если действие уже исполнено - вернуть прежний ApprovalId.
	Если Не ПустаяСтрока(IdempotencyKey) Тогда
		СуществующийId = ar_AuditЗащищённыйРежим.ApprovalIdПоКлючуПривилегированно(
			IdempotencyKey, "executed");
		Если Не ПустаяСтрока(СуществующийId) Тогда
			Возврат СуществующийId;
		КонецЕсли;
	КонецЕсли;

	ApprovalId = ar_Утилиты.НовыйUUID();
	Sequence = ЧислоКонтекста(КонтекстЗапуска, "Sequence", 0);
	Обоснование = ЗначениеДействия(Действие, "Обоснование", "");
	RiskLevel = ЗначениеДействия(Действие, "RiskLevel", "");

	ActionPayloadJSON = СобратьActionPayloadJSON(КонтекстЗапуска, Действие, RunId,
		ApprovalId, RiskLevel);

	// HOOK: BeforeApproval (HOOK-03, точка 7).
	КонтекстСобытияApproval = Новый Структура;
	КонтекстСобытияApproval.Вставить("RunId", RunId);
	КонтекстСобытияApproval.Вставить("Событие", Перечисления.ar_СобытиеHook.BeforeApproval);
	КонтекстСобытияApproval.Вставить("ApprovalId", ApprovalId);
	КонтекстСобытияApproval.Вставить("Действие", Действие);
	КонтекстСобытияApproval.Вставить("RiskLevel", RiskLevel);
	КонтекстСобытияApproval.Вставить("Sequence", Sequence);
	АгентHook = Неопределено;
	КонтекстЗапуска.Свойство("Агент", АгентHook);
	Если АгентHook <> Неопределено Тогда
		КонтекстСобытияApproval.Вставить("Агент", АгентHook);
	КонецЕсли;
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.BeforeApproval, КонтекстСобытияApproval);
	ЗначениеПрервать = Неопределено;
	КонтекстСобытияApproval.Свойство("Прервать", ЗначениеПрервать);
	// Защита типа: хук может не выставить ключ или положить не-Булево значение
	// (см. аналогичный паттерн в ar_RuntimeЦикл, "Cannot convert value to Boolean").
	ПрерватьApproval = (ТипЗнч(ЗначениеПрервать) = Тип("Булево") И ЗначениеПрервать = Истина);
	Если ПрерватьApproval Тогда
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-01: постановка заблокирована хуком (RunId=%1)';
				|en = 'APPR-01: enqueue blocked by hook (RunId=%1)'"),
			RunId));
		Возврат "";
	КонецЕсли;

	// Запись в служебные регистры approval-очереди и ar_Запуски недоступна в
	// правах пользователя. Точечное повышение привилегий инкапсулировано в
	// ar_AuditЗащищённыйРежим (AUD-04): сам approval-модуль режим не переключает.
	Попытка
		ar_AuditЗащищённыйРежим.ПоставитьВОчередьПривилегированно(ApprovalId, RunId,
			Sequence, ActionPayloadJSON, Обоснование, IdempotencyKey);
	Исключение
		ЗаписатьОшибкуЖурнал(СтрШаблон(
			НСтр("ru = 'APPR-01: ошибка постановки в очередь (RunId=%1): %2';
				|en = 'APPR-01: enqueue failed (RunId=%1): %2'"),
			RunId, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		ВызватьИсключение;
	КонецПопытки;

	// StateSnapshot и событие - вне основной транзакции (ar_AuditЗапуски и
	// ar_AuditСобытия открывают собственные транзакции; событие не пробрасывает).
	СохранитьСнимокЕслиЕсть(КонтекстЗапуска, RunId);
	ЗафиксироватьСобытиеЗапрошен(RunId, ApprovalId, ИмяДействия(Действие), RiskLevel);

	Возврат ApprovalId;

КонецФункции

// Принять действие оператором (APPR-02): перевести запись очереди из "pending"
// в "approved", зафиксировать аудит и обновить запись действия ar_ДействияАгента.
//
// Второй шаг approval-flow: единственная точка перехода pending → approved.
// Возобновление НЕ запускается здесь - его выполняет регламентное задание
// ar_ВозобновлениеПослеApproval (SCHED-03), читающее approved-записи. Защита от
// гонки/двойного нажатия обеспечивается ОжидаемыйСтатус = "pending" в
// ОбновитьЗаписьApproval (там же блокировка БлокировкаДанных и транзакция).
//
// Проверка прав оператора (роль ar_РольОператор/ar_РольАдмин) НЕ выполняется
// здесь - метод серверный и вызывается также из регламентных заданий. Контроль
// доступа - ответственность вызывающей формы (UI-08), см. спеку APPR-02.
//
// Параметры:
//  ApprovalId   - Строка - идентификатор записи очереди (измерение ar_ApprovalId).
//                 Обязателен; пустая строка → отказ без обращения к БД.
//  Пользователь - СправочникСсылка.Пользователи - принявший оператор. Допустима
//                 пустая ссылка (например, accept из регламентного задания).
//
// Возвращаемое значение:
//  Структура - {Успех: Булево, RunId: Строка, Причина: Строка}. При Успех=Истина
//              Причина = "", RunId - идентификатор запуска из записи очереди.
//
Функция Принять(Знач ApprovalId, Знач Пользователь) Экспорт

	Результат = Новый Структура("Успех, RunId, Причина", Ложь, "", "");
	// Итог ИСПОЛНЕНИЯ действия (отдельно от Успех - решения оператора): без него
	// форма показывала «Принято» и когда документ не создался, и оператор шёл
	// искать несуществующий документ. Заполняется на шаге 5.
	Результат.Вставить("ДействиеВыполнено", Ложь);
	Результат.Вставить("ДействиеСообщение", "");
	Результат.Вставить("ДокументСсылка", Неопределено);

	Если ТипЗнч(ApprovalId) <> Тип("Строка") Или ПустаяСтрока(ApprovalId) Тогда
		Результат.Причина = "approval_id_required";
		Возврат Результат;
	КонецЕсли;

	// 1. Читаем запись очереди для получения RunId / Sequence / ActionPayloadJSON.
	ДанныеЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно(ApprovalId);
	Если ДанныеЗаписи = Неопределено Тогда
		Результат.Причина = "record_not_found";
		Возврат Результат;
	КонецЕсли;

	RunId = ДанныеЗаписи.RunId;

	// 2. Перевод pending → approved (с блокировкой и защитой от гонки внутри).
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ОжидаемыйСтатус", "pending");
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
		ДопПараметры.Вставить("РешилПользователь", Пользователь);
	КонецЕсли;

	Если Не ОбновитьЗаписьApproval(ApprovalId, "approved", ДопПараметры) Тогда
		// Запись могла быть уже не в pending (двойное нажатие/гонка) либо исчезла.
		ТекущийСтатус = ar_AuditЗащищённыйРежим.СтатусЗаписиОчередиПривилегированно(ApprovalId);
		Если ПустаяСтрока(ТекущийСтатус) Тогда
			Результат.Причина = "record_not_found";
		Иначе
			Результат.Причина = "status_mismatch: " + ТекущийСтатус;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// 3. Обновляем запись действия (ApprovedBy/ApprovedAt). Вторичная операция:
	//    ошибка логируется предупреждением и НЕ влияет на успех Принять.
	ОбновитьДействиеApproved(ДанныеЗаписи, Пользователь);

	// 4. Фиксируем событие Approved (ar_AuditСобытия не пробрасывает исключений).
	ЗафиксироватьСобытиеПринято(RunId, ApprovalId, Пользователь);

	// 5. UNIV-06: исполнение approved-действия - замыкает цепочку
	//    tool -> payload -> очередь -> approve -> ЗАПИСЬ. До UNIV-06 записи не
	//    происходило вовсе (payload оставался в очереди), см. .docs/specs/UNIV-06.md.
	//
	//    Точка выбрана здесь, а не в форме ar_ОчередьПодтверждений: через Принять
	//    проходят ОБА пути подтверждения - одиночный (ПринятьНаСервере) и массовый
	//    (МассовоПринятьНаСервере -> Принять по каждому Id), и только здесь уже
	//    прочитан ActionPayloadJSON. Врезка в форму закрыла бы лишь один путь.
	//
	//    Порядок: до вызова хука AfterApproval - чтобы обработчики хука видели уже
	//    записанный документ, а не пустую очередь.
	//
	//    Ошибка исполнения НЕ отменяет approve: решение оператора зафиксировано,
	//    статус approved уже проставлен (шаг 2) и аудит записан (шаг 4). Причина
	//    неудачи уходит в служебный лог; Успех = Истина остаётся - иначе оператор
	//    получил бы "не принято" на фактически принятой записи.
	ИтогИсполнения = ИсполнитьApprovedДействие(ApprovalId, ДанныеЗаписи);
	Результат.ДействиеВыполнено = ИтогИсполнения.Выполнено;
	Результат.ДействиеСообщение = ИтогИсполнения.Сообщение;
	Результат.ДокументСсылка    = ИтогИсполнения.DocumentRef;

	// Observation с ФАКТИЧЕСКИМ итогом исполнения для LLM при resume. Без него
	// в истории остаётся только "queued for approval", и модель рапортует об
	// успешно созданном документе даже когда исполнитель не отработал
	// (например, no_executor_for_action) - см. лог 0.1.0.133.
	Результат.Вставить("ObservationИсполнения",
		НаблюдениеИтогаИсполнения(ДанныеЗаписи, ИтогИсполнения));

	// Итог исполнения - отдельным audit-событием, чтобы он был виден в логе
	// запуска рядом с Approved, а не только в служебном логе.
	ActionPayloadJSONДляЛога = "";
	ДанныеЗаписи.Свойство("ActionPayloadJSON", ActionPayloadJSONДляЛога);
	ЗафиксироватьСобытиеИсполнения(RunId, ApprovalId,
		ИмяДействияИзJSON(ActionPayloadJSONДляЛога), ИтогИсполнения);

	// HOOK: AfterApproval (HOOK-03, точка 8 - approved).
	КонтекстСобытияAfter = Новый Структура;
	КонтекстСобытияAfter.Вставить("RunId", RunId);
	КонтекстСобытияAfter.Вставить("Событие", Перечисления.ar_СобытиеHook.AfterApproval);
	КонтекстСобытияAfter.Вставить("ApprovalId", ApprovalId);
	КонтекстСобытияAfter.Вставить("Решение", "approved");
	КонтекстСобытияAfter.Вставить("Пользователь", Пользователь);
	Если ДанныеЗаписи.Свойство("Sequence") Тогда
		КонтекстСобытияAfter.Вставить("Sequence", ДанныеЗаписи.Sequence);
	КонецЕсли;
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.AfterApproval, КонтекстСобытияAfter);

	Результат.Успех = Истина;
	Результат.RunId = RunId;
	Возврат Результат;

КонецФункции

// Массово принять действия оператором (APPR-05): пакетное подтверждение нескольких
// pending-записей очереди за один серверный вызов.
//
// Пятый шаг approval-flow. Серверная обёртка над Принять: для каждого ApprovalId
// из списка вызывается Принять, результаты агрегируются. Новой транзакционной /
// блокировочной логики НЕ добавляет - она целиком в Принять (защита от гонки,
// блокировка, аудит Approved по каждой записи). Сверх Принять добавляет: приём
// Массива/СписокЗначений, частичный успех, агрегацию и одну запись агрегатного
// события Approved (bulk:true) в audit на каждый затронутый RunId.
//
// Ошибка отдельного ID (включая исключение внутри Принять) изолируется
// Попытка/Исключение - цикл не прерывается, неуспешный ID попадает в ОшибкиПоId.
// Метод НИКОГДА не выбрасывает исключение - итог возвращается всегда.
//
// Вызывается из формы очереди подтверждений (UI-08) по команде «Принять выбранные»
// либо из кода напрямую. Контроль прав оператора - ответственность формы (как и в
// Принять): метод серверный и может вызываться из регламентных заданий.
//
// Параметры:
//  СписокApprovalId - Массив, СписокЗначений - ApprovalId (строки UUID) записей для
//                     подтверждения. СписокЗначений нормализуется в Массив (берётся
//                     .Значение каждого элемента). Пустые/не-строковые значения
//                     пропускаются с предупреждением в журнал. Пустой список /
//                     Неопределено → результат с нулевыми счётчиками.
//  Пользователь     - СправочникСсылка.Пользователи - принявший оператор. Допустима
//                     пустая ссылка (системный/регламентный вызов) - передаётся в
//                     Принять как есть.
//
// Возвращаемое значение:
//  Структура - {Принято: Число, НеПринято: Число, ОшибкиПоId: Соответствие,
//               ВсегоЗапросов: Число}. ОшибкиПоId: {ApprovalId → Причина (Строка)},
//               заполняется только для неуспешных ID. Полный успех:
//               НеПринято=0 и Принято=ВсегоЗапросов. Частичный успех (Принято>0,
//               НеПринято>0) - не ошибка, не исключение.
//
Функция МассовоПринять(Знач СписокApprovalId, Знач Пользователь) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Принято", 0);
	Результат.Вставить("НеПринято", 0);
	Результат.Вставить("ОшибкиПоId", Новый Соответствие);
	Результат.Вставить("ВсегоЗапросов", 0);
	Результат.Вставить("Выполнено", 0);
	Результат.Вставить("НеВыполнено", 0);

	МассивId = НормализоватьСписокApprovalId(СписокApprovalId);
	Результат.ВсегоЗапросов = МассивId.Количество();

	Если МассивId.Количество() = 0 Тогда
		ЗаписатьПредупреждение(
			НСтр("ru = 'APPR-05: пустой список ApprovalId - пакетное подтверждение пропущено';
				|en = 'APPR-05: empty ApprovalId list - bulk approval skipped'"));
		Возврат Результат;
	КонецЕсли;

	// Большой пакет: на серверном уровне не ограничиваем (ответственность UI-08),
	// но предупреждаем о риске таймаута (APPR-05 R1).
	Если МассивId.Количество() > ПорогБольшогоПакета() Тогда
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-05: большой пакет подтверждения (%1 ID) - возможен таймаут';
				|en = 'APPR-05: large approval batch (%1 IDs) - timeout possible'"),
			Формат(МассивId.Количество(), "ЧГ=0")));
	КонецЕсли;

	// Накопитель затронутых RunId: ключ - RunId, значение - число принятых по нему.
	ПринятоПоRunId = Новый Соответствие;

	Для Каждого ApprovalId Из МассивId Цикл
		ОбработатьОдинApprovalId(ApprovalId, Пользователь, Результат, ПринятоПоRunId);
	КонецЦикла;

	// Агрегатное событие Approved (bulk:true) - по одному на каждый затронутый RunId
	// (Вариант A спеки APPR-05: переиспользуем тип Approved без нового значения
	// перечисления). Пишется только при наличии успешно принятых записей.
	Для Каждого ЭлементRunId Из ПринятоПоRunId Цикл
		ЗафиксироватьСобытиеМассовоПринято(ЭлементRunId.Ключ, ЭлементRunId.Значение, Пользователь);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отклонить действие оператором (APPR-03): перевести запись очереди из "pending"
// в "rejected", зафиксировать аудит и немедленно возобновить агента с rejection-
// observation, чтобы LLM на следующем шаге узнала об отказе и скорректировала тактику.
//
// Третий шаг approval-flow - симметричная относительно Принять «другая ветка».
// В отличие от Принять, возобновление запускается прямо здесь (Вариант A спеки
// APPR-03): регламентное ar_ВозобновлениеПослеApproval (SCHED-03) обрабатывает
// только approved-записи, поэтому rejected-возобновление выполняет сам Отклонить.
//
// Защита от гонки/двойного нажатия - ОжидаемыйСтатус = "pending" в
// ОбновитьЗаписьApproval (там же блокировка и транзакция). Проверка прав оператора
// здесь НЕ выполняется (метод серверный) - это ответственность формы UI-08.
//
// Причина (объяснение отказа) маскируется от секретов, пишется в ar_ОбоснованиеLLM
// записи очереди и передаётся агенту в observation вида "rejected by operator: <Причина>".
//
// Параметры:
//  ApprovalId   - Строка - идентификатор записи очереди (измерение ar_ApprovalId).
//                 Обязателен; пустая строка → отказ без обращения к БД.
//  Пользователь - СправочникСсылка.Пользователи - отклонивший оператор. Допустима
//                 пустая ссылка (например, reject из регламентного задания).
//  Причина      - Строка - человекочитаемое объяснение отказа. Может быть пустой.
//
// Возвращаемое значение:
//  Структура - {Успех: Булево, RunId: Строка, Причина: Строка}. При Успех=Истина
//              Причина = "", RunId - идентификатор запуска из записи очереди.
//
Функция Отклонить(Знач ApprovalId, Знач Пользователь, Знач Причина = "") Экспорт

	Результат = Новый Структура("Успех, RunId, Причина", Ложь, "", "");

	Если ТипЗнч(ApprovalId) <> Тип("Строка") Или ПустаяСтрока(ApprovalId) Тогда
		Результат.Причина = "approval_id_required";
		Возврат Результат;
	КонецЕсли;

	// Барьер: оператор не должен вводить секреты, но защита нужна (Bearer/sk-/ya29.).
	МаскированнаяПричина = ar_Утилиты.МаскироватьСекреты(
		?(ТипЗнч(Причина) = Тип("Строка"), Причина, ""));

	// 1. Читаем запись очереди для получения RunId / Sequence / ActionPayloadJSON.
	ДанныеЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно(ApprovalId);
	Если ДанныеЗаписи = Неопределено Тогда
		Результат.Причина = "record_not_found";
		Возврат Результат;
	КонецЕсли;

	RunId = ДанныеЗаписи.RunId;

	// 2. Перевод pending → rejected (с блокировкой и защитой от гонки внутри).
	//    Маскированная причина пишется в ar_ОбоснованиеLLM через РезультатJSON
	//    (внутри ОбновитьЗаписьApproval это поле маппится в ar_ОбоснованиеLLM).
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ОжидаемыйСтатус", "pending");
	ДопПараметры.Вставить("РезультатJSON", МаскированнаяПричина);
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
		ДопПараметры.Вставить("РешилПользователь", Пользователь);
	КонецЕсли;

	Если Не ОбновитьЗаписьApproval(ApprovalId, "rejected", ДопПараметры) Тогда
		// Запись могла быть уже не в pending (двойное нажатие/гонка) либо исчезла.
		ТекущийСтатус = ar_AuditЗащищённыйРежим.СтатусЗаписиОчередиПривилегированно(ApprovalId);
		Если ПустаяСтрока(ТекущийСтатус) Тогда
			Результат.Причина = "record_not_found";
		Иначе
			Результат.Причина = "status_mismatch: " + ТекущийСтатус;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// 3. Обновляем запись действия (RejectedBy/RejectedAt - в схеме регистра это
	//    поля ApprovedBy/ApprovedAt, отражающие «решившего»). Вторичная операция:
	//    ошибка логируется предупреждением и НЕ влияет на успех Отклонить.
	ОбновитьДействиеApproved(ДанныеЗаписи, Пользователь);

	// 4. Фиксируем событие Rejected (ar_AuditСобытия не пробрасывает исключений).
	ЗафиксироватьСобытиеОтклонено(RunId, ApprovalId, Пользователь, МаскированнаяПричина);

	// HOOK: AfterApproval (HOOK-03, точка 8 - rejected).
	КонтекстСобытияAfter = Новый Структура;
	КонтекстСобытияAfter.Вставить("RunId", RunId);
	КонтекстСобытияAfter.Вставить("Событие", Перечисления.ar_СобытиеHook.AfterApproval);
	КонтекстСобытияAfter.Вставить("ApprovalId", ApprovalId);
	КонтекстСобытияAfter.Вставить("Решение", "rejected");
	КонтекстСобытияAfter.Вставить("Пользователь", Пользователь);
	КонтекстСобытияAfter.Вставить("Причина", МаскированнаяПричина);
	Если ДанныеЗаписи.Свойство("Sequence") Тогда
		КонтекстСобытияAfter.Вставить("Sequence", ДанныеЗаписи.Sequence);
	КонецЕсли;
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.AfterApproval, КонтекстСобытияAfter);

	// 5. Извлекаем tool_call_id и формируем rejection-observation для LLM.
	ToolCallId = ToolCallIdИзPayload(ДанныеЗаписи.ActionPayloadJSON);
	ТекстObservation = ?(ПустаяСтрока(МаскированнаяПричина),
		"rejected by operator",
		"rejected by operator: " + МаскированнаяПричина);

	// 6. Немедленное возобновление с rejection-контекстом (Вариант A APPR-03).
	//    Запись очереди уже в rejected - это верно. Если возобновление не удалось,
	//    запуск остаётся в paused_for_approval до ручного resume / истечения APPR-04.
	КонтекстОтклонения = Новый Структура;
	КонтекстОтклонения.Вставить("ToolCallId", ToolCallId);
	КонтекстОтклонения.Вставить("ТекстObservation", ТекстObservation);

	РезультатВозобновления = ar_RuntimeЗапуск.Возобновить(RunId, КонтекстОтклонения);
	Если Не РезультатВозобновления.Успех Тогда
		Результат.Причина = "resume_failed: " + РезультатВозобновления.Причина;
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.RunId = RunId;
	Возврат Результат;

КонецФункции

// Истечь pending-запись очереди approval по TTL (APPR-04): перевести её из
// "pending" в "expired", зафиксировать событие Expired и немедленно возобновить
// агента с expired-observation, чтобы LLM на следующем шаге узнала о тайм-ауте.
//
// Четвёртый шаг approval-flow. Вызывается из регламентного задания (SCHED-03 или
// будущее ar_ОчисткаApproval) пакетно для каждого ApprovalId из
// НайтиПросроченныеApproval, либо вручную из UI (APPR-05). Метод не различает
// ручной и автоматический вызов.
//
// TTL-проверка выполняется внутри (защитный барьер: разные вызывающие могут иметь
// разный clock) - если со времени ar_СозданоВ прошло менее
// ar_Константы.ApprovalExpirationЧасов() часов, метод не вносит изменений и
// возвращает not_expired_yet. Сравнение и заполнение СозданоВ ведутся через
// ТекущаяДатаСеанса() (оба вызова на сервере - одна TZ, см. APPR-04 R2).
//
// Защита от гонки (оператор одновременно принял/отклонил) - ОжидаемыйСтатус =
// "pending" в ОбновитьЗаписьApproval (там же блокировка и транзакция).
// ar_РешилПользователь намеренно остаётся пустым - истечение системное действие.
//
// Параметры:
//  ApprovalId - Строка - идентификатор записи очереди (измерение ar_ApprovalId).
//               Обязателен; пустая строка → отказ без обращения к БД.
//
// Возвращаемое значение:
//  Структура - {Успех: Булево, RunId: Строка, Причина: Строка}. Тот же контракт,
//              что у Принять и Отклонить.
//
Функция Истечь(Знач ApprovalId) Экспорт

	Результат = Новый Структура("Успех, RunId, Причина", Ложь, "", "");

	Если ТипЗнч(ApprovalId) <> Тип("Строка") Или ПустаяСтрока(ApprovalId) Тогда
		Результат.Причина = "approval_id_required";
		Возврат Результат;
	КонецЕсли;

	// 1. Читаем запись очереди (RunId / Sequence / ActionPayloadJSON / СозданоВ).
	ДанныеЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьЗаписьОчередиПривилегированно(ApprovalId);
	Если ДанныеЗаписи = Неопределено Тогда
		Результат.Причина = "record_not_found";
		Возврат Результат;
	КонецЕсли;

	RunId = ДанныеЗаписи.RunId;
	TTLЧасов = ar_Константы.ApprovalExpirationЧасов();

	// 2. Защитный барьер TTL: истекло, только если прошло >= TTL часов.
	Если Не ДанныеЗаписи.Свойство("СозданоВ")
		Или ТипЗнч(ДанныеЗаписи.СозданоВ) <> Тип("Дата")
		Или (ТекущаяДатаСеанса() - ДанныеЗаписи.СозданоВ) < TTLЧасов * 3600 Тогда
		Результат.Причина = "not_expired_yet";
		Возврат Результат;
	КонецЕсли;

	ОбоснованиеИстечения = СтрШаблон(
		НСтр("ru = 'истекло через %1 ч.';
			|en = 'expired after %1 hours'"),
		Формат(TTLЧасов, "ЧГ=0"));

	// 3. Перевод pending → expired (с блокировкой и защитой от гонки внутри).
	//    Обоснование пишется в ar_ОбоснованиеLLM через РезультатJSON.
	//    РешилПользователь не передаём - остаётся пустой ссылкой (системное действие).
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ОжидаемыйСтатус", "pending");
	ДопПараметры.Вставить("РезультатJSON", ОбоснованиеИстечения);

	Если Не ОбновитьЗаписьApproval(ApprovalId, "expired", ДопПараметры) Тогда
		// Запись могла быть уже не в pending (оператор успел принять/отклонить)
		// либо исчезла - уточняем статус для диагностики.
		ТекущийСтатус = ar_AuditЗащищённыйРежим.СтатусЗаписиОчередиПривилегированно(ApprovalId);
		Если ПустаяСтрока(ТекущийСтатус) Тогда
			Результат.Причина = "record_not_found";
		Иначе
			Результат.Причина = "status_mismatch: " + ТекущийСтатус;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// 4. Фиксируем событие Expired (ar_AuditСобытия не пробрасывает исключений).
	ЗафиксироватьСобытиеИстекло(RunId, ApprovalId, TTLЧасов);

	// 5. Извлекаем tool_call_id и формируем expired-observation для LLM.
	//    Observation - протокольная строка для LLM (не UI), поэтому без НСтр и
	//    всегда на английском, симметрично rejection-observation в Отклонить.
	ToolCallId = ToolCallIdИзPayload(ДанныеЗаписи.ActionPayloadJSON);
	ТекстObservation = "approval expired after " + Формат(TTLЧасов, "ЧГ=0") + " hours";

	// 6. Немедленное возобновление с expired-контекстом (Вариант A APPR-04,
	//    симметрично Отклонить). Запись очереди уже в expired - это верно.
	//    Если запуск уже в финальном статусе, Возобновить вернёт ошибку - это
	//    штатно: запись обновлена корректно, логируем предупреждение и считаем
	//    истечение успешным (см. APPR-04 граничный случай D10).
	КонтекстExpired = Новый Структура;
	КонтекстExpired.Вставить("ToolCallId", ToolCallId);
	КонтекстExpired.Вставить("ТекстObservation", ТекстObservation);

	РезультатВозобновления = ar_RuntimeЗапуск.Возобновить(RunId, КонтекстExpired);
	Если Не РезультатВозобновления.Успех Тогда
		Если ВозобновлениеНевозможноИзЗаФинальногоСтатуса(РезультатВозобновления.Причина) Тогда
			// Запуск уже completed/failed - истечение записи очереди корректно,
			// возобновлять нечего. Это успех, не ошибка.
			ЗаписатьПредупреждение(СтрШаблон(
				НСтр("ru = 'APPR-04: запуск %1 не возобновлён после истечения (%2) - запуск в финальном статусе';
					|en = 'APPR-04: run %1 not resumed after expiration (%2) - run is final'"),
				RunId, РезультатВозобновления.Причина));
			Результат.Успех = Истина;
			Результат.RunId = RunId;
			Возврат Результат;
		КонецЕсли;
		// Временная ошибка возобновления (например, already_running): запись очереди
		// уже expired (откатить нельзя) - логируем и сообщаем вызывающему об ошибке.
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-04: не удалось возобновить запуск %1 после истечения: %2';
				|en = 'APPR-04: failed to resume run %1 after expiration: %2'"),
			RunId, РезультатВозобновления.Причина));
		Результат.Причина = "resume_failed: " + РезультатВозобновления.Причина;
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.RunId = RunId;
	Возврат Результат;

КонецФункции

// Найти все pending-записи очереди approval, у которых истёк TTL (APPR-04).
// Возвращает Массив из Строка - ApprovalId записей со статусом "pending", у которых
// ar_СозданоВ + ApprovalExpirationЧасов * 3600 < ТекущаяДатаСеанса(). Массив может
// быть пустым. Чтение под точечным привилегированным режимом (регистр служебный).
//
// Используется регламентным заданием (SCHED-03 / будущее ar_ОчисткаApproval):
//   ПросроченныеId = ar_Approval.НайтиПросроченныеApproval();
//   Для Каждого ApprovalId Из ПросроченныеId Цикл
//       ar_Approval.Истечь(ApprovalId);
//   КонецЦикла;
//
// Внутренний лимит ПЕРВЫЕ 100 защищает РЗ от зависания при большом числе
// накопившихся записей (APPR-04 R3) - следующая порция уйдёт в следующем цикле.
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если просроченных нет.
//
Функция НайтиПросроченныеApproval() Экспорт

	ГраницаСоздания = ТекущаяДатаСеанса() - ar_Константы.ApprovalExpirationЧасов() * 3600;
	// Подъём привилегий для чтения служебного регистра инкапсулирован в фасаде.
	Возврат ar_AuditЗащищённыйРежим.НайтиПросроченныеApprovalПривилегированно(ГраницаСоздания);

КонецФункции

// Найти одобренные оператором записи очереди approval, ожидающие возобновления (SCHED-03).
// Возвращает Массив из Строка - ApprovalId записей со статусом "approved", упорядоченных
// по ar_СозданоВ (FIFO). Массив может быть пустым. Чтение под точечным привилегированным
// режимом (регистр служебный) инкапсулировано в фасаде ar_AuditЗащищённыйРежим.
//
// Используется регламентным заданием ar_ВозобновлениеПослеApproval (SCHED-03):
//   ОдобренныеId = ar_Approval.НайтиОдобренныеApproval();
//   Для Каждого ApprovalId Из ОдобренныеId Цикл
//       // прочитать RunId и вызвать ar_RuntimeЗапуск.Возобновить(RunId)
//   КонецЦикла;
//
// Запись переводится в "approved" методом Принять, который намеренно НЕ запускает
// возобновление - его выполняет регламентное задание через этот метод.
//
// Внутренний лимит ПЕРВЫЕ 50 защищает тик регламентного задания от зависания при
// большом числе накопившихся записей (например, после batch-апрувинга оператором) -
// следующая порция уйдёт в следующем цикле.
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если одобренных нет.
//
Функция НайтиОдобренныеApproval() Экспорт

	// Подъём привилегий для чтения служебного регистра инкапсулирован в фасаде.
	Возврат ar_AuditЗащищённыйРежим.НайтиОдобренныеApprovalПривилегированно();

КонецФункции

// Найти записи очереди с ответом оператора на вопрос ask_user (TOOL-19 D8).
// Возвращает Массив из Строка - ApprovalId записей со статусом "answered",
// упорядоченных по ar_СозданоВ (FIFO). Массив может быть пустым.
//
// Используется регламентным заданием ar_ВозобновлениеПослеApproval (SCHED-03):
//   ОтвеченныеId = ar_Approval.НайтиОтвеченныеApproval();
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если отвеченных нет.
//
Функция НайтиОтвеченныеApproval() Экспорт

	Возврат ar_AuditЗащищённыйРежим.НайтиОтвеченныеApprovalПривилегированно();

КонецФункции

// Зафиксировать ответ оператора на вопрос ask_user (TOOL-19 D7).
// Переводит запись из "awaiting_input" в "answered" и сохраняет UserAnswer.
// Подъём привилегий инкапсулирован в ar_AuditЗащищённыйРежим.
//
// Параметры:
//  ApprovalId   - Строка                       - UUID записи очереди.
//  Пользователь - СправочникСсылка.Пользователи - кто дал ответ.
//  Ответ        - Строка                       - текст ответа оператора.
//
// Возвращаемое значение:
//  Булево - Истина при успехе; Ложь если запись не найдена или имеет неверный статус.
//
Функция ОтветитьНаВопрос(Знач ApprovalId, Знач Пользователь, Знач Ответ) Экспорт

	Возврат ar_AuditЗащищённыйРежим.ОтветитьНаВопросПривилегированно(
		ApprovalId, Пользователь, Ответ);

КонецФункции

// Найти просроченные pending/awaiting_input-записи очереди (без переключения привилегий).
// Вызывается из ar_AuditЗащищённыйРежим под уже поднятыми привилегиями (AUD-04).
// Покрывает оба статуса: "pending" (APPR-04) и "awaiting_input" (TOOL-19 D16).
//
// Параметры:
//  ГраницаСоздания - Дата - записи старше этой границы считаются просроченными.
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если просроченных нет.
//
Функция НайтиПросроченныеApprovalБезПривилегий(Знач ГраницаСоздания) Экспорт

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Очередь.ar_ApprovalId КАК ApprovalId
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	(Очередь.ar_Статус = &СтатусPending
		|		ИЛИ Очередь.ar_Статус = &СтатусAwaitingInput)
		|	И Очередь.ar_СозданоВ < &ГраницаСоздания
		|УПОРЯДОЧИТЬ ПО
		|	Очередь.ar_СозданоВ";
	Запрос.УстановитьПараметр("СтатусPending",      "pending");
	Запрос.УстановитьПараметр("СтатусAwaitingInput", "awaiting_input");
	Запрос.УстановитьПараметр("ГраницаСоздания",    ГраницаСоздания);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(СокрЛП(Выборка.ApprovalId));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Найти одобренные записи очереди (без переключения привилегий).
// Вызывается из ar_AuditЗащищённыйРежим под уже поднятыми привилегиями (AUD-04).
// Возвращает ПЕРВЫЕ 50 ApprovalId со статусом "approved", упорядоченных по
// ar_СозданоВ (FIFO).
//
// Возвращаемое значение:
//  Массив - элементы типа Строка (ApprovalId). Пустой, если одобренных нет.
//
Функция НайтиОдобренныеApprovalБезПривилегий() Экспорт

