КонецФункции

// Перевести запись очереди approval в новый статус (executed/rejected/expired).
// Служебная процедура для APPR-02..04 и DISP-04. Поднимает привилегии точечно.
//
// Параметры:
//  ApprovalId    - Строка - идентификатор записи очереди (измерение ar_ApprovalId).
//  НовыйСтатус   - Строка - целевой статус ("executed"/"rejected"/"expired"/...).
//  ДопПараметры  - Структура - опционально:
//                  {РешилПользователь - СправочникСсылка.Пользователи,
//                   РезультатJSON - Строка (пишется в ar_ОбоснованиеLLM),
//                   ОжидаемыйСтатус - Строка (запись переводится только из него)}.
//
// Возвращаемое значение:
//  Булево - Истина при успешном переводе; Ложь при пустых параметрах, отсутствии
//           записи, несовпадении ожидаемого статуса или ошибке. Не пробрасывает.
//
Функция ОбновитьЗаписьApproval(Знач ApprovalId, Знач НовыйСтатус, Знач ДопПараметры = Неопределено) Экспорт

	Если ТипЗнч(ApprovalId) <> Тип("Строка") Или ПустаяСтрока(ApprovalId)
		Или ТипЗнч(НовыйСтатус) <> Тип("Строка") Или ПустаяСтрока(НовыйСтатус) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Подъём привилегий для записи в служебный регистр инкапсулирован в фасаде
	// (AUD-04); фактическая транзакционная логика - в ...БезПривилегий ниже.
	ИтогОперации = ar_AuditЗащищённыйРежим.ОбновитьЗаписьОчередиПривилегированно(
		ApprovalId, НовыйСтатус, ДопПараметры);

	Если Не ИтогОперации.Успех Тогда
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-01: не удалось обновить запись approval %1 → %2: %3';
				|en = 'APPR-01: failed to update approval %1 → %2: %3'"),
			ApprovalId, НовыйСтатус, ИтогОперации.Причина));
	КонецЕсли;

	Возврат ИтогОперации.Успех;

КонецФункции

// Обновить запись очереди approval (без переключения привилегий). Вызывается из
// ar_AuditЗащищённыйРежим под уже поднятыми привилегиями (AUD-04). Не пробрасывает
// исключений: ошибка возвращается в поле Причина структуры результата.
//
// Параметры:
//  ApprovalId   - Строка    - идентификатор записи очереди.
//  НовыйСтатус  - Строка    - целевой статус.
//  ДопПараметры - Структура, Неопределено - {РешилПользователь, РезультатJSON,
//                 ОжидаемыйСтатус}.
//
// Возвращаемое значение:
//  Структура - {Успех: Булево, Причина: Строка}.
//
Функция ОбновитьЗаписьApprovalБезПривилегий(Знач ApprovalId, Знач НовыйСтатус,
		Знач ДопПараметры = Неопределено) Экспорт

	Итог = Новый Структура("Успех, Причина", Ложь, "");

	Параметры = ?(ТипЗнч(ДопПараметры) = Тип("Структура"), ДопПараметры, Новый Структура);
	ОжидаемыйСтатус = "";
	Параметры.Свойство("ОжидаемыйСтатус", ОжидаемыйСтатус);
	РешилПользователь = Неопределено;
	Параметры.Свойство("РешилПользователь", РешилПользователь);
	РезультатJSON = "";
	Параметры.Свойство("РезультатJSON", РезультатJSON);

	Попытка
		НачатьТранзакцию();
		Попытка

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_ОчередьApproval");
			ЭлементБлокировки.УстановитьЗначение("ar_ApprovalId", ApprovalId);
			Блокировка.Заблокировать();

			МенеджерЗаписи = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ar_ApprovalId = ApprovalId;
			МенеджерЗаписи.Прочитать();

			Если Не МенеджерЗаписи.Выбран() Тогда
				Итог.Причина = "record_not_found";
			ИначеЕсли Не ПустаяСтрока(ОжидаемыйСтатус)
				И СокрЛП(МенеджерЗаписи.ar_Статус) <> ОжидаемыйСтатус Тогда
				Итог.Причина = "status_mismatch";
			Иначе
				МенеджерЗаписи.ar_Статус = НовыйСтатус;
				МенеджерЗаписи.ar_РешеноВ = ТекущаяДатаСеанса();
				Если ТипЗнч(РешилПользователь) = Тип("СправочникСсылка.Пользователи") Тогда
					МенеджерЗаписи.ar_РешилПользователь = РешилПользователь;
				КонецЕсли;
				Если ТипЗнч(РезультатJSON) = Тип("Строка") И Не ПустаяСтрока(РезультатJSON) Тогда
					МенеджерЗаписи.ar_ОбоснованиеLLM = РезультатJSON;
				КонецЕсли;
				МенеджерЗаписи.Записать();
				Итог.Успех = Истина;
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		Итог.Успех = Ложь;
		Итог.Причина = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Пометить запись очереди approval как выполненную (executed) после успешного
// выполнения commit-tool (DISP-04). Перенесено из ar_ToolDispatcher: теперь
// привилегированная запись инкапсулирована в приватизированном модуле approval.
//
// Ищет запись со статусом "approved" по ключу идемпотентности, переводит её в
// "executed", фиксирует ar_РешеноВ и (если передан) РезультатJSON в
// ar_ОбоснованиеLLM (поле неогр. длины - итог выполнения, см. DISP-04 R1).
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности (RunId + "_" + Sequence).
//  РезультатJSON  - Строка - JSON-результат выполнения tool для кэширования.
//
// Возвращаемое значение:
//  Булево - Истина при переводе в executed; Ложь при пустом ключе, отсутствии
//           approved-записи или ошибке. Исключений не выбрасывает.
//
Функция ПометитьApprovalВыполненным(Знач IdempotencyKey, Знач РезультатJSON = "") Экспорт

	Если ТипЗнч(IdempotencyKey) <> Тип("Строка") Или ПустаяСтрока(IdempotencyKey) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ApprovalId = ar_AuditЗащищённыйРежим.ApprovalIdПоКлючуПривилегированно(
			IdempotencyKey, "approved");
	Исключение
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-01: ошибка поиска approved-записи (ключ %1): %2';
				|en = 'APPR-01: failed to find approved record (key %1): %2'"),
			IdempotencyKey, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;

	Если ПустаяСтрока(ApprovalId) Тогда
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-01: нет approved-записи для ключа %1';
				|en = 'APPR-01: no approved record for key %1'"),
			IdempotencyKey));
		Возврат Ложь;
	КонецЕсли;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ОжидаемыйСтатус", "approved");
	ДопПараметры.Вставить("РезультатJSON", РезультатJSON);
	Возврат ОбновитьЗаписьApproval(ApprovalId, "executed", ДопПараметры);

КонецФункции

// Найти кэшированный результат предыдущего исполнения commit-tool (DISP-04).
// Перенесено из ar_ToolDispatcher.
//
// Ищет запись по ar_IdempotencyKey со статусом "executed". Если найдена -
// действие уже исполнено: возвращается сохранённый результат (ar_ОбоснованиеLLM)
// как строка-observation; при пустом - "{}". Если записи нет - Неопределено
// (выполнение штатное). Чтение под привилегированным режимом (регистр недоступен
// в правах пользователя).
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности.
//
// Возвращаемое значение:
//  Неопределено - нет executed-записи; Строка - кэшированный JSON-результат.
//
Функция НайтиПредыдущийРезультат(Знач IdempotencyKey) Экспорт

	Если ТипЗнч(IdempotencyKey) <> Тип("Строка") Или ПустаяСтрока(IdempotencyKey) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Чтение служебного регистра под привилегиями инкапсулировано в фасаде (AUD-04).
	Возврат ar_AuditЗащищённыйРежим.НайтиПредыдущийРезультатПривилегированно(IdempotencyKey);

КонецФункции

// Найти кэшированный результат предыдущего исполнения commit-tool (без
// переключения привилегий). Вызывается из ar_AuditЗащищённыйРежим под уже
// поднятыми привилегиями (AUD-04).
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности (непустой, проверен вызывающим).
//
// Возвращаемое значение:
//  Неопределено - нет executed-записи; Строка - кэшированный JSON-результат ("{}",
//  если поле пустое).
//
Функция НайтиПредыдущийРезультатБезПривилегий(Знач IdempotencyKey) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.ar_ОбоснованиеLLM КАК Результат
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_IdempotencyKey = &Ключ
		|	И Очередь.ar_Статус = &Статус";
	Запрос.УстановитьПараметр("Ключ", IdempotencyKey);
	Запрос.УстановитьПараметр("Статус", "executed");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кэш = Выборка.Результат;
	Возврат ?(ТипЗнч(Кэш) = Тип("Строка") И Не ПустаяСтрока(Кэш), Кэш, "{}");

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Записать запись очереди (pending) и перевести запуск в паузу в одной транзакции.
// Вызывается из ar_AuditЗащищённыйРежим под уже поднятым привилегированным режимом
// (AUD-04). Сам режим не переключает.
//
// Параметры:
//  ApprovalId        - Строка - идентификатор записи очереди (UUID).
//  RunId             - Строка - идентификатор запуска (UUID).
//  Sequence          - Число  - порядковый номер действия.
//  ActionPayloadJSON - Строка - сериализованное действие.
//  Обоснование       - Строка - обоснование LLM.
//  IdempotencyKey    - Строка - ключ идемпотентности.
//
Процедура ЗаписатьЗаписьОчередиИПаузу(Знач ApprovalId, Знач RunId, Знач Sequence,
		Знач ActionPayloadJSON, Знач Обоснование, Знач IdempotencyKey) Экспорт

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;

		ЭлементОчереди = Блокировка.Добавить("РегистрСведений.ar_ОчередьApproval");
		ЭлементОчереди.УстановитьЗначение("ar_ApprovalId", ApprovalId);

		ЭлементЗапуска = Блокировка.Добавить("РегистрСведений.ar_Запуски");
		ЭлементЗапуска.УстановитьЗначение("ar_RunId", RunId);

		Блокировка.Заблокировать();

		// 1. Запись очереди approval.
		ЗаписьОчереди = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
		ЗаписьОчереди.ar_ApprovalId           = ApprovalId;
		ЗаписьОчереди.ar_RunId                 = RunId;
		ЗаписьОчереди.ar_Sequence              = Sequence;
		ЗаписьОчереди.ar_ActionPayloadJSON     = ActionPayloadJSON;
		ЗаписьОчереди.ar_Статус                = "pending";
		ЗаписьОчереди.ar_ОбоснованиеLLM        = ?(ТипЗнч(Обоснование) = Тип("Строка"), Обоснование, "");
		ЗаписьОчереди.ar_СозданоВ              = ТекущаяДатаСеанса();
		ЗаписьОчереди.ar_IdempotencyKey        = ?(ТипЗнч(IdempotencyKey) = Тип("Строка"), IdempotencyKey, "");
		ЗаписьОчереди.Записать();

		// 2. Перевод запуска в paused_for_approval.
		ЗаписьЗапуска = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
		ЗаписьЗапуска.ar_RunId = RunId;
		ЗаписьЗапуска.Прочитать();
		Если Не ЗаписьЗапуска.Выбран() Тогда
			ЗаписьЗапуска.ar_RunId = RunId;
		КонецЕсли;
		ЗаписьЗапуска.ar_Статус = Перечисления.ar_СтатусЗапуска.PausedForApproval;
		ЗаписьЗапуска.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Записать запись очереди (awaiting_input) и перевести запуск в PausedForInput
// в одной транзакции (TOOL-19 D5). Зеркало ЗаписатьЗаписьОчередиИПаузу для ask_user.
// Вызывается из ar_AuditЗащищённыйРежим под уже поднятым привилегированным режимом.
//
// Параметры:
//  ApprovalId        - Строка - идентификатор записи очереди (UUID).
//  RunId             - Строка - идентификатор запуска (UUID).
//  Sequence          - Число  - порядковый номер шага.
//  ActionPayloadJSON - Строка - сериализованный payload с ask_user:true.
//
Процедура ЗаписатьВопросВОчередьИПаузуБезПривилегий(Знач ApprovalId, Знач RunId,
		Знач Sequence, Знач ActionPayloadJSON) Экспорт

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;

		ЭлементОчереди = Блокировка.Добавить("РегистрСведений.ar_ОчередьApproval");
		ЭлементОчереди.УстановитьЗначение("ar_ApprovalId", ApprovalId);

		ЭлементЗапуска = Блокировка.Добавить("РегистрСведений.ar_Запуски");
		ЭлементЗапуска.УстановитьЗначение("ar_RunId", RunId);

		Блокировка.Заблокировать();

		// 1. Запись очереди со статусом "awaiting_input".
		ЗаписьОчереди = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
		ЗаписьОчереди.ar_ApprovalId       = ApprovalId;
		ЗаписьОчереди.ar_RunId            = RunId;
		ЗаписьОчереди.ar_Sequence         = Sequence;
		ЗаписьОчереди.ar_ActionPayloadJSON = ActionPayloadJSON;
		ЗаписьОчереди.ar_Статус           = "awaiting_input";
		ЗаписьОчереди.ar_ОбоснованиеLLM   = "";
		ЗаписьОчереди.ar_СозданоВ         = ТекущаяДатаСеанса();
		ЗаписьОчереди.ar_IdempotencyKey   = "";
		ЗаписьОчереди.Записать();

		// 2. Перевод запуска в PausedForInput.
		ЗаписьЗапуска = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
		ЗаписьЗапуска.ar_RunId = RunId;
		ЗаписьЗапуска.Прочитать();
		Если Не ЗаписьЗапуска.Выбран() Тогда
			ЗаписьЗапуска.ar_RunId = RunId;
		КонецЕсли;
		ЗаписьЗапуска.ar_Статус = Перечисления.ar_СтатусЗапуска.PausedForInput;
		ЗаписьЗапуска.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Зафиксировать ответ оператора на вопрос ask_user (без переключения привилегий).
// Переводит запись из "awaiting_input" в "answered", сохраняет UserAnswer в payload.
// Вызывается из ar_AuditЗащищённыйРежим под уже поднятыми привилегиями.
//
// Параметры:
//  ApprovalId   - Строка                       - идентификатор записи очереди (UUID).
//  Пользователь - СправочникСсылка.Пользователи - кто дал ответ.
//  Ответ        - Строка                       - текст ответа оператора.
//
// Возвращаемое значение:
//  Булево - Истина при успехе; Ложь если запись не найдена или уже не awaiting_input.
//
Функция ОтветитьНаВопросБезПривилегий(Знач ApprovalId, Знач Пользователь,
		Знач Ответ) Экспорт

	// Предварительная проверка без транзакции: существование и статус записи.
	// Это позволяет избежать ОтменитьТранзакцию() внутри блока Попытка,
	// что нарушало бы std783 (ОтменитьТранзакцию должен быть первым в Исключение).
	МенеджерПроверки = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	МенеджерПроверки.ar_ApprovalId = ApprovalId;
	МенеджерПроверки.Прочитать();
	Если Не МенеджерПроверки.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СокрЛП(МенеджерПроверки.ar_Статус) <> "awaiting_input" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Флаг результата: используем вместо промежуточных Возврат внутри Попытка,
	// т.к. std783 запрещает Возврат из блока Попытка при открытой транзакции.
	РезультатОтвета = Ложь;

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементОчереди = Блокировка.Добавить("РегистрСведений.ar_ОчередьApproval");
		ЭлементОчереди.УстановитьЗначение("ar_ApprovalId", ApprovalId);
		Блокировка.Заблокировать();

		// Перечитываем под блокировкой, чтобы получить актуальные данные.
		МенеджерЗаписи = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_ApprovalId = ApprovalId;
		МенеджерЗаписи.Прочитать();

		// Повторная проверка под блокировкой (защита от гонки).
		// Если запись не найдена или уже не awaiting_input - фиксируем без изменений.
		Если МенеджерЗаписи.Выбран()
			И СокрЛП(МенеджерЗаписи.ar_Статус) = "awaiting_input" Тогда

			// Обновляем payload: вписываем user_answer (маскировка секретов R5).
			PayloadJSON = МенеджерЗаписи.ar_ActionPayloadJSON;
			Payload = Неопределено;
			Попытка
				Payload = ar_JSON.ИзJSON(PayloadJSON);
			Исключение
				// Если JSON не распарсился - создаём минимальную структуру.
				Payload = Неопределено;
			КонецПопытки;

			ОтветМаск = ar_Утилиты.МаскироватьСекреты(Ответ);

			Если ТипЗнч(Payload) = Тип("Соответствие")
				Или ТипЗнч(Payload) = Тип("Структура") Тогда
				Payload.Вставить("user_answer", ОтветМаск);
			Иначе
				Payload = Новый Структура;
				Payload.Вставить("ask_user",    Истина);
				Payload.Вставить("user_answer", ОтветМаск);
			КонецЕсли;

			МенеджерЗаписи.ar_ActionPayloadJSON = ar_JSON.ВЗначениеJSON(Payload);
			МенеджерЗаписи.ar_Статус           = "answered";
			Если ЗначениеЗаполнено(Пользователь) Тогда
				МенеджерЗаписи.ar_РешилПользователь = Пользователь;
			КонецЕсли;
			МенеджерЗаписи.Записать(Истина);

			РезультатОтвета = Истина;

		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат РезультатОтвета;

КонецФункции

// Прочитать запись очереди approval (без переключения привилегий). Вызывается из
// ar_AuditЗащищённыйРежим под уже поднятыми привилегиями (AUD-04).
//
// Параметры:
//  ApprovalId - Строка - идентификатор записи очереди (UUID).
//
// Возвращаемое значение:
//  Структура, Неопределено - {RunId, Sequence, ActionPayloadJSON, СозданоВ,
//  Статус} или Неопределено, если запись не найдена.
//
Функция ПрочитатьЗаписьОчередиБезПривилегий(Знач ApprovalId) Экспорт

	МенеджерЗаписи = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_ApprovalId = ApprovalId;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("RunId", СокрЛП(МенеджерЗаписи.ar_RunId));
	Данные.Вставить("Sequence", МенеджерЗаписи.ar_Sequence);
	Данные.Вставить("ActionPayloadJSON", МенеджерЗаписи.ar_ActionPayloadJSON);
	Данные.Вставить("СозданоВ", МенеджерЗаписи.ar_СозданоВ);
	Данные.Вставить("Статус", СокрЛП(МенеджерЗаписи.ar_Статус));

	Возврат Данные;

КонецФункции

// Текущий статус записи очереди approval (без переключения привилегий).
// Вызывается из ar_AuditЗащищённыйРежим под уже поднятыми привилегиями (AUD-04).
//
// Параметры:
//  ApprovalId - Строка - идентификатор записи очереди (UUID).
//
// Возвращаемое значение:
//  Строка - статус записи или "", если не найдена.
//
Функция СтатусЗаписиОчередиБезПривилегий(Знач ApprovalId) Экспорт

	МенеджерЗаписи = РегистрыСведений.ar_ОчередьApproval.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_ApprovalId = ApprovalId;
	МенеджерЗаписи.Прочитать();
	Возврат ?(МенеджерЗаписи.Выбран(), СокрЛП(МенеджерЗаписи.ar_Статус), "");

КонецФункции

// Статус запуска из ar_Запуски (без переключения привилегий). Вызывается из
// ar_AuditЗащищённыйРежим под уже поднятыми привилегиями (AUD-04).
//
// Параметры:
//  RunId - Строка - идентификатор запуска (UUID).
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ar_СтатусЗапуска, Неопределено - статус запуска или
//  Неопределено, если запись не найдена.
//
Функция СтатусЗапускаБезПривилегий(Знач RunId) Экспорт

	МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_RunId = RunId;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат МенеджерЗаписи.ar_Статус;

КонецФункции

// Найти ar_ApprovalId записи очереди по ключу и статусу (без переключения
// привилегий). Вызывается из ar_AuditЗащищённыйРежим под уже поднятыми
// привилегиями (AUD-04). Возвращает "", если не найдена.
//
// Параметры:
//  IdempotencyKey - Строка - ключ идемпотентности.
//  Статус         - Строка - статус записи для поиска.
//
// Возвращаемое значение:
//  Строка - найденный ApprovalId или "".
//
Функция ApprovalIdПоКлючу(Знач IdempotencyKey, Знач Статус) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Очередь.ar_ApprovalId КАК ApprovalId
		|ИЗ
		|	РегистрСведений.ar_ОчередьApproval КАК Очередь
		|ГДЕ
		|	Очередь.ar_IdempotencyKey = &Ключ
		|	И Очередь.ar_Статус = &Статус";
	Запрос.УстановитьПараметр("Ключ", IdempotencyKey);
	Запрос.УстановитьПараметр("Статус", Статус);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ApprovalId);
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// UNIV-06 / RECON-01: исполняет approved-действие - вызывает исполнителя,
// который создаёт и записывает объект по сохранённому payload.
//
// Маршрутизация по tool_name (двухуровневое ветвление, БЕЗ Выполнить()/
// Вычислить() - Plan §1.3): tool_name читается из ActionPayloadJSON ДО
// вызова конкретного исполнителя (см. ИмяДействияИзJSON ниже), затем
// делегируется в exports-функцию соответствующего tool-модуля. Неизвестный
// tool_name - штатный no-op "no_executor_for_action:<имя>", без исключения
// (тот же контракт, что был раньше зашит внутрь ar_ToolДокументы.
// ИсполнитьСоздатьЧерновикСчёта - см. .docs/specs/UNIV-06.md, решение Р1).
// RECON-01 обобщает диспетчер минимально - добавлением второй ветви
// (prepare_reconciliation_email -> ar_ToolКоммуникации.ИсполнитьПодготовкуПисьма),
// не строя отдельный регистр action->исполнитель (см. .docs/specs/RECON-01.md,
// §«Правила проекта»).
//
// Исключение исполнителя НЕ пробрасывается: approve уже состоялся (статус
// approved проставлен, аудит записан) и не должен откатываться из-за сбоя записи
// документа. Диагностика уходит в ar_СлужебныйЛог.
//
// Параметры:
//  ApprovalId   - Строка - идентификатор записи очереди (для лога).
//  ДанныеЗаписи - Структура - {RunId, Sequence, ActionPayloadJSON, СозданоВ, Статус},
//                 см. ПрочитатьЗаписьОчередиБезПривилегий.
//
//
// Возвращаемое значение:
//  Структура - {Выполнено: Булево, Сообщение: Строка, DocumentRef: ЛюбаяСсылка/
//               Неопределено} - итог ИСПОЛНЕНИЯ (не решения оператора).
Функция ИсполнитьApprovedДействие(Знач ApprovalId, Знач ДанныеЗаписи)

	Итог = Новый Структура("Выполнено, Сообщение, DocumentRef", Ложь, "", Неопределено);

	ActionPayloadJSON = "";
	Если Не ДанныеЗаписи.Свойство("ActionPayloadJSON", ActionPayloadJSON)
		Или ПустаяСтрока(ActionPayloadJSON) Тогда
		Итог.Сообщение = "empty_action_payload";
		Возврат Итог;
	КонецЕсли;

	ToolName = ИмяДействияИзJSON(ActionPayloadJSON);

	Попытка
		Если ToolName = "prepare_reconciliation_email" Тогда
			РезультатИсполнения = ar_ToolКоммуникации.ИсполнитьПодготовкуПисьма(
				ApprovalId, ActionPayloadJSON);
		ИначеЕсли ToolName = "prepare_payment_reminder_email" Тогда
			РезультатИсполнения = ar_ToolКоммуникации.ИсполнитьПодготовкуПисьмаНапоминания(
				ApprovalId, ActionPayloadJSON);
		ИначеЕсли ToolName = "set_setting" Тогда
			РезультатИсполнения = ar_ToolПамять.ИсполнитьУстановкуНастройки(
				ApprovalId, ActionPayloadJSON);
		ИначеЕсли ToolName = "create_reconciliation_act" Тогда
			РезультатИсполнения = ar_ToolДокументы.ИсполнитьСоздатьАктСверки(
				ApprovalId, ActionPayloadJSON);
		Иначе
			// create_invoice_draft и прочие (fallback) - исполнитель сам
			// фильтрует по tool_name и возвращает no-op для незнакомых
			// значений (см. ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта).
			РезультатИсполнения = ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта(
				ApprovalId, ActionPayloadJSON);
		КонецЕсли;
	Исключение
		ar_СлужебныйЛог.Записать("ar_Approval.ИсполнитьApprovedДействие",
			"execute_failed",
			"ApprovalId=" + ApprovalId + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Итог.Сообщение = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	// Исполнитель сам пишет в служебный лог свои успех/отказ; здесь фиксируем
	// только то, чего он не знает - что действие пришло именно из approve-пути.
	Если Не РезультатИсполнения.Выполнено
		И РезультатИсполнения.Сообщения.Количество() > 0 Тогда
		ar_СлужебныйЛог.Записать("ar_Approval.ИсполнитьApprovedДействие",
			"not_executed",
			"ApprovalId=" + ApprovalId + ": "
				+ СтрСоединить(РезультатИсполнения.Сообщения, "; "), "Информация");
	КонецЕсли;

	Итог.Выполнено = РезультатИсполнения.Выполнено;
	Итог.Сообщение = СтрСоединить(РезультатИсполнения.Сообщения, "; ");
	Если РезультатИсполнения.Свойство("DocumentRef") Тогда
		Итог.DocumentRef = РезультатИсполнения.DocumentRef;
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Формирует observation с фактическим итогом исполнения approved-действия -
// структуру того же формата, что КонтекстОтклонения в Отклонить
// ({ToolCallId, ТекстObservation}), пригодную для передачи в
// ar_RuntimeЗапуск.Возобновить.
//
// Зачем: при resume после approve в историю попадает наблюдение
// "queued for approval", сформированное ДО паузы. Если исполнитель не
// отработал (no_executor_for_action, ошибка записи), LLM об этом не узнаёт и
// сообщает пользователю об успешно созданном документе. Здесь наблюдение
// заменяется на реальный результат.
//
// Параметры:
//  ДанныеЗаписи   - Структура - см. ПрочитатьЗаписьОчередиБезПривилегий.
//  ИтогИсполнения - Структура - см. ИсполнитьApprovedДействие.
//
// Возвращаемое значение:
//  Структура - {ToolCallId: Строка, ТекстObservation: Строка}.
//
Функция НаблюдениеИтогаИсполнения(Знач ДанныеЗаписи, Знач ИтогИсполнения)

	ActionPayloadJSON = "";
	ДанныеЗаписи.Свойство("ActionPayloadJSON", ActionPayloadJSON);

	Сообщение = СокрЛП(Строка(ИтогИсполнения.Сообщение));

	Если ИтогИсполнения.Выполнено Тогда
		ТекстObservation = "approved and executed by operator";
		Если Не ПустаяСтрока(Сообщение) Тогда
			ТекстObservation = ТекстObservation + ": " + Сообщение;
		КонецЕсли;
		Если ИтогИсполнения.DocumentRef <> Неопределено Тогда
			ТекстObservation = ТекстObservation + " (document_ref="
				+ ar_Утилиты.НавигационнаяСсылкаОбъекта(ИтогИсполнения.DocumentRef) + ")";
		КонецЕсли;
	Иначе
		// Явно называем провал исполнения, чтобы LLM не выдала действие за
		// успешное: approve состоялся, но документ НЕ создан.
		ТекстObservation = "approved by operator, but action was NOT executed";
		Если Не ПустаяСтрока(Сообщение) Тогда
			ТекстObservation = ТекстObservation + ": " + Сообщение;
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ToolCallId", ToolCallIdИзPayload(ActionPayloadJSON));
	Результат.Вставить("ТекстObservation", ТекстObservation);
	Возврат Результат;

КонецФункции

// RECON-01: читает поле tool_name из ActionPayloadJSON без разбора остального
// содержимого - используется ИсполнитьApprovedДействие ДО вызова конкретного
// исполнителя, чтобы выбрать нужную ветвь. Не бросает исключений (fail-safe
// маршрутизация - тот же контракт, что и у остальной части ar_Approval):
// при любой ошибке разбора возвращает "" (маршрутизируется в fallback-ветвь
// create_invoice_draft, которая сама вернёт no_executor_for_action).
//
// Параметры:
//  ActionPayloadJSON - Строка - см. СобратьActionPayloadJSON.
//
// Возвращаемое значение:
//  Строка - значение поля tool_name либо "".
//
Функция ИмяДействияИзJSON(Знач ActionPayloadJSON)

	Попытка
		Разобрано = ar_JSON.ИзJSON(ActionPayloadJSON);
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Разобрано.Получить("tool_name");
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), "");

КонецФункции

// Собрать ActionPayloadJSON: сериализация Действия + метаданные запуска.
// Секреты в итоговом JSON маскируются (ar_Утилиты.МаскироватьСекреты).
//
Функция СобратьActionPayloadJSON(Знач КонтекстЗапуска, Знач Действие, Знач RunId,
		Знач ApprovalId, Знач RiskLevel)

	Payload = Новый Структура;
	Payload.Вставить("approval_id", ApprovalId);
	Payload.Вставить("run_id", RunId);
	Payload.Вставить("agent_name", ИмяАгента(КонтекстЗапуска));
	Payload.Вставить("created_at", ar_Утилиты.ФорматДата(ТекущаяДатаСеанса()));
	Payload.Вставить("tool_name", ИмяДействия(Действие));
	Payload.Вставить("tool_call_id", ЗначениеДействия(Действие, "ИдВызова", ""));
	Payload.Вставить("idempotency_key", ЗначениеДействия(Действие, "IdempotencyKey", ""));
	Если Не ПустаяСтрока(RiskLevel) Тогда
		Payload.Вставить("risk_level", RiskLevel);
	КонецЕсли;
	Обоснование = ЗначениеДействия(Действие, "Обоснование", "");
	Если Не ПустаяСтрока(Обоснование) Тогда
		Payload.Вставить("rationale", Обоснование);
	КонецЕсли;
	Аргументы = АргументыДействия(Действие);
	Payload.Вставить("arguments", Аргументы);

	// Человекочитаемая расшифровка ссылок из аргументов. Оператор в очереди
	// видит только payload, а там ссылки - это GUID-ы: по ним невозможно
	// заметить, что документ создаётся не по тому юрлицу или контрагенту.
	// Реальный случай: акт сверки по Шилову ПБОЮЛ ушёл на основную организацию
	// вместо той, где висит сальдо, и подтвердить это глазами было нельзя.
	Расшифровка = РасшифроватьСсылкиДляОператора(Аргументы);
	Если Расшифровка.Количество() > 0 Тогда
		Payload.Вставить("refs_readable", Расшифровка);
	КонецЕсли;

	JSON = ar_JSON.ВЗначениеJSON(Payload);
	// Барьер: маскируем секреты, если они просочились в аргументы (Bearer/sk-/ya29.).
	Возврат ar_Утилиты.МаскироватьСекреты(JSON);

КонецФункции

// Расшифровка ссылочных аргументов в имена объектов - для показа оператору
// в очереди подтверждений. Берутся все ключи, оканчивающиеся на "_ref": их
// значения (навигационные ссылки/UUID) разыменовываются в представление
// объекта. Неразыменуемые значения пропускаются молча - это подсказка для
// глаз, а не контракт, и падать из-за неё постановка в очередь не должна.
//
// Параметры:
//  Аргументы - Соответствие, Структура, прочее - аргументы действия.
//
// Возвращаемое значение:
//  Соответствие - {"<ключ>": "<представление>"}; пустое, если расшифровывать нечего.
//
Функция РасшифроватьСсылкиДляОператора(Знач Аргументы)

	Результат = Новый Соответствие;

	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КлючЗначение Из Аргументы Цикл

		Ключ = СокрЛП(Строка(КлючЗначение.Ключ));
		Если Не СтрЗаканчиваетсяНа(Ключ, "_ref") Тогда
			Продолжить;
		КонецЕсли;

		СтрокаСсылки = СокрЛП(Строка(КлючЗначение.Значение));
		Если ПустаяСтрока(СтрокаСсылки) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Объект = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
		Исключение
			Объект = Неопределено;
		КонецПопытки;

		Если Объект = Неопределено Или Не ЗначениеЗаполнено(Объект) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Ключ, СокрЛП(Строка(Объект)));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Аргументы действия в сериализуемом виде. JSON-строка десериализуется в
// Соответствие (чтобы попасть в payload объектом, а не экранированной строкой);
// при невалидном JSON остаётся как есть.
//
Функция АргументыДействия(Знач Действие)

	Аргументы = ЗначениеДействияПроизвольное(Действие, "Аргументы");

	Если ТипЗнч(Аргументы) = Тип("Строка") Тогда
		Если ПустаяСтрока(Аргументы) Тогда
			Возврат Новый Структура;
		КонецЕсли;
		Разобрано = ar_JSON.ИзJSON(Аргументы);
		Возврат ?(Разобрано = Неопределено, Аргументы, Разобрано);
	КонецЕсли;

	Возврат ?(Аргументы = Неопределено, Новый Структура, Аргументы);

КонецФункции

// Сохранить StateSnapshot, если КонтекстЗапуска содержит ключ "Состояние".
// Снимок делегируется ar_AuditЗапуски (собственная транзакция, RT-08).
//
Процедура СохранитьСнимокЕслиЕсть(Знач КонтекстЗапуска, Знач RunId)

	Если ТипЗнч(КонтекстЗапуска) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Состояние = Неопределено;
	Если КонтекстЗапуска.Свойство("Состояние", Состояние) И Состояние <> Неопределено Тогда
		ar_AuditЗащищённыйРежим.СохранитьСнимокПривилегированно(RunId, Состояние);
	КонецЕсли;

КонецПроцедуры

// Зафиксировать событие approval_requested (через ar_AuditСобытия, не пробрасывает).
//
Процедура ЗафиксироватьСобытиеЗапрошен(Знач RunId, Знач ApprovalId, Знач ИмяTool, Знач RiskLevel)

	Payload = Новый Структура;
	Payload.Вставить("approval_id", ApprovalId);
	Payload.Вставить("tool_name", ИмяTool);
	Если Не ПустаяСтрока(RiskLevel) Тогда
		Payload.Вставить("risk_level", RiskLevel);
	КонецЕсли;
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "ApprovalRequested", Payload);

КонецПроцедуры

// Обновить запись действия ar_ДействияАгента после approve: проставить
// ApprovedBy / ApprovedAt. ИмяTool и RiskLevel извлекаются из ActionPayloadJSON
// (безопасные дефолты при невалидном/неполном JSON). Вторичная операция -
// ошибка логируется предупреждением и не пробрасывается.
//
Процедура ОбновитьДействиеApproved(Знач ДанныеЗаписи, Знач Пользователь)

	ИмяTool = "";
	RiskLevel = "";
	АргументыJSON = "";

	Попытка
		Payload = ar_JSON.ИзJSON(ДанныеЗаписи.ActionPayloadJSON);
		Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
			ИмяTool = ЗначениеСоответствияСтрока(Payload, "tool_name");
			RiskLevel = ЗначениеСоответствияСтрока(Payload, "risk_level");
			Аргументы = Payload.Получить("arguments");
			Если Аргументы <> Неопределено Тогда
				АргументыJSON = ar_JSON.ВЗначениеJSON(Аргументы);
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Безопасные дефолты: ИмяTool="", RiskLevel→Read внутри ar_AuditДействия.
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR-02: не удалось разобрать ActionPayloadJSON (Approval, RunId=%1): %2';
				|en = 'APPR-02: failed to parse ActionPayloadJSON (Approval, RunId=%1): %2'"),
			ДанныеЗаписи.RunId, ТекстОшибки));
	КонецПопытки;

	ДопДанные = Новый Структура;
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
		ДопДанные.Вставить("ApprovedBy", Пользователь);
	КонецЕсли;
	ДопДанные.Вставить("ApprovedAt", ТекущаяДатаСеанса());

	Записано = ar_AuditЗащищённыйРежим.ЗаписатьДействиеПривилегированно(ДанныеЗаписи.RunId, ДанныеЗаписи.Sequence,
		ИмяTool, АргументыJSON, RiskLevel, "", ДопДанные);

	Если Не Записано Тогда
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru = 'APPR-02: не удалось обновить ApprovedBy/ApprovedAt в ar_ДействияАгента (RunId=%1, Sequence=%2)';
				|en = 'APPR-02: failed to update ApprovedBy/ApprovedAt in ar_ДействияАгента (RunId=%1, Sequence=%2)'"),
			ДанныеЗаписи.RunId, ДанныеЗаписи.Sequence);
		ЗаписатьПредупреждение(ТекстПредупреждения);
	КонецЕсли;

КонецПроцедуры

// Зафиксировать событие Approved (через ar_AuditСобытия, не пробрасывает).
//
Процедура ЗафиксироватьСобытиеПринято(Знач RunId, Знач ApprovalId, Знач Пользователь)

	Payload = Новый Структура;
	Payload.Вставить("approval_id", ApprovalId);
	Payload.Вставить("user_id", ?(ЗначениеЗаполнено(Пользователь), Строка(Пользователь), ""));
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "Approved", Payload);

КонецПроцедуры

// Зафиксировать итог ИСПОЛНЕНИЯ approved-действия отдельным событием
// (ActionExecuted / ActionExecutionFailed).
//
// Событие Approved фиксирует только решение оператора; без этой пары в
// ar_СобытияЗапуска было невозможно понять по логу запуска, был ли фактически
// записан объект. Не пробрасывает исключений: сбой аудита не должен ломать
// approve, который уже состоялся.
//
// Параметры:
//  RunId       - Строка - идентификатор запуска.
//  ApprovalId  - Строка - идентификатор записи очереди.
//  ToolName    - Строка - имя tool из payload (для читаемости лога).
//  ИтогИсполнения - Структура - см. ИсполнитьApprovedДействие.
//
Процедура ЗафиксироватьСобытиеИсполнения(Знач RunId, Знач ApprovalId, Знач ToolName,
		Знач ИтогИсполнения)

	Если ПустаяСтрока(RunId) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Payload = Новый Структура;
		Payload.Вставить("approval_id", ApprovalId);
		Payload.Вставить("tool_name", ToolName);

		Если ИтогИсполнения.Выполнено Тогда
			Если ИтогИсполнения.DocumentRef <> Неопределено Тогда
				Payload.Вставить("document_ref",
					ar_Утилиты.НавигационнаяСсылкаОбъекта(ИтогИсполнения.DocumentRef));
				Payload.Вставить("document_name", Строка(ИтогИсполнения.DocumentRef));
			КонецЕсли;
			ИмяСобытия = "action_executed";
		Иначе
			Payload.Вставить("reason", ИтогИсполнения.Сообщение);
			ИмяСобытия = "action_execution_failed";
		КонецЕсли;

		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, ИмяСобытия, Payload);
	Исключение
		ЗаписатьПредупреждение(СтрШаблон(
			НСтр("ru = 'APPR: не удалось записать событие исполнения для ApprovalId=%1: %2';
				|en = 'APPR: failed to record execution event for ApprovalId=%1: %2'"),
			ApprovalId,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Обработать один ApprovalId в пакете массового подтверждения (APPR-05).
// Вызывает Принять, изолирует исключение (цикл не прерывается), обновляет
// агрегированный Результат ({Принято, НеПринято, ОшибкиПоId}) и накопитель
// ПринятоПоRunId (RunId → число успешно принятых) для агрегатного события.
//
// Параметры:
//  ApprovalId     - Строка - идентификатор записи очереди.
//  Пользователь   - СправочникСсылка.Пользователи - принявший оператор.
//  Результат      - Структура - изменяется по ссылке (счётчики и ОшибкиПоId).
//  ПринятоПоRunId - Соответствие - изменяется по ссылке (RunId → счётчик).
//
Процедура ОбработатьОдинApprovalId(Знач ApprovalId, Знач Пользователь, Результат, ПринятоПоRunId)

	Попытка
		РезультатПринятия = Принять(ApprovalId, Пользователь);
	Исключение
		// Крайний случай (DB-ошибка внутри Принять): изолируем, цикл продолжается.
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.НеПринято = Результат.НеПринято + 1;
		Результат.ОшибкиПоId.Вставить(ApprovalId, "exception: " + ТекстОшибки);
		ШаблонОшибки = НСтр("ru = 'APPR-05: исключение при подтверждении %1: %2';
							|en = 'APPR-05: exception while approving %1: %2'");
		ЗаписатьОшибкуЖурнал(СтрШаблон(ШаблонОшибки, ApprovalId, ТекстОшибки));
		Возврат;
	КонецПопытки;

	Если РезультатПринятия.Успех Тогда
		Результат.Принято = Результат.Принято + 1;
		Если РезультатПринятия.Свойство("ДействиеВыполнено")
			И РезультатПринятия.ДействиеВыполнено Тогда
			Результат.Выполнено = Результат.Выполнено + 1;
		Иначе
			Результат.НеВыполнено = Результат.НеВыполнено + 1;
			Результат.ОшибкиПоId.Вставить(ApprovalId,
				"not_executed: " + РезультатПринятия.ДействиеСообщение);
		КонецЕсли;
		RunId = РезультатПринятия.RunId;
		Если Не ПустаяСтрока(RunId) Тогда
			Текущее = ПринятоПоRunId.Получить(RunId);
			ПринятоПоRunId.Вставить(RunId, ?(Текущее = Неопределено, 0, Текущее) + 1);
		КонецЕсли;
	Иначе
		Результат.НеПринято = Результат.НеПринято + 1;
		Результат.ОшибкиПоId.Вставить(ApprovalId, РезультатПринятия.Причина);
	КонецЕсли;

КонецПроцедуры

// Зафиксировать агрегатное событие массового подтверждения (APPR-05). Вариант A:
// переиспользуем тип Approved с флагом bulk:true и количеством принятых по RunId.
// Через ar_AuditСобытия (не пробрасывает исключений).
//
Процедура ЗафиксироватьСобытиеМассовоПринято(Знач RunId, Знач Количество, Знач Пользователь)

	Payload = Новый Структура;
	Payload.Вставить("bulk", Истина);
	Payload.Вставить("count", Количество);
	Payload.Вставить("user_id", ?(ЗначениеЗаполнено(Пользователь), Строка(Пользователь), ""));
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "Approved", Payload);

КонецПроцедуры

// Зафиксировать событие Rejected (через ar_AuditСобытия, не пробрасывает).
// Причина уже замаскирована вызывающим кодом (Отклонить).
//
Процедура ЗафиксироватьСобытиеОтклонено(Знач RunId, Знач ApprovalId, Знач Пользователь, Знач Причина)

	Payload = Новый Структура;
	Payload.Вставить("approval_id", ApprovalId);
	Payload.Вставить("user_id", ?(ЗначениеЗаполнено(Пользователь), Строка(Пользователь), ""));
	Payload.Вставить("reason", ?(ТипЗнч(Причина) = Тип("Строка"), Причина, ""));
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "Rejected", Payload);

КонецПроцедуры

// Зафиксировать событие Expired (через ar_AuditСобытия, не пробрасывает).
// Payload: {approval_id, ttl_hours}.
//
Процедура ЗафиксироватьСобытиеИстекло(Знач RunId, Знач ApprovalId, Знач TTLЧасов)

	Payload = Новый Структура;
	Payload.Вставить("approval_id", ApprovalId);
	Payload.Вставить("ttl_hours", TTLЧасов);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "Expired", Payload);

КонецПроцедуры

// Признак: причина неудачи Возобновить означает, что запуск уже не в
// paused_for_approval (финальный статус / отсутствует) - возобновлять нечего,
// истечение записи очереди при этом считается успешным (APPR-04 D10).
// ar_RuntimeЗапуск.Возобновить возвращает в таких случаях "unexpected_status: ..."
// либо "run_not_found".
//
Функция ВозобновлениеНевозможноИзЗаФинальногоСтатуса(Знач Причина)
	Если ТипЗнч(Причина) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНачинаетсяС(Причина, "unexpected_status:") Или Причина = "run_not_found";
КонецФункции

// Извлечь tool_call_id из ActionPayloadJSON записи очереди. При невалидном/
// неполном JSON или отсутствии поля возвращает "" (observation добавится без
// привязки к конкретному вызову - допустимо, см. APPR-03 граничные случаи).
//
Функция ToolCallIdИзPayload(Знач ActionPayloadJSON)

	// ar_JSON.ИзJSON не выбрасывает исключений: при невалидном/пустом JSON
	// возвращает Неопределено - отдельный Попытка-блок здесь не нужен.
	Payload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
		Возврат ЗначениеСоответствияСтрока(Payload, "tool_call_id");
	КонецЕсли;

	Возврат "";

КонецФункции

// Нормализовать входной СписокApprovalId в Массив непустых строк (APPR-05).
// Принимает Массив или СписокЗначений; для СписокЗначений берётся .Значение
// каждого элемента. Пустые, не-строковые и пустые после СокрЛП значения
// пропускаются с предупреждением в журнал. Неопределено / иной тип → пустой Массив.
//
Функция НормализоватьСписокApprovalId(Знач СписокApprovalId)

	Результат = Новый Массив;

	Если ТипЗнч(СписокApprovalId) = Тип("СписокЗначений") Тогда
		Источник = СписокApprovalId.ВыгрузитьЗначения();
	ИначеЕсли ТипЗнч(СписокApprovalId) = Тип("Массив") Тогда
		Источник = СписокApprovalId;
	Иначе
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Источник Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Элемент)) Тогда
			ЗаписатьПредупреждение(
				НСтр("ru = 'APPR-05: пропущен пустой/нестроковый ApprovalId в списке подтверждения';
					|en = 'APPR-05: skipped empty/non-string ApprovalId in approval list'"));
			Продолжить;
		КонецЕсли;
		Результат.Добавить(СокрЛП(Элемент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Порог размера пакета, при превышении которого пишется предупреждение (APPR-05 R1).
//
Функция ПорогБольшогоПакета()
	Возврат 500;
КонецФункции

// Строковое значение из Соответствия по ключу (Неопределено/нестрока → "").
//
Функция ЗначениеСоответствияСтрока(Знач Соответствие, Знач Ключ)
	Значение = Соответствие.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

// Признак: запуск находится в финальном статусе (постановка в паузу недопустима).
// Финальные статусы - всё, кроме Created / Running / PausedForApproval.
// Чтение статуса делегировано фасаду ar_AuditЗащищённыйРежим (AUD-04).
//
Функция ЗапускВФинальномСтатусе(Знач RunId)

	// Чтение статуса служебного регистра под привилегиями инкапсулировано в фасаде.
	Статус = ar_AuditЗащищённыйРежим.СтатусЗапускаПривилегированно(RunId);
	Если Статус = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Перечисление = Перечисления.ar_СтатусЗапуска;
	Если Статус = Перечисление.Created
		Или Статус = Перечисление.Running
		Или Статус = Перечисление.PausedForApproval Тогда
		Возврат Ложь;
	КонецЕсли;

	// Незаполненный статус (пустая ссылка) трактуем как «не финальный».
	Возврат ЗначениеЗаполнено(Статус);

КонецФункции

// Безопасно получить значение из КонтекстЗапуска (Структура) с дефолтом-строкой.
//
Функция ЗначениеКонтекста(Знач КонтекстЗапуска, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(КонтекстЗапуска) <> Тип("Структура") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Дефолт;
	КонтекстЗапуска.Свойство(Ключ, Значение);
	Возврат Значение;
КонецФункции

// Числовое значение из КонтекстЗапуска с дефолтом.
//
Функция ЧислоКонтекста(Знач КонтекстЗапуска, Знач Ключ, Знач Дефолт)
	Значение = ЗначениеКонтекста(КонтекстЗапуска, Ключ, Дефолт);
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, Дефолт);
КонецФункции

// Строковое значение из Действия (Структура/Соответствие) с дефолтом.
//
Функция ЗначениеДействия(Знач Действие, Знач Ключ, Знач Дефолт)
	Значение = ЗначениеДействияПроизвольное(Действие, Ключ);
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, Строка(Значение));
КонецФункции

// Произвольное значение из Действия (Структура/Соответствие); Неопределено если нет.
//
Функция ЗначениеДействияПроизвольное(Знач Действие, Знач Ключ)
	Если ТипЗнч(Действие) = Тип("Структура") Тогда
		Значение = Неопределено;
		Действие.Свойство(Ключ, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Действие) = Тип("Соответствие") Тогда
		Возврат Действие.Получить(Ключ);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Имя tool из действия (Имя / name).
//
Функция ИмяДействия(Знач Действие)
	Имя = ЗначениеДействия(Действие, "Имя", "");
	Если ПустаяСтрока(Имя) Тогда
		Имя = ЗначениеДействия(Действие, "name", "");
	КонецЕсли;
	Возврат Имя;
КонецФункции

// Имя агента из КонтекстЗапуска (ссылка → представление), либо "".
//
Функция ИмяАгента(Знач КонтекстЗапуска)
	Агент = ЗначениеКонтекста(КонтекстЗапуска, "Агент", Неопределено);
	Если Агент = Неопределено Или Не ЗначениеЗаполнено(Агент) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Агент));
КонецФункции

// Записать предупреждение в журнал регистрации.
//
Процедура ЗаписатьПредупреждение(Знач Текст)
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Agent OS.Approval'; en = 'Agent OS.Approval'"),
		УровеньЖурналаРегистрации.Предупреждение,,, Текст);
КонецПроцедуры

// Записать ошибку в журнал регистрации.
//
Процедура ЗаписатьОшибкуЖурнал(Знач Текст)
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Agent OS.Approval'; en = 'Agent OS.Approval'"),
		УровеньЖурналаРегистрации.Ошибка,,, Текст);
КонецПроцедуры

#КонецОбласти
