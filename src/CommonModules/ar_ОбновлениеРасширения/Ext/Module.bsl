// Общий модуль ar_ОбновлениеРасширения (ENV-08).
//
// Лёгкий (без монопольного режима, без отложенных обработчиков) аналог
// БСП ОбновлениеИнформационнойБазы, специализированный под расширение:
// при смене версии установленного .cfe прогоняет зарегистрированные
// обработчики обновления по версиям, чтобы донастроить/мигрировать данные в ИБ.
//
// [Реф: БСП/ОбновлениеИнформационнойБазы] - идея таблицы обработчиков
// (Версия/Идентификатор) и сравнения с версией, хранимой в ИБ. Монопольный
// режим, отложенные обработчики и РС ВерсииПодсистем сознательно не
// заимствованы - расширение не должно требовать эксклюзивного доступа к ИБ.
//
// Текущая версия .cfe берётся из ar_Утилиты.ВерсияРасширения() (метаданные).
// Версия, для которой обработчики уже выполнены, хранится в константе
// ar_ВерсияРасширенияБД (см. ENV-05).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь
// (AUD-06: расширениям запрещён Privileged=true в общих модулях). Привилегии
// поднимаются точечно и сбрасываются парным вызовом (Ложь) - по паттерну
// ar_СлужебныйЛог/ar_AuditЗащищённыйРежим.
//
// Запрещено: Выполнить(), Вычислить().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет обработчики обновления, если версия расширения в ИБ отстаёт
// от версии установленного .cfe. Идемпотентна и дешева при совпадении версий -
// безопасно вызывать при каждом старте системы.
//
// Ошибка одного обработчика не прерывает остальные и не блокирует запуск
// системы - фиксируется в ar_СлужебныйЛог, обработка продолжается.
//
Процедура ВыполнитьОбновлениеПриНеобходимости() Экспорт

	ВерсияМетаданных = ar_Утилиты.ВерсияРасширения();
	Если ВерсияМетаданных = "?" Или ПустаяСтрока(ВерсияМетаданных) Тогда
		Возврат; // Расширение не найдено среди подключённых - сравнивать не с чем.
	КонецЕсли;

	ВерсияБД = Константы.ar_ВерсияРасширенияБД.Получить();

	Если ВерсияБД = ВерсияМетаданных Тогда
		Возврат; // Частый путь: обычный вход, версия не менялась.
	КонецЕсли;

	ЭтоПерваяУстановка = ПустаяСтрока(ВерсияБД);

	Если Не ЭтоПерваяУстановка Тогда
		ВыполнитьОбработчикиОбновления(ВерсияБД, ВерсияМетаданных);
	КонецЕсли;

	// EXT-10: диагностика согласованности списка пользовательских
	// tool-модулей, объявленных прикладным разработчиком в
	// ar_ToolПереопределяемый.ПриФормированииСпискаМодулейТулов. Сам вызов
	// ЗарегистрироватьTools() каждого модуля программно НЕ выполняется -
	// имя модуля заранее неизвестно ядру, а вызов метода по строке-имени без
	// явной ветки ИначеЕсли потребовал бы Выполнить()/Вычислить(), что
	// запрещено правилом проекта (Plan §1.3, DoD D5 EXT-10). Прикладной
	// разработчик регистрирует свои tools явно - либо вызовом
	// <СвойМодуль>.ЗарегистрироватьTools() из собственного обработчика
	// обновления (см. ПриДобавленииОбработчиковОбновления выше), либо из
	// своего кода инициализации.
	ПроверитьСогласованностьПользовательскихМодулей();

	УстановитьВерсиюРасширенияБД(ВерсияМетаданных);

КонецПроцедуры

// Возвращает новую пустую таблицу обработчиков обновления - по образцу
// БСП ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления().
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Версия      - Строка - версия расширения, начиная с которой требуется обработчик.
//   * Идентификатор - Строка - код обработчика для ВызватьОбработчикПоИдентификатору
//                     (диспетчеризация явным Если/ИначеЕсли - без Выполнить()/Вычислить()).
//   * Комментарий - Строка - для чего обработчик, для диагностики в логе.
//
Функция НоваяТаблицаОбработчиковОбновления() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Версия");
	Таблица.Колонки.Добавить("Идентификатор");
	Таблица.Колонки.Добавить("Комментарий");

	Возврат Таблица;

КонецФункции

// Регистрирует обработчики обновления расширения по версиям. Вызывается
// из ВыполнитьОбработчикиОбновления. Добавлять строки по мере появления
// реальных миграций данных.
//
// Пример регистрации (плюс добавить ветку в ВызватьОбработчикПоИдентификатору):
//   Обработчик = Обработчики.Добавить();
//   Обработчик.Версия = "0.2.0";
//   Обработчик.Идентификатор = "ПримерОбработчика";
//   Обработчик.Комментарий = "Заполнение нового реквизита по умолчанию";
//
// Параметры:
//  Обработчики - ТаблицаЗначений - см. НоваяТаблицаОбработчиковОбновления.
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	// UNIV-03: на существующей (не первый раз разворачиваемой) базе
	// АвтоЗаполнитьРеестрToolsПриЗапуске пропускает регистрацию (в ar_Tools уже
	// есть записи), поэтому ar_Доступен для существующих tools сам по себе не
	// пересчитается - нужен отдельный обработчик обновления версии.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.85";
	Обработчик.Идентификатор = "ПересчитатьДоступностьTools";
	Обработчик.Комментарий = "UNIV-03: пересчёт ar_Доступен для всех записей ar_Tools";

	// UNIV-06: на существующей (не первый раз разворачиваемой) базе новый
	// реквизит ar_ТребуетАдаптер для уже созданной записи create_invoice_draft
	// сам по себе не проставится (АвтоЗаполнитьРеестрToolsПриЗапуске
	// пропускает регистрацию, если в ar_Tools уже есть записи) - нужен
	// отдельный обработчик, перерегистрирующий tools ar_ToolДокументы и
	// адаптеры заново, затем пересчитывающий доступность.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.91";
	Обработчик.Идентификатор = "ЗарегистрироватьАдаптерыЗаполнения";
	Обработчик.Комментарий = "UNIV-06: регистрация ar_Адаптеры + ar_ТребуетАдаптер для create_invoice_draft";

	// TOOL-19: карточка ask_user так и не появилась в ar_Tools ни на одной базе.
	// Причина - опечатка в имени реквизита (ar_Включен вместо ar_Включён,
	// исправлена в 0.1.0.148): присваивание несуществующего поля выбрасывало
	// исключение, транзакция регистрации откатывалась целиком. Само по себе это
	// не починится: АвтоЗаполнитьРеестрToolsПриЗапуске выходит сразу, если в
	// ar_Tools есть хотя бы одна запись, а единственный полный вызов
	// ЗарегистрироватьВсеTools живёт за кнопкой в форме списка ar_Tools.
	//
	// Заодно закрывается общий пробел: обновлённые манифесты существующих tools
	// (в 0.1.0.148 - подсказки по contragent_inn у финансовых) тоже доезжали до
	// базы только вручную. Регистрация идемпотентна - upsert по имени.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.149";
	Обработчик.Идентификатор = "ПеререгистрироватьВсеTools";
	Обработчик.Комментарий = "TOOL-19: создание карточки ask_user + актуализация манифестов всех tools";

	// PAY-01: 5 новых tools (list_unpaid_invoices, get_invoice_reminder_history,
	// prepare_payment_reminder_email, get_settings, set_setting) на существующей
	// (не первый раз разворачиваемой) базе сами по себе не появятся -
	// АвтоЗаполнитьРеестрToolsПриЗапуске выходит, если реестр непуст.
	//
	// Версия обработчика (0.1.0.169) намеренно выше версий, которые база уже
	// прошла в ходе отладки PAY-01 (до 0.1.0.168 включительно). Отбор в
	// ВыполнитьОбработчикиОбновления выполняет обработчик только при
	// Версия > ar_ВерсияРасширенияБД, а эта константа поднимается до версии
	// метаданных при КАЖДОМ старте - независимо от того, отработали ли
	// обработчики. Из-за этого обработчик, привязанный к уже пройденной версии
	// (было 0.1.0.156 при версии базы 0.1.0.168), не выполняется никогда:
	// именно поэтому 4 из 5 tools PAY-01 отсутствовали в реестре ar_Tools.
	// При добавлении новых обработчиков ставить версию строго выше текущей
	// версии расширения в src/Configuration.xml.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.169";
	Обработчик.Идентификатор = "ЗарегистрироватьToolsКонтроляОплат";
	Обработчик.Комментарий = "PAY-01: регистрация 5 новых tools + заполнение типовых настроек";

	// ORG-01: новый tool search_organizations + обновлённые манифесты финансовых
	// tools (появился аргумент organization_name). Без перерегистрации на
	// существующей базе карточки search_organizations не будет, а модель
	// продолжит видеть старые манифесты без organization_name - то есть
	// исходный дефект «организацию по названию найти нечем» сохранится.
	//
	// Версия строго выше версии расширения в src/Configuration.xml на момент
	// правки (0.1.0.213) - см. комментарий к 0.1.0.169: обработчик, привязанный
	// к уже пройденной версии, не выполнится никогда.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.214";
	Обработчик.Идентификатор = "ЗарегистрироватьToolПоискаОрганизаций";
	Обработчик.Комментарий = "ORG-01: карточка search_organizations + манифесты с organization_name";

	// PKG-09: 10 tools (search_clients, update_client_contact,
	// create_invoice_draft, get_invoice, validate_document,
	// create_reconciliation_act, get_account_balance, find_overdue_receivables,
	// search_organizations, list_unpaid_invoices) переехали из ядра в пакет
	// "AgentRunner Бухгалтерия" и получили префикс "buh_" - без миграции
	// строковой связи по имени (ar_Агенты.ar_ДоступныеTools.ar_Tool, JSON
	// ar_Пресеты.ar_JSON) ссылки на старые имена стали бы мёртвыми молча.
	//
	// Версия строго выше версии расширения в src/Configuration.xml на момент
	// правки (0.1.0.230) - см. комментарий к 0.1.0.169: обработчик, привязанный
	// к уже пройденной версии, не выполнится никогда (память
	// project_update_handler_version_trap - так уже терялись 4 tools PAY-01).
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.231";
	Обработчик.Идентификатор = "МигрироватьИменаToolsБухгалтерии";
	Обработчик.Комментарий = "PKG-09: переименование 10 tools в ar_ДоступныеTools/ar_Пресеты на buh_*";

	// PERF-05: константа ar_ПорогМедленногоTool имеет тип Число, а незаполненная
	// числовая константа возвращает 0, а не Неопределено. Проверка по типу в
	// геттере ПорогМедленногоToolСек поэтому не срабатывает никогда, и дефолт 15
	// недостижим. При этом 0 - осознанное значение "выключено администратором",
	// поэтому подставлять дефолт в геттере при нуле нельзя: различить "не
	// настроено" и "выключено" по значению невозможно. Единственное корректное
	// место - разовая инициализация при установке версии (проверено живьём в
	// БП 3.0.201.16: панель настроек показывала "порог = 0" вместо 15).
	//
	// Версия строго выше версии расширения на момент правки (0.1.0.251) -
	// см. память project_update_handler_version_trap: обработчик, привязанный
	// к уже пройденной версии, не выполнится никогда.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.252";
	Обработчик.Идентификатор = "ИнициализироватьПорогМедленногоTool";
	Обработчик.Комментарий = "PERF-05: дефолт 15 сек в ar_ПорогМедленногоTool при первой установке";

	// SCALE-01: новый справочник ar_КатегорииTools заменяет русский текст
	// категории (был захардкожен в ar_ToolDispatcher.ПредставленияTools) на
	// стабильный код (finance, documents, ...). На существующей (не первый раз
	// разворачиваемой) базе ar_КатегорииTools сам по себе не заполнится -
	// АвтоЗаполнитьРеестрToolsПриЗапуске пропускает регистрацию, если ar_Tools
	// уже не пуст (условие проверки - там же). Обработчик заводит ядровые
	// категории и переписывает уже сохранённые записи ar_Tools.ar_Категория
	// с русского текста на код.
	//
	// Версия строго выше версии расширения в src/Configuration.xml на момент
	// правки (0.1.0.253) - см. комментарий к 0.1.0.169: обработчик, привязанный
	// к уже пройденной версии, не выполнится никогда (память
	// project_update_handler_version_trap - так уже терялись 4 tools PAY-01).
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.254";
	Обработчик.Идентификатор = "МигрироватьКатегорииTools";
	Обработчик.Комментарий = "SCALE-01: справочник ar_КатегорииTools + перевод ar_Tools.ar_Категория текст -> код";

	// SCALE-01, исправление: в ЗарегистрироватьКатегории в соответствие клался
	// курсор ВыборкаИзРезультатаЗапроса вместо значений строки, поэтому часть
	// категорий получила чужие Наименование/Описание/Порядок (живьём: service
	// показывался как "Взаимодействие", порядок 90 вместо 100). Код исправлен,
	// но уже записанные в базу значения нужно перезаписать - повторный прогон
	// ЗарегистрироватьКатегории теперь сравнивает по правильным данным и
	// выправит расхождения. Отдельный обработчик, потому что 0.1.0.254 уже
	// пройден на затронутых базах (память project_update_handler_version_trap).
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.256";
	Обработчик.Идентификатор = "ПеререгистрироватьКатегорииTools";
	Обработчик.Комментарий = "SCALE-01: выправить категории, записанные с чужими значениями из-за курсора выборки";

	// SCALE-02: ar_КраткоеОписание (35 ядровых/пакетных tools) и новый реквизит
	// ar_КлючевыеСловаПараметров (все записи с непустым ar_JSONManifest) на
	// существующей (не первый раз разворачиваемой) базе сами по себе не
	// заполнятся - АвтоЗаполнитьРеестрToolsПриЗапуске пропускает регистрацию,
	// если в ar_Tools уже есть записи (условие проверки - там же).
	//
	// ПеререгистрироватьВсеToolsСохранивНастройки переиспользуется как есть:
	// она вызывает ar_ToolDispatcher.ЗарегистрироватьВсеTools() целиком, который
	// теперь (после SCALE-02) идемпотентно сравнивает и перезаписывает
	// ar_КраткоеОписание в ОбновитьМанифестTool/аналогах всех 6 ядровых
	// tool-модулей (проверено по коду - не полагаемся на "раз добавили параметр,
	// значит запишется", см. риск в .docs/specs/SCALE-02.md) и вызывает
	// ЗаполнитьКлючевыеСловаПараметровВсехTools() без whitelist по имени - то
	// есть покрывает и 10 пакетных buh_* записей тоже (их ar_JSONManifest уже
	// в базе, если пакет установлен - регистрация самого пакета этим
	// обработчиком не запускается, PKG-03 требует явного действия администратора).
	//
	// Версия строго выше версии расширения в src/Configuration.xml на момент
	// правки (0.1.0.256) - см. комментарий к 0.1.0.169: обработчик, привязанный
	// к уже пройденной версии, не выполнится никогда (память
	// project_update_handler_version_trap - так уже терялись 4 tools PAY-01).
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.257";
	Обработчик.Идентификатор = "ЗаполнитьКраткиеОписанияИКлючевыеСловаTools";
	Обработчик.Комментарий = "SCALE-02: заполнить ar_КраткоеОписание (35 tools) + автозаполнить ar_КлючевыеСловаПараметров";

	// SCALE-03: новый ядровой tool-модуль ar_ToolРеестрПоиск (find_tools,
	// describe_tool) на существующей (не первый раз разворачиваемой) базе сам
	// по себе не зарегистрируется - АвтоЗаполнитьРеестрToolsПриЗапуске
	// пропускает регистрацию, если в ar_Tools уже есть записи (условие
	// проверки - там же).
	//
	// ПеререгистрироватьВсеToolsСохранивНастройки переиспользуется как есть:
	// она вызывает ar_ToolDispatcher.ЗарегистрироватьВсеTools() целиком,
	// который теперь (после SCALE-03) включает ar_ToolРеестрПоиск в общий
	// список зарегистрированных модулей (ЗарегистрироватьМодуль
	// "ar_ToolРеестрПоиск" добавлен в ЗарегистрироватьВсеTools) - появятся
	// записи find_tools/describe_tool, которых раньше не было. Обе записи
	// получают ar_Доступен = Истина автоматически через штатный
	// ПересчитатьДоступностьВсехTools() (вызывается в конце
	// ЗарегистрироватьВсеTools) - ar_ТребуемыеОбъекты у обоих tools пуст
	// (ядровые tools без внешних зависимостей), тот же путь, что и у
	// остальных шести ядровых модулей.
	//
	// Версия строго выше версии расширения в src/Configuration.xml на момент
	// правки (0.1.0.258) - см. комментарий к 0.1.0.169: обработчик, привязанный
	// к уже пройденной версии, не выполнится никогда (память
	// project_update_handler_version_trap - так уже терялись 4 tools PAY-01).
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.259";
	Обработчик.Идентификатор = "ЗарегистрироватьToolРеестрПоиска";
	Обработчик.Комментарий = "SCALE-03: зарегистрировать find_tools/describe_tool (ar_ToolРеестрПоиск)";

	// SEC-TOOL-02, релиз 1 из 2: диспетчеризация tools в режиме «Код»
	// (ar_ТипРеализации="Код", Выполнить() над ar_КодРеализации) удалена из
	// ar_ToolDispatcher - решение пользователя от 2026-09-02 (План-гибкие-
	// tools.md, Блок C §5, решение 6), тот же сценарий закрывается безопаснее
	// механизмом пакетов (PKG-04).
	//
	// Реквизиты ar_ТипРеализации/ar_КодРеализации и константа
	// ar_РазрешитьТулыВРежимеКод в ЭТОМ релизе физически СОХРАНЕНЫ в метаданных
	// (их удаление - следующий релиз). Причина: ВыполнитьОбработчикиОбновления
	// вызывается ПОСЛЕ UpdateDBCfg - если бы реквизиты были удалены в этой же
	// версии, к моменту запуска этого обработчика читать в них уже было бы
	// нечего, и карточки отключались бы "молча" без возможности их найти. Пока
	// реквизиты существуют, обработчик читает ar_ТипРеализации="Код" через
	// обычный запрос к справочнику ar_Tools и явно отключает такие карточки.
	//
	// Версия строго выше версии расширения на момент правки (0.1.0.276) -
	// см. комментарий к 0.1.0.169: обработчик, привязанный к уже пройденной
	// версии, не выполнится никогда (память project_update_handler_version_trap).
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.278";
	Обработчик.Идентификатор = "ОтключитьCodeTools";
	Обработчик.Комментарий = "SEC-TOOL-02 (релиз 1/2): отключить tools в режиме «Код» перед удалением механизма";

	// SCALE-05: константа ar_ПорогПрогрессивнойВыдачи и реквизит
	// ar_ВсегдаВКонтексте заведены (реквизит - ещё в PKG-02), но без этого
	// обработчика ни один из них не получает данных на существующей базе:
	// константа остаётся 0 (геттер её и так подставляет дефолтом на лету -
	// см. ar_Константы.ПорогПрогрессивнойВыдачи, - но панель настроек должна
	// показывать фактическое значение, не подставленное геттером), а
	// ar_ВсегдаВКонтексте=Истина не проставлен НИ У ОДНОЙ записи ar_Tools
	// (заведён PKG-02, данные никогда не заполнялись - подтверждено grep'ом
	// перед реализацией). Без этого шага Уровень 0 прогрессивной выдачи
	// окажется пустым за вычетом find_tools/describe_tool - именно риск,
	// прямо описанный в спеке SCALE-05, раздел «Риски».
	//
	// Версия строго выше версии расширения в src/Configuration.xml на момент
	// правки (0.1.0.279) - см. комментарий к 0.1.0.169: обработчик, привязанный
	// к уже пройденной версии, не выполнится никогда (память
	// project_update_handler_version_trap - так уже терялись 4 tools PAY-01).
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "0.1.0.282";
	Обработчик.Идентификатор = "ИнициализироватьПрогрессивнуюВыдачу";
	Обработчик.Комментарий = "SCALE-05: дефолт 25 в ar_ПорогПрогрессивнойВыдачи + ar_ВсегдаВКонтексте=Истина для Уровня 0";

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отбирает и последовательно выполняет обработчики обновления версии
// строго больше ВерсияБД и меньше-равно ВерсияМетаданных, в порядке
// возрастания версии.
//
// Параметры:
//  ВерсияБД         - Строка - версия, для которой обработчики уже выполнены.
//  ВерсияМетаданных - Строка - целевая версия (версия установленного .cfe).
//
Процедура ВыполнитьОбработчикиОбновления(Знач ВерсияБД, Знач ВерсияМетаданных)

	Обработчики = НоваяТаблицаОбработчиковОбновления();
	ПриДобавленииОбработчиковОбновления(Обработчики);

	Если Обработчики.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Обход с конца - потому что внутри удаляем строки. В 1С "Для ... По ..."
	// всегда идёт с шагом +1: запись "Для Индекс = Количество()-1 По 0" НЕ
	// является обратным циклом, её тело не выполняется НИ РАЗУ (9 <= 0 ложно
	// сразу). Из-за этого фильтр не работал: в КОтбору оставались ВСЕ
	// обработчики, включая давно пройденные, и на выполнение уходил
	// произвольный их набор. Проверено живьём в БП 3.0.201.16: при
	// ВерсияБД=0.1.0.255 отработали обработчики 0.1.0.85/91/252, а нужные
	// 0.1.0.254/256/257 - нет. Обратный обход делается пересчётом индекса.
	КОтбору = Обработчики.Скопировать();
	Всего = КОтбору.Количество();
	Для Смещение = 1 По Всего Цикл
		Индекс = Всего - Смещение;
		Обработчик = КОтбору[Индекс];
		ЕщеНеВыполнен = ar_ПроверкаОбновлений.СравнитьВерсии(Обработчик.Версия, ВерсияБД) > 0;
		УжеАктуален   = ar_ПроверкаОбновлений.СравнитьВерсии(Обработчик.Версия, ВерсияМетаданных) <= 0;
		Если Не (ЕщеНеВыполнен И УжеАктуален) Тогда
			КОтбору.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Если КОтбору.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Сортировка по возрастанию версии - вставками, т.к. штатный
	// ТаблицаЗначений.Сортировать("Версия") сравнивает версии как строки
	// (лексикографически: "0.10.0" < "0.9.0"), что для SemVer некорректно.
	КОтсортировано = НоваяТаблицаОбработчиковОбновления();
	Для Каждого Обработчик Из КОтбору Цикл
		ПозицияВставки = КОтсортировано.Количество();
		Для Индекс = 0 По КОтсортировано.Количество() - 1 Цикл
			Если ar_ПроверкаОбновлений.СравнитьВерсии(Обработчик.Версия, КОтсортировано[Индекс].Версия) < 0 Тогда
				ПозицияВставки = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		НоваяСтрока = КОтсортировано.Вставить(ПозицияВставки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Обработчик);
	КонецЦикла;

	Для Каждого Обработчик Из КОтсортировано Цикл
		ВыполнитьОдинОбработчик(Обработчик);
	КонецЦикла;

КонецПроцедуры

// Выполняет один обработчик обновления через явную диспетчеризацию
// ВызватьОбработчикПоИдентификатору - без Выполнить()/Вычислить(). Ошибка
// перехватывается и пишется в ar_СлужебныйЛог, не прерывая цикл остальных
// обработчиков.
//
// Параметры:
//  Обработчик - СтрокаТаблицыЗначений - строка из НоваяТаблицаОбработчиковОбновления.
//
Процедура ВыполнитьОдинОбработчик(Обработчик)

	ОписаниеОбработчика = "Версия " + Обработчик.Версия + ": " + Обработчик.Идентификатор;
	Если Не ПустаяСтрока(Обработчик.Комментарий) Тогда
		ОписаниеОбработчика = ОписаниеОбработчика + " (" + Обработчик.Комментарий + ")";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ВызватьОбработчикПоИдентификатору(Обработчик.Идентификатор);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать(
			"ar_ОбновлениеРасширения.ВыполнитьОдинОбработчик",
			"update_handler_error",
			ОписаниеОбработчика + " - " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Ошибка");
		Возврат;
	КонецПопытки;

	ar_СлужебныйЛог.Записать(
		"ar_ОбновлениеРасширения.ВыполнитьОдинОбработчик",
		"update_handler_done",
		ОписаниеОбработчика);

КонецПроцедуры

// Явная диспетчеризация обработчиков обновления по идентификатору -
// без Выполнить()/Вычислить(). Добавлять ветку сюда при регистрации
// нового обработчика в ПриДобавленииОбработчиковОбновления, например:
//   Если Идентификатор = "ПримерОбработчика" Тогда
//       ПримерОбработчика();
//       Возврат;
//   КонецЕсли;
//
// Параметры:
//  Идентификатор - Строка - см. НоваяТаблицаОбработчиковОбновления.
//
Процедура ВызватьОбработчикПоИдентификатору(Знач Идентификатор)

	Если Идентификатор = "ПересчитатьДоступностьTools" Тогда
		// UNIV-03: обработчик уже вызывается в привилегированном режиме извне
		// (ВыполнитьОдинОбработчик) - сама функция повторно Привилегированный
		// режим не поднимает.
		ar_ToolDispatcher.ПересчитатьДоступностьВсехTools();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ЗарегистрироватьАдаптерыЗаполнения" Тогда
		// UNIV-06: адаптеры - ДО перерегистрации tools (тот же порядок, что в
		// ar_ToolDispatcher.ИнициализироватьПриЗапускеСистемы), затем повторная
		// регистрация ar_ToolДокументы (проставит ar_ТребуетАдаптер=Истина для
		// create_invoke_draft на уже существующей записи), затем пересчёт
		// доступности всех tools. Уже в привилегированном режиме извне.
		//
		// PKG-09: ar_ToolДокументы.ЗарегистрироватьTools() удалён из ядра вместе
		// с самим модулем (перенесён в пакет "AgentRunner Бухгалтерия",
		// см. .docs/specs/PKG-09.md). Историю обработчика 0.1.0.91 НЕ переписываем
		// (уже выполнен на существующих базах, наблюдаемый эффект сохранён -
		// ar_ТребуетАдаптер на этой версии для buh_create_invoice_draft всё
		// равно проставляется заново пакетной регистрацией PKG-03/ar_ToolПакеты
		// при подключении пакета) - вызов убран, т.к. модуль физически не
		// существует и не может компилироваться.
		ar_АдаптерЗаполнения.ЗарегистрироватьВсеАдаптеры();
		ar_ToolDispatcher.ПересчитатьДоступностьВсехTools();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ПеререгистрироватьВсеTools" Тогда
		ПеререгистрироватьВсеToolsСохранивНастройки();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ЗарегистрироватьToolsКонтроляОплат" Тогда
		// PAY-01: та же перерегистрация с сохранением админских настроек
		// (ar_ТребуетApproval/ar_Включён), что и ПеререгистрироватьВсеTools -
		// затрагивает все модули (upsert по имени идемпотентен), новые карточки
		// (list_unpaid_invoices, get_invoice_reminder_history, prepare_payment_
		// reminder_email, get_settings, set_setting) получают значения из кода.
		ПеререгистрироватьВсеToolsСохранивНастройки();

		// Справочник настроек заполняется ТУТ ЖЕ, а не только кнопкой формы
		// списка: иначе после накатывания релиза ar_ДополнительныеНастройки
		// остаётся пустым, и администратор обязан угадать имя ключа руками.
		// Идемпотентно: существующие ключи и их значения не трогаются.
		ar_Настройки.ЗаполнитьТиповыеНастройки();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ЗарегистрироватьToolПоискаОрганизаций" Тогда
		// ORG-01: та же идемпотентная перерегистрация с сохранением админских
		// настроек - создаёт карточку search_organizations и актуализирует
		// манифесты get_account_balance / find_overdue_receivables /
		// list_unpaid_invoices, в которые добавлен organization_name.
		ПеререгистрироватьВсеToolsСохранивНастройки();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "МигрироватьИменаToolsБухгалтерии" Тогда
		МигрироватьИменаToolsБухгалтерии();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ИнициализироватьПорогМедленногоTool" Тогда
		ИнициализироватьПорогМедленногоTool();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "МигрироватьКатегорииTools" Тогда
		МигрироватьКатегорииTools();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ПеререгистрироватьКатегорииTools" Тогда
		ar_ToolDispatcher.ЗарегистрироватьКатегории();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ЗаполнитьКраткиеОписанияИКлючевыеСловаTools" Тогда
		// SCALE-02: полная перерегистрация с сохранением админских настроек -
		// обновляет ar_КраткоеОписание всех 6 ядровых tool-модулей и заполняет
		// ar_КлючевыеСловаПараметров для всех записей ar_Tools.
		ПеререгистрироватьВсеToolsСохранивНастройки();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ЗарегистрироватьToolРеестрПоиска" Тогда
		// SCALE-03: та же идемпотентная перерегистрация с сохранением
		// админских настроек - создаёт карточки find_tools/describe_tool
		// (ar_ToolРеестрПоиск), не трогая ar_ТребуетApproval/ar_Включён уже
		// существующих записей.
		ЗарегистрироватьToolРеестрПоиска();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ОтключитьCodeTools" Тогда
		// SEC-TOOL-02 (релиз 1/2): найти и отключить карточки tools в режиме
		// «Код» перед удалением механизма в следующем релизе.
		ОтключитьCodeTools();
		Возврат;
	КонецЕсли;

	Если Идентификатор = "ИнициализироватьПрогрессивнуюВыдачу" Тогда
		// SCALE-05: дефолт 25 в константе + always-on ядро Уровня 0.
		ИнициализироватьПрогрессивнуюВыдачу();
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Неизвестный идентификатор обработчика обновления: ""%1""';
		     |en = 'Unknown update handler identifier: ""%1""'"),
		Идентификатор);

КонецПроцедуры

// TOOL-19: полная перерегистрация tools с сохранением админских настроек.
//
// Зачем не голый ЗарегистрироватьВсеTools: upsert карточки безусловно
// перезаписывает ar_ТребуетApproval и ar_Включён значениями из кода. Это поля
// воли администратора, а не описания tool: пользователь мог вручную включить
// approval у create_reconciliation_act (в коде ТребуетApproval = Ложь по
// решению 2026-07-21, .docs/specs/RECON-01.md) или отключить ненужный tool.
// Без снимка обновление версии молча вернуло бы всё к умолчаниям кода.
//
// Порядок: снять текущие значения → перерегистрировать → вернуть снятое тем
// карточкам, что существовали ДО регистрации. Новые карточки (ask_user)
// получают значения из кода - восстанавливать им нечего.
//
// Вызывается из ВызватьОбработчикПоИдентификатору, уже в привилегированном
// режиме - сама привилегии не поднимает.
//
Процедура ПеререгистрироватьВсеToolsСохранивНастройки()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_ТребуетApproval КАК ТребуетApproval,
		|	Tools.ar_Включён КАК Включён
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";

	Снимок = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Снимок.Вставить(Выборка.Ссылка,
			Новый Структура("ТребуетApproval, Включён",
				Выборка.ТребуетApproval, Выборка.Включён));
	КонецЦикла;

	ar_ToolDispatcher.ЗарегистрироватьВсеTools();

	Для Каждого КлючЗначение Из Снимок Цикл

		Настройки = КлючЗначение.Значение;

		Попытка

			// Читаем и сравниваем ДО открытия транзакции: если регистрация
			// ничего не поменяла (обычный случай - значения кода совпали с
			// админскими), записи и транзакции вообще не нужно.
			Объект = КлючЗначение.Ключ.ПолучитьОбъект();

			// Карточку могли пометить на удаление между снимком и записью.
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если Объект.ar_ТребуетApproval = Настройки.ТребуетApproval
				И Объект.ar_Включён = Настройки.Включён Тогда
				Продолжить;
			КонецЕсли;

			Объект.ar_ТребуетApproval = Настройки.ТребуетApproval;
			Объект.ar_Включён = Настройки.Включён;

			НачатьТранзакцию();
			Попытка
				Объект.Записать();
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;

		Исключение
			// Одна несохранившаяся карточка не должна ронять всё обновление:
			// остальные настройки восстановить важнее.
			ЗаписьЖурналаРегистрации(
				"AgentRunner.ПеререгистрироватьВсеTools",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				НСтр("ru='Не удалось восстановить настройки tool: ';
				     |en='Failed to restore tool settings: '")
					+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// PKG-09: переписывает старые (без namespace) имена 10 tools, перенесённых в
// пакет "AgentRunner Бухгалтерия", на новые ("buh_"-префикс) везде, где на них
// ссылаются по строковому имени:
//   1. Справочник.ar_Агенты.ar_ДоступныеTools.ar_Tool - ТЧ, строковая связь.
//   2. Справочник.ar_Пресеты.ar_JSON - хранимый JSON пресета
//      ({"agent":{"tools":[{"name":"..."}]}}) - переименование ЧЕРЕЗ ПАРСИНГ
//      JSON (см. ЗаменитьИменаToolsВJSON), не текстовой заменой: ключ "name"
//      в контракте пресета встречается неоднозначно (agent.name, tools[].name,
//      skills[].name).
// Ссылки НЕ удаляются молча - переписываются, список изменений пишется в
// ar_СлужебныйЛог и аудит (Вопрос имён .docs/specs/PKG-09.md). Исторические
// записи ar_ДействияАгента НЕ трогаются - аудит неизменяем.
//
// Если пакет "buh" ещё не установлен на момент миграции - переименование всё
// равно выполняется (агент должен ссылаться на актуальное имя, когда пакет
// появится), но администратору дополнительно пишется предупреждение со
// списком затронутых агентов.
//
// Вызывается из ВызватьОбработчикПоИдентификатору, уже в привилегированном
// режиме - сама функция повторно привилегии не поднимает (кроме точечной
// записи объектов, где привилегии нужны на запись служебных справочников).
//
Процедура МигрироватьИменаToolsБухгалтерии()

	Сопоставление = НовоеСопоставлениеИменToolsБухгалтерии();

	ЗатронутыеАгенты = Новый Массив;
	Всего = МигрироватьToolsАгентов(Сопоставление, ЗатронутыеАгенты);
	Всего = Всего + МигрироватьToolsПресетов(Сопоставление);

	Если Всего = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.МигрироватьИменаToolsБухгалтерии",
			"pkg09_no_legacy_names_found",
			"Старых (без buh_) имён переносимых tools не найдено ни в"
				+ " ar_ДоступныеTools, ни в ar_Пресеты - переименовывать нечего.");
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.МигрироватьИменаToolsБухгалтерии",
		"pkg09_tools_renamed",
		СтрШаблон("Переименовано ссылок: %1. Затронутые агенты: %2.",
			Всего, СтрСоединить(ЗатронутыеАгенты, ", ")));

	ИзвестныеNamespace = ar_ToolПакеты.ВсеИзвестныеNamespace();
	ПакетАктивен = Ложь;
	Если ИзвестныеNamespace.Получить("buh") <> Неопределено Тогда
		ПакетАктивен = ИзвестныеNamespace.Получить("buh");
	КонецЕсли;

	Если Не ПакетАктивен И ЗатронутыеАгенты.Количество() > 0 Тогда
		ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.МигрироватьИменаToolsБухгалтерии",
			"pkg09_package_not_installed_warning",
			СтрШаблон("Имена tools переписаны на buh_*, но пакет ""AgentRunner"
				+ " Бухгалтерия"" не установлен - до его установки перечисленные"
				+ " агенты не смогут вызывать эти 10 tools: %1. Установите пакет"
				+ " через ""Дополнительные отчёты и обработки"" и подключите его"
				+ " в AgentRunner.", СтрСоединить(ЗатронутыеАгенты, ", ")),
			"Предупреждение");
	КонецЕсли;

КонецПроцедуры

// PERF-05: разовая инициализация порога автообнаружения медленных tools.
//
// Ставит 15 секунд, только если константа пуста (0) И запись о ней ещё не
// делалась. Повторно не перетирает: 0, выставленный администратором осознанно
// ("выключить автообнаружение"), должен сохраняться - поэтому обработчик
// выполняется ровно один раз, на переходе к 0.1.0.252.
//
Процедура ИнициализироватьПорогМедленногоTool()

	ДефолтныйПорогСек = 15;

	ТекущееЗначение = Константы.ar_ПорогМедленногоTool.Получить();
	Если ТипЗнч(ТекущееЗначение) = Тип("Число") И ТекущееЗначение <> 0 Тогда
		// Значение уже задано администратором - не трогаем.
		Возврат;
	КонецЕсли;

	Константы.ar_ПорогМедленногоTool.Установить(ДефолтныйПорогСек);

	ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.ИнициализироватьПорогМедленногоTool",
		"perf05_threshold_initialized",
		СтрШаблон("Порог автообнаружения медленных tools установлен в %1 сек."
			+ " Значение 0 отключает автообнаружение.", ДефолтныйПорогСек),
		"Информация");

КонецПроцедуры

// SCALE-05: разовая инициализация прогрессивной выдачи tools.
//
// Шаг 1. Ставит дефолт 25 в ar_ПорогПрогрессивнойВыдачи, только если константа
// пуста (0) - тот же паттерн, что ИнициализироватьПорогМедленногоTool, но без
// его семантики «0 = осознанно выключено»: для этой константы 0 значит только
// «не инициализирована» (см. докстринг ar_Константы.ПорогПрогрессивнойВыдачи).
// Геттер и так подставляет 25 на лету при 0, поэтому повторный прогон
// безопасен - если администратор позже поставит 0 вручную, следующий прогон
// (переустановка расширения на этой же версии не происходит, но проверка не
// перетирает уже непустое значение) не откатит его обратно.
//
// Шаг 2. Проставляет ar_ВсегдаВКонтексте=Истина минимальному ядровому набору
// Уровня 0 (План §3.3): find_tools, describe_tool, ask_user, query,
// search_metadata, get_current_context. Это upsert по имени - если записи ещё
// нет в реестре (модуль ar_ToolUniversal/ar_ToolInteraction/ar_ToolРеестрПоиск
// не зарегистрирован на этой базе), запись просто пропускается, без ошибки.
// Идемпотентно: запись, у которой ar_ВсегдаВКонтексте уже Истина, не трогается
// (Записать() не вызывается).
//
Процедура ИнициализироватьПрогрессивнуюВыдачу()

	ДефолтныйПорог = 25;

	ТекущийПорог = Константы.ar_ПорогПрогрессивнойВыдачи.Получить();
	Если ТипЗнч(ТекущийПорог) <> Тип("Число") ИЛИ ТекущийПорог = 0 Тогда
		Константы.ar_ПорогПрогрессивнойВыдачи.Установить(ДефолтныйПорог);
	КонецЕсли;

	ИменаЯдраУровня0 = Новый Массив;
	ИменаЯдраУровня0.Добавить("find_tools");
	ИменаЯдраУровня0.Добавить("describe_tool");
	ИменаЯдраУровня0.Добавить("ask_user");
	ИменаЯдраУровня0.Добавить("query");
	ИменаЯдраУровня0.Добавить("search_metadata");
	ИменаЯдраУровня0.Добавить("get_current_context");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имена", ИменаЯдраУровня0);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_ВсегдаВКонтексте КАК ВсегдаВКонтексте
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя В (&Имена)
		|	И НЕ Tools.ПометкаУдаления";

	Проставлено = 0;
	УжеБылоУстановлено = 0;
	НеНайденныеИмена = Новый Массив;
	НайденныеИмена = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НайденныеИмена.Вставить(СокрЛП(Выборка.Имя), Истина);

		Если Выборка.ВсегдаВКонтексте = Истина Тогда
			УжеБылоУстановлено = УжеБылоУстановлено + 1;
			Продолжить; // Идемпотентность - уже проставлено (повторный прогон).
		КонецЕсли;

		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Объект.ar_ВсегдаВКонтексте = Истина;

			НачатьТранзакцию();
			Попытка
				Объект.Записать();
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;

			Проставлено = Проставлено + 1;
		Исключение
			ar_СлужебныйЛог.Записать(
				"ar_ОбновлениеРасширения.ИнициализироватьПрогрессивнуюВыдачу",
				"scale05_always_in_context_row_error",
				СокрЛП(Строка(Выборка.Имя)) + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
				"Предупреждение");
		КонецПопытки;

	КонецЦикла;

	Для Каждого ИмяЯдра Из ИменаЯдраУровня0 Цикл
		Если НайденныеИмена.Получить(ИмяЯдра) = Неопределено Тогда
			НеНайденныеИмена.Добавить(ИмяЯдра);
		КонецЕсли;
	КонецЦикла;

	ТекстНеНайденных = ?(НеНайденныеИмена.Количество() = 0, "-", СтрСоединить(НеНайденныеИмена, ", "));
	ar_СлужебныйЛог.Записать(
		"ar_ОбновлениеРасширения.ИнициализироватьПрогрессивнуюВыдачу",
		"scale05_progressive_disclosure_initialized",
		СтрШаблон("Порог прогрессивной выдачи: дефолт %1 (если константа была пуста)."
				+ " ar_ВсегдаВКонтексте проставлен для %2 записей, уже было установлено у %3."
				+ " Не найдено в реестре (пропущено, не ошибка): %4.",
			ДефолтныйПорог, Проставлено, УжеБылоУстановлено, ТекстНеНайденных),
		"Информация");

КонецПроцедуры

// SCALE-03: регистрирует find_tools/describe_tool (ar_ToolРеестрПоиск) на
// существующей базе. Вызывается из ВызватьОбработчикПоИдентификатору, уже в
// привилегированном режиме - сама привилегии не поднимает.
//
// Порядок:
//  1. Прямой вызов ar_ToolРеестрПоиск.ЗарегистрироватьTools() - получает
//     точную статистику {Создано, Обновлено} по двум новым записям для лога
//     (спека SCALE-03, «Обработчик обновления», пункт 3).
//  2. ПеререгистрироватьВсеToolsСохранивНастройки() - тот же паттерн, что и
//     у SCALE-02/PAY-01/ORG-01: полная идемпотентная перерегистрация всех
//     модулей с сохранением админских ar_ТребуетApproval/ar_Включён для уже
//     существующих карточек (у find_tools/describe_tool "снимка" ещё нет -
//     это их первая регистрация, шаг 1 уже создал карточки со значениями из
//     кода, шаг 2 их не откатывает).
//  3. ПересчитатьДоступностьВсехTools() выполняется внутри
//     ar_ToolDispatcher.ЗарегистрироватьВсеTools() (вызывается на шаге 2) -
//     find_tools/describe_tool получают ar_Доступен=Истина автоматически,
//     т.к. ar_ТребуемыеОбъекты у обоих пуст (ядровые tools без внешних
//     зависимостей, тот же путь, что и у остальных шести ядровых модулей).
//
Процедура ЗарегистрироватьToolРеестрПоиска()

	Статистика = ar_ToolРеестрПоиск.ЗарегистрироватьTools();

	ПеререгистрироватьВсеToolsСохранивНастройки();

	ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.ЗарегистрироватьToolРеестрПоиска",
		"scale03_registry_search_registered",
		СтрШаблон("find_tools/describe_tool зарегистрированы. Создано: %1, обновлено: %2.",
			Статистика.Создано, Статистика.Обновлено),
		"Информация");

КонецПроцедуры

// SEC-TOOL-02 (релиз 1/2): находит карточки ar_Tools с ar_ТипРеализации="Код"
// и отключает их (ar_Включён = Ложь), не изменяя ar_ТребуетApproval и не
// удаляя карточку - администратор сохраняет возможность переоформить tool как
// пакет (PKG-04), но диспетчер (ar_ToolDispatcher) уже не может его вызвать,
// т.к. ветвление режима «Код» удалено из кода в этом же релизе.
//
// Идемпотентность: повторный прогон (например, при переустановке расширения)
// пропускает уже отключённые карточки - фиксируется только реально изменённое
// количество. Уже отключённая администратором ДО обновления карточка (Ложь
// изначально) не даёт ложного "затронуто N" в логе.
//
// Каждое отключение фиксируется дважды - тот же принцип, что в
// ar_ЗафиксироватьИзменениеКодаTool (Catalogs.ar_Tools.ObjectModule):
//  * ar_AuditСобытия (CodeToolsDisabled) - для подсистемы аудита/compliance;
//  * ar_СлужебныйЛог (событие "code_tools_disabled") - для технической
//    диагностики и баннера на панели настроек (см. HTMLСекцияCodeToolsОтключены
//    в CommonForm ar_Настройки, которая считает именно записи с этим именем
//    события).
//
// Вызывается из ВызватьОбработчикПоИдентификатору, уже в привилегированном
// режиме - сама привилегии не поднимает повторно (кроме записи объекта
// справочника, которая требует Write - привилегии уже активны на всём пути).
//
Процедура ОтключитьCodeTools()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_Включён КАК Включён
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_ТипРеализации = ""Код""
		|	И НЕ Tools.ПометкаУдаления";

	ЗатронутыеИмена = Новый Массив;
	ПропущенныеУжеОтключённые = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.Включён <> Истина Тогда
			ПропущенныеУжеОтключённые = ПропущенныеУжеОтключённые + 1;
			Продолжить; // Уже отключена (ручным действием администратора либо повторным прогоном).
		КонецЕсли;

		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Объект.ar_Включён = Ложь;
			Объект.Записать();
		Исключение
			ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.ОтключитьCodeTools",
				"code_tools_disable_error",
				СтрШаблон("Не удалось отключить tool ""%1"": %2", Выборка.Имя,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
				"Ошибка");
			Продолжить;
		КонецПопытки;

		ЗатронутыеИмена.Добавить(СокрЛП(Выборка.Имя));

		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("tool", СокрЛП(Выборка.Имя));
		ДанныеСобытия.Вставить("reason", "sec_tool_02_release_1");
		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(
			"", Перечисления.ar_ТипСобытия.CodeToolsDisabled, ДанныеСобытия);

	КонецЦикла;

	Если ЗатронутыеИмена.Количество() = 0 Тогда
		ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.ОтключитьCodeTools",
			"code_tools_disabled",
			СтрШаблон("Карточек в режиме «Код» для отключения не найдено (уже отключённых: %1).",
				ПропущенныеУжеОтключённые),
			"Информация");
		Возврат;
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.ОтключитьCodeTools",
		"code_tools_disabled",
		СтрШаблон("Отключено %1 tool(s) в режиме «Код»: %2. Переоформите нужные как пакет"
				+ " инструментов (PKG-04) - см. .docs/Tutorial-свой-tool.md.",
			ЗатронутыеИмена.Количество(), СтрСоединить(ЗатронутыеИмена, ", ")),
		"Предупреждение");

КонецПроцедуры

// SCALE-01: заводит ядровые категории (ar_КатегорииTools, upsert по Код) и
// переписывает ar_Tools.ar_Категория с русского текста (было захардкожено в
// ar_ToolDispatcher.ПредставленияTools ДО SCALE-01) на технический код -
// тот же список сопоставления "текст -> код", что и в
// ar_ToolDispatcher.СписокЯдровыхКатегорий (единственный источник истины,
// не дублируется здесь).
//
// Идемпотентна: запись, у которой ar_Категория уже равна коду (совпадает с
// Код какой-либо ядровой категории), не трогается - повторный прогон
// обработчика (например, на уже мигрированной базе) не создаёт лишних
// Записать(). Записи с пустым/неизвестным значением (сторонние tools вне
// ядрового списка) не трогаются вовсе - как и в ЗаполнитьПредставленияВсехTools,
// на который заведомо есть та же защита.
//
// Ошибка одной записи не должна ронять миграцию остальных - по паттерну
// ВыполнитьОдинОбработчик (см. вызывающую сторону), здесь дополнительно
// каждая запись оборачивается в свою Попытка.
//
// Вызывается из ВызватьОбработчикПоИдентификатору, уже в привилегированном
// режиме - сама процедура повторно привилегии не поднимает (кроме точечной
// записи объектов, где привилегии нужны на запись служебных справочников).
//
Процедура МигрироватьКатегорииTools()

	// Шаг 1: ядровые категории (Код, Наименование, ОписаниеДляLLM, Порядок) -
	// ДО миграции значений ar_Tools.ar_Категория, чтобы UI (ar_Диалог.
	// СписокВсехTools) сразу мог резолвить код в человекочитаемое имя.
	ИтогКатегорий = ar_ToolDispatcher.ЗарегистрироватьКатегории();

	// Шаг 2: текст -> код в ar_Tools.ar_Категория. Сопоставление строится из
	// СписокЯдровыхКатегорий (СтароеПредставление -> Код) - тот же список,
	// что заводит категории на шаге 1.
	СопоставлениеТекстВКод = Новый Соответствие;
	КодыЯдровыхКатегорий = Новый Соответствие;
	Для Каждого Категория Из ar_ToolDispatcher.СписокЯдровыхКатегорий() Цикл
		СопоставлениеТекстВКод.Вставить(Категория.СтароеПредставление, Категория.Код);
		КодыЯдровыхКатегорий.Вставить(Категория.Код, Истина);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.Ссылка КАК Ссылка,
		|	Tools.ar_Имя КАК Имя,
		|	Tools.ar_Категория КАК Категория
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	НЕ Tools.ПометкаУдаления";

	Мигрировано = 0;
	НеСопоставленныеИмена = Новый Массив;

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл

			ТекущееЗначение = СокрЛП(?(ТипЗнч(Выборка.Категория) = Тип("Строка"), Выборка.Категория, ""));

			Если ПустаяСтрока(ТекущееЗначение) Тогда
				Продолжить; // Не заполнено - нечего мигрировать.
			КонецЕсли;

			Если КодыЯдровыхКатегорий.Получить(ТекущееЗначение) <> Неопределено Тогда
				Продолжить; // Уже код (повторный прогон обработчика - идемпотентность).
			КонецЕсли;

			НовыйКод = СопоставлениеТекстВКод.Получить(ТекущееЗначение);
			Если НовыйКод = Неопределено Тогда
				// Неизвестное значение - сторонний tool вне ядрового списка
				// функций-геттеров, либо ar_Категория уже занята чем-то не из
				// известных 10 русских текстов. Не трогаем, только фиксируем.
				НеСопоставленныеИмена.Добавить(СокрЛП(Строка(Выборка.Имя)) + " (""" + ТекущееЗначение + """)");
				Продолжить;
			КонецЕсли;

			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Объект.ar_Категория = НовыйКод;

				НачатьТранзакцию();
				Попытка
					Объект.Записать();
					ЗафиксироватьТранзакцию();
				Исключение
					ОтменитьТранзакцию();
					ВызватьИсключение;
				КонецПопытки;

				Мигрировано = Мигрировано + 1;
			Исключение
				// Сбой на одной записи не должен ронять миграцию остальных.
				ar_СлужебныйЛог.Записать(
					"ar_ОбновлениеРасширения.МигрироватьКатегорииTools",
					"scale01_category_migration_row_error",
					СокрЛП(Строка(Выборка.Имя)) + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
					"Предупреждение");
			КонецПопытки;

		КонецЦикла;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать(
			"ar_ОбновлениеРасширения.МигрироватьКатегорииTools",
			"scale01_category_migration_failed",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	// Шаг 3: пересинхронизировать ar_Представление/ar_Категория для всех
	// записей реестра - ЗаполнитьПредставленияВсехTools теперь пишет код
	// категории (см. ar_ToolDispatcher.ПредставленияTools, SCALE-01), а не
	// текст, поэтому уже мигрированные вручную/повторно записи тоже сверяются.
	ar_ToolDispatcher.ЗаполнитьПредставленияВсехTools();

	ТекстНеСопоставленных = ?(НеСопоставленныеИмена.Количество() = 0, "-", СтрСоединить(НеСопоставленныеИмена, "; "));
	ar_СлужебныйЛог.Записать(
		"ar_ОбновлениеРасширения.МигрироватьКатегорииTools",
		"scale01_categories_migrated",
		СтрШаблон("Категорий заведено/обновлено: создано %1, обновлено %2."
			+ " Записей ar_Tools мигрировано (текст -> код): %3. Не сопоставлено: %4.",
			ИтогКатегорий.Создано, ИтогКатегорий.Обновлено, Мигрировано, ТекстНеСопоставленных),
		?(НеСопоставленныеИмена.Количество() = 0, "Информация", "Предупреждение"));

КонецПроцедуры

// Соответствие "старое имя tool" -> "новое имя с префиксом buh_" - точный
// список 10 tools, перенесённых из ar_ToolCRM/ar_ToolДокументы/ar_ToolФинансы
// в пакет "AgentRunner Бухгалтерия" (см. .docs/specs/PKG-09.md).
//
Функция НовоеСопоставлениеИменToolsБухгалтерии()

	Сопоставление = Новый Соответствие;
	Сопоставление.Вставить("search_clients", "buh_search_clients");
	Сопоставление.Вставить("update_client_contact", "buh_update_client_contact");
	Сопоставление.Вставить("create_invoice_draft", "buh_create_invoice_draft");
	Сопоставление.Вставить("get_invoice", "buh_get_invoice");
	Сопоставление.Вставить("validate_document", "buh_validate_document");
	Сопоставление.Вставить("create_reconciliation_act", "buh_create_reconciliation_act");
	Сопоставление.Вставить("get_account_balance", "buh_get_account_balance");
	Сопоставление.Вставить("find_overdue_receivables", "buh_find_overdue_receivables");
	Сопоставление.Вставить("search_organizations", "buh_search_organizations");
	Сопоставление.Вставить("list_unpaid_invoices", "buh_list_unpaid_invoices");
	Возврат Сопоставление;

КонецФункции

// Переписывает строки ar_Агенты.ar_ДоступныеTools.ar_Tool со старыми именами
// на новые (buh_*). Добавляет представление изменённого агента в
// ЗатронутыеАгенты (по ссылке, без дублей).
//
// Параметры:
//  Сопоставление     - Соответствие - см. НовоеСопоставлениеИменToolsБухгалтерии.
//  ЗатронутыеАгенты  - Массив - накопитель представлений изменённых агентов.
//
// Возвращаемое значение:
//  Число - количество переписанных строк ТЧ.
//
Функция МигрироватьToolsАгентов(Знач Сопоставление, ЗатронутыеАгенты)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Ссылка КАК Ссылка,
		|	Агенты.Представление КАК Представление
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	НЕ Агенты.ПометкаУдаления
		|	И Агенты.Ссылка В
		|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДоступныеTools.Ссылка КАК Ссылка
		|		ИЗ
		|			Справочник.ar_Агенты.ar_ДоступныеTools КАК ДоступныеTools
		|		ГДЕ
		|			ДоступныеTools.ar_Tool В (&СтарыеИмена))";
	Запрос.УстановитьПараметр("СтарыеИмена", НовыйМассивКлючейСоответствия(Сопоставление));

	Всего = 0;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ИзменилиАгента = Ложь;
			Для Каждого СтрокаТЧ Из Объект.ar_ДоступныеTools Цикл
				НовоеИмя = Сопоставление.Получить(СокрЛП(СтрокаТЧ.ar_Tool));
				Если НовоеИмя <> Неопределено Тогда
					СтрокаТЧ.ar_Tool = НовоеИмя;
					Всего = Всего + 1;
					ИзменилиАгента = Истина;
				КонецЕсли;
			КонецЦикла;

			Если ИзменилиАгента Тогда
				Объект.Записать();
				ЗатронутыеАгенты.Добавить(СокрЛП(Строка(Выборка.Представление)));
			КонецЕсли;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.МигрироватьToolsАгентов",
			"pkg09_agents_migration_failed",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат Всего;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Всего;

КонецФункции

// Переименовывает tools[].name внутри Справочник.ar_Пресеты.ar_JSON (хранимые
// пресеты, формат см. ar_ПресетыИмпорт) через ЗаменитьИменаToolsВJSON -
// точечная правка после парсинга JSON, а не текстовая замена (см. докстринг
// ЗаменитьИменаToolsВJSON - ключ "name" в контракте пресета неоднозначен).
//
// Параметры:
//  Сопоставление - Соответствие - см. НовоеСопоставлениеИменToolsБухгалтерии.
//
// Возвращаемое значение:
//  Число - количество изменённых записей ar_Пресеты (не отдельных tools).
//
Функция МигрироватьToolsПресетов(Знач Сопоставление)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пресеты.Ссылка КАК Ссылка,
		|	Пресеты.ar_JSON КАК JSON
		|ИЗ
		|	Справочник.ar_Пресеты КАК Пресеты
		|ГДЕ
		|	НЕ Пресеты.ПометкаУдаления";

	Изменено = 0;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИсходныйJSON = Выборка.JSON;
			Если ТипЗнч(ИсходныйJSON) <> Тип("Строка") Или ПустаяСтрока(ИсходныйJSON) Тогда
				Продолжить;
			КонецЕсли;

			НовыйJSON = ЗаменитьИменаToolsВJSON(ИсходныйJSON, Сопоставление);
			Если НовыйJSON = ИсходныйJSON Тогда
				Продолжить;
			КонецЕсли;

			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Объект.ar_JSON = НовыйJSON;
			Объект.Записать();
			Изменено = Изменено + 1;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ar_СлужебныйЛог.Записать("ar_ОбновлениеРасширения.МигрироватьToolsПресетов",
			"pkg09_presets_migration_failed",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат Изменено;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Изменено;

КонецФункции

// Переименовывает элементы agent.tools[].name внутри JSON пресета (формат -
// см. докстринг ar_ПресетыИмпорт, "name" встречается ТРИЖДЫ в контракте
// пресета: agent.name, tools[].name, skills[].name - поэтому правка идёт
// через ПАРСИНГ JSON и точечную модификацию нужного узла, а не текстовой
// заменой подстроки "name": "..." - последняя случайно задела бы имя агента
// или skill, совпавшее по тексту с именем tool).
//
// Возвращаемое значение:
//  Строка - изменённый JSON, либо ИСХОДНЫЙ ТекстJSON без изменений, если
//  разбор не удался или структура не содержит agent.tools (fail-safe -
//  повреждённый/нетиповой пресет не трогаем).
//
Функция ЗаменитьИменаToolsВJSON(Знач ТекстJSON, Знач Сопоставление)

	Разобрано = ar_JSON.ИзJSON(ТекстJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат ТекстJSON;
	КонецЕсли;

	БлокАгента = Разобрано.Получить("agent");
	Если ТипЗнч(БлокАгента) <> Тип("Соответствие") Тогда
		Возврат ТекстJSON;
	КонецЕсли;

	МассивTools = БлокАгента.Получить("tools");
	Если ТипЗнч(МассивTools) <> Тип("Массив") Тогда
		Возврат ТекстJSON;
	КонецЕсли;

	ЧтоТоИзменилось = Ложь;
	Для Каждого ЭлементTool Из МассивTools Цикл
		Если ТипЗнч(ЭлементTool) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ИмяTool = ЭлементTool.Получить("name");
		Если ТипЗнч(ИмяTool) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		НовоеИмя = Сопоставление.Получить(СокрЛП(ИмяTool));
		Если НовоеИмя <> Неопределено Тогда
			ЭлементTool.Вставить("name", НовоеИмя);
			ЧтоТоИзменилось = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Не ЧтоТоИзменилось Тогда
		Возврат ТекстJSON;
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Разобрано);

КонецФункции

// Массив ключей Соответствия (для параметра запроса "В (&Массив)").
//
Функция НовыйМассивКлючейСоответствия(Знач Соответствие)
	Массив = Новый Массив;
	Для Каждого КлючЗначение Из Соответствие Цикл
		Массив.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат Массив;
КонецФункции

// Записывает версию, для которой обработчики обновления выполнены.
//
// Параметры:
//  Версия - Строка - версия расширения (метаданные .cfe).
//
Процедура УстановитьВерсиюРасширенияБД(Знач Версия)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.ar_ВерсияРасширенияБД.Установить(Версия);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// EXT-10: холдаут-проверка согласованности между списком пользовательских
// tool-модулей (ar_ToolПереопределяемый.ПриФормированииСпискаМодулейТулов) и
// фактическими ветвями ИначеЕсли в
// ar_ToolПереопределяемый.ВызватьПользовательскийТул. Рассинхрон (модуль
// заявлен в списке, но ветка не дописана) сам по себе безопасен для рантайма
// (см. ar_ToolПереопределяемый - ветвь Иначе вернёт unknown_module), поэтому
// это диагностика "желательно" (см. .docs/specs/EXT-10.md, раздел
// "Поведение"), не критичная проверка - ошибка одного модуля не должна
// прерывать запуск системы (см. Попытка ниже).
//
// Холдаут-вызов передаёт заведомо несуществующее ИмяПроцедуры - ветка
// пользовательского модуля обязана вернуть СВОЙ unknown_procedure/ошибку
// (JSON), а не тот же ответ, что и полностью нерезолвленный модуль. Не
// использует Выполнить()/Вычислить() - вызывает только уже существующий
// экспортный метод ar_ToolПереопределяемый.ВызватьПользовательскийТул.
//
// ВАЖНО: вызывается только на смене версии (см. ВыполнитьОбновлениеПриНеобходимости),
// не на каждом старте системы - холдаут реально исполняет пользовательский
// Диспетчер(...) с фиктивным именем процедуры, и если чья-то реализация
// делает что-то до проверки ИмяПроцедуры (не по канону второго уровня
// ветвления), возможен нежелательный побочный эффект. Признанный компромисс
// диагностики "желательно" (см. .docs/specs/EXT-10.md), не входит в
// обязательный DoD.
//
Процедура ПроверитьСогласованностьПользовательскихМодулей()

	Попытка
		Модули = Новый Массив;
		ar_ToolПереопределяемый.ПриФормированииСпискаМодулейТулов(Модули);

		Для Каждого ИмяМодуля Из Модули Цикл

			Попытка
				ОтветХолдаут = ar_ToolПереопределяемый.ВызватьПользовательскийТул(
					ИмяМодуля, "__ext10_holdout_check__", "{}", Новый Структура);

				Если ТипЗнч(ОтветХолдаут) = Тип("Строка") И СтрНайти(ОтветХолдаут, "unknown_module") > 0 Тогда
					ar_СлужебныйЛог.Записать(
						"ar_ОбновлениеРасширения.ПроверитьСогласованностьПользовательскихМодулей",
						"user_tool_module_not_wired",
						"Модуль '" + ИмяМодуля + "' заявлен в ar_ToolПереопределяемый."
							+ "ПриФормированииСпискаМодулейТулов, но не найден веткой "
							+ "ИначеЕсли в ВызватьПользовательскийТул (рассинхрон списка и ветвления).",
						"Предупреждение");
				КонецЕсли;
			Исключение
				// Ошибка внутри пользовательской ветки на холдаут-аргументах -
				// не наша забота (симметрично тому, как ar_ToolDispatcher не
				// оборачивает ядровые ветки в Попытка); модуль явно резолвится,
				// это и есть цель проверки - фиксируем только факт (Информация),
				// не Предупреждение/Ошибка, чтобы не путать с рассинхроном выше.
				ar_СлужебныйЛог.Записать(
					"ar_ОбновлениеРасширения.ПроверитьСогласованностьПользовательскихМодулей",
					"user_tool_module_holdout_exception",
					"Модуль '" + ИмяМодуля + "' резолвится, но холдаут-вызов вызвал исключение: "
						+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
					"Информация");
			КонецПопытки;

		КонецЦикла;
	Исключение
		ar_СлужебныйЛог.Записать(
			"ar_ОбновлениеРасширения.ПроверитьСогласованностьПользовательскихМодулей",
			"user_tool_consistency_check_error",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
