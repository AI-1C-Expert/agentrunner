// Общий модуль ar_HTTP (AOS HTTP-утилиты).
//
// Единственная точка исходящих HTTP-вызовов из ядра AgentRunner. Все LLM-провайдеры
// и интеграции обязаны использовать эту обёртку вместо прямого обращения к
// HTTPСоединение — это обеспечивает централизованный контроль allow-list,
// прокси, таймаутов, ограничения размера ответа и маскировки секретов.
//
// На этапе 0 модуль реализует только POST (HTTPS). Полные ограничения:
//   HTTP-02 — allow-list URL;
//   HTTP-03 — ограничение размера ответа;
//   HTTP-04 — заголовок Idempotency-Key;
//   HTTP-05 — поддержка прокси (необязательный 6-й параметр).
//
// Свойства модуля: Сервер, без привилегированного режима.
// См. спеку: .docs/specs/HTTP-01.md, Plan §3.8, §11.6.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет HTTP POST-запрос к внешнему URL.
//
// Параметры:
//   URL            - Строка        - полный URL вида https://api.openai.com/v1/chat/completions.
//   Заголовки      - Соответствие  - заголовки запроса (Строка → Строка).
//                                    Может быть Неопределено — будет создан пустой набор.
//   Тело           - Строка        - тело запроса (UTF-8 JSON). Может быть пустой строкой.
//   Таймаут        - Число         - таймаут в секундах. 0 → использовать значение по умолчанию (60).
//   IdempotencyKey - Строка        - HTTP-04: идемпотентный ключ (UUID) для защиты от двойной
//                                    оплаты LLM при ретраях. Если непустая строка — добавляется
//                                    в заголовки запроса как "Idempotency-Key". Если в параметре
//                                    "Заголовки" уже задан "Idempotency-Key" — не перетирается.
//                                    Дефолт "" — заголовок не добавляется, обратная совместимость.
//                                    Генерация UUID — на вызывающей стороне (стабильность при ретраях).
//   Прокси         - ИнтернетПрокси - HTTP-05: объект прокси-сервера, передаётся пятым позиционным
//                                    аргументом в конструктор HTTPСоединение. Дефолт Неопределено —
//                                    прокси не используется (полная обратная совместимость).
//                                    Получение объекта прокси — ответственность вызывающего
//                                    (типично — через БСП ПолучениеФайловИзИнтернета.ПолучитьПрокси).
//
// Возвращаемое значение:
//   Структура с ключами:
//     * КодСостояния  - Число        - 0 при сетевой ошибке или до соединения.
//     * Тело          - Строка       - UTF-8, пусто при ошибке соединения. Может быть обрезано при превышении лимита.
//     * Заголовки     - Соответствие - заголовки ответа, пусто при ошибке.
//     * Ошибка        - Строка       - пусто если успех; очищенное (без секретов) сообщение при ошибке.
//     * Предупреждение - Строка      - пусто при норме; локализованное описание, если тело было обрезано (HTTP-03).
//     * РазмерОтвета  - Число        - фактический размер тела в байтах до обрезки (0 при ошибке соединения).
//
Функция ВыполнитьPOST(URL, Заголовки, Тело, Таймаут = 0, IdempotencyKey = "", Прокси = Неопределено) Экспорт

	Результат = НовыйРезультат();

	ФактическийТаймаут = ?(Таймаут > 0, Таймаут, 60);

	Компоненты = РазобратьURL(URL);
	Если Компоненты = Неопределено Тогда
		Результат.Ошибка = "Не удалось разобрать URL";
		Возврат Результат;
	КонецЕсли;

	Если Компоненты.Протокол <> "https" Тогда
		// Исключение из https-only: локальные inference-серверы (LM Studio,
		// Ollama, LLaMA.cpp и т.п.) по умолчанию поднимаются без TLS на
		// loopback-адресе - трафик не покидает машину, шифрование не требуется.
		// Для всех остальных хостов схема обязана быть https (SEC/HTTP-01).
		Если Компоненты.Протокол <> "http" Или Не ЭтоLoopbackХост(Компоненты.Хост) Тогда
			Результат.Ошибка = "Схема не поддерживается: " + Компоненты.Протокол;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// HTTP-02: проверка allow-list URL.
	СписокHosts = ar_Константы.LLMAllowListURL();
	Если Не ХостВAllowList(Компоненты.Хост, СписокHosts) Тогда
		Результат.Ошибка = НСтр("ru = 'URL не входит в allowlist LLM'; en = 'URL is not in LLM allowlist'")
			+ ": " + Компоненты.Хост;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Если Компоненты.Протокол = "https" Тогда
			ЗащищённоеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС());
		Иначе
			ЗащищённоеСоединение = Неопределено;
		КонецЕсли;

		Соединение = Новый HTTPСоединение(
			Компоненты.Хост,
			Компоненты.Порт,
			,
			,
			Прокси,
			ФактическийТаймаут,
			ЗащищённоеСоединение);

		Запрос = Новый HTTPЗапрос(Компоненты.Путь);

		Если ТипЗнч(Заголовки) = Тип("Соответствие") Тогда
			Для Каждого КЗ Из Заголовки Цикл
				Запрос.Заголовки.Вставить(Строка(КЗ.Ключ), Строка(КЗ.Значение));
			КонецЦикла;
		КонецЕсли;

		// HTTP-04: заголовок идемпотентности для LLM-повторов.
		// Если вызывающий уже передал "Idempotency-Key" в параметре Заголовки,
		// его значение не перетирается.
		Если Не ПустаяСтрока(СокрЛП(IdempotencyKey))
				И Запрос.Заголовки.Получить("Idempotency-Key") = Неопределено Тогда
			Запрос.Заголовки.Вставить("Idempotency-Key", СокрЛП(IdempotencyKey));
		КонецЕсли;

		Если ТипЗнч(Тело) = Тип("Строка") И ЗначениеЗаполнено(Тело) Тогда
			Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8");
		КонецЕсли;

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Результат.КодСостояния = Ответ.КодСостояния;

		// HTTP-03: чтение тела с проверкой лимита размера.
		ДекодированноеТело = ДекодироватьОтветСЛимитом(Ответ, ar_Константы.МаксРазмерОтветаHTTP());
		Результат.Тело          = ДекодированноеТело.Тело;
		Результат.Предупреждение = ДекодированноеТело.Предупреждение;
		Результат.РазмерОтвета   = ДекодированноеТело.РазмерОтвета;

		Если ТипЗнч(Ответ.Заголовки) = Тип("Соответствие") Тогда
			Для Каждого КЗ Из Ответ.Заголовки Цикл
				Результат.Заголовки.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЦикла;
		КонецЕсли;

	Исключение
		Результат.КодСостояния = 0;
		Результат.Тело = "";
		Результат.Заголовки = Новый Соответствие;
		Результат.Ошибка = ar_Утилиты.МаскироватьСекреты(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт пустую структуру результата.
Функция НовыйРезультат()
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Тело", "");
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Предупреждение", "");
	Результат.Вставить("РазмерОтвета", 0);
	Возврат Результат;
КонецФункции

// Читает тело HTTP-ответа с проверкой лимита размера (HTTP-03).
//
// Алгоритм:
//  1. Получает тело как ДвоичныеДанные.
//  2. Если размер ≤ МаксРазмер — декодирует целиком в UTF-8.
//  3. Если размер > МаксРазмер — обрезает до МаксРазмер байт, декодирует,
//     заполняет поле Предупреждение и пишет уровень "Предупреждение" в
//     журнал регистрации (имя события "AgentRunner.HTTP").
//  4. При ошибке декодирования (например, обрезка посредине UTF-8 символа)
//     — возврат Тело = "", Предупреждение = локализованное сообщение.
//     Исключение не пробрасывается наружу.
//
// Параметры:
//   Ответ      - HTTPОтвет - объект HTTP-ответа.
//   МаксРазмер - Число     - максимальный допустимый размер в байтах (> 0).
//
// Возвращаемое значение:
//   Структура:
//     * Тело          - Строка - декодированное (возможно обрезанное) тело.
//     * Предупреждение - Строка - пусто или локализованное описание.
//     * РазмерОтвета  - Число  - фактический размер тела в байтах до обрезки.
//
Функция ДекодироватьОтветСЛимитом(Ответ, МаксРазмер)

	Результат = Новый Структура;
	Результат.Вставить("Тело", "");
	Результат.Вставить("Предупреждение", "");
	Результат.Вставить("РазмерОтвета", 0);

	ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ФактическийРазмер = ДвоичныеДанные.Размер();
	Результат.РазмерОтвета = ФактическийРазмер;

	Если ФактическийРазмер = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если ФактическийРазмер > МаксРазмер Тогда
		// Обрезаем и формируем предупреждение.
		ДанныеДляДекодирования = ДвоичныеДанные.ПолучитьЧасть(0, МаксРазмер);
		Результат.Предупреждение = СтрШаблон(
			НСтр("ru = 'Тело HTTP-ответа обрезано: %1 б > %2 б';
				 |en = 'HTTP response body truncated: %1 b > %2 b'"),
			Формат(ФактическийРазмер, "ЧГ=0"),
			Формат(МаксРазмер, "ЧГ=0"));
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			Результат.Предупреждение);
	Иначе
		ДанныеДляДекодирования = ДвоичныеДанные;
	КонецЕсли;

	Попытка
		Результат.Тело = ПолучитьСтрокуИзДвоичныхДанных(ДанныеДляДекодирования, "UTF-8");
	Исключение
		// Обрезка могла попасть в середину многобайтового UTF-8 символа.
		Результат.Тело = "";
		Результат.Предупреждение = НСтр(
			"ru = 'Не удалось декодировать тело ответа';
			 |en = 'Failed to decode response body'");
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			Результат.Предупреждение + ": "
				+ ar_Утилиты.МаскироватьСекреты(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Разбирает URL вида <схема>://<хост>[:<порт>][/<путь>] на компоненты.
//
// Параметры:
//   URL - Строка - произвольный URL.
//
// Возвращаемое значение:
//   Структура {Протокол, Хост, Порт, Путь} или Неопределено если разобрать не удалось.
//
Функция РазобратьURL(URL)

	Если ТипЗнч(URL) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Текст = СокрЛП(URL);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияСхемы = СтрНайти(Текст, "://");
	Если ПозицияСхемы = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Протокол = НРег(Лев(Текст, ПозицияСхемы - 1));
	Остаток  = Сред(Текст, ПозицияСхемы + 3);

	Если ПустаяСтрока(Остаток) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Отделяем путь от хоста.
	ПозицияСлеша = СтрНайти(Остаток, "/");
	Если ПозицияСлеша = 0 Тогда
		ХостПорт = Остаток;
		Путь = "/";
	Иначе
		ХостПорт = Лев(Остаток, ПозицияСлеша - 1);
		Путь = Сред(Остаток, ПозицияСлеша);
	КонецЕсли;

	Если ПустаяСтрока(ХостПорт) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Разделяем хост и порт.
	ПозицияДвоеточия = СтрНайти(ХостПорт, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Хост = ХостПорт;
		Порт = ?(Протокол = "https", 443, ?(Протокол = "http", 80, 0));
	Иначе
		Хост = Лев(ХостПорт, ПозицияДвоеточия - 1);
		ПортСтрока = Сред(ХостПорт, ПозицияДвоеточия + 1);
		Попытка
			Порт = Число(ПортСтрока);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ПустаяСтрока(Хост) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Компоненты = Новый Структура;
	Компоненты.Вставить("Протокол", Протокол);
	Компоненты.Вставить("Хост", Хост);
	Компоненты.Вставить("Порт", Порт);
	Компоненты.Вставить("Путь", Путь);
	Возврат Компоненты;

КонецФункции

// Проверяет, что хост указывает на локальную машину (loopback).
// Используется как единственное исключение из https-only (см. ВыполнитьPOST):
// локальные inference-серверы (LM Studio, Ollama и т.п.) по умолчанию
// поднимаются без TLS на loopback-адресе.
//
// Параметры:
//   Хост - Строка - хост из разобранного URL (без схемы и порта).
//
// Возвращаемое значение:
//   Булево - Истина, если хост - "localhost", "127.0.0.1" или "::1".
//
Функция ЭтоLoopbackХост(Хост)

	Если ТипЗнч(Хост) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Литералы "127.0.0.1"/"::1" - это не адрес окружения, а сравнение с
	// зарезервированной IANA-константой loopback (RFC 5735 / RFC 4291) для
	// security-проверки; линтер UsingHardcodeNetworkAddress ловит здесь
	// ожидаемое использование, не конфигурацию среды.
	ХостНРег = НРег(СокрЛП(Хост));
	Возврат ХостНРег = "localhost" Или ХостНРег = "127.0.0.1" Или ХостНРег = "::1";

КонецФункции

// Проверяет, входит ли хост в список разрешённых (allow-list).
//
// Семантика совпадения (в порядке приоритета):
//  1. Точное совпадение НРег(Хост) = НРег(ЭлементСписка).
//  2. Суффиксное совпадение: если элемент списка начинается с "." — хост
//     разрешается, если НРег(Хост) заканчивается на НРег(ЭлементСписка).
//     Например, ".openai.com" разрешает "api.openai.com", "streaming.openai.com",
//     но НЕ "evil-openai.com" (граница на точку).
//
// Сравнение регистронезависимое. Никаких regexp и Выполнить() — только
// платформенные строковые функции.
//
// Параметры:
//   Хост         - Строка - хост из разобранного URL (без схемы и порта).
//   СписокХостов - Массив - массив строк, как его возвращает ar_Константы.LLMAllowListURL().
//
// Возвращаемое значение:
//   Булево - Истина, если хост разрешён.
//
Функция ХостВAllowList(Хост, СписокХостов)

	Если ТипЗнч(Хост) <> Тип("Строка") Или ПустаяСтрока(Хост) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(СписокХостов) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	ХостНижнийРегистр = НРег(СокрЛП(Хост));

	Для Каждого Элемент Из СписокХостов Цикл

		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;

		ЭлементНормализованный = НРег(СокрЛП(Элемент));
		Если ПустаяСтрока(ЭлементНормализованный) Тогда
			Продолжить;
		КонецЕсли;

		// Точное совпадение.
		Если ХостНижнийРегистр = ЭлементНормализованный Тогда
			Возврат Истина;
		КонецЕсли;

		// Суффиксное совпадение: элемент начинается с точки.
		Если Лев(ЭлементНормализованный, 1) = "." Тогда
			Если СтрЗаканчиваетсяНа(ХостНижнийРегистр, ЭлементНормализованный) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
