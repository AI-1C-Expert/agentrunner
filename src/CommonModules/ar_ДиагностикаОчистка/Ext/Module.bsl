// Добавляет в документ один раздел лога: заголовок + построчный вывод всех
// колонок результата запроса + счётчик строк. Каждое строковое/JSON-значение
// пропускается через ar_Утилиты.МаскироватьСекреты - дополнительный барьер на
// случай, если в payload оказалось что-то, не покрытое маскированием при записи.
//
Процедура ДобавитьРазделРегистра(Документ, Знач Заголовок, Знач Запрос)

	Документ.ДобавитьСтроку(Заголовок);
	Документ.ДобавитьСтроку(СтрокаРазделительРаздела(СтрДлина(Заголовок)));

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Документ.ДобавитьСтроку("(нет записей)");
		Документ.ДобавитьСтроку(Разделитель());
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
	КонецЦикла;

	// Лимит на раздел - защита UI от подвисания при аномально большом объёме
	// накопленных служебных данных (см. МаксСтрокНаРаздел).
	МаксСтрокНаРаздел = 5000;
	КоличествоСтрок    = 0;
	Пока Выборка.Следующий() И КоличествоСтрок < МаксСтрокНаРаздел Цикл
		КоличествоСтрок = КоличествоСтрок + 1;
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Значение = Выборка[ИмяКолонки];
			Документ.ДобавитьСтроку("  " + ИмяКолонки + ": " + ЗначениеВСтроку(Значение));
		КонецЦикла;
		Документ.ДобавитьСтроку("");
	КонецЦикла;

	Если КоличествоСтрок >= МаксСтрокНаРаздел Тогда
		Документ.ДобавитьСтроку(СтрШаблон(
			"... (показаны первые %1 записей, остальные обрезаны)", МаксСтрокНаРаздел));
	КонецЕсли;

	Документ.ДобавитьСтроку(СтрШаблон("Всего записей в выгрузке: %1", КоличествоСтрок));
	Документ.ДобавитьСтроку(Разделитель());

КонецПроцедуры

// Приводит произвольное значение поля запроса к строке, пригодной для
// текстового лога: маскирует секреты в строковых значениях, разворачивает
// ссылки в их строковое представление.
//
Функция ЗначениеВСтроку(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ar_Утилиты.МаскироватьСекреты(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='yyyy-MM-dd HH:mm:ss'");
	Иначе
		Возврат ar_Утилиты.МаскироватьСекреты(Строка(Значение));
	КонецЕсли;

КонецФункции

Функция Разделитель()
	Возврат Символы.ПС;
КонецФункции

// Строка из символов "-" заданной длины (подчёркивание заголовка раздела).
// Не полагаемся на непроверенные "функции повтора строки" - явный цикл.
//
Функция СтрокаРазделительРаздела(Знач Длина)

	Результат = "";
	Для Индекс = 1 По Длина Цикл
		Результат = Результат + "-";
	КонецЦикла;
	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Очистка - удаление по регистрам и справочнику.

// Порционно удаляет все записи одного регистра сведений по его имени.
// Регистр обязан иметь ровно одно или два измерения (все служебные регистры
// расширения этому условию удовлетворяют - см. заголовок модуля).
//
Функция ОчиститьРегистрСведений(Результат, Знач ИмяРегистра)

	Попытка
		Возврат УдалитьВсеЗаписиРегистра(ИмяРегистра);
	Исключение
		Результат.Ошибки.Добавить(СтрШаблон("%1: %2",
			ИмяРегистра,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат 0;
	КонецПопытки;

КонецФункции

// Читает все ключевые поля (измерения) регистра порциями по 1000 и удаляет
// записи через пустой набор с заданным отбором - стандартный платформенный
// паттерн (см. ar_Scheduler.УдалитьУстаревшиеСобытияПорцией).
//
Функция УдалитьВсеЗаписиРегистра(Знач ИмяРегистра) Экспорт

	МенеджерРегистра  = РегистрыСведений[ИмяРегистра];
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);

	ИменаИзмерений = Новый Массив;
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		ИменаИзмерений.Добавить(Измерение.Имя);
	КонецЦикла;

	ТекстПоляВыборки  = "";
	ТекстУпорядочивания = "";
	Для Каждого ИмяИзм Из ИменаИзмерений Цикл
		Если НЕ ПустаяСтрока(ТекстПоляВыборки) Тогда
			ТекстПоляВыборки  = ТекстПоляВыборки + ", ";
			ТекстУпорядочивания = ТекстУпорядочивания + ", ";
		КонецЕсли;
		ТекстПоляВыборки  = ТекстПоляВыборки  + "Р." + ИмяИзм + " КАК " + ИмяИзм;
		ТекстУпорядочивания = ТекстУпорядочивания + "Р." + ИмяИзм;
	КонецЦикла;

	ТекстЗапроса = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1000 %1 ИЗ РегистрСведений.%2 КАК Р УПОРЯДОЧИТЬ ПО %3",
		ТекстПоляВыборки, ИмяРегистра, ТекстУпорядочивания);

	ВсегоУдалено = 0;
	МаксИтераций = 1000;
	НомерИтерации = 0;

	Пока НомерИтерации < МаксИтераций Цикл
		НомерИтерации = НомерИтерации + 1;

		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;

		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;

		Выборка = РезультатЗапроса.Выбрать();
		УдаленоВПорции = 0;
		Пока Выборка.Следующий() Цикл
			НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
			Для Каждого ИмяИзм Из ИменаИзмерений Цикл
				НаборЗаписей.Отбор[ИмяИзм].Использование = Истина;
				НаборЗаписей.Отбор[ИмяИзм].Значение = Выборка[ИмяИзм];
			КонецЦикла;
			// Записываем пустой набор - удаление записи регистра сведений (стандартный паттерн).
			НаборЗаписей.Записать();
			УдаленоВПорции = УдаленоВПорции + 1;
		КонецЦикла;

		ВсегоУдалено = ВсегоУдалено + УдаленоВПорции;
		Если УдаленоВПорции = 0 Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат ВсегоУдалено;

КонецФункции

// Удаляет все элементы справочника ar_ПамятьАгента порциями по 1000.
//
Функция ОчиститьСправочникПамятьАгента(Результат)

	Попытка

		ВсегоУдалено = 0;
		МаксИтераций = 1000;
		НомерИтерации = 0;

		Пока НомерИтерации < МаксИтераций Цикл
			НомерИтерации = НомерИтерации + 1;

			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1000
				|	П.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ar_ПамятьАгента КАК П
				|УПОРЯДОЧИТЬ ПО
				|	П.Ссылка";

			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				Прервать;
			КонецЕсли;

			Выборка = РезультатЗапроса.Выбрать();
			УдаленоВПорции = 0;
			Пока Выборка.Следующий() Цикл
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.Удалить();
					УдаленоВПорции = УдаленоВПорции + 1;
				КонецЕсли;
			КонецЦикла;

			ВсегоУдалено = ВсегоУдалено + УдаленоВПорции;
			Если УдаленоВПорции = 0 Тогда
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Возврат ВсегоУдалено;

	Исключение
		Результат.Ошибки.Добавить(СтрШаблон("ar_ПамятьАгента: %1",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат 0;
	КонецПопытки;

КонецФункции

// Имя текущего пользователя ИБ для заголовка лога и audit payload.
// Не Пользователи.ТекущийПользователь() (справочник Пользователи не заимствован
// в расширение - см. комментарий в ar_Диалог.Ext/Form/Module.bsl) - используем
// платформенный ПользователиИнформационнойБазы.
//
Функция ИмяТекущегоПользователя()

	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийПользовательИБ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТекущийПользовательИБ.Имя;

КонецФункции

#КонецОбласти
