////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ДиагностикаОчистка.
//
// Сбор служебной информации AgentRunner в текстовый документ (для анализа) и
// очистка служебных регистров/справочников по кнопкам формы ОбщаяФорма.ar_Диалог.
//
// Источники (все служебные объекты расширения, кроме ar_ХранилищеСекретов -
// оно намеренно исключено из выгрузки и очистки, т.к. хранит секреты
// провайдеров LLM):
//   РегистрСведений.ar_СобытияЗапуска, ar_Сессии, ar_Запуски, ar_ДействияАгента,
//   ar_МетрикиLLM, ar_ОчередьApproval, ar_ЗапрещённыеОбъекты,
//   ar_ПереопределенияОбъектов, ar_ПравилаМаскированияПДн;
//   Справочник.ar_ПамятьАгента.
//
// Очистка выполняется в привилегированном режиме (аналог ar_AuditЗащищённыйРежим -
// см. Plan §1.3): рядовые роли (ar_РольОператор/ar_РольАдмин) имеют на большинство
// этих регистров только Read/View, точечный подъём привилегий здесь оправдан
// тем же контрактом, что и плановая компакция ar_Scheduler.ОбработатьКомпакциюAudit.
//
// Запрещено: Выполнить(), Вычислить() (Plan §1.3).
//
// См. спеку: .docs/specs/UI-22-log-tools.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Собирает служебную информацию по всем audit/служебным объектам расширения в
// текстовый документ, удобный для последующего построчного анализа.
//
// Выполняется в привилегированном режиме (точечно, try/finally) - большинство
// ролей (ar_РольОператор/ar_РольЧитатель/ar_РольАдмин) не имеют Read на все
// служебные регистры (например, ar_Сессии, ar_МетрикиLLM), т.к. эти объекты
// не предназначены для прямого просмотра пользователем. Права ролей ради
// одной диагностической кнопки не расширяем - доступ идёт через этот фасад,
// тем же контрактом, что и ar_AuditЗащищённыйРежим.
//
// Возвращаемое значение:
//   ТекстовыйДокумент - готовый к показу/сохранению документ.
//
Функция СобратьСлужебныйЛог() Экспорт

	Документ = Новый ТекстовыйДокумент;

	Документ.ДобавитьСтроку("AgentRunner - служебный лог");
	Документ.ДобавитьСтроку("Версия расширения: " + ar_Утилиты.ВерсияРасширения());
	Документ.ДобавитьСтроку("Сформирован: " + Формат(ТекущаяДатаСеанса(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
	Документ.ДобавитьСтроку("Пользователь: " + ИмяТекущегоПользователя());
	Документ.ДобавитьСтроку(Разделитель());

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_СобытияЗапуска", ЗапросСобытияЗапуска());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_Сессии", ЗапросСессии());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_Запуски", ЗапросЗапуски());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_ДействияАгента", ЗапросДействияАгента());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_МетрикиLLM", ЗапросМетрикиLLM());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_ОчередьApproval", ЗапросОчередьApproval());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_ЗапрещённыеОбъекты", ЗапросЗапрещённыеОбъекты());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_ПереопределенияОбъектов", ЗапросПереопределенияОбъектов());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_ПравилаМаскированияПДн", ЗапросПравилаМаскированияПДн());
		ДобавитьРазделРегистра(Документ, "Справочник.ar_ПамятьАгента", ЗапросПамятьАгента());
		ДобавитьРазделРегистра(Документ, "РегистрСведений.ar_СлужебныйЛог (SESS-08)", ЗапросСлужебныйЛог());

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Документ;

КонецФункции

// Очищает все служебные регистры/справочники расширения (кроме
// ar_ХранилищеСекретов). Выполняется в привилегированном режиме, точечно,
// с гарантированным сбросом (try/finally).
//
// Возвращаемое значение:
//   Структура - {УспехОбщий (Булево), ВсегоУдалено (Число), Ошибки (Массив Строк)}.
//
Функция ОчиститьСлужебныеДанные() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("УспехОбщий",   Истина);
	Результат.Вставить("ВсегоУдалено", 0);
	Результат.Вставить("Ошибки",       Новый Массив);

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		Результат.ВсегоУдалено = Результат.ВсегоУдалено
			+ ОчиститьРегистрСведений(Результат, "ar_СобытияЗапуска");
		Результат.ВсегоУдалено = Результат.ВсегоУдалено
			+ ОчиститьРегистрСведений(Результат, "ar_Сессии");
		Результат.ВсегоУдалено = Результат.ВсегоУдалено
			+ ОчиститьРегистрСведений(Результат, "ar_Запуски");
		Результат.ВсегоУдалено = Результат.ВсегоУдалено
			+ ОчиститьРегистрСведений(Результат, "ar_ДействияАгента");
		Результат.ВсегоУдалено = Результат.ВсегоУдалено
			+ ОчиститьРегистрСведений(Результат, "ar_МетрикиLLM");
		Результат.ВсегоУдалено = Результат.ВсегоУдалено
			+ ОчиститьРегистрСведений(Результат, "ar_ОчередьApproval");
		Результат.ВсегоУдалено = Результат.ВсегоУдалено
			+ ОчиститьРегистрСведений(Результат, "ar_СлужебныйЛог");

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Результат.УспехОбщий = Ложь;
		Результат.Ошибки.Добавить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	// Итоговое audit-событие пишем после снятия привилегий этой функции -
	// ЗаписатьСобытиеПривилегированно сама точечно поднимает/сбрасывает режим.
	УстановитьПривилегированныйРежим(Ложь);

	Если Результат.Ошибки.Количество() > 0 Тогда
		Результат.УспехОбщий = Ложь;
	КонецЕсли;

	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("deleted_rows",   Результат.ВсегоУдалено);
	ПараметрыСобытия.Вставить("triggered_by",   "manual_ui");
	ПараметрыСобытия.Вставить("initiator",      ИмяТекущегоПользователя());
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно("", "AuditPurged", ПараметрыСобытия);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

