// Геттер пользовательских правил маскирования ПДн (PII-01).
//
// Хранилище правил - РегистрСведений.ar_ПравилаМаскированияПДн (измерения
// Объект/ИмяПоля, ресурсы Включён/СпособМаскирования/Причина/Автор/Создано).
// Подключение к реальной точке маскирования (ar_Утилиты.ОчиститьЗначениеПоля)
// выполнено в PII-04. Кэширование результата на время серверного вызова
// реализовано в отдельном модуле aosPersonalDataПовтИсп (PII-05,
// ReturnValuesReuse=НаВремяВызова) - публичная функция ЕстьПравилоПолногоСокрытия
// ниже лишь делегирует в него, не выполняя запрос напрямую.

// Проверить, есть ли включённое правило полного сокрытия для указанного поля объекта.
//
// Приоритет поиска:
//   1. Точное совпадение (Объект = ИмяОбъекта, ИмяПоля = ИмяПоля);
//   2. Правило "для всех объектов" (Объект = "*", ИмяПоля = ИмяПоля).
// Учитываются только записи с Включён = Истина и
// СпособМаскирования = ПолностьюСкрыть. Сравнение ИмяПоля - регистронезависимое.
//
// В отличие от ar_PermissionEngine.ОбъектЗапрещён (fail-closed), эта функция
// fail-open: пустые аргументы и ошибки чтения регистра не блокируют вызывающий
// код, а возвращают Ложь. Причина: это необязательная PII-функция для маскирования
// значений перед отдачей в LLM-контекст, а не guard записи в БД - отсутствие
// правила или сбой чтения не должны прерывать основной поток сериализации данных;
// запрет на показ поля достигается явным правилом, а не отказом функции.
//
// Публичная точка входа (используется ar_Утилиты.ОчиститьЗначениеПоля, PII-04).
// Тонкий фасад: делегирует в aosPersonalDataПовтИсп.ЕстьПравилоПолногоСокрытияКэшируемая,
// который кэширует результат на время текущего серверного вызова (PII-05) -
// сигнатура и контракт (типы аргументов/результата, fail-open поведение) не
// изменились относительно PII-01/PII-04.
//
// Параметры:
//   ИмяОбъекта - Строка - полное имя метаданных объекта, например "Справочник.Контрагенты".
//   ИмяПоля    - Строка - имя реквизита/поля объекта (точное имя, без wildcard).
//
// Возвращаемое значение:
//   Булево - Истина, если поле должно быть полностью скрыто.
//
Функция ЕстьПравилоПолногоСокрытия(ИмяОбъекта, ИмяПоля) Экспорт

	Если Не ЗначениеЗаполнено(ИмяОбъекта) Или Не ЗначениеЗаполнено(ИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат aosPersonalDataПовтИсп.ЕстьПравилоПолногоСокрытияКэшируемая(ИмяОбъекта, ИмяПоля);

КонецФункции

// Записать предупреждение в журнал регистрации.
//
// Параметры:
//   Событие              - Строка - имя события журнала регистрации.
//   Комментарий          - Строка - текст комментария.
//   ИнформацияОбОшибке   - ИнформацияОбОшибке, Неопределено - для детализации причины,
//                          если предупреждение вызвано перехваченным исключением.
//
Процедура ЗаписатьПредупреждение(Событие, Комментарий, Знач ИнформацияОбОшибке = Неопределено)

	ТекстКомментария = Комментарий;
	Если ИнформацияОбОшибке <> Неопределено Тогда
		ТекстКомментария = ТекстКомментария + Символы.ПС
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;

	ЗаписьЖурналаРегистрации(Событие,
		УровеньЖурналаРегистрации.Предупреждение, , , ТекстКомментария);

КонецПроцедуры

// Проверить (без кэша), есть ли включённое правило полного сокрытия для
// указанного поля объекта. Выполняет обращение к регистру на каждый вызов -
// не вызывать напрямую в обход кэша, используйте публичную
// ЕстьПравилоПолногоСокрытия (делегирует в aosPersonalDataПовтИсп, PII-05).
// Экспортная - вызывается из соседнего модуля aosPersonalDataПовтИсп.
//
// Приоритет поиска:
//   1. Точное совпадение (Объект = ИмяОбъекта, ИмяПоля = ИмяПоля);
//   2. Правило "для всех объектов" (Объект = "*", ИмяПоля = ИмяПоля).
// Учитываются только записи с Включён = Истина и
// СпособМаскирования = ПолностьюСкрыть. Сравнение ИмяПоля - регистронезависимое.
//
// fail-open: пустые аргументы и ошибки чтения регистра не блокируют вызывающий
// код, а возвращают Ложь (см. докстринг ЕстьПравилоПолногоСокрытия выше -
// поведение не изменилось относительно PII-01/PII-04, только переехало в
// эту переименованную функцию).
//
// Параметры:
//   ИмяОбъекта - Строка - полное имя метаданных объекта, например "Справочник.Контрагенты".
//   ИмяПоля    - Строка - имя реквизита/поля объекта (точное имя, без wildcard).
//
// Возвращаемое значение:
//   Булево - Истина, если поле должно быть полностью скрыто.
//
Функция ЕстьПравилоПолногоСокрытияБезКэша(ИмяОбъекта, ИмяПоля) Экспорт

	Если Не ЗначениеЗаполнено(ИмяОбъекта) Или Не ЗначениеЗаполнено(ИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат ЕстьПравилоПолногоСокрытияЗапрос(ИмяОбъекта, ИмяПоля);
	Исключение
		// fail-open: сбой чтения регистра (недоступна БД, повреждён кэш и т.п.)
		// не должен блокировать основной поток - маскирование необязательно.
		ОписаниеОшибки = ИнформацияОбОшибке();
		ЗаписатьПредупреждение(
			"aosPersonalData.ЕстьПравилоПолногоСокрытияБезКэша",
			НСтр("ru = 'Ошибка проверки правила маскирования ПДн, правило считается отсутствующим';
				|en = 'Error checking PII masking rule, rule treated as absent'"),
			ОписаниеОшибки);
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Внутренняя реализация запроса к ar_ПравилаМаскированияПДн. Выбирает
// одну наиболее приоритетную подходящую запись (не просто "любую первую").
// Условие по Объекту оформлено через "В (...)" вместо "ИЛИ" в ГДЕ - эквивалентно
// по смыслу (точное имя объекта или "*" для всех объектов), но не приводит
// к предупреждению статического анализа LogicalOrInTheWhereSectionOfQuery.
//
// PII-05 (AI-аудит check_1c_code): "ВЫБРАТЬ ПЕРВЫЕ 1" без УПОРЯДОЧИТЬ ПО не
// гарантирует, что при одновременном наличии точного правила
// (Объект=ИмяОбъекта) и wildcard-правила (Объект="*") для одного и того же поля
// СУБД вернёт именно точное - порядок строк без ORDER BY не детерминирован.
// Это не меняет заявленный приоритет поиска (см. докстринг вызывающей функции),
// а лишь делает его гарантированным на уровне запроса: УПОРЯДОЧИТЬ ПО ставит
// точное совпадение Объекта выше wildcard.
//
// Параметры:
//   ИмяОбъекта - Строка - полное имя метаданных объекта.
//   ИмяПоля    - Строка - имя поля (сравнивается регистронезависимо).
//
// Возвращаемое значение:
//   Булево - Истина, если найдено включённое правило ПолностьюСкрыть.
//
Функция ЕстьПравилоПолногоСокрытияЗапрос(ИмяОбъекта, ИмяПоля)

	Запрос = Новый Запрос;
	// Регистронезависимое сравнение ИмяПоля - приводим обе стороны к ВРег,
	// т.к. значение хранится "как ввёл администратор" в форме.
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Найдено
		|ИЗ
		|	РегистрСведений.ar_ПравилаМаскированияПДн КАК ПравилаМаскирования
		|ГДЕ
		|	ПравилаМаскирования.Включён = ИСТИНА
		|	И ПравилаМаскирования.СпособМаскирования = &СпособПолностьюСкрыть
		|	И ВРег(ПравилаМаскирования.ИмяПоля) = ВРег(&ИмяПоля)
		|	И ПравилаМаскирования.Объект В (&ИмяОбъекта, ""*"")
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА ПравилаМаскирования.Объект = &ИмяОбъекта ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("ИмяПоля", ИмяПоля);
	Запрос.УстановитьПараметр("СпособПолностьюСкрыть",
		Перечисления.ar_СпособМаскированияПДн.ПолностьюСкрыть);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции
