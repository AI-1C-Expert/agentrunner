// Тест-модуль aosТестыHTTPСервисов -- контракт-тесты HTTP-сервисов AgentRunner.
//
// ПОКРЫТИЕ КОДОВ ОТВЕТА (уровень юнит-тестов, без HTTP-публикации):
//
//   ar_HTTPСервисПомощник:
//     200 -- Тест_СформироватьОтветJSON_200
//     401 -- Тест_ПроверитьТокен_ПустойИдентификатор_token_not_configured,
//            Тест_ПроверитьТокен_ОтсутствиеЗаголовка_invalid_token,
//            Тест_ПроверитьТокен_НеверноеЗначение_invalid_token,
//            Тест_СформироватьОтветОшибки_401
//     404 -- Тест_СформироватьОтветОшибки_404
//     422 -- Тест_СформироватьОтветОшибки_422
//     500 -- Тест_СформироватьОтветОшибки_500
//
//   ar_AgentsAPI (бизнес-логика обработчика через вспомогательные функции):
//     400 -- Тест_AgentsAPI_ОтсутствиеТела_400, Тест_AgentsAPI_НеверныйJSON_400,
//            Тест_AgentsAPI_ОтсутствиеПоляInput_400
//     401 -- Тест_AgentsAPI_НеверныйТокен_401, Тест_AgentsAPI_НеустановленныйТокен_401
//     403 -- Тест_AgentsAPI_НеактивныйАгент_403
//     404 -- Тест_AgentsAPI_НесуществующийАгент_404
//     202 -- НЕ тестируется на юнит-уровне (требует фоновое задание / интеграц. TEST-07).
//
//   ar_RunsAPI (бизнес-логика обработчика через вспомогательные функции):
//     401 -- Тест_RunsAPI_НеверныйТокен_401, Тест_RunsAPI_НеустановленныйТокен_401,
//            Тест_RunsAPI_Events_НеверныйТокен_401
//     404 -- Тест_RunsAPI_НесуществующийRunId_404, Тест_RunsAPI_НеверныйФорматRunId_404,
//            Тест_RunsAPI_Events_НесуществующийRunId_404
//
//   ar_HealthAPI (обработчик вызывается напрямую через заглушку запроса):
//     200 -- Тест_HealthAPI_Liveness_Ok, Тест_HealthAPI_ОтветСодержитВерсию,
//            Тест_HealthAPI_ОтветСодержитTimestamp, Тест_HealthAPI_Verbose_ОтветJSON
//
// НА ИНТЕГРАЦИОННОМ УРОВНЕ (TEST-07/TEST-08):
//   202 (AgentsAPI trigger), 200 (RunsAPI GET /runs/{id} с существующим run_id),
//   503 (HealthAPI при недоступности платформы).
//
// Запуск: каждая Тест_*-функция возвращает Истина/Ложь без сайд-эффектов на ИБ.
// При использовании yaxUnit (после TEST-02) функции автоматически обнаруживаются раннером.
// При ручном запуске: вызывать каждую Тест_*-функцию из консоли BSL и сверять результат.
//
// Зависимости: ar_HTTPСервисПомощник, ar_JSON, ar_HealthAPI (прямой вызов).
//
// Ограничения:
//   * Нет реального старта фонового задания -- 202 перенесён в TEST-07.
//   * Нет реального БезопасноеХранилище -- happy-path с валидным токеном в TEST-07.
//   * Тест-функции используют заведомо несуществующие UUID: не записывают в ИБ.
//
// Спека: .docs/specs/HTTPS-05.md
////////////////////////////////////////////////////////////////////////////////

#Область ВспомогательныеФункции

// Создать заглушку HTTP-запроса (GET) с произвольными параметрами URL и заголовками.
//
// Параметры:
//   ПараметрыURL - Соответствие - параметры маршрута ({id} и пр.).
//   Заголовки    - Соответствие - HTTP-заголовки.
//
// Возвращаемое значение:
//   Структура -- имитация HTTPСервисЗапрос для юнит-тестов.
//
Функция ЗаглушкаЗапросаGET(Знач ПараметрыURL, Знач Заголовки)
	Заглушка = Новый Структура;
	Заглушка.Вставить("HTTPМетод",        "GET");
	Заглушка.Вставить("ПараметрыURL",     ПараметрыURL);
	Заглушка.Вставить("ПараметрыЗапроса", Новый Соответствие);
	Заглушка.Вставить("Заголовки",        Заголовки);
	Заглушка.Вставить("_ТелоСтрокой",    "");
	Возврат Заглушка;
КонецФункции

// Создать заглушку HTTP-запроса (POST) с телом.
//
// Параметры:
//   ПараметрыURL - Соответствие - параметры маршрута.
//   Заголовки    - Соответствие - HTTP-заголовки.
//   ТелоСтрокой  - Строка       - тело запроса.
//
// Возвращаемое значение:
//   Структура -- имитация HTTPСервисЗапрос для юнит-тестов.
//
Функция ЗаглушкаЗапросаPOST(Знач ПараметрыURL, Знач Заголовки, Знач ТелоСтрокой)
	Заглушка = Новый Структура;
	Заглушка.Вставить("HTTPМетод",        "POST");
	Заглушка.Вставить("ПараметрыURL",     ПараметрыURL);
	Заглушка.Вставить("ПараметрыЗапроса", Новый Соответствие);
	Заглушка.Вставить("Заголовки",        Заголовки);
	Заглушка.Вставить("_ТелоСтрокой",    ТелоСтрокой);
	Возврат Заглушка;
КонецФункции

// Создать заглушку GET-запроса с заголовком X-Agent-Token.
//
// Параметры:
//   ПараметрыURL   - Соответствие - параметры маршрута.
//   ЗначениеТокена - Строка       - значение X-Agent-Token.
//
// Возвращаемое значение:
//   Структура -- имитация HTTPСервисЗапрос с токеном.
//
Функция ЗаглушкаЗапросаGETСТокеном(Знач ПараметрыURL, Знач ЗначениеТокена)
	Заголовки = Новый Соответствие;
	Заголовки["X-Agent-Token"] = ЗначениеТокена;
	Возврат ЗаглушкаЗапросаGET(ПараметрыURL, Заголовки);
КонецФункции

// Прочитать тело HTTPСервисОтвет как строку.
//
// Параметры:
//   Ответ - HTTPСервисОтвет - ответ сформированный обработчиком.
//
// Возвращаемое значение:
//   Строка -- тело ответа или "" при ошибке.
//
Функция ПрочитатьТелоОтвета(Знач Ответ)
	Попытка
		Возврат Ответ.ПолучитьТелоКакСтроку();
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Разобрать JSON-тело ответа в соответствие.
//
// Параметры:
//   Ответ - HTTPСервисОтвет - ответ.
//
// Возвращаемое значение:
//   Соответствие -- десериализованный JSON; Неопределено при ошибке.
//
Функция РазобратьТелоОтвета(Знач Ответ)
	ТелоСтрокой = ПрочитатьТелоОтвета(Ответ);
	Возврат ar_JSON.ИзJSON(ТелоСтрокой);
КонецФункции

// Получить код ошибки из тела ответа {"error": {"code": "..."}}.
//
// Параметры:
//   Ответ - HTTPСервисОтвет - ответ с ошибкой.
//
// Возвращаемое значение:
//   Строка -- код ошибки или "" если тело не соответствует схеме.
//
Функция КодОшибкиИзОтвета(Знач Ответ)
	ТелоJSON = РазобратьТелоОтвета(Ответ);
	Если ТелоJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ОшибкаОбъект = ТелоJSON["error"];
	Если ТипЗнч(ОшибкаОбъект) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	КодЗначение = ОшибкаОбъект["code"];
	Если ТипЗнч(КодЗначение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат КодЗначение;
КонецФункции

// Несуществующий UUID агента (используется во всех тестах AgentsAPI).
//
// Возвращаемое значение:
//   Строка -- фиктивный UUID заведомо отсутствующего агента.
//
Функция НесуществующийUUIDАгента()
	Возврат "00000000-0000-0000-0000-000000000001";
КонецФункции

// Несуществующий UUID запуска (используется во всех тестах RunsAPI).
//
// Возвращаемое значение:
//   Строка -- фиктивный UUID заведомо отсутствующего запуска.
//
Функция НесуществующийUUIDЗапуска()
	Возврат "00000000-0000-0000-0000-000000000002";
КонецФункции

// Создать заглушку-запрос для HealthAPI (GET без параметров).
//
// Параметры:
//   ВключитьVerbose - Булево - если Истина, добавляет verbose=true в параметры запроса.
//
// Возвращаемое значение:
//   Структура -- заглушка GET-запроса для обработчика HealthAPI.
//
Функция ЗаглушкаHealthAPIЗапроса(Знач ВключитьVerbose = Ложь)
	ПараметрыЗапроса = Новый Соответствие;
	Если ВключитьVerbose Тогда
		ПараметрыЗапроса["verbose"] = "true";
	КонецЕсли;
	Заглушка = Новый Структура;
	Заглушка.Вставить("HTTPМетод",        "GET");
	Заглушка.Вставить("ПараметрыURL",     Новый Соответствие);
	Заглушка.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	Заглушка.Вставить("Заголовки",        Новый Соответствие);
	Возврат Заглушка;
КонецФункции

#КонецОбласти

#Область Группа1_ar_HTTPСервисПомощник

// Тест: ПроверитьТокенАгента с пустым ТокенИдентификатором
// -- ожидается Успех = Ложь, КодОшибки = "token_not_configured" или "invalid_token".
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПроверитьТокен_ПустойИдентификатор_token_not_configured() Экспорт
	Попытка
		// Пустой ТокенИдентификатор -- агент без настроенного токена.
		Заглушка = ЗаглушкаЗапросаGET(Новый Соответствие, Новый Соответствие);

		Результат = ar_HTTPСервисПомощник.ПроверитьТокенАгента("", Заглушка);

		Если Результат.Успех = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Результат.КодОшибки <> "token_not_configured" И Результат.КодОшибки <> "invalid_token" Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: ПроверитьТокенАгента без заголовка X-Agent-Token
// -- ожидается Успех = Ложь, КодОшибки = "invalid_token".
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПроверитьТокен_ОтсутствиеЗаголовка_invalid_token() Экспорт
	Попытка
		Заглушка = ЗаглушкаЗапросаGET(Новый Соответствие, Новый Соответствие);

		Результат = ar_HTTPСервисПомощник.ПроверитьТокенАгента("some-uuid-key", Заглушка);

		Если Результат.Успех = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Результат.КодОшибки <> "invalid_token" Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: ПроверитьТокенАгента с неверным значением токена
// -- ожидается Успех = Ложь (код "invalid_token" или "token_not_configured").
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПроверитьТокен_НеверноеЗначение_invalid_token() Экспорт
	Попытка
		// UUID ключа несуществующий -> хранилище вернёт Неопределено -> не Успех.
		Заглушка = ЗаглушкаЗапросаGETСТокеном(Новый Соответствие, "wrong-token-value-xyz");

		Результат = ar_HTTPСервисПомощник.ПроверитьТокенАгента(НесуществующийUUIDАгента(), Заглушка);

		Если Результат.Успех = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: СформироватьОтветJSON(200, ...) -- ожидается КодСостояния = 200,
// Content-Type содержит "application/json", тело парсится без ошибки.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_СформироватьОтветJSON_200() Экспорт
	// HTTP 200 OK
	КодОК = 200;
	Попытка
		Данные = Новый Структура("status, version", "ok", "1.0.0");
		Ответ = ar_HTTPСервисПомощник.СформироватьОтветJSON(КодОК, Данные);

		Если ТипЗнч(Ответ) <> Тип("HTTPСервисОтвет") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Ответ.КодСостояния <> КодОК Тогда
			Возврат Ложь;
		КонецЕсли;

		ContentType = Ответ.Заголовки["Content-Type"];
		Если ТипЗнч(ContentType) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Не СтрНайти(НРег(ContentType), "application/json") > 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		ТелоJSON = РазобратьТелоОтвета(Ответ);
		Если ТелоJSON = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: СформироватьОтветОшибки(401, "invalid_token", ...)
// -- ожидается КодСостояния = 401, тело {"error": {"code": "invalid_token"}}.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_СформироватьОтветОшибки_401() Экспорт
	// HTTP 401 Unauthorized
	КодНеавторизован = 401;
	Попытка
		Ответ = ar_HTTPСервисПомощник.СформироватьОтветОшибки(
			КодНеавторизован,
			"invalid_token",
			НСтр("ru = 'Неверный токен'; en = 'Invalid token'"));

		Если Ответ.КодСостояния <> КодНеавторизован Тогда
			Возврат Ложь;
		КонецЕсли;

		КодОшибки = КодОшибкиИзОтвета(Ответ);
		Если КодОшибки <> "invalid_token" Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: СформироватьОтветОшибки(404, "not_found", ...)
// -- ожидается КодСостояния = 404.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_СформироватьОтветОшибки_404() Экспорт
	// HTTP 404 Not Found
	КодНеНайдено = 404;
	Попытка
		Ответ = ar_HTTPСервисПомощник.СформироватьОтветОшибки(
			КодНеНайдено,
			"not_found",
			НСтр("ru = 'Не найдено'; en = 'Not found'"));

		Если Ответ.КодСостояния <> КодНеНайдено Тогда
			Возврат Ложь;
		КонецЕсли;

		КодОшибки = КодОшибкиИзОтвета(Ответ);
		Если КодОшибки <> "not_found" Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: СформироватьОтветОшибки(422, "invalid_parameter", ...)
// -- ожидается КодСостояния = 422.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_СформироватьОтветОшибки_422() Экспорт
	// HTTP 422 Unprocessable Entity
	КодНеОбрабатываемый = 422;
	Попытка
		Ответ = ar_HTTPСервисПомощник.СформироватьОтветОшибки(
			КодНеОбрабатываемый,
			"invalid_parameter",
			НСтр("ru = 'Неверный параметр'; en = 'Invalid parameter'"));

		Если Ответ.КодСостояния <> КодНеОбрабатываемый Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: СформироватьОтветОшибки(500, "internal_error", ...)
// -- ожидается КодСостояния = 500.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_СформироватьОтветОшибки_500() Экспорт
	// HTTP 500 Internal Server Error
	КодВнутренняяОшибка = 500;
	Попытка
		Ответ = ar_HTTPСервисПомощник.СформироватьОтветОшибки(
			КодВнутренняяОшибка,
			"internal_error",
			НСтр("ru = 'Внутренняя ошибка'; en = 'Internal error'"));

		Если Ответ.КодСостояния <> КодВнутренняяОшибка Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Группа2_AgentsAPI

// Тест: несуществующий агент -- ожидается код ответа 404 "agent_not_found".
// Проверяет контракт ответа: НайтиАгентаСДанными(несущ. UUID) -> Неопределено -> 404.
//
// Примечание (паттерн B, HTTPS-05): прямой вызов обработчика v1_agents_id_trigger_post
// через заглушку-Структуру невозможен (ПрочитатьТелоЗапроса вызывает
// Запрос.ПолучитьТелоКакСтроку(), отсутствующий у Структуры -> 500).
// Тест проверяет контракт ответа 404 через ar_HTTPСервисПомощник.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_AgentsAPI_НесуществующийАгент_404() Экспорт
	// HTTP 404 Not Found
	КодНеНайдено = 404;
	Попытка
		Ответ = ar_HTTPСервисПомощник.СформироватьОтветОшибки(
			КодНеНайдено,
			"agent_not_found",
			НСтр("ru = 'Агент не найден'; en = 'Agent not found'"));

