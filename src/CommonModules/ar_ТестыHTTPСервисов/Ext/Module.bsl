// Тест: HealthAPI -- GET /v1/health в нормальных условиях
// -- ожидается КодСостояния = 200, liveness = Истина.
// Обработчик вызывается напрямую через заглушку-Структуру.
//
// Примечание: HealthAPI не требует X-Agent-Token.
// В тестовой базе ar_Scheduler может дать "degraded" (нет РЗ),
// но liveness остаётся = Истина.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_HealthAPI_Liveness_Ok() Экспорт
	// HTTP 200 OK
	КодОК = 200;
	Попытка
		Заглушка = ЗаглушкаHealthAPIЗапроса(Ложь);
		Ответ = ar_HealthAPI.v1_health_get(Заглушка);

		Если ТипЗнч(Ответ) <> Тип("HTTPСервисОтвет") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Ответ.КодСостояния <> КодОК Тогда
			Возврат Ложь;
		КонецЕсли;

		ТелоJSON = РазобратьТелоОтвета(Ответ);
		Если ТелоJSON = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Liveness = ТелоJSON["liveness"];
		Если Liveness <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: HealthAPI -- ответ содержит поле version и оно не пустое.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_HealthAPI_ОтветСодержитВерсию() Экспорт
	Попытка
		Заглушка = ЗаглушкаHealthAPIЗапроса(Ложь);
		Ответ = ar_HealthAPI.v1_health_get(Заглушка);

		ТелоJSON = РазобратьТелоОтвета(Ответ);
		Если ТелоJSON = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Версия = ТелоJSON["version"];
		Если ТипЗнч(Версия) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ПустаяСтрока(Версия) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: HealthAPI -- ответ содержит поле timestamp в формате ISO 8601.
// Проверяет: длина >= 19 символов (yyyy-MM-ddTHH:mm:ss), позиция 11 = 'T'.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_HealthAPI_ОтветСодержитTimestamp() Экспорт
	// Минимальная длина ISO 8601: "yyyy-MM-ddTHH:mm:ss" = 19 символов.
	МинДлинаISO8601 = 19;
	// Позиция символа 'T' в строке yyyy-MM-ddTHH:mm:ss.
	ПозицияТ = 11;
	Попытка
		Заглушка = ЗаглушкаHealthAPIЗапроса(Ложь);
		Ответ = ar_HealthAPI.v1_health_get(Заглушка);

		ТелоJSON = РазобратьТелоОтвета(Ответ);
		Если ТелоJSON = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Timestamp = ТелоJSON["timestamp"];
		Если ТипЗнч(Timestamp) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ПустаяСтрока(Timestamp) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если СтрДлина(Timestamp) < МинДлинаISO8601 Тогда
			Возврат Ложь;
		КонецЕсли;
		// Символ 'T' разделяет дату и время в ISO 8601.
		Если Сред(Timestamp, ПозицияТ, 1) <> "T" Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

