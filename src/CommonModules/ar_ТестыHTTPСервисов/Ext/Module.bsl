// Тест: JSON без поля input -- ожидается код ответа 400 "missing_required_field".
// Проверяет: корректный JSON без "input" -> ВводПользователя = Неопределено -> 400.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_AgentsAPI_ОтсутствиеПоляInput_400() Экспорт
	// HTTP 400 Bad Request
	КодНеверныйЗапрос = 400;
	Попытка
		// Тело -- корректный JSON, но без поля "input".
		ДанныеЗапроса = ar_JSON.ИзJSON("{""metadata"":{""key"":""val""}}");
		Если ДанныеЗапроса = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		// Воспроизводим логику AgentsAPI: проверяем отсутствие поля "input".
		ВводПользователя = ДанныеЗапроса["input"];
		Если ВводПользователя <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		// Логика AgentsAPI: input отсутствует -> 400 "missing_required_field".
		Ответ = ar_HTTPСервисПомощник.СформироватьОтветОшибки(
			КодНеверныйЗапрос,
			"missing_required_field",
			НСтр("ru = 'Обязательное поле input отсутствует или пустое'; en = 'Required field input is missing or empty'"));

		Если Ответ.КодСостояния <> КодНеверныйЗапрос Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

