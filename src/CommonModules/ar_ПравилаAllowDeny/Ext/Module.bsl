////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПравилаAllowDeny (CONS-01).
//
// Предметно-нейтральное ЯДРО СЕМАНТИКИ allow/deny, вынесенное из проверенного
// в четырёх итерациях ревью алгоритма ar_ToolAccessRules (SCALE-07), чтобы
// логика правил не переписывалась заново для каждой новой предметной области
// (спека CONS-01, DoD D4).
//
// Контракт полностью нейтрален от предметной области: вызывающий код передаёт
// список кандидатов (произвольные значения-строки, полученные ЛЮБЫМ способом -
// перебором закрытого реестра, как у tools, либо единственным фактическим
// значением параметра, как у области данных) и список правил {Значение,
// Разрешить}. Модуль не читает БД, не знает о ar_Tools/ar_Агенты/
// ar_ПрофилиЗапуска.
//
// Алгоритм (идентичен ar_ToolAccessRules.НаборПоПравилам +
// ИсключитьЗапрещённые, см. также спека SCALE-07 «Поведение» п.1 и спека
// CONS-01 «Три обязательных сценария»):
//  1. Правил нет вовсе -> разрешено ВСЁ (обрабатывается вызывающим кодом до
//     обращения к этому модулю - см. ЭтоРазрешеноПоПравилам, случай "нет
//     правил" трактуется отдельно, т.к. что значит "всё" - зависит от
//     предметной области: для tools - весь реестр, для параметра области
//     данных - "фильтр не применяется вообще").
//  2. Есть только запрещающие правила -> разрешено всё, кроме совпавших с
//     запретом ("всё, кроме...").
//  3. Есть хотя бы одно разрешающее правило -> разрешено только то, что
//     совпало с разрешающим правилом (union разрешающих).
//  4. Запрещающие правила применяются ПОСЛЕДНИМИ и ВСЕГДА побеждают
//     разрешающие - независимо от Порядок и от того, к какому множеству
//     кандидат принадлежит изначально (deny always wins).
//  5. Пустое значение правила (Значение = "") не совпадает ни с чем -
//     опечатка не должна расширять доступ (граничный случай обеих спек).
//  6. Wildcard "*" НЕ реализован в этом модуле - вызывающий код (сейчас только
//     ar_ToolAccessRules), которому нужен wildcard в deny, применяет его до
//     вызова сюда (сравнивая явно) либо использует свою обёртку. CONS-01 не
//     нуждается в wildcard (спека, раздел «Переиспользование логики»).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Запрещено: Выполнить(), Вычислить().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Определяет, разрешено ли конкретное значение согласно списку правил allow/
// deny. Не проверяет случай "правил нет вовсе" - это отдельная семантика
// вызывающего кода ("нет правил" может означать разное в разных предметных
// областях, см. заголовок модуля), сюда передаётся только когда правила ТОЧНО
// есть (проверить Правила.Количество() > 0 до вызова).
//
// Параметры:
//  Значение - Строка - фактическое проверяемое значение (СокрЛП вызывающим кодом).
//  Правила - Массив - непустой список Структур {Значение, Разрешить}, порядок не важен.
//
// Возвращаемое значение:
//  Булево - Истина, если Значение разрешено.
//
Функция ЭтоРазрешеноПоПравилам(Знач Значение, Знач Правила) Экспорт

	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь; // Пустое проверяемое значение не может совпасть ни с одним правилом.
	КонецЕсли;

	ЕстьРазрешающие = Ложь;
	Для Каждого Правило Из Правила Цикл
		Если Правило.Разрешить Тогда
			ЕстьРазрешающие = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьРазрешающие Тогда
		Разрешено = ЕстьСовпадение(Значение, Правила, Истина);
	Иначе
		// Только запрещающие правила (или список пуст, что сюда не должно
		// попадать по контракту) - базовое разрешённое множество = всё.
		Разрешено = Истина;
	КонецЕсли;

	// Deny применяется последним и всегда побеждает - независимо от того, как
	// значение попало в "разрешено" (allow-правило или базовое "всё").
	Если ЕстьСовпадение(Значение, Правила, Ложь) Тогда
		Разрешено = Ложь;
	КонецЕсли;

	Возврат Разрешено;

КонецФункции

// Классифицирует список правил на одно из трёх состояний, не привязанных к
// конкретному проверяемому значению - используется там, где нужно показать
// пользователю результат в виде "разрешено только: ..." / "разрешено всё,
// кроме: ..." / "без ограничений" (спека CONS-01, текстовая расшифровка), а
// не проверить одно конкретное значение.
//
// Параметры:
//  Правила - Массив - список Структур {Значение, Разрешить}, может быть пустым.
//
// Возвращаемое значение:
//  Структура - Состояние (Строка: "БезОграничений"/"ТолькоРазрешённые"/"ВсеКромеЗапрещённых"),
//  СписокРазрешить (Массив Строк, непустые ar_Значение с Разрешить=Истина, БЕЗ значений,
//  одновременно запрещённых - deny всегда побеждает, см. заголовок модуля п.4 и DoD D7),
//  СписокЗапретить (Массив Строк, непустые ar_Значение с Разрешить=Ложь, заполняется всегда).
//
Функция КлассификацияПравил(Знач Правила) Экспорт

	Результат = Новый Структура;
	СписокРазрешитьСырой = Новый Массив;
	СписокЗапретить = Новый Массив;

	ЕстьРазрешающие = Ложь;
	Для Каждого Правило Из Правила Цикл
		ЗначениеПравила = СокрЛП(Правило.Значение);
		Если ПустаяСтрока(ЗначениеПравила) Тогда
			Продолжить; // Пустое значение правила игнорируется (см. заголовок модуля, п.5).
		КонецЕсли;
		Если Правило.Разрешить Тогда
			ЕстьРазрешающие = Истина;
			СписокРазрешитьСырой.Добавить(ЗначениеПравила);
		Иначе
			СписокЗапретить.Добавить(ЗначениеПравила);
		КонецЕсли;
	КонецЦикла;

	// Deny всегда побеждает allow на одном и том же значении (заголовок модуля,
	// п.4; DoD D7 спеки CONS-01) - без вычитания текст расшифровки показал бы
	// запрещённое значение как разрешённое (найдено при проверке смешанного
	// сценария allow+deny на одно значение, замечание оркестратора CONS-01
	// итерация 3, п.4).
	СписокРазрешить = Новый Массив;
	Для Каждого ЗначениеРазрешить Из СписокРазрешитьСырой Цикл
		Если СписокЗапретить.Найти(ЗначениеРазрешить) = Неопределено Тогда
			СписокРазрешить.Добавить(ЗначениеРазрешить);
		КонецЕсли;
	КонецЦикла;

	ИмяКлючаСостояние = "Состояние";
	Если Правила.Количество() = 0 Тогда
		Результат.Вставить(ИмяКлючаСостояние, СостояниеБезОграничений());
	ИначеЕсли ЕстьРазрешающие Тогда
		Результат.Вставить(ИмяКлючаСостояние, СостояниеТолькоРазрешённые());
	Иначе
		Результат.Вставить(ИмяКлючаСостояние, СостояниеВсеКромеЗапрещённых());
	КонецЕсли;

	Результат.Вставить("СписокРазрешить", СписокРазрешить);
	Результат.Вставить("СписокЗапретить", СписокЗапретить);

	Возврат Результат;

КонецФункции

// Каноническое значение Классификация.Состояние для "без ограничений" (пустой
// список правил). Экспортируется, чтобы вызывающий код (ar_ПрофилиЗапуска и
// любой будущий потребитель) сравнивал с этой функцией, а не с текстовым
// литералом - устраняет риск опечатки/расхождения (замечание AI-аудита о
// магических строках).
//
// Возвращаемое значение:
//  Строка - код состояния "БезОграничений".
//
Функция СостояниеБезОграничений() Экспорт
	Возврат "БезОграничений";
КонецФункции

// Каноническое значение Классификация.Состояние, когда есть хотя бы одно
// разрешающее правило - см. СостояниеБезОграничений.
//
// Возвращаемое значение:
//  Строка - код состояния "ТолькоРазрешённые".
//
Функция СостояниеТолькоРазрешённые() Экспорт
	Возврат "ТолькоРазрешённые";
КонецФункции

// Каноническое значение Классификация.Состояние, когда есть только
// запрещающие правила - см. СостояниеБезОграничений.
//
// Возвращаемое значение:
//  Строка - код состояния "ВсеКромеЗапрещённых".
//
Функция СостояниеВсеКромеЗапрещённых() Экспорт
	Возврат "ВсеКромеЗапрещённых";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, совпадает ли Значение хотя бы с одним правилом заданного знака.
//
// Параметры:
//  Значение - Строка - непустое проверяемое значение (СокрЛП вызывающим кодом).
//  Правила - Массив - Структуры {Значение, Разрешить}.
//  Разрешить - Булево - знак правил, которые учитываются (Истина - allow, Ложь - deny).
//
// Возвращаемое значение:
//  Булево - Истина, если найдено совпадение.
//
Функция ЕстьСовпадение(Значение, Правила, Разрешить)

	Для Каждого Правило Из Правила Цикл
		Если Правило.Разрешить <> Разрешить Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеПравила = СокрЛП(Правило.Значение);
		Если ПустаяСтрока(ЗначениеПравила) Тогда
			Продолжить; // Пустое значение правила не совпадает ни с чем.
		КонецЕсли;
		Если ЗначениеПравила = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
