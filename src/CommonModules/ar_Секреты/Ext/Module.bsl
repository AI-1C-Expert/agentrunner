////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Секреты (Секреты AgentRunner).
//
// Единственная точка доступа ядра Agent OS к хранению секретов. Все остальные
// модули обязаны читать/писать секреты только через этот модуль — прямой вызов
// РегистрыСведений.ar_ХранилищеСекретов за пределами ar_Секреты является
// нарушением архитектурного контракта (см. SEC-01, Plan §3.9, §11.5).
//
// Бэкенд хранения — собственный регистр сведений расширения
// ar_ХранилищеСекретов (Ключ -> Значение). Платформенный БезопасноеХранилище
// недоступен в файловой ИБ, а заимствование БСП-регистра
// РегистрыСведений.БезопасноеХранилищеДанных из кода расширений невозможно:
// его ПередЗаписью проверяет БезопасныйРежим() и отклоняет запись из
// расширения («Действие недоступно в безопасном режиме») — платформа не
// снимает безопасный режим для кода расширений (в отличие от кода основной
// конфигурации), и УстановитьОтключениеБезопасногоРежима из общего модуля
// не вызывается. Поэтому единственный рабочий вариант - свой регистр.
//
// Свойства модуля: Сервер, Привилегированный = Ложь. Платформа НЕ разрешает
// признак «Привилегированный» для общих модулей расширений («Cannot use
// privileged common modules in extensions»). Собственный регистр
// ar_ХранилищеСекретов не имеет прав ни у одной роли (сознательно не
// упомянут ни в одном Rights.xml) - единственный доступ к нему получает
// серверный код через УстановитьПривилегированныйРежим(Истина)/Ложь внутри
// каждой экспортной операции этого модуля.
//
// Шифрование: платформенного шифрования (как у БезопасноеХранилище) у
// обычного регистра сведений нет. Значение хранится как есть; защита
// обеспечивается только правами доступа к регистру (см. выше).
//
// Соглашение по ключам: вызывающий передаёт логический ключ без префикса,
// модуль автоматически добавляет пространство имён "aos." (см. ПолныйКлюч).
// Авторитетный источник правды о схеме именования — экспортные функции из
// области #КлючиХранилища (см. ниже). Внешний код должен пользоваться ими,
// а не собирать строки конкатенацией:
//   ar_Секреты.КлючПровайдера(UUID)    → "llm_provider.<UUID>"
//   ar_Секреты.КлючТокенаАгента(UUID) → "agent.token.<UUID>"
// Полный ключ (см. ПолныйКлюч) записывается в измерение Ключ регистра
// (Строка(150)) - с большим запасом относительно реальной длины:
//   "aos.llm_provider.<UUID>"  → 40 символов
//   "aos.agent.token.<UUID>"   → 40 символов
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Сохранить значение секрета в хранилище.
//
// Параметры:
//  Ключ      - Строка - логический ключ без префикса (например, "llm_provider.<UUID>").
//                       Не может быть пустой строкой.
//  Значение  - Строка - значение секрета. Не может быть пустой строкой —
//                       пустое значение семантически эквивалентно «не задан».
//
// Исключение:
//  - "ar_Секреты: Ключ не может быть пустым" — если Ключ пуст или не строка.
//  - "ar_Секреты: Значение секрета не может быть пустым" — если Значение пусто.
//  - "ar_Секреты: ошибка операции с хранилищем" — при ошибке платформы
//                       (текст не содержит значения секрета).
//
Процедура Сохранить(Ключ, Значение) Экспорт

	ПроверитьКлюч(Ключ);
	ПроверитьЗначение(Значение);

	КлючХранилища = ПолныйКлюч(Ключ);

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_ХранилищеСекретов");
			ЭлементБлокировки.УстановитьЗначение("Ключ", КлючХранилища);
			Блокировка.Заблокировать();

			МенеджерЗаписи = РегистрыСведений.ar_ХранилищеСекретов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Ключ = КлючХранилища;
			МенеджерЗаписи.Значение = Значение;
			МенеджерЗаписи.Записать();

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение НСтр("ru = 'ar_Секреты: ошибка операции с хранилищем';
			|en = 'ar_Секреты: secure storage operation failed'");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Прочитать значение секрета из хранилища.
//
// Параметры:
//  Ключ - Строка - логический ключ без префикса. Не может быть пустой строкой.
//
// Возвращаемое значение:
//  Строка       - сохранённое значение секрета.
//  Неопределено - если ключ не найден в хранилище.
//
// Исключение:
//  - "ar_Секреты: Ключ не может быть пустым" — если Ключ пуст или не строка.
//  - "ar_Секреты: ошибка операции с хранилищем" — при ошибке платформы.
//
Функция Прочитать(Ключ) Экспорт

	ПроверитьКлюч(Ключ);

	КлючХранилища = ПолныйКлюч(Ключ);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи = РегистрыСведений.ar_ХранилищеСекретов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Ключ = КлючХранилища;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			Результат = МенеджерЗаписи.Значение;
		Иначе
			Результат = Неопределено;
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение НСтр("ru = 'ar_Секреты: ошибка операции с хранилищем';
			|en = 'ar_Секреты: secure storage operation failed'");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Удалить значение секрета из хранилища (идемпотентно).
//
// Параметры:
//  Ключ - Строка - логический ключ без префикса. Не может быть пустой строкой.
//
// Исключение:
//  - "ar_Секреты: Ключ не может быть пустым" — если Ключ пуст или не строка.
//  - "ar_Секреты: ошибка операции с хранилищем" — при ошибке платформы.
//
Процедура Удалить(Ключ) Экспорт

	ПроверитьКлюч(Ключ);

	КлючХранилища = ПолныйКлюч(Ключ);

	УстановитьПривилегированныйРежим(Истина);
	Попытка

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ar_ХранилищеСекретов");
			ЭлементБлокировки.УстановитьЗначение("Ключ", КлючХранилища);
			Блокировка.Заблокировать();

			МенеджерЗаписи = РегистрыСведений.ar_ХранилищеСекретов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Ключ = КлючХранилища;
			МенеджерЗаписи.Удалить();

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение НСтр("ru = 'ar_Секреты: ошибка операции с хранилищем';
			|en = 'ar_Секреты: secure storage operation failed'");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

#КонецОбласти

#Область КлючиХранилища

// Логический ключ хранилища для API-ключа LLM-провайдера.
//
// Параметры:
//  UUIDПровайдера - Строка - значение реквизита ar_LLMПровайдеры.ar_APIKeyИдентификатор
//                            (UUID в строковом представлении, 36 символов без скобок).
//                            Не может быть пустой строкой.
//
// Возвращаемое значение:
//  Строка - логический ключ вида "llm_provider.<UUID>" для передачи в
//           ar_Секреты.Сохранить/Прочитать/Удалить.
//
// Исключение:
//  - "ar_Секреты: UUID не может быть пустым" — если UUIDПровайдера пуст или
//                                              не строка.
//
Функция КлючПровайдера(UUIDПровайдера) Экспорт

	ПроверитьUUID(UUIDПровайдера);
	Возврат "llm_provider." + UUIDПровайдера;

КонецФункции

// Логический ключ хранилища для токена авторизации агента
// (X-Agent-Token, см. HTTPS-04).
//
// Параметры:
//  UUIDАгента - Строка - значение реквизита ar_Агенты.ar_ТокенИдентификатор
//                       (UUID в строковом представлении, 36 символов без скобок).
//                       Не может быть пустой строкой.
//
// Возвращаемое значение:
//  Строка - логический ключ вида "agent.token.<UUID>" для передачи в
//           ar_Секреты.Сохранить/Прочитать/Удалить.
//
// Исключение:
//  - "ar_Секреты: UUID не может быть пустым" — если UUIDАгента пуст или
//                                              не строка.
//
Функция КлючТокенаАгента(UUIDАгента) Экспорт

	ПроверитьUUID(UUIDАгента);
	Возврат "agent.token." + UUIDАгента;

КонецФункции

// Логический ключ хранилища для анонимного ID установки (install_id),
// передаваемого при проверке обновлений (см. ar_ПроверкаОбновлений,
// agentrunner_site/.docs/ext-install-id-requirement.md).
// Без параметра - ID один на инсталляцию, не привязан к UUID другой сущности.
//
// Возвращаемое значение:
//  Строка - логический ключ "install_id" для передачи в
//           ar_Секреты.Сохранить/Прочитать/Удалить.
//
Функция КлючУстановки() Экспорт

	Возврат "install_id";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сформировать полный ключ хранилища с пространством имён "aos.".
// Используется как значение измерения Ключ регистра ar_ХранилищеСекретов
// (Строка(150) - с большим запасом относительно реальной длины ключей).
//
// Параметры:
//  Ключ - Строка - логический ключ без префикса.
//
// Возвращаемое значение:
//  Строка - полный ключ.
//
Функция ПолныйКлюч(Знач Ключ)
	Возврат "aos." + Ключ;
КонецФункции

// Проверить корректность входного логического ключа.
//
// Параметры:
//  Ключ - Произвольный - проверяемое значение; ожидается непустая строка.
//
Процедура ПроверитьКлюч(Знач Ключ)

	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'ar_Секреты: Ключ должен быть строкой';
			|en = 'ar_Секреты: Key must be a string'");
	КонецЕсли;

	Если ПустаяСтрока(Ключ) Тогда
		ВызватьИсключение НСтр("ru = 'ar_Секреты: Ключ не может быть пустым';
			|en = 'ar_Секреты: Key cannot be empty'");
	КонецЕсли;

КонецПроцедуры

// Проверить корректность UUID, передаваемого в хелперы построения ключей.
//
// Параметры:
//  UUID - Произвольный - проверяемое значение; ожидается непустая строка.
//
Процедура ПроверитьUUID(Знач UUID)

	Если ТипЗнч(UUID) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'ar_Секреты: UUID должен быть строкой';
			|en = 'ar_Секреты: UUID must be a string'");
	КонецЕсли;

	Если ПустаяСтрока(UUID) Тогда
		ВызватьИсключение НСтр("ru = 'ar_Секреты: UUID не может быть пустым';
			|en = 'ar_Секреты: UUID cannot be empty'");
	КонецЕсли;

КонецПроцедуры

// Проверить корректность сохраняемого значения секрета.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение; ожидается непустая строка.
//
Процедура ПроверитьЗначение(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'ar_Секреты: Значение секрета должно быть строкой';
			|en = 'ar_Секреты: Secret value must be a string'");
	КонецЕсли;

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение НСтр("ru = 'ar_Секреты: Значение секрета не может быть пустым';
			|en = 'ar_Секреты: Secret value cannot be empty'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
