////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПланЗапуска (План запуска).
//
// Чистый вычислительный слой между tool update_plan (PLAN-03) и циклом рантайма
// (ar_RuntimeЦикл, PLAN-04): формат внутреннего представления плана, слияние
// пунктов, присланных LLM, с ранее сохранённым состоянием и подсчёт прогресса.
//
// Модуль чистый: не читает и не пишет ИБ (нет Запрос, нет обращений к
// Справочники./Документы./РегистрыСведений.), не устанавливает привилегированный
// режим, не делает HTTP, не вызывает Выполнить/Вычислить, не вызывает ar_JSON —
// работает только с уже десериализованными платформенными типами (Структура,
// Массив), сериализация в JSON и обратно — ответственность вызывающих модулей
// (PLAN-03, PLAN-04).
//
// Контракт «План» (Структура):
//   Пункты  - Массив из Структур {Заголовок, Статус} - не более 12 элементов.
//   Усечено - Булево - признак усечения списка пунктов и/или текста заголовка.
//
// Статус пункта - Строка, одно из: pending | in_progress | done | skipped |
// removed. Значение removed присваивается только функцией Применить пунктам,
// исчезнувшим из нового списка LLM. Неизвестное/пустое значение статуса от LLM
// трактуется как pending - модуль не бросает исключений на плохом входе, это
// ответственность вызывающей стороны (PLAN-03) интерпретировать invalid_steps.
//
// См. спеку: .docs/specs/PLAN-02.md, .docs/specs/PLAN-01.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Создаёт пустой План.
//
// Отправная точка при первом вызове update_plan в рамках запуска (когда в
// Состояние ещё нет ключа План).
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив, пустой), Усечено (Булево, Ложь).
//
Функция НовыйПлан() Экспорт

	Возврат Новый Структура("Пункты, Усечено", Новый Массив, Ложь);

КонецФункции

// Сливает предыдущий План с новым списком пунктов от LLM.
//
// Основная функция модуля: применяет нормализацию входа, защиту от
// «раззакрытия» и лимиты к результату слияния.
//
// Закрытые (done) пункты не «раззакрываются» повторным вызовом с более ранним
// статусом от LLM - защита от того, что LLM прислала план заново, забыв
// прогресс. Пункты, пропавшие из нового списка LLM, не удаляются молча, а
// помечаются статусом removed. Мусорные элементы входа пропускаются без
// исключения (по образцу устойчивого разбора
// ar_RuntimeЦикл.ЗапомнитьОписанныеTools).
//
// Параметры:
//  ПредыдущийПлан - Структура - текущий План (см. НовыйПлан). Любой другой тип
//                    трактуется как отсутствие плана (используется пустой).
//  ПунктыИзLLM    - Массив    - сырые структуры {title, status}, уже
//                    десериализованные из JSON вызывающей стороной. Любой
//                    другой тип (Неопределено и т.п.) трактуется как пустой
//                    список.
//
// Возвращаемое значение:
//  Структура - новый План: поля Пункты (Массив), Усечено (Булево).
//
Функция Применить(Знач ПредыдущийПлан, Знач ПунктыИзLLM) Экспорт

	ПредыдущиеПункты = ПунктыПредыдущегоПлана(ПредыдущийПлан);

	// Шаг 1. Нормализация входа LLM: фильтрация мусора, обрезка заголовка,
	// нормализация статуса, ограничение количества.
	НормализацияВхода = НормализоватьПунктыLLM(ПунктыИзLLM);
	НормализованныеПункты = НормализацияВхода.Пункты;
	Усечено = НормализацияВхода.Усечено;

	// Если после фильтрации мусора не осталось ни одного валидного пункта -
	// предыдущий план возвращается как есть, Усечено не взводится по этой
	// причине (мусор - не усечение).
	Если НормализованныеПункты.Количество() = 0 Тогда
		Возврат Новый Структура("Пункты, Усечено", ПредыдущиеПункты, Ложь);
	КонецЕсли;

	// Шаг 2-3. Слияние нормализованных пунктов LLM с предыдущим планом и
	// перенос пропавших пунктов в removed.
	СлитыеПункты = СлитьСПредыдущимПланом(НормализованныеПункты, ПредыдущиеПункты);

	// Шаг 4. Лимит в 12 пунктов применяется к результату целиком.
	ОбрезкаРезультата = ОбрезатьДоЛимита(СлитыеПункты);
	Если ОбрезкаРезультата.Усечено Тогда
		Усечено = Истина;
	КонецЕсли;

	Возврат Новый Структура("Пункты, Усечено", ОбрезкаРезультата.Пункты, Усечено);

КонецФункции

// Возвращает текущий выполняемый пункт плана.
//
// Используется для отображения этапа выполнения оператору (PLAN-06, PLAN-07).
//
// Приоритет: первый пункт со статусом in_progress, при отсутствии - первый
// pending, при отсутствии обоих - Неопределено (план пуст, либо все пункты в
// done/skipped/removed).
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура, Неопределено - пункт {Заголовок, Статус} или Неопределено.
//
Функция ТекущийПункт(Знач План) Экспорт

	Если ТипЗнч(План) <> Тип("Структура")
		Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПервыйPending = Неопределено;

	// Прочие статусы (done, skipped, removed) на выбор текущего пункта не
	// влияют - пропускаются: ни одно из двух условий ниже для них не
	// срабатывает.
	Для Каждого Пункт Из План.Пункты Цикл

		Если Пункт.Статус = "in_progress" Тогда
			Возврат Пункт;
		КонецЕсли;

		Если Пункт.Статус = "pending" И ПервыйPending = Неопределено Тогда
			ПервыйPending = Пункт;
		КонецЕсли;

	КонецЦикла;

	Возврат ПервыйPending;

КонецФункции

// Считает прогресс плана.
//
// Результат - прямой источник для ресурсов ar_ЭтаповВсего/ar_ЭтаповЗакрыто в
// ar_Запуски (запись делает вызывающая сторона, PLAN-04).
//
// Всего  - количество пунктов, статус которых не removed (снятые пункты не
//          входят в знаменатель, иначе прогресс визуально «откатывается
//          назад» при снятии пункта).
// Закрыто - количество пунктов со статусом done среди них же.
//
// Параметры:
//  План - Структура - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Структура - поля: Всего (Число), Закрыто (Число).
//
Функция Прогресс(Знач План) Экспорт

	Всего  = 0;
	Закрыто = 0;

	Если ТипЗнч(План) = Тип("Структура")
		И План.Свойство("Пункты")
		И ТипЗнч(План.Пункты) = Тип("Массив") Тогда

		Для Каждого Пункт Из План.Пункты Цикл
			Если Пункт.Статус = "removed" Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Если Пункт.Статус = мСтатусЗакрыт() Тогда
				Закрыто = Закрыто + 1;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Новый Структура("Всего, Закрыто", Всего, Закрыто);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Максимальное количество пунктов в плане (вход LLM и результат слияния).
//
// Возвращаемое значение:
//  Число - лимит пунктов (12).
//
Функция мМаксПунктов()
	Возврат 12;
КонецФункции

// Максимальная длина заголовка пункта плана в символах.
//
// Возвращаемое значение:
//  Число - лимит символов (150).
//
Функция мМаксДлинаЗаголовка()
	Возврат 150;
КонецФункции

// Значение статуса "пункт закрыт" - используется в нескольких местах модуля
// (защита от «раззакрытия», подсчёт прогресса, нормализация входа).
//
// Возвращаемое значение:
//  Строка - "done".
//
Функция мСтатусЗакрыт()
	Возврат "done";
КонецФункции

// Возвращает массив пунктов предыдущего плана, устойчиво к некорректному
// или отсутствующему входу (План отсутствует, не Структура, без ключа
// Пункты или Пункты не Массив трактуются как пустой список).
//
// Параметры:
//  ПредыдущийПлан - Структура, Произвольный - см. НовыйПлан/Применить.
//
// Возвращаемое значение:
//  Массив - пункты предыдущего плана (может быть пустым).
//
Функция ПунктыПредыдущегоПлана(Знач ПредыдущийПлан)

	Если ТипЗнч(ПредыдущийПлан) <> Тип("Структура")
		Или Не ПредыдущийПлан.Свойство("Пункты")
		Или ТипЗнч(ПредыдущийПлан.Пункты) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат ПредыдущийПлан.Пункты;

КонецФункции

// Нормализует сырой список пунктов от LLM: отбрасывает мусорные элементы,
// обрезает заголовок и ограничивает количество пунктов лимитом
// мМаксПунктов().
//
// Параметры:
//  ПунктыИзLLM - Массив, Произвольный - сырые структуры {title, status}.
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив нормализованных {Заголовок, Статус}),
//  Усечено (Булево).
//
Функция НормализоватьПунктыLLM(Знач ПунктыИзLLM)

	Результат = Новый Структура("Пункты, Усечено", Новый Массив, Ложь);

	Если ТипЗнч(ПунктыИзLLM) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ЭлементLLM Из ПунктыИзLLM Цикл

		Если Результат.Пункты.Количество() >= мМаксПунктов() Тогда
			Результат.Усечено = Истина;
			Продолжить;
		КонецЕсли;

		НормализованныйПункт = НормализоватьПунктLLM(ЭлементLLM);
		Если НормализованныйПункт = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НормализованныйПункт.Усечено Тогда
			Результат.Усечено = Истина;
		КонецЕсли;

		Результат.Пункты.Добавить(НормализованныйПункт.Пункт);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализует один элемент входного массива LLM. Возвращает Неопределено,
// если элемент - мусор (не Структура, без title, title не строка или пуст).
//
// Параметры:
//  ЭлементLLM - Произвольный - один элемент массива ПунктыИзLLM.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля: Пункт {Заголовок, Статус}, Усечено
//  (Булево, признак обрезки заголовка), либо Неопределено для мусора.
//
Функция НормализоватьПунктLLM(Знач ЭлементLLM)

	Если ТипЗнч(ЭлементLLM) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЭлементLLM.Свойство("title") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗначениеЗаголовка = ЭлементLLM.title;
	Если ТипЗнч(ЗначениеЗаголовка) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заголовок = СокрЛП(ЗначениеЗаголовка);
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УсеченоЗаголовок = Ложь;
	Если СтрДлина(Заголовок) > мМаксДлинаЗаголовка() Тогда
		Заголовок = Лев(Заголовок, мМаксДлинаЗаголовка());
		УсеченоЗаголовок = Истина;
	КонецЕсли;

	ЗначениеСтатуса = Неопределено;
	Если ЭлементLLM.Свойство("status") Тогда
		ЗначениеСтатуса = ЭлементLLM.status;
	КонецЕсли;
	Статус = НормализоватьСтатус(ЗначениеСтатуса);

	Пункт = Новый Структура("Заголовок, Статус", Заголовок, Статус);

	Возврат Новый Структура("Пункт, Усечено", Пункт, УсеченоЗаголовок);

КонецФункции

// Сливает нормализованные пункты LLM с предыдущим планом: закрытые (done)
// пункты не раззакрываются, пропавшие пункты переносятся в конец со
// статусом removed (не дублируются, если уже были removed).
//
// Параметры:
//  НормализованныеПункты - Массив - результат НормализоватьПунктыLLM.Пункты.
//  ПредыдущиеПункты      - Массив - результат ПунктыПредыдущегоПлана.
//
// Возвращаемое значение:
//  Массив - результирующие пункты {Заголовок, Статус}, снятые пункты - в конце.
//
Функция СлитьСПредыдущимПланом(Знач НормализованныеПункты, Знач ПредыдущиеПункты)

	// Индекс предыдущих пунктов по нормализованному заголовку для поиска O(1).
	ПредыдущиеПоЗаголовку = Новый Соответствие;
	Для Каждого ПредыдущийПункт Из ПредыдущиеПункты Цикл
		Ключ = НРег(СокрЛП(ПредыдущийПункт.Заголовок));
		Если ПредыдущиеПоЗаголовку.Получить(Ключ) = Неопределено Тогда
			ПредыдущиеПоЗаголовку.Вставить(Ключ, ПредыдущийПункт);
		КонецЕсли;
	КонецЦикла;

	ВстреченныеЗаголовки = Новый Соответствие;
	РезультирующиеПункты = Новый Массив;

	Для Каждого Пункт Из НормализованныеПункты Цикл

		Ключ = НРег(Пункт.Заголовок);
		ВстреченныеЗаголовки.Вставить(Ключ, Истина);

		Найденный = ПредыдущиеПоЗаголовку.Получить(Ключ);
		ИтоговыйСтатус = СтатусПриСлиянии(Найденный, Пункт.Статус);

		РезультирующиеПункты.Добавить(Новый Структура("Заголовок, Статус", Пункт.Заголовок, ИтоговыйСтатус));

	КонецЦикла;

	Для Каждого ПредыдущийПункт Из ПредыдущиеПункты Цикл
		Ключ = НРег(СокрЛП(ПредыдущийПункт.Заголовок));
		Если ВстреченныеЗаголовки.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РезультирующиеПункты.Добавить(Новый Структура("Заголовок, Статус", ПредыдущийПункт.Заголовок, "removed"));
	КонецЦикла;

	Возврат РезультирующиеПункты;

КонецФункции

// Решает итоговый статус пункта при слиянии одного пункта LLM с найденным
// (или не найденным) пунктом предыдущего плана. Защита от «раззакрытия»:
// если найденный пункт уже done, а новый статус LLM - не done и не skipped,
// статус сохраняется done.
//
// Параметры:
//  НайденныйПредыдущийПункт - Структура, Неопределено - пункт предыдущего
//                              плана с тем же заголовком, либо Неопределено.
//  СтатусLLM                - Строка - нормализованный статус от LLM.
//
// Возвращаемое значение:
//  Строка - итоговый статус пункта.
//
Функция СтатусПриСлиянии(Знач НайденныйПредыдущийПункт, Знач СтатусLLM)

	НайденЗакрытым = НайденныйПредыдущийПункт <> Неопределено
		И НайденныйПредыдущийПункт.Статус = мСтатусЗакрыт();
	ПопыткаОткатаНазад = СтатусLLM <> мСтатусЗакрыт() И СтатусLLM <> "skipped";

	Если НайденЗакрытым И ПопыткаОткатаНазад Тогда
		Возврат мСтатусЗакрыт();
	КонецЕсли;

	Возврат СтатусLLM;

КонецФункции

// Обрезает список пунктов до лимита мМаксПунктов(). Не мутирует вход,
// возвращает новый список.
//
// Сначала обрезаются лишние removed-пункты (с конца списка, как наименее
// ценная информация для оператора), затем, если лимит всё ещё превышен, -
// остаток списка с конца целиком. Порядок оставшихся пунктов сохраняется
// таким же, как во входном списке.
//
// Параметры:
//  Пункты - Массив - список пунктов {Заголовок, Статус} до обрезки.
//
// Возвращаемое значение:
//  Структура - поля: Пункты (Массив, не длиннее мМаксПунктов()), Усечено
//  (Булево, Истина, если вход превышал лимит).
//
Функция ОбрезатьДоЛимита(Знач Пункты)

	Если Пункты.Количество() <= мМаксПунктов() Тогда
		Возврат Новый Структура("Пункты, Усечено", Пункты, Ложь);
	КонецЕсли;

	Избыток = Пункты.Количество() - мМаксПунктов();
	ИсключитьНомер = НомераДляИсключения(Пункты, Избыток);

	Оставшиеся = Новый Массив;
	Для Номер = 0 По Пункты.Количество() - 1 Цикл
		Если ИсключитьНомер.Получить(Номер) = Неопределено Тогда
			Оставшиеся.Добавить(Пункты[Номер]);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Пункты, Усечено", Оставшиеся, Истина);

КонецФункции

// Определяет порядковые номера (0-based, от начала списка) пунктов, которые
// нужно исключить, чтобы убрать Избыток штук: сначала removed-пункты с
// конца списка (наименее ценная информация), затем, если removed не
// хватило, - любые оставшиеся пункты, тоже с конца.
//
// Параметры:
//  Пункты  - Массив - список пунктов {Заголовок, Статус}.
//  Избыток - Число  - сколько пунктов нужно исключить.
//
// Возвращаемое значение:
//  Соответствие - ключи: номера пунктов для исключения (значение - Истина).
//
Функция НомераДляИсключения(Знач Пункты, Знач Избыток)

	ИсключитьНомер = Новый Соответствие;
	Оставшийся = Избыток;

	// Проход 1: removed-пункты с конца.
	Для Каждого НомерИПункт Из НумерованныеСКонца(Пункты) Цикл
		Если Оставшийся = 0 Тогда
			Прервать;
		КонецЕсли;
		Если НомерИПункт.Пункт.Статус = "removed" Тогда
			ИсключитьНомер.Вставить(НомерИПункт.Номер, Истина);
			Оставшийся = Оставшийся - 1;
		КонецЕсли;
	КонецЦикла;

	// Проход 2: если removed не хватило - добираем любыми пунктами с конца.
	Для Каждого НомерИПункт Из НумерованныеСКонца(Пункты) Цикл
		Если Оставшийся = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ИсключитьНомер.Получить(НомерИПункт.Номер) = Неопределено Тогда
			ИсключитьНомер.Вставить(НомерИПункт.Номер, Истина);
			Оставшийся = Оставшийся - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат ИсключитьНомер;

КонецФункции

// Возвращает элементы списка вместе с их порядковыми номерами (0-based, от
// начала списка), но в порядке обхода от конца списка к началу.
//
// Параметры:
//  Пункты - Массив - исходный список.
//
// Возвращаемое значение:
//  Массив - структур {Номер (Число), Пункт (Структура)}, в порядке от
//  последнего элемента исходного списка к первому.
//
Функция НумерованныеСКонца(Знач Пункты)

	Результат = Новый Массив;
	Всего = Пункты.Количество();

	Для Смещение = 1 По Всего Цикл
		Номер = Всего - Смещение;
		Результат.Добавить(Новый Структура("Номер, Пункт", Номер, Пункты[Номер]));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализует значение статуса пункта, пришедшее от LLM, к одному из четырёх
// допустимых значений входа (pending, in_progress, done, skipped). Неизвестное
// или пустое значение (включая любой тип, кроме Строка) трактуется как pending
// - мусор не должен ронять обработку.
//
// Параметры:
//  ЗначениеСтатуса - Произвольный - сырое значение ключа "status".
//
// Возвращаемое значение:
//  Строка - pending | in_progress | done | skipped.
//
Функция НормализоватьСтатус(Знач ЗначениеСтатуса)

	Если ТипЗнч(ЗначениеСтатуса) <> Тип("Строка") Тогда
		Возврат "pending";
	КонецЕсли;

	Статус = НРег(СокрЛП(ЗначениеСтатуса));

	Если Статус = "in_progress"
		Или Статус = мСтатусЗакрыт()
		Или Статус = "skipped" Тогда
		Возврат Статус;
	КонецЕсли;

	Возврат "pending";

КонецФункции

#КонецОбласти
