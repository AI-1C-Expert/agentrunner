// Общий модуль ar_HookDispatcher (Hook Dispatcher).
//
// Диспетчер hook-обработчиков событий жизненного цикла agent-runtime (этап 2,
// подсистема Hooks). По архитектуре (Plan §3.4) любой hook вызывается
// ИСКЛЮЧИТЕЛЬНО через этот диспетчер - прямой вызов процедуры hook-модуля
// из ar_Hooks запрещён.
//
// Два типа обработчиков (реквизит ar_ТипОбработчика справочника ar_Hooks):
//
//   "Процедура" (или пусто) - двухуровневое явное ветвление БЕЗ
//   Выполнить()/Вычислить():
//     уровень 1 - по реквизиту ar_ОбщийМодуль ссылки на ar_Hooks (имя модуля);
//     уровень 2 - внутри ветви модуля по ar_ИмяПроцедуры (имя процедуры).
//   Это рутинный, но статически анализируемый и безопасный шаблон (Plan §3.4).
//
//   "Код" - произвольный код 1С из реквизита ar_КодОбработчика, исполняемый
//   через Выполнить() СТРОГО в безопасном режиме (УстановитьБезопасныйРежим).
//   Осознанное исключение из запрета Plan §1.3 на Выполнить() в ядре:
//   пользовательские hook-скрипты вводятся администратором в карточке hook
//   и выполняются с правами пользователя сессии, без привилегированного
//   режима, без доступа к COM/файлам/внешним средствам (гарантии безопасного
//   режима платформы). Коду доступны переменные КонтекстСобытия (Структура,
//   по ссылке) и Результат (Структура с полем Прервать).
//
// Контракт результата (возврат функции Вызвать):
//   Структура { Прервать - Булево }.
//   Прервать = Истина - вызывающий код (ar_Hooks.Вызвать) прекращает цикл
//   обработки оставшихся hook-обработчиков данного события.
//
// Ответственность диспетчера - ТОЛЬКО маршрутизация (resolve модуль, resolve
// процедура, вызов, возврат результата). В отличие от ar_ToolDispatcher,
// диспетчер hooks НЕ содержит Попытка/Исключение: обработка ошибок целиком
// на уровне ar_Hooks.Вызвать (HOOK-01). Обоснование асимметрии: hooks допускают
// множественный вызов обработчиков за одно событие с продолжением цикла при
// ошибке (требует единой точки try/catch - ar_Hooks.Вызвать), тогда как tools -
// одиночный вызов с собственным жизненным циклом audit/idempotency.
//
// На этапе HOOK-02 реальных hook-модулей ядра нет (whitelist пуст). Любая
// переданная пара (модуль, процедура) генерирует управляемое исключение
// hook_module_not_found, перехватываемое ar_Hooks.Вызвать и записываемое
// как audit-событие HookFailed.
//
// Точка расширения для EXT-01/EXT-02: функция ВызватьHookИзРасширения.
// В будущем заменит stub-ВызватьИсключение на маршрутизацию по
// СсылкаHook.ar_ИсточникРасширение, не меняя контракт Вызвать.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Hook-обработчики выполняются в правах пользователя сессии (Plan §2.8).
//
// См. спеку: .docs/specs/HOOK-01.md, .docs/specs/HOOK-02.md, Plan §3.4.
//////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Вызвать hook-обработчик по ссылке на запись справочника ar_Hooks.
//
// Параметры:
//  СсылкаHook - СправочникСсылка.ar_Hooks - hook-обработчик для вызова.
//  КонтекстСобытия - Структура - контекст события, передаётся по ссылке.
//
// Возвращаемое значение:
//  Структура - результат вызова обработчика (содержит поле Прервать).
//
Функция Вызвать(Знач СсылкаHook, Знач КонтекстСобытия) Экспорт

	РеквизитыHook = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаHook,
		"ar_ТипОбработчика, ar_ОбщийМодуль, ar_ИмяПроцедуры, ar_КодОбработчика");

	Если СокрЛП(РеквизитыHook.ar_ТипОбработчика) = "Код" Тогда
		Возврат ВыполнитьHookКод(РеквизитыHook.ar_КодОбработчика, СсылкаHook, КонтекстСобытия);
	КонецЕсли;

	ИмяМодуля = СокрЛП(РеквизитыHook.ar_ОбщийМодуль);
	ИмяПроцедуры = СокрЛП(РеквизитыHook.ar_ИмяПроцедуры);

	Возврат ВыполнитьHookМодуль(ИмяМодуля, ИмяПроцедуры, СсылкаHook, КонтекстСобытия);

КонецФункции

#КонецОбласти

#Область ИсполнениеКода

// Выполнить произвольный код 1С hook-обработчика (ar_ТипОбработчика = "Код").
//
// Код исполняется через Выполнить() в безопасном режиме: без привилегированного
// режима, без COM/внешних компонент/файлов/запуска приложений. Исключения кода
// НЕ перехватываются здесь - обработка ошибок на уровне ar_Hooks.Вызвать
// (единая точка try/catch, audit-событие HookFailed), как и для процедурных hooks.
//
// Контракт для кода обработчика:
//  КонтекстСобытия - Структура - контекст события (доступен по ссылке, можно
//                    класть данные для последующих обработчиков);
//  Результат       - Структура - поле Прервать (Булево): Истина прерывает
//                    цепочку оставшихся обработчиков события.
//
// Параметры:
//  КодОбработчика - Строка - текст кода 1С из ar_КодОбработчика.
//  СсылкаHook - СправочникСсылка.ar_Hooks - ссылка на обработчик (для ошибок).
//  КонтекстСобытия - Структура - контекст события.
//
// Возвращаемое значение:
//  Структура - результат вызова (содержит поле Прервать).
//
Функция ВыполнитьHookКод(Знач КодОбработчика, Знач СсылкаHook, КонтекстСобытия)

	Если ПустаяСтрока(КодОбработчика) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Hook dispatcher: hook_code_empty (hook: %1)';
				|en = 'Hook dispatcher: hook_code_empty (hook: %1)'"),
			Строка(СсылкаHook));
		ВызватьИсключение(ТекстСообщения);
	КонецЕсли;

	Результат = РезультатПрервать(Ложь);

	// Безопасный режим обязателен (Plan §1.3). Явно НЕ сбрасываем в Ложь:
	// платформа сама снимает его при выходе из функции, в том числе при
	// исключении внутри Выполнить().
	УстановитьБезопасныйРежим(Истина);
	Выполнить(КодОбработчика);

	// Defensive: код мог перезаписать Результат не-структурой или удалить поле.
	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("Прервать") Тогда
		Возврат РезультатПрервать(Ложь);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ДвухуровневоеВетвление

// Уровень 1: ветвление по имени общего модуля. БЕЗ Выполнить()/Вычислить().
//
// Параметры:
//  ИмяМодуля - Строка - значение ar_ОбщийМодуль из ar_Hooks.
//  ИмяПроцедуры - Строка - значение ar_ИмяПроцедуры из ar_Hooks.
//  СсылкаHook - СправочникСсылка.ar_Hooks - ссылка на обработчик.
//  КонтекстСобытия - Структура - контекст события.
//
// Возвращаемое значение:
//  Структура - результат диспетчеризации (содержит поле Прервать).
//
Функция ВыполнитьHookМодуль(Знач ИмяМодуля, Знач ИмяПроцедуры, Знач СсылкаHook, КонтекстСобытия)

	// !!! ДОБАВЛЯТЬ НОВЫЙ ЯДРОВОЙ HOOK-МОДУЛЬ ЗДЕСЬ: новая ветвь ИначеЕсли с
	// вызовом второго уровня ВыполнитьHookПроцедуру<Модуль>. Строка-имя модуля
	// ОБЯЗАНА совпадать с именем каталога в src/CommonModules/ и со значением
	// ar_ОбщийМодуль в справочнике ar_Hooks. Обязательно создать парную
	// функцию ВыполнитьHookПроцедуру<Модуль>(ИмяПроцедуры, КонтекстСобытия)
	// в области ниже. Шаблон:
	//
	// ИначеЕсли ИмяМодуля = "ar_НечтоHook" Тогда
	//     Возврат ВыполнитьHookПроцедуруНечто(ИмяПроцедуры, КонтекстСобытия);

	// На этапе HOOK-02 реальных hook-модулей ядра нет (whitelist пуст).
	// Любая пара (модуль, процедура) попадает в ветвь Иначе.

	ИмяМодуляНорм = СокрЛП(ИмяМодуля);

	Если ИмяМодуляНорм = "" Тогда
		// Пустое имя модуля - ошибка данных, трактуется как неизвестный модуль.
		ВызватьHookИзРасширения("", ИмяПроцедуры, СсылкаHook, КонтекстСобытия);
	Иначе
		// Модуль не входит в whitelist диспетчера.
		// EXT-01/EXT-02 (будущее): маршрутизация по ar_ИсточникРасширение.
		ВызватьHookИзРасширения(ИмяМодуляНорм, ИмяПроцедуры, СсылкаHook, КонтекстСобытия);
	КонецЕсли;

	// ВызватьHookИзРасширения генерирует исключение, но для статического
	// анализатора явно возвращаем результат (недостижимо на практике).
	Возврат РезультатПрервать(Ложь);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Точка расширения для EXT-01/EXT-02. Stub, генерирующий исключение.
//
// Параметры:
//  ИмяМодуля - Строка - имя модуля для текста исключения.
//  ИмяПроцедуры - Строка - имя процедуры для текста исключения.
//  СсылкаHook - СправочникСсылка.ar_Hooks - для будущего доступа.
//  КонтекстСобытия - Структура - контекст события.
//
Процедура ВызватьHookИзРасширения(Знач ИмяМодуля, Знач ИмяПроцедуры, Знач СсылкаHook, КонтекстСобытия)
	// TODO[EXT-01/EXT-02]: маршрутизация по СсылкаHook.ar_ИсточникРасширение -
	// ветвление по имени Expert Pack, аналогично ar_ToolDispatcher.ВызватьРасширение.
	// На этапе HOOK-02 - управляемое исключение, перехватываемое ar_Hooks.Вызвать
	// (HOOK-01) как HookFailed.
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Hook dispatcher: hook_module_not_found (module: %1, procedure: %2)';
			|en = 'Hook dispatcher: hook_module_not_found (module: %1, procedure: %2)'"),
		?(ПустаяСтрока(ИмяМодуля), "<empty>", ИмяМодуля),
		?(ПустаяСтрока(ИмяПроцедуры), "<empty>", ИмяПроцедуры));
	ВызватьИсключение(ТекстСообщения);
КонецПроцедуры

// Сформировать структуру результата диспетчера.
//
// Параметры:
//  ПризнакПрервать - Булево - флаг прерывания цепочки обработчиков.
//
// Возвращаемое значение:
//  Структура - результат с флагом прерывания (поле Прервать).
//
Функция РезультатПрервать(Знач ПризнакПрервать)
	Результат = Новый Структура;
	Результат.Вставить("Прервать", ПризнакПрервать);
	Возврат Результат;
КонецФункции

#КонецОбласти
