//////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_SkillsИмпортЭкспорт (Skills Import/Export).
//
// Импорт/экспорт элементов справочника ar_Skills в формате Anthropic Skills
// (.md-файл с YAML-подобным frontmatter + markdown-тело). Совместим с форматом
// SKILL.md из .claude/skills/*/SKILL.md (SKILL-04).
//
// Контракт (META-23): ar_Содержимое хранит чистое markdown-тело без frontmatter.
// Поля frontmatter (name, description, version, ...) - типизированные реквизиты
// справочника. Этот модуль реализует двустороннее преобразование.
//
// Маппинг frontmatter <-> реквизиты:
//   name              -> ar_Имя (обязательно)
//   description       -> ar_Описание
//   version           -> ar_Версия
//   author            -> ar_Автор
//   category          -> ar_Категория
//   ar_source_extension -> ar_ИсточникРасширение (расширение AgentRunner)
//   ar_updated       -> (экспорт только, не импортируется)
//   license и прочие  -> игнорируются (попадают в НеизвестныеКлючи)
//
// Ограничения парсера: плоский YAML (key: value), без вложенности/списков/multiline.
//
// Свойства модуля: Сервер, ServerCall=true, Привилегированный=Ложь.
//
// См. спеку: .docs/specs/SKILL-04.md, Plan §2.3.
//////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Разобрать текст .md-файла с frontmatter.
//
// Параметры:
//  ТекстФайла - Строка - содержимое .md-файла (UTF-8).
//
// Возвращаемое значение:
//  Структура:
//    Успех             - Булево - результат разбора.
//    Метаданные        - Соответствие - ключи frontmatter (если Успех=Истина).
//    Тело              - Строка - markdown-тело после frontmatter (если Успех=Истина).
//    Причина           - Строка - код ошибки (если Успех=Ложь):
//                        no_frontmatter / unterminated_frontmatter / malformed_line / missing_name.
//    ДетальноеСообщение - Строка - описание ошибки (для UI).
//
Функция РазобратьФронтматтер(Знач ТекстФайла) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Метаданные", Неопределено);
	Результат.Вставить("Тело", "");
	Результат.Вставить("Причина", "");
	Результат.Вставить("ДетальноеСообщение", "");

	Если ПустаяСтрока(ТекстФайла) Тогда
		Результат.Причина = "no_frontmatter";
		Результат.ДетальноеСообщение = НСтр(
			"ru = 'Файл пуст';
			|en = 'File is empty'");
		Возврат Результат;
	КонецЕсли;

	// Нормализация переводов строк: CRLF -> LF, CR -> LF.
	Нормализованный = СтрЗаменить(ТекстФайла, Символы.ВК + Символы.ПС, Символы.ПС);
	Нормализованный = СтрЗаменить(Нормализованный, Символы.ВК, Символы.ПС);

	// Убрать BOM, если есть.
	Если СтрНачинаетсяС(Нормализованный, Символы.НПП) Тогда
		Нормализованный = Сред(Нормализованный, 2);
	КонецЕсли;

	Строки = СтрРазделить(Нормализованный, Символы.ПС, Ложь);

	// Пропустить ведущие пустые строки.
	Начало = 0;
	Для Инд = 0 По Строки.Количество() - 1 Цикл
		Если ПустаяСтрока(СокрЛП(Строки[Инд])) Тогда
			Начало = Инд + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Начало >= Строки.Количество() Тогда
		Результат.Причина = "no_frontmatter";
		Результат.ДетальноеСообщение = НСтр(
			"ru = 'Файл не содержит frontmatter (---)';
			|en = 'File does not contain frontmatter (---)'");
		Возврат Результат;
	КонецЕсли;

	Если СокрЛП(Строки[Начало]) <> "---" Тогда
		Результат.Причина = "no_frontmatter";
		Результат.ДетальноеСообщение = НСтр(
			"ru = 'Файл не содержит frontmatter (---)';
			|en = 'File does not contain frontmatter (---)'");
		Возврат Результат;
	КонецЕсли;

	// Читать строки frontmatter до закрывающего "---".
	Метаданные = Новый Соответствие;
	МаксСтрок = 200;
	НайденоОкончание = Ложь;
	КонецФронтматтера = Начало + 1;

	Для Инд = Начало + 1 По Мин(Начало + МаксСтрок, Строки.Количество() - 1) Цикл
		Стр = Строки[Инд];
		Если СокрЛП(Стр) = "---" Тогда
			НайденоОкончание = Истина;
			КонецФронтматтера = Инд + 1;
			Прервать;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(Стр)) Тогда
			Продолжить;
		КонецЕсли;

		ПозицияДвоеточия = СтрНайти(Стр, ":");
		Если ПозицияДвоеточия = 0 Тогда
			Результат.Причина = "malformed_line";
			Результат.ДетальноеСообщение = СтрШаблон(
				НСтр("ru = 'Строка %1 не содержит двоеточие: %2';
					|en = 'Line %1 does not contain colon: %2'"),
				Инд + 1, Лев(СокрЛП(Стр), 100));
			Возврат Результат;
		КонецЕсли;

		Ключ = СокрЛП(Лев(Стр, ПозицияДвоеточия - 1));
		Значение = СокрЛП(Сред(Стр, ПозицияДвоеточия + 1));
		Значение = СнятьКавычки(Значение);

		Если ПустаяСтрока(Ключ) Тогда
			Результат.Причина = "malformed_line";
			Результат.ДетальноеСообщение = СтрШаблон(
				НСтр("ru = 'Строка %1: пустой ключ';
					|en = 'Line %1: empty key'"),
				Инд + 1);
			Возврат Результат;
		КонецЕсли;

		Метаданные.Вставить(НРег(Ключ), Значение);
	КонецЦикла;

	Если Не НайденоОкончание Тогда
		Результат.Причина = "unterminated_frontmatter";
		Результат.ДетальноеСообщение = НСтр(
			"ru = 'Frontmatter не закрыт (отсутствует закрывающий ---)';
			|en = 'Frontmatter is not closed (missing closing ---)'");
		Возврат Результат;
	КонецЕсли;

	// Проверить обязательное поле name.
	Имя = Метаданные.Получить("name");
	Если Имя = Неопределено Или ПустаяСтрока(Имя) Тогда
		Результат.Причина = "missing_name";
		Результат.ДетальноеСообщение = НСтр(
			"ru = 'Поле ""name"" обязательно во frontmatter';
			|en = 'Field ""name"" is required in frontmatter'");
		Возврат Результат;
	КонецЕсли;

	// Собрать тело (все строки после закрывающего "---").
	ТелоСтроки = Новый Массив;
	ПропуститьВедущие = Истина;
	Для Инд = КонецФронтматтера По Строки.Количество() - 1 Цикл
		Стр = Строки[Инд];
		Если ПропуститьВедущие И ПустаяСтрока(СокрЛП(Стр)) Тогда
			Продолжить;
		КонецЕсли;
		ПропуститьВедущие = Ложь;
		ТелоСтроки.Добавить(Стр);
	КонецЦикла;

	Тело = СтрСоединить(ТелоСтроки, Символы.ПС);

	Результат.Успех = Истина;
	Результат.Метаданные = Метаданные;
	Результат.Тело = Тело;
	Возврат Результат;

КонецФункции

// Разобрать файл из временного хранилища и маппить frontmatter на реквизиты.
//
// Параметры:
//  АдресВХранилище - Строка - адрес временного хранилища с двоичными данными файла.
//
// Возвращаемое значение:
//  Структура:
//    Успех             - Булево
//    Имя, Описание, Категория, Версия, Автор, ИсточникРасширение - Строки
//    Содержимое        - Строка - markdown-тело
//    НеизвестныеКлючи  - Массив - ключи frontmatter без маппинга
//    Причина, Ошибка   - Строки - при Успех=Ложь
//
Функция РазобратьФайл(Знач АдресВХранилище) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Имя", "");
	Результат.Вставить("Описание", "");
	Результат.Вставить("Категория", "");
	Результат.Вставить("Версия", "");
	Результат.Вставить("Автор", "");
	Результат.Вставить("ИсточникРасширение", "");
	Результат.Вставить("Содержимое", "");
	Результат.Вставить("НеизвестныеКлючи", Новый Массив);
	Результат.Вставить("Причина", "");
	Результат.Вставить("Ошибка", "");

	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХранилище);
		ТекстФайла = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Исключение
		Результат.Причина = "read_error";
		Результат.Ошибка = НСтр(
			"ru = 'Не удалось прочитать файл из временного хранилища';
			|en = 'Failed to read file from temp storage'");
		Возврат Результат;
	КонецПопытки;

	Разбор = РазобратьФронтматтер(ТекстФайла);
	Если Не Разбор.Успех Тогда
		Результат.Причина = Разбор.Причина;
		Результат.Ошибка = Разбор.ДетальноеСообщение;
		Возврат Результат;
	КонецЕсли;

	Метаданные = Разбор.Метаданные;

	// Маппинг известных ключей.
	ИзвестныеКлючи = Новый Массив;
	ИзвестныеКлючи.Добавить("name");
	ИзвестныеКлючи.Добавить("description");
	ИзвестныеКлючи.Добавить("version");
	ИзвестныеКлючи.Добавить("author");
	ИзвестныеКлючи.Добавить("category");
	ИзвестныеКлючи.Добавить("ar_source_extension");
	ИзвестныеКлючи.Добавить("ar_updated");
	// Игнорируемые без предупреждения.
	ИгнорируемыеКлючи = Новый Массив;
	ИгнорируемыеКлючи.Добавить("license");
	ИгнорируемыеКлючи.Добавить("allowed-tools");

	Результат.Имя = ЗначениеМетаданных(Метаданные, "name");
	Результат.Описание = ЗначениеМетаданных(Метаданные, "description");
	Результат.Версия = ЗначениеМетаданных(Метаданные, "version");
	Результат.Автор = ЗначениеМетаданных(Метаданные, "author");
	Результат.Категория = ЗначениеМетаданных(Метаданные, "category");
	Результат.ИсточникРасширение = ЗначениеМетаданных(Метаданные, "ar_source_extension");
	Результат.Содержимое = Разбор.Тело;

	// Собрать неизвестные ключи (кроме игнорируемых).
	Для Каждого КлючЗначение Из Метаданные Цикл
		КлючНижний = НРег(КлючЗначение.Ключ);
		Если ИзвестныеКлючи.Найти(КлючНижний) = Неопределено
			И ИгнорируемыеКлючи.Найти(КлючНижний) = Неопределено Тогда
			Результат.НеизвестныеКлючи.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Импортировать данные frontmatter в справочник ar_Skills (upsert по ar_Имя).
//
// Параметры:
//  ДанныеФронтматтера - Структура - результат РазобратьФайл (без полей Причина/Ошибка).
//
// Возвращаемое значение:
//  Структура:
//    Успех     - Булево
//    Ссылка    - СправочникСсылка.ar_Skills - ссылка на созданный/обновлённый элемент
//    Создан    - Булево - Истина если создан новый элемент
//    Причина   - Строка - "multiple_matches" при нескольких совпадениях
//    Кандидаты - Массив - ссылки-кандидаты при multiple_matches
//    Ошибка    - Строка - описание ошибки
//
Функция Импортировать(Знач ДанныеФронтматтера) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("Создан", Ложь);
	Результат.Вставить("Причина", "");
	Результат.Вставить("Кандидаты", Новый Массив);
	Результат.Вставить("Ошибка", "");

	Имя = ДанныеФронтматтера.Имя;
	Если ПустаяСтрока(Имя) Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Имя skill не задано';
			|en = 'Skill name is not set'");
		Возврат Результат;
	КонецЕсли;

	// Поиск существующего элемента по ar_Имя.
	ИсточникРасширение = ДанныеФронтматтера.ИсточникРасширение;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);

	Если ПустаяСтрока(ИсточникРасширение) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Skills.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ar_Skills КАК Skills
			|ГДЕ
			|	Skills.ar_Имя = &Имя
			|	И НЕ Skills.ПометкаУдаления";
	Иначе
		Запрос.УстановитьПараметр("Источник", ИсточникРасширение);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Skills.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ar_Skills КАК Skills
			|ГДЕ
			|	Skills.ar_Имя = &Имя
			|	И Skills.ar_ИсточникРасширение = &Источник
			|	И НЕ Skills.ПометкаУдаления";
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Найдено = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Найдено.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Если Найдено.Количество() > 1 Тогда
		Результат.Причина = "multiple_matches";
		Результат.Кандидаты = Найдено;
		Результат.Ошибка = СтрШаблон(
			НСтр("ru = 'Найдено %1 элементов с именем ""%2"" - выберите один';
				|en = 'Found %1 elements with name ""%2"" - select one'"),
			Найдено.Количество(), Имя);
		Возврат Результат;
	КонецЕсли;

	// Upsert: обновить существующий или создать новый.
	Если Найдено.Количество() = 1 Тогда
		Объект = Найдено[0].ПолучитьОбъект();
		ЗаполнитьРеквизитыИзИмпорта(Объект, ДанныеФронтматтера);
		Объект.Записать();
		Результат.Ссылка = Найдено[0];
		Результат.Создан = Ложь;
	Иначе
		Объект = Справочники.ar_Skills.СоздатьЭлемент();
		Объект.Наименование = Имя;
		ЗаполнитьРеквизитыИзИмпорта(Объект, ДанныеФронтматтера);
		Объект.Записать();
		Результат.Ссылка = Объект.Ссылка;
		Результат.Создан = Истина;
	КонецЕсли;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Сформировать .md-текст с frontmatter из элемента ar_Skills.
//
// Параметры:
//  СсылкаSkill - СправочникСсылка.ar_Skills - элемент для экспорта.
//
// Возвращаемое значение:
//  Строка - содержимое .md-файла (frontmatter + markdown-тело).
//
Функция СформироватьФронтматтер(Знач СсылкаSkill) Экспорт

	// Прочитать реквизиты.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаSkill);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Skills.ar_Имя КАК Имя,
		|	Skills.ar_Описание КАК Описание,
		|	Skills.ar_Версия КАК Версия,
		|	Skills.ar_Автор КАК Автор,
		|	Skills.ar_Категория КАК Категория,
		|	Skills.ar_ИсточникРасширение КАК ИсточникРасширение,
		|	Skills.ar_Обновлено КАК Обновлено,
		|	Skills.ar_Содержимое КАК Содержимое
		|ИЗ
		|	Справочник.ar_Skills КАК Skills
		|ГДЕ
		|	Skills.Ссылка = &Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	СтрокиФронтматтера = Новый Массив;

	// name (обязательно).
	СтрокиФронтматтера.Добавить("name: " + ЭкранироватьЗначениеYAML(Выборка.Имя));

	// description.
	Если Не ПустаяСтрока(Выборка.Описание) Тогда
		СтрокиФронтматтера.Добавить("description: " + ЭкранироватьЗначениеYAML(Выборка.Описание));
	КонецЕсли;

	// version.
	Если Не ПустаяСтрока(Выборка.Версия) Тогда
		СтрокиФронтматтера.Добавить("version: " + ЭкранироватьЗначениеYAML(Выборка.Версия));
	КонецЕсли;

	// author.
	Если Не ПустаяСтрока(Выборка.Автор) Тогда
		СтрокиФронтматтера.Добавить("author: " + ЭкранироватьЗначениеYAML(Выборка.Автор));
	КонецЕсли;

	// category.
	Если Не ПустаяСтрока(Выборка.Категория) Тогда
		СтрокиФронтматтера.Добавить("category: " + ЭкранироватьЗначениеYAML(Выборка.Категория));
	КонецЕсли;

	// ar_source_extension (расширение AgentRunner).
	Если Не ПустаяСтрока(Выборка.ИсточникРасширение) Тогда
		СтрокиФронтматтера.Добавить("ar_source_extension: " + ЭкранироватьЗначениеYAML(Выборка.ИсточникРасширение));
	КонецЕсли;

	// ar_updated (информативное, экспорт только).
	Если ТипЗнч(Выборка.Обновлено) = Тип("Дата") И ЗначениеЗаполнено(Выборка.Обновлено) Тогда
		СтрокиФронтматтера.Добавить("ar_updated: " + ar_Утилиты.ФорматДата(Выборка.Обновлено));
	КонецЕсли;

	// Собрать итоговый текст.
	Фронтматтер = "---" + Символы.ПС
		+ СтрСоединить(СтрокиФронтматтера, Символы.ПС) + Символы.ПС
		+ "---" + Символы.ПС + Символы.ПС;

	Содержимое = Строка(Выборка.Содержимое);
	Если ПустаяСтрока(Содержимое) Тогда
		Возврат Фронтматтер;
	КонецЕсли;

	Возврат Фронтматтер + Содержимое + Символы.ПС;

КонецФункции

// Экспортировать элемент ar_Skills во временное хранилище.
//
// Параметры:
//  СсылкаSkill - СправочникСсылка.ar_Skills - элемент для экспорта.
//
// Возвращаемое значение:
//  Структура:
//    Успех         - Булево
//    АдресВХранилище - Строка - адрес временного хранилища (при Успех=Истина)
//    ИмяФайла      - Строка - рекомендуемое имя файла
//    Ошибка        - Строка - описание ошибки (при Успех=Ложь)
//
Функция Экспортировать(Знач СсылкаSkill) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("АдресВХранилище", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("Ошибка", "");

	Если СсылкаSkill = Неопределено Или Не ЗначениеЗаполнено(СсылкаSkill) Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Элемент не выбран';
			|en = 'Element not selected'");
		Возврат Результат;
	КонецЕсли;

	// Прочитать имя для проверки и файла.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаSkill);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Skills.ar_Имя КАК Имя
		|ИЗ
		|	Справочник.ar_Skills КАК Skills
		|ГДЕ
		|	Skills.Ссылка = &Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Элемент не найден';
			|en = 'Element not found'");
		Возврат Результат;
	КонецЕсли;

	Имя = СокрЛП(Строка(Выборка.Имя));
	Если ПустаяСтрока(Имя) Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Поле ""Имя"" не заполнено - экспорт невозможен';
			|en = 'Field ""Name"" is empty - export is not possible'");
		Возврат Результат;
	КонецЕсли;

	ТекстMD = СформироватьФронтматтер(СсылкаSkill);
	Если ПустаяСтрока(ТекстMD) Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Не удалось сформировать содержимое файла';
			|en = 'Failed to generate file content'");
		Возврат Результат;
	КонецЕсли;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстMD, КодировкаТекста.UTF8);
	АдресВХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

	Результат.Успех = Истина;
	Результат.АдресВХранилище = АдресВХранилище;
	Результат.ИмяФайла = ОчиститьИмяДляФайла(Имя) + ".md";
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнить реквизиты элемента из данных импорта (без записи).
// ar_Обновлено НЕ устанавливается - управляется ObjectModule.ПередЗаписью.
//
Процедура ЗаполнитьРеквизитыИзИмпорта(Объект, ДанныеФронтматтера)

	Объект.ar_Имя = ДанныеФронтматтера.Имя;
	Объект.ar_Описание = ДанныеФронтматтера.Описание;
	Объект.ar_Версия = ДанныеФронтматтера.Версия;
	Объект.ar_Автор = ДанныеФронтматтера.Автор;
	Объект.ar_Категория = ДанныеФронтматтера.Категория;
	Объект.ar_ИсточникРасширение = ДанныеФронтматтера.ИсточникРасширение;
	Объект.ar_Содержимое = ДанныеФронтматтера.Содержимое;

КонецПроцедуры

// Снять обрамляющие кавычки у значения frontmatter.
//
Функция СнятьКавычки(Знач Текст)

	Если СтрДлина(Текст) < 2 Тогда
		Возврат Текст;
	КонецЕсли;

	Первый = Лев(Текст, 1);
	Последний = Прав(Текст, 1);

	Если (Первый = """" И Последний = """")
		Или (Первый = "'" И Последний = "'") Тогда
		Возврат Сред(Текст, 2, СтрДлина(Текст) - 2);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Получить значение из соответствия метаданных (безопасно).
//
Функция ЗначениеМетаданных(Метаданные, Знач Ключ)

	Значение = Метаданные.Получить(НРег(Ключ));
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Экранировать значение для YAML frontmatter.
// Если значение содержит спецсимволы - обернуть в двойные кавычки.
//
Функция ЭкранироватьЗначениеYAML(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат """""";
	КонецЕсли;

	СпецСимволы = ":#-?[]{}&*!|>""'%@`";
	НужныКавычки = Ложь;

	// Проверить наличие спецсимволов (в т.ч. в начале строки -
	// перебор по всем символам Текста покрывает и первый символ).
	Для Инд = 1 По СтрДлина(СпецСимволы) Цикл
		Если СтрНайти(Текст, Сред(СпецСимволы, Инд, 1)) > 0 Тогда
			НужныКавычки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НужныКавычки Тогда
		// Экранировать внутренние двойные кавычки.
		Экранированный = СтрЗаменить(Текст, """", "\""");
		Возврат """" + Экранированный + """";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Очистить имя для использования в имени файла.
// Удаляет недопустимые символы файловой системы.
//
Функция ОчиститьИмяДляФайла(Знач Текст)

	Недопустимые = "\/:*?""<>|";
	Результат = Текст;

	Для Инд = 1 По СтрДлина(Недопустимые) Цикл
		Символ = Сред(Недопустимые, Инд, 1);
		Результат = СтрЗаменить(Результат, Символ, "_");
	КонецЦикла;

	// Ограничить длину.
	Если СтрДлина(Результат) > 100 Тогда
		Результат = Лев(Результат, 100);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
