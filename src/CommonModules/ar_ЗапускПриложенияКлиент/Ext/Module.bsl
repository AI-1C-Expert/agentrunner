////////////////////////////////////////////////////////////////////////////////
// Клиентский общий модуль ar_ЗапускПриложенияКлиент (UI-21).
//
// Содержит экспортные клиентские процедуры, вызываемые платформенным
// ПодключитьОбработчикОжидания() из модуля управляемого приложения расширения
// (src/Ext/ManagedApplicationModule.bsl). Платформа не может подключить
// обработчик ожидания на процедуру, локальную для самого модуля управляемого
// приложения расширения (Invalid parameter value для 1-го параметра) - целевая
// процедура обязана быть экспортной процедурой отдельного общего клиентского
// модуля. [Реф: БСП/СтандартныеПодсистемыКлиент] - тот же паттерн
// (ОбработчикОжиданияПриНачалеРаботыСистемы и т.п. вызываются из общего
// клиентского модуля, а не из модуля приложения напрямую).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработчик ожидания - открывает форму мастера первичной настройки после
// отображения главного окна. Вызывается через ПодключитьОбработчикОжидания
// из АР_ПриНачалеРаботыСистемы (ManagedApplicationModule.bsl).
//
Процедура АР_МастерНастройкиОткрыть() Экспорт

	// Повторная проверка: мастер мог быть выполнен параллельным администратором.
	Если ar_ToolDispatcher.МастерНастройкиВыполнен() Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	Попытка
		// Обычное окно (режим открытия не задаётся), как у типовых форм БП -
		// [Реф: БП/бит_ОбщегоНазначенияКлиент.ОткрытьФорму("Обработка.бит_ДополнительнаяИнформация.Форма")].
		// Ранее использовался РежимОткрытияОкнаФормы.БлокироватьОкноВладельца: мастер
		// открывался модально поверх основного окна и не масштабировался вместе с ним.
		ОткрытьФорму("ОбщаяФорма.ar_МастерНастройки", ПараметрыФормы);
	Исключение
		// Форма может быть недоступна - не прерываем запуск системы.
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		// Статус - ПЯТЫЙ параметр (четвёртый - Картинка): иначе
		// "Несоответствие типов (параметр номер '4')".
		ПоказатьОповещениеПользователя(
			НСтр("ru='Мастер настройки недоступен'; en='Setup wizard unavailable'"),
			,
			ТекстОшибки,
			,
			СтатусОповещенияПользователя.Важное);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
