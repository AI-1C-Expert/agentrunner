////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_PermissionRoles (PermissionRoles / Проверка ролей).
//
// Уровень L2 permission engine: проверка членства текущего пользователя
// сессии в роли 1С, заданной для агента (реквизит ar_Агенты.ar_ИмяРоли1С).
//
// Вызывается из ar_PermissionEngine.ВыполнитьПроверки на каждый tool call.
// В отличие от RT-10 (ar_RuntimeЦикл.ПроверитьРольПользователя - стартовая
// проверка при запуске, возвращает Булево, при Ложь дает denied_globally),
// этот модуль вызывается внутри loop на каждое действие и возвращает структуру
// решения {Решение, Причина}. Контракт допускает расширение L2 в будущем
// (например, отдельная роль per-tool).
//
// Шаги проверки:
//   R0: пустое ИмяРоли1С  -> allow (ролевой контроль для агента не задан);
//   R1: роль не найдена в Метаданные.Роли -> deny "agent_role_not_found_in_metadata";
//   R2: нет текущего пользователя ИБ -> deny "no_current_ib_user";
//   R3: пользователь не входит в роль -> deny "user_not_in_agent_role";
//   R3: пользователь входит в роль -> allow.
//
// Примечание: пользователь ИБ с признаком администратора (полные права без ролей)
// проходит Роли.Содержит как Истина - это штатное поведение платформы, при запуске
// от администратора ролевое ограничение L2 фактически не действует.
//
// Контракт возвращаемого значения совпадает с ar_PermissionEngine.Deny/Allow:
// Структура {Решение: "allow"|"deny", Причина: Строка,
//            RiskLevel: Неопределено, СсылкаTool: Неопределено}.
//
// Свойства модуля: Сервер, без вызова с клиента, без привилегированного режима.
//
// См. спеку: .docs/specs/PERM-02.md, Plan §2.8.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверить членство текущего пользователя сессии в роли агента.
//
// Параметры:
//   ДанныеАгента    - Структура - {Ссылка, ИмяРоли1С, РежимАвтономии,
//                                  МаксДействий, МаксСуммаДействия, ...}.
//   КонтекстЗапуска - Структура - {RunId, Агент, РежимАвтономии, DryRun, Sequence}.
//
// Возвращаемое значение:
//   Структура - {Решение: "allow"|"deny", Причина: Строка,
//                RiskLevel: Неопределено, СсылкаTool: Неопределено}.
//
Функция Проверить(ДанныеАгента, КонтекстЗапуска) Экспорт

	Попытка
		Возврат ВыполнитьПроверкуРоли(ДанныеАгента);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Deny("permission_roles_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная цепочка проверки роли R0-R3. Любой не-allow результат прерывает цепочку.
//
Функция ВыполнитьПроверкуРоли(ДанныеАгента)

	// R0: пустое имя роли - ролевой контроль для этого агента отключён.
	ИмяРоли = СокрЛП(Строка(ДанныеАгента.ИмяРоли1С));
	Если ПустаяСтрока(ИмяРоли) Тогда
		Возврат Allow();
	КонецЕсли;

	// R1: роль должна существовать в метаданных.
	МетаданныеРоли = Метаданные.Роли.Найти(ИмяРоли);
	Если МетаданныеРоли = Неопределено Тогда
		Возврат Deny(НСтр("ru = 'agent_role_not_found_in_metadata';
			|en = 'agent_role_not_found_in_metadata'"));
	КонецЕсли;

	// R2: текущий пользователь ИБ.
	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийПользовательИБ = Неопределено Тогда
		Возврат Deny(НСтр("ru = 'no_current_ib_user'; en = 'no_current_ib_user'"));
	КонецЕсли;

	// R3: членство в роли.
	Если Не ТекущийПользовательИБ.Роли.Содержит(МетаданныеРоли) Тогда
		Возврат Deny(НСтр("ru = 'user_not_in_agent_role'; en = 'user_not_in_agent_role'"));
	КонецЕсли;

	Возврат Allow();

КонецФункции

// ---- Helpers возвращаемых структур (дублируют формат ar_PermissionEngine) ----

Функция Allow()
	Результат = Новый Структура;
	Результат.Вставить("Решение",    "allow");
	Результат.Вставить("Причина",    "");
	Результат.Вставить("RiskLevel",  Неопределено);
	Результат.Вставить("СсылкаTool", Неопределено);
	Возврат Результат;
КонецФункции

Функция Deny(Причина)
	Результат = Новый Структура;
	Результат.Вставить("Решение",    "deny");
	Результат.Вставить("Причина",    Причина);
	Результат.Вставить("RiskLevel",  Неопределено);
	Результат.Вставить("СсылкаTool", Неопределено);
	Возврат Результат;
КонецФункции

#КонецОбласти
