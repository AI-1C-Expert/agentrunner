// Общий модуль ar_LLMКонтракт (AOS LLM — Контракт провайдера).
//
// Документирующий модуль. Закрепляет единый программный контракт для всех
// LLM-провайдеров ядра AgentRunner: внутренний формат сообщений, формат ответа
// функции Чат() и обязательные ключи структуры Параметры. Не вызывается
// напрямую из бизнес-логики — только как справочник и набор конструкторов
// структур, чтобы провайдеры не дублировали наборы ключей.
//
// Не содержит HTTP-вызовов, парсеров и какой-либо рабочей логики. Только:
//   * конструкторы пустых структур нужного формата (НовоеСообщение,
//     НовыйToolCall, НовыйToolResult, НовыйОтвет, НовыеПараметры);
//   * валидаторы структур (ВалидироватьОтвет, ВалидироватьСообщения);
//   * строковые константы ролей (РольSystem/User/Assistant/Tool).
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, Client = false, ServerCall = false,
//   Privileged = false, ReturnValuesReuse = DontUse.
//
// См. спеку: .docs/specs/LLM-03.md, Plan §2.8.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Создаёт пустую структуру сообщения во внутреннем формате AgentRunner.
//
// Параметры:
//   Роль        - Строка - одна из РольSystem()/РольUser()/РольAssistant()/РольTool().
//   Содержание  - Строка - текст сообщения; может быть "" для assistant с tool_calls.
//
// Возвращаемое значение:
//   Структура - {
//     role     - Строка - "system" | "user" | "assistant" | "tool"
//     content  - Строка - текстовое содержание
//   }
//   Дополнительные ключи (tool_calls, tool_call_id, name) при необходимости
//   добавляет вызывающий код через Вставить().
//
Функция НовоеСообщение(Роль, Содержание = "") Экспорт

	Сообщение = Новый Структура;
	Сообщение.Вставить("role", Строка(Роль));
	Сообщение.Вставить("content", Строка(Содержание));
	Возврат Сообщение;

КонецФункции

// Создаёт пустую структуру одного tool_call (элемент массива tool_calls в
// сообщении assistant).
//
// Параметры:
//   Ид             - Строка - уникальный идентификатор вызова (получен от LLM).
//   ИмяTool        - Строка - имя tool в snake_case.
//   АргументыJSON  - Строка - JSON-строка аргументов вызова.
//
// Возвращаемое значение:
//   Структура - {
//     id        - Строка
//     type      - Строка - всегда "function"
//     function  - Структура - { name - Строка, arguments - Строка JSON }
//   }
//
Функция НовыйToolCall(Ид, ИмяTool, АргументыJSON) Экспорт

	ФункцияСтрукт = Новый Структура;
	ФункцияСтрукт.Вставить("name", Строка(ИмяTool));
	ФункцияСтрукт.Вставить("arguments", Строка(АргументыJSON));

	Вызов = Новый Структура;
	Вызов.Вставить("id", Строка(Ид));
	Вызов.Вставить("type", "function");
	Вызов.Вставить("function", ФункцияСтрукт);
	Возврат Вызов;

КонецФункции

// Создаёт сообщение результата tool (role="tool").
//
// Параметры:
//   ToolCallId            - Строка - id вызова, на который отвечаем.
//   ИмяTool               - Строка - имя tool (snake_case).
//   СодержаниеРезультата  - Строка - текст результата (как правило, JSON-строка).
//
// Возвращаемое значение:
//   Структура - {
//     role          - Строка - "tool"
//     content       - Строка
//     tool_call_id  - Строка
//     name          - Строка
//   }
//
Функция НовыйToolResult(ToolCallId, ИмяTool, СодержаниеРезультата) Экспорт

	Сообщение = НовоеСообщение(РольTool(), Строка(СодержаниеРезультата));
	Сообщение.Вставить("tool_call_id", Строка(ToolCallId));
	Сообщение.Вставить("name", Строка(ИмяTool));
	Возврат Сообщение;

КонецФункции

// Безопасно приводит произвольное значение к неотрицательному Числу.
// Используется всеми LLM-провайдерами для парсинга полей usage:
//   * OpenAI — prompt_tokens / completion_tokens (Число);
//   * YandexGPT — inputTextTokens / completionTokens (Строка);
//   * GigaChat — prompt_tokens / completion_tokens (Число).
//
// Покрывает граничные случаи:
//   * Число → Макс(Число, 0);
//   * Строка "120" → 120; "-5" → 0; "" → 0; "abc" → 0;
//   * Неопределено → 0;
//   * Любое исключение приведения → 0.
//
// Параметры:
//   Значение - Произвольный - исходное значение (Число, Строка, Неопределено, и т.д.).
//
// Возвращаемое значение:
//   Число - >= 0.
//
Функция ИзвлечьЧисло(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Макс(Значение, 0);
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Результат = Число(СокрЛП(Строка(Значение)));
	Исключение
		Возврат 0;
	КонецПопытки;

	Возврат Макс(Результат, 0);

КонецФункции

// Конструктор usage-блока: возвращает структуру с полями ТокеновВход/ТокеновВыход,
// гарантированно приведёнными к неотрицательным числам через ИзвлечьЧисло.
// Провайдеры используют конструктор вместо ручного присваивания, чтобы не
// дублировать логику парсинга чисел.
//
// Параметры:
//   ТокеновВход  - Произвольный - значение из поля провайдера (число или строка).
//   ТокеновВыход - Произвольный - значение из поля провайдера (число или строка).
//
// Возвращаемое значение:
//   Структура - {ТокеновВход - Число, ТокеновВыход - Число}.
//
Функция НовыйUsage(ТокеновВход = 0, ТокеновВыход = 0) Экспорт

	Usage = Новый Структура;
	Usage.Вставить("ТокеновВход", ИзвлечьЧисло(ТокеновВход));
	Usage.Вставить("ТокеновВыход", ИзвлечьЧисло(ТокеновВыход));
	Возврат Usage;

КонецФункции

// Проверяет корректность usage-блока в ответе провайдера. Не выбрасывает
// исключений: при любой проблеме возвращает непустую строку с описанием.
//
// Проверяет, что:
//   * ТокеновВход и ТокеновВыход — Число;
//   * оба значения >= 0.
//
// Параметры:
//   Usage - Произвольный - структура или ответ провайдера с полями
//           ТокеновВход/ТокеновВыход.
//
// Возвращаемое значение:
//   Строка - "" если usage корректен; иначе текст ошибки.
//
Функция ВалидироватьUsage(Usage) Экспорт

	Если Usage = Неопределено Тогда
		Возврат НСтр("ru = 'Usage-блок не задан (Неопределено)';
		             |en = 'Usage block is not set (Undefined)'");
	КонецЕсли;

	Если ТипЗнч(Usage) <> Тип("Структура") Тогда
		Возврат НСтр("ru = 'Usage-блок должен быть структурой';
		             |en = 'Usage block must be a structure'");
	КонецЕсли;

	Если НЕ Usage.Свойство("ТокеновВход") Тогда
		Возврат НСтр("ru = 'В usage отсутствует ключ ""ТокеновВход""';
		             |en = 'Usage has no ""ТокеновВход"" key'");
	КонецЕсли;

	Если НЕ Usage.Свойство("ТокеновВыход") Тогда
		Возврат НСтр("ru = 'В usage отсутствует ключ ""ТокеновВыход""';
		             |en = 'Usage has no ""ТокеновВыход"" key'");
	КонецЕсли;

	Если ТипЗнч(Usage.ТокеновВход) <> Тип("Число") Тогда
		Возврат НСтр("ru = 'Ключ ""ТокеновВход"" должен быть типа Число';
		             |en = 'Key ""ТокеновВход"" must be of type Number'");
	КонецЕсли;

	Если ТипЗнч(Usage.ТокеновВыход) <> Тип("Число") Тогда
		Возврат НСтр("ru = 'Ключ ""ТокеновВыход"" должен быть типа Число';
		             |en = 'Key ""ТокеновВыход"" must be of type Number'");
	КонецЕсли;

	Если Usage.ТокеновВход < 0 Тогда
		Возврат НСтр("ru = 'Значение ""ТокеновВход"" не может быть отрицательным';
		             |en = 'Value ""ТокеновВход"" must not be negative'");
	КонецЕсли;

	Если Usage.ТокеновВыход < 0 Тогда
		Возврат НСтр("ru = 'Значение ""ТокеновВыход"" не может быть отрицательным';
		             |en = 'Value ""ТокеновВыход"" must not be negative'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Создаёт пустую структуру ответа функции Чат() любого провайдера.
// Набор ключей и значения по умолчанию идентичны локальной функции
// НовыйРезультат() в ar_LLMOpenAI — для бинарной совместимости при
// последующей миграции (см. LLM-04, LLM-05).
//
// Возвращаемое значение:
//   Структура - {
//     Успех        - Булево              - Ложь
//     Сообщение    - Структура|Неопределено - Неопределено
//     ТокеновВход  - Число               - 0
//     ТокеновВыход - Число               - 0
//     Ошибка       - Строка              - ""
//     КодСостояния - Число               - 0
//     БалансРуб    - Число|Неопределено - Неопределено (заполняет только
//                    ar_LLMAgentRunnerCloud; остальные провайдеры не заполняют)
//     БалансНизкий - Булево             - Ложь (аналогично)
//   }
//
Функция НовыйОтвет() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);
	// LLM-14 (часть Б): БалансРуб/БалансНизкий - опциональные поля из
	// успешного (200) ответа шлюза AgentRunner Cloud. БалансРуб дефолтится в
	// Неопределено (НЕ 0!) - 0 является легитимным значением баланса,
	// Неопределено однозначно означает "провайдер не заполнил поле".
	Результат.Вставить("БалансРуб", Неопределено);
	Результат.Вставить("БалансНизкий", Ложь);
	Возврат Результат;

КонецФункции

// Проверяет, соответствует ли структура контракту ответа провайдера.
// Не выбрасывает исключений: при любой проблеме возвращает непустую строку
// с описанием первой найденной ошибки.
//
// Параметры:
//   Результат - Произвольный - структура, возвращённая Чат() провайдера.
//
// Возвращаемое значение:
//   Строка - "" если ответ соответствует контракту; иначе текст ошибки.
//
Функция ВалидироватьОтвет(Результат) Экспорт

	Если Результат = Неопределено Тогда
		Возврат НСтр("ru = 'Ответ провайдера не задан (Неопределено)';
		             |en = 'Provider response is not set (Undefined)'");
	КонецЕсли;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат НСтр("ru = 'Ответ провайдера должен быть структурой';
		             |en = 'Provider response must be a structure'");
	КонецЕсли;

	ОбязательныеКлючи = Новый Массив;
	ОбязательныеКлючи.Добавить("Успех");
	ОбязательныеКлючи.Добавить("Сообщение");
	ОбязательныеКлючи.Добавить("ТокеновВход");
	ОбязательныеКлючи.Добавить("ТокеновВыход");
	ОбязательныеКлючи.Добавить("Ошибка");
	ОбязательныеКлючи.Добавить("КодСостояния");
	// LLM-14 (часть Б): БалансРуб/БалансНизкий намеренно НЕ входят в
	// обязательные ключи - их заполняет только ar_LLMAgentRunnerCloud, а
	// остальные 4 боевых провайдера (OpenAI/YandexGPT/GigaChat/
	// LocalCompatible) и ar_LLMMock не имеют концепции баланса шлюза и не
	// обязаны их присутствием в ответе. Если добавить эти ключи сюда -
	// ВалидироватьОтвет() начнёт проваливаться на ответах всех остальных
	// провайдеров.

	Для Каждого Ключ Из ОбязательныеКлючи Цикл
		Если НЕ Результат.Свойство(Ключ) Тогда
			ШаблонОшибки = НСтр("ru = 'В ответе отсутствует обязательный ключ ""%1""';
			                     |en = 'Required key ""%1"" is missing in response'");
			Возврат СтрШаблон(ШаблонОшибки, Ключ);
		КонецЕсли;
	КонецЦикла;

	Если ТипЗнч(Результат.Успех) <> Тип("Булево") Тогда
		Возврат НСтр("ru = 'Ключ ""Успех"" должен быть типа Булево';
		             |en = 'Key ""Успех"" must be of type Boolean'");
	КонецЕсли;

	Если ТипЗнч(Результат.ТокеновВход) <> Тип("Число") Тогда
		Возврат НСтр("ru = 'Ключ ""ТокеновВход"" должен быть типа Число';
		             |en = 'Key ""ТокеновВход"" must be of type Number'");
	КонецЕсли;

	Если ТипЗнч(Результат.ТокеновВыход) <> Тип("Число") Тогда
		Возврат НСтр("ru = 'Ключ ""ТокеновВыход"" должен быть типа Число';
		             |en = 'Key ""ТокеновВыход"" must be of type Number'");
	КонецЕсли;

	Если ТипЗнч(Результат.Ошибка) <> Тип("Строка") Тогда
		Возврат НСтр("ru = 'Ключ ""Ошибка"" должен быть типа Строка';
		             |en = 'Key ""Ошибка"" must be of type String'");
	КонецЕсли;

	Если ТипЗнч(Результат.КодСостояния) <> Тип("Число") Тогда
		Возврат НСтр("ru = 'Ключ ""КодСостояния"" должен быть типа Число';
		             |en = 'Key ""КодСостояния"" must be of type Number'");
	КонецЕсли;

	// При Успех = Истина обязательно должно быть Сообщение-Структура с role/content.
	Если Результат.Успех Тогда
		Если ТипЗнч(Результат.Сообщение) <> Тип("Структура") Тогда
			Возврат НСтр("ru = 'При Успех = Истина ключ ""Сообщение"" должен быть структурой';
			             |en = 'When Успех = True the ""Сообщение"" key must be a structure'");
		КонецЕсли;
		Если НЕ Результат.Сообщение.Свойство("role") Тогда
			Возврат НСтр("ru = 'Сообщение не содержит ключ ""role""';
			             |en = 'Message does not contain ""role"" key'");
		КонецЕсли;
		Если НЕ Результат.Сообщение.Свойство("content") Тогда
			Возврат НСтр("ru = 'Сообщение не содержит ключ ""content""';
			             |en = 'Message does not contain ""content"" key'");
		КонецЕсли;

		// LLM-06: дополнительно проверяем корректность usage-блока в успешном ответе.
		ОшибкаUsage = ВалидироватьUsage(Результат);
		Если НЕ ПустаяСтрока(ОшибкаUsage) Тогда
			Возврат ОшибкаUsage;
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Создаёт структуру Параметры для функции Чат() провайдера. Заполняет
// обязательные ключи; опциональные (Температура, МаксТокенов, Tools)
// вызывающий код добавляет через Вставить() по необходимости.
//
// Параметры:
//   СсылкаПровайдера - СправочникСсылка.ar_LLMПровайдеры - провайдер.
//   Модель           - Строка - имя модели у провайдера.
//   Таймаут          - Число  - таймаут запроса в секундах, > 0.
//
// Возвращаемое значение:
//   Структура - {
//     Провайдер - СправочникСсылка.ar_LLMПровайдеры
//     Модель    - Строка
//     Таймаут   - Число (секунды)
//   }
//
Функция НовыеПараметры(СсылкаПровайдера, Модель, Таймаут) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Провайдер", СсылкаПровайдера);
	Параметры.Вставить("Модель", Строка(Модель));
	Параметры.Вставить("Таймаут", ?(ТипЗнч(Таймаут) = Тип("Число"), Таймаут, 0));
	Возврат Параметры;

КонецФункции

// Проверяет, соответствует ли массив сообщений контракту входа функции Чат().
// Не выбрасывает исключений: при любой проблеме возвращает непустую строку
// с описанием первой найденной ошибки.
//
// Параметры:
//   Сообщения - Произвольный - массив структур, который планируется передать в Чат().
//
// Возвращаемое значение:
//   Строка - "" если соответствует; иначе текст ошибки.
//
Функция ВалидироватьСообщения(Сообщения) Экспорт

	Если Сообщения = Неопределено Тогда
		Возврат НСтр("ru = 'Массив сообщений не задан (Неопределено)';
		             |en = 'Messages array is not set (Undefined)'");
	КонецЕсли;

	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат НСтр("ru = 'Сообщения должны быть массивом';
		             |en = 'Messages must be an array'");
	КонецЕсли;

	Если Сообщения.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Массив сообщений пуст';
		             |en = 'Messages array is empty'");
	КонецЕсли;

	ДопустимыеРоли = Новый Соответствие;
	ДопустимыеРоли.Вставить(РольSystem(), Истина);
	ДопустимыеРоли.Вставить(РольUser(), Истина);
	ДопустимыеРоли.Вставить(РольAssistant(), Истина);
	ДопустимыеРоли.Вставить(РольTool(), Истина);

	Индекс = 0;
	Для Каждого Сообщение Из Сообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			ШаблонОшибки = НСтр("ru = 'Сообщение №%1 не является структурой';
			                     |en = 'Message #%1 is not a structure'");
			Возврат СтрШаблон(ШаблонОшибки, Формат(Индекс, "ЧГ="));
		КонецЕсли;

		Если НЕ Сообщение.Свойство("role") Тогда
			ШаблонОшибки = НСтр("ru = 'Сообщение №%1 не содержит ключ ""role""';
			                     |en = 'Message #%1 has no ""role"" key'");
			Возврат СтрШаблон(ШаблонОшибки, Формат(Индекс, "ЧГ="));
		КонецЕсли;

		Если НЕ Сообщение.Свойство("content") Тогда
			ШаблонОшибки = НСтр("ru = 'Сообщение №%1 не содержит ключ ""content""';
			                     |en = 'Message #%1 has no ""content"" key'");
			Возврат СтрШаблон(ШаблонОшибки, Формат(Индекс, "ЧГ="));
		КонецЕсли;

		Роль = Строка(Сообщение.role);
		Если ДопустимыеРоли.Получить(Роль) = Неопределено Тогда
			ШаблонОшибки = НСтр("ru = 'Сообщение №%1 содержит недопустимую роль ""%2""';
			                     |en = 'Message #%1 has invalid role ""%2""'");
			Возврат СтрШаблон(ШаблонОшибки, Формат(Индекс, "ЧГ="), Роль);
		КонецЕсли;

		// Для role = "tool" требуется tool_call_id.
		Если Роль = РольTool() Тогда
			Если НЕ Сообщение.Свойство("tool_call_id") Тогда
				ШаблонОшибки = НСтр("ru = 'Сообщение №%1 с ролью ""tool"" не содержит ""tool_call_id""';
				                     |en = 'Message #%1 with role ""tool"" has no ""tool_call_id""'");
				Возврат СтрШаблон(ШаблонОшибки, Формат(Индекс, "ЧГ="));
			КонецЕсли;
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает строковую константу роли системного сообщения.
//
// Возвращаемое значение:
//   Строка - "system".
//
Функция РольSystem() Экспорт
	Возврат "system";
КонецФункции

// Возвращает строковую константу роли пользовательского сообщения.
//
// Возвращаемое значение:
//   Строка - "user".
//
Функция РольUser() Экспорт
	Возврат "user";
КонецФункции

// Возвращает строковую константу роли ответа ассистента.
//
// Возвращаемое значение:
//   Строка - "assistant".
//
Функция РольAssistant() Экспорт
	Возврат "assistant";
КонецФункции

// Возвращает строковую константу роли сообщения результата tool.
//
// Возвращаемое значение:
//   Строка - "tool".
//
Функция РольTool() Экспорт
	Возврат "tool";
КонецФункции

#КонецОбласти

#Область СправочникПоПровайдерам

// Справочник маппинга внутреннего формата AgentRunner на нативные форматы LLM.
// Используется как референс при написании новых провайдеров.
//
// ─────────────────────────────────────────────────────────────────────────────
//  Провайдер        | Особенность system          | Tool calls
// ─────────────────────────────────────────────────────────────────────────────
//  OpenAI           | В messages[0].role="system" | assistant.tool_calls[]
//  Anthropic        | Отдельное поле system       | content blocks tool_use
//                   | верхнего уровня запроса     |
//  YandexGPT        | В messages[0], поле text    | Массив functions +
//                   |                             | text: "[tool result]..."
//  GigaChat         | В messages[0].role="system" | Близко к OpenAI
//  LocalCompatible  | Как OpenAI                  | Как OpenAI ИЛИ
//                   |                             | <tool_call> теги
// ─────────────────────────────────────────────────────────────────────────────
//
// ─────────────────────────────────────────────────────────────────────────────
//  Провайдер        | Tool result                 | Доп. правила
// ─────────────────────────────────────────────────────────────────────────────
//  OpenAI           | отдельное сообщение         | Один в один с
//                   | role="tool"                 | внутренним форматом
//  Anthropic        | content blocks tool_result  | Склейка user+user
//                   |                             | запрещена
//  YandexGPT        | Нет нативного               | Tool result
//                   | tool_call_id                | оборачивается в text
//  GigaChat         | Аналог OpenAI               | OAuth2 в провайдере,
//                   |                             | обновление access_token
//  LocalCompatible  | По                          | Fallback-парсер
//                   | ПоддерживаетToolCalls       | <tool_call>...</tool_call>
// ─────────────────────────────────────────────────────────────────────────────
//
// Базовые принципы маппинга:
//   1. Внутренний массив "Сообщения" — список структур {role, content, ...}.
//   2. Провайдер сам решает, как переложить system: вставить в messages[0]
//      (OpenAI/GigaChat/LocalCompatible/YandexGPT) или в отдельное поле
//      (Anthropic — поле system верхнего уровня).
//   3. role="assistant" с tool_calls возвращается в ответе — провайдер
//      обязан собрать tool_calls во внутренний формат (массив структур
//      {id, type="function", function={name, arguments JSON}}).
//   4. role="tool" в массиве входных сообщений — это ответ инструмента;
//      провайдер обязан транслировать tool_call_id обратно к формату LLM
//      (для YandexGPT — обернуть в текст, для Anthropic — content block
//      tool_result, для OpenAI/GigaChat — оставить как есть).
//   5. usage (prompt_tokens / completion_tokens) — провайдер кладёт в
//      ТокеновВход / ТокеновВыход. Если LLM usage не вернул — оставить 0.
//   6. КодСостояния — HTTP-код ответа (0 при сетевой ошибке).
//   7. Ошибка — пустая строка при Успех = Истина, иначе человекочитаемое
//      описание (без секретов).

#КонецОбласти
