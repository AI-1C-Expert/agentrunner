////////////////////////////////////////////////////////////////////////////////
// Тест-модуль ar_ТестыPLAN - самопроверка совместимости "спящего" статуса
// PausedForEvent с рантайм-обходчиками запусков (планировщик, sweeper).
//
// ЗАЧЕМ ОТДЕЛЬНЫЙ МОДУЛЬ (отличие от ar_ТестыФинансыНаДанных): предмет теста -
// рантайм-обходчики запусков ar_Запуски (планирование, ожидание событий),
// тематически не относится к финансовым tools на данных БП. По образцу того же
// модуля (см. его докстринг) - те же три хелпера Успех/Провал/Пропуск,
// ДобавитьРезультат, СобратьОтчёт.
//
// ЧТО ПРОВЕРЯЕТ (R6, PLAN-14): два самостоятельных обходчика запусков -
// sweeper зависших (ar_AuditЗапуски.НайтиЗависшиеЗапускиБезПривилегий) и
// ретеншен/компакция терминальных статусов (ar_Scheduler.ТерминальныеСтатусыЗапуска) -
// не должны знать про статус PausedForEvent (спящий запуск, ожидающий событие,
// - не зависший и не завершённый). Инвариант зашит только в состав двух
// списков в коде - без единого места объявления он может случайно сломаться
// будущей правкой. Регрессионно проверяется и обратное: ПодсчитатьАктивныеЗапускиБезПривилегий
// обязан УЧИТЫВАТЬ PausedForEvent (R2, закрыто PLAN-12).
//
// ЗАПУСК: ar_ТестыPLAN.ВыполнитьВсе() - возвращает текстовый отчёт. Кнопка
// «Самопроверка» на форме ar_Диалог вызывает её вместе с ar_ТестыФинансыНаДанных.
//
// READ-ONLY, за единственным документированным исключением (по образцу PAY-01
// в ar_ТестыФинансыНаДанных): проверки sweeper/R2 создают ОДНУ временную
// служебную запись регистра сведений ar_Запуски с RunId по префиксу
// "plan14-test-" (не пересекается по формату с боевыми UUID-RunId) и
// гарантированно удаляют её в блоке Попытка...Исключение сразу после
// проверок, вне зависимости от исхода.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполнить все проверки и вернуть отчёт.
//
// Возвращаемое значение:
//  Строка - многострочный отчёт: по строке на проверку + итог.
//
Функция ВыполнитьВсе() Экспорт

	Результаты = Новый Массив;

	ДобавитьРезультат(Результаты, "PausedForEvent не входит в терминальные статусы",
		ПроверкаPausedForEventНеТерминальный());
	ДобавитьРезультат(Результаты, "PausedForEvent не считается зависшим sweeper'ом",
		ПроверкаPausedForEventНеЗависший());
	ДобавитьРезультат(Результаты, "PausedForEvent учитывается в активных запусках (R2)",
		ПроверкаPausedForEventУчтёнВАктивных());

	Возврат СобратьОтчёт(Результаты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// R6: ТерминальныеСтатусыЗапуска() используется ретеншеном/компакцией событий
// терминальных запусков (ar_Scheduler). Спящий запуск, ожидающий событие,
// не должен туда попасть - иначе его данные будут ретеншены/компактированы,
// хотя запуск ещё не завершён и рано или поздно должен проснуться.
//
// Не создаёт и не пишет ни одной записи в ИБ - список читается напрямую.
Функция ПроверкаPausedForEventНеТерминальный()

	Попытка
		Статусы = ar_Scheduler.ТерминальныеСтатусыЗапуска();
	Исключение
		Возврат Провал("исключение при вызове ТерминальныеСтатусыЗапуска: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Статусы = Неопределено Или ТипЗнч(Статусы) <> Тип("Массив") Тогда
		Возврат Провал("ТерминальныеСтатусыЗапуска вернула не массив");
	КонецЕсли;

	Если Статусы.Найти(Перечисления.ar_СтатусЗапуска.PausedForEvent) <> Неопределено Тогда
		Возврат Провал("PausedForEvent найден в ТерминальныеСтатусыЗапуска() - спящий "
			+ "запуск попадёт под ретеншен/компакцию терминальных запусков");
	КонецЕсли;

	Возврат Успех();

КонецФункции

// R6: НайтиЗависшиеЗапускиБезПривилегий отбирает Running/PausedForApproval по
// устаревшему LastHeartbeat. Проверка поведенческая (текст запроса программно
// не читается) - создаёт одну временную запись PausedForEvent с давним
// LastHeartbeat и убеждается, что sweeper её НЕ находит, даже если бы функция
// смотрела только на возраст heartbeat, а не на статус.
//
// Создаёт и гарантированно удаляет временную запись ar_Запуски (см. докстринг
// модуля) - единственное документированное исключение из READ-ONLY.
Функция ПроверкаPausedForEventНеЗависший()

	RunId = НовыйТестовыйRunId();

	Попытка
		СоздатьТестовыйЗапуск(RunId);
	Исключение
		Возврат Провал("не удалось создать временную тестовую запись ar_Запуски: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка

		Попытка
			Зависшие = ar_AuditЗащищённыйРежим.НайтиЗависшиеЗапускиПривилегированно(ТекущаяДатаСеанса());
		Исключение
			УдалитьТестовыйЗапуск(RunId);
			Возврат Провал("исключение при вызове НайтиЗависшиеЗапускиБезПривилегий: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если Зависшие <> Неопределено И Зависшие.Найти(RunId) <> Неопределено Тогда
			УдалитьТестовыйЗапуск(RunId);
			Возврат Провал("тестовый запуск со статусом PausedForEvent и давним "
				+ "LastHeartbeat найден НайтиЗависшиеЗапускиБезПривилегий - спящий "
				+ "запуск будет ошибочно прерван sweeper'ом как зависший");
		КонецЕсли;

		УдалитьТестовыйЗапуск(RunId);
		Возврат Успех();

	Исключение
		УдалитьТестовыйЗапуск(RunId);
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// R2 (регрессия, закрыто PLAN-12): в отличие от двух проверок выше, здесь
// ожидание обратное - PausedForEvent ДОЛЖЕН учитываться в подсчёте активных
// запусков (слот планировщика занят, пока запуск ждёт события). Переиспользует
// тот же приём временной записи.
Функция ПроверкаPausedForEventУчтёнВАктивных()

	RunId = НовыйТестовыйRunId();

	Попытка
		СоздатьТестовыйЗапуск(RunId);
	Исключение
		Возврат Провал("не удалось создать временную тестовую запись ar_Запуски: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка

		Попытка
			Счётчики = ar_AuditЗащищённыйРежим.ПодсчитатьАктивныеЗапускиПривилегированно(Неопределено);
		Исключение
			УдалитьТестовыйЗапуск(RunId);
			Возврат Провал("исключение при вызове ПодсчитатьАктивныеЗапускиБезПривилегий: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если Счётчики = Неопределено Или Счётчики.ВсегоАктивных < 1 Тогда
			УдалитьТестовыйЗапуск(RunId);
			Возврат Провал("тестовый запуск со статусом PausedForEvent НЕ учтён в "
				+ "ВсегоАктивных ПодсчитатьАктивныеЗапускиБезПривилегий - слот "
				+ "планировщика будет ошибочно считаться свободным");
		КонецЕсли;

		УдалитьТестовыйЗапуск(RunId);
		Возврат Успех();

	Исключение
		УдалитьТестовыйЗапуск(RunId);
		Возврат Провал("исключение: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Сгенерировать фиктивный RunId с узнаваемым префиксом - не пересекается по
// формату с боевыми UUID-RunId (см. докстринг модуля), поле ar_RunId -
// Строка(36).
Функция НовыйТестовыйRunId()

	ДлинаПоляRunId = 36;
	Возврат Лев("plan14-test-" + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", ""), ДлинаПоляRunId);

КонецФункции

// Создать временную запись ar_Запуски со статусом PausedForEvent и давним
// LastHeartbeat - через привилегированный фасад ar_AuditЗащищённыйРежим
// (аналогично боевому пути создания запуска, ar_RuntimeЗапуск). Модуль
// ar_AuditЗапуски сам привилегий не поднимает (AUD-06) - обычная роль
// самопроверки не имеет права добавления записей в ar_Запуски.
Процедура СоздатьТестовыйЗапуск(Знач RunId)

	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Статус", Перечисления.ar_СтатусЗапуска.PausedForEvent);
	СтруктураДанных.Вставить("LastHeartbeat", ДобавитьМесяц(ТекущаяДатаСеанса(), -12));
	СтруктураДанных.Вставить("Триггер", "manual");

	ar_AuditЗащищённыйРежим.СоздатьЗапускПривилегированно(RunId, СтруктураДанных);

КонецПроцедуры

// Гарантированно удалить временную тестовую запись ar_Запуски. Вызывается из
// блоков Попытка...Исключение обеих проверок выше вне зависимости от исхода -
// тест не должен оставлять запись даже при собственном сбое (см. докстринг
// модуля). Привилегия поднимается локально (парно со сбросом в Попытка/
// Исключение) - готового фасада на удаление записи в ar_AuditЗащищённыйРежим
// нет, а обычная роль самопроверки не имеет права удаления записей регистра.
Процедура УдалитьТестовыйЗапуск(Знач RunId)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи = РегистрыСведений.ar_Запуски.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_RunId = RunId;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		// Намеренно проглатываем - очистка не должна маскировать исходную
		// ошибку проверки исключением из finally-блока. Осиротевшая запись с
		// префиксом plan14-test- легко находится вручную (см. докстринг).
	КонецПопытки;

КонецПроцедуры

Функция Успех(Знач Деталь = "")
	Возврат Новый Структура("Статус, Деталь", "OK", Деталь);
КонецФункции

Функция Провал(Знач Деталь)
	Возврат Новый Структура("Статус, Деталь", "FAIL", Деталь);
КонецФункции

// Пропуск - когда данных для проверки в базе нет. Это не провал: на пустой
// или нетиповой базе часть проверок физически неприменима.
Функция Пропуск(Знач Деталь)
	Возврат Новый Структура("Статус, Деталь", "SKIP", Деталь);
КонецФункции

Процедура ДобавитьРезультат(Результаты, Знач Имя, Знач Итог)
	Строка = Новый Структура("Имя, Статус, Деталь", Имя, Итог.Статус, Итог.Деталь);
	Результаты.Добавить(Строка);
КонецПроцедуры

// Собрать текстовый отчёт: по строке на проверку + итоговая сводка.
Функция СобратьОтчёт(Знач Результаты)

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Самопроверка планирования и ожидания событий (PausedForEvent)';
		|en = 'Self-check: scheduling and event waiting (PausedForEvent)'"));
	Строки.Добавить(НСтр("ru = 'Версия расширения: '; en = 'Extension version: '") + ВерсияРасширения());
	Строки.Добавить(НСтр("ru = 'Дата: '; en = 'Date: '") + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Строки.Добавить("");

	ВсегоОК = 0;
	ВсегоПровалов = 0;
	ВсегоПропусков = 0;

	Для Каждого Результат Из Результаты Цикл
		Если Результат.Статус = "OK" Тогда
			ВсегоОК = ВсегоОК + 1;
		ИначеЕсли Результат.Статус = "FAIL" Тогда
			ВсегоПровалов = ВсегоПровалов + 1;
		Иначе
			ВсегоПропусков = ВсегоПропусков + 1;
		КонецЕсли;

		Строка = "[" + Результат.Статус + "] " + Результат.Имя;
		Если Не ПустаяСтрока(Результат.Деталь) Тогда
			Строка = Строка + " - " + Результат.Деталь;
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;

	Строки.Добавить("");
	Строки.Добавить(НСтр("ru = 'Итог: '; en = 'Total: '") + "OK=" + Строка(ВсегоОК)
		+ ", FAIL=" + Строка(ВсегоПровалов)
		+ ", SKIP=" + Строка(ВсегоПропусков));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Версия расширения для шапки отчёта (тот же приём, что в ar_ТестыФинансыНаДанных).
Функция ВерсияРасширения()

	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "AgentRunner" Тогда
				Возврат Расширение.Версия;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат НСтр("ru = 'неизвестна'; en = 'unknown'");
	КонецПопытки;

	Возврат НСтр("ru = 'неизвестна'; en = 'unknown'");

КонецФункции

#КонецОбласти
