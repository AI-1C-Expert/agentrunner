// Общий серверный модуль ar_HTTPСервисПомощник.
//
// Содержит переиспользуемые функции для HTTP-сервисов AgentRunner:
//   - Проверка заголовка X-Agent-Token через ar_Secrets.
//   - Формирование JSON-ответов (успех и ошибка).
//
// Используется модулями: ar_AgentsAPI, ar_RunsAPI, ar_HealthAPI.
//
// Безопасность:
//   * Значение X-Agent-Token нигде не логируется.
//   * Модуль не является привилегированным -- чтение секретов
//     происходит через ar_Secrets, который сам является привилегированным (SEC-01).
//   * В модуле нет Выполнить() / Вычислить().
//
// Зависимости: ar_Secrets, ar_JSON.
//
// См. спеку: .docs/specs/HTTPS-04.md, Plan §2.7.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверить заголовок X-Agent-Token входящего HTTP-запроса.
// Значение токена НЕ пишется в журнал регистрации ни при каком исходе.
//
// Параметры:
//   ТокенИдентификатор - Строка          - UUID-строка токена агента
//                                          (реквизит ar_Агенты.ТокенИдентификатор или
//                                           ДанныеЗапуска.ТокенИдентификатор). Может быть пустым.
//   Запрос             - HTTPСервисЗапрос - входящий запрос. Значение заголовка
//                                          токена агента не логируется.
//
// Возвращаемое значение:
//   Структура - {Успех: Булево, КодОшибки: Строка}.
//   Возможные значения КодОшибки:
//     ""                     -- при Успех = Истина.
//     "invalid_token"        -- заголовок отсутствует, пустой или не совпадает с хранилищем.
//     "token_not_configured" -- ТокенИдентификатор пустой или ключ отсутствует в хранилище.
//
Функция ПроверитьТокенАгента(Знач ТокенИдентификатор, Знач Запрос) Экспорт

	Результат = Новый Структура("Успех, КодОшибки", Ложь, "");

	// Читаем заголовок -- значение токена нигде не логируем.
	ТокенЗапроса = Неопределено;
	Попытка
		ТокенЗапроса = Запрос.Заголовки["X-Agent-Token"];
	Исключение
		Результат.КодОшибки = "invalid_token";
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(ТокенЗапроса) <> Тип("Строка") Или ПустаяСтрока(ТокенЗапроса) Тогда
		Результат.КодОшибки = "invalid_token";
		Возврат Результат;
	КонецЕсли;

	// Проверяем, задан ли идентификатор токена.
	Если ПустаяСтрока(ТокенИдентификатор) Тогда
		Результат.КодОшибки = "token_not_configured";
		Возврат Результат;
	КонецЕсли;

	// Получаем логический ключ для БезопасноеХранилище через ar_Secrets.
	КлючСекрета = "";
	Попытка
		КлючСекрета = ar_Secrets.КлючТокенаАгента(ТокенИдентификатор);
	Исключение
		Результат.КодОшибки = "token_not_configured";
		Возврат Результат;
	КонецПопытки;

	// Читаем эталонный токен из БезопасноеХранилище через ar_Secrets (привилегированный).
	ЭталонныйТокен = Неопределено;
	Попытка
		ЭталонныйТокен = ar_Secrets.Прочитать(КлючСекрета);
	Исключение
		// Хранилище временно недоступно -- возвращаем 401, не раскрываем причину.
		Результат.КодОшибки = "invalid_token";
		Возврат Результат;
	КонецПопытки;

	Если ЭталонныйТокен = Неопределено Тогда
		Результат.КодОшибки = "token_not_configured";
		Возврат Результат;
	КонецЕсли;

	// Побайтовое сравнение (платформенное сравнение строк -- без timing attack protection,
	// достаточно для текущего threat model согласно SEC-01).
	Если ТокенЗапроса <> ЭталонныйТокен Тогда
		Результат.КодОшибки = "invalid_token";
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Сформировать HTTPСервисОтвет с телом JSON и заголовком Content-Type: application/json.
//
// Параметры:
//   КодСостояния - Число                  - HTTP-код ответа (200, 202 и т.д.).
//   Данные       - Структура, Соответствие - данные для JSON-сериализации через ar_JSON.ВЗначениеJSON.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с заголовком Content-Type: application/json; charset=utf-8 и телом в UTF-8.
//
Функция СформироватьОтветJSON(Знач КодСостояния, Знач Данные) Экспорт

	ОтветJSON = ar_JSON.ВЗначениеJSON(Данные);
	Если ПустаяСтрока(ОтветJSON) Тогда
		ОтветJSON = "{}";
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.УстановитьТелоИзСтроки(ОтветJSON, КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции

// Сформировать HTTPСервисОтвет с JSON-телом ошибки вида:
// {"error": {"code": "<Код>", "message": "<Сообщение>"}}.
//
// Параметры:
//   КодСостояния - Число  - HTTP-код ответа (400, 401, 403, 404, 422, 500 и т.д.).
//   Код          - Строка - машиночитаемый код ошибки (например, "invalid_token").
//   Сообщение    - Строка - человекочитаемое описание ошибки для разработчика.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с JSON-телом ошибки.
//
Функция СформироватьОтветОшибки(Знач КодСостояния, Знач Код, Знач Сообщение) Экспорт

	ОшибкаОбъект = Новый Структура;
	ОшибкаОбъект.Вставить("code",    Код);
	ОшибкаОбъект.Вставить("message", Сообщение);

	ТелоОтвета = Новый Структура;
	ТелоОтвета.Вставить("error", ОшибкаОбъект);

	Возврат СформироватьОтветJSON(КодСостояния, ТелоОтвета);

КонецФункции

#КонецОбласти
