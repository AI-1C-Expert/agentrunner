#Область ПрограммныйИнтерфейс

// Проверяет, должен ли агент запускаться в указанный момент времени.
//
// Параметры:
//   ВыражениеCron - Строка - cron-выражение из 5 полей:
//       "минуты часы день_месяца месяц день_недели".
//   МоментВремени - Дата - проверяемый момент (секунды игнорируются,
//       анализируются минута, час, день месяца, месяц, день недели).
//
// Возвращаемое значение:
//   Булево - Истина, если выражение совпадает с моментом времени;
//       Ложь, если не совпадает или выражение не удалось разобрать.
//
Функция СовпадаетСВременем(ВыражениеCron, МоментВремени) Экспорт

	РезультатРазбора = РазобратьВыражение(ВыражениеCron);
	Если Не РезультатРазбора.ОК Тогда
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru='Некорректное cron-выражение «%1»: %2'; en='Invalid cron expression ""%1"": %2'"),
			ВыражениеCron,
			РезультатРазбора.Ошибка);
		ЗаписатьПредупреждение(ТекстПредупреждения);
		Возврат Ложь;
	КонецЕсли;

	Возврат СовпадаетСРазбором(РезультатРазбора, МоментВремени);

КонецФункции

// Разбирает cron-выражение в структуру с массивами допустимых значений по каждому полю.
//
// Параметры:
//   ВыражениеCron - Строка - cron-выражение из 5 полей.
//
// Возвращаемое значение:
//   Структура - результат разбора:
//     * ОК        - Булево - Истина, если выражение корректно;
//     * Ошибка    - Строка - текст ошибки (пустой при ОК = Истина);
//     * Минуты    - Массив из Число - допустимые минуты, 0..59;
//     * Часы      - Массив из Число - допустимые часы, 0..23;
//     * ДниМесяца - Массив из Число - допустимые дни месяца, 1..31;
//     * Месяцы    - Массив из Число - допустимые месяцы, 1..12;
//     * ДниНедели - Массив из Число - допустимые дни недели, 0..6 (0 = воскресенье).
//
Функция РазобратьВыражение(ВыражениеCron) Экспорт

	Результат = ПустойРезультатРазбора();

	НормализованноеВыражение = СокрЛП(Строка(ВыражениеCron));
	Поля = СтрРазделить(НормализованноеВыражение, " ", Ложь);
	// Лишние пробелы между полями: убираем пустые фрагменты.
	НепустыеПоля = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Если Не ПустаяСтрока(Поле) Тогда
			НепустыеПоля.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;

	КоличествоПолейCron = 5;
	Если НепустыеПоля.Количество() <> КоличествоПолейCron Тогда
		Результат.ОК = Ложь;
		Результат.Ошибка = СтрШаблон(
			НСтр("ru='Ожидается 5 полей, получено %1'; en='5 fields expected, got %1'"),
			НепустыеПоля.Количество());
		Возврат Результат;
	КонецЕсли;

	ОписанияПолей = ОписанияПолейCron();

	Для НомерПоля = 1 По КоличествоПолейCron Цикл
		Описание = ОписанияПолей[НомерПоля - 1];
		РазборПоля = РазобратьПоле(НепустыеПоля[НомерПоля - 1], Описание.Мин, Описание.Макс,
			НомерПоля, Описание.Имя, Описание.ВоскресеньеКак0);
		Если Не РазборПоля.ОК Тогда
			Результат.ОК = Ложь;
			Результат.Ошибка = РазборПоля.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат[Описание.Ключ] = РазборПоля.Значения;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вычисляет ближайший момент после ОтметкаВремени, когда cron-выражение сработает.
// Используется планировщиком для пропуска уже прошедших минут при старте/рестарте.
//
// Параметры:
//   ВыражениеCron    - Строка - cron-выражение из 5 полей.
//   ОтметкаВремени   - Дата   - момент, после которого ищется срабатывание.
//   ОграничениеМинут - Число  - максимум проверяемых минут (по умолчанию 525960 = 366 суток).
//
// Возвращаемое значение:
//   Дата         - ближайший момент срабатывания (секунды = 0);
//   Неопределено - если за ОграничениеМинут совпадений не найдено или выражение некорректно.
//
Функция СледующийМомент(ВыражениеCron, ОтметкаВремени, ОграничениеМинут = 525960) Экспорт

	РезультатРазбора = РазобратьВыражение(ВыражениеCron);
	Если Не РезультатРазбора.ОК Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОтметкаБезСекунд = ОтметкаВремени - Секунда(ОтметкаВремени);
	Кандидат = ОтметкаБезСекунд + 60;
	ОставшихсяШагов = ОграничениеМинут;
	Пока ОставшихсяШагов > 0 Цикл
		Если СовпадаетСРазбором(РезультатРазбора, Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
		Кандидат = Кандидат + 60;
		ОставшихсяШагов = ОставшихсяШагов - 1;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает пустую структуру результата разбора с заполненными ключами.
//
// Возвращаемое значение:
//   Структура - см. РазобратьВыражение.
//
Функция ПустойРезультатРазбора()

	Результат = Новый Структура;
	Результат.Вставить("ОК", Истина);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Минуты", Новый Массив);
	Результат.Вставить("Часы", Новый Массив);
	Результат.Вставить("ДниМесяца", Новый Массив);
	Результат.Вставить("Месяцы", Новый Массив);
	Результат.Вставить("ДниНедели", Новый Массив);
	Возврат Результат;

КонецФункции

// Возвращает описания пяти полей cron в порядке следования.
//
// Возвращаемое значение:
//   Массив из Структура - по полю:
//     * Имя   - Строка;
//     * Ключ  - Строка - ключ в структуре результата;
//     * Мин   - Число;
//     * Макс  - Число;
//     * ВоскресеньеКак0 - Булево - Истина для поля дня недели (значение 7 = 0).
//
Функция ОписанияПолейCron()

	Описания = Новый Массив;
	Описания.Добавить(ОписаниеПоля(НСтр("ru='Минуты'; en='Minutes'"), "Минуты", 0, 59, Ложь));
	Описания.Добавить(ОписаниеПоля(НСтр("ru='Часы'; en='Hours'"), "Часы", 0, 23, Ложь));
	Описания.Добавить(ОписаниеПоля(НСтр("ru='День месяца'; en='Day of month'"), "ДниМесяца", 1, 31, Ложь));
	Описания.Добавить(ОписаниеПоля(НСтр("ru='Месяц'; en='Month'"), "Месяцы", 1, 12, Ложь));
	Описания.Добавить(ОписаниеПоля(НСтр("ru='День недели'; en='Day of week'"), "ДниНедели", 0, 6, Истина));
	Возврат Описания;

КонецФункции

// Конструктор структуры описания поля.
//
// Параметры:
//   Имя   - Строка - человекочитаемое имя поля;
//   Ключ  - Строка - ключ поля в структуре результата разбора;
//   Мин   - Число  - нижняя граница допустимых значений;
//   Макс  - Число  - верхняя граница допустимых значений;
//   ВоскресеньеКак0 - Булево - Истина для поля дня недели (значение 7 = 0).
//
// Возвращаемое значение:
//   Структура - описание поля.
//
Функция ОписаниеПоля(Имя, Ключ, Мин, Макс, ВоскресеньеКак0)

	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Ключ", Ключ);
	Описание.Вставить("Мин", Мин);
	Описание.Вставить("Макс", Макс);
	Описание.Вставить("ВоскресеньеКак0", ВоскресеньеКак0);
	Возврат Описание;

КонецФункции

// Разбирает одно поле cron в массив допустимых числовых значений.
//
// Параметры:
//   Поле     - Строка - текст поля (может содержать сегменты через запятую);
//   Мин      - Число  - нижняя граница допустимых значений;
//   Макс     - Число  - верхняя граница допустимых значений;
//   НомерПоля - Число - порядковый номер поля (1..5) для сообщения об ошибке;
//   ИмяПоля  - Строка - человекочитаемое имя поля для сообщения об ошибке;
//   ВоскресеньеКак0 - Булево - Истина, если значение 7 трактуется как 0.
//
// Возвращаемое значение:
//   Структура:
//     * ОК       - Булево;
//     * Ошибка   - Строка;
//     * Значения - Массив из Число - отсортированные уникальные значения.
//
Функция РазобратьПоле(Поле, Мин, Макс, НомерПоля, ИмяПоля, ВоскресеньеКак0)

	Результат = НовыйРезультатРазбораПоля();
	НаборЗначений = Новый Соответствие;

	Сегменты = СтрРазделить(Поле, ",", Истина);
	Для Каждого ИсходныйСегмент Из Сегменты Цикл
		Сегмент = СокрЛП(ИсходныйСегмент);
		РазборСегмента = РазобратьСегмент(Сегмент, Мин, Макс, НомерПоля, ИмяПоля, ВоскресеньеКак0);
		Если Не РазборСегмента.ОК Тогда
			Результат.ОК = Ложь;
			Результат.Ошибка = РазборСегмента.Ошибка;
			Результат.Значения.Очистить();
			Возврат Результат;
		КонецЕсли;
		Для Каждого Значение Из РазборСегмента.Значения Цикл
			НаборЗначений.Вставить(Значение, Истина);
		КонецЦикла;
	КонецЦикла;

	ТаблицаСортировки = Новый ТаблицаЗначений;
	ТаблицаСортировки.Колонки.Добавить("Значение");
	Для Каждого КлючЗначение Из НаборЗначений Цикл
		ТаблицаСортировки.Добавить().Значение = КлючЗначение.Ключ;
	КонецЦикла;
	ТаблицаСортировки.Сортировать("Значение Возр");

	Значения = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		Значения.Добавить(СтрокаТаблицы.Значение);
	КонецЦикла;
	Результат.Значения = Значения;
	Возврат Результат;

КонецФункции

// Разбирает один сегмент поля cron: "*", "*/N", "A-B" или число.
// Диспетчеризует сегмент в специализированный обработчик по его форме.
//
// Параметры:
//   Сегмент  - Строка - текст сегмента;
//   Мин      - Число  - нижняя граница допустимых значений;
//   Макс     - Число  - верхняя граница допустимых значений;
//   НомерПоля - Число - порядковый номер поля для сообщения об ошибке;
//   ИмяПоля  - Строка - имя поля для сообщения об ошибке;
//   ВоскресеньеКак0 - Булево - Истина, если значение 7 трактуется как 0.
//
// Возвращаемое значение:
//   Структура - "ОК, Ошибка, Значения" (Массив из Число).
//
Функция РазобратьСегмент(Сегмент, Мин, Макс, НомерПоля, ИмяПоля, ВоскресеньеКак0)

	Если ПустаяСтрока(Сегмент) Тогда
		Возврат ОшибкаПоля(НовыйРезультатРазбораПоля(), НомерПоля, ИмяПоля,
			НСтр("ru='пустой сегмент'; en='empty segment'"));
	КонецЕсли;

	Если Сегмент = "*" Тогда
		Возврат СегментЗвездочка(Мин, Макс);
	КонецЕсли;

	Если СтрНачинаетсяС(Сегмент, "*/") Тогда
		Возврат СегментШаг(Сегмент, Мин, Макс, НомерПоля, ИмяПоля);
	КонецЕсли;

	Если СтрНайти(Сегмент, "-") > 0 Тогда
		Возврат СегментДиапазон(Сегмент, Мин, Макс, НомерПоля, ИмяПоля, ВоскресеньеКак0);
	КонецЕсли;

	Возврат СегментЧисло(Сегмент, Мин, Макс, НомерПоля, ИмяПоля, ВоскресеньеКак0);

КонецФункции

// Обрабатывает сегмент "*" — все значения диапазона.
//
// Параметры:
//   Мин  - Число - нижняя граница диапазона;
//   Макс - Число - верхняя граница диапазона.
//
// Возвращаемое значение:
//   Структура - результат разбора сегмента (см. НовыйРезультатРазбораПоля).
//
Функция СегментЗвездочка(Мин, Макс)

	Результат = НовыйРезультатРазбораПоля();
	ДобавитьДиапазон(Результат.Значения, Мин, Макс, 1);
	Возврат Результат;

КонецФункции

// Обрабатывает сегмент "*/N" — значения с шагом N.
//
// Параметры:
//   Сегмент  - Строка - текст сегмента вида "*/N";
//   Мин      - Число  - нижняя граница диапазона;
//   Макс     - Число  - верхняя граница диапазона;
//   НомерПоля - Число - порядковый номер поля для сообщения об ошибке;
//   ИмяПоля  - Строка - имя поля для сообщения об ошибке.
//
// Возвращаемое значение:
//   Структура - результат разбора сегмента (см. НовыйРезультатРазбораПоля).
//
Функция СегментШаг(Сегмент, Мин, Макс, НомерПоля, ИмяПоля)

	Результат = НовыйРезультатРазбораПоля();
	ТекстШага = Сред(Сегмент, 3);
	РазборШага = ВЦелоеЧисло(ТекстШага);
	Если Не РазборШага.ОК Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СообщениеНеЧисло(ТекстШага));
	КонецЕсли;
	Если РазборШага.Значение < 1 Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СтрШаблон(
			НСтр("ru='шаг %1 недопустим'; en='step %1 is invalid'"), РазборШага.Значение));
	КонецЕсли;
	ДобавитьДиапазон(Результат.Значения, Мин, Макс, РазборШага.Значение);
	Возврат Результат;

КонецФункции

// Обрабатывает сегмент "A-B" — диапазон значений.
//
// Параметры:
//   Сегмент  - Строка - текст сегмента вида "A-B";
//   Мин      - Число  - нижняя граница допустимых значений;
//   Макс     - Число  - верхняя граница допустимых значений;
//   НомерПоля - Число - порядковый номер поля для сообщения об ошибке;
//   ИмяПоля  - Строка - имя поля для сообщения об ошибке;
//   ВоскресеньеКак0 - Булево - Истина, если значение 7 трактуется как 0.
//
// Возвращаемое значение:
//   Структура - результат разбора сегмента (см. НовыйРезультатРазбораПоля).
//
Функция СегментДиапазон(Сегмент, Мин, Макс, НомерПоля, ИмяПоля, ВоскресеньеКак0)

	Результат = НовыйРезультатРазбораПоля();
	Границы = СтрРазделить(Сегмент, "-", Истина);
	Если Границы.Количество() <> 2 Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СообщениеДиапазонНекорректен(Сегмент));
	КонецЕсли;
	РазборНачала = ВЦелоеЧисло(СокрЛП(Границы[0]));
	РазборКонца = ВЦелоеЧисло(СокрЛП(Границы[1]));
	Если Не РазборНачала.ОК Или Не РазборКонца.ОК Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СообщениеНеЧисло(Сегмент));
	КонецЕсли;
	Начало = НормализоватьЗначение(РазборНачала.Значение, ВоскресеньеКак0);
	Конец = НормализоватьЗначение(РазборКонца.Значение, ВоскресеньеКак0);
	Если Начало > Конец Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СообщениеДиапазонНекорректен(Сегмент));
	КонецЕсли;
	Если Начало < Мин Или Конец > Макс Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СтрШаблон(
			НСтр("ru='диапазон %1 вне границ [%2,%3]'; en='range %1 out of bounds [%2,%3]'"),
			Сегмент, Мин, Макс));
	КонецЕсли;
	ДобавитьДиапазон(Результат.Значения, Начало, Конец, 1);
	Возврат Результат;

КонецФункции

// Обрабатывает сегмент в виде одиночного числа.
//
// Параметры:
//   Сегмент  - Строка - текст сегмента (число);
//   Мин      - Число  - нижняя граница допустимых значений;
//   Макс     - Число  - верхняя граница допустимых значений;
//   НомерПоля - Число - порядковый номер поля для сообщения об ошибке;
//   ИмяПоля  - Строка - имя поля для сообщения об ошибке;
//   ВоскресеньеКак0 - Булево - Истина, если значение 7 трактуется как 0.
//
// Возвращаемое значение:
//   Структура - результат разбора сегмента (см. НовыйРезультатРазбораПоля).
//
Функция СегментЧисло(Сегмент, Мин, Макс, НомерПоля, ИмяПоля, ВоскресеньеКак0)

	Результат = НовыйРезультатРазбораПоля();
	РазборЧисла = ВЦелоеЧисло(Сегмент);
	Если Не РазборЧисла.ОК Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СообщениеНеЧисло(Сегмент));
	КонецЕсли;
	Значение = НормализоватьЗначение(РазборЧисла.Значение, ВоскресеньеКак0);
	Если Значение < Мин Или Значение > Макс Тогда
		Возврат ОшибкаПоля(Результат, НомерПоля, ИмяПоля, СтрШаблон(
			НСтр("ru='%1 вне диапазона [%2,%3]'; en='%1 out of range [%2,%3]'"),
			РазборЧисла.Значение, Мин, Макс));
	КонецЕсли;
	Результат.Значения.Добавить(Значение);
	Возврат Результат;

КонецФункции

// Конструктор пустого результата разбора поля/сегмента.
//
// Возвращаемое значение:
//   Структура - "ОК, Ошибка, Значения" (Массив из Число).
//
Функция НовыйРезультатРазбораПоля()

	Результат = Новый Структура;
	Результат.Вставить("ОК", Истина);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Значения", Новый Массив);
	Возврат Результат;

КонецФункции

// Формирует сообщение о нечисловом значении.
//
// Параметры:
//   Текст - Строка - значение, не являющееся числом.
//
// Возвращаемое значение:
//   Строка - локализованный текст сообщения.
//
Функция СообщениеНеЧисло(Знач Текст)

	Возврат СтрШаблон(
		НСтр("ru='«%1» не является числом'; en='""%1"" is not a number'"), Текст);

КонецФункции

// Формирует сообщение о некорректном диапазоне.
//
// Параметры:
//   Сегмент - Строка - текст сегмента-диапазона.
//
// Возвращаемое значение:
//   Строка - локализованный текст сообщения.
//
Функция СообщениеДиапазонНекорректен(Знач Сегмент)

	Возврат СтрШаблон(
		НСтр("ru='диапазон %1 некорректен'; en='range %1 is malformed'"), Сегмент);

КонецФункции

// Преобразует значение дня недели 7 в 0 (воскресенье) для поля дня недели.
//
// Параметры:
//   Значение - Число - исходное числовое значение;
//   ВоскресеньеКак0 - Булево - Истина, если значение 7 трактуется как 0.
//
// Возвращаемое значение:
//   Число - нормализованное значение.
//
Функция НормализоватьЗначение(Значение, ВоскресеньеКак0)

	ВоскресеньеPOSIX7 = 7;
	Если ВоскресеньеКак0 И Значение = ВоскресеньеPOSIX7 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Добавляет в массив значения от Начало до Конец с заданным шагом.
//
// Параметры:
//   Значения - Массив - изменяемый массив-приемник;
//   Начало   - Число  - первое добавляемое значение;
//   Конец    - Число  - верхняя граница (включительно);
//   Шаг      - Число  - приращение.
//
Процедура ДобавитьДиапазон(Значения, Начало, Конец, Шаг)

	Текущее = Начало;
	Пока Текущее <= Конец Цикл
		Значения.Добавить(Текущее);
		Текущее = Текущее + Шаг;
	КонецЦикла;

КонецПроцедуры

// Заполняет результат разбора сегмента сообщением об ошибке поля.
//
// Параметры:
//   Результат - Структура - изменяемый результат разбора;
//   НомерПоля - Число  - порядковый номер поля;
//   ИмяПоля  - Строка - имя поля;
//   Причина  - Строка - причина ошибки.
//
// Возвращаемое значение:
//   Структура - тот же результат с заполненными ОК = Ложь и Ошибка.
//
Функция ОшибкаПоля(Результат, НомерПоля, ИмяПоля, Причина)

	Результат.ОК = Ложь;
	Результат.Ошибка = СтрШаблон(
		НСтр("ru='Поле %1 (%2): %3'; en='Field %1 (%2): %3'"),
		НомерПоля, ИмяПоля, Причина);
	Результат.Значения.Очистить();
	Возврат Результат;

КонецФункции

// Преобразует строку в целое неотрицательное число.
//
// Параметры:
//   Текст - Строка - исходная строка.
//
// Возвращаемое значение:
//   Структура:
//     * ОК       - Булево - Истина, если строка состоит только из цифр;
//     * Значение - Число  - результат (0 при ОК = Ложь).
//
Функция ВЦелоеЧисло(Текст)

	Результат = Новый Структура("ОК, Значение", Ложь, 0);
	Строка = СокрЛП(Текст);
	Если ПустаяСтрока(Строка) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат.ОК = Истина;
	Результат.Значение = Число(Строка);
	Возврат Результат;

КонецФункции

// Проверяет совпадение уже разобранного выражения с моментом времени.
// Внутренний аналог СовпадаетСВременем для повторного использования в СледующийМомент
// без повторного разбора строки.
//
// Параметры:
//   РезультатРазбора - Структура - результат РазобратьВыражение с ОК = Истина;
//   МоментВремени    - Дата      - проверяемый момент.
//
// Возвращаемое значение:
//   Булево - Истина, если все компоненты момента входят в разобранные значения.
//
Функция СовпадаетСРазбором(РезультатРазбора, МоментВремени)

	// Платформа: ДеньНедели = 1(Пн)..7(Вс). POSIX cron: 0(Вс)..6(Сб).
	ДнейВНеделе = 7;
	ДеньНеделиPOSIX = ДеньНедели(МоментВремени) % ДнейВНеделе;

	Возврат РезультатРазбора.Минуты.Найти(Минута(МоментВремени)) <> Неопределено
		И РезультатРазбора.Часы.Найти(Час(МоментВремени)) <> Неопределено
		И РезультатРазбора.ДниМесяца.Найти(День(МоментВремени)) <> Неопределено
		И РезультатРазбора.Месяцы.Найти(Месяц(МоментВремени)) <> Неопределено
		И РезультатРазбора.ДниНедели.Найти(ДеньНеделиPOSIX) <> Неопределено;

КонецФункции

// Записывает предупреждение о некорректном выражении в журнал регистрации.
//
// Параметры:
//   Текст - Строка - текст предупреждения.
//
Процедура ЗаписатьПредупреждение(Знач Текст)

	ЗаписьЖурналаРегистрации(
		НСтр("ru='ar_Cron'; en='ar_Cron'"),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		Текст);

КонецПроцедуры

#КонецОбласти
