////////////////////////////////////////////////////////////////////////////////
// Общий модуль "ar_Токены".
//
// Эвристическая оценка количества токенов в тексте — для pre-check компакции
// контекста до вызова LLM. Авторитативный источник числа токенов — поле usage
// ответа провайдера (см. LLM-06). Эвристика нужна, чтобы решить «поместимся ли
// в MaxContext» ДО отправки запроса.
//
// Алгоритм: интерполяция средней плотности символов на токен по доле кириллицы
// в тексте. Латиница — ~3.5 симв/токен, кириллица — ~1.8 симв/токен.
// Погрешность ±25% приемлема для триггера компакции.
//
// См. Plan §3.13, спека .docs/specs/LLM-07.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Оценить количество токенов в тексте.
//
// Параметры:
//   Текст - Строка, Неопределено - оцениваемый текст. Не-строковые значения трактуются как пустая строка.
//   Модель - Строка - имя модели (зарезервировано для будущей модель-специфичной настройки;
//                    в текущей версии игнорируется).
//
// Возвращаемое значение:
//   Число - оценка числа токенов (0 для пустого текста, иначе >= 1).
//
Функция Оценить(Знач Текст, Знач Модель = "") Экспорт

	НормализованныйТекст = НормализоватьТекст(Текст);

	Если СтрДлина(НормализованныйТекст) = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Доля = ДоляКириллицы(НормализованныйТекст);
	Коэффициент = КоэффициентЛатиница() - (КоэффициентЛатиница() - КоэффициентКириллица()) * Доля;

	Оценка = Окр(СтрДлина(НормализованныйТекст) / Коэффициент, 0);

	Возврат Макс(Оценка, 1);

КонецФункции

// Оценить суммарное количество токенов для массива сообщений чат-формата.
//
// Параметры:
//   Сообщения - Массив - элементы Структура с ключами:
//                          * content - Строка - текст сообщения (необязательно)
//                          * tool_calls - Массив - вызовы инструментов (необязательно), элемент:
//                              ** function - Структура с ключом arguments (Строка)
//   Модель - Строка - имя модели (зарезервировано, игнорируется).
//
// Возвращаемое значение:
//   Число - суммарная оценка токенов с учётом оверхеда на структуру chat-сообщений.
//
Функция ОценитьМассив(Знач Сообщения, Знач Модель = "") Экспорт

	Если Сообщения = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;

	Если Сообщения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ВсегоТокенов = 0;

	Для Каждого Сообщение Из Сообщения Цикл
		// Оверхед на структуру сообщения (per tiktoken docs для chat API).
		ВсегоТокенов = ВсегоТокенов + ОверхедНаСообщение();

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Содержимое = "";
		Если Сообщение.Свойство("content", Содержимое) И Содержимое <> Неопределено Тогда
			ВсегоТокенов = ВсегоТокенов + Оценить(Содержимое, Модель);
		КонецЕсли;

		ToolCalls = Неопределено;
		Если Сообщение.Свойство("tool_calls", ToolCalls) И ToolCalls <> Неопределено
			И ТипЗнч(ToolCalls) = Тип("Массив") Тогда
			Для Каждого ToolCall Из ToolCalls Цикл
				ВсегоТокенов = ВсегоТокенов + ОверхедНаВызовИнструмента();
				Если ТипЗнч(ToolCall) <> Тип("Структура") Тогда
					Продолжить;
				КонецЕсли;
				ОписаниеФункции = Неопределено;
				Если ToolCall.Свойство("function", ОписаниеФункции) И ТипЗнч(ОписаниеФункции) = Тип("Структура") Тогда
					Аргументы = "";
					Если ОписаниеФункции.Свойство("arguments", Аргументы) И Аргументы <> Неопределено Тогда
						ВсегоТокенов = ВсегоТокенов + Оценить(Аргументы, Модель);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	// Прайминг ответа ассистента (per tiktoken docs).
	ВсегоТокенов = ВсегоТокенов + ОверхедНаПрайминг();

	Возврат ВсегоТокенов;

КонецФункции

// Вычислить долю кириллических символов в тексте.
//
// Считается среди буквенных символов (кириллица + латиница). Пробелы, цифры,
// пунктуация и прочие символы исключаются из знаменателя — это даёт более
// точную долю «русскости» текста для интерполяции коэффициента токенизации.
//
// Параметры:
//   Текст - Строка, Неопределено - анализируемый текст.
//
// Возвращаемое значение:
//   Число - доля кириллических символов среди буквенных, в диапазоне [0, 1].
//           Для пустого текста или текста без букв — 0.
//
Функция ДоляКириллицы(Знач Текст) Экспорт

	НормализованныйТекст = НормализоватьТекст(Текст);
	Длина = СтрДлина(НормализованныйТекст);

	Если Длина = 0 Тогда
		Возврат 0;
	КонецЕсли;

	МаскаКир = МаскаКириллицы();
	МаскаЛат = МаскаЛатиницы();

	// Оптимизация: для длинных текстов проверяем каждый 3-й символ.
	// Ошибка доли при этом ~5%, что в пределах общей погрешности ±25% эвристики.
	Шаг = ?(Длина > ПорогВыборочнойПроверки(), 3, 1);

	КириллическихСимволов = 0;
	БуквенныхСимволов = 0;
	Позиция = 1;

	Пока Позиция <= Длина Цикл
		Символ = Сред(НормализованныйТекст, Позиция, 1);
		Если СтрНайти(МаскаКир, Символ) > 0 Тогда
			КириллическихСимволов = КириллическихСимволов + 1;
			БуквенныхСимволов = БуквенныхСимволов + 1;
		ИначеЕсли СтрНайти(МаскаЛат, Символ) > 0 Тогда
			БуквенныхСимволов = БуквенныхСимволов + 1;
		КонецЕсли;
		Позиция = Позиция + Шаг;
	КонецЦикла;

	Если БуквенныхСимволов = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат КириллическихСимволов / БуквенныхСимволов;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает коэффициент символов на токен для чистой латиницы.
Функция КоэффициентЛатиница()
	Возврат 3.5;
КонецФункции

// Возвращает коэффициент символов на токен для чистой кириллицы.
Функция КоэффициентКириллица()
	Возврат 1.8;
КонецФункции

// Оверхед на одно сообщение chat-формата (per tiktoken docs).
Функция ОверхедНаСообщение()
	Возврат 4;
КонецФункции

// Оверхед на один tool-call (function name + структура).
Функция ОверхедНаВызовИнструмента()
	Возврат 8;
КонецФункции

// Прайминг ответа ассистента (per tiktoken docs для chat API).
Функция ОверхедНаПрайминг()
	Возврат 3;
КонецФункции

// Порог длины текста, после которого включается выборочная проверка (каждый 3-й символ).
Функция ПорогВыборочнойПроверки()
	Возврат 3000;
КонецФункции

// Маска кириллических символов: А-Я, а-я, Ё, ё.
Функция МаскаКириллицы()
	Возврат "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя";
КонецФункции

// Маска латинских символов: A-Z, a-z.
Функция МаскаЛатиницы()
	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
КонецФункции

// Привести значение к строке: Неопределено и не-строковые типы → "".
Функция НормализоватьТекст(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти
