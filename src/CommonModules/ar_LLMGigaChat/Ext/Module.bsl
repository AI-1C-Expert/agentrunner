// Общий модуль ar_LLMGigaChat (AOS LLM GigaChat).
//
// Провайдер GigaChat API (Sber). Реализует единственную экспортную функцию
// Чат(Сообщения, Параметры) — принимает сообщения во внутреннем универсальном
// формате AgentRunner (см. ar_LLMКонтракт), преобразует их в формат GigaChat REST
// API (/api/v1/chat/completions), выполняет HTTP POST через ar_HTTP.ВыполнитьPOST
// и возвращает результат в том же внутреннем формате.
//
// Ключевое отличие GigaChat — двухэтапная аутентификация через OAuth2
// client_credentials. Перед каждым чат-запросом модуль обеспечивает наличие
// действующего Bearer-токена: получает его из эндпоинта
// https://ngw.devices.sberbank.ru:9443/api/v2/oauth, кэширует в глобальной
// переменной модуля и обновляет, когда срок истёк (expires_at в UTC-мс).
//
// Свойства модуля: Сервер, без привилегированного режима. Привилегированный
// режим устанавливается внутри ar_Secrets.Прочитать при чтении credentials.
//
// Контракт: см. ar_LLMКонтракт (формат сообщений, ключи структуры результата).
// Локальный НовыйРезультат() сохранён по образцу ar_LLMКонтракт.НовыйОтвет().
//
// Особенности формата GigaChat:
//   * role "tool" → "function", поле "name" обязательно;
//   * tool_calls → одно поле "function_call" (один вызов за раз);
//   * functions (не "tools") для описания доступных функций;
//   * usage.prompt_tokens и usage.completion_tokens — числа (не строки).
//
// См. спеку: .docs/specs/LLM-05.md, Plan §3.14.
////////////////////////////////////////////////////////////////////////////////

// Кэш OAuth2-токена (глобальная переменная модуля).
// Живёт в пределах одного сеанса сервера / фонового задания.
// Структура: {AccessToken (Строка), ExpiresAt (Число, UTC ms), ProviderUUID (Строка)}.
Перем ОAuthКэш;

#Область ПрограммныйИнтерфейс

// Выполняет запрос к GigaChat API.
//
// Параметры:
//   Сообщения  - Массив   - список сообщений во внутреннем формате AgentRunner.
//                           Контракт — ar_LLMКонтракт.НовоеСообщение().
//   Параметры  - Структура - {
//                  Провайдер           - СправочникСсылка.ar_LLMПровайдеры
//                  Модель              - Строка (GigaChat, GigaChat-Pro, GigaChat-Max)
//                  Температура         - Число 0..2
//                  МаксТокенов         - Число (0 = не передавать)
//                  Tools               - Массив (манифесты, только при ПоддерживаетToolCalls)
//                  Таймаут             - Число секунд (0 = константа)
//               }
//
// Возвращаемое значение:
//   Структура - ar_LLMКонтракт.НовыйОтвет() —
//               {Успех, Сообщение, ТокеновВход, ТокеновВыход, Ошибка, КодСостояния}
//
Функция Чат(Сообщения, Параметры) Экспорт

	Результат = НовыйРезультат();

	// --- Валидация входа ---------------------------------------------------
	Если ТипЗнч(Сообщения) <> Тип("Массив") Или Сообщения.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Сообщения не заданы';
		                       |en = 'Messages are not set'");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Результат.Ошибка = НСтр("ru = 'Параметры не заданы';
		                       |en = 'Parameters are not set'");
		Возврат Результат;
	КонецЕсли;

	Провайдер = Неопределено;
	Параметры.Свойство("Провайдер", Провайдер);
	Если Провайдер = Неопределено Или НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Результат.Ошибка = НСтр("ru = 'Провайдер не задан';
		                       |en = 'Provider is not set'");
		Возврат Результат;
	КонецЕсли;

	// --- Чтение реквизитов провайдера --------------------------------------
	ДанныеПровайдера = ПрочитатьДанныеПровайдера(Провайдер);
	Если НЕ ДанныеПровайдера.Прочитано Тогда
		Результат.Ошибка = ДанныеПровайдера.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(ДанныеПровайдера.BaseURL) Тогда
		Результат.Ошибка = НСтр("ru = 'BaseURL не задан у провайдера';
		                       |en = 'Provider BaseURL is not set'");
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(ДанныеПровайдера.КлючИдентификатор) Тогда
		Результат.Ошибка = НСтр("ru = 'Идентификатор API-ключа не задан у провайдера';
		                       |en = 'Provider API-key identifier is not set'");
		Возврат Результат;
	КонецЕсли;

	// --- Чтение OAuth2 credentials из БезопасногоХранилища ----------------
	Credentials = Неопределено;
	Попытка
		Credentials = ar_Secrets.Прочитать(ar_Secrets.КлючПровайдера(ДанныеПровайдера.КлючИдентификатор));
	Исключение
		Результат.Ошибка = НСтр("ru = 'Не удалось прочитать client credentials';
		                       |en = 'Failed to read client credentials'");
		Возврат Результат;
	КонецПопытки;

	Если Credentials = Неопределено Или ТипЗнч(Credentials) <> Тип("Строка") Или ПустаяСтрока(Credentials) Тогда
		Результат.Ошибка = НСтр("ru = 'Client credentials не заданы для провайдера GigaChat';
		                       |en = 'Client credentials are not set for GigaChat provider'");
		Возврат Результат;
	КонецЕсли;

	// --- Модель ------------------------------------------------------------
	Модель = "";
	Параметры.Свойство("Модель", Модель);
	Если ТипЗнч(Модель) <> Тип("Строка") Или ПустаяСтрока(Модель) Тогда
		Модель = ДанныеПровайдера.DefaultModel;
	КонецЕсли;
	Если ПустаяСтрока(Модель) Тогда
		Модель = "GigaChat";
	КонецЕсли;

	// --- Tools / предупреждение при отключённом function calling ----------
	ToolsПараметр = Неопределено;
	Параметры.Свойство("Tools", ToolsПараметр);
	ЕстьToolsНаВход = (ТипЗнч(ToolsПараметр) = Тип("Массив") И ToolsПараметр.Количество() > 0);

	Если ЕстьToolsНаВход И НЕ ДанныеПровайдера.ПоддерживаетToolCalls Тогда
		ЛогироватьПредупреждение(Провайдер,
			НСтр("ru = 'Параметры.Tools непуст, но у провайдера выключен ПоддерживаетToolCalls — functions не передаются в запрос';
			    |en = 'Parameters.Tools is non-empty, but provider has ПоддерживаетToolCalls = False — functions are not passed'"));
	КонецЕсли;

	// --- Таймаут -----------------------------------------------------------
	Таймаут = 0;
	Параметры.Свойство("Таймаут", Таймаут);
	Если ТипЗнч(Таймаут) <> Тип("Число") Или Таймаут <= 0 Тогда
		Таймаут = ?(ДанныеПровайдера.Таймаут > 0, ДанныеПровайдера.Таймаут, ar_Константы.ТаймаутLLM());
	КонецЕсли;

	// --- Построение тела запроса -------------------------------------------
	ТелоJSON = "";
	Попытка
		ТелоJSON = ПостроитьТелоЗапроса(Модель, Сообщения, Параметры, ДанныеПровайдера.ПоддерживаетToolCalls);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Ошибка сериализации запроса';
		                       |en = 'Request serialization error'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	URL = ПостроитьURL(ДанныеПровайдера.BaseURL);
	Прокси = ПолучитьПрокси(Провайдер);

	// --- Получение токена + чат-запрос (с однократным force-refresh при 401) -
	ФорсОбновление = Ложь;
	Для ПопыткаАвторизации = 1 По 2 Цикл

		Токен = ПолучитьОAuthТокен(ДанныеПровайдера, Credentials, Таймаут, Провайдер, ФорсОбновление);
		Если НЕ Токен.Успех Тогда
			Результат.Ошибка = Токен.Ошибка;
			Результат.КодСостояния = Токен.КодСостояния;
			Возврат Результат;
		КонецЕсли;

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен.AccessToken);
		Заголовки.Вставить("Content-Type", "application/json");
		Заголовки.Вставить("Accept", "application/json");

		// Идемпотентный ключ — UUID на одну попытку чат-запроса.
		IdempotencyKey = Строка(Новый УникальныйИдентификатор());

		HTTPОтвет = ar_HTTP.ВыполнитьPOST(URL, Заголовки, ТелоJSON, Таймаут, IdempotencyKey, Прокси);
		Результат.КодСостояния = HTTPОтвет.КодСостояния;

		// 401 на первой попытке — инвалидируем кэш и повторяем с force-refresh.
		Если HTTPОтвет.КодСостояния = 401 И ПопыткаАвторизации = 1 Тогда
			ИнвалидироватьКэш();
			ФорсОбновление = Истина;
			Продолжить;
		КонецЕсли;

		// Сетевая ошибка.
		Если HTTPОтвет.КодСостояния = 0 Тогда
			ТекстОшибки = ?(ПустаяСтрока(HTTPОтвет.Ошибка),
				НСтр("ru = 'Сетевая ошибка'; en = 'Network error'"),
				HTTPОтвет.Ошибка);
			Результат.Ошибка = МаскироватьСекреты(ТекстОшибки, Credentials, Токен.AccessToken);
			Возврат Результат;
		КонецЕсли;

		// Прочие HTTP-ошибки (в т.ч. повторный 401 после force-refresh).
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Результат.Ошибка = МаскироватьСекреты(
				СообщениеОбОшибкеHTTP(HTTPОтвет.КодСостояния, HTTPОтвет.Тело),
				Credentials, Токен.AccessToken);
			Возврат Результат;
		КонецЕсли;

		// --- Парсинг успешного ответа -------------------------------------
		Возврат ПарситьОтвет(HTTPОтвет.Тело, ДанныеПровайдера.ПоддерживаетToolCalls, Результат);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает реквизиты провайдера одним запросом через БСП.
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры
//
// Возвращаемое значение:
//   Структура - {Прочитано, Ошибка, BaseURL, КлючИдентификатор, DefaultModel,
//                Таймаут, ПоддерживаетToolCalls}.
//
Функция ПрочитатьДанныеПровайдера(Провайдер)

	Результат = Новый Структура;
	Результат.Вставить("Прочитано", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("BaseURL", "");
	Результат.Вставить("КлючИдентификатор", "");
	Результат.Вставить("DefaultModel", "");
	Результат.Вставить("Таймаут", 0);
	Результат.Вставить("ПоддерживаетToolCalls", Ложь);

	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер,
			"ar_BaseURL, ar_APIKeyИдентификатор, ar_DefaultModel, ar_Таймаут, ar_ПоддерживаетToolCalls");
		Результат.BaseURL = СокрЛП(Строка(Реквизиты.ar_BaseURL));
		Результат.КлючИдентификатор = СокрЛП(Строка(Реквизиты.ar_APIKeyИдентификатор));
		Результат.DefaultModel = СокрЛП(Строка(Реквизиты.ar_DefaultModel));
		Если ТипЗнч(Реквизиты.ar_Таймаут) = Тип("Число") Тогда
			Результат.Таймаут = Реквизиты.ar_Таймаут;
		КонецЕсли;
		Если ТипЗнч(Реквизиты.ar_ПоддерживаетToolCalls) = Тип("Булево") Тогда
			Результат.ПоддерживаетToolCalls = Реквизиты.ar_ПоддерживаетToolCalls;
		КонецЕсли;
		Результат.Прочитано = Истина;
	Исключение
		Результат.Ошибка = НСтр("ru = 'Не удалось прочитать провайдера';
		                       |en = 'Failed to read provider'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Получает актуальный Bearer-токен GigaChat. Использует кэш в глобальной
// переменной модуля; при истечении срока (или ФорсОбновление = Истина) —
// запрашивает новый через OAuth2-эндпоинт.
//
// Параметры:
//   ДанныеПровайдера - Структура - реквизиты провайдера (см. ПрочитатьДанныеПровайдера).
//   Credentials      - Строка    - "<client_id>:<client_secret>" из БезопасногоХранилища.
//   Таймаут          - Число     - таймаут OAuth2-запроса, секунд.
//   Провайдер        - СправочникСсылка.ar_LLMПровайдеры - для привязки кэша и журнала.
//   ФорсОбновление   - Булево     - Истина = игнорировать кэш и запросить новый токен.
//
// Возвращаемое значение:
//   Структура - {Успех (Булево), AccessToken (Строка), Ошибка (Строка), КодСостояния (Число)}.
//
Функция ПолучитьОAuthТокен(ДанныеПровайдера, Credentials, Таймаут, Провайдер, ФорсОбновление = Ложь)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("AccessToken", "");
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);

	ProviderUUID = Строка(Провайдер.УникальныйИдентификатор());

	// --- Проверка кэша -----------------------------------------------------
	Если НЕ ФорсОбновление И ТипЗнч(ОAuthКэш) = Тип("Структура") Тогда
		Если ОAuthКэш.ProviderUUID = ProviderUUID
			И НЕ ПустаяСтрока(ОAuthКэш.AccessToken)
			И ОAuthКэш.ExpiresAt > (ТекущееВремяUTCМс() + 60000) Тогда
			Результат.Успех = Истина;
			Результат.AccessToken = ОAuthКэш.AccessToken;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// --- Запрос нового токена ---------------------------------------------
	Ответ = ЗапроситьОAuthТокен(Credentials, Таймаут, Провайдер);
	Результат.КодСостояния = Ответ.КодСостояния;

	Если НЕ Ответ.Успех Тогда
		Результат.Ошибка = Ответ.Ошибка;
		Возврат Результат;
	КонецЕсли;

	// --- Сохранение в кэш --------------------------------------------------
	НовыйКэш = Новый Структура;
	НовыйКэш.Вставить("AccessToken", Ответ.AccessToken);
	НовыйКэш.Вставить("ExpiresAt", Ответ.ExpiresAt);
	НовыйКэш.Вставить("ProviderUUID", ProviderUUID);
	ОAuthКэш = НовыйКэш;

	Результат.Успех = Истина;
	Результат.AccessToken = Ответ.AccessToken;
	Возврат Результат;

КонецФункции

// Выполняет HTTP POST к OAuth2-эндпоинту GigaChat и парсит ответ.
//
// Параметры:
//   Credentials - Строка - "<client_id>:<client_secret>".
//   Таймаут     - Число  - секунд.
//   Провайдер   - СправочникСсылка.ar_LLMПровайдеры - для прокси.
//
// Возвращаемое значение:
//   Структура - {Успех, AccessToken, ExpiresAt (UTC ms), Ошибка, КодСостояния}.
//
Функция ЗапроситьОAuthТокен(Credentials, Таймаут, Провайдер)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("AccessToken", "");
	Результат.Вставить("ExpiresAt", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);

	// Basic-авторизация: base64(credentials) без переносов строк (HTTP требует чистую строку).
	BasicToken = База64БезПереносов(Credentials);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Basic " + BasicToken);
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор()));

	// scope: для MVP — персональный доступ (GIGACHAT_API_PERS). Корпоративным
	// пользователям нужно изменить на GIGACHAT_API_CORP (технический долг —
	// реквизит ar_OAuthScope, см. спеку LLM-05, раздел «Риски»).
	ТелоФормы = "scope=GIGACHAT_API_PERS";

	Прокси = ПолучитьПрокси(Провайдер);

	HTTPОтвет = ar_HTTP.ВыполнитьPOST(OAuthURL(), Заголовки, ТелоФормы, Таймаут,
		Строка(Новый УникальныйИдентификатор()), Прокси);

	Результат.КодСостояния = HTTPОтвет.КодСостояния;

	Если HTTPОтвет.КодСостояния = 0 Тогда
		ТекстОшибки = ?(ПустаяСтрока(HTTPОтвет.Ошибка),
			НСтр("ru = 'Сетевая ошибка'; en = 'Network error'"),
			HTTPОтвет.Ошибка);
		Результат.Ошибка = НСтр("ru = 'Ошибка получения OAuth2-токена GigaChat';
		                       |en = 'Failed to obtain GigaChat OAuth2 token'")
			+ ": " + МаскироватьСекреты(ТекстОшибки, Credentials, BasicToken);
		Возврат Результат;
	КонецЕсли;

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		Результат.Ошибка = НСтр("ru = 'Ошибка получения OAuth2-токена GigaChat';
		                       |en = 'Failed to obtain GigaChat OAuth2 token'")
			+ ": " + МаскироватьСекреты(
				СообщениеОбОшибкеHTTP(HTTPОтвет.КодСостояния, HTTPОтвет.Тело),
				Credentials, BasicToken);
		Возврат Результат;
	КонецЕсли;

	// --- Парсинг ответа OAuth2 --------------------------------------------
	Попытка
		Ответ = ПрочитатьJSONСтроку(HTTPОтвет.Тело);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Ошибка парсинга ответа OAuth2 GigaChat';
		                       |en = 'GigaChat OAuth2 response parsing error'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'OAuth2 GigaChat: ответ не является объектом';
		                       |en = 'GigaChat OAuth2: response is not an object'");
		Возврат Результат;
	КонецЕсли;

	AccessToken = Ответ.Получить("access_token");
	Если ТипЗнч(AccessToken) <> Тип("Строка") Или ПустаяСтрока(AccessToken) Тогда
		Результат.Ошибка = НСтр("ru = 'OAuth2 GigaChat: access_token отсутствует в ответе';
		                       |en = 'GigaChat OAuth2: access_token is missing in response'");
		Возврат Результат;
	КонецЕсли;

	// expires_at — UTC-миллисекунды (НЕ секунды), используется как есть.
	ExpiresAtRaw = Ответ.Получить("expires_at");
	Если ТипЗнч(ExpiresAtRaw) = Тип("Число") И ExpiresAtRaw > 0 Тогда
		ExpiresAt = ExpiresAtRaw;
	Иначе
		// Консервативный дефолт — 25 минут от текущего момента.
		ExpiresAt = ТекущееВремяUTCМс() + 1500000;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.AccessToken = AccessToken;
	Результат.ExpiresAt = ExpiresAt;
	Возврат Результат;

КонецФункции

// Инвалидирует кэш OAuth2-токена (для force-refresh при 401).
Процедура ИнвалидироватьКэш()
	ОAuthКэш = Неопределено;
КонецПроцедуры

// Возвращает OAuth2-эндпоинт GigaChat (жёстко закодирован).
Функция OAuthURL()
	Возврат "https://ngw.devices.sberbank.ru:9443/api/v2/oauth";
КонецФункции

// Строит JSON-тело запроса к /chat/completions.
//
// Параметры:
//   Модель                - Строка
//   Сообщения             - Массив   - внутренний формат AgentRunner.
//   Параметры             - Структура
//   ПоддерживаетToolCalls - Булево
//
// Возвращаемое значение:
//   Строка - JSON-тело запроса.
//
Функция ПостроитьТелоЗапроса(Модель, Сообщения, Параметры, ПоддерживаетToolCalls)

	Тело = Новый Соответствие;
	Тело.Вставить("model", Строка(Модель));
	Тело.Вставить("messages", КонвертироватьСообщения(Сообщения, ПоддерживаетToolCalls));

	Температура = Неопределено;
	Если Параметры.Свойство("Температура", Температура)
		И Температура <> Неопределено
		И ТипЗнч(Температура) = Тип("Число")
		И Температура >= 0 Тогда
		Тело.Вставить("temperature", Температура);
	КонецЕсли;

	МаксТокенов = 0;
	Если Параметры.Свойство("МаксТокенов", МаксТокенов)
		И ТипЗнч(МаксТокенов) = Тип("Число") И МаксТокенов > 0 Тогда
		Тело.Вставить("max_tokens", МаксТокенов);
	КонецЕсли;

	// functions (не tools!) — только при включённом function calling и непустых Tools.
	Tools = Неопределено;
	Если ПоддерживаетToolCalls
		И Параметры.Свойство("Tools", Tools)
		И ТипЗнч(Tools) = Тип("Массив")
		И Tools.Количество() > 0 Тогда
		Functions = КонвертироватьToolsВFunctions(Tools);
		Если Functions.Количество() > 0 Тогда
			Тело.Вставить("functions", Functions);
		КонецЕсли;
	КонецЕсли;

	// stream жёстко false — streaming не используется (Plan §3.8).
	Тело.Вставить("stream", Ложь);

	Возврат ЗаписатьJSONСтроку(Тело);

КонецФункции

// Конвертирует массив внутренних сообщений в массив Соответствий формата GigaChat.
//
// Параметры:
//   Сообщения             - Массив - внутренний формат AgentRunner.
//   ПоддерживаетToolCalls - Булево.
//
// Возвращаемое значение:
//   Массив - сообщения в формате GigaChat.
//
Функция КонвертироватьСообщения(Сообщения, ПоддерживаетToolCalls)

	Результат = Новый Массив;

	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(КонвертироватьОдноСообщение(Сообщение, ПоддерживаетToolCalls));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конвертирует одно внутреннее сообщение в формат GigaChat.
//
// Правила:
//   role "tool"      → role "function", + поле name;
//   role "assistant" с tool_calls → content=null, + function_call (первый вызов);
//   прочие           → один-в-один (role, content).
//
Функция КонвертироватьОдноСообщение(Сообщение, ПоддерживаетToolCalls)

	Элемент = Новый Соответствие;

	Role = "";
	Сообщение.Свойство("role", Role);
	РольСтр = Строка(Role);

	Content = "";
	Сообщение.Свойство("content", Content);

	ToolCalls = Неопределено;
	Сообщение.Свойство("tool_calls", ToolCalls);
	ЕстьToolCalls = (ТипЗнч(ToolCalls) = Тип("Массив") И ToolCalls.Количество() > 0);

	ИмяTool = "";
	Сообщение.Свойство("name", ИмяTool);
	ИмяToolСтр = Строка(ИмяTool);

	Если РольСтр = "tool" Тогда
		// GigaChat: роль function + обязательное имя функции.
		Элемент.Вставить("role", "function");
		Элемент.Вставить("content", Строка(Content));
		Если НЕ ПустаяСтрока(ИмяToolСтр) Тогда
			Элемент.Вставить("name", ИмяToolСтр);
		КонецЕсли;

	ИначеЕсли РольСтр = "assistant" И ЕстьToolCalls Тогда
		Элемент.Вставить("role", "assistant");
		// content = null при наличии function_call.
		Элемент.Вставить("content", Неопределено);

		// GigaChat поддерживает один function_call — берём первый вызов.
		Если ToolCalls.Количество() > 1 Тогда
			ЛогироватьПредупреждение(Неопределено,
				НСтр("ru = 'В сообщении assistant несколько tool_calls — GigaChat принимает один function_call, остальные игнорируются';
				    |en = 'Assistant message has multiple tool_calls — GigaChat accepts a single function_call, the rest are ignored'"));
		КонецЕсли;

		FunctionCall = ИзвлечьFunctionCall(ToolCalls[0]);
		Если FunctionCall <> Неопределено Тогда
			Элемент.Вставить("function_call", FunctionCall);
		Иначе
			// Некорректный tool_call — деградируем до текстового content.
			Элемент.Вставить("content", Строка(Content));
		КонецЕсли;

	Иначе
		Элемент.Вставить("role", РольСтр);
		Элемент.Вставить("content", Строка(Content));
	КонецЕсли;

	Возврат Элемент;

КонецФункции

// Извлекает Соответствие function_call {name, arguments} из внутренней структуры tool_call.
// Возвращает Неопределено, если структура некорректна.
Функция ИзвлечьFunctionCall(Вызов)

	Если ТипЗнч(Вызов) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФункцияВызова = Неопределено;
	Вызов.Свойство("function", ФункцияВызова);
	Если ТипЗнч(ФункцияВызова) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = "";
	ФункцияВызова.Свойство("name", Имя);
	Аргументы = "";
	ФункцияВызова.Свойство("arguments", Аргументы);

	Результат = Новый Соответствие;
	Результат.Вставить("name", Строка(Имя));
	Результат.Вставить("arguments", Строка(Аргументы));
	Возврат Результат;

КонецФункции

// Конвертирует массив tool-манифестов из формата AgentRunner/OpenAI
// ({type, function:{name, description, parameters}}) в формат GigaChat functions
// ({name, description, parameters}).
//
// Параметры:
//   Tools - Массив - манифесты в формате AgentRunner/OpenAI.
//
// Возвращаемое значение:
//   Массив - элементы в формате GigaChat functions.
//
Функция КонвертироватьToolsВFunctions(Tools)

	Результат = Новый Массив;

	Для Каждого Манифест Из Tools Цикл

		Если ТипЗнч(Манифест) <> Тип("Соответствие") И ТипЗнч(Манифест) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		// Источник полей: вложенный function (OpenAI-формат) или сам манифест (плоский).
		Источник = ЗначениеКлюча(Манифест, "function");
		Если ТипЗнч(Источник) <> Тип("Соответствие") И ТипЗнч(Источник) <> Тип("Структура") Тогда
			Источник = Манифест;
		КонецЕсли;

		Имя = ЗначениеКлюча(Источник, "name");
		Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;

		ФункцияОписание = Новый Соответствие;
		ФункцияОписание.Вставить("name", Имя);

		Описание = ЗначениеКлюча(Источник, "description");
		Если ТипЗнч(Описание) = Тип("Строка") И НЕ ПустаяСтрока(Описание) Тогда
			ФункцияОписание.Вставить("description", Описание);
		КонецЕсли;

		Параметры = ЗначениеКлюча(Источник, "parameters");
		Если Параметры <> Неопределено Тогда
			ФункцияОписание.Вставить("parameters", Параметры);
		КонецЕсли;

		Результат.Добавить(Функция);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Унифицированный доступ к значению по ключу для Структуры или Соответствия.
Функция ЗначениеКлюча(Контейнер, Ключ)
	Если ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		Возврат Контейнер.Получить(Ключ);
	ИначеЕсли ТипЗнч(Контейнер) = Тип("Структура") Тогда
		Значение = Неопределено;
		Контейнер.Свойство(Ключ, Значение);
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Парсит тело успешного ответа GigaChat во внутренний формат AgentRunner.
//
// Параметры:
//   ТелоОтвета            - Строка    - JSON-тело ответа GigaChat.
//   ПоддерживаетToolCalls - Булево.
//   Результат             - Структура - заготовка результата (для возврата с КодСостояния).
//
// Возвращаемое значение:
//   Структура - заполненный результат контракта.
//
Функция ПарситьОтвет(ТелоОтвета, ПоддерживаетToolCalls, Результат)

	Попытка
		Ответ = ПрочитатьJSONСтроку(ТелоОтвета);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Ошибка парсинга ответа GigaChat';
		                       |en = 'GigaChat response parsing error'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ GigaChat не является объектом';
		                       |en = 'GigaChat response is not an object'");
		Возврат Результат;
	КонецЕсли;

	Choices = Ответ.Получить("choices");
	Если ТипЗнч(Choices) <> Тип("Массив") Или Choices.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ GigaChat не содержит вариантов';
		                       |en = 'GigaChat response has no alternatives'");
		Возврат Результат;
	КонецЕсли;

	ПервыйChoice = Choices[0];
	Если ТипЗнч(ПервыйChoice) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ GigaChat имеет некорректную структуру choices';
		                       |en = 'GigaChat response has invalid choices structure'");
		Возврат Результат;
	КонецЕсли;

	СообщениеGC = ПервыйChoice.Получить("message");
	Если ТипЗнч(СообщениеGC) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ GigaChat не содержит message';
		                       |en = 'GigaChat response has no message'");
		Возврат Результат;
	КонецЕсли;

	Результат.Сообщение = СообщениеИзФорматаGigaChat(СообщениеGC, ПоддерживаетToolCalls);

	// --- Usage (числа, не строки) -----------------------------------------
	// LLM-06: единый парсер usage через ar_LLMКонтракт.
	ПарситьUsage(Ответ, Результат);

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Конвертирует message (Соответствие из ответа GigaChat) во внутреннюю Структуру.
// Если есть function_call — формирует tool_calls из одного элемента.
Функция СообщениеИзФорматаGigaChat(СообщениеGC, ПоддерживаетToolCalls)

	Результат = Новый Структура;

	Role = СообщениеGC.Получить("role");
	Результат.Вставить("role", ?(ТипЗнч(Role) = Тип("Строка"), Role, "assistant"));

	Content = СообщениеGC.Получить("content");
	Если ТипЗнч(Content) = Тип("Строка") Тогда
		Результат.Вставить("content", Content);
	Иначе
		// content = null при function_call — нормально для GigaChat.
		Результат.Вставить("content", "");
	КонецЕсли;

	FunctionCall = СообщениеGC.Получить("function_call");
	Если ТипЗнч(FunctionCall) = Тип("Соответствие") Тогда
		Попытка
			ToolCall = ToolCallИзFunctionCall(FunctionCall);
			Если ToolCall <> Неопределено Тогда
				Массив = Новый Массив;
				Массив.Добавить(ToolCall);
				Результат.Вставить("tool_calls", Массив);
			КонецЕсли;
		Исключение
			ЛогироватьПредупреждение(Неопределено,
				НСтр("ru = 'Не удалось распарсить function_call в ответе GigaChat';
				    |en = 'Failed to parse function_call in GigaChat response'")
				+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Преобразует function_call GigaChat в один внутренний tool_call.
// id генерируется как "gigachat_" + UUID (нативного id GigaChat не возвращает).
Функция ToolCallИзFunctionCall(FunctionCall)

	ИмяФ = FunctionCall.Получить("name");
	Если ТипЗнч(ИмяФ) <> Тип("Строка") Тогда
		ИмяФ = "";
	КонецЕсли;

	АргументыRaw = FunctionCall.Получить("arguments");
	АргументыJSON = "";
	Если ТипЗнч(АргументыRaw) = Тип("Строка") Тогда
		АргументыJSON = АргументыRaw;
	ИначеЕсли АргументыRaw = Неопределено Тогда
		АргументыJSON = "{}";
	Иначе
		// GigaChat может вернуть arguments объектом — сериализуем в JSON-строку
		// для единообразия с внутренним форматом (arguments всегда строка).
		Попытка
			АргументыJSON = ЗаписатьJSONСтроку(АргументыRaw);
		Исключение
			АргументыJSON = "{}";
		КонецПопытки;
	КонецЕсли;

	Возврат ar_LLMКонтракт.НовыйToolCall(
		"gigachat_" + Строка(Новый УникальныйИдентификатор()),
		ИмяФ,
		АргументыJSON);

КонецФункции

// Строит URL чата: СокрП(BaseURL) + "/chat/completions" (без модификации /v1).
Функция ПостроитьURL(BaseURL)

	База = СокрЛП(Строка(BaseURL));
	Пока СтрДлина(База) > 0 И Прав(База, 1) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;

	Возврат База + "/chat/completions";

КонецФункции

// Текущее время UTC в миллисекундах (для сравнения с expires_at GigaChat).
Функция ТекущееВремяUTCМс()
	// ТекущаяУниверсальнаяДатаВМиллисекундах() появилась позже; для совместимости
	// с базовой платформой используем разницу от эпохи Unix в секундах * 1000.
	Возврат (ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1, 0, 0, 0)) * 1000;
КонецФункции

// HTTP-05: возвращает объект ИнтернетПрокси для провайдера, либо Неопределено.
//
// Если у провайдера установлен флаг ar_ИспользоватьПрокси — вызывается
// БСП-метод ПолучениеФайловИзИнтернета.ПолучитьПрокси("https").
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры.
//
// Возвращаемое значение:
//   ИнтернетПрокси, Неопределено.
//
Функция ПолучитьПрокси(Провайдер)

	ИспользоватьПрокси = Ложь;
	Попытка
		РеквизитыПрокси = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер, "ar_ИспользоватьПрокси");
		Если ТипЗнч(РеквизитыПрокси.ar_ИспользоватьПрокси) = Тип("Булево") Тогда
			ИспользоватьПрокси = РеквизитыПрокси.ar_ИспользоватьПрокси;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ИспользоватьПрокси Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("ПолучениеФайловИзИнтернета") = Неопределено Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Подсистема РаботаСФайлами недоступна — прокси не используется';
			    |en = 'Subsystem FilesOperations is unavailable — proxy is not used'"));
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
	Исключение
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Не удалось получить ИнтернетПрокси';
			    |en = 'Failed to obtain InternetProxy'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Формирует структуру результата по умолчанию (Успех = Ложь).
// Состав ключей — см. ar_LLMКонтракт.НовыйОтвет().
Функция НовыйРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);
	Возврат Результат;
КонецФункции

// Base64-кодирование с удалением переносов строк (Base64Строка добавляет их
// каждые 76 символов; HTTP Basic Auth требует чистую строку).
Функция База64БезПереносов(Значение)
	Кодированное = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Строка(Значение), "UTF-8"));
	Кодированное = СтрЗаменить(Кодированное, Символы.ПС, "");
	Кодированное = СтрЗаменить(Кодированное, Символы.ВК, "");
	Возврат Кодированное;
КонецФункции

// Возвращает строку JSON-сериализации значения с настройками AgentRunner:
//   * двойные кавычки; сохранение null; даты в ISO 8601.
// При исключении в ЗаписатьJSON гарантирует закрытие потока ЗаписьJSON.
Функция ЗаписатьJSONСтроку(Значение)

	НастройкиЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "", Истина);

	// Свойства СохранятьNull у НастройкиСериализацииJSON не существует (платформа
	// и так сериализует Неопределено как JSON null по умолчанию). Правильное имя
	// свойства формата дат - ФорматСериализацииДаты (проверено по реальному
	// использованию в БП: DataProcessors/МенеджерКонвертацииУправлениеПерсоналом).
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(НастройкиЗаписи);
	Попытка
		ЗаписатьJSON(Запись, Значение, НастройкиСериализации);
	Исключение
		Попытка
			Запись.Закрыть();
		Исключение
			// Поток уже закрыт или повреждён — игнорируем вторичную ошибку.
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Запись.Закрыть();

КонецФункции

// Десериализует JSON-строку в Соответствие/Массив (ЧитатьВСоответствие = Истина).
// При исключении в ПрочитатьJSON гарантирует закрытие потока ЧтениеJSON.
Функция ПрочитатьJSONСтроку(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
			// Поток уже закрыт — игнорируем.
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Извлекает usage из JSON-ответа GigaChat и кладёт в Результат.
// Приведение к числу делегируется ar_LLMКонтракт.ИзвлечьЧисло (LLM-06).
// При отсутствии блока usage — нули и запись в журнал уровня Информация.
//
// Параметры:
//   Ответ     - Соответствие - распарсенный JSON ответа GigaChat.
//   Результат - Структура    - модифицируется: ТокеновВход / ТокеновВыход.
//
Процедура ПарситьUsage(Ответ, Результат)

	Usage = Ответ.Получить("usage");

	Если ТипЗнч(Usage) <> Тип("Соответствие") Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.LLM.Usage",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.ОбщиеМодули.ar_LLMGigaChat,
			,
			НСтр("ru = 'Блок usage отсутствует в ответе GigaChat; токены не учтены';
			    |en = 'Usage block is missing in GigaChat response; tokens not counted'"));
		Возврат;
	КонецЕсли;

	Результат.ТокеновВход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("prompt_tokens"));
	Результат.ТокеновВыход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("completion_tokens"));

КонецПроцедуры

// Формирует текст ошибки для HTTP-кода != 200, извлекая error.message / message если есть.
Функция СообщениеОбОшибкеHTTP(КодСостояния, Тело)

	КраткоеТело = ИзвлечьСообщениеОшибкиИзТела(Тело);

	Префикс = "";
	Если КодСостояния = 401 Тогда
		Префикс = НСтр("ru = 'Ошибка авторизации GigaChat: 401';
		              |en = 'GigaChat authorization error: 401'");
	ИначеЕсли КодСостояния = 429 Тогда
		Префикс = НСтр("ru = 'Rate limit GigaChat: 429';
		              |en = 'GigaChat rate limit: 429'");
	ИначеЕсли КодСостояния >= 500 Тогда
		Префикс = НСтр("ru = 'Ошибка сервера GigaChat'; en = 'GigaChat server error'")
			+ ": " + Формат(КодСостояния, "ЧГ=");
	Иначе
		Префикс = НСтр("ru = 'Ошибка GigaChat'; en = 'GigaChat error'")
			+ ": " + Формат(КодСостояния, "ЧГ=");
	КонецЕсли;

	Если ПустаяСтрока(КраткоеТело) Тогда
		Возврат Префикс;
	КонецЕсли;

	Возврат Префикс + ": " + КраткоеТело;

КонецФункции

// Извлекает текст ошибки из JSON-тела (поддерживает error.message и message верхнего уровня).
Функция ИзвлечьСообщениеОшибкиИзТела(Тело)

	Если ТипЗнч(Тело) <> Тип("Строка") Или ПустаяСтрока(Тело) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Распарсенное = ПрочитатьJSONСтроку(Тело);
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Распарсенное) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	ErrorНоды = Распарсенное.Получить("error");
	Если ТипЗнч(ErrorНоды) = Тип("Соответствие") Тогда
		Сообщ = ErrorНоды.Получить("message");
		Если ТипЗнч(Сообщ) = Тип("Строка") Тогда
			Возврат Сообщ;
		КонецЕсли;
	КонецЕсли;

	// GigaChat нередко отдаёт {"message": "...", "status": <код>}.
	Сообщ = Распарсенное.Получить("message");
	Если ТипЗнч(Сообщ) = Тип("Строка") Тогда
		Возврат Сообщ;
	КонецЕсли;

	Возврат "";

КонецФункции

// Маскирует чувствительные значения (credentials, токен) в тексте ошибки/лога.
Функция МаскироватьСекреты(Текст, Credentials, Токен)
	Результат = Строка(Текст);
	Если ТипЗнч(Credentials) = Тип("Строка") И СтрДлина(Credentials) >= 8 Тогда
		Результат = СтрЗаменить(Результат, Credentials, "***");
	КонецЕсли;
	Если ТипЗнч(Токен) = Тип("Строка") И СтрДлина(Токен) >= 8 Тогда
		Результат = СтрЗаменить(Результат, Токен, "***");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Пишет предупреждение в журнал регистрации (без чувствительных данных).
Процедура ЛогироватьПредупреждение(Данные, Текст)
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ar_LLMGigaChat.Чат'; en = 'ar_LLMGigaChat.Chat'"),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		Данные,
		Текст);
КонецПроцедуры

#КонецОбласти
