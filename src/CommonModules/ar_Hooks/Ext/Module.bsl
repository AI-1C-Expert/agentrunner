//////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Hooks (Hooks).
//
// Единственная точка вызова hook-обработчиков жизненного цикла agent-runtime
// (этап 2, подсистема Hooks). Процедура Вызвать(Событие, КонтекстСобытия)
// вызывается из ar_RuntimeЦикл / ar_LLMДиспетчер / ar_Approval (HOOK-03) в
// 10 фиксированных точках - по одной на каждое значение перечисления
// ar_СобытиеHook (META-21).
//
// Архитектурный контракт (Plan §3.4):
//   1. Читает из ar_Hooks (META-20) все включенные обработчики для данного
//      события, отсортированные по ar_Приоритет (возрастание), вторично по
//      Ссылка (детерминированный порядок при равных приоритетах).
//   2. Вызывает каждый обработчик через ar_HookDispatcher.Вызвать.
//      Обработчик - либо процедура общего модуля, либо код 1С из
//      ar_КодОбработчика (ar_ТипОбработчика = "Код", исполняется диспетчером
//      в безопасном режиме).
//   3. Оборачивает каждый вызов в Попытка/Исключение: ошибка одного hook
//      не прерывает остальные и не валит run - фиксируется как audit-событие
//      HookFailed (META-10, payload {hook_name, error_text}).
//   4. Поддерживает сигнал Прервать от обработчика: если ar_HookDispatcher
//      вернул Результат.Прервать = Истина, цикл прекращается, поле
//      КонтекстСобытия.Прервать устанавливается в Истина.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Hook-обработчики выполняются в правах пользователя сессии (Plan §2.8).
// AUD-06: платформа запрещает Privileged=true в общих модулях расширений
// ("Cannot use privileged common modules in extensions"), поэтому
// ar_AuditСобытия тоже Privileged=false. Запись audit-события HookFailed
// идёт не напрямую, а через фасад ar_AuditЗащищённыйРежим.
// ЗаписатьСобытиеПривилегированно, который сам поднимает и сбрасывает
// УстановитьПривилегированныйРежим точечно - этому модулю самому поднимать
// привилегии не требуется.
//
// См. спеку: .docs/specs/HOOK-01.md, Plan §2.8, §3.4.
//////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Вызвать hook-обработчики для указанного события жизненного цикла.
//
// Параметры:
//  Событие - ПеречислениеСсылка.ar_СобытиеHook - событие для вызова обработчиков.
//  КонтекстСобытия - Структура - контекст события, передаётся по ссылке.
//
Процедура Вызвать(Знач Событие, КонтекстСобытия) Экспорт

	// 1. Defensive programming: валидация события.
	Если Событие = Неопределено
		Или ТипЗнч(Событие) <> Тип("ПеречислениеСсылка.ar_СобытиеHook") Тогда

		ЗаписатьПредупреждение(
			НСтр("ru = 'ar_Hooks.Вызвать: параметр Событие не задан или имеет некорректный тип';
				|en = 'ar_Hooks.Invoke: parameter Event is not set or has invalid type'"));
		Возврат;
	КонецЕсли;

	// 2. Нормализация контекста события.
	// НормализоватьКонтекст возвращает Структура или Неопределено при ошибке.
	КонтекстСобытия = НормализоватьКонтекст(КонтекстСобытия);
	Если КонтекстСобытия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// 3. Убедиться, что поле «Событие» присутствует в контексте (удобно для
	// обработчиков - не нужно передавать отдельно).
	Если Не КонтекстСобытия.Свойство("Событие") Тогда
		КонтекстСобытия.Вставить("Событие", Событие);
	КонецЕсли;

	// 4. Выборка включённых обработчиков для события (сортировка по приоритету).
	Обработчики = ПолучитьОбработчикиСобытия(Событие);
	Если Обработчики = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// 5. Цикл по обработчикам (в порядке приоритета).
	Для Каждого Обработчик Из Обработчики Цикл

		РезультатHook = Неопределено;
		Попытка
			РезультатHook = ar_HookDispatcher.Вызвать(Обработчик.Ссылка, КонтекстСобытия);

			// Defensive: если диспетчер вернул не Структура - пропускаем.
			Если ТипЗнч(РезультатHook) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;

			// Обработка сигнала «Прервать» от обработчика.
			// Примечание: «Прервать» - одновременно имя поля структуры и оператор
			// языка (выход из цикла). Оператор Прервать ниже прерывает цикл
			// ForEach, а не обращается к одноимённому полю.
			ЗначениеПрервать = Неопределено;
			РезультатHook.Свойство("Прервать", ЗначениеПрервать);
			// Защита типа: обработчик может положить в "Прервать" не-Булево
			// значение - без проверки Если бросает "Cannot convert value to
			// Boolean" (см. также аналогичные фиксы в ar_RuntimeЦикл, ar_Approval,
			// ar_ToolDispatcher - единая точка входа здесь устраняет причину для всех).
			ПрерватьЦепочку = (ТипЗнч(ЗначениеПрервать) = Тип("Булево") И ЗначениеПрервать = Истина);

			Если ПрерватьЦепочку Тогда
				КонтекстСобытия.Вставить("Прервать", Истина);
				Прервать; // Оператор языка - выход из цикла обработки обработчиков.
			КонецЕсли;

		Исключение
			// Ошибка hook не прерывает run - фиксируем в audit и продолжаем.
			ОбработатьОшибкуОбработчика(КонтекстСобытия, Обработчик);
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нормализовать контекст события: вернуть пустую структуру при Неопределено,
// проверить тип или вернуть Неопределено при некорректном типе.
//
// ВНИМАНИЕ: Неопределено в 1С передаётся по значению, а не по ссылке.
// Присваивание параметру (даже без Знач) создаёт новую локальную переменную,
// не влияя на внешнюю. Поэтому функция возвращает нормализованную структуру
// через возвращаемое значение, а не через мутацию параметра.
//
// Параметры:
//  КонтекстСобытия - Структура, Неопределено - контекст события для нормализации.
//
// Возвращаемое значение:
//  Структура - нормализованный контекст (исходный переданный или пустой, если
//              был передан Неопределено).
//  Неопределено - если передан некорректный тип (не Структура и не Неопределено).
//
Функция НормализоватьКонтекст(Знач КонтекстСобытия)

	Если КонтекстСобытия = Неопределено Тогда
		ЗаписатьПредупреждение(
			НСтр("ru = 'ar_Hooks.Вызвать: КонтекстСобытия = Неопределено, создана пустая структура';
				|en = 'ar_Hooks.Invoke: EventContext is Undefined, empty structure created'"));
		Возврат Новый Структура;
	ИначеЕсли ТипЗнч(КонтекстСобытия) <> Тип("Структура") Тогда
		ЗаписатьПредупреждение(
			НСтр("ru = 'ar_Hooks.Вызвать: КонтекстСобытия имеет некорректный тип (ожидается Структура)';
				|en = 'ar_Hooks.Invoke: EventContext has invalid type (expected Structure)'"));
		Возврат Неопределено;
	Иначе
		Возврат КонтекстСобытия;
	КонецЕсли;

КонецФункции

// Получить список включённых обработчиков для события.
//
// Параметры:
//  Событие - ПеречислениеСсылка.ar_СобытиеHook - событие для выборки.
//
// Возвращаемое значение:
//  Массив - массив структур {Ссылка, ТипОбработчика, ОбщийМодуль, ИмяПроцедуры},
//  или Неопределено, если обработчиков нет.
//
Функция ПолучитьОбработчикиСобытия(Знач Событие)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Hooks.Ссылка КАК Ссылка,
		|	Hooks.ar_ТипОбработчика КАК ТипОбработчика,
		|	Hooks.ar_ОбщийМодуль КАК ОбщийМодуль,
		|	Hooks.ar_ИмяПроцедуры КАК ИмяПроцедуры
		|ИЗ
		|	Справочник.ar_Hooks КАК Hooks
		|ГДЕ
		|	Hooks.ar_Событие = &Событие
		|	И Hooks.ar_Включён = ИСТИНА
		|	И НЕ Hooks.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Hooks.ar_Приоритет,
		|	Hooks.Ссылка";
	Запрос.УстановитьПараметр("Событие", Событие);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Обработчики = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Обработчик = Новый Структура;
		Обработчик.Вставить("Ссылка", Выборка.Ссылка);
		Обработчик.Вставить("ТипОбработчика", СокрЛП(Выборка.ТипОбработчика));
		Обработчик.Вставить("ОбщийМодуль", СокрЛП(Выборка.ОбщийМодуль));
		Обработчик.Вставить("ИмяПроцедуры", СокрЛП(Выборка.ИмяПроцедуры));
		Обработчики.Добавить(Обработчик);
	КонецЦикла;

	Если Обработчики.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Обработчики;

КонецФункции

// Обработать ошибку hook-обработчика: записать audit-событие HookFailed.
//
// Параметры:
//  КонтекстСобытия - Структура - контекст события с RunId для audit.
//  Обработчик - Структура - данные обработчика {Ссылка, ОбщийМодуль, ИмяПроцедуры}.
//
Процедура ОбработатьОшибкуОбработчика(Знач КонтекстСобытия, Знач Обработчик)

	// Извлечь RunId из контекста (если отсутствует - ar_AuditСобытия подставит sentinel).
	RunId = "";
	КонтекстСобытия.Свойство("RunId", RunId);

	// Сформировать имя hook для payload: "<Модуль>.<Процедура>" для процедурных
	// обработчиков, "code:<Наименование>" для обработчиков кодом 1С.
	Если Обработчик.ТипОбработчика = "Код" Тогда
		ИмяHook = "code:" + Строка(Обработчик.Ссылка);
	Иначе
		ИмяHook = Обработчик.ОбщийМодуль + "." + Обработчик.ИмяПроцедуры;
	КонецЕсли;

	// Очистить текст ошибки через утилиту (маскировка секретов, удаление стеков).
	ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	// Записать audit-событие HookFailed.
	Payload = Новый Структура;
	Payload.Вставить("hook_name", ИмяHook);
	Payload.Вставить("error_text", ТекстОшибки);

	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "HookFailed", Payload);

КонецПроцедуры

// Записать предупреждение в журнал регистрации.
//
// Параметры:
//  Текст - Строка - текст предупреждения для журнала регистрации.
//
Процедура ЗаписатьПредупреждение(Знач Текст)

	Попытка
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ar_Hooks'; en = 'ar_Hooks'"),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			Текст);
	Исключение
		// Журнал регистрации недоступен - намеренный no-op, подавляем
		// вторичную ошибку, чтобы не перекрыть исходную причину.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
