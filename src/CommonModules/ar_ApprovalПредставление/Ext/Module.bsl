////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ApprovalПредставление.
//
// Человекочитаемое представление записи очереди РегистрСведений.ar_ОчередьApproval
// для UI: представление tool вместо технического имени, бейдж риска, фраза
// «что произойдёт», аргументы tool с развёрнутыми ссылками вместо GUID.
//
// Выделен из ar_Диалог (UI-23) - карточка запроса на подтверждение внутри чата
// и карточка формы ОбщаяФорма.ar_ОчередьПодтверждений используют одну и ту же
// логику построения представления; дублировать её в обеих формах не нужно.
//
// Свойства модуля: Сервер, без вызова с клиента, непривилегированный - только
// чтение и форматирование, ничего не пишет.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Собирает человекочитаемую карточку одной записи очереди approval по разобранному
// JSON payload.
//
// Параметры:
//   ApprovalId  - Строка - ar_ApprovalId записи очереди.
//   PayloadJSON - Строка - ar_ActionPayloadJSON записи (сырой JSON).
//
// Возвращаемое значение:
//   Структура - {
//     ApprovalId      - Строка,
//     ИмяTool         - Строка - техническое имя (tool_name из payload),
//     Представление   - Строка - человекочитаемое название действия,
//     Риск            - Строка - "Read"/"Write"/"Commit" либо "",
//     Обоснование     - Строка - rationale от LLM,
//     Эффект          - Строка - фраза "что произойдёт при подтверждении",
//     Параметры       - Массив из Структура {Подпись, Значение, ЭтоСсылка},
//     АргументыТекст  - Строка - красиво отформатированный JSON аргументов
//   }.
//
Функция СобратьКарточку(Знач ApprovalId, Знач PayloadJSON) Экспорт

	Карточка = Новый Структура;
	Карточка.Вставить("ApprovalId", ApprovalId);
	Карточка.Вставить("ИмяTool", "");
	Карточка.Вставить("Представление", "");
	Карточка.Вставить("Риск", "");
	Карточка.Вставить("Обоснование", "");
	Карточка.Вставить("Эффект", "");
	Карточка.Вставить("Параметры", Новый Массив);
	Карточка.Вставить("АргументыТекст", "");

	Попытка
		Payload = ar_JSON.ИзJSON(PayloadJSON);
		Если ТипЗнч(Payload) = Тип("Соответствие") Тогда
			Значение = Payload.Получить("tool_name");
			Если Значение <> Неопределено Тогда
				Карточка.ИмяTool = "" + Значение;
			КонецЕсли;
			Значение = Payload.Получить("risk_level");
			Если Значение <> Неопределено Тогда
				Карточка.Риск = "" + Значение;
			КонецЕсли;
			Значение = Payload.Получить("rationale");
			Если Значение <> Неопределено Тогда
				Карточка.Обоснование = "" + Значение;
			КонецЕсли;
			Аргументы = Payload.Получить("arguments");
			Если Аргументы <> Неопределено Тогда
				Карточка.АргументыТекст = ar_JSON.КрасивыйФорматJSON(Аргументы);
				Карточка.Параметры = ЧитаемыеПараметрыApproval(Аргументы);
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Ошибки парсинга payload не критичны - карточка без деталей, но след
		// в служебном логе остаётся для диагностики (см. project_service_log_register).
		ar_СлужебныйЛог.Записать("ar_ApprovalПредставление.СобратьКарточку",
			"payload_parse_failed",
			"ApprovalId=" + ApprovalId + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

	Карточка.Представление = ПредставлениеTool(Карточка.ИмяTool);
	Карточка.Эффект = ЭффектДействия(Карточка.ИмяTool, Карточка.Риск);

	Возврат Карточка;

КонецФункции

// Человекочитаемое название tool для карточки подтверждения.
//
// Источник - ar_Представление реестра Справочник.ar_Tools (заполняется
// ar_ToolDispatcher.ЗаполнитьПредставленияВсехTools). Если запись реестра
// отсутствует или представление не заполнено, возвращается техническое имя -
// карточка не должна оставаться без заголовка.
//
// Параметры:
//   ИмяTool - Строка - техническое имя tool (snake_case).
//
// Возвращаемое значение:
//   Строка - представление либо исходное имя.
//
Функция ПредставлениеTool(Знач ИмяTool) Экспорт

	Если ПустаяСтрока(ИмяTool) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		СсылкаTool = ar_ToolDispatcher.НайтиToolПоИмени(ИмяTool);
		Если ЗначениеЗаполнено(СсылкаTool) Тогда
			Представление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаTool, "ar_Представление");
			Если НЕ ПустаяСтрока(Представление) Тогда
				Возврат "" + Представление;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Реестр недоступен - откатываемся на техническое имя, но фиксируем причину.
		ar_СлужебныйЛог.Записать("ar_ApprovalПредставление.ПредставлениеTool",
			"tool_lookup_failed",
			"ИмяTool=" + ИмяTool + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
	КонецПопытки;

	Возврат ИмяTool;

КонецФункции

// Фраза «что произойдёт», если пользователь разрешит действие.
//
// Обоснование (rationale) от LLM объясняет, ЗАЧЕМ агент это делает, но не
// говорит, что именно изменится в базе. Здесь описываем последствие в терминах
// пользователя: создаётся документ, меняются данные, отправляется письмо.
//
// Параметры:
//   ИмяTool - Строка - техническое имя tool.
//   Риск    - Строка - уровень риска ("Read" / "Write" / "Commit").
//
// Возвращаемое значение:
//   Строка - описание последствия либо "" (если нечего сказать сверх заголовка).
//
Функция ЭффектДействия(Знач ИмяTool, Знач Риск) Экспорт

	Если ИмяTool = "create_reconciliation_act" Тогда
		Возврат НСтр("ru='Будет создан новый документ «Акт сверки взаиморасчётов» в статусе черновика — без проведения.';
			|en='A new reconciliation act document will be created as a draft, without posting.'");

	ИначеЕсли ИмяTool = "create_invoice_draft" Тогда
		Возврат НСтр("ru='Будет создан новый счёт покупателю в статусе черновика — без проведения.';
			|en='A new customer invoice will be created as a draft, without posting.'");

	ИначеЕсли ИмяTool = "update_client_contact" Тогда
		Возврат НСтр("ru='Контактные данные контрагента в базе будут перезаписаны новыми значениями.';
			|en='The client contact details in the database will be overwritten with the new values.'");

	ИначеЕсли ИмяTool = "prepare_reconciliation_email" Тогда
		Возврат НСтр("ru='Будет подготовлен черновик письма с актом сверки. Письмо не отправится без вашего участия.';
			|en='A draft email with the reconciliation act will be prepared. It will not be sent without you.'");

	ИначеЕсли ИмяTool = "prepare_payment_reminder_email" Тогда
		Возврат НСтр("ru='Будет подготовлен черновик письма-напоминания об оплате счёта. Письмо не отправится без вашего участия.';
			|en='A draft payment reminder email will be prepared. It will not be sent without you.'");

	ИначеЕсли ИмяTool = "set_setting" Тогда
		Возврат НСтр("ru='Будет изменена настройка агента (справочник ar_ДополнительныеНастройки).';
			|en='An agent setting will be changed (ar_ДополнительныеНастройки catalog).'");

	ИначеЕсли ИмяTool = "remember" Тогда
		Возврат НСтр("ru='Информация будет сохранена в памяти агента и станет доступна ему в следующих диалогах.';
			|en='The information will be saved to agent memory and reused in later conversations.'");

	ИначеЕсли ИмяTool = "save_object" Тогда
		Возврат НСтр("ru='Объект базы будет записан напрямую, в обход прикладной логики. Проверьте параметры особенно внимательно.';
			|en='The object will be written directly, bypassing applied logic. Check the parameters carefully.'");

	ИначеЕсли Риск = "Commit" Тогда
		Возврат НСтр("ru='Документ будет проведён — движения по регистрам изменят учётные данные.';
			|en='The document will be posted — register records will change accounting data.'");

	ИначеЕсли Риск = "Write" Тогда
		Возврат НСтр("ru='Действие изменит данные в информационной базе.';
			|en='This action will change data in the infobase.'");

	Иначе
		Возврат "";

	КонецЕсли;

КонецФункции

// Аргументы tool в виде списка «понятная подпись → читаемое значение».
//
// Ключевая задача - развернуть навигационные ссылки в наименования объектов:
// пользователь не может оценить "e1cib/data/Справочник.Контрагенты?ref=ba4f...",
// но сразу понимает «ООО "Ромашка"». Технический JSON остаётся доступен ниже
// в свёрнутом виде.
//
// Параметры:
//   Аргументы - Соответствие, Произвольный - разобранный JSON аргументов tool.
//
// Возвращаемое значение:
//   Массив из Структура - Подпись, Значение, ЭтоСсылка.
//
Функция ЧитаемыеПараметрыApproval(Знач Аргументы) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КлючЗначение Из Аргументы Цикл

		Ключ = "" + КлючЗначение.Ключ;

		// Служебные ключи протокола пользователю не интересны.
		Если Ключ = "dry_run" ИЛИ Ключ = "idempotency_key" Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеЗначения = ЧитаемоеЗначениеПараметра(КлючЗначение.Значение);

		Параметр = Новый Структура;
		Параметр.Вставить("Подпись", ПодписьПараметра(Ключ));
		Параметр.Вставить("Значение", ОписаниеЗначения.Текст);
		Параметр.Вставить("ЭтоСсылка", ОписаниеЗначения.ЭтоСсылка);
		Результат.Добавить(Параметр);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение одного аргумента в читаемом виде.
//
// Навигационная ссылка разыменовывается в представление объекта; вложенные
// структуры и массивы сворачиваются в компактный JSON - раскрывать их в
// карточке было бы шумом.
//
// Параметры:
//   Значение - Произвольный - значение аргумента из разобранного JSON.
//
// Возвращаемое значение:
//   Структура - Текст (Строка), ЭтоСсылка (Булево - значение удалось разыменовать).
//
Функция ЧитаемоеЗначениеПараметра(Знач Значение) Экспорт

	Результат = Новый Структура("Текст, ЭтоСсылка", "", Ложь);

	Если Значение = Неопределено Тогда
		Результат.Текст = НСтр("ru='не указано'; en='not specified'");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Результат.Текст = ?(Значение, НСтр("ru='да'; en='yes'"), НСтр("ru='нет'; en='no'"));
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат.Текст = ar_Утилиты.ФорматДатаПользователю(Значение);
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
		Попытка
			Результат.Текст = ar_Утилиты.ОбрезатьДо(ar_JSON.ВЗначениеJSON(Значение), 200);
		Исключение
			Результат.Текст = НСтр("ru='(составное значение)'; en='(composite value)'");
		КонецПопытки;
		Возврат Результат;
	КонецЕсли;

	Текст = СокрЛП("" + Значение);

	// Навигационная ссылка -> представление объекта.
	Если СтрНайти(Текст, "e1cib/data/") > 0 Тогда
		Объект = ar_Утилиты.ОбъектИзНавигационнойСсылки(Текст);
		Если ЗначениеЗаполнено(Объект) Тогда
			Результат.Текст = "" + Объект;
			Результат.ЭтоСсылка = Истина;
			Возврат Результат;
		КонецЕсли;
		// Разыменовать не удалось - показываем хотя бы тип объекта, а не голый GUID.
		Результат.Текст = ПредставлениеНеразыменованнойСсылки(Текст);
		Возврат Результат;
	КонецЕсли;

	Результат.Текст = ar_Утилиты.ОбрезатьДо(Текст, 200);
	Возврат Результат;

КонецФункции

// Запасное представление ссылки, которую не удалось разыменовать:
// «Справочник.Контрагенты (объект не найден)» вместо всей строки с GUID.
//
Функция ПредставлениеНеразыменованнойСсылки(Знач Текст) Экспорт

	ПрефиксДанных = "e1cib/data/";
	ПозицияПрефикса = СтрНайти(Текст, ПрефиксДанных);
	ПозицияПараметра = СтрНайти(Текст, "?ref=");

	// Отсутствие "?ref=" (ПозицияПараметра = 0) тоже отсекается: без него
	// имя типа вычислить нельзя.
	Если ПозицияПрефикса = 0 ИЛИ ПозицияПараметра = 0 ИЛИ ПозицияПараметра <= ПозицияПрефикса Тогда
		Возврат ar_Утилиты.ОбрезатьДо(Текст, 200);
	КонецЕсли;

	НачалоИмени = ПозицияПрефикса + СтрДлина(ПрефиксДанных);
	ИмяТипа = СокрЛП(Сред(Текст, НачалоИмени, ПозицияПараметра - НачалоИмени));

	Возврат СтрШаблон(НСтр("ru='%1 (объект не найден)'; en='%1 (object not found)'"), ИмяТипа);

КонецФункции

// Подпись аргумента tool на языке пользователя.
//
// Имена аргументов в контракте tools - английский snake_case (client_ref,
// date_from). Здесь переводим известные ключи; неизвестные показываем как есть,
// заменив подчёркивания на пробелы.
//
// Параметры:
//   Ключ - Строка - имя аргумента из JSON.
//
// Возвращаемое значение:
//   Строка - подпись для карточки.
//
Функция ПодписьПараметра(Знач Ключ) Экспорт

	Подписи = Новый Соответствие;
	Подписи.Вставить("client_ref", НСтр("ru='Контрагент'; en='Client'"));
	Подписи.Вставить("counterparty_ref", НСтр("ru='Контрагент'; en='Counterparty'"));
	Подписи.Вставить("contract_ref", НСтр("ru='Договор'; en='Contract'"));
	Подписи.Вставить("organization_ref", НСтр("ru='Организация'; en='Organization'"));
	Подписи.Вставить("object_ref", НСтр("ru='Объект'; en='Object'"));
	Подписи.Вставить("document_ref", НСтр("ru='Документ'; en='Document'"));
	Подписи.Вставить("date_from", НСтр("ru='Период с'; en='Date from'"));
	Подписи.Вставить("date_to", НСтр("ru='Период по'; en='Date to'"));
	Подписи.Вставить("period_start", НСтр("ru='Период с'; en='Period start'"));
	Подписи.Вставить("period_end", НСтр("ru='Период по'; en='Period end'"));
	Подписи.Вставить("amount", НСтр("ru='Сумма'; en='Amount'"));
	Подписи.Вставить("currency", НСтр("ru='Валюта'; en='Currency'"));
	Подписи.Вставить("comment", НСтр("ru='Комментарий'; en='Comment'"));
	Подписи.Вставить("email", НСтр("ru='Электронная почта'; en='Email'"));
	Подписи.Вставить("phone", НСтр("ru='Телефон'; en='Phone'"));
	Подписи.Вставить("subject", НСтр("ru='Тема письма'; en='Subject'"));
	Подписи.Вставить("body", НСтр("ru='Текст письма'; en='Body'"));
	Подписи.Вставить("object_type", НСтр("ru='Тип объекта'; en='Object type'"));
	Подписи.Вставить("uuid", НСтр("ru='Идентификатор'; en='UUID'"));
	Подписи.Вставить("key", НСтр("ru='Ключ'; en='Key'"));
	Подписи.Вставить("value", НСтр("ru='Значение'; en='Value'"));

	Подпись = Подписи.Получить(Ключ);
	Если Подпись <> Неопределено Тогда
		Возврат Подпись;
	КонецЕсли;

	Возврат СтрЗаменить(Ключ, "_", " ");

КонецФункции

// HTML-бейдж уровня риска действия.
//
// Параметры:
//   Риск            - Строка - "Read"/"Write"/"Commit" либо "".
//   ТребуетApproval - Булево - добавить дополнительный бейдж "требует подтверждения".
//
// Возвращаемое значение:
//   Строка - HTML либо "" (Риск пуст).
//
Функция БейджРиска(Знач Риск, Знач ТребуетApproval) Экспорт

	Если ПустаяСтрока(Риск) Тогда
		Возврат "";
	КонецЕсли;

	Если Риск = "Read" Тогда
		Подпись = НСтр("ru='чтение'; en='read'");
	ИначеЕсли Риск = "Write" Тогда
		Подпись = НСтр("ru='запись'; en='write'");
	ИначеЕсли Риск = "Commit" Тогда
		Подпись = НСтр("ru='проведение'; en='commit'");
	Иначе
		Подпись = Риск;
	КонецЕсли;

	Результат = "<span class=""ar-risk ar-risk-" + НРег(Риск) + """>"
		+ ЭкранироватьHTML(Подпись) + "</span>";

	Если ТребуетApproval Тогда
		Результат = Результат + "<span class=""ar-risk ar-risk-appr"" title="""
			+ ЭкранироватьHTML(НСтр("ru='Действие требует вашего подтверждения перед выполнением';
				|en='Action requires your approval before execution'")) + """>"
			+ ЭкранироватьHTML(НСтр("ru='подтверждение'; en='approval'")) + "</span>";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Экранировать спецсимволы HTML (тот же контракт, что в ar_Настройки/ar_Диалог/ar_ДиалогOld).
//
Функция ЭкранироватьHTML(Знач Текст) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции

#КонецОбласти
