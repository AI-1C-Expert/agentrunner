////////////////////////////////////////////////////////////////////////////////
// Общий модуль "ar_LLMКомпакция".
//
// Двухуровневая компакция массива сообщений чат-формата перед отправкой в LLM
// (см. Plan §3.13, спека .docs/specs/LLM-08.md):
//   * Мягкая компакция (soft): при оценке > 0.7 * MaxContext — попарно удалять
//     наиболее старые сообщения (кроме system и последних N), пока оценка не
//     опустится ниже 0.65 * MaxContext.
//   * Жёсткий cut (hard): при оценке > 0.9 * MaxContext — оставить все
//     сообщения с role = "system" + последние N сообщений диалога.
//
// Чистая трансформация: модуль не читает ИБ, не делает HTTP, не пишет в
// регистры. MaxContext поступает аргументом от вызывающего (RT-04). Зависит
// только от ar_Токены (оценка длины) и ar_LLMКонтракт (строковые роли).
//
// Свойства модуля (выставлены в манифесте):
//   Server = true, Client = false, ServerCall = false,
//   Privileged = false, ReturnValuesReuse = DontUse.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Применить компакцию к массиву сообщений с учётом порогов MaxContext.
//
// Точка входа: RT-04 вызывает её перед передачей контекста в ar_LLMДиспетчер.
// Возвращает структуру с признаком, была ли компакция, и каким типом.
//
// Параметры:
//   Сообщения  - Массив, Неопределено - элементы Структура чат-формата с
//                                       ключами role, content, опц. tool_calls.
//   MaxContext - Число - максимальный размер окна контекста модели (в токенах).
//                        0 = «не ограничено» — компакция отключена.
//   Модель     - Строка - имя модели; передаётся в ar_Токены (зарезервировано).
//
// Возвращаемое значение:
//   Структура - {
//     Сообщения        - Массив - обновлённый (или исходный) массив.
//     БылаКомпакция    - Булево - применялась ли какая-либо компакция.
//     ТипКомпакции     - Строка - "none" | "soft" | "hard".
//     УдаленоСообщений - Число  - сколько сообщений удалено.
//     ОценкаДо         - Число  - оценка токенов до компакции.
//     ОценкаПосле      - Число  - оценка токенов после компакции.
//   }
//
Функция Применить(Знач Сообщения, Знач MaxContext, Знач Модель = "") Экспорт

	Результат = НовыйРезультат();

	// Защитные ветки: некорректный или пустой вход — graceful return.
	Если Сообщения = Неопределено
		ИЛИ ТипЗнч(Сообщения) <> Тип("Массив")
		ИЛИ Сообщения.Количество() = 0 Тогда
		Результат.Сообщения = НовыйПустойМассив();
		Возврат Результат;
	КонецЕсли;

	// MaxContext = 0 (или отрицательный/невалидный) → компакция отключена.
	Если ТипЗнч(MaxContext) <> Тип("Число") ИЛИ MaxContext <= 0 Тогда
		Результат.Сообщения = КопияМассива(Сообщения);
		Возврат Результат;
	КонецЕсли;

	ОценкаТекущая = ar_Токены.ОценитьМассив(Сообщения, Модель);
	Результат.ОценкаДо = ОценкаТекущая;
	Результат.ОценкаПосле = ОценкаТекущая;
	Результат.Сообщения = КопияМассива(Сообщения);

	ПорогHard = ПорогЖёсткогоCut() * MaxContext;
	ПорогSoft = ПорогМягкойКомпакции() * MaxContext;

	Если ОценкаТекущая > ПорогHard Тогда
		ВыполнитьЖёсткийCut(Результат, MaxContext, Модель);
	ИначеЕсли ОценкаТекущая > ПорогSoft Тогда
		ВыполнитьМягкуюКомпакцию(Результат, MaxContext, Модель);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Быстрая проверка: нужна ли компакция (оценка > 0.7 * MaxContext).
//
// Параметры:
//   Сообщения  - Массив - чат-сообщения.
//   MaxContext - Число  - окно контекста модели; 0 → всегда Ложь.
//   Модель     - Строка - имя модели (передаётся в ar_Токены).
//
// Возвращаемое значение:
//   Булево - Истина, если требуется хотя бы soft-компакция.
//
Функция НужнаКомпакция(Знач Сообщения, Знач MaxContext, Знач Модель = "") Экспорт

	Если Сообщения = Неопределено
		ИЛИ ТипЗнч(Сообщения) <> Тип("Массив")
		ИЛИ Сообщения.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(MaxContext) <> Тип("Число") ИЛИ MaxContext <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Оценка = ar_Токены.ОценитьМассив(Сообщения, Модель);
	Возврат Оценка > ПорогМягкойКомпакции() * MaxContext;

КонецФункции

// Вернуть долю заполнения окна контекста: оценка / MaxContext.
//
// Полезно для логов и UI (например, прогресс-бар «79% контекста»).
//
// Параметры:
//   Сообщения  - Массив - чат-сообщения.
//   MaxContext - Число  - окно контекста; 0 → возвращается 0 (нет ограничения).
//   Модель     - Строка - имя модели.
//
// Возвращаемое значение:
//   Число - доля в диапазоне [0..1+]. 0 — для пустого массива или MaxContext=0.
//
Функция ОценкаЗаполненности(Знач Сообщения, Знач MaxContext, Знач Модель = "") Экспорт

	Если Сообщения = Неопределено
		ИЛИ ТипЗнч(Сообщения) <> Тип("Массив")
		ИЛИ Сообщения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(MaxContext) <> Тип("Число") ИЛИ MaxContext <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Оценка = ar_Токены.ОценитьМассив(Сообщения, Модель);
	Возврат Оценка / MaxContext;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Конструктор пустого результата компакции (см. Применить).
Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Сообщения", Неопределено);
	Результат.Вставить("БылаКомпакция", Ложь);
	Результат.Вставить("ТипКомпакции", ТипКомпакцииНет());
	Результат.Вставить("УдаленоСообщений", 0);
	Результат.Вставить("ОценкаДо", 0);
	Результат.Вставить("ОценкаПосле", 0);
	Возврат Результат;

КонецФункции

// Выполняет мягкую компакцию (попарное удаление наиболее старых сообщений вне
// защищённых зон). Модифицирует поля Результата по месту.
//
// Параметры:
//   Результат  - Структура - см. НовыйРезультат(); поле Сообщения уже
//                            содержит копию исходного массива.
//   MaxContext - Число     - окно контекста модели.
//   Модель     - Строка    - имя модели.
//
Процедура ВыполнитьМягкуюКомпакцию(Результат, Знач MaxContext, Знач Модель)

	Сообщения = Результат.Сообщения;
	ПорогЗапаса = ЗапасПорогом() * MaxContext;
	КоличествоПоследних = КоличествоПоследнихХодовHard();

	// Граница начала защищённого "хвоста" — последние N сообщений нельзя трогать.
	НижняяГраницаХвоста = Сообщения.Количество() - КоличествоПоследних;
	Если НижняяГраницаХвоста < 0 Тогда
		НижняяГраницаХвоста = 0;
	КонецЕсли;

	// Позиция, начиная с которой можно удалять (пропускаем все системные
	// сообщения в начале массива — обычно одно, но допускается несколько).
	НачальнаяПозиция = ПозицияПервогоНеSystem(Сообщения);

	УдаленоВсего = 0;
	ТекущаяОценка = Результат.ОценкаДо;

	// Удаляем "ходами" слева: один user/assistant + связанные tool-сообщения.
	// Останавливаемся, как только оценка опустилась ниже ЗапасПорогом или
	// удалять больше нечего.
	Пока ТекущаяОценка > ПорогЗапаса И НачальнаяПозиция < НижняяГраницаХвоста Цикл

		КандидатДляУдаления = ВыбратьДиапазонДляУдаления(Сообщения, НачальнаяПозиция, НижняяГраницаХвоста);
		Если КандидатДляУдаления.Количество = 0 Тогда
			Прервать;
		КонецЕсли;

		Для Сч = 1 По КандидатДляУдаления.Количество Цикл
			Сообщения.Удалить(КандидатДляУдаления.Позиция);
		КонецЦикла;

		УдаленоВсего = УдаленоВсего + КандидатДляУдаления.Количество;
		НижняяГраницаХвоста = НижняяГраницаХвоста - КандидатДляУдаления.Количество;
		// Пересчёт после удаления.
		ТекущаяОценка = ar_Токены.ОценитьМассив(Сообщения, Модель);
	КонецЦикла;

	Если УдаленоВсего > 0 Тогда
		Результат.БылаКомпакция = Истина;
		Результат.ТипКомпакции = ТипКомпакцииSoft();
		Результат.УдаленоСообщений = УдаленоВсего;
		Результат.ОценкаПосле = ТекущаяОценка;
	КонецЕсли;

КонецПроцедуры

// Выполняет жёсткий cut: оставляет все системные сообщения в начале + последние
// N сообщений из конца. Модифицирует поля Результата по месту.
//
// Параметры:
//   Результат  - Структура - см. НовыйРезультат(); поле Сообщения уже
//                            содержит копию исходного массива.
//   MaxContext - Число     - окно контекста модели.
//   Модель     - Строка    - имя модели.
//
Процедура ВыполнитьЖёсткийCut(Результат, Знач MaxContext, Знач Модель)

	Сообщения = Результат.Сообщения;
	КоличествоПоследних = КоличествоПоследнихХодовHard();

	// Префикс — все подряд идущие system-сообщения с начала массива.
	ПозицияПослеSystem = ПозицияПервогоНеSystem(Сообщения);

	Голова = Новый Массив;
	Для Сч = 0 По ПозицияПослеSystem - 1 Цикл
		Голова.Добавить(Сообщения[Сч]);
	КонецЦикла;

	НачалоХвоста = Макс(ПозицияПослеSystem, Сообщения.Количество() - КоличествоПоследних);

	// Защита: первое сообщение хвоста не должно быть role = "tool" без
	// предшествующего assistant[tool_calls] — иначе провайдер вернёт ошибку.
	Пока НачалоХвоста < Сообщения.Количество()
		И ЯвляетсяРольюTool(Сообщения[НачалоХвоста]) Цикл
		НачалоХвоста = НачалоХвоста + 1;
	КонецЦикла;

	Хвост = Новый Массив;
	Для Сч = НачалоХвоста По Сообщения.Количество() - 1 Цикл
		Хвост.Добавить(Сообщения[Сч]);
	КонецЦикла;

	НовыйМассив = Новый Массив;
	Для Каждого Элемент Из Голова Цикл
		НовыйМассив.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из Хвост Цикл
		НовыйМассив.Добавить(Элемент);
	КонецЦикла;

	УдаленоВсего = Сообщения.Количество() - НовыйМассив.Количество();

	Если УдаленоВсего > 0 Тогда
		Результат.Сообщения = НовыйМассив;
		Результат.БылаКомпакция = Истина;
		Результат.ТипКомпакции = ТипКомпакцииHard();
		Результат.УдаленоСообщений = УдаленоВсего;
		Результат.ОценкаПосле = ar_Токены.ОценитьМассив(НовыйМассив, Модель);

		ЗаписьВЖурнал(УдаленоВсего, MaxContext, Результат.ОценкаДо, Результат.ОценкаПосле);
	КонецЕсли;

КонецПроцедуры

// Найти позицию первого сообщения с role != "system" (начиная с 0).
// Если все сообщения системные — вернёт Сообщения.Количество().
Функция ПозицияПервогоНеSystem(Знач Сообщения)

	Для Сч = 0 По Сообщения.Количество() - 1 Цикл
		Если Не ЯвляетсяРольюSystem(Сообщения[Сч]) Тогда
			Возврат Сч;
		КонецЕсли;
	КонецЦикла;
	Возврат Сообщения.Количество();

КонецФункции

// Выбрать диапазон сообщений для удаления (один "ход" диалога).
//
// Алгоритм: начиная с НачальнаяПозиция, осмотреть текущее сообщение по роли.
// Если это assistant[tool_calls] — захватить также все следующие за ним
// сообщения с role = "tool" (это один логический ход). Если user — захватить
// пару user + следующий assistant (если есть и без tool_calls). Иначе —
// удалить одиночное сообщение, не блокируя цикл.
//
// Возвращает структуру { Позиция, Количество }. Если ничего удалить нельзя —
// Количество = 0.
//
Функция ВыбратьДиапазонДляУдаления(Знач Сообщения, Знач НачальнаяПозиция, Знач НижняяГраницаХвоста)

	Результат = Новый Структура("Позиция, Количество", НачальнаяПозиция, 0);

	Если НачальнаяПозиция >= НижняяГраницаХвоста Тогда
		Возврат Результат;
	КонецЕсли;

	Сообщение = Сообщения[НачальнаяПозиция];
	Роль = ПолучитьРоль(Сообщение);

	Если Роль = ar_LLMКонтракт.РольAssistant() И ИмеетToolCalls(Сообщение) Тогда
		// Удаляем assistant + все следующие tool-сообщения.
		КонецДиапазона = НачальнаяПозиция + 1;
		Пока КонецДиапазона < НижняяГраницаХвоста
			И ПолучитьРоль(Сообщения[КонецДиапазона]) = ar_LLMКонтракт.РольTool() Цикл
			КонецДиапазона = КонецДиапазона + 1;
		КонецЦикла;
		Результат.Количество = КонецДиапазона - НачальнаяПозиция;
	ИначеЕсли Роль = ar_LLMКонтракт.РольUser() Тогда
		// Удаляем user + следующий assistant (если есть и без tool_calls,
		// иначе на следующей итерации удалится отдельным ходом).
		Если НачальнаяПозиция + 1 < НижняяГраницаХвоста
			И ПолучитьРоль(Сообщения[НачальнаяПозиция + 1]) = ar_LLMКонтракт.РольAssistant()
			И Не ИмеетToolCalls(Сообщения[НачальнаяПозиция + 1]) Тогда
			Результат.Количество = 2;
		Иначе
			Результат.Количество = 1;
		КонецЕсли;
	ИначеЕсли Роль = ar_LLMКонтракт.РольAssistant() Тогда
		// Одиночный assistant без tool_calls.
		Результат.Количество = 1;
	ИначеЕсли Роль = ar_LLMКонтракт.РольTool() Тогда
		// "Висячий" tool без предшествующего assistant — удаляем одиночно.
		Результат.Количество = 1;
	Иначе
		// Неизвестная роль или нет роли — удаляем одиночно, не блокируя цикл.
		Результат.Количество = 1;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Безопасное чтение поля role из структуры сообщения.
Функция ПолучитьРоль(Знач Сообщение)

	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Роль = "";
	Если Сообщение.Свойство("role", Роль) И Роль <> Неопределено Тогда
		Возврат Строка(Роль);
	КонецЕсли;
	Возврат "";

КонецФункции

// Истина, если сообщение имеет непустой массив tool_calls.
Функция ИмеетToolCalls(Знач Сообщение)

	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	ToolCalls = Неопределено;
	Если Сообщение.Свойство("tool_calls", ToolCalls)
		И ToolCalls <> Неопределено
		И ТипЗнч(ToolCalls) = Тип("Массив")
		И ToolCalls.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Истина, если role сообщения = "system".
Функция ЯвляетсяРольюSystem(Знач Сообщение)
	Возврат ПолучитьРоль(Сообщение) = ar_LLMКонтракт.РольSystem();
КонецФункции

// Истина, если role сообщения = "tool".
Функция ЯвляетсяРольюTool(Знач Сообщение)
	Возврат ПолучитьРоль(Сообщение) = ar_LLMКонтракт.РольTool();
КонецФункции

// Пустой массив-результат.
Функция НовыйПустойМассив()
	Возврат Новый Массив;
КонецФункции

// Вернуть неглубокую копию массива (элементы не клонируются, только сам
// массив). У типа Массив в BSL нет метода Скопировать() - в отличие от
// ТаблицаЗначений/СписокЗначений.
//
// Параметры:
//   Источник - Массив.
//
// Возвращаемое значение:
//   Массив - новый массив с теми же элементами в том же порядке.
//
Функция КопияМассива(Знач Источник)
	Копия = Новый Массив;
	Для Каждого Элемент Из Источник Цикл
		Копия.Добавить(Элемент);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Запись в журнал регистрации факта жёсткого cut (метаданные, без тел).
Процедура ЗаписьВЖурнал(Знач Удалено, Знач MaxContext, Знач ОценкаДо, Знач ОценкаПосле)

	Сообщение = СтрШаблон(
		НСтр("ru = 'Жёсткий cut контекста: удалено сообщений %1, MaxContext %2, оценка %3 -> %4.';
			|en = 'Hard context cut: %1 messages removed, MaxContext %2, estimate %3 -> %4.'"),
		Удалено, MaxContext, ОценкаДо, ОценкаПосле);

	Попытка
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'AgentRunner.Компакция'; en = 'AgentRunner.Compaction'"),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			Сообщение);
	Исключение
		// Журнал — best-effort, не маскируем основные ошибки вызывающего.
	КонецПопытки;

КонецПроцедуры

// === Константы порогов и идентификаторов типов ===

// Доля MaxContext, при которой включается soft-компакция.
Функция ПорогМягкойКомпакции()
	Возврат 0.7;
КонецФункции

// Доля MaxContext, при которой включается hard cut.
Функция ПорогЖёсткогоCut()
	Возврат 0.9;
КонецФункции

// Целевая заполненность после soft-компакции (запас по умолчанию 0.65).
Функция ЗапасПорогом()
	Возврат 0.65;
КонецФункции

// Число последних сообщений (не ходов), сохраняемых при жёстком cut и soft.
Функция КоличествоПоследнихХодовHard()
	Возврат 4;
КонецФункции

// Идентификатор "компакция не применялась".
Функция ТипКомпакцииНет()
	Возврат "none";
КонецФункции

// Идентификатор мягкой компакции.
Функция ТипКомпакцииSoft()
	Возврат "soft";
КонецФункции

// Идентификатор жёсткого cut.
Функция ТипКомпакцииHard()
	Возврат "hard";
КонецФункции

#КонецОбласти
