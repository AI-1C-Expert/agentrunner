////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_Память (AOS - Память агентов).
//
// Работа с долгосрочной памятью агентов (справочник ar_ПамятьАгента, META-25)
// вне tool-контекста. Используется ar_RuntimeКонтекст для формирования
// STABLE-слоя системного промпта (секция §2.5 Memory Index, Plan §6.1).
//
// Модуль чистый (read-only к ИБ): не пишет данных, не устанавливает
// привилегированный режим, не делает HTTP-запросов.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/MEM-01.md, .docs/specs/MEM-02.md, Plan §5 этап 2, §2.8.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Загрузить memory index агента для вставки в системный промпт (STABLE-слой).
//
// Запрашивает из ar_ПамятьАгента все непомеченные записи владельца,
// упорядоченные по убыванию ar_Обновлено (последние изменения выше).
// Лимит: 50 записей (защита от переполнения контекста, MEM-01 §Риски).
//
// MEM-03: владелец записей — либо агент (СправочникСсылка.ar_Агенты), либо
// пользователь ИБ в режиме «без агента» (UI-22). Ровно один из параметров
// Агент/ПользовательUUID должен быть заполнен — вызывающая сторона
// (ar_RuntimeКонтекст) отвечает за выбор ветки.
//
// Формат блока:
//   ## Memory Index
//   [<тип>] <текст> (keywords: <ключевые слова>)
//   ...
//
// Параметры:
//  Агент          - СправочникСсылка.ar_Агенты - ссылка агента (агентный режим).
//                   Пустая ссылка/Неопределено - тогда используется ПользовательUUID.
//  ПользовательUUID - Строка - UUID пользователя ИБ (режим «без агента», MEM-03).
//                   Используется только если Агент не задан. По умолчанию "".
//
// Возвращаемое значение:
//  Строка - текстовый блок Memory Index (непустой при наличии записей)
//           или "" при отсутствии записей или незаполненном владельце.
//
Функция ЗагрузитьИндекс(Знач Агент, Знач ПользовательUUID = "") Экспорт

	ВладелецКлюч = СформироватьВладелецКлюч(Агент, ПользовательUUID);
	Если ПустаяСтрока(ВладелецКлюч) Тогда
		Возврат "";
	КонецЕсли;

	Записи = ПолучитьЗаписиПамяти(ВладелецКлюч);
	Если Записи.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("## Memory Index");

	Для Каждого Запись Из Записи Цикл
		ТипЗаписи     = Запись.Тип;
		ТекстЗаписи   = Запись.Текст;
		КлючевыеСлова = СокрЛП(Запись.КлючевыеСлова);

		СтрокаИндекса = "[" + ТипЗаписи + "] " + ТекстЗаписи;
		Если Не ПустаяСтрока(КлючевыеСлова) Тогда
			СтрокаИндекса = СтрокаИндекса + " (keywords: " + КлючевыеСлова + ")";
		КонецЕсли;
		Строки.Добавить(СтрокаИндекса);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Поиск записей в долгосрочной памяти агента по шаблону (tool recall_memory, MEM-02).
//
// Выполняет ПОДОБНО-поиск по полям ar_Текст и ar_КлючевыеСлова справочника
// ar_ПамятьАгента. Шаблон экранируется через
// ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе [Реф: БСП/ОбщегоНазначения]
// и оборачивается в "%" + Шаблон + "%" для поиска подстроки.
//
// Опциональная вторая фаза (ВключатьИсторию = Истина) включается ТОЛЬКО
// если первая фаза вернула < 5 результатов: перебирает PayloadJSON из
// ar_СобытияЗапуска (не более 200 последних событий агента). MEM-03: фаза 2
// работает только для агентного владельца (ar_СобытияЗапуска не хранит
// разреза по пользователю) - в режиме «без агента» пропускается.
//
// Параметры:
//  Агент           - СправочникСсылка.ar_Агенты - ссылка агента (агентный режим).
//                    Пустая ссылка/Неопределено - тогда используется ПользовательUUID.
//  Шаблон          - Строка - шаблон для ПОДОБНО (без "%" и экранирования).
//  НачалоПериода   - Дата, Неопределено - ограничение по ar_Обновлено >= (Неопределено = без фильтра).
//  КонецПериода    - Дата, Неопределено - зарезервирован для будущего использования;
//                    в текущей реализации не применяется (MEM-02 §Поведение:
//                    КонецПериода всегда = Неопределено, поиск ведётся до «сейчас»).
//  ФильтрТипа      - Строка - тип записи: "fact"/"preference"/"rule"/"note" или "all" (без фильтра).
//  ВключатьИсторию - Булево - включить вторую фазу поиска по ar_СобытияЗапуска (только агентный режим).
//  ПользовательUUID - Строка - UUID пользователя ИБ (режим «без агента», MEM-03).
//                    Используется только если Агент не задан. По умолчанию "".
//
// Возвращаемое значение:
//  Массив из Структура { Тип, Текст, КлючевыеСлова, Обновлено, Источник }.
//
Функция ИскатьЗапуски(Знач Агент, Знач Шаблон, Знач НачалоПериода, Знач КонецПериода,
		Знач ФильтрТипа = "all", Знач ВключатьИсторию = Ложь, Знач ПользовательUUID = "") Экспорт

	ВладелецКлюч = СформироватьВладелецКлюч(Агент, ПользовательUUID);
	Если ПустаяСтрока(ВладелецКлюч) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ТипЗнч(Шаблон) <> Тип("Строка") Или ПустаяСтрока(Шаблон) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	// Экранируем шаблон для оператора ПОДОБНО (спецсимвол "~") и добавляем %.
	ШаблонЭкран = ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(Шаблон);
	ШаблонПодобно = "%" + ШаблонЭкран + "%";

	// Фаза 1: поиск в memory index (ar_ПамятьАгента), строго по ar_ВладелецКлюч.
	РезультатФаза1 = ИскатьВПамяти(ВладелецКлюч, ШаблонПодобно, НачалоПериода, ФильтрТипа);

	Результат = Новый Массив;
	Для Каждого Стр Из РезультатФаза1 Цикл
		Результат.Добавить(Стр);
	КонецЦикла;

	// Фаза 2 (опциональная): поиск в истории запусков (ar_СобытияЗапуска).
	// Включается только при явном запросе, менее 5 результатов из фазы 1
	// И реальном (непустом) агенте - у пользовательского владельца истории
	// запусков конкретного агента нет.
	ЕстьРеальныйАгент = (ТипЗнч(Агент) = Тип("СправочникСсылка.ar_Агенты") И Не Агент.Пустая());
	Если ВключатьИсторию И Результат.Количество() < 5 И ЕстьРеальныйАгент Тогда
		РезультатФаза2 = ИскатьВИсторииЗапусков(Агент, Шаблон, НачалоПериода);
		Для Каждого Стр Из РезультатФаза2 Цикл
			Результат.Добавить(Стр);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Формирует универсальный ключ владельца записи памяти (MEM-03).
//
// Ровно одна из веток должна дать непустой результат: агентная ("agent:<uuid>")
// или пользовательская ("ibuser:<uuid>"). Приоритет у агента - если передана
// непустая ссылка на ar_Агенты, ПользовательUUID игнорируется. Единая точка
// формирования ключа, переиспользуемая в ar_Память, ar_ToolПамять, ar_RuntimeКонтекст,
// ar_Scheduler (SCHED-09-блок).
//
// Параметры:
//  Агент            - СправочникСсылка.ar_Агенты, Неопределено - ссылка агента.
//  ПользовательUUID - Строка - UUID пользователя ИБ. Используется только если
//                     Агент не задан/пуст.
//
// Возвращаемое значение:
//  Строка - "agent:<uuid>" / "ibuser:<uuid>" или "" (граничный случай: оба параметра пусты).
//
Функция СформироватьВладелецКлюч(Знач Агент, Знач ПользовательUUID = "") Экспорт

	Если ТипЗнч(Агент) = Тип("СправочникСсылка.ar_Агенты") И Не Агент.Пустая() Тогда
		Возврат "agent:" + СтрЗаменить(Строка(Агент.УникальныйИдентификатор()), " ", "");
	КонецЕсли;

	UUID = СокрЛП(?(ТипЗнч(ПользовательUUID) = Тип("Строка"), ПользовательUUID, ""));
	Если ПустаяСтрока(UUID) Тогда
		Возврат "";
	КонецЕсли;

	Возврат "ibuser:" + UUID;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поиск в справочнике ar_ПамятьАгента по шаблону ПОДОБНО. Лимит: 30 записей.
//
// MEM-03: фильтрует строго по ar_ВладелецКлюч (единый ключ владельца -
// агент или пользователь), без «or»-условий - гарантирует изоляцию между
// пользователями/агентами (MEM-03 §4).
//
// Параметры:
//  ВладелецКлюч    - Строка - "agent:<uuid>" или "ibuser:<uuid>" (см. СформироватьВладелецКлюч).
//  ШаблонПодобно   - Строка - уже готовый шаблон с % и экранированными символами.
//  НачалоПериода   - Дата или Неопределено.
//  ФильтрТипа      - Строка: конкретный тип ("fact" и т.п.) или "all" / Неопределено.
//
// Возвращаемое значение:
//  Массив из Структура {Тип, Текст, КлючевыеСлова, Обновлено, Источник}.
//
Функция ИскатьВПамяти(Знач ВладелецКлюч, Знач ШаблонПодобно, Знач НачалоПериода, Знач ФильтрТипа)

	// Флаги условий: при Истина — соответствующее ограничение пропускается.
	ФильтрТипаОтключён = Не (ТипЗнч(ФильтрТипа) = Тип("Строка")
		И Не ПустаяСтрока(ФильтрТипа)
		И ФильтрТипа <> "all");
	ФильтрПериодаОтключён = Не (ТипЗнч(НачалоПериода) = Тип("Дата"));

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 30
		|	Память.ar_Тип           КАК Тип,
		|	Память.ar_Текст         КАК Текст,
		|	Память.ar_КлючевыеСлова КАК КлючевыеСлова,
		|	Память.ar_Обновлено     КАК Обновлено,
		|	""memory_index""         КАК Источник
		|ИЗ
		|	Справочник.ar_ПамятьАгента КАК Память
		|ГДЕ
		|	Память.ar_ВладелецКлюч = &ВладелецКлюч
		|	И НЕ Память.ПометкаУдаления
		|	И (Память.ar_Текст ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Память.ar_КлючевыеСлова ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И (&ФильтрТипаОтключён ИЛИ Память.ar_Тип = &ТипЗаписи)
		|	И (&ФильтрПериодаОтключён ИЛИ Память.ar_Обновлено >= &НачалоПериода)
		|УПОРЯДОЧИТЬ ПО
		|	Память.ar_Обновлено УБЫВ";

	Запрос.УстановитьПараметр("ВладелецКлюч",         ВладелецКлюч);
	Запрос.УстановитьПараметр("Шаблон",               ШаблонПодобно);
	Запрос.УстановитьПараметр("ФильтрТипаОтключён",   ФильтрТипаОтключён);
	Запрос.УстановитьПараметр("ТипЗаписи",            ?(ФильтрТипаОтключён, "", ФильтрТипа));
	Запрос.УстановитьПараметр("ФильтрПериодаОтключён", ФильтрПериодаОтключён);
	Если Не ФильтрПериодаОтключён Тогда
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Иначе
		// Для запроса нужен параметр даже при отключённом фильтре (параметр не используется,
		// но должен присутствовать в тексте запроса).
		Запрос.УстановитьПараметр("НачалоПериода", '00010101');
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("Тип",            Выборка.Тип);
		Стр.Вставить("Текст",          Выборка.Текст);
		Стр.Вставить("КлючевыеСлова",  Выборка.КлючевыеСлова);
		Стр.Вставить("Обновлено",      Выборка.Обновлено);
		Стр.Вставить("Источник",       Выборка.Источник);
		Результат.Добавить(Стр);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поиск по PayloadJSON событий запуска агента (вторая фаза, опциональная).
// Фильтрует в 1С-цикле — не более 200 событий (Риск 3, MEM-02).
//
// Параметры:
//  Агент          - СправочникСсылка.ar_Агенты.
//  Шаблон         - Строка - исходный шаблон поиска (без % и экранирования).
//  НачалоПериода  - Дата или Неопределено.
//
// Возвращаемое значение:
//  Массив из Структура {Тип, Текст, КлючевыеСлова, Обновлено, Источник}.
//
Функция ИскатьВИсторииЗапусков(Знач Агент, Знач Шаблон, Знач НачалоПериода)

	// Получить RunId запусков текущего агента за период.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 200
		|	События.ar_PayloadJSON КАК PayloadJSON,
		|	События.ar_МоментВремени КАК МоментВремени
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК События
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ar_Запуски КАК Запуски
		|		ПО Запуски.ar_RunId = События.ar_RunId
		|ГДЕ
		|	Запуски.ar_АгентРеф = &Агент
		|	И (&ФильтрПериода ИЛИ Запуски.ar_СтартовалВ >= &НачалоПериода)
		|УПОРЯДОЧИТЬ ПО
		|	События.ar_МоментВремени УБЫВ";

	ФильтрПериодаОтключён = Не (ТипЗнч(НачалоПериода) = Тип("Дата"));
	Запрос.УстановитьПараметр("Агент",          Агент);
	Запрос.УстановитьПараметр("ФильтрПериода",  ФильтрПериодаОтключён);
	Если Не ФильтрПериодаОтключён Тогда
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Иначе
		Запрос.УстановитьПараметр("НачалоПериода", '00010101');
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	ШаблонНижний = НРег(Шаблон);

	Пока Выборка.Следующий() Цикл
		ПолезнаяНагрузка = СокрЛП(Выборка.PayloadJSON);
		Если ПустаяСтрока(ПолезнаяНагрузка) Тогда
			Продолжить;
		КонецЕсли;
		// Поиск шаблона без учёта регистра.
		Если СтрНайти(НРег(ПолезнаяНагрузка), ШаблонНижний) = 0 Тогда
			Продолжить;
		КонецЕсли;
		// Извлечь фрагмент контекста (до 500 символов).
		Фрагмент = Лев(ПолезнаяНагрузка, 500);

		Стр = Новый Структура;
		Стр.Вставить("Тип",           "note");
		Стр.Вставить("Текст",         Фрагмент);
		Стр.Вставить("КлючевыеСлова", "");
		Стр.Вставить("Обновлено",     Выборка.МоментВремени);
		Стр.Вставить("Источник",      "run_history");
		Результат.Добавить(Стр);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получить записи памяти владельца (агента или пользователя) из ИБ, упорядоченные
// по убыванию ar_Обновлено. Возвращает не более 50 записей (защита от переполнения
// контекста LLM).
//
// MEM-03: фильтрует строго по ar_ВладелецКлюч - гарантирует изоляцию между
// пользователями/агентами (MEM-03 §4).
//
// Параметры:
//  ВладелецКлюч - Строка - "agent:<uuid>" или "ibuser:<uuid>" (см. СформироватьВладелецКлюч).
//
// Возвращаемое значение:
//  Массив из Структура {Тип, Текст, КлючевыеСлова}.
//
Функция ПолучитьЗаписиПамяти(Знач ВладелецКлюч)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Память.ar_Тип           КАК Тип,
		|	Память.ar_Текст         КАК Текст,
		|	Память.ar_КлючевыеСлова КАК КлючевыеСлова
		|ИЗ
		|	Справочник.ar_ПамятьАгента КАК Память
		|ГДЕ
		|	Память.ar_ВладелецКлюч = &ВладелецКлюч
		|	И НЕ Память.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Память.ar_Обновлено УБЫВ";
	Запрос.УстановитьПараметр("ВладелецКлюч", ВладелецКлюч);

	Выборка = Запрос.Выполнить().Выбрать();

	// Перекладываем в массив для удобства обхода (Выборка.Количество() — нет метода).
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрЗаписи = Новый Структура;
		СтрЗаписи.Вставить("Тип",            Выборка.Тип);
		СтрЗаписи.Вставить("Текст",          Выборка.Текст);
		СтрЗаписи.Вставить("КлючевыеСлова",  Выборка.КлючевыеСлова);
		Результат.Добавить(СтрЗаписи);
	КонецЦикла;

	Возврат Результат;

КонецФункции

