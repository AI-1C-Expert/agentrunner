////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_СлужебныйЛог (SESS-08).
//
// Универсальный внутренний лог-регистр AgentRunner - структурированная замена
// диагностических ЗаписьЖурналаРегистрации(). Пишет в РегистрСведений.
// ar_СлужебныйЛог (append-only: каждая запись уникальна за счёт измерения
// ar_ЗаписьId). Не привязан к конкретной подсистеме (сессии/audit/tools) -
// любой модуль расширения может использовать Записать() для диагностики,
// доступной программному анализу (фильтрация по RunId/Событию/Источнику),
// в отличие от текстового журнала регистрации платформы.
//
// Вывод и очистка - через существующий фасад ar_ДиагностикаОчистка
// (ar_Диалог: команды ar_ПоказатьЛог/ar_ОчиститьЛог) - единый служебный лог
// AgentRunner, а не параллельный механизм.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь
// (AUD-06: расширениям запрещён Privileged=true в общих модулях). Привилегии
// поднимаются точечно внутри Записать и сбрасываются парным вызовом (Ложь),
// по паттерну ar_AuditЗащищённыйРежим.
//
// Запрещено: Выполнить(), Вычислить().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Добавить запись в служебный лог. Best-effort: любая ошибка проглатывается
// (лог не должен ронять вызывающий код) - при сбое запись дублируется в
// стандартный ЖурналРегистрации, чтобы диагностика не терялась полностью.
//
// Параметры:
//  Источник - Строка - модуль/процедура-источник (например "ar_RuntimeЦикл.ПодмешатьИсториюСессии").
//  Событие  - Строка - короткий код события (например "sess_read", "sess_write").
//  Текст    - Строка - произвольные подробности.
//  Уровень  - Строка - "Информация" / "Предупреждение" / "Ошибка". По умолчанию "Информация".
//  RunId    - Строка - идентификатор запуска, если применимо. По умолчанию "".
//  Объект   - Произвольный - ссылка на связанный объект ИБ, если применимо.
//             Конвертируется через ar_Утилиты.НавигационнаяСсылкаОбъекта. По умолчанию Неопределено.
//
Процедура Записать(Знач Источник, Знач Событие, Знач Текст, Знач Уровень = "Информация",
		Знач RunId = "", Знач Объект = Неопределено) Экспорт

	Попытка
		ЗаписьId = Строка(Новый УникальныйИдентификатор());
		ОбъектСсылка = "";
		Если Объект <> Неопределено Тогда
			ОбъектСсылка = ar_Утилиты.НавигационнаяСсылкаОбъекта(Объект);
		КонецЕсли;

		УстановитьПривилегированныйРежим(Истина);
		Попытка
			МенеджерЗаписи = РегистрыСведений.ar_СлужебныйЛог.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ar_ЗаписьId = ЗаписьId;
			МенеджерЗаписи.ar_Момент = ТекущаяДатаСеанса();
			МенеджерЗаписи.ar_Источник = Лев(Источник, 150);
			МенеджерЗаписи.ar_Событие = Лев(Событие, 100);
			МенеджерЗаписи.ar_Уровень = Уровень;
			МенеджерЗаписи.ar_RunId = RunId;
			МенеджерЗаписи.ar_ОбъектСсылка = Лев(ОбъектСсылка, 250);
			МенеджерЗаписи.ar_Текст = Текст;
			МенеджерЗаписи.Записать(Истина);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			ВызватьИсключение;
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);

	Исключение
		// Best-effort: лог не должен ронять вызывающий код. Дублируем в ЖР,
		// чтобы не потерять диагностику полностью.
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru='AgentRunner.ar_СлужебныйЛог: ошибка записи'"),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
