////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolОтчёты (Tool - Отчёты).
//
// Реализует tools:
//   run_report     — прогон варианта отчёта через СКД (TOOL-13).
//   get_print_form — получение печатной формы документа (TOOL-14).
//
// Контракт tool-функций:
//   Вход:  Аргументы (Строка) — JSON-объект аргументов от LLM.
//          Контекст (Структура) — КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//   Выход: Строка JSON — observation для добавления в контекст как role:tool.
//          Никогда не пустая; при ошибке — {"error":"<код>"}.
//
// Обе операции read-only: побочных эффектов нет. Привилегированный режим
// не используется — данные читаются в правах пользователя сессии (Plan §2.8, §3.1).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеки: .docs/specs/TOOL-13.md, .docs/specs/TOOL-14.md, Plan §2.8, §3.1.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня модуля ar_ToolОтчёты. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolОтчёты.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры (например "ПрогонОтчёта").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ПрогонОтчёта" Тогда
		Возврат ПрогонОтчёта(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПолучитьПечатнуюФорму" Тогда
		Возврат ПолучитьПечатнуюФорму(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Идемпотентно создаёт/обновляет запись реестра ar_Tools для tool run_report.
// Вызывается из ar_ToolDispatcher.ЗарегистрироватьВсеTools(). Привилегированный
// режим включается локально только для записи в служебный реестр ядра.
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } — статистика.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинИнструмент(ОписаниеRunReport(), Статистика);
		ЗарегистрироватьОдинИнструмент(ОписаниеGetPrintForm(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

// Tool run_report: прогон варианта отчёта СКД из конфигурации.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM. Поля:
//    report_name (обяз.) - имя отчёта в метаданных конфигурации.
//    variant     (опц.)  - имя варианта СКД; при отсутствии используется вариант по умолчанию.
//    parameters  (опц.)  - объект {ИмяПараметра: значение} для параметров СКД.
//    limit       (опц.)  - макс. строк, 1..500, деф. 100.
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//
// Возвращаемое значение:
//   Строка - JSON {"report","variant","columns":[{name,title}],
//                  "rows":[[...],...],"count","truncated","structure":"flat"}
//            либо {"error":"<код>"[,...]}
//
Функция ПрогонОтчёта(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Возврат ПрогонОтчётаВнутр(Аргументы, Контекст);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Tool get_print_form: получить печатную форму документа в текстовом/табличном виде.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM. Поля:
//    ref      (обяз.) - навигационная ссылка или GUID документа.
//    template (опц.)  - идентификатор команды печати; при отсутствии — первая доступная.
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//
// Возвращаемое значение:
//   Строка - JSON {"ref","template","content_type":"text"/"table","content","truncated"}
//            либо {"error":"<код>"[,...]}
//
Функция ПолучитьПечатнуюФорму(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Возврат ПолучитьПечатнуюФормуВнутр(Аргументы, Контекст);
	Исключение
		Возврат ОшибкаTool(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Основная логика run_report.

// Внутренняя реализация прогона отчёта. Выделена из ПрогонОтчёта чтобы
// внешний Попытка/Исключение ловил любые непредвиденные ошибки.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM (те же, что получила ПрогонОтчёта).
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ПрогонОтчётаВнутр(Знач Аргументы, Знач Контекст)

	Аргс = РазобратьАргументы(Аргументы);

	// 1. Нормализация параметров.
	ИмяОтчёта  = ПолучитьСтроку(Аргс, "report_name");
	Вариант    = ПолучитьСтроку(Аргс, "variant");
	Лимит      = НормализоватьЛимит(ПолучитьЧисло(Аргс, "limit", 100), 1, 500, 100);
	DryRun     = ar_ToolDispatcher.ИзвлечьDryRun(Аргументы);

	// Пустое имя — незвестный отчёт согласно таксономии DoD D6 (unknown_report).
	// "report_name_required" не входит в таксономию; пустая строка трактуется
	// как несуществующий отчёт, что корректно: LLM может передать пустой аргумент.
	Если ПустаяСтрока(ИмяОтчёта) Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error",  "unknown_report");
		Ошибка.Вставить("report", "");
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 2. Проверка запрета объектов расширения (D4).
	Если Лев(ВРег(ИмяОтчёта), 4) = "AOS_" Тогда
		Возврат ОшибочныйJSON("access_denied_to_extension_object");
	КонецЕсли;

	// 3. Поиск отчёта в метаданных.
	МДОтчёта = Метаданные.Отчеты.Найти(ИмяОтчёта);
	Если МДОтчёта = Неопределено Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "unknown_report");
		Ошибка.Вставить("report", ИмяОтчёта);
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 4. Признак СКД-отчёта — заполненное свойство метаданных
	// ОсновнаяСхемаКомпоновкиДанных. [Платформа: ОбъектМетаданных.Отчет]
	Если МДОтчёта.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "no_dcs_schema");
		Ошибка.Вставить("report", ИмяОтчёта);
		Ошибка.Вставить("hint", "report may not use DCS");
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 5-7. Компоновка ЧЕРЕЗ ОБЪЕКТ ОТЧЁТА (Отчеты[Имя].Создать() +
	// СкомпоноватьРезультат) — именно этот путь вызывает обработчик
	// ПриКомпоновкеРезультата модуля отчёта, наполняющий вычисляемые/внешние поля.
	// Прямой прогон схемы (КомпоновщикМакета→ПроцессорКомпоновки) обработчик НЕ
	// вызывает, из-за чего отчёты с логикой в ПриКомпоновкеРезультата падали на
	// Вывести. [Платформа: ОтчетОбъект.СкомпоноватьРезультат; интернет-канон СКД]
	ТабДок = Новый ТабличныйДокумент;
	ИмяВарианта = Вариант;
	Попытка
		ОбъектОтчёта = Отчеты[ИмяОтчёта].Создать();

		// Настройки: вариант (если задан) либо настройки по умолчанию из схемы.
		РезультатНастроек = НастройкиОбъектаОтчёта(ОбъектОтчёта, Вариант, ИмяОтчёта);
		Если ТипЗнч(РезультатНастроек) = Тип("Строка") Тогда
			Возврат РезультатНастроек; // JSON-ошибка unknown_variant.
		КонецЕсли;
		Настройки   = РезультатНастроек.Настройки;
		ИмяВарианта = РезультатНастроек.ИмяВарианта;

		// Применение параметров СКД (тихое игнорирование неизвестных/несовместимых).
		Предупреждения = Новый Массив;
		ПараметрыJSON  = Аргс.Получить("parameters");
		Если ТипЗнч(ПараметрыJSON) = Тип("Соответствие") Тогда
			ПрименитьПараметрыСКД(Настройки, ПараметрыJSON, Предупреждения);
		КонецЕсли;

		ОбъектОтчёта.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		ОбъектОтчёта.СкомпоноватьРезультат(ТабДок, Неопределено);
	Исключение
		Возврат КлассифицироватьОшибкуПечати(ИнформацияОбОшибке(), "report_error");
	КонецПопытки;

	// 8. Извлечение строк из ТабличногоДокумента (строки таблицы × колонки).
	ДанныеТаблицы = ИзвлечьСтрокиТабДок(ТабДок, Лимит);

	// 9. Сборка observation.
	Результат = Новый Структура;
	Результат.Вставить("report",   ИмяОтчёта);
	Результат.Вставить("variant",  ИмяВарианта);
	Результат.Вставить("rows",     ДанныеТаблицы.Строки);
	Результат.Вставить("count",    ДанныеТаблицы.Количество);
	Результат.Вставить("truncated", ДанныеТаблицы.Усечено);
	Результат.Вставить("structure", "table");

	Если Предупреждения.Количество() > 0 Тогда
		Результат.Вставить("warnings", Предупреждения);
	КонецЕсли;

	Если DryRun Тогда
		Результат.Вставить("dry_run", Истина);
	КонецЕсли;

	// 10. Ограничение размера (~100 KB).
	Возврат ОграничитьРазмерObservation(Результат);

КонецФункции

// Получить настройки компоновки от ОБЪЕКТА отчёта: схема берётся через
// ОбъектОтчёта.ПолучитьМакет (валидный носитель метода, в отличие от объекта
// метаданных), дальше — общая логика ПолучитьНастройкиСхемы (переиспользование).
//
// Параметры:
//  ОбъектОтчёта - ОтчетОбъект - созданный объект отчёта (Отчеты[Имя].Создать()).
//  Вариант      - Строка - имя варианта ("" = настройки по умолчанию).
//  ИмяОтчёта    - Строка - имя отчёта (для сообщений об ошибке).
//
// Возвращаемое значение:
//  Структура - {Настройки, ИмяВарианта} при успехе.
//  Строка    - JSON-ошибка {"error":"unknown_variant",...} при неизвестном варианте.
//
Функция НастройкиОбъектаОтчёта(Знач ОбъектОтчёта, Знач Вариант, Знач ИмяОтчёта)
	Схема = ОбъектОтчёта.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Возврат ПолучитьНастройкиСхемы(Схема, Вариант, ИмяОтчёта);
КонецФункции

// Извлечь строки данных из ТабличногоДокумента результата СкомпоноватьРезультат.
// Каждая непустая строка табдока → массив текстов ячеек (по ширине таблицы);
// полностью пустые строки-разделители пропускаются. Лимит строк → Усечено.
//
// Параметры:
//  ТабДок - ТабличныйДокумент - результат компоновки отчёта.
//  Лимит  - Число - максимум строк в ответе.
//
// Возвращаемое значение:
//  Структура - { Строки - Массив из Массив (тексты ячеек),
//                Количество - Число, Усечено - Булево }.
//
Функция ИзвлечьСтрокиТабДок(Знач ТабДок, Знач Лимит)

	Результат = Новый Структура("Строки, Количество, Усечено", Новый Массив, 0, Ложь);

	Высота = ТабДок.ВысотаТаблицы;
	Ширина = ТабДок.ШиринаТаблицы;

	Для НомерСтроки = 1 По Высота Цикл

		ЯчейкиСтроки = Новый Массив;
		ЕстьДанные = Ложь;
		Для НомерКолонки = 1 По Ширина Цикл
			ТекстЯчейки = СокрЛП(
				ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
			ЯчейкиСтроки.Добавить(ТекстЯчейки);
			Если НЕ ПустаяСтрока(ТекстЯчейки) Тогда
				ЕстьДанные = Истина;
			КонецЕсли;
		КонецЦикла;

		Если НЕ ЕстьДанные Тогда
			Продолжить; // Пустая строка-разделитель — не данные.
		КонецЕсли;

		Если Результат.Строки.Количество() >= Лимит Тогда
			Результат.Усечено = Истина;
			Прервать;
		КонецЕсли;

		Результат.Строки.Добавить(ЯчейкиСтроки);

	КонецЦикла;

	Результат.Количество = Результат.Строки.Количество();
	Возврат Результат;

КонецФункции

// Получить настройки схемы: либо по умолчанию, либо именованный вариант.
//
// Параметры:
//  Схема      - СхемаКомпоновкиДанных - схема СКД отчёта.
//  Вариант    - Строка - имя варианта (пустая строка = вариант по умолчанию).
//  ИмяОтчёта - Строка - имя отчёта (для формирования сообщения об ошибке).
//
// Возвращаемое значение:
//  Структура - {Настройки, ИмяВарианта} при успехе.
//  Строка    - JSON-ошибка {"error":"unknown_variant",...} при неизвестном варианте.
//
Функция ПолучитьНастройкиСхемы(Знач Схема, Знач Вариант, Знач ИмяОтчёта)

	Если ПустаяСтрока(Вариант) Тогда
		// Вариант не задан — используем настройки по умолчанию из схемы.
		// Инициализировать первым параметром ждёт ИсточникДоступныхНастроек-
		// КомпоновкиДанных, а НЕ саму схему (иначе Type mismatch parameter 1).
		// [Реф: интернет-канон СКД; Платформа: КомпоновщикНастроекКомпоновкиДанных]
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.Инициализировать(
			Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
		Настройки = КомпоновщикНастроек.ПолучитьНастройки();
		ИмяВарианта = "";
		Если Схема.ВариантыНастроек.Количество() > 0 Тогда
			// Свойство элемента ВариантыНастроек называется Имя, а не Ключ
			// (иначе Object field not found (Ключ)). [Платформа: ВариантНастроекКомпоновкиДанных]
			ИмяВарианта = Схема.ВариантыНастроек[0].Имя;
		КонецЕсли;
		Возврат Новый Структура("Настройки, ИмяВарианта", Настройки, ИмяВарианта);
	КонецЕсли;

	// Ищем вариант по имени в схеме.
	Настройки = Неопределено;
	Для Каждого ВариантСхемы Из Схема.ВариантыНастроек Цикл
		Если ВариантСхемы.Имя = Вариант Тогда
			Настройки = ВариантСхемы.Настройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Настройки = Неопределено Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error",   "unknown_variant");
		Ошибка.Вставить("variant", Вариант);
		Ошибка.Вставить("report",  ИмяОтчёта);
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	Возврат Новый Структура("Настройки, ИмяВарианта", Настройки, Вариант);

КонецФункции

// Применить параметры СКД из соответствия {Ключ → Значение}.
// Неизвестные ключи тихо игнорируются.
// Несовместимые типы: попытка установить, при исключении — пропустить +
// добавить предупреждение.
//
Процедура ПрименитьПараметрыСКД(Знач Настройки, Знач Параметры, Предупреждения)

	Для Каждого КлючИЗначение Из Параметры Цикл

		Ключ         = КлючИЗначение.Ключ;
		ЗначениеПар = КлючИЗначение.Значение;

		Если ТипЗнч(Ключ) <> Тип("Строка") ИЛИ ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			НайденноеЗначение = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
				Новый ПараметрКомпоновкиДанных(Ключ));
			Если НайденноеЗначение <> Неопределено Тогда
				НайденноеЗначение.Использование = Истина;
				НайденноеЗначение.Значение       = ЗначениеПар;
			КонецЕсли;
			// Неизвестный параметр (НайденноеЗначение = Неопределено) — тихо пропускаем.
		Исключение
			// Несовместимый тип — предупреждение, не ошибка.
			Предупреждения.Добавить("parameter_skipped: " + Ключ);
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Основная логика get_print_form.

// Внутренняя реализация получения печатной формы. Выделена из ПолучитьПечатнуюФорму
// чтобы внешний Попытка/Исключение ловил любые непредвиденные ошибки.
//
// АРХИТЕКТУРНОЕ РЕШЕНИЕ (TOOL-14):
//   Вызов процедуры Печать() менеджера документа в общем случае требует динамического
//   вызова, который запрещён в AgentRunner. Вместо этого используем публичный API БСП:
//   УправлениеПечатью.СформироватьТабличныйДокумент(Макет, МассивОбъектов, ОбъектыПечати, КодЯзыка).
//   Метод инкапсулирует вызов Печать() менеджера через механизм подсистемы «Печать».
//   Если данный метод выбросит исключение (нет прав, RLS) — возвращаем access_denied.
//   [Реф: БСП/УправлениеПечатью] — СформироватьТабличныйДокумент, КомандыПечатиОбъектаДоступныеДляВложений.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM.
//  Контекст  - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ПолучитьПечатнуюФормуВнутр(Знач Аргументы, Знач Контекст)

	Аргс = РазобратьАргументы(Аргументы);

	// 1. Извлечь обязательный параметр ref.
	СтрокаСсылки = ПолучитьСтроку(Аргс, "ref");
	Если ПустаяСтрока(СтрокаСсылки) Тогда
		Возврат ОшибочныйJSON("ref_required");
	КонецЕсли;

	ШаблонПечати = ПолучитьСтроку(Аргс, "template");
	DryRun        = ar_ToolDispatcher.ИзвлечьDryRun(Аргументы);

	// 2. Разыменовать ссылку.
	Ссылка = Неопределено;
	// ОбъектИзНавигационнойСсылки может вернуть ссылку или объект.
	// Используем ОбщегоНазначения.ЭтоСсылка (БСП) для различения:
	//   Метаданные.НайтиПоТипу возвращает МД как для ДокументСсылка, так и для ДокументОбъект,
	//   поэтому он не подходит для определения ссылка/объект.
	// При любой ошибке разыменования — считаем объект не найденным.
	// [Реф: БСП/ОбщегоНазначения — ЭтоСсылка]
	Попытка
		ЗначениеСсылки = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
		Если ЗначениеСсылки = Неопределено Тогда
			Ссылка = Неопределено;
		ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеСсылки)) Тогда
			// Значение является ссылочным типом (ДокументСсылка, СправочникСсылка и т.д.).
			Ссылка = ЗначениеСсылки;
		Иначе
			// Значение является объектом (ДокументОбъект, СправочникОбъект и пр.) — берём его ссылку.
			Ссылка = ЗначениеСсылки.Ссылка;
		КонецЕсли;
	Исключение
		Ссылка = Неопределено;
	КонецПопытки;

	Если Ссылка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "object_not_found");
		Ошибка.Вставить("ref", СтрокаСсылки);
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 3. Найти метаданные объекта.
	МД = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если МД = Неопределено Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "object_not_found");
		Ошибка.Вставить("ref", СтрокаСсылки);
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 4. Защита объектов расширения (D4).
	Если Лев(ВРег(МД.Имя), 4) = "AOS_" Тогда
		Возврат ОшибочныйJSON("access_denied_to_extension_object");
	КонецЕсли;

	// 5. Получить список команд печати через БСП.
	КомандыПечати = Неопределено;
	Попытка
		КомандыПечати = УправлениеПечатью.КомандыПечатиОбъектаДоступныеДляВложений(МД);
	Исключение
		// Подсистема «Печать» недоступна — graceful.
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "print_form_not_found");
		Ошибка.Вставить("hint",
			НСтр("ru = 'Подсистема Печать недоступна в данной конфигурации';
			     |en = 'Print subsystem is not available in this configuration'"));
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецПопытки;

	Если КомандыПечати = Неопределено ИЛИ КомандыПечати.Количество() = 0 Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "print_form_not_found");
		Ошибка.Вставить("hint",
			НСтр("ru = 'Для данного типа объекта не зарегистрировано команд печати';
			     |en = 'No print commands registered for this object type'"));
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 6. Отобрать команды-кандидаты. Явно внешние (МенеджерПечати = подсистема
	// доп.обработок) отсеиваются сразу; но признак «внешняя/неработающая ПФ» по
	// полям структуры команды ненадёжен (пример: «ГарантийноеПисьмоВПФ» — внешняя
	// печатная форма демо-конфигурации, не помеченная менеджером доп.обработок),
	// поэтому дальше кандидаты ПРОБУЮТСЯ по порядку — побеждает первая команда,
	// чья печатная форма реально сформировалась.
	КандидатыКоманд = Новый Массив;
	Для Каждого Команда Из КомандыПечати Цикл
		Если ЭтоВнешняяКомандаПечати(Команда) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ШаблонПечати) И Команда.Идентификатор <> ШаблонПечати Тогда
			Продолжить;
		КонецЕсли;
		КандидатыКоманд.Добавить(Команда);
	КонецЦикла;

	Если КандидатыКоманд.Количество() = 0 Тогда
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "print_form_not_found");
		Ошибка.Вставить("hint",
			НСтр("ru = 'Нет внутренних (не внешних) команд печати для объекта';
			     |en = 'No internal print commands for object'"));
		Если Не ПустаяСтрока(ШаблонПечати) Тогда
			Ошибка.Вставить("template", ШаблонПечати);
		КонецЕсли;
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 7. Сформировать печатную форму через ПУБЛИЧНЫЙ API БСП (область
	// ПрограммныйИнтерфейс): НапечататьВФайл(Команда, СписокОбъектов, Настройки).
	// Команда передаётся ЦЕЛИКОМ — БСП сама ветвится по её МенеджерПечати
	// (СКД-печать / Печать() менеджера / внешние формы) тем же путём, что и UI.
	// Результат (MXL-файл) конвертируется обратно публичным
	// ТабличныйДокументПоДвоичнымДанным. Ручная сборка вызова служебного
	// СформироватьПечатныеФормы с подбором менеджера удалена — подмена менеджера
	// на имя объекта ломала все команды демо-базы (у менеджера демо-документа
	// нет процедуры Печать). [Реф: БСП/УправлениеПечатью — НапечататьВФайл,
	// НастройкиСохранения, ТабличныйДокументПоДвоичнымДанным]
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Ссылка);

	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	ФорматыСохранения = Новый Массив;
	ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.MXL);
	НастройкиСохранения.ФорматыСохранения = ФорматыСохранения;
	НастройкиСохранения.УпаковатьВАрхив = Ложь;

	ТабДок = Неопределено;
	ИмяШаблона = "";
	НеудавшиесяШаблоны = Новый Массив;
	ПоследняяОшибкаПечати = Неопределено;

	Для Каждого Команда Из КандидатыКоманд Цикл

		ФайлыПечати = Неопределено;
		Попытка
			ФайлыПечати = УправлениеПечатью.НапечататьВФайл(Команда, МассивОбъектов, НастройкиСохранения);
		Исключение
			ПоследняяОшибкаПечати = ИнформацияОбОшибке();
			НеудавшиесяШаблоны.Добавить(Команда.Идентификатор);
			Продолжить; // Пробуем следующую команду.
		КонецПопытки;

		Если ТипЗнч(ФайлыПечати) = Тип("ТаблицаЗначений") И ФайлыПечати.Количество() > 0 Тогда
			Попытка
				ТабДок = УправлениеПечатью.ТабличныйДокументПоДвоичнымДанным(
					ФайлыПечати[0].ДвоичныеДанные);
			Исключение
				ПоследняяОшибкаПечати = ИнформацияОбОшибке();
				ТабДок = Неопределено;
			КонецПопытки;
		КонецЕсли;

		Если ТабДок <> Неопределено Тогда
			ИмяШаблона = Команда.Идентификатор;
			Прервать;
		КонецЕсли;

		НеудавшиесяШаблоны.Добавить(Команда.Идентификатор);

	КонецЦикла;

	Если ТабДок = Неопределено Тогда
		// Все кандидаты не сформировались. Если было исключение — классифицируем
		// его (access_denied против print_error с реальным текстом); иначе — пустой
		// результат формирования. В обоих случаях перечисляем неудавшиеся шаблоны.
		Если ПоследняяОшибкаПечати <> Неопределено Тогда
			Возврат ДополнитьОшибкуСпискомШаблонов(
				КлассифицироватьОшибкуПечати(ПоследняяОшибкаПечати), НеудавшиесяШаблоны);
		КонецЕсли;
		Ошибка = Новый Структура;
		Ошибка.Вставить("error", "print_form_not_found");
		Ошибка.Вставить("failed_templates", НеудавшиесяШаблоны);
		Возврат ar_JSON.ВЗначениеJSON(Ошибка);
	КонецЕсли;

	// 8. Извлечь текст из ТабличногоДокумента.
	РезультатИзвлечения = ИзвлечьТекстТабДок(ТабДок);

	// 9. Сборка observation.
	Результат = Новый Структура;
	Результат.Вставить("ref",          СтрокаСсылки);
	Результат.Вставить("template",     ИмяШаблона);
	Результат.Вставить("content_type", РезультатИзвлечения.ТипКонтента);
	Результат.Вставить("content",      РезультатИзвлечения.Контент);
	Результат.Вставить("truncated",    Ложь);

	Если DryRun Тогда
		Результат.Вставить("dry_run", Истина);
	КонецЕсли;

	// 10. Ограничение размера (~100 KB).
	Возврат ОграничитьРазмерObservationПечать(Результат);

КонецФункции

// Извлечь текст из ТабличногоДокумента построчно.
// Определяет тип контента: "text" (однородные строки) или "table" (матрица ячеек).
//
// Параметры:
//  ТабДок - ТабличныйДокумент - результат формирования печатной формы.
//
// Возвращаемое значение:
//  Структура { ТипКонтента - "text"/"table", Контент - Строка/Массив }.
//
Функция ИзвлечьТекстТабДок(Знач ТабДок)

	Высота  = ТабДок.ВысотаТаблицы;
	Ширина  = ТабДок.ШиринаТаблицы;

	// Пустой документ.
	Если Высота = 0 ИЛИ Ширина = 0 Тогда
		Возврат Новый Структура("ТипКонтента, Контент", "text", "");
	КонецЕсли;

	МатрицаСтрок = Новый Массив; // Массив массивов строк для table.
	СтрокиТекста = Новый Массив; // Массив строк для text.
	ЕстьМультиколонки = Ложь;    // Признак: встречались строки с несколькими заполненными ячейками.

	Для НомерСтроки = 1 По Высота Цикл

		СтрокаМассив = Новый Массив;
		КоличествоЗаполненных = 0;
		ПервоеЗначение = "";

		Для НомерКолонки = 1 По Ширина Цикл
			Попытка
				Текст = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
			Исключение
				Текст = "";
			КонецПопытки;
			СтрокаМассив.Добавить(Текст);
			Если НЕ ПустаяСтрока(Текст) Тогда
				КоличествоЗаполненных = КоличествоЗаполненных + 1;
				Если КоличествоЗаполненных = 1 Тогда
					ПервоеЗначение = Текст;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		МатрицаСтрок.Добавить(СтрокаМассив);

		// Строка с более чем одной заполненной ячейкой → табличная форма.
		Если КоличествоЗаполненных > 1 Тогда
			ЕстьМультиколонки = Истина;
		КонецЕсли;

		// Для text-режима: берём первое непустое значение строки.
		СтрокиТекста.Добавить(ПервоеЗначение);

	КонецЦикла;

	Если ЕстьМультиколонки Тогда
		Возврат Новый Структура("ТипКонтента, Контент", "table", МатрицаСтрок);
	КонецЕсли;

	// Текстовый режим — объединить непустые строки через перенос строки.
	НепустыеСтроки = Новый Массив;
	Для Каждого Стр Из СтрокиТекста Цикл
		Если НЕ ПустаяСтрока(Стр) Тогда
			НепустыеСтроки.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	ТекстРезультата = СтрСоединить(НепустыеСтроки, Символы.ПС);

	Возврат Новый Структура("ТипКонтента, Контент", "text", ТекстРезультата);

КонецФункции

// Ограничивает observation печатной формы ~100 KB: при превышении помечает truncated.
// Для text — обрезает строку. Для table — удаляет строки с конца.
//
// Параметры:
//  Результат - Структура - сформированный результат get_print_form.
//
// Возвращаемое значение:
//  Строка JSON.
//
Функция ОграничитьРазмерObservationПечать(Знач Результат)

	КэпКБ = 100 * 1024;

	JSON = ar_JSON.ВЗначениеJSON(Результат);
	Если СтрДлина(JSON) <= КэпКБ Тогда
		Возврат JSON;
	КонецЕсли;

	// Превышен cap — обрезаем контент и помечаем truncated.
	ТипКонтента = Результат["content_type"];
	Контент     = Результат["content"];

	Если ТипКонтента = "table" И ТипЗнч(Контент) = Тип("Массив") Тогда
		// Бинарный поиск по строкам матрицы.
		Лево  = 0;
		Право = Контент.Количество() - 1;
		ЛучшийКандидат = 0;
		Пока Лево <= Право Цикл
			Середина = Цел((Лево + Право) / 2);
			КопияКандидата = СкопироватьСтруктуру(Результат);
			КопияКандидата.Вставить("content",   Контент.Скопировать(0, Середина));
			КопияКандидата.Вставить("truncated", Истина);
			ДлинаКандидата = СтрДлина(ar_JSON.ВЗначениеJSON(КопияКандидата));
			Если ДлинаКандидата <= КэпКБ Тогда
				ЛучшийКандидат = Середина;
				Лево = Середина + 1;
			Иначе
				Право = Середина - 1;
			КонецЕсли;
		КонецЦикла;
		Обрезанный = СкопироватьСтруктуру(Результат);
		Обрезанный.Вставить("content",   Контент.Скопировать(0, ЛучшийКандидат));
		Обрезанный.Вставить("truncated", Истина);
		Возврат ar_JSON.ВЗначениеJSON(Обрезанный);

	ИначеЕсли ТипКонтента = "text" И ТипЗнч(Контент) = Тип("Строка") Тогда
		// Обрезаем строку по cap с запасом на прочие поля (~512 байт служебных).
		МаксДлина = КэпКБ - 512;
		Если МаксДлина < 0 Тогда
			МаксДлина = 0;
		КонецЕсли;
		Обрезанный = СкопироватьСтруктуру(Результат);
		Обрезанный.Вставить("content",   Лев(Контент, МаксДлина));
		Обрезанный.Вставить("truncated", Истина);
		Возврат ar_JSON.ВЗначениеJSON(Обрезанный);
	Иначе
		// Неизвестный тип контента или нет контента — вернуть как есть с пометкой.
		Результат.Вставить("truncated", Истина);
		Возврат ar_JSON.ВЗначениеJSON(Результат);
	КонецЕсли;

КонецФункции

// Копирует Структуру (мелкое копирование ключей).
//
Функция СкопироватьСтруктуру(Знач Источник)
	Копия = Новый Структура;
	Для Каждого КлючЗначение Из Источник Цикл
		Копия.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Регистрация tool.

// Описание tool run_report для регистрации в ar_Tools.
//
Функция ОписаниеRunReport()

	Описание = Новый Структура;
	Описание.Вставить("Имя",           "run_report");
	Описание.Вставить("ИмяПроцедуры",  "ПрогонОтчёта");
	Описание.Вставить("ОбщийМодуль",   "ar_ToolОтчёты");
	Описание.Вставить("RiskLevel",     Перечисления.ar_RiskLevel.Read);
	Описание.Вставить("ТребуетApproval", Ложь);
	Описание.Вставить("Описание",
		НСтр("ru = 'Прогон варианта отчёта СКД, возвращает таблицу строк';
		     |en = 'Run a DCS report variant, returns table rows'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Сформировать отчёт: ОСВ, продажи, остатки и т.п.';
		     |en = 'Run a report: trial balance, sales, stock, etc.'"));
	Описание.Вставить("Манифест",      МанифестRunReport());
	Описание.Вставить("Версия",        "1.0.0");

	Возврат Описание;

КонецФункции

// JSON-манифест tool run_report для LLM.
//
Функция МанифестRunReport()

	Свойства = Новый Структура;

	СвойствоИмяОтчёта = Новый Структура;
	СвойствоИмяОтчёта.Вставить("type", "string");
	СвойствоИмяОтчёта.Вставить("description",
		НСтр("ru = 'Имя отчёта в метаданных конфигурации (например ОстаткиТоваров, ДебиторскаяЗадолженность)';
		     |en = 'Report name in configuration metadata (e.g. ОстаткиТоваров, ДебиторскаяЗадолженность)'"));

	СвойствоВариант = Новый Структура;
	СвойствоВариант.Вставить("type", "string");
	СвойствоВариант.Вставить("description",
		НСтр("ru = '(опц.) Имя варианта СКД. При отсутствии — используется вариант по умолчанию из схемы';
		     |en = '(opt.) DCS variant name. If absent - default variant from schema is used'"));

	СвойствоПараметры = Новый Структура;
	СвойствоПараметры.Вставить("type", "object");
	СвойствоПараметры.Вставить("description",
		НСтр("ru = '(опц.) Параметры СКД в виде объекта: {ИмяПараметра: значение}. Значения: строки/числа/булево';
		     |en = '(opt.) DCS parameters as object: {ParameterName: value}. Values: strings/numbers/booleans'"));

	СвойствоЛимит = Новый Структура;
	СвойствоЛимит.Вставить("type", "integer");
	СвойствоЛимит.Вставить("description",
		НСтр("ru = '(опц.) Максимальное количество строк результата. Деф. 100, макс. 500';
		     |en = '(opt.) Maximum result rows. Default 100, max 500'"));

	Свойства.Вставить("report_name", СвойствоИмяОтчёта);
	Свойства.Вставить("variant",     СвойствоВариант);
	Свойства.Вставить("parameters",  СвойствоПараметры);
	Свойства.Вставить("limit",       СвойствоЛимит);

	Обязательные = Новый Массив;
	Обязательные.Добавить("report_name");

	Параметры = Новый Структура;
	Параметры.Вставить("type",       "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required",   Обязательные);

	Возврат ОбернутьВOpenAIФормат("run_report",
		НСтр("ru = 'Прогон варианта отчёта СКД из конфигурации. Возвращает таблицу с заголовком столбцов и строками данных.';
		     |en = 'Run a DCS report variant from the configuration. Returns a table with column headers and data rows.'"),
		Параметры);

КонецФункции

