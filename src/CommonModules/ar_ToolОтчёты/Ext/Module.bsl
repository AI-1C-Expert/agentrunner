		     |en = 'Get document print form. Returns text or table content of the layout suitable for analysis.'"),
		Параметры);

КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
// Формат обязателен для всех LLM-провайдеров (OpenAI-совместимые API, включая
// локальные - LM Studio и т.п.) - без обёртки провайдер возвращает 400 на
// список tools (см. ar_ToolUniversal.МанифестTool - образец контракта).
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)
	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", Имя);
	ФункцияОписание.Вставить("description", Описание);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);
	Возврат ar_JSON.ВЗначениеJSON(Манифест);
КонецФункции

// Регистрирует или обновляет одну запись tool в ar_Tools.
// Ключ идемпотентности — ar_Имя. Существующая запись обновляется целиком
// (кроме пользовательских полей, не входящих в контракт модуля).
//
Процедура ЗарегистрироватьОдинИнструмент(Знач Описание, Статистика)

	ИмяTool = Описание.Имя;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", ИмяTool);

	Выборка = Запрос.Выполнить().Выбрать();

	НачатьТранзакцию();
	Попытка

		Если Выборка.Следующий() Тогда
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Статистика.Обновлено = Статистика.Обновлено + 1;
		Иначе
			Объект = Справочники.ar_Tools.СоздатьЭлемент();
			Статистика.Создано = Статистика.Создано + 1;
		КонецЕсли;

		Объект.Наименование           = ИмяTool;
		Объект.ar_Имя                = ИмяTool;
		Объект.ar_ОбщийМодуль        = Описание.ОбщийМодуль;
		Объект.ar_ИмяПроцедуры       = Описание.ИмяПроцедуры;
		Объект.ar_Описание           = Описание.Описание;
		Объект.ar_КраткоеОписание     = Описание.КраткоеОписание;
		Объект.ar_JSONManifest        = Описание.Манифест;
		Объект.ar_RiskLevel           = Описание.RiskLevel;
		Объект.ar_ТребуетApproval     = Описание.ТребуетApproval;
		Объект.ar_Включён             = Истина;
		Объект.ar_Версия              = Описание.Версия;
		Объект.ar_ИсточникРасширение  = "";
		Объект.Записать();

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Разбор аргументов (локальные копии универсальных хелперов).

// Десериализует JSON-аргументы в Соответствие. Пустые/некорректные → пустое.
Функция РазобратьАргументы(Знач Аргументы)
	Значение = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Новый Соответствие;
КонецФункции

// Читает строковое поле из Соответствие аргументов; не-строка → "".
Функция ПолучитьСтроку(Знач Аргс, Знач Ключ)
	Значение = Аргс.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

// Читает числовое поле из Соответствие аргументов; не-число → ЗначениеПоУмолчанию.
Функция ПолучитьЧисло(Знач Аргс, Знач Ключ, Знач ЗначениеПоУмолчанию)
	Значение = Аргс.Получить(Ключ);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Приводит значение к диапазону [Мин..Макс]; вне диапазона/не-число → ПоУмолчанию.
Функция НормализоватьЛимит(Знач Значение, Знач Мин, Знач Макс, Знач ПоУмолчанию)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Цел = Цел(Значение);
	Если Цел < Мин ИЛИ Цел > Макс Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Цел;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Формирование observation.

// JSON-строка ошибки-observation: {"error":"<код>"}.
Функция ОшибочныйJSON(Знач КодОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(КодОшибки) = Тип("Строка"), КодОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""internal""}", Результат);
КонецФункции

// Формирует observation ошибки из информации об исключении.
Функция ОшибкаTool(Знач ИнфоОбОшибке)
	ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнфоОбОшибке));
	Объект = Новый Структура;
	Объект.Вставить("error",  "tool_error");
	Объект.Вставить("detail", ТекстОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// Дополнить готовую JSON-ошибку списком неудавшихся шаблонов печати
// (failed_templates). При ошибке разбора возвращает исходный JSON как есть.
//
Функция ДополнитьОшибкуСпискомШаблонов(Знач JSONОшибки, Знач Шаблоны)

	Если Шаблоны.Количество() = 0 Тогда
		Возврат JSONОшибки;
	КонецЕсли;

	Разобранное = ar_JSON.ИзJSON(JSONОшибки);
	Если ТипЗнч(Разобранное) <> Тип("Соответствие") Тогда
		Возврат JSONОшибки;
	КонецЕсли;

	Разобранное.Вставить("failed_templates", Шаблоны);
	Результат = ar_JSON.ВЗначениеJSON(Разобранное);
	Возврат ?(ПустаяСтрока(Результат), JSONОшибки, Результат);

КонецФункции

// Истина, если команда печати относится к ВНЕШНЕЙ печатной форме (менеджер
// печати — подсистема ДополнительныеОтчетыИОбработки). Такие команды нельзя
// печатать через СформироватьПечатныеФормы с менеджером-объектом.
Функция ЭтоВнешняяКомандаПечати(Знач Команда)
	Попытка
		Возврат СтрНайти(НРег(Строка(Команда.МенеджерПечати)), "дополнительныеотчетыиобработки") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Классифицировать исключение формирования печати: реальный отказ доступа (RLS)
// vs иная ошибка печати (макет обращается к отсутствующим реквизитам целевой
// конфигурации). Раньше всё маскировалось под access_denied, скрывая причину.
Функция КлассифицироватьОшибкуПечати(Знач ИнфоОбОшибке, Знач КодОшибки = "print_error")
	ТекстПодробно = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
	ТекстНРег = НРег(ТекстПодробно);
	ПризнакиДоступа = "право доступа,недостаточно прав,access,rls,запрещено выполнять";
	Для Каждого Признак Из СтрРазделить(ПризнакиДоступа, ",") Цикл
		Если СтрНайти(ТекстНРег, СокрЛП(Признак)) > 0 Тогда
			Возврат ОшибочныйJSON("access_denied");
		КонецЕсли;
	КонецЦикла;
	// Иначе — реальный (очищенный) текст ошибки с указанным кодом.
	Объект = Новый Структура;
	Объект.Вставить("error",  КодОшибки);
	Объект.Вставить("detail", ar_Утилиты.ОчиститьОшибкуДляLLM(ТекстПодробно));
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// Ограничивает observation ~100 KB: при превышении помечает усечение.
// Возвращает строку JSON.
//
Функция ОграничитьРазмерObservation(Знач Результат)

	КэпКБ = 100 * 1024;

	JSON = ar_JSON.ВЗначениеJSON(Результат);
	Если СтрДлина(JSON) <= КэпКБ Тогда
		Возврат JSON;
	КонецЕсли;

	// Превышен cap — урезаем строки, оставляем служебные поля.
	Строки = Результат["rows"];
	Если ТипЗнч(Строки) = Тип("Массив") Тогда
		// Бинарный поиск подходящего числа строк для уложения в cap.
		// ЛучшийКандидат хранит последнее количество строк, которое ВОШЛО в cap.
		// Верхняя граница — Количество()-1, т.к. все N строк заведомо не влезают
		// (мы попадаем сюда только при СтрДлина(JSON) > КэпКБ с полным массивом).
		Лево  = 0;
		Право = Строки.Количество() - 1;
		ЛучшийКандидат = 0;
		Пока Лево <= Право Цикл
			Середина = Цел((Лево + Право) / 2);
			КопияКандидата = ОбрезатьСтроки(Результат, Строки, Середина);
			ДлинаКандидата = СтрДлина(ar_JSON.ВЗначениеJSON(КопияКандидата));
			Если ДлинаКандидата <= КэпКБ Тогда
				ЛучшийКандидат = Середина;  // этот размер помещается
				Лево = Середина + 1;         // ищем, можно ли взять больше
			Иначе
				Право = Середина - 1;        // слишком большой — уменьшаем
			КонецЕсли;
		КонецЦикла;
		// ЛучшийКандидат — точное количество строк, при котором JSON <= КэпКБ.
		Обрезанный = ОбрезатьСтроки(Результат, Строки, ЛучшийКандидат);
		Возврат ar_JSON.ВЗначениеJSON(Обрезанный);
	КонецЕсли;

	// Нет строк — вернуть как есть с пометкой size_limited.
	Результат.Вставить("size_limited", Истина);
	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Вернуть копию результата с усечёнными строками до НужноСтрок.
// Все поля оригинала сохраняются (включая warnings, dry_run и пр.);
// rows заменяется обрезанным массивом, truncated принудительно Истина.
//
Функция ОбрезатьСтроки(Знач Результат, Знач ВсеСтроки, Знач НужноСтрок)

	// Скопировать(Начало, Количество) — безопасен при НужноСтрок=0 (вернёт пустой массив).
	НовыеСтроки = ВсеСтроки.Скопировать(0, НужноСтрок);

	// Копируем все ключи оригинала, затем перезаписываем rows и truncated.
	КопияРезультата = Новый Структура;
	Для Каждого КлючЗначение Из Результат Цикл
		КопияРезультата.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	КопияРезультата.Вставить("rows",      НовыеСтроки);
	КопияРезультата.Вставить("truncated", Истина);

	Возврат КопияРезультата;

КонецФункции

#КонецОбласти
