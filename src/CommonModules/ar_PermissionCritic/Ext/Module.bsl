////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_PermissionCritic (PermissionCritic / LLM-критик разрешений).
//
// LLM-критик для граничных случаев permission engine (PERM-04).
// Вызывается из ar_PermissionEngine.ВыполнитьПроверки на уровне L5, когда:
//   * флаг ar_Константы.ВключитьCriticLLM() = Истина;
//   * результат L4 "approval_required" с мягкой причиной (граничный случай);
//   * КонтекстЗапуска.DryRun = Ложь.
//
// Критик запрашивает у LLM финальный вердикт: ALLOW / DENY / APPROVAL_REQUIRED.
// Любая ошибка деградирует в исходное решение движка (fail-safe: ошибка
// критика не улучшает исходное решение).
//
// Граничные случаи (ЭтоГраничныйСлучай):
//   "manual_mode_non_read_action"     - manual-режим, action не read
//   "auto_threshold_high_risk"        - auto_threshold, action write/commit
//   "commit_always_requires_approval" - autonomous, action commit
//
// Свойства модуля: Сервер, НеГлобальный, Привилегированный = Ложь,
// ReturnValuesReuse = DontUse.
//
// Запрещено: Выполнить(), Вычислить(), УстановитьПривилегированныйРежим(),
//             прямое обращение к БезопасноеХранилище.
//
// Зависимости: ar_LLMДиспетчер, ar_Константы, ar_AuditСобытия, ar_JSON,
//              ar_Утилиты.
//
// См. спеку: .docs/specs/PERM-04.md, Plan §2.8.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Уточнить решение permission engine с помощью LLM-критика.
//
// Вызывается из ar_PermissionEngine (уровень L5) только когда флаг включён,
// решение является граничным случаем и DryRun = Ложь.
//
// Параметры:
//   ДанныеАгента     - Структура - {Ссылка, ИмяРоли1С, РежимАвтономии,
//                                   МаксДействий, МаксСуммаДействия,
//                                   LLMПровайдер, Модель, Температура, ...}.
//   Действие         - Структура - {Имя, ИдВызова, Аргументы}.
//   КонтекстЗапуска  - Структура - {RunId, Агент, РежимАвтономии, DryRun,
//                                   Sequence, ...}.
//   ИсходноеРешение  - Структура - результат ar_PermissionEngine.РазрешитьДействие:
//                                   {Решение, Причина, RiskLevel, СсылкаTool}.
//
// Возвращаемое значение:
//   Структура - {Решение: "allow"|"deny"|"approval_required", Причина: Строка,
//                RiskLevel: ПеречислениеСсылка.ar_RiskLevel|Неопределено,
//                СсылкаTool: СправочникСсылка.ar_Tools|Неопределено}.
//
// При любой ошибке (LLM недоступен, таймаут, невалидный JSON, исключение)
// возвращается ИсходноеРешение без изменений; факт ошибки фиксируется в аудите.
//
Функция Уточнить(ДанныеАгента, Действие, КонтекстЗапуска, ИсходноеРешение) Экспорт

	// Защита от пустого провайдера: критик без провайдера не работает.
	LLMПровайдер = Неопределено;
	Если Не ДанныеАгента.Свойство("LLMПровайдер", LLMПровайдер)
		Или Не ЗначениеЗаполнено(LLMПровайдер) Тогда
		ЗафиксироватьВызовCritic(КонтекстЗапуска, Неопределено, ИсходноеРешение, 0,
			"critic_skipped", НСтр("ru = 'провайдер не задан у агента';
				|en = 'agent LLM provider is not configured'"));
		Возврат ИсходноеРешение;
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка

		КонтекстCritic = СформироватьКонтекстCritic(ДанныеАгента, Действие, КонтекстЗапуска, ИсходноеРешение);
		РезультатLLM   = ar_LLMДиспетчер.Вызвать(КонтекстCritic);

		Если Не РезультатLLM.Успех Тогда
			ТекстОш = ar_Утилиты.ОчиститьОшибкуДляLLM(РезультатLLM.Ошибка);
			ЗафиксироватьВызовCritic(КонтекстЗапуска, Неопределено, ИсходноеРешение,
				ЛатентностьМс(НачалоМс), "critic_failed", ТекстОш);
			Возврат ИсходноеРешение;
		КонецЕсли;

		ВердиктCritic = РазобратьОтветCritic(РезультатLLM.Сообщение, КонтекстЗапуска, ИсходноеРешение);
		Если ВердиктCritic = Неопределено Тогда
			// РазобратьОтветCritic уже зафиксировал critic_parse_error.
			Возврат ИсходноеРешение;
		КонецЕсли;

		ЗафиксироватьВызовCritic(КонтекстЗапуска, ВердиктCritic, ИсходноеРешение,
			ЛатентностьМс(НачалоМс), "critic_called", "");

		Возврат СформироватьРезультат(ВердиктCritic, ИсходноеРешение);

	Исключение

		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗафиксироватьВызовCritic(КонтекстЗапуска, Неопределено, ИсходноеРешение,
			ЛатентностьМс(НачалоМс), "critic_failed", ТекстОшибки);
		Возврат ИсходноеРешение;

	КонецПопытки;

КонецФункции

// Определить, является ли результат L4 граничным случаем для LLM-критика.
//
// Граничными считаются причины из матрицы РежимАвтономии x RiskLevel.
// tool_requires_approval - не граничный: это hard-запрет, tool-level policy
// приоритетнее мнения LLM.
//
// Параметры:
//   РезультатL4 - Структура - {Решение, Причина, RiskLevel, СсылкаTool}.
//
// Возвращаемое значение:
//   Булево - Истина, если критик должен быть вызван.
//
Функция ЭтоГраничныйСлучай(РезультатL4) Экспорт

	Если ТипЗнч(РезультатL4) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Причина = "";
	Если Не РезультатL4.Свойство("Причина", Причина) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Белый список граничных случаев: только матричные причины L4.
	ГраничныеПричины = Новый Соответствие;
	ГраничныеПричины.Вставить("manual_mode_non_read_action",     Истина);
	ГраничныеПричины.Вставить("auto_threshold_high_risk",        Истина);
	ГраничныеПричины.Вставить("commit_always_requires_approval", Истина);

	Возврат ГраничныеПричины.Получить(Причина) = Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сформировать структуру Контекст для ar_LLMДиспетчер.Вызвать.
//
// Параметры:
//   ДанныеАгента     - Структура
//   Действие         - Структура
//   КонтекстЗапуска  - Структура
//   ИсходноеРешение  - Структура
//
// Возвращаемое значение:
//   Структура
//
Функция СформироватьКонтекстCritic(ДанныеАгента, Действие, КонтекстЗапуска, ИсходноеРешение)

	СообщенияCritic = Новый Массив;

	СистемноеСообщение = Новый Структура;
	СистемноеСообщение.Вставить("role",    "system");
	СистемноеСообщение.Вставить("content", ПостроитьСистемноеСообщение());
	СообщенияCritic.Добавить(СистемноеСообщение);

	ТекстПользователя = ПостроитьПользовательскоеСообщение(
		ДанныеАгента, Действие, КонтекстЗапуска, ИсходноеРешение);
	ПользовательскоеСообщение = Новый Структура;
	ПользовательскоеСообщение.Вставить("role",    "user");
	ПользовательскоеСообщение.Вставить("content", ТекстПользователя);
	СообщенияCritic.Добавить(ПользовательскоеСообщение);

	КонтекстCritic = Новый Структура;
	КонтекстCritic.Вставить("Провайдер",   ДанныеАгента.LLMПровайдер);

	МодельАгента = "";
	ДанныеАгента.Свойство("Модель", МодельАгента);
	Если Не ПустаяСтрока(МодельАгента) Тогда
		КонтекстCritic.Вставить("Модель", МодельАгента);
	КонецЕсли;

	КонтекстCritic.Вставить("Температура", 0);    // детерминированный вывод
	КонтекстCritic.Вставить("МаксТокенов", 200);  // вердикт короткий
	КонтекстCritic.Вставить("МаксПопыток", 2);    // 1 retry при сбое
	КонтекстCritic.Вставить("Сообщения",   СообщенияCritic);
	// Tools не передаются: критик работает как text-completion, не tool-calling.

	Возврат КонтекстCritic;

КонецФункции

// Сформировать system message критика.
// Не меняется между вызовами: пригоден для prompt caching.
//
// Возвращаемое значение:
//   Строка
//
Функция ПостроитьСистемноеСообщение()

	Возврат НСтр(
		"ru = 'Ты - критик системы permission control для 1С-агентов AgentRunner.
		|Тебе поступает запрос на выполнение действия агентом, который движок разрешений
		|предварительно квалифицировал как требующий подтверждения (approval_required).
		|Твоя задача: проанализировать действие в контексте запуска и вынести финальный
		|вердикт из трёх вариантов:
		|
		|ALLOW - действие безопасно выполнить автономно (нет рисков, аргументы корректны,
		|         контекст соответствует норме для данного агента)
		|DENY  - действие явно опасно или некорректно (нарушает смысл задачи агента,
		|         аргументы подозрительны, явная ошибка LLM)
		|APPROVAL_REQUIRED - оставить на ручное подтверждение оператора
		|
		|Отвечай ТОЛЬКО в формате JSON без markdown-обёртки:
		|{""verdict"": ""ALLOW""|""DENY""|""APPROVAL_REQUIRED"", ""reason"": ""<одна строка, до 200 символов>""}
		|
		|Если не уверен - выбирай APPROVAL_REQUIRED, не ALLOW.
		|Ошибочный ALLOW хуже ошибочного APPROVAL_REQUIRED.';
		|en = 'You are a permission control critic for 1C AgentRunner agents.
		|You receive an action request that the permission engine has pre-qualified
		|as requiring approval (approval_required).
		|Your task: analyze the action in the launch context and issue a final verdict
		|from three options:
		|
		|ALLOW - the action is safe to execute autonomously (no risks, arguments are correct,
		|         context matches the norm for this agent)
		|DENY  - the action is clearly dangerous or incorrect (violates the agent purpose,
		|         arguments are suspicious, obvious LLM error)
		|APPROVAL_REQUIRED - leave for manual operator confirmation
		|
		|Respond ONLY in JSON format without markdown wrapper:
		|{""verdict"": ""ALLOW""|""DENY""|""APPROVAL_REQUIRED"", ""reason"": ""<one line, up to 200 chars>""}
		|
		|When in doubt - choose APPROVAL_REQUIRED, not ALLOW.
		|A wrong ALLOW is worse than a wrong APPROVAL_REQUIRED.'");

КонецФункции

// Сформировать user message с деталями действия.
//
// Параметры:
//   ДанныеАгента     - Структура
//   Действие         - Структура
//   КонтекстЗапуска  - Структура
//   ИсходноеРешение  - Структура
//
// Возвращаемое значение:
//   Строка
//
Функция ПостроитьПользовательскоеСообщение(ДанныеАгента, Действие, КонтекстЗапуска, ИсходноеРешение)

	МаксДлинаИнструкции = 500;
	МаксДлинаАргументов = 2000;

	НаименованиеАгента = ИзвлечьНаименованиеАгента(ДанныеАгента);

	РежимАвтономии = "";
	ДанныеАгента.Свойство("РежимАвтономии", РежимАвтономии);

	ИнструкцияАгента = "";
	ДанныеАгента.Свойство("Инструкция", ИнструкцияАгента);
	Если ТипЗнч(ИнструкцияАгента) = Тип("Строка") И СтрДлина(ИнструкцияАгента) > МаксДлинаИнструкции Тогда
		ИнструкцияАгента = Лев(ИнструкцияАгента, МаксДлинаИнструкции);
	КонецЕсли;

	ИмяTool = ИзвлечьИмяТулИзДействия(Действие);
	RiskLevelСтрока = ИзвлечьRiskLevelСтроку(ИсходноеРешение);
	АргументыТекст  = ПодготовитьАргументы(Действие, МаксДлинаАргументов);

	RunIdСтрока = "";
	КонтекстЗапуска.Свойство("RunId", RunIdСтрока);

	SequenceЗначение = 0;
	КонтекстЗапуска.Свойство("Sequence", SequenceЗначение);

	ИсходнаяПричина = "";
	ИсходноеРешение.Свойство("Причина", ИсходнаяПричина);

	Сообщение =
		НСтр("ru = 'Агент: '")              + НаименованиеАгента           + Символы.ПС
		+ НСтр("ru = 'Режим автономии: '")  + Строка(РежимАвтономии)       + Символы.ПС;

	Если Не ПустаяСтрока(ИнструкцияАгента) Тогда
		Сообщение = Сообщение
			+ НСтр("ru = 'Инструкция агента (первые 500 символов): '")
			+ ИнструкцияАгента + Символы.ПС;
	КонецЕсли;

	Сообщение = Сообщение
		+ Символы.ПС
		+ НСтр("ru = 'Действие: '")               + ИмяTool                          + Символы.ПС
		+ НСтр("ru = 'Risk level: '")              + RiskLevelСтрока                  + Символы.ПС
		+ НСтр("ru = 'Аргументы действия:'")       + Символы.ПС
		+ АргументыТекст                           + Символы.ПС
		+ Символы.ПС
		+ НСтр("ru = 'RunId: '")                   + RunIdСтрока                      + Символы.ПС
		+ НСтр("ru = 'Шаг запуска: '")             + Строка(SequenceЗначение)         + Символы.ПС
		+ Символы.ПС
		+ НСтр("ru = 'Исходное решение движка: '") + ИсходнаяПричина                  + Символы.ПС
		+ Символы.ПС
		+ НСтр("ru = 'Вынеси финальный вердикт.'");

	Возврат Сообщение;

КонецФункции

// Извлечь наименование агента из данных.
//
// Параметры:
//   ДанныеАгента - Структура
//
// Возвращаемое значение:
//   Строка
//
Функция ИзвлечьНаименованиеАгента(ДанныеАгента)

	НаименованиеАгента = "";
	Если ДанныеАгента.Свойство("Наименование") Тогда
		НаименованиеАгента = СокрЛП(Строка(ДанныеАгента.Наименование));
	КонецЕсли;

	Если ПустаяСтрока(НаименованиеАгента) Тогда
		Ссылка = Неопределено;
		Если ДанныеАгента.Свойство("Ссылка", Ссылка) И ЗначениеЗаполнено(Ссылка) Тогда
			НаименованиеАгента = СокрЛП(Строка(Ссылка));
		КонецЕсли;
	КонецЕсли;

	Возврат НаименованиеАгента;

КонецФункции

// Извлечь имя tool из структуры действия.
//
// Параметры:
//   Действие - Структура
//
// Возвращаемое значение:
//   Строка
//
Функция ИзвлечьИмяТулИзДействия(Действие)

	ИмяTool = "";
	Действие.Свойство("Имя", ИмяTool);
	Если ПустаяСтрока(ИмяTool) Тогда
		Действие.Свойство("name", ИмяTool);
	КонецЕсли;
	Возврат ИмяTool;

КонецФункции

// Получить строковое представление RiskLevel из исходного решения.
//
// Параметры:
//   ИсходноеРешение - Структура
//
// Возвращаемое значение:
//   Строка
//
Функция ИзвлечьRiskLevelСтроку(ИсходноеРешение)

	РискЗначение = Неопределено;
	Если ИсходноеРешение.Свойство("RiskLevel", РискЗначение) И ЗначениеЗаполнено(РискЗначение) Тогда
		Возврат Строка(РискЗначение);
	КонецЕсли;
	Возврат "";

КонецФункции

// Подготовить строку аргументов для user message.
// Маскирует секреты, обрезает до указанного лимита.
//
// Параметры:
//   Действие      - Структура
//   МаксДлина     - Число
//
// Возвращаемое значение:
//   Строка
//
Функция ПодготовитьАргументы(Действие, МаксДлина)

	АргументыJSON = "";
	Действие.Свойство("Аргументы", АргументыJSON);
	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Тогда
		АргументыJSON = ar_JSON.ВЗначениеJSON(АргументыJSON);
	КонецЕсли;
	// Не ОчиститьОшибкуДляLLM: та функция обрезает до 500 символов внутри себя,
	// что срабатывает раньше и вместо МаксДлина (может быть больше 500) -
	// здесь нужна только маскировка секретов, обрезка - явно ниже своим лимитом.
	АргументыJSON = ar_Утилиты.МаскироватьСекреты(АргументыJSON);

	Если СтрДлина(АргументыJSON) > МаксДлина Тогда
		АргументыJSON = Лев(АргументыJSON, МаксДлина) + " [truncated]";
	КонецЕсли;

	Возврат АргументыJSON;

КонецФункции

// Разобрать ответ LLM-критика и получить вердикт.
// При невалидном JSON или неизвестном вердикте фиксирует critic_parse_error и
// возвращает Неопределено; вызывающий код вернёт ИсходноеРешение.
//
// Параметры:
//   СообщениеLLM    - Структура - сообщение ответа LLM (role, content).
//   КонтекстЗапуска - Структура
//   ИсходноеРешение - Структура
//
// Возвращаемое значение:
//   Структура {Вердикт, Резон} или Неопределено при ошибке парсинга.
//
Функция РазобратьОтветCritic(СообщениеLLM, КонтекстЗапуска, ИсходноеРешение)

	МаксДлинаRaw    = 500;
	МаксДлинаРезон  = 300;

	// Извлечь содержимое сообщения.
	СодержимоеСообщения = "";
	Если Не ИзвлечьСодержимоеLLM(СообщениеLLM, СодержимоеСообщения) Тогда
		Возврат ЗафиксироватьОшибкуПарсинга(КонтекстЗапуска, СообщениеLLM, МаксДлинаRaw);
	КонецЕсли;

	// Найти JSON-блок внутри текста.
	JSONСтрока = ИзвлечьJSONБлок(СодержимоеСообщения);
	Если ПустаяСтрока(JSONСтрока) Тогда
		Возврат ЗафиксироватьОшибкуПарсинга(КонтекстЗапуска, СообщениеLLM, МаксДлинаRaw);
	КонецЕсли;

	// Разобрать JSON.
	ОтветJSON = ar_JSON.ИзJSON(JSONСтрока);
	Если ОтветJSON = Неопределено Тогда
		Возврат ЗафиксироватьОшибкуПарсинга(КонтекстЗапуска, СообщениеLLM, МаксДлинаRaw);
	КонецЕсли;

	// Прочитать и валидировать вердикт.
	ВердиктСтрока = "";
	Если Не ОтветJSON.Свойство("verdict", ВердиктСтрока) Тогда
		Возврат ЗафиксироватьОшибкуПарсинга(КонтекстЗапуска, СообщениеLLM, МаксДлинаRaw);
	КонецЕсли;
	ВердиктСтрока = ВРег(СокрЛП(Строка(ВердиктСтрока)));
	Если Не ЭтоДопустимыйВердикт(ВердиктСтрока) Тогда
		Возврат ЗафиксироватьОшибкуПарсинга(КонтекстЗапуска, СообщениеLLM, МаксДлинаRaw);
	КонецЕсли;

	РезонCritic = "";
	Если ОтветJSON.Свойство("reason", РезонCritic) Тогда
		РезонCritic = СокрЛП(Строка(РезонCritic));
		Если СтрДлина(РезонCritic) > МаксДлинаРезон Тогда
			РезонCritic = Лев(РезонCritic, МаксДлинаРезон);
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Вердикт", ВердиктСтрока);
	Результат.Вставить("Резон",   РезонCritic);
	Возврат Результат;

КонецФункции

// Проверить, входит ли значение вердикта в допустимый набор.
//
// Параметры:
//   Вердикт - Строка - значение в верхнем регистре.
//
// Возвращаемое значение:
//   Булево - Истина, если вердикт входит в набор ALLOW, DENY, APPROVAL_REQUIRED.
//
Функция ЭтоДопустимыйВердикт(Вердикт)

	Возврат Вердикт = "ALLOW"
		Или Вердикт = "DENY"
		Или Вердикт = "APPROVAL_REQUIRED";

КонецФункции

// Безопасно извлечь строковое содержимое из сообщения LLM.
//
// Параметры:
//   СообщениеLLM         - Структура
//   СодержимоеСообщения  - Строка - возвращаемый параметр.
//
// Возвращаемое значение:
//   Булево - Истина если извлечение успешно.
//
Функция ИзвлечьСодержимоеLLM(СообщениеLLM, СодержимоеСообщения)

	Если ТипЗнч(СообщениеLLM) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	СодержимоеСообщения = "";
	Если Не СообщениеLLM.Свойство("content", СодержимоеСообщения) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(СодержимоеСообщения) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Извлечь первый JSON-объект из произвольного текста (от { до }).
//
// Параметры:
//   Текст - Строка
//
// Возвращаемое значение:
//   Строка - JSON-блок или "" если не найден.
//
Функция ИзвлечьJSONБлок(Текст)

	ПозНачало = СтрНайти(Текст, "{");
	Если ПозНачало = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПозКонец = 0;
	Инд = СтрДлина(Текст);
	Пока Инд >= ПозНачало Цикл
		Если Сред(Текст, Инд, 1) = "}" Тогда
			ПозКонец = Инд;
			Инд = 0;
		Иначе
			Инд = Инд - 1;
		КонецЕсли;
	КонецЦикла;

	Если ПозКонец = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(Текст, ПозНачало, ПозКонец - ПозНачало + 1);

КонецФункции

// Зафиксировать ошибку парсинга ответа критика и вернуть Неопределено.
// Всегда возвращает Неопределено - вызывающий код вернёт ИсходноеРешение.
//
// Параметры:
//   КонтекстЗапуска - Структура
//   СообщениеLLM    - Произвольный
//   МаксДлинаRaw    - Число
//
// Возвращаемое значение:
//   Неопределено - всегда.
//
Функция ЗафиксироватьОшибкуПарсинга(КонтекстЗапуска, СообщениеLLM, МаксДлинаRaw)

	RawResponse = "";
	Если ТипЗнч(СообщениеLLM) = Тип("Структура") Тогда
		СообщениеLLM.Свойство("content", RawResponse);
		Если ТипЗнч(RawResponse) = Тип("Строка") И СтрДлина(RawResponse) > МаксДлинаRaw Тогда
			RawResponse = Лев(RawResponse, МаксДлинаRaw);
		КонецЕсли;
	КонецЕсли;

	PayloadОшибки = Новый Структура;
	PayloadОшибки.Вставить("raw_response", RawResponse);

	RunId = "";
	КонтекстЗапуска.Свойство("RunId", RunId);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "critic_parse_error", PayloadОшибки);
	Возврат Неопределено;

КонецФункции

// Сформировать итоговую структуру результата по вердикту критика.
// RiskLevel и СсылкаTool берутся из ИсходноеРешение без изменения.
//
// Параметры:
//   ВердиктCritic   - Структура - {Вердикт, Резон}.
//   ИсходноеРешение - Структура
//
// Возвращаемое значение:
//   Структура {Решение, Причина, RiskLevel, СсылкаTool}
//
Функция СформироватьРезультат(ВердиктCritic, ИсходноеРешение)

	RiskLevel  = Неопределено;
	СсылкаTool = Неопределено;
	ИсходноеРешение.Свойство("RiskLevel",  RiskLevel);
	ИсходноеРешение.Свойство("СсылкаTool", СсылкаTool);

	Результат = Новый Структура;
	Результат.Вставить("RiskLevel",  RiskLevel);
	Результат.Вставить("СсылкаTool", СсылкаTool);

	Вердикт = ВердиктCritic.Вердикт;
	Резон    = ВердиктCritic.Резон;

	Если Вердикт = "ALLOW" Тогда
		Результат.Вставить("Решение", "allow");
		Результат.Вставить("Причина",
			НСтр("ru = 'critic_approved: '; en = 'critic_approved: '") + Резон);
	ИначеЕсли Вердикт = "DENY" Тогда
		Результат.Вставить("Решение", "deny");
		Результат.Вставить("Причина",
			НСтр("ru = 'critic_denied: '; en = 'critic_denied: '") + Резон);
	Иначе
		// APPROVAL_REQUIRED: оставляем оригинальную причину движка.
		ИсходнаяПричина = "";
		ИсходноеРешение.Свойство("Причина", ИсходнаяПричина);
		Результат.Вставить("Решение", "approval_required");
		Результат.Вставить("Причина", ИсходнаяПричина);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Зафиксировать факт вызова/пропуска/ошибки критика в аудите.
//
// Параметры:
//   КонтекстЗапуска  - Структура - контекст запуска агента.
//   ВердиктCritic    - Структура, Неопределено - разобранный вердикт или Неопределено.
//   ИсходноеРешение  - Структура - исходное решение L4.
//   ЛатентностьМс    - Число - латентность вызова LLM в миллисекундах.
//   ТипСобытияCritic - Строка - "critic_called", "critic_failed" или "critic_skipped".
//   ДопПричина       - Строка - доп. информация при пропуске/ошибке.
//
Процедура ЗафиксироватьВызовCritic(КонтекстЗапуска, ВердиктCritic, ИсходноеРешение,
	ЛатентностьМс, ТипСобытияCritic, ДопПричина)

	RunId = "";
	КонтекстЗапуска.Свойство("RunId", RunId);

	SequenceЗначение = 0;
	КонтекстЗапуска.Свойство("Sequence", SequenceЗначение);

	ИсходноеРешениеСтрока = "";
	ИсходноеРешение.Свойство("Причина", ИсходноеРешениеСтрока);

	ToolСсылка = Неопределено;
	ИсходноеРешение.Свойство("СсылкаTool", ToolСсылка);

	Payload = Новый Структура;
	Payload.Вставить("tool",             ?(ЗначениеЗаполнено(ToolСсылка), Строка(ToolСсылка), ""));
	Payload.Вставить("исходное_решение", ИсходноеРешениеСтрока);
	Payload.Вставить("latency_ms",       ЛатентностьМс);
	Payload.Вставить("sequence",         SequenceЗначение);

	Если ВердиктCritic <> Неопределено Тогда
		Payload.Вставить("вердикт",         ВердиктCritic.Вердикт);
		Payload.Вставить("причина_критика", ВердиктCritic.Резон);
	КонецЕсли;

	Если Не ПустаяСтрока(ДопПричина) Тогда
		Payload.Вставить("причина_пропуска", ДопПричина);
	КонецЕсли;

	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, ТипСобытияCritic, Payload);

КонецПроцедуры

// Вычислить латентность в миллисекундах от момента начала.
//
// Параметры:
//   НачалоМс - Число - значение ТекущаяУниверсальнаяДатаВМиллисекундах() в начале.
//
// Возвращаемое значение:
//   Число
//
Функция ЛатентностьМс(НачалоМс)
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
КонецФункции

#КонецОбласти
