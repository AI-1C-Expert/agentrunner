////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_LLMYandexGPT (AOS LLM YandexGPT).
//
// Нативный LLM-провайдер AgentRunner для Yandex Cloud Foundation Models
// (YandexGPT). Реализует единственную экспортную функцию Чат(Сообщения,
// Параметры) — принимает сообщения во внутреннем универсальном формате
// AgentRunner (см. ar_LLMКонтракт), сериализует их в формат YandexGPT
// (/foundationModels/v1/completion) и возвращает ответ в том же
// внутреннем формате, включая tool_calls и usage.
//
// Свойства модуля: Сервер, без привилегированного режима. Привилегированный
// режим устанавливается внутри ar_Secrets.Прочитать при чтении API-ключа.
//
// Контракт: см. ar_LLMКонтракт (формат сообщений, ключи структуры результата,
// валидаторы). Локальный НовыйРезультат() сохранён по образцу
// ar_LLMКонтракт.НовыйОтвет() для бинарной совместимости.
//
// Особенности YandexGPT относительно OpenAI:
//   * поле text вместо content;
//   * tool_call_id нативно не возвращается — генерируем UUID;
//   * function calling — отдельное поле tools верхнего уровня; в ответе —
//     toolCallList.toolCalls с functionCall.name / functionCall.arguments;
//   * usage.inputTextTokens / completionTokens возвращаются строками;
//   * Authorization: Api-Key <key> либо Bearer <IAMToken> — тип определяется
//     по префиксу значения (t1. → IAM, иначе → Api-Key).
//
// См. спеку: .docs/specs/LLM-04.md, Plan §3.14.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет запрос к YandexGPT Foundation Models API.
//
// Параметры:
//   Сообщения  - Массив   - список сообщений во внутреннем формате AgentRunner.
//                           Контракт — ar_LLMКонтракт.НовоеСообщение().
//   Параметры  - Структура - {Провайдер (СправочникСсылка.ar_LLMПровайдеры),
//                             Модель (Строка),
//                             Температура (Число 0..1),
//                             МаксТокенов (Число),
//                             Tools (Массив манифестов),
//                             Таймаут (Число секунд)}
//
// Возвращаемое значение:
//   Структура - ar_LLMКонтракт.НовыйОтвет() —
//               {Успех, Сообщение, ТокеновВход, ТокеновВыход, Ошибка, КодСостояния}
//
Функция Чат(Сообщения, Параметры) Экспорт

	Результат = НовыйРезультат();

	// --- Валидация входа ---------------------------------------------------
	Если ТипЗнч(Сообщения) <> Тип("Массив") Или Сообщения.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Сообщения не заданы';
		                       |en = 'Messages are not set'");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Результат.Ошибка = НСтр("ru = 'Параметры не заданы';
		                       |en = 'Parameters are not set'");
		Возврат Результат;
	КонецЕсли;

	Провайдер = Неопределено;
	Параметры.Свойство("Провайдер", Провайдер);
	Если Провайдер = Неопределено Или НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Результат.Ошибка = НСтр("ru = 'Провайдер не задан';
		                       |en = 'Provider is not set'");
		Возврат Результат;
	КонецЕсли;

	// --- Чтение реквизитов провайдера --------------------------------------
	BaseURL = "";
	КлючИдентификатор = "";
	DefaultModel = "";
	ПоддерживаетToolCalls = Ложь;
	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер,
			"ar_BaseURL, ar_APIKeyИдентификатор, ar_DefaultModel, ar_ПоддерживаетToolCalls");
		BaseURL = СокрЛП(Строка(Реквизиты.ar_BaseURL));
		КлючИдентификатор = СокрЛП(Строка(Реквизиты.ar_APIKeyИдентификатор));
		DefaultModel = СокрЛП(Строка(Реквизиты.ar_DefaultModel));
		Если ТипЗнч(Реквизиты.ar_ПоддерживаетToolCalls) = Тип("Булево") Тогда
			ПоддерживаетToolCalls = Реквизиты.ar_ПоддерживаетToolCalls;
		КонецЕсли;
	Исключение
		Результат.Ошибка = НСтр("ru = 'Не удалось прочитать провайдера';
		                       |en = 'Failed to read provider'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(BaseURL) Тогда
		Результат.Ошибка = НСтр("ru = 'BaseURL не задан у провайдера';
		                       |en = 'Provider BaseURL is not set'");
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(КлючИдентификатор) Тогда
		Результат.Ошибка = НСтр("ru = 'Идентификатор API-ключа не задан у провайдера';
		                       |en = 'Provider API-key identifier is not set'");
		Возврат Результат;
	КонецЕсли;

	// --- Чтение API-ключа из БезопасногоХранилища -------------------------
	APIKey = Неопределено;
	Попытка
		APIKey = ar_Secrets.Прочитать(ar_Secrets.КлючПровайдера(КлючИдентификатор));
	Исключение
		Результат.Ошибка = НСтр("ru = 'Не удалось прочитать API-ключ';
		                       |en = 'Failed to read API key'");
		Возврат Результат;
	КонецПопытки;

	Если APIKey = Неопределено Или ТипЗнч(APIKey) <> Тип("Строка") Или ПустаяСтрока(APIKey) Тогда
		Результат.Ошибка = НСтр("ru = 'API-ключ не задан для провайдера';
		                       |en = 'API key is not set for provider'");
		Возврат Результат;
	КонецЕсли;

	// --- Модель ------------------------------------------------------------
	Модель = "";
	Параметры.Свойство("Модель", Модель);
	Если ТипЗнч(Модель) <> Тип("Строка") Или ПустаяСтрока(Модель) Тогда
		Модель = DefaultModel;
	КонецЕсли;
	Если ПустаяСтрока(Модель) Тогда
		Модель = "yandexgpt-lite";
	КонецЕсли;

	// --- Tools / предупреждение при отключённом function calling ----------
	ToolsПараметр = Неопределено;
	Параметры.Свойство("Tools", ToolsПараметр);
	ЕстьToolsНаВход = (ТипЗнч(ToolsПараметр) = Тип("Массив") И ToolsПараметр.Количество() > 0);

	Если ЕстьToolsНаВход И НЕ ПоддерживаетToolCalls Тогда
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ar_LLMYandexGPT.Чат'; en = 'ar_LLMYandexGPT.Chat'"),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Параметры.Tools непуст, но у провайдера выключен ПоддерживаетToolCalls — tools не передаются в запрос';
			    |en = 'Parameters.Tools is non-empty, but provider has ПоддерживаетToolCalls = False — tools are not passed'"));
	КонецЕсли;

	// --- Построение modelUri и тела запроса --------------------------------
	МодельUri = ПостроитьМодельUri(BaseURL, Модель);

	ТелоJSON = "";
	Попытка
		ТелоJSON = ПостроитьТелоЗапросаJSON(МодельUri, Сообщения, Параметры, ПоддерживаетToolCalls);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Ошибка сериализации запроса';
		                       |en = 'Request serialization error'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	// --- HTTP-вызов --------------------------------------------------------
	URL = ПостроитьURL(BaseURL);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", ЗаголовокAuthorization(APIKey));
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");

	Таймаут = 0;
	Параметры.Свойство("Таймаут", Таймаут);
	Если ТипЗнч(Таймаут) <> Тип("Число") Или Таймаут <= 0 Тогда
		Таймаут = ar_Константы.ТаймаутLLM();
	КонецЕсли;

	// Идемпотентный ключ — UUID на один логический вызов Чат() (используется
	// ar_HTTP.ВыполнитьPOST для защиты от двойных списаний при ретраях
	// внутри одного вызова провайдера; ретраи на уровне диспетчера
	// сгенерируют новый ключ — см. HTTP-04).
	IdempotencyKey = Строка(Новый УникальныйИдентификатор());

	// HTTP-05: если у провайдера установлен флаг ar_ИспользоватьПрокси —
	// получаем объект ИнтернетПрокси через БСП и передаём в HTTP-вызов.
	Прокси = ПолучитьПрокси(Провайдер);

	HTTPОтвет = ar_HTTP.ВыполнитьPOST(URL, Заголовки, ТелоJSON, Таймаут, IdempotencyKey, Прокси);

	Результат.КодСостояния = HTTPОтвет.КодСостояния;

	// --- Обработка ошибок HTTP --------------------------------------------
	Если HTTPОтвет.КодСостояния = 0 Тогда
		ТекстОшибки = ?(ПустаяСтрока(HTTPОтвет.Ошибка),
			НСтр("ru = 'Сетевая ошибка'; en = 'Network error'"),
			HTTPОтвет.Ошибка);
		Результат.Ошибка = МаскироватьКлюч(ТекстОшибки, APIKey);
		Возврат Результат;
	КонецЕсли;

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		Результат.Ошибка = МаскироватьКлюч(
			СообщениеОбОшибкеHTTP(HTTPОтвет.КодСостояния, HTTPОтвет.Тело),
			APIKey);
		Возврат Результат;
	КонецЕсли;

	// --- Парсинг ответа ----------------------------------------------------
	Попытка
		Ответ = ПрочитатьJSONСтроку(HTTPОтвет.Тело);
	Исключение
		Результат.Ошибка = НСтр("ru = 'Ошибка парсинга ответа';
		                       |en = 'Response parsing error'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ YandexGPT не является объектом';
		                       |en = 'YandexGPT response is not an object'");
		Возврат Результат;
	КонецЕсли;

	БлокResult = Ответ.Получить("result");
	Если ТипЗнч(БлокResult) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ YandexGPT не содержит блок result';
		                       |en = 'YandexGPT response has no result block'");
		Возврат Результат;
	КонецЕсли;

	Alternatives = БлокResult.Получить("alternatives");
	Если ТипЗнч(Alternatives) <> Тип("Массив") Или Alternatives.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ YandexGPT не содержит вариантов';
		                       |en = 'YandexGPT response has no alternatives'");
		Возврат Результат;
	КонецЕсли;

	ПерваяAlternative = Alternatives[0];
	Если ТипЗнч(ПерваяAlternative) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ YandexGPT имеет некорректную структуру alternatives';
		                       |en = 'YandexGPT response has invalid alternatives structure'");
		Возврат Результат;
	КонецЕсли;

	СообщениеYandex = ПерваяAlternative.Получить("message");
	Если ТипЗнч(СообщениеYandex) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Ответ YandexGPT не содержит message';
		                       |en = 'YandexGPT response has no message'");
		Возврат Результат;
	КонецЕсли;

	Результат.Сообщение = СообщениеИзФорматаYandexGPT(СообщениеYandex, ПоддерживаетToolCalls);

	// --- Usage -------------------------------------------------------------
	// LLM-06: единый парсер usage через ar_LLMКонтракт; YandexGPT возвращает
	// токены строками, но ar_LLMКонтракт.ИзвлечьЧисло приводит их к Числу.
	ПарситьUsage(БлокResult, Результат);

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// HTTP-05: возвращает объект ИнтернетПрокси для провайдера, либо Неопределено.
//
// Если у провайдера установлен флаг ar_ИспользоватьПрокси — вызывается
// БСП-метод ПолучениеФайловИзИнтернета.ПолучитьПрокси("https"), который
// возвращает прокси на основании настроек кластера/сервера.
//
// При отсутствии подсистемы РаботаСФайлами или ошибке получения прокси —
// возвращается Неопределено (соединение пойдёт напрямую), а событие
// фиксируется в журнале регистрации как предупреждение.
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры - ссылка на провайдера.
//
// Возвращаемое значение:
//   ИнтернетПрокси, Неопределено - объект прокси или Неопределено.
//
Функция ПолучитьПрокси(Провайдер)

	ИспользоватьПрокси = Ложь;
	Попытка
		РеквизитыПрокси = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер, "ar_ИспользоватьПрокси");
		Если ТипЗнч(РеквизитыПрокси.ar_ИспользоватьПрокси) = Тип("Булево") Тогда
			ИспользоватьПрокси = РеквизитыПрокси.ar_ИспользоватьПрокси;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ИспользоватьПрокси Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("ПолучениеФайловИзИнтернета") = Неопределено Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Подсистема РаботаСФайлами недоступна — прокси не используется';
			    |en = 'Subsystem FilesOperations is unavailable — proxy is not used'"));
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
	Исключение
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Не удалось получить ИнтернетПрокси';
			    |en = 'Failed to obtain InternetProxy'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Формирует структуру результата по умолчанию (Успех = Ложь).
// Состав ключей — см. ar_LLMКонтракт.НовыйОтвет().
Функция НовыйРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);
	Возврат Результат;
КонецФункции

// Строит итоговый URL вида <BaseURL>/foundationModels/v1/completion.
// BaseURL может быть полным modelUri-префиксом (gpt://<FolderID>) или
// HTTP-URL (https://llm.api.cloud.yandex.net). В первом случае HTTP-эндпоинт
// фиксированный; во втором — берётся как корень.
Функция ПостроитьURL(BaseURL)

	База = ОчиститьЗавершающиеСлеши(BaseURL);

	// Если в BaseURL лежит modelUri-префикс gpt://... — используем фиксированный HTTP-эндпоинт.
	Если СтрНачинаетсяС(НРег(База), "gpt://") Тогда
		Возврат "https://llm.api.cloud.yandex.net/foundationModels/v1/completion";
	КонецЕсли;

	Возврат База + "/foundationModels/v1/completion";

КонецФункции

// Конструирует значение поля modelUri тела запроса.
//   * Если Модель уже начинается с "gpt://" — возвращаем как есть.
//   * Если BaseURL начинается с "gpt://" — это префикс с FolderID, дописываем "/<модель>".
//   * Иначе FolderID неизвестен; возвращаем имя модели как есть (API вернёт 400).
Функция ПостроитьМодельUri(BaseURL, Модель)

	База = ОчиститьЗавершающиеСлеши(BaseURL);
	МодельСтр = СокрЛП(Строка(Модель));

	Если СтрНачинаетсяС(НРег(МодельСтр), "gpt://") Тогда
		Возврат МодельСтр;
	КонецЕсли;

	Если СтрНачинаетсяС(НРег(База), "gpt://") Тогда
		Возврат База + "/" + МодельСтр;
	КонецЕсли;

	Возврат МодельСтр;

КонецФункции

// Удаляет завершающие слэши и пробелы с обеих сторон.
Функция ОчиститьЗавершающиеСлеши(Значение)
	База = СокрЛП(Строка(Значение));
	Пока СтрДлина(База) > 0 И Прав(База, 1) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;
	Возврат База;
КонецФункции

// Формирует заголовок Authorization. Тип определяется по префиксу значения:
//   * "t1." → IAM-токен → Bearer
//   * иначе → Api-Key
Функция ЗаголовокAuthorization(APIKey)
	Если СтрНачинаетсяС(APIKey, "t1.") Тогда
		Возврат "Bearer " + APIKey;
	КонецЕсли;
	Возврат "Api-Key " + APIKey;
КонецФункции

// Строит JSON-тело запроса YandexGPT.
Функция ПостроитьТелоЗапросаJSON(МодельUri, Сообщения, Параметры, ПоддерживаетToolCalls)

	Тело = Новый Соответствие;
	Тело.Вставить("modelUri", Строка(МодельUri));

	CompletionOptions = Новый Соответствие;
	CompletionOptions.Вставить("stream", Ложь);

	Температура = Неопределено;
	Если Параметры.Свойство("Температура", Температура)
		И Температура <> Неопределено
		И ТипЗнч(Температура) = Тип("Число") Тогда
		// Обрезаем до [0, 1] согласно DoD D18.
		ТемператураОбрезанная = Мин(Макс(Температура, 0), 1);
		CompletionOptions.Вставить("temperature", ТемператураОбрезанная);
	КонецЕсли;

	МаксТокенов = 0;
	Если Параметры.Свойство("МаксТокенов", МаксТокенов)
		И ТипЗнч(МаксТокенов) = Тип("Число") И МаксТокенов > 0 Тогда
		CompletionOptions.Вставить("maxTokens", МаксТокенов);
	КонецЕсли;

	Тело.Вставить("completionOptions", CompletionOptions);
	Тело.Вставить("messages", СообщенияВФорматYandexGPT(Сообщения));

	Tools = Неопределено;
	Если ПоддерживаетToolCalls
		И Параметры.Свойство("Tools", Tools)
		И ТипЗнч(Tools) = Тип("Массив")
		И Tools.Количество() > 0 Тогда
		Тело.Вставить("tools", Tools);
	КонецЕсли;

	Возврат ЗаписатьJSONСтроку(Тело);

КонецФункции

// Сериализует массив внутренних сообщений в массив Соответствий формата
// YandexGPT ({role, text}). YandexGPT не имеет нативного tool_call_id,
// поэтому tool-сообщения оборачиваются в текстовый префикс
// "[tool_result: <name>] <content>", а assistant.tool_calls — в
// "[tool_call: <name>] <args>". Это даёт LLM контекст об истории вызовов
// инструментов и при включённом, и при выключенном function calling.
//
// Параметры:
//   Сообщения - Массив - входные сообщения внутреннего формата AgentRunner.
//
Функция СообщенияВФорматYandexGPT(Сообщения)

	Результат = Новый Массив;

	Для Каждого Сообщение Из Сообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Role = "";
		Сообщение.Свойство("role", Role);
		РольСтр = Строка(Role);

		Content = "";
		Сообщение.Свойство("content", Content);
		ContentСтр = Строка(Content);

		ToolCalls = Неопределено;
		Сообщение.Свойство("tool_calls", ToolCalls);
		ЕстьToolCalls = (ТипЗнч(ToolCalls) = Тип("Массив") И ToolCalls.Количество() > 0);

		ИмяTool = "";
		Сообщение.Свойство("name", ИмяTool);
		ИмяToolСтр = Строка(ИмяTool);

		ТекстИтог = "";

		Если РольСтр = "assistant" И ЕстьToolCalls Тогда
			ТекстToolCalls = ToolCallsВТекст(ToolCalls);
			Если НЕ ПустаяСтрока(ContentСтр) Тогда
				ТекстИтог = ContentСтр + Символы.ПС + ТекстToolCalls;
			Иначе
				ТекстИтог = ТекстToolCalls;
			КонецЕсли;
		ИначеЕсли РольСтр = "tool" Тогда
			ПрефиксИмя = ?(ПустаяСтрока(ИмяToolСтр), "tool", ИмяToolСтр);
			ТекстИтог = "[tool_result: " + ПрефиксИмя + "] " + ContentСтр;
		Иначе
			ТекстИтог = ContentСтр;
		КонецЕсли;

		Элемент = Новый Соответствие;
		Элемент.Вставить("role", РольСтр);
		Элемент.Вставить("text", ТекстИтог);

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует текстовое представление массива tool_calls.
// Если несколько вызовов — разделяются переводом строки.
Функция ToolCallsВТекст(ToolCalls)

	Куски = Новый Массив;

	Для Каждого Вызов Из ToolCalls Цикл

		Если ТипЗнч(Вызов) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Имя = "";
		Аргументы = "";

		ФункцияВызова = Неопределено;
		Вызов.Свойство("function", ФункцияВызова);
		Если ТипЗнч(ФункцияВызова) = Тип("Структура") Тогда
			ФункцияВызова.Свойство("name", Имя);
			ФункцияВызова.Свойство("arguments", Аргументы);
		КонецЕсли;

		Куски.Добавить("[tool_call: " + Строка(Имя) + "] " + Строка(Аргументы));

	КонецЦикла;

	Возврат СтрСоединить(Куски, Символы.ПС);

КонецФункции

// Конвертирует Соответствие message (из ответа YandexGPT) во внутреннюю
// Структуру формата AgentRunner. При наличии нативного toolCallList — заполняет
// tool_calls; иначе текст помещается в content "как есть".
Функция СообщениеИзФорматаYandexGPT(СообщениеYandex, ПоддерживаетToolCalls)

	Результат = Новый Структура;

	Role = СообщениеYandex.Получить("role");
	Результат.Вставить("role", ?(ТипЗнч(Role) = Тип("Строка"), Role, "assistant"));

	ТекстПоле = СообщениеYandex.Получить("text");
	Если ТипЗнч(ТекстПоле) = Тип("Строка") Тогда
		Результат.Вставить("content", ТекстПоле);
	Иначе
		Результат.Вставить("content", "");
	КонецЕсли;

	Если ПоддерживаетToolCalls Тогда
		ToolCallList = СообщениеYandex.Получить("toolCallList");
		Если ТипЗнч(ToolCallList) = Тип("Соответствие") Тогда
			Попытка
				ToolCallsМассив = ToolCallsИзYandexGPT(ToolCallList);
				Если ToolCallsМассив.Количество() > 0 Тогда
					Результат.Вставить("tool_calls", ToolCallsМассив);
				КонецЕсли;
			Исключение
				// Формат toolCallList может измениться в новых версиях API —
				// фиксируем в журнал и продолжаем как обычный текстовый ответ.
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'ar_LLMYandexGPT.Чат'; en = 'ar_LLMYandexGPT.Chat'"),
					УровеньЖурналаРегистрации.Предупреждение,
					,
					,
					НСтр("ru = 'Не удалось распарсить toolCallList';
					    |en = 'Failed to parse toolCallList'")
					+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Преобразует нативный блок toolCallList YandexGPT в массив внутренних
// tool_calls (Структур). id генерируется как UUID — API не возвращает
// нативный tool_call_id.
Функция ToolCallsИзYandexGPT(ToolCallList)

	Результат = Новый Массив;

	ToolCallsRaw = ToolCallList.Получить("toolCalls");
	Если ТипЗнч(ToolCallsRaw) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Вызов Из ToolCallsRaw Цикл

		Если ТипЗнч(Вызов) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		FunctionCall = Вызов.Получить("functionCall");
		Если ТипЗнч(FunctionCall) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		ИмяФ = FunctionCall.Получить("name");
		АргументыRaw = FunctionCall.Получить("arguments");

		// YandexGPT возвращает arguments объектом — сериализуем обратно в JSON-строку
		// для единообразия с внутренним форматом AgentRunner (arguments всегда строка).
		АргументыJSON = "";
		Если ТипЗнч(АргументыRaw) = Тип("Строка") Тогда
			АргументыJSON = АргументыRaw;
		ИначеЕсли АргументыRaw = Неопределено Тогда
			АргументыJSON = "{}";
		Иначе
			Попытка
				АргументыJSON = ЗаписатьJSONСтроку(АргументыRaw);
			Исключение
				АргументыJSON = "{}";
			КонецПопытки;
		КонецЕсли;

		ФункцияСтрукт = Новый Структура;
		ФункцияСтрукт.Вставить("name", ?(ТипЗнч(ИмяФ) = Тип("Строка"), ИмяФ, ""));
		ФункцияСтрукт.Вставить("arguments", АргументыJSON);

		Структ = Новый Структура;
		Структ.Вставить("id", НовыйToolCallId());
		Структ.Вставить("type", "function");
		Структ.Вставить("function", ФункцияСтрукт);

		Результат.Добавить(Структ);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Генерирует уникальный id вызова tool. YandexGPT не возвращает нативный
// tool_call_id; диспетчер использует id только для сопоставления
// observation внутри одного шага агента.
Функция НовыйToolCallId()
	Возврат "yagpt_" + Строка(Новый УникальныйИдентификатор());
КонецФункции

// Возвращает строку JSON-сериализации значения с настройками AgentRunner:
//   * двойные кавычки;
//   * сохранение null;
//   * даты в ISO 8601.
// При исключении в ЗаписатьJSON гарантирует закрытие потока ЗаписьJSON.
Функция ЗаписатьJSONСтроку(Значение)

	НастройкиЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "", Истина);

	// Свойства СохранятьNull у НастройкиСериализацииJSON не существует (платформа
	// и так сериализует Неопределено как JSON null по умолчанию). Правильное имя
	// свойства формата дат - ФорматСериализацииДаты (проверено по реальному
	// использованию в БП: DataProcessors/МенеджерКонвертацииУправлениеПерсоналом).
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(НастройкиЗаписи);
	Попытка
		ЗаписатьJSON(Запись, Значение, НастройкиСериализации);
	Исключение
		Попытка
			Запись.Закрыть();
		Исключение
			// Поток уже закрыт или повреждён — игнорируем вторичную ошибку.
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Запись.Закрыть();

КонецФункции

// Десериализует JSON-строку в Соответствие/Массив (ЧитатьВСоответствие = Истина).
// При исключении в ПрочитатьJSON гарантирует закрытие потока ЧтениеJSON.
Функция ПрочитатьJSONСтроку(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
			// Поток уже закрыт — игнорируем.
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Извлекает usage из блока result ответа YandexGPT и кладёт в Результат.
// YandexGPT возвращает inputTextTokens / completionTokens строками — приведение
// делегируется ar_LLMКонтракт.ИзвлечьЧисло. При отсутствии usage — нули
// и запись в журнал регистрации уровня Информация.
//
// Параметры:
//   БлокResult - Соответствие - значение узла result из JSON ответа YandexGPT.
//   Результат  - Структура    - модифицируется: ТокеновВход / ТокеновВыход.
//
Процедура ПарситьUsage(БлокResult, Результат)

	Usage = БлокResult.Получить("usage");

	Если ТипЗнч(Usage) <> Тип("Соответствие") Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.LLM.Usage",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.ОбщиеМодули.ar_LLMYandexGPT,
			,
			НСтр("ru = 'Блок usage отсутствует в ответе YandexGPT; токены не учтены';
			    |en = 'Usage block is missing in YandexGPT response; tokens not counted'"));
		Возврат;
	КонецЕсли;

	Результат.ТокеновВход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("inputTextTokens"));
	Результат.ТокеновВыход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("completionTokens"));

	// Fallback (см. риск в LLM-06): если inputTextTokens отсутствует, но есть
	// totalTokens — принимаем его как приблизительную верхнюю границу входа.
	Если Результат.ТокеновВход = 0 Тогда
		Total = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("totalTokens"));
		Если Total > 0 Тогда
			Результат.ТокеновВход = Total;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Формирует текст ошибки для HTTP-кода != 200, извлекая error.message если есть.
Функция СообщениеОбОшибкеHTTP(КодСостояния, Тело)

	КраткоеТело = "";
	Если ТипЗнч(Тело) = Тип("Строка") И НЕ ПустаяСтрока(Тело) Тогда
		Попытка
			Распарсенное = ПрочитатьJSONСтроку(Тело);
			Если ТипЗнч(Распарсенное) = Тип("Соответствие") Тогда
				ErrorНоды = Распарсенное.Получить("error");
				Если ТипЗнч(ErrorНоды) = Тип("Соответствие") Тогда
					Сообщ = ErrorНоды.Получить("message");
					Если ТипЗнч(Сообщ) = Тип("Строка") Тогда
						КраткоеТело = Сообщ;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// игнорируем — оставим КраткоеТело пустым
		КонецПопытки;
	КонецЕсли;

	Префикс = "";
	Если КодСостояния = 401 Тогда
		Префикс = НСтр("ru = 'Ошибка авторизации YandexGPT: 401';
		              |en = 'YandexGPT authorization error: 401'");
	ИначеЕсли КодСостояния = 429 Тогда
		Префикс = НСтр("ru = 'Rate limit YandexGPT: 429';
		              |en = 'YandexGPT rate limit: 429'");
	ИначеЕсли КодСостояния >= 500 Тогда
		Префикс = НСтр("ru = 'Ошибка сервера YandexGPT'; en = 'YandexGPT server error'")
			+ ": " + Формат(КодСостояния, "ЧГ=");
	Иначе
		Префикс = НСтр("ru = 'Ошибка YandexGPT'; en = 'YandexGPT error'")
			+ ": " + Формат(КодСостояния, "ЧГ=");
	КонецЕсли;

	Если ПустаяСтрока(КраткоеТело) Тогда
		Возврат Префикс;
	КонецЕсли;

	Возврат Префикс + ": " + КраткоеТело;

КонецФункции

// Маскирует API-ключ в тексте, на случай если HTTP-уровень включил
// заголовок или тело запроса в сообщение об ошибке.
Функция МаскироватьКлюч(Текст, APIKey)
	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Строка(Текст);
	КонецЕсли;
	Если ТипЗнч(APIKey) <> Тип("Строка") Или СтрДлина(APIKey) < 8 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат СтрЗаменить(Текст, APIKey, "***");
КонецФункции

#КонецОбласти
