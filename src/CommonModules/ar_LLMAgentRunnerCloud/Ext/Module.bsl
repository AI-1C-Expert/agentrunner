////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_LLMAgentRunnerCloud (AOS LLM AgentRunner Cloud).
//
// Пятый рабочий тип LLM-провайдера. Реализует чат с собственным облачным
// LLM-шлюзом AgentRunner (agentrunner.ru) - прокси, скрывающим за собой
// сторонних LLM-провайдеров (в т.ч. CLOUDRU), с собственным протоколом,
// НЕ совместимым с OpenAI Chat Completions: POST <BaseURL>/api/proxy,
// плоская схема ответа (content/usage.input_tokens/usage.output_tokens),
// без choices[]. С LLM-13 шлюз опционально поддерживает tool_calls (формат
// сообщений/ответа идентичен OpenAI, {id, type:"function", function:{name,
// arguments}}), управляется реквизитом провайдера ar_ПоддерживаетToolCalls -
// см. функцию Чат() и СообщенияВФорматAgentRunnerCloud.
//
// Свойства модуля: Сервер, без привилегированного режима. Привилегированный
// режим устанавливается внутри ar_Secrets.Прочитать при чтении API-ключа.
//
// Контракт: см. ar_LLMКонтракт (формат сообщений, ключи структуры результата,
// валидаторы). Локальный НовыйРезультат() сохранён по образцу ar_LLMOpenAI
// (и ar_LLMКонтракт.НовыйОтвет()) для бинарной совместимости с диспетчером.
//
// Поля balance_rub / low_balance из успешного (200) ответа шлюза пробрасываются
// в контракт результата Чат() через ПарситьБаланс (LLM-14, часть Б): ключи
// БалансРуб (Число|Неопределено, дефолт Неопределено - НЕ 0!) и БалансНизкий
// (Булево, дефолт Ложь). Контракт диспетчера (ar_LLMДиспетчер) и эталонный
// контракт (ar_LLMКонтракт.НовыйОтвет) расширены теми же двумя опциональными
// ключами; остальные 4 боевых провайдера их не заполняют.
//
// Лимиты протокола шлюза (максимум 200 сообщений, content <= 200000 символов)
// в этой итерации не валидируются модулем - см. LLM-12, раздел "Риски".
// TODO: если агентский цикл соберёт более длинный контекст - шлюз ответит 422
// без локальной диагностики; требуется отдельная задача валидации лимитов.
//
// См. спеку: .docs/specs/LLM-12.md, .docs/specs/LLM-13.md, .docs/specs/LLM-14.md,
// Plan §3.14, §3.8.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет запрос к шлюзу AgentRunner Cloud (POST <BaseURL>/api/proxy).
//
// tool_calls (LLM-13): если у провайдера ar_ПоддерживаетToolCalls = Истина и
// Параметры.Tools непустой - в тело запроса добавляется "tools" (и, если
// задан, "tool_choice"), а ответ разбирается на предмет tool_calls в корне
// JSON. Источник истины при разборе ответа - тело ответа шлюза, а не локальный
// флаг провайдера (см. ниже разбор tool_calls через ToolCallsИзФорматаOpenAI).
//
// Idempotent-реплей: при повторном вызове с тем же идемпотентным ключом шлюз
// может вернуть плоский ответ вида {idempotent:true, usage, balance_rub} без
// content/tool_calls/model/provider. Это не ошибка - HTTP-код всё равно 200,
// Результат.Успех = Истина, content подставляется как "" (см. ниже), а ключ
// tool_calls в Результат.Сообщение просто отсутствует.
//
// Формат элемента Сообщения (внутренний формат AgentRunner):
//   role         - Строка ("system"|"user"|"assistant"|"tool")
//   content      - Строка
//   tool_calls   - Массив структур (опционально, для assistant)
//   tool_call_id - Строка (опционально, для tool)
//   name         - Строка (опционально, для tool)
//
// Параметры:
//   Сообщения - Массив    - список сообщений во внутреннем формате AgentRunner.
//   Параметры - Структура - {Провайдер (СправочникСсылка.ar_LLMПровайдеры),
//                            Модель (Строка), Температура (Число),
//                            МаксТокенов (Число), Tools (Массив манифестов,
//                            опционально), ToolChoice (Строка|Структура,
//                            опционально)}.
//
// Возвращаемое значение:
//   Структура - {Успех, Сообщение, ТокеновВход, ТокеновВыход, Ошибка, КодСостояния}
//
Функция Чат(Сообщения, Параметры) Экспорт

	Результат = НовыйРезультат();

	// --- Валидация входа ---------------------------------------------------
	Если ТипЗнч(Сообщения) <> Тип("Массив") Или Сообщения.Количество() = 0 Тогда
		Результат.Ошибка = "Сообщения не заданы";
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Результат.Ошибка = "Параметры не заданы";
		Возврат Результат;
	КонецЕсли;

	Провайдер = Неопределено;
	Параметры.Свойство("Провайдер", Провайдер);
	Если Провайдер = Неопределено Или НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Результат.Ошибка = "Провайдер не задан";
		Возврат Результат;
	КонецЕсли;

	// --- Чтение реквизитов провайдера и API-ключа --------------------------
	// Вынесено в отдельную функцию, чтобы не раздувать цикломатическую и
	// когнитивную сложность Чат() - все ветки ошибок чтения собраны в одном месте.
	ДанныеДоступа = ПрочитатьДанныеДоступа(Провайдер);
	Если НЕ ДанныеДоступа.Успех Тогда
		Результат.Ошибка = ДанныеДоступа.Ошибка;
		Возврат Результат;
	КонецЕсли;
	BaseURL = ДанныеДоступа.BaseURL;
	APIKey = ДанныеДоступа.APIKey;
	ПоддерживаетToolCalls = ДанныеДоступа.ПоддерживаетToolCalls;

	// --- Модель --------------------------------------------------------------
	// ar_LLMДиспетчер.ПараметрыДляПровайдера всегда подставляет DefaultModel
	// провайдера, если Модель не задана явно в контексте вызова. Безопасный
	// дефолт здесь нужен только на случай прямого вызова модуля в обход
	// диспетчера (например, из тестов).
	Модель = "";
	Параметры.Свойство("Модель", Модель);
	Если ТипЗнч(Модель) <> Тип("Строка") Или ПустаяСтрока(Модель) Тогда
		Модель = "Qwen3.6-35B-A3B";
	КонецЕсли;

	// --- Сборка тела запроса ----------------------------------------------
	ТелоJSON = "";
	Попытка
		ТелоJSON = ПостроитьТелоЗапроса(Модель, Сообщения, Параметры, ПоддерживаетToolCalls);
	Исключение
		Результат.Ошибка = "Ошибка сериализации запроса: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	// --- HTTP-вызов --------------------------------------------------------
	URL = ПостроитьURL(BaseURL);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + APIKey);
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");

	// Структура.Свойство() при отсутствии ключа записывает в переменную Неопределено,
	// поэтому тип проверяем после вызова, а не полагаемся на инициализацию.
	Таймаут = 0;
	ЗначениеТаймаута = Неопределено;
	Если Параметры.Свойство("Таймаут", ЗначениеТаймаута)
		И ТипЗнч(ЗначениеТаймаута) = Тип("Число") Тогда
		Таймаут = ЗначениеТаймаута;
	КонецЕсли;

	// HTTP-04: идемпотентный ключ для защиты от двойной оплаты при ретраях.
	// UUID генерируется один раз на логический вызов Чат() - по образцу
	// ar_LLMOpenAI (см. её же технический долг про повторную генерацию
	// UUID при ретраях диспетчера, LLM-02, "Риски").
	IdempotencyKey = Строка(Новый УникальныйИдентификатор());

	// HTTP-05: если у провайдера установлен флаг ar_ИспользоватьПрокси -
	// получаем объект ИнтернетПрокси через БСП и передаём в HTTP-вызов.
	Прокси = ПолучитьПрокси(Провайдер);

	HTTPОтвет = ar_HTTP.ВыполнитьPOST(URL, Заголовки, ТелоJSON,
		?(Таймаут > 0, Таймаут, 0), IdempotencyKey, Прокси);

	Результат.КодСостояния = HTTPОтвет.КодСостояния;

	// --- Обработка ошибок HTTP --------------------------------------------
	// Код 200 - единственный успешный; вся диагностика вынесена в
	// ОписаниеОшибкиHTTP (сетевая ошибка / 402 / общая ветка), чтобы не
	// раздувать цикломатическую сложность Чат().
	Если HTTPОтвет.КодСостояния <> 200 Тогда
		Результат.Ошибка = ОписаниеОшибкиHTTP(HTTPОтвет);
		Возврат Результат;
	КонецЕсли;

	// --- Парсинг ответа ----------------------------------------------------
	Попытка
		Ответ = ПрочитатьJSONСтроку(HTTPОтвет.Тело);
	Исключение
		Результат.Ошибка = "Ошибка парсинга ответа: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "Ответ LLM не является объектом";
		Возврат Результат;
	КонецЕсли;

	// Плоская схема шлюза: content лежит прямо в корне ответа, без choices[].
	// При idempotent-реплее (см. doc-comment функции) content в ответе
	// отсутствует - Получить() вернёт Неопределено, и он корректно
	// подставляется как "" ниже, без исключения.
	Content = Ответ.Получить("content");
	Результат.Сообщение = Новый Структура;
	Результат.Сообщение.Вставить("role", "assistant");
	Результат.Сообщение.Вставить("content",
		?(ТипЗнч(Content) = Тип("Строка"), Content, ""));

	// LLM-13: tool_calls - опциональное поле верхнего уровня ответа (идентично
	// OpenAI по формату элементов). Источник истины - тело ответа, а не
	// локальный флаг ПоддерживаетToolCalls: шлюз не должен присылать tool_calls,
	// если они не были запрошены, но defensive-код не полагается на это.
	// При idempotent-реплее и обычном ответе без tool_calls ключ просто
	// отсутствует в Результат.Сообщение - это штатно, а не ошибка.
	ToolCallsRaw = Ответ.Получить("tool_calls");
	Если ТипЗнч(ToolCallsRaw) = Тип("Массив") И ToolCallsRaw.Количество() > 0 Тогда
		Результат.Сообщение.Вставить("tool_calls", ToolCallsИзФорматаOpenAI(ToolCallsRaw));
	КонецЕсли;

	// --- Usage -------------------------------------------------------------
	// LLM-06: единый парсер usage через ar_LLMКонтракт; нули при отсутствии блока.
	ПарситьUsage(Ответ, Результат);

	// --- Баланс шлюза (LLM-14, часть Б) -------------------------------------
	// balance_rub/low_balance - опциональные поля верхнего уровня успешного
	// ответа; работает одинаково и на обычном ответе, и на idempotent-реплее
	// (см. doc-comment функции), т.к. не зависит от content/tool_calls.
	ПарситьБаланс(Ответ, Результат);

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Формирует JSON-тело минимального тестового запроса (1 сообщение user).
// Используется ar_LLMТест.ОписаниеТестовогоЗапроса, чтобы не дублировать
// логику сериализации тела шлюза AgentRunner Cloud (LLM-12, п. 4).
//
// Параметры:
//   Модель      - Строка - модель для теста (DefaultModel провайдера).
//   ТекстСообщения - Строка - текст пользовательского сообщения (например "ping").
//   МаксТокенов - Число  - лимит токенов ответа (небольшое значение для теста).
//
// Возвращаемое значение:
//   Строка - JSON-тело запроса.
//
Функция ТелоМинимальногоЗапроса(Модель, ТекстСообщения, МаксТокенов = 16) Экспорт

	Сообщение = Новый Структура;
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", ТекстСообщения);

	Сообщения = Новый Массив;
	Сообщения.Добавить(Сообщение);

	Тело = Новый Соответствие;
	Тело.Вставить("provider", "CLOUDRU");
	Тело.Вставить("model", Модель);
	Тело.Вставить("messages", СообщенияВФорматAgentRunnerCloud(Сообщения));

	Если ТипЗнч(МаксТокенов) = Тип("Число") И МаксТокенов > 0 Тогда
		Тело.Вставить("maxTokens", МаксТокенов);
	КонецЕсли;

	Возврат ЗаписатьJSONСтроку(Тело);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает BaseURL, API-ключ и флаг поддержки tool_calls провайдера одним
// местом - объединяет чтение реквизитов (ОбщегоНазначения.ЗначенияРеквизитовОбъекта)
// и чтение секрета (ar_Secrets.Прочитать), чтобы не раздувать цикломатическую
// и когнитивную сложность Чат().
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры - ссылка на провайдера.
//
// Возвращаемое значение:
//   Структура - {Успех (Булево), Ошибка (Строка), BaseURL (Строка),
//                APIKey (Строка), ПоддерживаетToolCalls (Булево)}.
//
Функция ПрочитатьДанныеДоступа(Провайдер)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("BaseURL", "");
	Результат.Вставить("APIKey", "");
	Результат.Вставить("ПоддерживаетToolCalls", Ложь);

	BaseURL = "";
	КлючИдентификатор = "";
	ПоддерживаетToolCalls = Ложь;
	Попытка
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер, "ar_BaseURL, ar_APIKeyИдентификатор, ar_ПоддерживаетToolCalls");
		BaseURL = СокрЛП(Строка(Реквизиты.ar_BaseURL));
		КлючИдентификатор = СокрЛП(Строка(Реквизиты.ar_APIKeyИдентификатор));
		Если ТипЗнч(Реквизиты.ar_ПоддерживаетToolCalls) = Тип("Булево") Тогда
			ПоддерживаетToolCalls = Реквизиты.ar_ПоддерживаетToolCalls;
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Не удалось прочитать провайдера: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(BaseURL) Тогда
		Результат.Ошибка = "BaseURL не задан у провайдера";
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(КлючИдентификатор) Тогда
		Результат.Ошибка = "Идентификатор API-ключа не задан у провайдера";
		Возврат Результат;
	КонецЕсли;

	APIKey = Неопределено;
	Попытка
		APIKey = ar_Secrets.Прочитать(ar_Secrets.КлючПровайдера(КлючИдентификатор));
	Исключение
		Результат.Ошибка = "Не удалось прочитать API-ключ";
		Возврат Результат;
	КонецПопытки;

	Если APIKey = Неопределено Или ТипЗнч(APIKey) <> Тип("Строка") Или ПустаяСтрока(APIKey) Тогда
		Результат.Ошибка = "API-ключ не задан для провайдера";
		Возврат Результат;
	КонецЕсли;

	Результат.BaseURL = BaseURL;
	Результат.APIKey = APIKey;
	Результат.ПоддерживаетToolCalls = ПоддерживаетToolCalls;
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// HTTP-05: возвращает объект ИнтернетПрокси для провайдера, либо Неопределено.
//
// Если у провайдера установлен флаг ar_ИспользоватьПрокси - вызывается
// БСП-метод ПолучениеФайловИзИнтернета.ПолучитьПрокси("https"), который
// возвращает прокси на основании настроек кластера/сервера.
//
// При отсутствии подсистемы РаботаСФайлами или ошибке получения прокси -
// возвращается Неопределено (соединение пойдёт напрямую), а событие
// фиксируется в журнале регистрации как предупреждение.
//
// Скопировано 1:1 из ar_LLMOpenAI.ПолучитьПрокси - функция не специфична
// для конкретного провайдера.
//
// Параметры:
//   Провайдер - СправочникСсылка.ar_LLMПровайдеры - ссылка на провайдера.
//
// Возвращаемое значение:
//   ИнтернетПрокси, Неопределено - объект прокси или Неопределено.
//
Функция ПолучитьПрокси(Провайдер)

	ИспользоватьПрокси = Ложь;
	Попытка
		РеквизитыПрокси = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Провайдер, "ar_ИспользоватьПрокси");
		Если ТипЗнч(РеквизитыПрокси.ar_ИспользоватьПрокси) = Тип("Булево") Тогда
			ИспользоватьПрокси = РеквизитыПрокси.ar_ИспользоватьПрокси;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ИспользоватьПрокси Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("ПолучениеФайловИзИнтернета") = Неопределено Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Подсистема РаботаСФайлами недоступна - прокси не используется';
			    |en = 'Subsystem FilesOperations is unavailable - proxy is not used'"));
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
	Исключение
		ЗаписьЖурналаРегистрации(
			"AgentRunner.HTTP",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Провайдер,
			НСтр("ru = 'Не удалось получить ИнтернетПрокси';
			    |en = 'Failed to obtain InternetProxy'")
			+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Формирует структуру результата по умолчанию (Успех = Ложь).
//
// Экспортная (LLM-14): нужна юнит-тестовому модулю ar_ТестыLLMAgentRunnerCloud
// как отправная точка для тестов ПарситьБаланс (собрать Результат с дефолтами,
// затем вызвать ПарситьБаланс и проверить изменения).
//
// Возвращаемое значение:
//   Структура - {Успех, Сообщение, ТокеновВход, ТокеновВыход, Ошибка, КодСостояния,
//                БалансРуб, БалансНизкий}.
//
Функция НовыйРезультат() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ТокеновВход", 0);
	Результат.Вставить("ТокеновВыход", 0);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("КодСостояния", 0);
	// LLM-14 (часть Б): БалансРуб дефолтится в Неопределено (НЕ 0!) - 0
	// является легитимным значением баланса, Неопределено означает "шлюз не
	// прислал поле balance_rub". См. ПарситьБаланс.
	Результат.Вставить("БалансРуб", Неопределено);
	Результат.Вставить("БалансНизкий", Ложь);
	Возврат Результат;
КонецФункции

// Строит итоговый URL вида <BaseURL без завершающего "/">/api/proxy.
// В отличие от ar_LLMOpenAI, здесь НЕ применяется эвристика наличия "/v1" -
// протокол шлюза AgentRunner Cloud не версионируется таким образом.
//
// Параметры:
//   BaseURL - Строка - базовый URL провайдера (может быть с "/" на конце или без).
//
// Возвращаемое значение:
//   Строка - итоговый URL для POST-запроса.
//
Функция ПостроитьURL(BaseURL)

	База = СокрЛП(BaseURL);
	Пока СтрДлина(База) > 0 И Прав(База, 1) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;

	Возврат База + "/api/proxy";

КонецФункции

// Строит JSON-тело запроса к шлюзу AgentRunner Cloud:
//   {provider:"CLOUDRU", model, messages, maxTokens?, temperature?, tools?, tool_choice?}
//
// tools/tool_choice (LLM-13) добавляются только при ПоддерживаетToolCalls =
// Истина, по паттерну ar_LLMLocalCompatible.ПостроитьТелоЗапроса. ToolChoice -
// первая реализация этого параметра в расширении (ar_LLMOpenAI его пока не
// пробрасывает): передаётся в тело как есть, без валидации формата на
// стороне 1С - некорректное значение шлюз отклонит кодом 422.
//
// Параметры:
//   Модель                - Строка    - модель для запроса.
//   Сообщения             - Массив    - сообщения во внутреннем формате AgentRunner.
//   Параметры             - Структура - {МаксТокенов (Число, опционально),
//                                        Температура (Число, опционально),
//                                        Tools (Массив, опционально),
//                                        ToolChoice (Строка|Структура, опционально)}.
//   ПоддерживаетToolCalls - Булево    - реквизит провайдера ar_ПоддерживаетToolCalls.
//
// Возвращаемое значение:
//   Строка - JSON-тело запроса.
//
Функция ПостроитьТелоЗапроса(Модель, Сообщения, Параметры, ПоддерживаетToolCalls = Ложь)

	Тело = Новый Соответствие;
	Тело.Вставить("provider", "CLOUDRU");
	Тело.Вставить("model", Модель);
	Тело.Вставить("messages", СообщенияВФорматAgentRunnerCloud(Сообщения));

	МаксТокенов = 0;
	Если Параметры.Свойство("МаксТокенов", МаксТокенов) И ТипЗнч(МаксТокенов) = Тип("Число") И МаксТокенов > 0 Тогда
		Тело.Вставить("maxTokens", МаксТокенов);
	КонецЕсли;

	Температура = Неопределено;
	// Проверка типа сразу (а не отдельным условием на "<> Неопределено") -
	// защищает от нештатного типа значения Температура, если оно вообще задано.
	Если Параметры.Свойство("Температура", Температура) И ТипЗнч(Температура) = Тип("Число") Тогда
		Тело.Вставить("temperature", Температура);
	КонецЕсли;

	Если ПоддерживаетToolCalls Тогда
		Tools = Неопределено;
		ЕстьTools = (Параметры.Свойство("Tools", Tools)
			И ТипЗнч(Tools) = Тип("Массив") И Tools.Количество() > 0);
		Если ЕстьTools Тогда
			Тело.Вставить("tools", Tools);

			// tool_choice пробрасывается только вместе с tools - без tools для
			// шлюза он бессмысленен (requestSchema допускает его отдельно, но
			// проброс без tools не имеет практического применения).
			ToolChoice = Неопределено;
			Если Параметры.Свойство("ToolChoice", ToolChoice) И ToolChoice <> Неопределено Тогда
				Тело.Вставить("tool_choice", ToolChoice);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат ЗаписатьJSONСтроку(Тело);

КонецФункции

// Сериализует массив внутренних сообщений в массив соответствий формата
// шлюза AgentRunner Cloud (messageSchema, идентична OpenAI Chat Completions):
//   role="system"/"user"    -> {role, content};
//   role="assistant"        -> {role, content, tool_calls?} - tool_calls
//                               сериализуется через ToolCallsВФорматOpenAI,
//                               если сообщение содержит непустой массив;
//   role="tool"              -> {role, content, tool_call_id, name?}.
//
// ВАЖНО (LLM-13, отличие от ar_LLMOpenAI/ar_LLMLocalCompatible): для
// assistant-сообщения с непустым tool_calls поле content сериализуется как
// пустая строка "", а НЕ Неопределено/null. requestSchema шлюза AgentRunner
// Cloud определяет content как z.string() без .nullable() - JSON null для
// этого поля не проходит валидацию Zod и вызовет 422, в отличие от OpenAI,
// где content: null для tool-calling сообщений - штатный паттерн.
//
// TODO (не входит в DoD LLM-12/LLM-13): лимиты протокола - максимум 200
// сообщений, content <= 200000 символов - здесь явно не валидируются.
//
// Параметры:
//   Сообщения - Массив - сообщения во внутреннем формате AgentRunner.
//
// Возвращаемое значение:
//   Массив - соответствия формата шлюза AgentRunner Cloud.
//
Функция СообщенияВФорматAgentRunnerCloud(Сообщения)

	Результат = Новый Массив;

	Для Каждого Сообщение Из Сообщения Цикл

		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Соответствие;

		Role = "";
		Сообщение.Свойство("role", Role);
		Role = Строка(Role);
		Элемент.Вставить("role", Role);

		Content = "";
		Сообщение.Свойство("content", Content);

		ToolCalls = Неопределено;
		Сообщение.Свойство("tool_calls", ToolCalls);
		ЕстьToolCalls = (ТипЗнч(ToolCalls) = Тип("Массив") И ToolCalls.Количество() > 0);

		Если Role = "assistant" И ЕстьToolCalls Тогда
			// content="" вместо Неопределено/null - см. doc-comment выше (Zod-схема
			// шлюза не допускает null для content).
			Элемент.Вставить("content", "");
			Элемент.Вставить("tool_calls", ToolCallsВФорматOpenAI(ToolCalls));
		Иначе
			Элемент.Вставить("content", Строка(Content));
		КонецЕсли;

		Если Role = "tool" Тогда
			ToolCallId = "";
			Сообщение.Свойство("tool_call_id", ToolCallId);
			Элемент.Вставить("tool_call_id", Строка(ToolCallId));

			ИмяTool = "";
			Если Сообщение.Свойство("name", ИмяTool) И НЕ ПустаяСтрока(Строка(ИмяTool)) Тогда
				Элемент.Вставить("name", Строка(ИмяTool));
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сериализует массив tool_calls (Структур) в массив Соответствий формата
// OpenAI - идентичен формату шлюза AgentRunner Cloud. Скопировано по
// паттерну ar_LLMOpenAI/ar_LLMLocalCompatible.ToolCallsВФорматOpenAI (каждый
// провайдер держит свою копию, не переиспользуют функции друг друга).
//
// Параметры:
//   ToolCalls - Массив - tool_calls во внутреннем формате AgentRunner
//               ({id, type, function:{name, arguments}}).
//
// Возвращаемое значение:
//   Массив - соответствия {id, type, function:{name, arguments}}.
//
Функция ToolCallsВФорматOpenAI(ToolCalls)

	Результат = Новый Массив;

	Для Каждого Вызов Из ToolCalls Цикл

		Если ТипЗнч(Вызов) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Соответствие;

		ИдВызова = "";
		Вызов.Свойство("id", ИдВызова);
		Элемент.Вставить("id", Строка(ИдВызова));

		ТипВызова = "function";
		Вызов.Свойство("type", ТипВызова);
		Элемент.Вставить("type", Строка(ТипВызова));

		ФункцияВызова = Неопределено;
		Вызов.Свойство("function", ФункцияВызова);

		ФункцияMap = Новый Соответствие;
		Если ТипЗнч(ФункцияВызова) = Тип("Структура") Тогда
			ИмяФункции = "";
			ФункцияВызова.Свойство("name", ИмяФункции);
			ФункцияMap.Вставить("name", Строка(ИмяФункции));

			Аргументы = "";
			ФункцияВызова.Свойство("arguments", Аргументы);
			ФункцияMap.Вставить("arguments", Строка(Аргументы));
		КонецЕсли;
		Элемент.Вставить("function", ФункцияMap);

		Результат.Добавить(Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конвертирует массив tool_calls из Соответствий (формат ответа шлюза,
// идентичен OpenAI) во внутренние Структуры через конструктор
// ar_LLMКонтракт.НовыйToolCall. Скопировано по паттерну
// ar_LLMOpenAI/ar_LLMLocalCompatible.ToolCallsИзФорматаOpenAI.
//
// Параметры:
//   ToolCallsRaw - Массив - элементы {id, type, function:{name, arguments}}
//                  из JSON-ответа шлюза.
//
// Возвращаемое значение:
//   Массив - tool_calls во внутреннем формате AgentRunner.
//
Функция ToolCallsИзФорматаOpenAI(ToolCallsRaw)

	Результат = Новый Массив;

	Для Каждого Вызов Из ToolCallsRaw Цикл

		Если ТипЗнч(Вызов) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		ИдВызова = Вызов.Получить("id");
		ИмяФ = "";
		АргументыФ = "";

		ФункцияRaw = Вызов.Получить("function");
		Если ТипЗнч(ФункцияRaw) = Тип("Соответствие") Тогда
			ЗначениеИмя = ФункцияRaw.Получить("name");
			Если ТипЗнч(ЗначениеИмя) = Тип("Строка") Тогда
				ИмяФ = ЗначениеИмя;
			КонецЕсли;
			ЗначениеАргументы = ФункцияRaw.Получить("arguments");
			Если ТипЗнч(ЗначениеАргументы) = Тип("Строка") Тогда
				АргументыФ = ЗначениеАргументы;
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(ar_LLMКонтракт.НовыйToolCall(
			?(ТипЗнч(ИдВызова) = Тип("Строка"), ИдВызова, ""), ИмяФ, АргументыФ));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает строку JSON-сериализации значения с настройками AgentRunner:
//   * двойные кавычки;
//   * сохранение null;
//   * даты в ISO 8601.
// Скопировано 1:1 из ar_LLMOpenAI.ЗаписатьJSONСтроку.
//
// Параметры:
//   Значение - Произвольный - значение для сериализации (обычно Соответствие).
//
// Возвращаемое значение:
//   Строка - JSON-представление значения.
//
Функция ЗаписатьJSONСтроку(Значение)

	НастройкиЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "", Истина);

	// Свойства СохранятьNull у НастройкиСериализацииJSON не существует (платформа
	// и так сериализует Неопределено как JSON null по умолчанию). Правильное имя
	// свойства формата дат - ФорматСериализацииДаты (проверено по реальному
	// использованию в БП: DataProcessors/МенеджерКонвертацииУправлениеПерсоналом).
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(НастройкиЗаписи);
	ЗаписатьJSON(Запись, Значение, НастройкиСериализации);
	Возврат Запись.Закрыть();

КонецФункции

// Десериализует JSON-строку в Соответствие/Массив (ЧитатьВСоответствие = Истина).
//
// Параметры:
//   СтрокаJSON - Строка - JSON-строка для разбора.
//
// Возвращаемое значение:
//   Соответствие, Массив - результат разбора JSON.
//
Функция ПрочитатьJSONСтроку(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Извлекает usage из JSON-ответа шлюза AgentRunner Cloud и кладёт в
// Результат.ТокеновВход/ТокеновВыход.
//
// В отличие от OpenAI (prompt_tokens/completion_tokens), шлюз возвращает
// usage.input_tokens/usage.output_tokens. При отсутствии блока usage -
// оставляет нули и пишет запись в журнал регистрации уровня Информация.
// Числовое приведение делегируется ar_LLMКонтракт.ИзвлечьЧисло (LLM-06).
//
// Параметры:
//   Ответ     - Соответствие - распарсенный JSON ответа шлюза.
//   Результат - Структура    - модифицируется: ТокеновВход / ТокеновВыход.
//
Процедура ПарситьUsage(Ответ, Результат)

	Usage = Ответ.Получить("usage");

	Если ТипЗнч(Usage) <> Тип("Соответствие") Тогда
		ЗаписьЖурналаРегистрации(
			"AgentRunner.LLM.Usage",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.ОбщиеМодули.ar_LLMAgentRunnerCloud,
			,
			НСтр("ru = 'Блок usage отсутствует в ответе AgentRunner Cloud; токены не учтены';
			    |en = 'Usage block is missing in AgentRunner Cloud response; tokens not counted'"));
		Возврат;
	КонецЕсли;

	Результат.ТокеновВход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("input_tokens"));
	Результат.ТокеновВыход = ar_LLMКонтракт.ИзвлечьЧисло(Usage.Получить("output_tokens"));

КонецПроцедуры

// LLM-14 (часть Б): balance_rub / low_balance - опциональные поля ВЕРХНЕГО
// УРОВНЯ успешного (200) ответа Чат(). Не путать с полями code/balance/
// limit/required тела ОШИБКИ 402 (см. ОписаниеОшибкиHTTP, часть A) - это
// независимый сценарий протокола.
//
// balance_rub отсутствует/не Число -> Результат.БалансРуб остаётся
// Неопределено (дефолт НовыйРезультат()), НЕ 0 - чтобы не путать
// "нет данных" с "баланс = 0".
// low_balance отсутствует/не Булево -> Результат.БалансНизкий остаётся Ложь.
//
// В отличие от ПарситьUsage (делегирует числовое приведение
// ar_LLMКонтракт.ИзвлечьЧисло, который трактует отсутствие/некорректный тип
// как 0) - здесь типы НЕ приводятся принудительно: отсутствие/некорректность
// этих двух полей не эквивалентно "0"/"Ложь" по данным, а означает "шлюз не
// прислал данные о балансе", что для БалансРуб дефолтится в Неопределено.
//
// Экспортная (LLM-14): нужна юнит-тестовому модулю ar_ТестыLLMAgentRunnerCloud
// для проверки парсинга balance_rub/low_balance без реального HTTP-вызова
// шлюза - по аналогии с ОписаниеОшибкиHTTP/ИзвлечьКодОшибки выше.
//
// Параметры:
//   Ответ     - Соответствие - распарсенный JSON успешного ответа шлюза.
//   Результат - Структура    - модифицируется на месте: БалансРуб/БалансНизкий.
//
Процедура ПарситьБаланс(Ответ, Результат) Экспорт

	БалансRub = Ответ.Получить("balance_rub");
	Если ТипЗнч(БалансRub) = Тип("Число") Тогда
		Результат.БалансРуб = БалансRub;
	КонецЕсли;

	LowBalance = Ответ.Получить("low_balance");
	Если ТипЗнч(LowBalance) = Тип("Булево") Тогда
		Результат.БалансНизкий = LowBalance;
	КонецЕсли;

КонецПроцедуры

// Формирует текст ошибки по неуспешному ответу ar_HTTP.ВыполнитьPOST.
// Вынесена из Чат() отдельной функцией, чтобы не раздувать её цикломатическую
// и когнитивную сложность (три независимых случая: сетевая ошибка, HTTP 402,
// прочие HTTP-коды).
//
// Экспортная (LLM-14): нужна юнит-тестовому модулю ar_ТестыLLMAgentRunnerCloud
// для проверки текстов ошибок 402 без реального HTTP-вызова шлюза - по
// аналогии с паттерном ar_ТестыHTTPСервисов (прямой вызов чистых функций
// без побочных эффектов на ИБ).
//
// Параметры:
//   HTTPОтвет - Структура - результат ar_HTTP.ВыполнитьPOST
//               {КодСостояния, Тело, Ошибка}.
//
// Возвращаемое значение:
//   Строка - текст ошибки для Результат.Ошибка.
//
Функция ОписаниеОшибкиHTTP(HTTPОтвет) Экспорт

	Если HTTPОтвет.КодСостояния = 0 Тогда
		Возврат ?(ПустаяСтрока(HTTPОтвет.Ошибка), "Сетевая ошибка", HTTPОтвет.Ошибка);
	КонецЕсли;

	// LLM-12/LLM-14: 402 - шлюз не может выполнить запрос по денежной причине.
	// LLM-14 (часть A): начиная с этой версии шлюз различает две причины
	// через поле "code" JSON-тела ответа: "insufficient_balance" (баланс
	// исчерпан) и "limit_exceeded" (превышен dailyLimitRub/monthlyLimitRub
	// ключа - настраивается пользователем в личном кабинете agentrunner.ru
	// независимо от баланса). Текст ошибки читаемый, без утечки числовых
	// значений (balance/required/limit) в лог/сообщение - осознанное
	// ограничение протокола (см. .docs/specs/LLM-14.md, п. 2).
	// Нетранзиентная ошибка - ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка уже не
	// считает 402 транзиентным (код не входит ни в 429, ни в 5xx, ни в 0),
	// доп. изменений там не требуется.
	Если HTTPОтвет.КодСостояния = 402 Тогда
		КодОшибки = ИзвлечьКодОшибки(HTTPОтвет.Тело);
		Если КодОшибки = "limit_exceeded" Тогда
			Возврат НСтр("ru = 'Превышен лимит расходов API-ключа AgentRunner Cloud
				|(день/месяц). Лимит настраивается в личном кабинете
				|agentrunner.ru - можно снять или увеличить.';
				|en = 'AgentRunner Cloud API key spending limit exceeded
				|(day/month). Configurable in the agentrunner.ru dashboard.'");
		КонецЕсли;
		// "insufficient_balance", неизвестный или отсутствующий code (старая
		// версия шлюза, обрезанное тело и т.п.) - прежний безопасный текст.
		Возврат НСтр("ru = 'Недостаточно средств на балансе шлюза AgentRunner
			|Cloud. Пополните счёт в личном кабинете agentrunner.ru.';
			|en = 'Insufficient balance on the AgentRunner Cloud gateway.
			|Top up your account at agentrunner.ru.'");
	КонецЕсли;

	Возврат СообщениеОбОшибкеHTTP(HTTPОтвет.КодСостояния, HTTPОтвет.Тело);

КонецФункции

// Формирует текст ошибки для HTTP-кода != 200 (кроме 402, который
// обрабатывается отдельной веткой в ОписаниеОшибкиHTTP). Композиция краткого
// тела ошибки (ИзвлечьКраткоеТелоОшибки) и префикса по коду (ПрефиксОшибкиПоКоду).
//
// Параметры:
//   КодСостояния - Число  - HTTP-код ответа.
//   Тело         - Строка - тело HTTP-ответа (ожидается JSON или пустая строка).
//
// Возвращаемое значение:
//   Строка - человекочитаемый текст ошибки.
//
Функция СообщениеОбОшибкеHTTP(КодСостояния, Тело)

	КраткоеТело = ИзвлечьКраткоеТелоОшибки(Тело);
	Префикс = ПрефиксОшибкиПоКоду(КодСостояния);

	Если ПустаяСтрока(КраткоеТело) Тогда
		Возврат Префикс;
	КонецЕсли;

	Возврат Префикс + ": " + КраткоеТело;

КонецФункции

// Извлекает краткое человекочитаемое тело ошибки из JSON-тела ответа шлюза.
// Defensive: формат тела ошибки шлюза в задаче не специфицирован - если
// тело не является валидным JSON или не содержит "message"/"error" (Строка),
// возвращается пустая строка.
//
// Параметры:
//   Тело - Строка - тело HTTP-ответа (ожидается JSON или пустая строка).
//
// Возвращаемое значение:
//   Строка - краткое тело ошибки либо пустая строка.
//
Функция ИзвлечьКраткоеТелоОшибки(Тело)

	Если ТипЗнч(Тело) <> Тип("Строка") Или ПустаяСтрока(Тело) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Распарсенное = ПрочитатьJSONСтроку(Тело);
	Исключение
		// Невалидный JSON в теле ошибки - не является поводом падать.
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Распарсенное) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Сообщ = Распарсенное.Получить("message");
	Если ТипЗнч(Сообщ) <> Тип("Строка") Тогда
		Сообщ = Распарсенное.Получить("error");
	КонецЕсли;

	Если ТипЗнч(Сообщ) = Тип("Строка") Тогда
		Возврат Сообщ;
	КонецЕсли;

	Возврат "";

КонецФункции

// LLM-14 (часть A): извлекает машиночитаемый код ошибки ("code") из JSON-тела
// ответа 402 шлюза AgentRunner Cloud - "insufficient_balance" | "limit_exceeded".
// Defensive, по образцу ИзвлечьКраткоеТелоОшибки (не дублирует её парсинг
// "message"/"error", но независимо разбирает то же JSON-тело под другой ключ):
// если тело не является валидным JSON, не Соответствие, либо поле "code"
// отсутствует/не Строка - возвращается "" (вызывающий код трактует это как
// "код неизвестен" и применяет прежний безопасный текст про баланс).
//
// Экспортная (LLM-14): нужна юнит-тестовому модулю ar_ТестыLLMAgentRunnerCloud
// (см. ОписаниеОшибкиHTTP выше).
//
// Параметры:
//   Тело - Строка - тело HTTP-ответа 402 (ожидается JSON или пустая строка).
//
// Возвращаемое значение:
//   Строка - значение поля "code" либо "" при отсутствии/невалидном JSON.
//
Функция ИзвлечьКодОшибки(Тело) Экспорт

	Если ТипЗнч(Тело) <> Тип("Строка") Или ПустаяСтрока(Тело) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Распарсенное = ПрочитатьJSONСтроку(Тело);
	Исключение
		// Невалидный JSON в теле ошибки - не является поводом падать.
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Распарсенное) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Код = Распарсенное.Получить("code");
	Если ТипЗнч(Код) = Тип("Строка") Тогда
		Возврат Код;
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает человекочитаемый префикс ошибки по HTTP-коду.
// 502/504/прочие 5xx попадают под общее правило диспетчера
// ЭтоТранзиентнаяОшибка (код >= 500 -> транзиентная, ретраится).
//
// Параметры:
//   КодСостояния - Число - HTTP-код ответа.
//
// Возвращаемое значение:
//   Строка - человекочитаемый префикс сообщения об ошибке.
//
Функция ПрефиксОшибкиПоКоду(КодСостояния)

	Если КодСостояния = 401 Или КодСостояния = 403 Тогда
		Возврат "Ошибка авторизации LLM: " + Формат(КодСостояния, "ЧГ=");
	ИначеЕсли КодСостояния = 422 Тогда
		Возврат "Ошибка валидации запроса LLM: 422";
	ИначеЕсли КодСостояния = 429 Тогда
		Возврат "Rate limit LLM: 429";
	ИначеЕсли КодСостояния >= 500 Тогда
		Возврат "Ошибка сервера LLM: " + Формат(КодСостояния, "ЧГ=");
	Иначе
		Возврат "Ошибка LLM: " + Формат(КодСостояния, "ЧГ=");
	КонецЕсли;

КонецФункции

#КонецОбласти
