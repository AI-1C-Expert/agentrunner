////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ИнструментыПлан (Tool - план запуска).
//
// Реализует tools:
//   update_plan     — объявить/обновить план работы по многоэтапной задаче (PLAN-03).
//   wait_for_event  — объявить паузу до наступления события/дедлайна (PLAN-11).
//
// S4 (шапка Tasks_plan.md): wait_for_event - вторая функция в этом же модуле,
// отдельный модуль не заведён (по образцу ar_ИнструментыРеестрПоиск: find_tools +
// describe_tool в одном модуле).
//
// wait_for_event НЕ пишет статус запуска в ИБ напрямую (R1 - более строгое
// требование, чем у ask_user/ar_ИнструментыВзаимодействие, у которого есть отдельная
// сущность approval-очереди). У wait_for_event такой сущности нет: единственный
// держатель финального статуса запуска - ar_RuntimeЦикл.ЗавершитьЗапуск. Поэтому
// tool только валидирует вход и возвращает JSON-маркер паузы
// {"paused":"awaiting_event", object_type, filter, deadline_hours} - постановку
// статуса PausedForEvent и запись ar_ОжидаетСобытия/ar_ОжиданиеДо делает ЦИКЛ
// в новой ветке «7б» (см. ar_RuntimeЦикл, спека PLAN-11, «Точная механика»).
// НЕ повторять путь ask_user (привилегированный вызов из tool) - это нарушит
// R1 и дух S2 (новый привилегированный фасад не нужен).
//
// Контракт tool-функции:
//   Вход:  Аргументы (Строка) — JSON-объект аргументов от LLM.
//          Контекст (Структура) — КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//          БЕЗ Состояние (Plan-ревью R1, ar_RuntimeЦикл.КонтекстЗапуска) - tool
//          физически не может прочитать/записать текущий план запуска.
//   Выход: Строка JSON — observation для добавления в контекст как role:tool.
//          Никогда не пустая; при ошибке — {"error":"<код>"}.
//
// Роль update_plan в этой задаче узкая: провалидировать и нормализовать
// присланные LLM пункты через ar_ПланЗапуска (без доступа к предыдущему плану -
// merge-семантика здесь не применяется буквально, вызывается
// Применить(НовыйПлан(), ПунктыИзLLM)). Настоящее слияние с историей и запись
// в ar_Запуски (событие PlanUpdated) делает цикл ar_RuntimeЦикл (PLAN-04) - вне
// скоупа этой задачи.
//
// update_plan read-only с точки зрения ИБ: не пишет в Состояние, не читает и
// не пишет РегистрСведений.ar_Запуски, HTTP не делает. Привилегированный режим
// используется ТОЛЬКО в ЗарегистрироватьTools (запись в служебный реестр
// ar_Инструменты) — сама выдача не требует повышенных прав (Plan §3.3).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/PLAN-03.md, .docs/specs/PLAN-02.md, .docs/specs/PLAN-01.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня модуля ar_ИнструментыПлан. Маршрутизирует вызов по имени
// процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ИнструментыДиспетчер.ВыполнитьПроцедуруToolПлан.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры ("ОбновитьПлан").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ОбновитьПлан" Тогда
		Возврат ОбновитьПлан(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ОжидатьСобытия" Тогда
		Возврат ОжидатьСобытия(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Идемпотентно создаёт/обновляет запись реестра ar_Инструменты для tool update_plan
// (PLAN-03). Вызывается из ar_ИнструментыДиспетчер.ЗарегистрироватьВсеTools() и из
// обработчика обновления расширения. Привилегированный режим включается
// локально только для записи в служебный реестр ядра, с парным сбросом в
// блоке Исключение (Plan §1.3).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } — статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинИнструмент(ОписаниеToolUpdatePlan(), Статистика);
		ЗарегистрироватьОдинИнструмент(ОписаниеToolWaitForEvent(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

// Tool update_plan: провалидировать и нормализовать пункты плана,
// присланные LLM, вернуть короткий observation с планом и прогрессом.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM. Поля:
//    steps (обяз.) - массив объектов {title: string, status: string}.
//                    status - одно из pending|in_progress|done|skipped, вне
//                    словаря/отсутствует - нормализуется в pending силами
//                    ar_ПланЗапуска.
//    note  (опц.)  - строка, комментарий агента. Не участвует в контракте
//                    ar_ПланЗапуска, маскируется и возвращается как есть.
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}. DryRun
//              не даёт отдельной ветки: update_plan не мутирует ИБ и не
//              создаёт approval-запись, поведение то же, что и без DryRun.
//
// Возвращаемое значение:
//  Строка - JSON {"plan":[{"title":"...","status":"..."}],"progress":"N/M"
//           [,"truncated":true][,"note":"..."]} либо {"error":"<код>"}.
//
Функция ОбновитьПлан(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Возврат ОбновитьПланВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool wait_for_event: объявить паузу до наступления события по объекту
// метаданных (или до истечения deadline_hours). Сам tool НЕ ставит статус
// запуска и НЕ пишет ar_ОжидаетСобытия/ar_ОжиданиеДо в ИБ (R1) - это делает
// ar_RuntimeЦикл (ветка «7б») по маркеру паузы, который здесь возвращается.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы от LLM. Поля:
//    object_type    (обяз.) - строка, полное имя типа метаданных
//                    ("Справочник.Контрагенты", "Документ.СчетНаОплатуПокупателю", ...).
//                    Должен быть либо в ar_ОбработчикПодписок.ГорячиеТипы(),
//                    либо резолвиться через Метаданные.НайтиПоПолномуИмени в
//                    класс Справочник/Документ/РегистрСведений (R3).
//    filter         (опц.)  - плоский JSON-объект «реквизит = значение» (R4),
//                    по умолчанию {} - пропускать любое событие этого типа.
//    deadline_hours (обяз.) - число часов ожидания от текущего момента,
//                    0 < deadline_hours <= 720 (30 суток).
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, Sequence, ...}.
//
// Возвращаемое значение:
//  Строка - JSON-observation:
//    * DryRun=Истина -> {"dry_run":true,"would_wait_for":"<object_type>"}
//    * Нормально     -> {"paused":"awaiting_event","object_type":"...",
//                        "filter":{...},"deadline_hours":N}
//    * Ошибка        -> {"error":"<код>"}
//
Функция ОжидатьСобытия(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Возврат ОжидатьСобытияВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSON("internal_error: " + ТекстОшибки);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// update_plan: валидация и нормализация без истории.

// Основная логика tool update_plan. Выделена из ОбновитьПлан, чтобы внешний
// Попытка/Исключение ловил любые непредвиденные ошибки.
//
// Алгоритм (см. .docs/specs/PLAN-03.md, раздел «Поведение»):
//  1. Разбор АргументыJSON через ar_JSON.ИзJSON - при ошибке парсинга получаем
//     пустое Соответствие, не исключение.
//  2. Извлечение steps - если это не Массив или отсутствует, invalid_steps
//     (единственный обязательный параметр).
//  3. Извлечение note (опционально), маскировка секретов.
//  4. Передача steps в ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(),
//     steps) - НЕ ar_ПланЗапуска.Применить(ПредыдущийПлан, ...) буквально:
//     предыдущего плана внутри tool нет (R1 - Состояние недоступно). Так
//     нормализуются и усекаются присланные пункты по тем же правилам
//     (лимиты 12/150, фильтрация мусора), но БЕЗ merge с историей.
//  5. Формирование короткого observation: plan (Результат.Пункты),
//     progress ("<Закрыто>/<Всего>" через ar_ПланЗапуска.Прогресс),
//     truncated:true при Результат.Усечено.
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы tool (см. ОбновитьПлан).
//  Контекст  - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. ОбновитьПлан).
//
Функция ОбновитьПланВнутр(Знач Аргументы, Знач Контекст)

	ДанныеJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_steps");
	КонецЕсли;

	СырыеШаги = ДанныеJSON.Получить("steps");
	Если ТипЗнч(СырыеШаги) <> Тип("Массив") Тогда
		Возврат ОшибочныйJSON("invalid_steps");
	КонецЕсли;

	СтрокаNote = СтрокаNoteИзАргументов(ДанныеJSON);

	// ar_JSON.ИзJSON разбирает JSON-объекты как Соответствие, а не Структура
	// (докстринг ar_JSON.ИзJSON, платформенный ПрочитатьJSON с
	// ПрочитатьВСоответствие=Истина). ar_ПланЗапуска.НормализоватьПунктLLM
	// требует строго Тип("Структура") для каждого элемента - без конвертации
	// любой корректный вход отбрасывается как мусор (ревью 1, замечание 1).
	ШагиДляПланировщика = ПривестиШагиКСтруктурам(СырыеШаги);

	// DryRun (Контекст.DryRun = Истина) сознательно НЕ даёт отдельной ветки с
	// фиктивным ответом, в отличие от ask_user: update_plan не мутирует ИБ и
	// не создаёт approval-запись, поэтому поведение одинаковое с обычным
	// вызовом (см. спеку PLAN-03, «Поведение», шаг 6).

	// Предыдущего плана внутри tool нет (R1) - НовыйПлан() как база слияния,
	// это нормализация/усечение входа LLM, а не честный merge с историей.
	Результат = ar_ПланЗапуска.Применить(ar_ПланЗапуска.НовыйПлан(), ШагиДляПланировщика);
	Прогресс   = ar_ПланЗапуска.Прогресс(Результат);

	ОтветПлан = Новый Массив;
	Для Каждого Пункт Из Результат.Пункты Цикл
		ЭлементПлана = Новый Структура;
		ЭлементПлана.Вставить("title", Пункт.Заголовок);
		ЭлементПлана.Вставить("status", Пункт.Статус);
		ОтветПлан.Добавить(ЭлементПлана);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("plan", ОтветПлан);
	Ответ.Вставить("progress", Строка(Прогресс.Закрыто) + "/" + Строка(Прогресс.Всего));

	Если Результат.Усечено Тогда
		Ответ.Вставить("truncated", Истина);
	КонецЕсли;

	Если СтрокаNote <> Неопределено Тогда
		Ответ.Вставить("note", СтрокаNote);
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Конвертирует массив сырых элементов steps (каждый - Соответствие, как их
// разбирает ar_JSON.ИзJSON) в массив Структур с полями title/status, как их
// ожидает ar_ПланЗапуска.НормализоватьПунктLLM (строгая проверка
// ТипЗнч(...) = Тип("Структура")). Элемент, который сам не является
// Соответствие (мусор внутри массива steps), передаётся дальше как есть -
// ar_ПланЗапуска отбросит его самостоятельно как невалидный тип.
//
// Экспортная (PLAN-04, уточнение U7): переиспользуется из ar_RuntimeЦикл
// (ОбработатьРезультатUpdatePlan) - та же граница типов Соответствие/Структура
// возникает при разборе observation update_plan цикла, что и здесь при разборе
// аргументов steps. Единственная точка конвертации, дублирование в третьем
// месте не допускается.
//
// Параметры:
//  СырыеШаги - Массив - элементы steps после ar_JSON.ИзJSON (обычно
//              Соответствие с ключами title/status, но тип элементов не
//              гарантирован - вход от LLM).
//
// Возвращаемое значение:
//  Массив - элементы Структура("title, status", ...) там, где конвертация
//  возможна, либо исходный элемент без изменений (для дальнейшей отбраковки
//  ar_ПланЗапуска как мусора).
//
Функция ПривестиШагиКСтруктурам(Знач СырыеШаги) Экспорт

	Результат = Новый Массив;

	// Защитная проверка типа входа (PLAN-04): функция стала экспортной и
	// вызывается из второго места (ar_RuntimeЦикл) - вызывающая сторона там
	// уже проверяет ТипЗнч(...) = Тип("Массив") перед вызовом, но повторная
	// проверка здесь не даёт функции упасть, если контракт нарушит будущий
	// вызывающий код.
	Если ТипЗнч(СырыеШаги) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СыройЭлемент Из СырыеШаги Цикл
		// Соответствие.Получить(<Ключ>) безопасен на отсутствующем ключе -
		// работает как оператор [], возвращает Неопределено, исключения не
		// бросает (в отличие от обращения к отсутствующему реквизиту
		// Структуры через точку) - см. платформенную документацию метода.
		// Обёртка Попытка здесь избыточна.
		Если ТипЗнч(СыройЭлемент) = Тип("Соответствие") Тогда
			ЗначениеЗаголовка = СыройЭлемент.Получить("title");
			ЗначениеСтатуса   = СыройЭлемент.Получить("status");
			Структурированный = Новый Структура("title, status", ЗначениеЗаголовка, ЗначениеСтатуса);
			Результат.Добавить(Структурированный);
		Иначе
			// Не Соответствие (например Строка, Число, Массив, Неопределено) -
			// заведомый мусор, ar_ПланЗапуска.НормализоватьПунктLLM отбросит
			// его сам по проверке ТипЗнч(...) <> Тип("Структура").
			Результат.Добавить(СыройЭлемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлекает опциональное поле note из разобранных аргументов и маскирует в
// нём секреты (по аналогии с question/hint у ask_user). Отсутствующее или
// не строковое значение - Неопределено (поле не попадёт в observation).
//
// Параметры:
//  ДанныеJSON - Соответствие - разобранные аргументы tool (ar_JSON.ИзJSON).
//
// Возвращаемое значение:
//  Строка, Неопределено - замаскированный текст note либо Неопределено.
//
Функция СтрокаNoteИзАргументов(Знач ДанныеJSON)

	ЗначениеNote = ДанныеJSON.Получить("note");
	Если ТипЗнч(ЗначениеNote) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Note = СокрЛП(ЗначениеNote);
	Если ПустаяСтрока(Note) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ar_Утилиты.МаскироватьСекреты(Note);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// wait_for_event: валидация и маркер паузы (PLAN-11).

// Основная логика tool wait_for_event. Выделена из ОжидатьСобытия, чтобы
// внешний Попытка/Исключение ловил любые непредвиденные ошибки.
//
// Алгоритм (см. .docs/specs/PLAN-11.md, раздел «Поведение»):
//  1. Разбор Аргументы через ar_JSON.ИзJSON.
//  2. Валидация object_type: обязателен, должен пройти ПроверитьТипОбъекта
//     (R3) - иначе unsupported_object_type ДО любой мутации.
//  3. Валидация deadline_hours: обязателен, число, 0 < X <= 720 - иначе
//     deadline_hours_required.
//  4. Валидация filter: опционален, если задан - должен быть Соответствие
//     (объект в JSON), иначе invalid_filter.
//  5. DryRun - фиктивный ответ, без постановки маркера паузы.
//  6. Запуск в финальном статусе - run_is_final, пауза не ставится.
//  7. Нормальный путь: вернуть JSON-маркер паузы "awaiting_event" с эхом
//     object_type/filter/deadline_hours - ar_RuntimeЦикл прочитает их из
//     observation и сам поставит PausedForEvent/ar_ОжидаетСобытия/
//     ar_ОжиданиеДо через ЗавершитьЗапуск (R1, S2 - см. докстринг модуля).
//
// Параметры:
//  Аргументы - Строка    - JSON-аргументы tool (см. ОжидатьСобытия).
//  Контекст  - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. ОжидатьСобытия).
//
Функция ОжидатьСобытияВнутр(Знач Аргументы, Знач Контекст)

	ДанныеJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("object_type_required");
	КонецЕсли;

	// --- object_type ----------------------------------------------------------

	ТипОбъекта = ДанныеJSON.Получить("object_type");
	Если ТипЗнч(ТипОбъекта) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(ТипОбъекта)) Тогда
		Возврат ОшибочныйJSON("object_type_required");
	КонецЕсли;
	ТипОбъекта = СокрЛП(ТипОбъекта);

	Если Не ТипОбъектаПоддерживается(ТипОбъекта) Тогда
		Возврат ОшибочныйJSON("unsupported_object_type");
	КонецЕсли;

	// --- deadline_hours ---------------------------------------------------------

	DeadlineHours = ДанныеJSON.Получить("deadline_hours");
	МаксDeadlineHours = 720; // 30 суток (см. спеку PLAN-11, «Риски» - не догма).
	Если ТипЗнч(DeadlineHours) <> Тип("Число") Или DeadlineHours <= 0
		Или DeadlineHours > МаксDeadlineHours Тогда
		Возврат ОшибочныйJSON("deadline_hours_required");
	КонецЕсли;

	// --- filter (опционален) -----------------------------------------------------

	ЗначениеФильтра = ДанныеJSON.Получить("filter");
	Если ЗначениеФильтра = Неопределено Тогда
		Фильтр = Новый Структура;
	ИначеЕсли ТипЗнч(ЗначениеФильтра) = Тип("Соответствие") Тогда
		// R4/D3: фильтр обязан быть ПЛОСКИМ - ни один из его значений сам не
		// должен быть объектом/массивом (AI-аудит PLAN-11: без этой проверки
		// вложенный объект/массив от LLM эхом уходил бы в observation молча,
		// нарушая контракт «без вложенных путей и операторов»).
		Если Не ЗначенияФильтраПлоские(ЗначениеФильтра) Тогда
			Возврат ОшибочныйJSON("invalid_filter");
		КонецЕсли;
		Фильтр = СоответствиеВСтруктуруПлоско(ЗначениеФильтра);
	Иначе
		Возврат ОшибочныйJSON("invalid_filter");
	КонецЕсли;

	// --- DryRun -----------------------------------------------------------------

	DryRun = ar_ИнструментыДиспетчер.ИзвлечьDryRun(Аргументы);
	Если DryRun Тогда
		ОбъектDryRun = Новый Структура;
		ОбъектDryRun.Вставить("dry_run", Истина);
		ОбъектDryRun.Вставить("would_wait_for", ТипОбъекта);
		Возврат ar_JSON.ВЗначениеJSON(ОбъектDryRun);
	КонецЕсли;

	// --- Проверка финального статуса запуска -------------------------------------

	RunId = "";
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("RunId", RunId);
	КонецЕсли;
	Если ТипЗнч(RunId) <> Тип("Строка") Тогда
		RunId = "";
	КонецЕсли;

	Если Не ПустаяСтрока(RunId) И ar_ИнструментыВзаимодействие.ЗапускВФинальномСтатусе(RunId) Тогда
		Возврат ОшибочныйJSON("run_is_final");
	КонецЕсли;

	// --- Маркер паузы для ar_RuntimeЦикл (R1 - tool не пишет ИБ статус) ----------

	ОбъектПаузы = Новый Структура;
	ОбъектПаузы.Вставить("paused",         "awaiting_event");
	ОбъектПаузы.Вставить("object_type",    ТипОбъекта);
	ОбъектПаузы.Вставить("filter",         Фильтр);
	ОбъектПаузы.Вставить("deadline_hours", DeadlineHours);
	Возврат ar_JSON.ВЗначениеJSON(ОбъектПаузы);

КонецФункции

// Проверить, поддерживается ли тип объекта для wait_for_event (R3).
// Два пути: push (ar_ОбработчикПодписок.ГорячиеТипы) или polling
// (Метаданные.НайтиПоПолномуИмени в класс Справочник/Документ/РегистрСведений).
// Точный образец второй проверки - ar_Планировщик.ОбработатьОдинТипПодписок
// (D9: «поддерживаем только Справочник, Документ, РегистрСведений»), но здесь
// без побочных эффектов - только валидация типа.
//
// Параметры:
//  ТипОбъекта - Строка - полное имя типа метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если тип поддерживается.
//
Функция ТипОбъектаПоддерживается(Знач ТипОбъекта)

	Если ar_ОбработчикПодписок.ГорячиеТипы().Найти(ТипОбъекта) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ТипОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// Класс объекта метаданных определяется коллекциями Метаданные.*.Содержит,
	// как в БСП (ОбщегоНазначения.ЭтоСправочник/ЭтоДокумент/ЭтоРегистрСведений).
	// Имя типа "ОбъектМетаданных.Справочник" в платформе НЕ существует - Тип()
	// на нём бросает «Тип не определен», что и ловил живой прогон PLAN-11.
	Возврат Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или Метаданные.Документы.Содержит(ОбъектМетаданных)
		Или Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных);

КонецФункции

// R4/D3: проверка, что фильтр ПЛОСКИЙ - ни одно значение не является
// вложенным объектом или массивом. Контракт tool обещает только плоское
// сравнение по И (ar_ОбработчикПодписок.ПроверитьФильтр сравнивает
// Строка(Источник[Реквизит])), поэтому вложенную структуру надо отклонить
// явно, а не отправить эхом в observation.
//
// Параметры:
//  Фильтр - Соответствие - разобранный JSON-объект filter.
//
// Возвращаемое значение:
//  Булево - Истина, если все значения скалярные.
//
Функция ЗначенияФильтраПлоские(Знач Фильтр)

	Для Каждого КлючЗначение Из Фильтр Цикл
		Значение = КлючЗначение.Значение;
		Если ТипЗнч(Значение) = Тип("Соответствие")
			ИЛИ ТипЗнч(Значение) = Тип("Массив")
			ИЛИ ТипЗнч(Значение) = Тип("Структура") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Конвертирует плоское Соответствие (результат ar_JSON.ИзJSON для JSON-объекта)
// в Структуру с теми же парами ключ/значение - формат filter, ожидаемый
// вниз по цепочке (observation, ar_ОбработчикПодписок.ПроверитьФильтр читает
// Соответствие из ar_ФильтрJSON после отдельной сериализации, здесь же
// значение просто эхом уходит в JSON-observation через ar_JSON.ВЗначениеJSON,
// который одинаково сериализует и Структуру, и Соответствие). Структура
// выбрана для единообразия с остальными полями ОбъектПаузы.
//
// НЕ объединена с ПривестиШагиКСтруктурам (AI-аудит PLAN-11): та функция
// конвертирует МАССИВ элементов с фиксированными полями title/status и
// fallback-веткой для мусора (её контракт - подготовка входа для
// ar_ПланЗапуска.НормализоватьПунктLLM), эта - произвольное плоское
// Соответствие с любыми ключами (контракт - эхо filter в observation).
// Разное назначение и форма входа, общая абстракция добавила бы косвенность
// без выигрыша.
//
// Параметры:
//  Фильтр - Соответствие - разобранный JSON-объект filter.
//
// Возвращаемое значение:
//  Структура - те же пары ключ/значение.
//
Функция СоответствиеВСтруктуруПлоско(Знач Фильтр)
	Результат = Новый Структура;
	Для Каждого КлючЗначение Из Фильтр Цикл
		Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// JSON-строка ошибки-observation: {"error":"<текст>"}.
//
// Параметры:
//  ТекстОшибки - Строка - код/текст ошибки.
//
// Возвращаемое значение:
//  Строка - JSON {"error":"<текст>"}.
//
Функция ОшибочныйJSON(Знач ТекстОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""tool_error""}", Результат);
КонецФункции

// Описание tool update_plan для регистрации в ar_Инструменты.
//
// Возвращаемое значение:
//  Структура - поля Имя, Описание, КраткоеОписание, ОбщийМодуль, ИмяПроцедуры,
//  RiskLevel, ТребуетApproval, Включён, Версия, JSONManifest.
//
Функция ОписаниеToolUpdatePlan()

	// OpenAI tool-format (parameters, не Anthropic input_schema) - единый
	// контракт для всех LLM-провайдеров (образец: ar_ИнструментыРеестрПоиск.ОписаниеToolFindTools).
	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""update_plan"",
	|    ""description"": ""Объявить или обновить план работы по многоэтапной задаче. Вызывай на задачах из нескольких шагов, чтобы оператор видел прогресс. План - твоё намерение: переписывай его, если обстоятельства изменились."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""steps""],
	|      ""properties"": {
	|        ""steps"": {
	|          ""type"": ""array"",
	|          ""items"": {
	|            ""type"": ""object"",
	|            ""properties"": {
	|              ""title"": { ""type"": ""string"", ""description"": ""Краткий заголовок шага плана, до 150 символов."" },
	|              ""status"": { ""type"": ""string"", ""enum"": [""pending"", ""in_progress"", ""done"", ""skipped""], ""description"": ""Статус шага. Неизвестное или отсутствующее значение трактуется как pending."" }
	|            },
	|            ""required"": [""title""]
	|          },
	|          ""description"": ""Список шагов плана, до 12 элементов. Присылай полный актуальный список при каждом вызове.""
	|        },
	|        ""note"": {
	|          ""type"": ""string"",
	|          ""description"": ""Опциональный короткий комментарий о текущем состоянии работы.""
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя",              "update_plan");
	Описание.Вставить("Описание",
		НСтр("ru = 'Объявить или обновить план работы по многоэтапной задаче. Вызывай на задачах из нескольких шагов, чтобы оператор видел прогресс. План — твоё намерение: переписывай его, если обстоятельства изменились.';
		|en = 'Announce or update the work plan for a multi-step task. Call it on tasks with several steps so the operator can see progress. The plan is your intent: rewrite it if circumstances change.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Объявить или обновить план работы';
		|en = 'Announce or update the work plan'"));
	Описание.Вставить("ОбщийМодуль",      "ar_ИнструментыПлан");
	Описание.Вставить("ИмяПроцедуры",     "ОбновитьПлан");
	Описание.Вставить("RiskLevel",        "Чтение");
	Описание.Вставить("ТребуетApproval",  Ложь);
	Описание.Вставить("Включён",          Истина);
	Описание.Вставить("Версия",           "1.0.0");
	Описание.Вставить("JSONManifest",     МанифестJSON);
	Возврат Описание;

КонецФункции

// Описание tool wait_for_event для регистрации в ar_Инструменты (PLAN-11).
//
// Возвращаемое значение:
//  Структура - поля Имя, Описание, КраткоеОписание, ОбщийМодуль, ИмяПроцедуры,
//  RiskLevel, ТребуетApproval, Включён, Версия, JSONManifest.
//
Функция ОписаниеToolWaitForEvent()

	// OpenAI tool-format (parameters, не Anthropic input_schema) - единый
	// контракт для всех LLM-провайдеров (образец: ОписаниеToolUpdatePlan выше).
	МанифестJSON = "{
	|  ""type"": ""function"",
	|  ""function"": {
	|    ""name"": ""wait_for_event"",
	|    ""description"": ""Приостановить работу до наступления события по объекту 1С (создание/изменение) либо до истечения срока ожидания. Использовать, когда для продолжения задачи нужно дождаться внешнего события - например, поступления оплаты или изменения статуса документа. Tool приостанавливает цикл и не выполняется повторно, пока событие не наступит или не истечёт дедлайн."",
	|    ""parameters"": {
	|      ""type"": ""object"",
	|      ""required"": [""object_type"", ""deadline_hours""],
	|      ""properties"": {
	|        ""object_type"": {
	|          ""type"": ""string"",
	|          ""description"": ""Полное имя типа метаданных 1С, событие по которому ожидается, например 'Справочник.Контрагенты' или 'Документ.СчетНаОплатуПокупателю'.""
	|        },
	|        ""filter"": {
	|          ""type"": ""object"",
	|          ""description"": ""Необязательный плоский фильтр 'реквизит = значение' по объекту (без вложенных путей и операторов). Пустой или отсутствующий фильтр - ждать любое событие этого типа.""
	|        },
	|        ""deadline_hours"": {
	|          ""type"": ""number"",
	|          ""description"": ""Через сколько часов ожидание считается истёкшим (число больше 0, не более 720 - 30 суток). Обязательный параметр.""
	|        }
	|      },
	|      ""additionalProperties"": false
	|    }
	|  }
	|}";

	Описание = Новый Структура;
	Описание.Вставить("Имя",              "wait_for_event");
	Описание.Вставить("Описание",
		НСтр("ru = 'Приостановить работу до наступления события по объекту 1С (создание/изменение) либо до истечения срока ожидания. Использовать, когда для продолжения задачи нужно дождаться внешнего события - например, поступления оплаты или изменения статуса документа. Tool приостанавливает цикл и не выполняется повторно, пока событие не наступит или не истечёт дедлайн.';
		|en = 'Pause work until an event happens on a 1C object (creation/change) or until the wait deadline expires. Use when the task cannot continue without waiting for an external event - e.g. a payment arriving or a document status changing. The tool pauses the cycle and is not re-run until the event happens or the deadline expires.'"));
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Дождаться события по объекту 1С или истечения срока';
		|en = 'Wait for an event on a 1C object or for a deadline'"));
	Описание.Вставить("ОбщийМодуль",      "ar_ИнструментыПлан");
	Описание.Вставить("ИмяПроцедуры",     "ОжидатьСобытия");
	Описание.Вставить("RiskLevel",        "Чтение");
	Описание.Вставить("ТребуетApproval",  Ложь);
	Описание.Вставить("Включён",          Истина);
	Описание.Вставить("Версия",           "1.0.0");
	Описание.Вставить("JSONManifest",     МанифестJSON);
	Возврат Описание;

КонецФункции

// Создать или обновить одну запись в ar_Инструменты по описанию.
// Ищет по ar_Имя среди непомеченных. При нахождении — обновляет, иначе создаёт.
// ar_Категория здесь сознательно НЕ заполняется - постпроход
// ar_ИнструментыДиспетчер.ЗаполнитьПредставленияВсехTools() делает это после
// регистрации всех модулей (спека PLAN-03, «Сущности и метаданные»).
//
// Параметры:
//  Описание   - Структура - см. ОписаниеToolUpdatePlan.
//  Статистика - Структура - {Создано, Обновлено} - модифицируется по ссылке.
//
Процедура ЗарегистрироватьОдинИнструмент(Знач Описание, Статистика)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Инструменты КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", Описание.Имя);

	Выборка = Запрос.Выполнить().Выбрать();

	НачатьТранзакцию();
	Попытка
		Если Выборка.Следующий() Тогда
			ОбъектИнструмент = Выборка.Ссылка.ПолучитьОбъект();
			Статистика.Обновлено = Статистика.Обновлено + 1;
		Иначе
			ОбъектИнструмент = Справочники.ar_Инструменты.СоздатьЭлемент();
			Статистика.Создано = Статистика.Создано + 1;
		КонецЕсли;

		ОбъектИнструмент.Наименование        = Описание.Имя;
		ОбъектИнструмент.ar_Имя              = Описание.Имя;
		ОбъектИнструмент.ar_Описание         = Описание.Описание;
		ОбъектИнструмент.ar_КраткоеОписание  = Описание.КраткоеОписание;
		ОбъектИнструмент.ar_ОбщийМодуль      = Описание.ОбщийМодуль;
		ОбъектИнструмент.ar_ИмяПроцедуры     = Описание.ИмяПроцедуры;
		ОбъектИнструмент.ar_ТребуетApproval  = Описание.ТребуетApproval;
		ОбъектИнструмент.ar_Включён          = Описание.Включён;
		ОбъектИнструмент.ar_Версия           = Описание.Версия;
		ОбъектИнструмент.ar_JSONManifest     = Описание.JSONManifest;

		// Установка RiskLevel через перечисление (образец: ar_ИнструментыРеестрПоиск.ПолучитьУровеньРиска).
		ОбъектИнструмент.ar_RiskLevel = ПолучитьУровеньРиска(Описание.RiskLevel);

		// Справочник записывается без параметров.
		ОбъектИнструмент.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Получить ссылку перечисления ar_УровеньРиска по строковому имени.
// При неизвестном имени возвращает Чтение (безопасный дефолт).
//
// Параметры:
//  ИмяЗначения - Строка - имя значения перечисления ar_УровеньРиска.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ar_УровеньРиска - найденное значение либо Чтение по умолчанию.
//
Функция ПолучитьУровеньРиска(Знач ИмяЗначения)
	Если ТипЗнч(ИмяЗначения) <> Тип("Строка") Тогда
		Возврат Перечисления.ar_УровеньРиска.Чтение;
	КонецЕсли;
	Для Каждого ЗначМД Из Метаданные.Перечисления.ar_УровеньРиска.ЗначенияПеречисления Цикл
		Если ЗначМД.Имя = ИмяЗначения Тогда
			Возврат Перечисления.ar_УровеньРиска[ЗначМД.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Перечисления.ar_УровеньРиска.Чтение;
КонецФункции

#КонецОбласти
