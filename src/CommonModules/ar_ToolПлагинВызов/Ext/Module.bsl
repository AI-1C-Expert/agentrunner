// Общий модуль ar_ToolПлагинВызов (PKG-04).
//
// Третий механизм адресации tool (третья точка входа диспетчера, помимо
// "Процедура" и "Код" - см. ar_ToolDispatcher): вызов tool, реализация
// которого находится в ЗАРЕГИСТРИРОВАННОМ пакете (внешняя обработка,
// подключённая через БСП "Дополнительные отчёты и обработки", см. PKG-01/
// PKG-03). Основная точка входа - ar_ToolDispatcher.Вызвать, шаг 5,
// ветка ДанныеTool.ИсточникТип = "Пакет" (ставится ПЕРЕД РежимКод - см.
// .docs/specs/PKG-04.md, отступление от плана §2.4).
//
// Алгоритм Вызвать():
//   1. ar_ToolПакеты.МеханизмПакетовДоступен() - недоступен → error.
//   2. Статус пакета по ar_ПакетыTools - не "Зарегистрирован" → error
//      package_not_active:<статус> (второй барьер поверх ar_Доступен=Ложь,
//      который отсеивает tool ещё на этапе сборки определений - но вызов
//      может прийти из уже подгруженного набора).
//   3. Объект пакета - см. кэш ниже.
//   4. ВнешнийОбъект.ar_ВыполнитьTool(ИмяTool, АргументыJSON, Контекст).
//   5. Нормализация результата - см. НормализоватьРезультат.
//
// PKG-09: вторая точка входа - ВызватьИсполнениеApproved (отложенное
// исполнение approved-действия пакетного commit-tool через
// ВнешнийОбъект.ar_ИсполнитьApprovedTool, контракт §1.7.5 .docs/Контракт-
// пакета-tools.md). Вызывается ТОЛЬКО из ar_ToolDispatcher.
// ИсполнитьApprovedДействиеПакета (единственный вызывающий - ar_Approval.
// ИсполнитьApprovedДействие), не из обычного пути диспетчеризации.
//
// Кэш объекта пакета (§ плана "кэш объекта на время запуска", решение §2.6).
// ВнешниеОбработки.Создать() - дорогая операция, цикл агента делает до
// ar_Константы.МаксШагов итераций, создавать объект на каждый вызов нельзя.
// Кэш - переменная модуля (Соответствие ИдентификаторПакета → ВнешнийОбъект).
//
//   Границы кэша - ОДИН СЕРВЕРНЫЙ ВЫЗОВ, а не "весь запуск" буквально: внешний
//   объект не сериализуется в кэш повторного использования (ПовтИсп для этого
//   не подходит), глобальной переменной сеанса для серверных модулей не
//   существует, а запуск может пережить паузу на approval/ask_user и
//   возобновиться в ДРУГОМ сеансе (APPR-01, TOOL-19) - объект пакета в любом
//   случае границу сеанса не переживает. На практике цикл агента исполняется
//   в одном фоновом задании, поэтому в типичном сценарии кэш живёт все
//   итерации одного запуска; после возобновления в другом сеансе объект
//   создаётся заново - это корректно и дополнительной работы не требует.
//   Фактическая стоимость ВнешниеОбработки.Создать() и эффективность кэша
//   замеряются в PERF-03 - здесь кэш существует и документирован.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Пакет исполняется в правах пользователя сессии - RLS целевой конфигурации
// работает; привилегированный режим НЕ поднимается нигде в этом модуле.
//
// Запрещено: Выполнить(), Вычислить() - вызов экспортного метода внешнего
// объекта происходит по ФИКСИРОВАННОМУ имени (ar_ВыполнитьTool), это не
// интерпретация произвольного текста (обоснование - PKG-01 §1.1,
// [Реф: БСП/CommonModules/ДополнительныеОтчетыИОбработки, ОбъектВнешнейОбработки]).
//
// См. спеку: .docs/specs/PKG-04.md, .docs/План-гибкие-tools.md §2.4, §2.6,
// Часть 4 блок A.
////////////////////////////////////////////////////////////////////////////////

// Кэш объектов зарегистрированных пакетов: Соответствие
// ИдентификаторПакета (Строка) → ВнешнийОбъект (ДанныеОбработки.ar_ИмяОбъекта).
// Граница жизни - ОДИН СЕРВЕРНЫЙ ВЫЗОВ (см. шапку модуля), НЕ "весь запуск"
// буквально - переживает паузу/resume только пока сервер не перезапущен и в
// пределах текущего серверного вызова (типично - фоновое задание цикла
// агента). Инициализируется лениво при первом обращении в Вызвать().
Перем КэшОбъектовПакетов;

#Область ПрограммныйИнтерфейс

// Выполнить tool из зарегистрированного пакета. Единственная точка входа -
// ar_ToolDispatcher.Вызвать, шаг 5 (ветка ИсточникТип = "Пакет").
//
// Параметры:
//  ИдентификаторПакета - Строка - строковое представление UUID ссылки на
//                         элемент справочника ДополнительныеОтчетыИОбработки
//                         (см. ar_Tools.ar_ИдентификаторПакета).
//  ИмяTool              - Строка - полное имя tool с namespace (например
//                         "demo_echo").
//  АргументыJSON        - Строка - JSON-объект аргументов, уже обогащённый
//                         диспетчером системными полями (_dry_run,
//                         _idempotency_key при commit-tools).
//  Контекст             - Структура - контекст запуска (RunId, Sequence,
//                         DryRun, при наличии - Агент).
//  ТребуетApproval      - Булево - реквизит ar_Tools.ar_ТребуетApproval
//                         вызываемого tool (PKG-05). Используется только для
//                         рантайм-контроля формы ответа в НормализоватьРезультат
//                         - на сам вызов пакета не влияет.
//
// Возвращаемое значение:
//  Строка - JSON-observation {"error":"..."} либо результат пакета как есть.
//
Функция Вызвать(Знач ИдентификаторПакета, Знач ИмяTool, Знач АргументыJSON, Знач Контекст,
		Знач ТребуетApproval = Ложь) Экспорт

	Попытка

		Доступность = ar_ToolПакеты.МеханизмПакетовДоступен();
		Если Не Доступность.Доступен Тогда
			Возврат ОшибкаПлагина("package_mechanism_unavailable");
		КонецЕсли;

		СтатусПакета = СтатусПакетаПоРегистру(ИдентификаторПакета);
		Если СтатусПакета <> "Зарегистрирован" Тогда
			Возврат ОшибкаПлагина("package_not_active:" + СтатусПакета);
		КонецЕсли;

		ВнешнийОбъект = ПолучитьОбъектПакета(ИдентификаторПакета);
		Если ВнешнийОбъект = Неопределено Тогда
			Возврат ОшибкаПлагина("package_object_unavailable");
		КонецЕсли;

		РезультатПакета = ВнешнийОбъект.ar_ВыполнитьTool(ИмяTool, АргументыJSON, Контекст);

		РезультатНормализованный = НормализоватьРезультат(РезультатПакета);

		// PKG-05 §2: рантайм-контроль формы ответа мутирующего пакетного tool -
		// не блокировка, а фиксация подозрительного случая (см. шапку модуля
		// PKG-05 и .docs/specs/PKG-05.md). Проверяется ПОСЛЕ нормализации типа/
		// пустоты - подозрительная форма ответа сама по себе не является
		// ошибкой пакета, поэтому наблюдение возвращается модели без изменений.
		Если ТребуетApproval = Истина Тогда
			ПроверитьКонтрактApproval(РезультатНормализованный, ИдентификаторПакета, ИмяTool,
				RunIdИзКонтекста(Контекст));
		КонецЕсли;

		Возврат РезультатНормализованный;

	Исключение
		ПодробноеПредставление = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(ПодробноеПредставление);
		RunId = RunIdИзКонтекста(Контекст);
		ar_СлужебныйЛог.Записать("ar_ToolПлагинВызов.Вызвать", "package_tool_exception",
			"Пакет=" + ИдентификаторПакета + "; Tool=" + ИмяTool + ": " + ПодробноеПредставление,
			"Ошибка", RunId);
		Возврат ОшибкаПлагина(ТекстОшибки);
	КонецПопытки;

КонецФункции

// PKG-09: исполнение approved-действия ПАКЕТНОГО commit-tool (.docs/Контракт-
// пакета-tools.md §1.7.5) - вторая, отдельная от Вызвать() точка входа в
// объект пакета. Вызывается ТОЛЬКО из ar_ToolDispatcher.
// ИсполнитьApprovedДействиеПакета (единственный вызывающий - ar_Approval.
// ИсполнитьApprovedДействие, ПОСЛЕ подтверждения оператором), не из обычного
// пути диспетчеризации tool-вызова.
//
// В отличие от Вызвать() возвращает НЕ JSON-строку, а Структуру
// {Выполнено, DocumentRef, Сообщения} - тот же контракт, что был у ядровых
// исполнителей вроде ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта до PKG-09
// (см. ar_Approval.ИсполнитьApprovedДействие, где Итог заполняется именно
// этими тремя полями).
//
// Параметры:
//  ИдентификаторПакета - Строка - строковое представление UUID ссылки на
//                         элемент справочника ДополнительныеОтчетыИОбработки.
//  ИмяTool              - Строка - полное имя tool с namespace.
//  ApprovalId           - Строка - идентификатор записи очереди
//                         ar_ОчередьApproval (передаётся пакету как есть, для
//                         логирования на его стороне).
//  ActionPayloadJSON    - Строка - JSON, сохранённый в очереди при постановке
//                         (см. ar_Approval.СобратьActionPayloadJSON).
//
// Возвращаемое значение:
//  Структура - {Выполнено: Булево, DocumentRef: ЛюбаяСсылка/Неопределено,
//  Сообщения: Массив строк}. При любой ошибке (пакет недоступен, исключение
//  внутри пакета, некорректная форма ответа) - {Выполнено: Ложь,
//  DocumentRef: Неопределено, Сообщения: [<код ошибки>]}, без исключения
//  наружу (тот же fail-safe контракт, что и у Вызвать()).
//
Функция ВызватьИсполнениеApproved(Знач ИдентификаторПакета, Знач ИмяTool, Знач ApprovalId,
		Знач ActionPayloadJSON) Экспорт

	ОтказНеВыполнено = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	Попытка

		Доступность = ar_ToolПакеты.МеханизмПакетовДоступен();
		Если Не Доступность.Доступен Тогда
			ОтказНеВыполнено.Сообщения.Добавить("package_mechanism_unavailable");
			Возврат ОтказНеВыполнено;
		КонецЕсли;

		СтатусПакета = СтатусПакетаПоРегистру(ИдентификаторПакета);
		Если СтатусПакета <> "Зарегистрирован" Тогда
			ОтказНеВыполнено.Сообщения.Добавить("package_not_active:" + СтатусПакета);
			Возврат ОтказНеВыполнено;
		КонецЕсли;

		ВнешнийОбъект = ПолучитьОбъектПакета(ИдентификаторПакета);
		Если ВнешнийОбъект = Неопределено Тогда
			ОтказНеВыполнено.Сообщения.Добавить("package_object_unavailable");
			Возврат ОтказНеВыполнено;
		КонецЕсли;

		РезультатПакета = ВнешнийОбъект.ar_ИсполнитьApprovedTool(ИмяTool, ApprovalId, ActionPayloadJSON);

		Если ТипЗнч(РезультатПакета) <> Тип("Структура")
			Или Не РезультатПакета.Свойство("Выполнено")
			Или Не РезультатПакета.Свойство("Сообщения") Тогда
			ar_СлужебныйЛог.Записать("ar_ToolПлагинВызов.ВызватьИсполнениеApproved",
				"package_approved_executor_bad_shape",
				"Пакет=" + ИдентификаторПакета + "; Tool=" + ИмяTool, "Ошибка");
			ОтказНеВыполнено.Сообщения.Добавить("package_approved_executor_bad_shape");
			Возврат ОтказНеВыполнено;
		КонецЕсли;

		Возврат РезультатПакета;

	Исключение
		ПодробноеПредставление = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ar_СлужебныйЛог.Записать("ar_ToolПлагинВызов.ВызватьИсполнениеApproved",
			"package_approved_executor_exception",
			"Пакет=" + ИдентификаторПакета + "; Tool=" + ИмяTool + "; ApprovalId=" + ApprovalId
				+ ": " + ПодробноеПредставление, "Ошибка");
		ОтказНеВыполнено.Сообщения.Добавить(ar_Утилиты.ОчиститьОшибкуДляLLM(ПодробноеПредставление));
		Возврат ОтказНеВыполнено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Статус пакета по РегистрСведений.ar_ПакетыTools. Пустая строка, если запись
// не найдена (пакет не зарегистрирован вовсе) - трактуется вызывающим кодом
// как "не активен".
//
// Параметры:
//  ИдентификаторПакета - Строка - строковое представление UUID ссылки на
//                         элемент справочника ДополнительныеОтчетыИОбработки.
//
// Возвращаемое значение:
//  Строка - ar_Статус записи регистра ("Зарегистрирован"/"ТребуетПереподтверждения"/
//  "Отключён"/"Отклонён"), либо "" если запись не найдена.
//
Функция СтатусПакетаПоРегистру(Знач ИдентификаторПакета)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пакеты.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_ПакетыTools КАК Пакеты
		|ГДЕ
		|	Пакеты.ar_ИдентификаторОбработки = &ИдентификаторПакета";
	Запрос.УстановитьПараметр("ИдентификаторПакета", ИдентификаторПакета);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Выборка.Статус;

КонецФункции

// Возвращает объект внешней обработки пакета с кэшированием на время
// серверного вызова (см. шапку модуля - КэшОбъектовПакетов).
//
// Возвращаемое значение:
//  ДанныеОбработки.<ИмяОбъекта> - объект пакета, либо Неопределено при ошибке
//  разыменования ссылки/создания объекта.
//
Функция ПолучитьОбъектПакета(Знач ИдентификаторПакета)

	Если КэшОбъектовПакетов = Неопределено Тогда
		КэшОбъектовПакетов = Новый Соответствие;
	КонецЕсли;

	ИзКэша = КэшОбъектовПакетов.Получить(ИдентификаторПакета);
	Если ИзКэша <> Неопределено Тогда
		Возврат ИзКэша;
	КонецЕсли;

	СсылкаОбработки = СсылкаНаОбработкуПоИдентификатору(ИдентификаторПакета);
	Если Не ЗначениеЗаполнено(СсылкаОбработки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		МодульДопОбработки = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
		ВнешнийОбъект = МодульДопОбработки.ОбъектВнешнейОбработки(СсылкаОбработки);
	Исключение
		ar_СлужебныйЛог.Записать("ar_ToolПлагинВызов.ПолучитьОбъектПакета", "package_object_create_error",
			ИдентификаторПакета + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		Возврат Неопределено;
	КонецПопытки;

	Если ВнешнийОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	КэшОбъектовПакетов.Вставить(ИдентификаторПакета, ВнешнийОбъект);
	Возврат ВнешнийОбъект;

КонецФункции

// Возвращает ссылку на элемент справочника ДополнительныеОтчетыИОбработки по
// строковому идентификатору (UUID). Справочник НЕ заимствован в расширение
// (см. PKG-02) - разыменование через универсальную коллекцию Справочники по
// имени, тот же приём, что в ar_ToolПакеты.СсылкаПоИдентификатору.
//
Функция СсылкаНаОбработкуПоИдентификатору(Знач ИдентификаторОбработки)

	Попытка
		UUID = Новый УникальныйИдентификатор(ИдентификаторОбработки);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		МенеджерСправочника = Справочники["ДополнительныеОтчетыИОбработки"];
		Возврат МенеджерСправочника.ПолучитьСсылку(UUID);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Нормализует результат ar_ВыполнитьTool к контракту JSON-observation.
// Подстраховка поверх ar_ToolDispatcher.СтрокаНаблюдения (шаг 6 Вызвать) -
// та функция уже приводит ЛЮБОЙ ОтветTool к строке (не-строка сериализуется,
// Неопределено → "{}"), но НЕ считает пустую строку "" ошибкой (валидная
// строка возвращается как есть). Без проверки здесь пакет, вернувший ""
// (например, из-за забытого Возврат в ar_ВыполнитьTool), дал бы агенту
// пустое наблюдение без диагностируемой причины - см. .docs/specs/PKG-04.md.
//
// Параметры:
//  РезультатПакета - Произвольный - значение, возвращённое ar_ВыполнитьTool.
//
// Возвращаемое значение:
//  Строка - JSON-observation: РезультатПакета как есть, если это непустая
//  строка; иначе JSON вида {"error":"package_returned_non_string"} или
//  {"error":"package_returned_empty"}.
//
Функция НормализоватьРезультат(Знач РезультатПакета)

	Если ТипЗнч(РезультатПакета) <> Тип("Строка") Тогда
		Возврат ОшибкаПлагина("package_returned_non_string");
	КонецЕсли;

	Если ПустаяСтрока(РезультатПакета) Тогда
		Возврат ОшибкаПлагина("package_returned_empty");
	КонецЕсли;

	// Успешный результат пакета возвращается КАК ЕСТЬ - ОчиститьОшибкуДляLLM
	// (режет текст до 500 символов) применяется ТОЛЬКО к текстам ошибок,
	// никогда к результатам tools (память проекта project_observation_truncation_bug).
	Возврат РезультатПакета;

КонецФункции

// PKG-05 §2: рантайм-контроль формы ответа мутирующего пакетного tool
// (ТребуетApproval = Истина). Ожидаемые формы ответа - status="queued_for_approval",
// status="dry_run" (при DryRun) либо ключ "error". Любая иная форма означает,
// что мутирующий tool завершился, ничего не поставив в очередь approval -
// подозрение на нарушение контракта пакета (см. .docs/specs/PKG-05.md,
// "DoD плана изменён этой спекой": обнаружимость, а не блокировка).
//
// НЕ блокирует вызов и НЕ меняет РезультатНормализованный - только фиксирует
// подозрительный случай в ar_СлужебныйЛог (Предупреждение) и в аудит
// (ar_AuditЗащищённыйРежим, событие "package_approval_contract_suspect").
//
// Параметры:
//  РезультатНормализованный - Строка - JSON-observation после НормализоватьРезультат.
//  ИдентификаторПакета      - Строка - идентификатор пакета (для лога/аудита).
//  ИмяTool                  - Строка - имя вызванного tool.
//  RunId                    - Строка - идентификатор запуска для аудита ("" допустимо).
//
// Возвращаемое значение: нет.
//
Процедура ПроверитьКонтрактApproval(Знач РезультатНормализованный, Знач ИдентификаторПакета,
		Знач ИмяTool, Знач RunId)

	Разобрано = ar_JSON.ИзJSON(РезультатНормализованный);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		// Ответ не является JSON-объектом - НормализоватьРезультат уже
		// гарантирует, что это непустая строка, но не гарантирует валидный
		// JSON-объект (пакет мог вернуть произвольную строку). Такая форма
		// тоже подозрительна для мутирующего tool.
		ЗафиксироватьПодозрениеНаНарушениеКонтракта(ИдентификаторПакета, ИмяTool, RunId);
		Возврат;
	КонецЕсли;

	Если Разобрано.Получить("error") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Статус = Разобрано.Получить("status");
	Если Статус = "queued_for_approval" Или Статус = "dry_run" Тогда
		Возврат;
	КонецЕсли;

	ЗафиксироватьПодозрениеНаНарушениеКонтракта(ИдентификаторПакета, ИмяTool, RunId);

КонецПроцедуры

// Записывает факт подозрения на нарушение approval-контракта пакетным tool -
// предупреждение в ar_СлужебныйЛог и событие аудита через ar_AuditЗащищённыйРежим.
//
Процедура ЗафиксироватьПодозрениеНаНарушениеКонтракта(Знач ИдентификаторПакета, Знач ИмяTool, Знач RunId)

	ar_СлужебныйЛог.Записать("ar_ToolПлагинВызов.ПроверитьКонтрактApproval",
		"package_approval_contract_suspect",
		"Пакет=" + ИдентификаторПакета + "; Tool=" + ИмяTool
			+ ": мутирующий tool (ТребуетApproval=Истина) вернул ответ без status=queued_for_approval/dry_run и без ключа error",
		"Предупреждение", RunId);

	ПолезнаяНагрузка = Новый Структура;
	ПолезнаяНагрузка.Вставить("package", ИдентификаторПакета);
	ПолезнаяНагрузка.Вставить("tool", ИмяTool);
	ПолезнаяНагрузка.Вставить("run_id", RunId);
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "package_approval_contract_suspect",
		ПолезнаяНагрузка);

КонецПроцедуры

// JSON-строка ошибки-observation: {"error":"<текст>"}.
//
// Параметры:
//  ТекстОшибки - Строка - машиночитаемый код/текст ошибки.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<текст>"}.
//
Функция ОшибкаПлагина(Знач ТекстОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(ТекстОшибки) = Тип("Строка"), ТекстОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""package_dispatch_error""}", Результат);
КонецФункции

// Безопасно извлечь RunId из Контекста (Структура) для лога ошибки.
//
// Параметры:
//  Контекст - Структура - контекст запуска (RunId, Sequence, DryRun, ...).
//             Может быть Неопределено/не Структурой.
//
// Возвращаемое значение:
//  Строка - значение RunId либо "" при отсутствии/некорректном типе.
//
Функция RunIdИзКонтекста(Знач Контекст)
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	RunId = "";
	Контекст.Свойство("RunId", RunId);
	Возврат ?(ТипЗнч(RunId) = Тип("Строка"), RunId, "");
КонецФункции

#КонецОбласти
