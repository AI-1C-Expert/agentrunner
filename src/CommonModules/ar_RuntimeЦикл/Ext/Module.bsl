////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_RuntimeЦикл (Цикл рассуждения агента - Runtime).
//
// Центральный ReAct-цикл (Reason + Act) AgentRunner. Единственная экспортная
// процедура ВыполнитьАгента вызывается ИСКЛЮЧИТЕЛЬНО из фонового задания,
// поставленного ar_RuntimeЗапуск.СтартоватьВФоне / .Возобновить (RT-02/RT-03).
//
// Цикл объединяет готовые слои расширения:
//   * сборку контекста            - ar_RuntimeКонтекст (RT-04)
//   * парсинг tool calls          - ar_RuntimeПарсер   (RT-05)
//   * вызов LLM с retry/fallback  - ar_LLMДиспетчер     (LLM-02)
//   * проверку разрешений         - ar_PermissionEngine (PERM-01)
//   * approval-поток              - ar_Approval         (APPR-01)
//   * диспетчеризацию tools        - ar_ToolDispatcher   (DISP-01)
//   * аудит запусков/событий/действий - ar_AuditЗапуски/ar_AuditСобытия/ar_AuditДействия
//
// Свойства модуля: Сервер, НеГлобальный, Привилегированный = Ложь (манифест).
// Привилегии НЕ поднимаются в этом модуле: запись аудита делегируется
// привилегированным модулям ar_AuditЗапуски / ar_AuditСобытия / ar_AuditДействия,
// а tools исполняются в правах пользователя сессии - чтобы RLS целевой
// конфигурации работал естественно (Plan §2.8, §3.1).
//
// СТАТУС РЕАЛИЗАЦИИ (RT-06, итерация 1):
//   Блокеры RT-04, RT-05, PERM-01, APPR-01, DISP-01, AUD-03 ещё не реализованы
//   как отдельные модули. RT-06 построен поверх их контрактов через
//   stub-функции (_Стаб*), помеченные TODO с ссылкой на тикет. Стабы дают
//   degraded-режим: PERM → allow, APPROVAL → пустой ApprovalId, DISPATCH →
//   пустой результат. После реализации реальных модулей вызовы стабов
//   заменяются на реальные API одной правкой в точке вызова (#Область
//   ИнтеграцияБлокеров).
//
// Состояние цикла (внутренняя структура, не экспорт) - сериализуемо в
// ХранилищеЗначения для StateSnapshot (см. ar_AuditЗапуски.СохранитьСнимок):
//   {
//     Сообщения          - Массив структур {role, content, [tool_calls], [tool_call_id]}
//     ШаговВсего         - Число
//     ДействийВсего      - Число
//     ОжидаютApproval    - Число
//     Результат          - Строка
//     RunId              - Строка
//     ТокеновВход        - Число
//     ТокеновВыход       - Число
//     DryRun             - Булево
//     ИнструкцияДобавка  - Строка - текст добавки к инструкции от рутины-триггера
//                                    (ROUT-04, §3.6 STABLE-слоя).
//     ФактОбластиДанных  - Строка - текст факта об области данных профиля запуска
//                                    (CONS-02, STABLE-слой). Пусто - профиль не
//                                    указан либо не имеет ограничений - секция
//                                    промпта не добавляется (обратная
//                                    совместимость, решение 22).
//     ПользовательUUID   - Строка - UUID пользователя ИБ - инициатора запуска
//                                    (MEM-03, владелец памяти в режиме «без агента»).
//     ПодгруженныеTools  - Массив из Строка - имена tools, подгруженных через
//                                    describe_tool в рамках текущего RunId
//                                    (SCALE-04) - дозагружаются в tool_definitions
//                                    каждой итерации до конца запуска.
//     ОжидаютEvent          - Число  - счётчик паузы wait_for_event (PLAN-11),
//                                    по аналогии с ОжидаютApproval/ОжидаютInput.
//     ОжидаемоеСобытиеJSON  - Строка - сериализованный {"object_type":...,
//                                    "filter":{...}} для ветки «7б» - см.
//                                    ar_ОжидаетСобытия (PLAN-10).
//     ОжиданиеДо            - Дата   - посчитанный дедлайн (ТекущаяДатаСеанса() +
//                                    deadline_hours часов) - см. ar_ОжиданиеДо
//                                    (PLAN-10).
//   }
//
// См. спеку: .docs/specs/RT-06.md, .docs/specs/MEM-03.md, Plan §2.8, §3.1.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполнить агентный ReAct-цикл. Точка входа фонового задания.
//
// Результат не возвращается - жизненный цикл фиксируется в регистре ar_Запуски
// через ar_AuditЗапуски, события - в ar_СобытияЗапуска через ar_AuditСобытия.
//
// Параметры:
//  СсылкаАгент      - СправочникСсылка.ar_Агенты - запускаемый агент.
//  RunId            - Строка(36) - идентификатор запуска (создан в ar_RuntimeЗапуск).
//  КонтекстТриггера - Структура - {
//                       Триггер - Строка - "manual"/"cron"/"webhook"/"mention"/
//                                "approval_resume"/"manual_resume";
//                       Снимок  - Структура - {v, state} при Триггер="approval_resume"
//                                или "manual_resume" (опционально);
//                       ... прочие данные триггера ...
//                     }
//                     UI-13: "manual_resume" - ручное возобновление Interrupted-запуска
//                     оператором из Run Viewer (ar_RuntimeЗапуск.Возобновить). Ветка
//                     восстановления состояния из снимка идентична "approval_resume" -
//                     оба литерала проверяются вместе ниже (state-restoration).
//
Процедура ВыполнитьАгента(СсылкаАгент, RunId, КонтекстТриггера) Экспорт

	// SESS-Debug (диагностика PLAN-04, оставлено намеренно - живой прогон
	// показал молчаливое падение при включённом ar_ПланироватьРаботу, ноль
	// записей в ar_СлужебныйЛог даже на самых ранних точках модуля). Первая
	// строка входа в точку фонового задания - если следующий прогон снова не
	// покажет продолжения после неё, исключение происходит либо на этапе
	// платформенной сериализации параметров ФоновыеЗадания.Выполнить (до
	// вызова этой процедуры вообще - тогда и это событие не попадёт в лог),
	// либо где-то внутри Попытка ниже, но до входа в ВыполнитьАгентаВнутр.
	Попытка
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгента", "debug_entry",
			СтрШаблон("СсылкаАгент=%1; ТипКонтекста=%2",
				?(ТипЗнч(СсылкаАгент) = Тип("СправочникСсылка.ar_Агенты"), Строка(СсылкаАгент), "не-агент"),
				Строка(ТипЗнч(КонтекстТриггера))),
			"Информация", RunId);
	Исключение
		// Best-effort - ar_СлужебныйЛог.Записать сама проглатывает свои ошибки,
		// но на случай непредвиденного второго сбоя дублируем в платформенный
		// журнал, а не оставляем блок пустым (вложенное падение здесь не
		// должно останавливать основной цикл).
		ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгента", УровеньЖурналаРегистрации.Ошибка,
			, , "debug_entry: вторичный сбой логирования на входе в фоновое задание");
	КонецПопытки;

	Попытка

		ВыполнитьАгентаВнутр(СсылкаАгент, RunId, КонтекстТриггера);

	Исключение

		// Неперехваченное исключение цикла - фиксируем как run_failed.
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		// SESS-Debug (диагностика PLAN-04, оставлено намеренно): гарантированная
		// запись факта и текста исключения в ar_СлужебныйЛог, независимая от
		// остального тела catch-блока (ЗафиксироватьСобытие/ЗавершитьЗапуск/
		// ar_Hooks ниже пишут в другие регистры и сами могут упасть -
		// эта запись должна дойти до лога раньше них).
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгента", "run_failed_unhandled",
				ТекстОшибки, "Ошибка", RunId);
		Исключение
			// Best-effort - вторичный сбой самого логирования не должен помешать
			// остальному catch-блоку записать статус запуска и событие.
			ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгента", УровеньЖурналаРегистрации.Ошибка,
				, , "run_failed_unhandled: вторичный сбой логирования исключения");
		КонецПопытки;

		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("code", "run_failed");
		ПолезнаяНагрузка.Вставить("error", ТекстОшибки);
		ЗафиксироватьСобытие(RunId, "Failed", ПолезнаяНагрузка);

		ДанныеЗавершения = Новый Структура;
		ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Failed);
		ДанныеЗавершения.Вставить("ОтветLLM", ТекстОшибки);
		// PLAN-04: Состояние вне области видимости этой процедуры (исключение
		// могло произойти до его создания в ВыполнитьАгентаВнутр) - хелпер
		// безопасно no-op на Неопределено.
		ДополнитьДаннымиПлана(ДанныеЗавершения, Неопределено);
		ЗавершитьЗапуск(RunId, ДанныеЗавершения);

		// HOOK: OnRunComplete (HOOK-03, точка 10г - unhandled exception).
		КонтекстСобытияФинал = Новый Структура;
		КонтекстСобытияФинал.Вставить("RunId", RunId);
		КонтекстСобытияФинал.Вставить("Событие", Перечисления.ar_СобытиеHook.OnRunComplete);
		КонтекстСобытияФинал.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Failed);
		КонтекстСобытияФинал.Вставить("Результат", ТекстОшибки);
		// Агент может быть не определён, если исключение произошло до ПрочитатьДанныеАгента.
		Если ТипЗнч(СсылкаАгент) = Тип("СправочникСсылка.ar_Агенты")
			И ЗначениеЗаполнено(СсылкаАгент) Тогда
			КонтекстСобытияФинал.Вставить("Агент", СсылкаАгент);
		КонецЕсли;
		ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.OnRunComplete, КонтекстСобытияФинал);

	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основной алгоритм без внешнего перехвата исключений (он в ВыполнитьАгента).
//
Процедура ВыполнитьАгентаВнутр(СсылкаАгент, RunId, КонтекстТриггера)

	// --- Шаг 0: инициализация ---------------------------------------------

	// UI-22: режим «без агента» (ar_RuntimeЗапуск.СтартоватьВФонеБезАгента) -
	// СсылкаАгент пустая, ДанныеАгента строится синтетически из ОверрайдTools/
	// ОверрайдПровайдер вместо чтения справочника ar_Агенты.
	БезАгента = Ложь;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("БезАгента", БезАгента);
	КонецЕсли;
	БезАгента = (БезАгента = Истина);

	// ВРЕМЕННО (диагностика UI-22): зафиксировать фактическое содержимое
	// КонтекстТриггера на входе в ВыполнитьАгентаВнутр.
	ДиагТипКонтекста = ТипЗнч(КонтекстТриггера);
	ДиагЕстьБезАгента = Ложь;
	ДиагЕстьПровайдер = Ложь;
	ДиагПровайдерТип = "н/д";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		ДиагЕстьБезАгента = КонтекстТриггера.Свойство("БезАгента");
		ДиагЕстьПровайдер = КонтекстТриггера.Свойство("ОверрайдПровайдер");
		Если ДиагЕстьПровайдер Тогда
			ДиагПровайдерЗнач = Неопределено;
			КонтекстТриггера.Свойство("ОверрайдПровайдер", ДиагПровайдерЗнач);
			ДиагПровайдерТип = ?(ДиагПровайдерЗнач = Неопределено, "Неопределено", Строка(ТипЗнч(ДиагПровайдерЗнач)));
		КонецЕсли;
	КонецЕсли;
	ЗаписьЖурналаРегистрации(
		"AgentRunner.Debug.ВыполнитьАгентаВнутр",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("ТипКонтекста=%1; БезАгента(вычислено)=%2; ЕстьКлючБезАгента=%3; ЕстьКлючПровайдер=%4; ТипПровайдера=%5",
			Строка(ДиагТипКонтекста), Строка(БезАгента), Строка(ДиагЕстьБезАгента),
			Строка(ДиагЕстьПровайдер), ДиагПровайдерТип));

	Если БезАгента Тогда
		ДанныеАгента = ДанныеАгентаБезАгента(КонтекстТриггера);
	Иначе
		ДанныеАгента = ПрочитатьДанныеАгента(СсылкаАгент);
		// UI-01/6: оверрайд провайдера на диалог (ar_Диалог.ОтправитьНаСервере) -
		// временная замена ar_LLMПровайдер агента, не меняет сам справочник.
		Если ДанныеАгента <> Неопределено Тогда
			ОверрайдПровайдерАгента = Неопределено;
			Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
				КонтекстТриггера.Свойство("ОверрайдПровайдер", ОверрайдПровайдерАгента);
			КонецЕсли;
			Если ТипЗнч(ОверрайдПровайдерАгента) = Тип("СправочникСсылка.ar_LLMПровайдеры")
				И ЗначениеЗаполнено(ОверрайдПровайдерАгента) Тогда
				ДанныеАгента.LLMПровайдер = ОверрайдПровайдерАгента;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// SESS-Debug (диагностика PLAN-04, оставлено намеренно): сразу после
	// чтения ДанныеАгента (ПрочитатьДанныеАгента/ДанныеАгентаБезАгента) -
	// подтверждает, что SQL-запрос с новым полем ar_ПланироватьРаботу
	// (PLAN-04) отработал без исключения, и фиксирует реальное значение
	// флажка, прочитанное из базы (живой прогон E2E показал молчаливое
	// падение только при включённом флажке - см. .docs/specs/PLAN-04.md,
	// замечания ревью по итогу живого прогона).
	Попытка
		ФлагПланДиаг = "н/д";
		Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
			ЗначениеФлагаДиаг = Неопределено;
			Если ДанныеАгента.Свойство("ПланироватьРаботу", ЗначениеФлагаДиаг) Тогда
				ФлагПланДиаг = Строка(ЗначениеФлагаДиаг);
			Иначе
				ФлагПланДиаг = "ключ отсутствует";
			КонецЕсли;
		КонецЕсли;
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_agent_data_read",
			СтрШаблон("ДанныеАгента=%1; ПланироватьРаботу=%2; БезАгента=%3",
				?(ТипЗнч(ДанныеАгента) = Тип("Структура"), "Структура", "Неопределено"),
				ФлагПланДиаг, Строка(БезАгента)),
			"Информация", RunId);
	Исключение
		// Best-effort - диагностика не должна ронять реальную ветку выполнения.
		ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
			, , "debug_agent_data_read: вторичный сбой логирования");
	КонецПопытки;

	Если ДанныеАгента = Неопределено Тогда
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("code", "run_failed");
		ПолезнаяНагрузка.Вставить("reason", "agent_not_found_or_inactive");
		ЗафиксироватьСобытие(RunId, "Failed", ПолезнаяНагрузка);
		ДанныеЗавершения = Новый Структура;
		ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Failed);
		// PLAN-04: Состояние ещё не создано на этой ветке - no-op.
		ДополнитьДаннымиПлана(ДанныеЗавершения, Неопределено);
		ЗавершитьЗапуск(RunId, ДанныеЗавершения);
		Возврат;
	КонецЕсли;

	// Проверка роли пользователя сессии (denied_globally) - для БезАгента
	// ИмяРоли1С всегда пусто, ПроверитьРольПользователя пропускает проверку.
	Если Не ПроверитьРольПользователя(ДанныеАгента, RunId) Тогда
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("code", "denied_globally");
		ПолезнаяНагрузка.Вставить("role", ДанныеАгента.ИмяРоли1С);
		ЗафиксироватьСобытие(RunId, "Denied", ПолезнаяНагрузка);
		ДанныеЗавершения = Новый Структура;
		ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.DeniedGlobally);
		// PLAN-04: Состояние ещё не создано на этой ветке - no-op.
		ДополнитьДаннымиПлана(ДанныеЗавершения, Неопределено);
		ЗавершитьЗапуск(RunId, ДанныеЗавершения);
		Возврат;
	КонецЕсли;

	Триггер = "manual";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("Триггер", Триггер);
	КонецЕсли;

	// ИнструкцияДобавка от рутины-триггера (ROUT-04).
	// Извлекается до создания состояния, чтобы установить в состояние
	// как для нового, так и для восстановленного (resume) сценария.
	ИнструкцияДобавка = "";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("ИнструкцияДобавка", ИнструкцияДобавка);
	КонецЕсли;

	// UI-13: "manual_resume" (ручной resume Interrupted-запуска оператором из Run
	// Viewer, ar_RuntimeЗапуск.Возобновить) восстанавливает состояние из снимка по
	// той же ветке, что и "approval_resume" - оба литерала равнозначны для
	// state-restoration (см. doc-комментарий ВыполнитьАгента).
	// TOOL-19: "input_resume" добавлен к резюме-ветке - поведение идентично
	// approval_resume: восстановление состояния из снимка + инъекция user_answer.
	// PLAN-12: "event_resume" (пробуждение спящего PausedForEvent-запуска
	// наступившим событием, ar_RuntimeЗапуск.НайтиИРазбудитьСпящийЗапуск) -
	// аддитивно, тот же принцип: без этой ветки resume создал бы новое
	// состояние вместо восстановления истории/плана/счётчиков из снимка.
	// PLAN-13: "deadline_resume" (пробуждение спящего PausedForEvent-запуска
	// истёкшим дедлайном ar_ОжиданиеДо, ar_Scheduler.ОбработатьОдинДедлайн) -
	// аддитивно, тот же принцип, что и event_resume.
	ЭтоResumeИзСнимка = (Триггер = "approval_resume" ИЛИ Триггер = "manual_resume"
		ИЛИ Триггер = "input_resume" ИЛИ Триггер = "event_resume"
		ИЛИ Триггер = "deadline_resume");

	// CONS-11: "supervisor_continue" - третий режим (см. doc-комментарий модуля,
	// "Модель продолжения"). Не resume из снимка (approval/input не ждали) и не
	// новый запуск (НовоеСостояние обнулило бы историю и Sequence действий,
	// вызвав коллизию ключа ar_ДействияАгента при следующем dispatch - Sequence
	// берётся из Состояние.ДействийВсего, см. КонтекстЗапуска). Состояние
	// приходит уже готовым от ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора (не
	// ar_Надзор - тот только решает Продолжать/не Продолжать в РешитьПродолжатьЛи,
	// саму подготовку состояния делает эта же процедура модуля) через
	// КонтекстТриггера.Продолжение - переносится целиком (Сообщения + счётчики
	// НЕ обнуляются), только дописывается управляющее сообщение.
	ЭтоПродолжениеНадзора = (Триггер = "supervisor_continue");

	// Восстановление состояния из снимка (resume) либо новое состояние.
	Если ЭтоResumeИзСнимка Тогда
		Состояние = ВосстановитьСостояние(RunId, КонтекстТриггера);
		Если Состояние = Неопределено Тогда
			ПолезнаяНагрузка = Новый Структура;
			ПолезнаяНагрузка.Вставить("code", "run_failed");
			ПолезнаяНагрузка.Вставить("reason", "incompatible_snapshot_version");
			ЗафиксироватьСобытие(RunId, "Failed", ПолезнаяНагрузка);
			ДанныеЗавершения = Новый Структура;
			ДанныеЗавершения.Вставить("Статус", Перечисления.ar_СтатусЗапуска.FailedIncompatibleState);
			// PLAN-04: Состояние = Неопределено на этой ветке (несовместимый снимок) - no-op.
			ДополнитьДаннымиПлана(ДанныеЗавершения, Состояние);
			ЗавершитьЗапуск(RunId, ДанныеЗавершения);
			Возврат;
		КонецЕсли;
	ИначеЕсли ЭтоПродолжениеНадзора Тогда
		Состояние = Неопределено;
		Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
			КонтекстТриггера.Свойство("Продолжение", Состояние);
		КонецЕсли;
		Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
			// Защитный fallback (не должен наступать при вызове из
			// ПродолжитьЦиклПослеНадзора) - без готового Состояния продолжать
			// нельзя, откатываемся к новому состоянию, чтобы не потерять RunId.
			Состояние = НовоеСостояние(RunId);
		КонецЕсли;
		// Обнуляем ТОЛЬКО границу текущего прохода (для Sequence/бюджета слоя 1
		// используется накопленное значение, см. КонтекстЗапуска.Sequence и
		// Пока Состояние.ШаговВсего < МаксШагов - это и есть накопительный
		// бюджет за весь RunId, D1).
		Состояние.Вставить("ДействийВсегоНаНачалоПрохода", Состояние.ДействийВсего);
	Иначе
		Состояние = НовоеСостояние(RunId);

		// Подмешивание истории сессии в DYNAMIC-слой (SESS-01).
		// Если в КонтекстТриггера передан ЯкорьСсылка - ищется активная запись
		// регистра ar_Сессии и её история добавляется в начало Состояние.Сообщения.
		ПодмешатьИсториюСессии(Состояние, СсылкаАгент, КонтекстТриггера, ДанныеАгента, RunId);

		// UI-22: первое сообщение пользователя (интерактивный чат, ar_Диалог).
		// Добавляется ПОСЛЕ истории сессии - оно продолжает диалог, а не
		// открывает его. Триггеры без интерактивного текста (cron/webhook/
		// mention) не передают ЗапросПользователя - ветка no-op.
		ЗапросПользователя = "";
		Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
			КонтекстТриггера.Свойство("ЗапросПользователя", ЗапросПользователя);
		КонецЕсли;
		Если ТипЗнч(ЗапросПользователя) = Тип("Строка") И Не ПустаяСтрока(ЗапросПользователя) Тогда
			Состояние.Сообщения.Добавить(
				ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), ЗапросПользователя));
		КонецЕсли;

	КонецЕсли;

	// Сохранить инструкцию-добавку в состоянии для §3.6 STABLE-слоя (ROUT-04).
	// При resume (approval_resume / manual_resume) десериализация снимка может
	// уже содержать это поле (см. UC-4) - не перезаписываем, если восстановлено
	// из снимка.
	// CONS-11: ЭтоПродолжениеНадзора добавлено к условию по той же логике, что
	// ЭтоResumeИзСнимка - Состояние уже несёт актуальное значение, полученное
	// из предыдущего прохода в памяти, перезапись обнулила бы факт.
	Если Не ЭтоResumeИзСнимка И Не ЭтоПродолжениеНадзора Тогда
		Состояние.Вставить("ИнструкцияДобавка",
			СокрЛП(?(ТипЗнч(ИнструкцияДобавка) = Тип("Строка"), ИнструкцияДобавка, "")));
	КонецЕсли;

	// CONS-02: факт об области данных профиля запуска - для STABLE-слоя
	// промпта, по тому же паттерну, что и ИнструкцияДобавка выше (не
	// перезаписывается при resume - факт уже в восстановленном Состоянии).
	// Ошибка построения факта не должна прерывать запуск (спека CONS-02,
	// «Граничные случаи»).
	Если Не ЭтоResumeИзСнимка И Не ЭтоПродолжениеНадзора Тогда
		Состояние.Вставить("ФактОбластиДанных", ФактОбластиДанныхПрофиля(КонтекстТриггера, RunId));
	КонецЕсли;

	// MEM-03: UUID пользователя ИБ - инициатора запуска (для памяти-владельца
	// в режиме «без агента», ar_RuntimeКонтекст.ЗагрузитьБлокПамяти). При resume
	// значение уже есть в восстановленном Состоянии (ДополнитьКлючи подставит
	// дефолт "" для снимков старого формата) - не перезаписываем.
	Если Не ЭтоResumeИзСнимка И Не ЭтоПродолжениеНадзора Тогда
		ПользовательUUIDТриггера = "";
		Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
			КонтекстТриггера.Свойство("ПользовательUUID", ПользовательUUIDТриггера);
		КонецЕсли;
		Состояние.Вставить("ПользовательUUID",
			СокрЛП(?(ТипЗнч(ПользовательUUIDТриггера) = Тип("Строка"), ПользовательUUIDТриггера, "")));
	КонецЕсли;

	// Флаг DryRun из контекста триггера (DISP-03). Безопасный дефолт - Ложь:
	// если триггер создан без поля DryRun (scheduler, webhook, resume без флага),
	// запуск считается боевым. При resume значение из снимка сохраняется, если
	// триггер его не переопределяет.
	DryRunИзТриггера = Ложь;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура")
		И КонтекстТриггера.Свойство("DryRun") Тогда
		КонтекстТриггера.Свойство("DryRun", DryRunИзТриггера);
		Состояние.DryRun = (DryRunИзТриггера = Истина);
	КонецЕсли;

	// UI-30: признаки интерактивного чата, режима «без агента» и оверрайда
	// tools сохраняются в Состоянии - переживают снимок/resume (в state только
	// сериализуемые примитивы: булево, массив строк, навигационная ссылка).
	// Побочный фикс: раньше живой no-agent-запуск терял БезАгента/ОверрайдTools
	// при resume после approval (ДополнитьКонтекстТриггераИзСнимкаБезАгента
	// находила эти ключи только у sentinel-запусков ar_Scheduler).
	Если Не ЭтоResumeИзСнимка И Не ЭтоПродолжениеНадзора Тогда
		Состояние.Вставить("БезАгента", БезАгента);
		Состояние.Вставить("ИнтерактивныйЧат", СтрНачинаетсяС(Триггер, "manual_chat"));
		ОверрайдToolsТриггера = Неопределено;
		ОверрайдПровайдерТриггера = Неопределено;
		Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
			КонтекстТриггера.Свойство("ОверрайдTools", ОверрайдToolsТриггера);
			КонтекстТриггера.Свойство("ОверрайдПровайдер", ОверрайдПровайдерТриггера);
		КонецЕсли;
		Состояние.Вставить("ОверрайдTools",
			?(ТипЗнч(ОверрайдToolsТриггера) = Тип("Массив"), ОверрайдToolsТриггера, Новый Массив));
		Если ЗначениеЗаполнено(ОверрайдПровайдерТриггера) Тогда
			Состояние.Вставить("ОверрайдПровайдер",
				ar_Утилиты.НавигационнаяСсылкаОбъекта(ОверрайдПровайдерТриггера));
		КонецЕсли;
	КонецЕсли;

	// Перевод в Running до первого шага LLM.
	ДанныеRunning = Новый Структура;
	ДанныеRunning.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Running);
	// PLAN-04: план на этот момент пуст (до первого шага цикла) - no-op,
	// вызов оставлен для единообразия всех десяти точек (уточнение U2).
	ДополнитьДаннымиПлана(ДанныеRunning, Состояние);
	ЗавершитьЗапуск(RunId, ДанныеRunning);

	// HOOK: OnRunStart (HOOK-03, точка 1).
	КонтекстСобытия = Новый Структура;
	КонтекстСобытия.Вставить("RunId", RunId);
	КонтекстСобытия.Вставить("Событие", Перечисления.ar_СобытиеHook.OnRunStart);
	КонтекстСобытия.Вставить("Триггер", Триггер);
	КонтекстСобытия.Вставить("Агент", ДанныеАгента.Ссылка);
	КонтекстСобытия.Вставить("ИмяАгента", ДанныеАгента.Наименование);
	КонтекстСобытия.Вставить("МаксШагов", ДанныеАгента.МаксШагов);
	КонтекстСобытия.Вставить("МаксДействий", ДанныеАгента.МаксДействий);
	КонтекстСобытия.Вставить("Sequence", Состояние.ШаговВсего);
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.OnRunStart, КонтекстСобытия);

	ПолезнаяНагрузкаСтарт = Новый Структура;
	ПолезнаяНагрузкаСтарт.Вставить("code", "run_started");
	ПолезнаяНагрузкаСтарт.Вставить("trigger", Триггер);
	ПолезнаяНагрузкаСтарт.Вставить("agent", ДанныеАгента.Наименование);
	ЗафиксироватьСобытие(RunId, "Started", ПолезнаяНагрузкаСтарт);

	// --- Шаг цикла --------------------------------------------------------

	МаксШагов = ДанныеАгента.МаксШагов;
	МаксДействий = ДанныеАгента.МаксДействий;

	Пока Состояние.ШаговВсего < МаксШагов Цикл

		// HOOK: BeforeStep (HOOK-03, точка 2).
		КонтекстСобытияШаг = Новый Структура;
		КонтекстСобытияШаг.Вставить("RunId", RunId);
		КонтекстСобытияШаг.Вставить("Событие", Перечисления.ar_СобытиеHook.BeforeStep);
		КонтекстСобытияШаг.Вставить("Sequence", Состояние.ШаговВсего);
		КонтекстСобытияШаг.Вставить("Агент", ДанныеАгента.Ссылка);
		КонтекстСобытияШаг.Вставить("СообщенийВКонтексте", Состояние.Сообщения.Количество());
		ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.BeforeStep, КонтекстСобытияШаг);

		// ВРЕМЕННО (диагностика UI-22): зафиксировать фактический тип значения
		// под ключом "Прервать" после ar_Hooks.Вызвать - выясняем причину
		// "Cannot convert value to Boolean".
		ЕстьКлючПрервать = КонтекстСобытияШаг.Свойство("Прервать");
		ЗначениеПрервать = Неопределено;
		КонтекстСобытияШаг.Свойство("Прервать", ЗначениеПрервать);
		ЗаписьЖурналаРегистрации(
			"AgentRunner.Debug.BeforeStep",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон("ЕстьКлюч=%1; Тип=%2; Значение=%3",
				ЕстьКлючПрервать,
				?(ЗначениеПрервать = Неопределено, "Неопределено", Строка(ТипЗнч(ЗначениеПрервать))),
				ar_Утилиты.ОчиститьОшибкуДляLLM(Строка(ЗначениеПрервать))));

		ПрерватьШаг = (ТипЗнч(ЗначениеПрервать) = Тип("Булево") И ЗначениеПрервать = Истина);
		Если ПрерватьШаг Тогда
			ПолезнаяНагрузкаБлок = Новый Структура;
			ПолезнаяНагрузкаБлок.Вставить("code", "step_blocked_by_hook");
			ЗафиксироватьСобытие(RunId, "Denied", ПолезнаяНагрузкаБлок);
			ДанныеБлок = Новый Структура;
			ДанныеБлок.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Failed);
			ДанныеБлок.Вставить("ОтветLLM", "blocked by before_step hook");
			ДанныеБлок.Вставить("ШаговВсего", Состояние.ШаговВсего);
			// PLAN-04: ранний обрыв до dispatch действий - план ещё не мог измениться
			// на этом шаге, но уже существует (НовоеСостояние) - запись безопасна.
			ДополнитьДаннымиПлана(ДанныеБлок, Состояние);
			ЗавершитьЗапуск(RunId, ДанныеБлок);
			// HOOK: OnRunComplete при блокировке хуком.
			КонтекстСобытияФинал = Новый Структура;
			КонтекстСобытияФинал.Вставить("RunId", RunId);
			КонтекстСобытияФинал.Вставить("Событие", Перечисления.ar_СобытиеHook.OnRunComplete);
			КонтекстСобытияФинал.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Failed);
			КонтекстСобытияФинал.Вставить("ШаговВсего", Состояние.ШаговВсего);
			КонтекстСобытияФинал.Вставить("ДействийВсего", Состояние.ДействийВсего);
			КонтекстСобытияФинал.Вставить("ТокеновВход", Состояние.ТокеновВход);
			КонтекстСобытияФинал.Вставить("ТокеновВыход", Состояние.ТокеновВыход);
			КонтекстСобытияФинал.Вставить("Результат", "blocked by before_step hook");
			КонтекстСобытияФинал.Вставить("Агент", ДанныеАгента.Ссылка);
			ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.OnRunComplete, КонтекстСобытияФинал);
			Возврат;
		КонецЕсли;

		// 1. HEARTBEAT.
		Heartbeat(RunId);

		// Самоконтроль отмены: статус Cancelled → немедленный выход.
		Если ПроверитьОтмену(RunId) Тогда
			Возврат;
		КонецЕсли;

		// 2. КОНТЕКСТ.
		ОкноКонтекста = ПостроитьКонтекст(Состояние, ДанныеАгента);

		// UI-22: режим «без агента» - tool_definitions не читаются из
		// ar_Агенты.ar_ДоступныеTools (ДанныеАгента.Ссылка пустая, см.
		// ar_RuntimeКонтекст.СобратьОпределенияTools), а собираются из
		// ОверрайдTools, переданного пользователем в форме ar_Диалог.
		Если БезАгента Тогда
			ОкноКонтекста.tool_definitions = ОпределенияOverrideTools(КонтекстТриггера);
		Иначе
			// UI-30: оверрайд набора tools агента на текущий диалог. Список
			// читается из Состояния (переживает resume); пустой список =
			// штатная ТЧ агента, поведение прежнее.
			ИменаОверрайда = ОверрайдToolsИзСостояния(Состояние);
			Если ИменаОверрайда.Количество() > 0 Тогда
				ОкноКонтекста.tool_definitions = ОпределенияToolsПоИменам(ИменаОверрайда);
			КонецЕсли;
		КонецЕсли;

		// SCALE-04: дозагрузка манифестов tools, описанных ранее через
		// describe_tool (Состояние.ПодгруженныеTools) - без этого шага модель,
		// один раз описавшая tool за пределами штатного tool_definitions, не
		// может сформировать корректный tool_call на следующей итерации
		// (провайдер отклоняет вызов функции, не объявленной в списке tools
		// запроса). Дописывается В КОНЕЦ массива, не переставляя уже
		// присутствующие манифесты (стабильность префикса промпта для кэша,
		// план §3.6). Действует и для основного пути, и для UI-22 (сужение
		// самого find_tools/describe_tool - в ar_ToolРеестрПоиск, см. ниже).
		ДозагрузитьОписанныеTools(ОкноКонтекста.tool_definitions, Состояние);

		// UI-30/TOOL-19: в интерактивном чате ask_user доступен по умолчанию -
		// добавляем манифест, если его нет в наборе (permission-слой пропускает
		// ask_user без whitelist, см. ar_PermissionEngine.ВыполнитьПроверки).
		Если ИнтерактивныйЧатИзСостояния(Состояние) Тогда
			ДобавитьМанифестAskUser(ОкноКонтекста.tool_definitions);
		КонецЕсли;

		// PLAN-04: update_plan доступен под флажком ar_ПланироватьРаботу
		// конкретного агента (режим «без агента» им не владеет - см.
		// ДобавитьМанифестUpdatePlan). Дописывается В КОНЕЦ массива, после
		// ask_user - самый новый добавочный слой (стабильность префикса
		// промпта для провайдерского кэша, план §3.6).
		// SESS-Debug (диагностика PLAN-04, оставлено намеренно): "до"/"после"
		// вокруг единственного вызова в основном цикле, реально зависящего от
		// значения флажка на раннем этапе шага - живой прогон показал
		// молчаливое падение только при включённом флажке.
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_before_update_plan_manifest",
				"tool_definitions.Количество()=" + Строка(ОкноКонтекста.tool_definitions.Количество()),
				"Информация", RunId);
		Исключение
			// Best-effort - диагностика не должна ронять сборку контекста.
			ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
				, , "debug_before_update_plan_manifest: вторичный сбой логирования");
		КонецПопытки;
		ДобавитьМанифестUpdatePlan(ОкноКонтекста.tool_definitions, ДанныеАгента);
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_after_update_plan_manifest",
				"tool_definitions.Количество()=" + Строка(ОкноКонтекста.tool_definitions.Количество()),
				"Информация", RunId);
		Исключение
			// Best-effort - диагностика не должна ронять сборку контекста.
			ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
				, , "debug_after_update_plan_manifest: вторичный сбой логирования");
		КонецПопытки;

		ПолезнаяНагрузкаКонтекст = Новый Структура;
		ПолезнаяНагрузкаКонтекст.Вставить("code", "context_built");
		ПолезнаяНагрузкаКонтекст.Вставить("messages", ОкноКонтекста.messages.Количество());
		ЗафиксироватьСобытие(RunId, "ContextBuilt", ПолезнаяНагрузкаКонтекст);

		// При применённой компакции фиксируем отдельное событие.
		Если ОкноКонтекста.БылаКомпакция Тогда
			ПолезнаяНагрузкаКомпакция = Новый Структура;
			ПолезнаяНагрузкаКомпакция.Вставить("code", "context_compacted");
			ПолезнаяНагрузкаКомпакция.Вставить("compaction_type", ОкноКонтекста.ТипКомпакции);
			ПолезнаяНагрузкаКомпакция.Вставить("estimated_tokens", ОкноКонтекста.ОценкаТокенов);
			ЗафиксироватьСобытие(RunId, "ContextCompacted", ПолезнаяНагрузкаКомпакция);
		КонецЕсли;

		// 3. LLM (диспетчер сам выполняет retry/backoff/fallback по контракту LLM-02).
		КонтекстLLM = СобратьКонтекстLLM(ОкноКонтекста, ДанныеАгента);
		// SESS-Debug (диагностика PLAN-04, продолжение): точка обрыва локализована
		// между sess_write (ветка Failed LLM, СохранитьСессию) и первой записью
		// happy-path (debug_parse_result) - значит где-то в диапазоне "собрать
		// КонтекстLLM -> вызвать ar_LLMДиспетчер.Вызвать". КонтекстLLM.RunId -
		// новый необязательный ключ контракта диспетчера (аддитивно, не влияет
		// на существующих потребителей без него), нужен только чтобы модули
		// ar_LLMДиспетчер/ar_LLM<Провайдер> могли писать в ar_СлужебныйЛог с
		// привязкой к RunId (без этого их диагностику невозможно связать с
		// запуском - см. прямое требование задания).
		КонтекстLLM.Вставить("RunId", RunId);

		// PLAN-15 (итерация 2): принудительный tool_choice на первом шаге нового
		// запуска. Состояние.ШаговВсего = 0 однозначно определяет "первый шаг
		// нового запуска" (не resume, не supervisor_continue - НовоеСостояние
		// обнуляет счётчик только для истинно нового запуска, ВосстановитьСостояние
		// и продолжение после надзора его не обнуляют - см. спеку PLAN-15).
		// Условие двойное: ПланироватьРаботу=Истина И ШаговВсего=0 - иначе
		// update_plan мог бы не входить в tools вовсе (флажок выключен) или
		// принуждение повторялось бы на каждом шаге (риск зацикливания).
		// Ключ ToolChoice НЕ добавляется вовсе при невыполнении условия (не
		// Неопределено/"" - отсутствие ключа), тем же паттерном, каким уже
		// устроен условный проброс Tools/Модель/Температура выше.
		// ДанныеАгента.Свойство(...), а не точечная нотация - в режиме «без
		// агента» (UI-22, ДанныеАгентаБезАгента) ключ ПланироватьРаботу в
		// структуре отсутствует вовсе, прямое обращение упало бы с ошибкой.
		//
		// Живой прогон 0.1.0.343 показал: адресный формат OpenAI
		// {"type":"function","function":{"name":...}} даёт HTTP 400 на
		// OpenAI-совместимом эндпоинте LM Studio ("Invalid tool_choice type:
		// 'object'. Supported string values: none, auto, required") и в
		// худшем случае - зависание запуска, а не быструю ошибку. Строка
		// "required" на том же эндпоинте (с полным набором tools,
		// update_plan последним) реально форсирует вызов update_plan в
		// одном ответе с прикладным tool-call - см. спеку, "Контекст".
		// Рантайм больше НЕ решает, в каком протокольном формате форсировать
		// вызов - он передаёт абстрактное НАМЕРЕНИЕ ("принудить конкретную
		// функцию"), а каждый провайдер разворачивает его в свой
		// поддерживаемый формат (ar_LLMLocalCompatible -> "required" как
		// самый совместимый общий знаменатель; ar_LLMAgentRunnerCloud ->
		// точный адресный формат, который он подтверждённо поддерживает -
		// см. ar_LLMAgentRunnerCloud.ПостроитьТелоЗапроса). Это не хардкодит
		// "required" в рантайме так, чтобы облачный путь терял адресность.
		ПланироватьРаботуДляВыбора = Неопределено;
		ДанныеАгента.Свойство("ПланироватьРаботу", ПланироватьРаботуДляВыбора);
		// PLAN-17 (итерация 2, фикс R-1): критерий "новый запуск" - это
		// ПЕРВЫЙ ШАГ истинно нового запуска, а не любой шаг нового запуска.
		// Итерация 1 по ошибке убрала Состояние.ШаговВсего = 0 из условия -
		// живой прогон 0.1.0.368 показал, что tool_choice=required уходил на
		// КАЖДОМ шаге нового запуска (Триггер вне resume/supervisor_continue
		// не меняется весь запуск), заставляя модель вызывать tool даже когда
		// она уже готова дать финальный ответ. Условие снова тройное:
		// ШаговВсего = 0 (первый шаг - см. цикл "Пока ШаговВсего < МаксШагов",
		// инкремент строго в конце итерации) И Не ЭтоResumeИзСнимка (снимок
		// уснувшего на первом шаге запуска тоже хранит ШаговВсего = 0 -
		// поэтому resume-флаг остаётся отдельным обязательным предикатом,
		// иначе вернулся бы баг PLAN-13) И Не ЭтоПродолжениеНадзора
		// (supervisor_continue переустанавливает часть Состояния, но не
		// ШаговВсего - см. ПродолжитьЦиклПослеНадзора).
		ФорсироватьUpdatePlan = (ПланироватьРаботуДляВыбора = Истина)
			И (Состояние.ШаговВсего = 0)
			И Не ЭтоResumeИзСнимка И Не ЭтоПродолжениеНадзора;
		Если ФорсироватьUpdatePlan Тогда
			НамерениеToolChoice = Новый Структура;
			НамерениеToolChoice.Вставить("Намерение", "ForceFunction");
			НамерениеToolChoice.Вставить("Функция", "update_plan");
			КонтекстLLM.Вставить("ToolChoice", НамерениеToolChoice);
		КонецЕсли;
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_tool_choice_decision",
				"ПланироватьРаботу=" + Строка(ПланироватьРаботуДляВыбора = Истина)
					+ "; ШаговВсего=" + Строка(Состояние.ШаговВсего)
					// PLAN-17: признак resume - показывает, по какой причине (если
					// причина есть) принуждение НЕ сработало, несмотря на
					// ПланироватьРаботу=Да. ЭтоResumeИзСнимка покрывает все пять
					// resume-триггеров (approval/manual/input/event/deadline),
					// ЭтоПродолжениеНадзора - CONS-11 continuation.
					+ "; ЭтоResumeИзСнимка=" + Строка(ЭтоResumeИзСнимка)
					+ "; ЭтоПродолжениеНадзора=" + Строка(ЭтоПродолжениеНадзора)
					+ "; ФорсироватьUpdatePlan=" + Строка(ФорсироватьUpdatePlan)
					+ "; Намерение=" + ?(ФорсироватьUpdatePlan, "ForceFunction(update_plan)", "(нет)"),
				"Информация", RunId);
		Исключение
			// Best-effort - диагностика не должна ронять сборку контекста.
			ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
				, , "debug_tool_choice_decision: вторичный сбой логирования");
		КонецПопытки;
		Попытка
			ПробнаяСериализацияTools = "";
			ЕстьToolsДиаг = (КонтекстLLM.Свойство("Tools") И ТипЗнч(КонтекстLLM.Tools) = Тип("Массив"));
			Если ЕстьToolsДиаг Тогда
				ПробнаяСериализацияTools = ar_JSON.ВЗначениеJSON(КонтекстLLM.Tools);
			КонецЕсли;
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_before_llm_dispatch",
				"Провайдер=" + Строка(КонтекстLLM.Провайдер)
					+ "; Сообщений=" + Строка(КонтекстLLM.Сообщения.Количество())
					+ "; ЕстьTools=" + ?(ЕстьToolsДиаг, "Да", "Нет")
					+ "; ToolsКоличество=" + ?(ЕстьToolsДиаг, Строка(КонтекстLLM.Tools.Количество()), "0")
					+ "; ПробнаяСериализацияToolsДлина=" + Строка(СтрДлина(ПробнаяСериализацияTools))
					+ "; ПробнаяСериализацияПуста=" + ?(ЕстьToolsДиаг И ПустаяСтрока(ПробнаяСериализацияTools),
						"Да(!)", "Нет"),
				"Информация", RunId);
		Исключение
			// Сама пробная сериализация упала - фиксируем текст ошибки, это и
			// есть искомая причина (сериализация КонтекстLLM.Tools в JSON).
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_before_llm_dispatch_failed",
				ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
				"Ошибка", RunId);
		КонецПопытки;

		// HOOK: BeforeLLMCall (HOOK-03, точка 3).
		КонтекстСобытияLLM = Новый Структура;
		КонтекстСобытияLLM.Вставить("RunId", RunId);
		КонтекстСобытияLLM.Вставить("Событие", Перечисления.ar_СобытиеHook.BeforeLLMCall);
		КонтекстСобытияLLM.Вставить("ЗапросLLM", КонтекстLLM);
		КонтекстСобытияLLM.Вставить("Sequence", Состояние.ШаговВсего);
		КонтекстСобытияLLM.Вставить("Агент", ДанныеАгента.Ссылка);
		ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.BeforeLLMCall, КонтекстСобытияLLM);
		ПрерватьLLMЗначение = Неопределено;
		КонтекстСобытияLLM.Свойство("Прервать", ПрерватьLLMЗначение);
		ПрерватьLLM = (ТипЗнч(ПрерватьLLMЗначение) = Тип("Булево") И ПрерватьLLMЗначение = Истина);
		// CONS-16: дефолт на случай ветки "Прервать" (LLM не вызывается,
		// ОтветLLM.Успех = Ложь - до МетрикиСобытияLLM код не доходит,
		// но переменная должна существовать при любом пути выполнения).
		ДлительностьLLMМС = 0;
		Если ПрерватьLLM Тогда
			ОтветLLM = Новый Структура;
			ОтветLLM.Вставить("Успех", Ложь);
			ОтветLLM.Вставить("Ошибка", "blocked by before_llm_call hook");
			ОтветLLM.Вставить("КодСостояния", 0);
			ОтветLLM.Вставить("Сообщение", Неопределено);
			ОтветLLM.Вставить("ТокеновВход", 0);
			ОтветLLM.Вставить("ТокеновВыход", 0);
			ОтветLLM.Вставить("ПровайдерИтог", "");
			ОтветLLM.Вставить("ПопытокСделано", 0);
		Иначе
			// CONS-16: замер latency вокруг вызова LLM-диспетчера (включая
			// ретраи внутри диспетчера - суммарное время ожидания ответа,
			// согласованно с attempts). Используется в сводке события
			// LLMCalled (МетрикиСобытияLLM) и переживает компакцию (см.
			// ar_Scheduler.СжатьПорциюСобытийLLM).
			МоментДоLLM = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ОтветLLM = ar_LLMДиспетчер.Вызвать(КонтекстLLM);
			ДлительностьLLMМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментДоLLM;
		КонецЕсли;

		// SESS-Debug (диагностика PLAN-04, продолжение): результат вызова
		// диспетчера сразу после возврата - до любой дальнейшей обработки
		// (МетрикиСобытияLLM/РазобратьОтвет), которая уже не выполняется в
		// ветке "Не Успех" (см. debug_parse_result ниже - штатно не пишется
		// в этой ветке).
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_after_llm_dispatch",
				"Успех=" + ?(ТипЗнч(ОтветLLM) = Тип("Структура") И ОтветLLM.Успех = Истина, "Да", "Нет")
					+ "; КодСостояния=" + Строка(?(ТипЗнч(ОтветLLM) = Тип("Структура"), ОтветLLM.КодСостояния, "?"))
					+ "; Ошибка=" + ar_Утилиты.ОчиститьОшибкуДляLLM(
						Строка(?(ТипЗнч(ОтветLLM) = Тип("Структура"), ОтветLLM.Ошибка, "")))
					+ "; ПопытокСделано=" + Строка(?(ТипЗнч(ОтветLLM) = Тип("Структура")
						И ОтветLLM.Свойство("ПопытокСделано"), ОтветLLM.ПопытокСделано, "?"))
					+ "; ДлительностьМС=" + Строка(ДлительностьLLMМС),
				"Информация", RunId);
		Исключение
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_after_llm_dispatch_log_failed",
				ar_Утилиты.ОчиститьОшибкуДляLLM(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
				"Ошибка", RunId);
		КонецПопытки;

		// HOOK: AfterLLMCall (HOOK-03, точка 4).
		КонтекстСобытияAfterLLM = Новый Структура;
		КонтекстСобытияAfterLLM.Вставить("RunId", RunId);
		КонтекстСобытияAfterLLM.Вставить("Событие", Перечисления.ar_СобытиеHook.AfterLLMCall);
		КонтекстСобытияAfterLLM.Вставить("ОтветLLM", ОтветLLM);
		Использование = Новый Структура;
		ТокеныВход = 0;
		ОтветLLM.Свойство("ТокеновВход", ТокеныВход);
		ТокеныВыход = 0;
		ОтветLLM.Свойство("ТокеновВыход", ТокеныВыход);
		Использование.Вставить("ТокеновВход", ТокеныВход);
		Использование.Вставить("ТокеновВыход", ТокеныВыход);
		КонтекстСобытияAfterLLM.Вставить("Usage", Использование);
		КонтекстСобытияAfterLLM.Вставить("Sequence", Состояние.ШаговВсего);
		КонтекстСобытияAfterLLM.Вставить("Агент", ДанныеАгента.Ссылка);
		ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.AfterLLMCall, КонтекстСобытияAfterLLM);

		// LLM-14 (часть Б): low_balance - предупреждение о приближении баланса
		// шлюза AgentRunner Cloud к нулю. Side-effect уведомление, НЕ блокирует
		// выполнение агента - runtime-цикл всегда фоновый (см. ar_RuntimeЗапуск,
		// фоновое задание ar_RuntimeЦикл.ВыполнитьАгента). Интерактивное
		// предупреждение в диалоге - отдельная точка в ar_МастерНастройки,
		// единственный интерактивный каллер ar_LLMДиспетчер.Вызвать.
		// Фиксируется независимо от исхода запроса (Успех/Неуспех) - низкий
		// баланс может сопровождать и успешный ответ LLM (обычный случай,
		// 200 + low_balance=true), поэтому блок расположен ДО проверки
		// ОтветLLM.Успех.
		БалансНизкий = Ложь;
		ОтветLLM.Свойство("БалансНизкий", БалансНизкий);
		Если БалансНизкий Тогда
			ЗаписьЖурналаРегистрации(
				"AgentRunner.LLM.LowBalance",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				НСтр("ru = 'Баланс шлюза AgentRunner Cloud приближается к нулю';
					|en = 'AgentRunner Cloud gateway balance is running low'"));
		КонецЕсли;

		Если Не ОтветLLM.Успех Тогда
			ТекстОшибкиLLM = ar_Утилиты.ОчиститьОшибкуДляLLM(ОтветLLM.Ошибка);
			ПолезнаяНагрузкаОшибка = Новый Структура;
			ПолезнаяНагрузкаОшибка.Вставить("code", "run_failed");
			ПолезнаяНагрузкаОшибка.Вставить("error", ТекстОшибкиLLM);
			ПолезнаяНагрузкаОшибка.Вставить("status_code", ОтветLLM.КодСостояния);
			ЗафиксироватьСобытие(RunId, "Failed", ПолезнаяНагрузкаОшибка);

			ДанныеОшибки = Новый Структура;
			ДанныеОшибки.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Failed);
			ДанныеОшибки.Вставить("ОтветLLM", ТекстОшибкиLLM);
			ДанныеОшибки.Вставить("ШаговВсего", Состояние.ШаговВсего);

			// CONS-09: если ошибка транзиентна (сеть/429/5xx - см.
			// ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка, переиспользуется целиком,
			// без второй классификации) и лимит попыток техповтора (3) ещё не
			// исчерпан - планируем следующую попытку. Статус всё равно
			// становится Failed (фоновое задание должно завершиться, штатное
			// продолжение цикла Пока после ЗавершитьЗапуск невозможно) -
			// именно поэтому ar_Scheduler.ОбработатьАвтовозобновление (блок 2)
			// исполняет уже запланированный retry отдельным тиком, а не эта
			// функция. ЭтоТранзиентнаяОшибка ожидает структуру с
			// КодСостояния/НеРеализован - контракт ОтветLLM совпадает.
			ПланДанные = ЗапланироватьТехповторЕслиНужно(RunId, ОтветLLM);
			Если ПланДанные <> Неопределено Тогда
				ДанныеОшибки.Вставить("ПовторитьПосле", ПланДанные.ПовторитьПосле);
			КонецЕсли;

			// PLAN-04: план запуска (Состояние.План) - до первого успешного шага LLM
			// мог остаться пустым, но точка магистральная (обрыв после реального
			// шага возможен на 2+ итерации) - записываем текущий прогресс.
			ДополнитьДаннымиПлана(ДанныеОшибки, Состояние);
			ЗавершитьЗапуск(RunId, ДанныеОшибки);
			// HOOK: OnRunComplete (HOOK-03, точка 10б - failed LLM).
			КонтекстСобытияФинал = Новый Структура;
			КонтекстСобытияФинал.Вставить("RunId", RunId);
			КонтекстСобытияФинал.Вставить("Событие", Перечисления.ar_СобытиеHook.OnRunComplete);
			КонтекстСобытияФинал.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Failed);
			КонтекстСобытияФинал.Вставить("ШаговВсего", Состояние.ШаговВсего);
			КонтекстСобытияФинал.Вставить("ДействийВсего", Состояние.ДействийВсего);
			КонтекстСобытияФинал.Вставить("ТокеновВход", Состояние.ТокеновВход);
			КонтекстСобытияФинал.Вставить("ТокеновВыход", Состояние.ТокеновВыход);
			КонтекстСобытияФинал.Вставить("Результат", ТекстОшибкиLLM);
			КонтекстСобытияФинал.Вставить("Агент", ДанныеАгента.Ссылка);
			ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.OnRunComplete, КонтекстСобытияФинал);
			// SESS-02: сохранить историю сессии (best-effort, не падать).
			СохранитьСессию(Состояние, ДанныеАгента, КонтекстТриггера, RunId);
			Возврат;
		КонецЕсли;

		// Аккумулируем usage между шагами (LLM-06: диспетчер не суммирует).
		СобратьМетрикиLLM(Состояние, ОтветLLM);
		// UI-11: payload llm_called дополнительно несёт сами сообщения prompt
		// (КонтекстLLM.Сообщения) - нужны для модального просмотра «Показать
		// prompt» в Run Viewer (CommonForm.ar_ПросмотрЗапуска). Аддитивно:
		// существующие ключи code/tokens_in/tokens_out/provider/attempts не меняются.
		ПолезнаяНагрузкаLLM = МетрикиСобытияLLM(ОтветLLM, КонтекстLLM.Сообщения, ДлительностьLLMМС);
		ЗафиксироватьСобытие(RunId, "LLMCalled", ПолезнаяНагрузкаLLM);

		// Сообщение ассистента сохраняем в контекст.
		СообщениеАссистента = СообщениеAssistant(ОтветLLM.Сообщение);
		Состояние.Сообщения.Добавить(СообщениеАссистента);
		ПоследнийТекст = СтрокаЗначения(ОтветLLM.Сообщение, "content");

		// 4. ПАРСИНГ.
		РазобранныйОтвет = РазобратьОтвет(ОтветLLM);
		Действия = РазобранныйОтвет.Действия;

		// ДИАГНОСТИКА (PERF-03): почему tool_calls модели не доходят до
		// диспетчера. Фиксируем что именно вернул парсер на этом шаге.
		ИменаДействийДиаг = Новый Массив;
		Для Каждого ДействиеДиаг Из Действия Цикл
			ИменаДействийДиаг.Добавить(ИмяДействия(ДействиеДиаг));
		КонецЦикла;
		ТипСообщенияДиаг = "нет";
		СообщениеДиаг = Неопределено;
		Если ТипЗнч(ОтветLLM) = Тип("Структура") Тогда
			ОтветLLM.Свойство("Сообщение", СообщениеДиаг);
			ТипСообщенияДиаг = ?(СообщениеДиаг = Неопределено, "Неопределено", Строка(ТипЗнч(СообщениеДиаг)));
		КонецЕсли;
		ЕстьToolCallsДиаг = "нет";
		Если ТипЗнч(СообщениеДиаг) = Тип("Структура") Тогда
			ToolCallsДиаг = Неопределено;
			СообщениеДиаг.Свойство("tool_calls", ToolCallsДиаг);
			ЕстьToolCallsДиаг = ?(ТипЗнч(ToolCallsДиаг) = Тип("Массив"),
				"массив[" + ToolCallsДиаг.Количество() + "]",
				?(ToolCallsДиаг = Неопределено, "нет ключа", Строка(ТипЗнч(ToolCallsДиаг))));
		КонецЕсли;
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "debug_parse_result",
			"Шаг=" + Формат(Состояние.ШаговВсего, "ЧГ=0")
				+ "; ТипСообщения=" + ТипСообщенияДиаг
				+ "; tool_calls=" + ЕстьToolCallsДиаг
				+ "; Действий=" + Формат(Действия.Количество(), "ЧГ=0")
				+ "; Имена=" + СтрСоединить(ИменаДействийДиаг, ", ")
				+ "; ЕстьОшибкиПарсера=" + Строка(РазобранныйОтвет.ЕстьОшибки),
			"Информация", RunId);

		// 5. Нет действий → финальный ответ, цикл завершён.
		Если Действия.Количество() = 0 Тогда
			Состояние.Результат = ПоследнийТекст;

			// PLAN-17: закрывающий шаг перед финальным ответом. Слабая модель
			// (gemma-4-e2b, живой прогон PLAN-08 2026-09-23 02:16) может вернуть
			// финальный текст без tool-calls, не закрыв объявленный план -
			// пункт остаётся "висящим" pending и в панели чата (PLAN-08), и в
			// консоли (PLAN-06), и в Run Viewer (PLAN-07), хотя по существу
			// задача выполнена. Один дополнительный вызов LLM с единственным
			// доступным tool (update_plan) даёт модели явный шанс закрыть план
			// до того, как ar_Надзор.ПроверитьДостижениеЦели (ниже) прочитает
			// прогресс плана в сводку надзора (PLAN-09). Общая механика
			// вынесена в ВыполнитьВспомогательныйШагПлана (переиспользуется
			// открывающим шагом, см. ветку "6а" ниже по коду) - см. итерацию 2.
			//
			// Условие входа - оба:
			//  1. ПланироватьРаботуДляВыбора = Истина - тот же флаг, что уже
			//     читается для PLAN-15 (выше по коду, не пересчитывается).
			//  2. ar_ПланЗапуска.ТекущийПункт(Состояние.План) <> Неопределено -
			//     план объявлен и содержит незакрытый пункт (in_progress либо
			//     pending). Пункты skipped/done/removed не провоцируют
			//     закрывающий шаг - skipped финален наравне с done (решение из
			//     спеки PLAN-17: не использовать Прогресс().Закрыто, он считает
			//     только done).
			ТекущийПунктДляЗакрытия = Неопределено;
			Если ПланироватьРаботуДляВыбора = Истина Тогда
				ТекущийПунктДляЗакрытия = ar_ПланЗапуска.ТекущийПункт(Состояние.План);
			КонецЕсли;

			Если ТекущийПунктДляЗакрытия <> Неопределено Тогда

				// PLAN-17 (правка оркестратора, итерация 3): текст должен явно
				// требовать вернуть ПОЛНЫЙ список пунктов С ТЕМИ ЖЕ
				// заголовками, что уже в плане (видны модели в системном
				// сообщении "Текущий план: ..." после пересборки окна в
				// ВыполнитьВспомогательныйШагПлана), и статус done - иначе
				// ar_ПланЗапуска.Применить (слияние по нормализованному
				// заголовку) не сопоставит новый текст со старым пунктом и
				// создаст новый вместо закрытия существующего.
				ТекстЗакрытияПлана = НСтр("ru = 'Прежде чем завершить, вызови update_plan и верни ПОЛНЫЙ список пунктов плана с ТЕМИ ЖЕ заголовками, что уже объявлены (см. ""Текущий план"" выше), выставив status=""done"" для всех выполненных пунктов';
					|en = 'Before finishing, call update_plan and return the FULL list of plan items with the SAME titles already announced (see ""Current plan"" above), setting status=""done"" for all completed items'");

				ВыполнитьВспомогательныйШагПлана(Состояние, ДанныеАгента, RunId, КонтекстТриггера,
					ОкноКонтекста, ТекстЗакрытияПлана, "plan_close",
					"Пункт=" + СтрокаЗначения(ТекущийПунктДляЗакрытия, "Заголовок")
						+ "; Статус=" + СтрокаЗначения(ТекущийПунктДляЗакрытия, "Статус"));

			КонецЕсли;

			// PLAN-19 D5-D9: защита от пустого финального ответа (нет текста,
			// нет tool-calls - вход в эту ветку уже это гарантирует). Ровно одна
			// повторная попытка на весь запуск (флаг Состояние.ПустойОтветПопыток,
			// переживает снимок/resume/supervisor_continue - см. спеку, раздел
			// "Ровно одна попытка"). ВАЖНО: строго ПОСЛЕ закрывающего шага плана
			// PLAN-17 выше (:976-994) и ДО сборки ПолезнаяНагрузкаЗавершено ниже -
			// закрывающий шаг не трогает ПоследнийТекст/Состояние.Результат
			// (PLAN-17 D10), поэтому оба механизма не конфликтуют.
			Если ПустаяСтрока(ПоследнийТекст) И Состояние.ПустойОтветПопыток = 0 Тогда

				Состояние.ПустойОтветПопыток = 1;

				ТекстПустогоОтвета = НСтр("ru = 'Ты не дал текстового ответа. Если задача выполнена - кратко сообщи об этом пользователю; если нужно продолжить работу - вызови нужный инструмент';
					|en = 'You did not provide a text response. If the task is complete, briefly tell the user; if more work is needed, call the appropriate tool'");
				Состояние.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), ТекстПустогоОтвета));

				Попытка
					ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "empty_answer_retry",
						"Шаг=" + Формат(Состояние.ШаговВсего, "ЧГ=0"), "Информация", RunId);
				Исключение
					// Best-effort - диагностика не должна ронять запуск.
					ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
						, , "empty_answer_retry: вторичный сбой логирования");
				КонецПопытки;

				// Не завершаем запуск на этой итерации - возвращаемся в начало
				// тела цикла "Пока". Следующая обычная итерация соберёт
				// ОкноКонтекста заново (полный tool_definitions, без ToolChoice)
				// и вызовет LLM тем же путём, что и любой другой шаг (см. спеку,
				// раздел "Механизм реализации"). Инкремент Состояние.ШаговВсего
				// произойдёт естественно в конце итерации ("9. Шаг += 1").
				Продолжить;

			КонецЕсли;

			Если ПустаяСтрока(ПоследнийТекст) И Состояние.ПустойОтветПопыток = 1 Тогда
				// Повторная попытка уже была использована и снова дала пустой
				// ответ - единственный надёжный способ довести текст до трёх
				// независимых потребителей (лента чата, ar_Надзор.СформироватьСводку
				// через Состояние.Результат, ДанныеЗавершено.ОтветLLM) без нового
				// канала. Состояние.Результат уже был присвоен выше (:948) старым
				// (пустым) значением ПоследнийТекст - переприсваиваем здесь тем же
				// системным текстом, чтобы все три потребителя увидели одно и то
				// же (см. спеку, "Куда и как системный текст попадает в UI").
				ПоследнийТекст = НСтр("ru = 'Агент завершил работу без текстового ответа.'; en = 'The agent finished without a text response.'");
				Состояние.Результат = ПоследнийТекст;

				Попытка
					ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", "empty_answer_final",
						"Шаг=" + Формат(Состояние.ШаговВсего, "ЧГ=0"), "Предупреждение", RunId);
				Исключение
					// Best-effort - диагностика не должна ронять запуск.
					ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
						, , "empty_answer_final: вторичный сбой логирования");
				КонецПопытки;
			КонецЕсли;

			ПолезнаяНагрузкаЗавершено = Новый Структура;
			ПолезнаяНагрузкаЗавершено.Вставить("code", "run_completed");
			// UI-22: текст финального ответа ассистента - без него форма ar_Диалог
			// не может отобразить ответ в истории чата (событие llm_called несёт
			// только метрики вызова, а не сам текст).
			ПолезнаяНагрузкаЗавершено.Вставить("content", ПоследнийТекст);
			ЗафиксироватьСобытие(RunId, "Completed", ПолезнаяНагрузкаЗавершено);

			ДанныеЗавершено = Новый Структура;
			ДанныеЗавершено.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Completed);
			ДанныеЗавершено.Вставить("ОтветLLM", ПоследнийТекст);
			ДанныеЗавершено.Вставить("ТокеновВход", Состояние.ТокеновВход);
			ДанныеЗавершено.Вставить("ТокеновВыход", Состояние.ТокеновВыход);
			ДанныеЗавершено.Вставить("ШаговВсего", Состояние.ШаговВсего + 1);

			// CONS-10: надзор за достижением цели - строго после присвоения
			// Состояние.Результат (ПоследнийТекст) и до ЗавершитьЗапуск. Статус
			// Completed не переопределяется - вердикт идёт отдельным полем.
			// ar_Надзор сам гарантирует, что ни одна ошибка не пролетит наружу
			// (D7) - обёртка Попытка здесь не нужна.
			ВердиктНадзора = ar_Надзор.ПроверитьДостижениеЦели(RunId, Состояние, ДанныеАгента, КонтекстТриггера);
			ДанныеЗавершено.Вставить("ПоследнееРешениеНадзора", ВердиктНадзора);

			// CONS-11: три слоя детекции отсутствия прогресса - строго ПОСЛЕ
			// вердикта "Продолжить" (единственная точка, где он осмыслен, см.
			// .docs/specs/CONS-11.md, «Точка вызова трёх слоёв»). Возвращает
			// финальное решение - либо ЗавершитьЗапуск состоится как обычно
			// (Completed, вердикт как есть или переписан на Эскалировать), либо
			// РешениеПродолжения.Продолжать = Истина - тогда ЗавершитьЗапуск НЕ
			// вызывается (см. ПродолжитьЦиклПослеНадзора - сама допишет финальный
			// статус, когда продолжение реально закончится).
			РешениеПродолжения = ar_Надзор.РешитьПродолжатьЛи(RunId, Состояние, ДанныеАгента, ВердиктНадзора);
			Если РешениеПродолжения.ВердиктДляЗаписи <> ВердиктНадзора Тогда
				ДанныеЗавершено.ПоследнееРешениеНадзора = РешениеПродолжения.ВердиктДляЗаписи;
			КонецЕсли;

			Если РешениеПродолжения.Продолжать Тогда
				ПродолжитьЦиклПослеНадзора(СсылкаАгент, RunId, Состояние, ПоследнийТекст, "run_completed");
				Возврат;
			КонецЕсли;

			// PLAN-04: магистральный путь completed - прогресс плана на момент
			// финального ответа LLM.
			ДополнитьДаннымиПлана(ДанныеЗавершено, Состояние);
			ЗавершитьЗапуск(RunId, ДанныеЗавершено);
			// HOOK: OnRunComplete (HOOK-03, точка 10а - completed).
			КонтекстСобытияФинал = Новый Структура;
			КонтекстСобытияФинал.Вставить("RunId", RunId);
			КонтекстСобытияФинал.Вставить("Событие", Перечисления.ar_СобытиеHook.OnRunComplete);
			КонтекстСобытияФинал.Вставить("Статус", Перечисления.ar_СтатусЗапуска.Completed);
			КонтекстСобытияФинал.Вставить("ШаговВсего", Состояние.ШаговВсего + 1);
			КонтекстСобытияФинал.Вставить("ДействийВсего", Состояние.ДействийВсего);
			КонтекстСобытияФинал.Вставить("ТокеновВход", Состояние.ТокеновВход);
			КонтекстСобытияФинал.Вставить("ТокеновВыход", Состояние.ТокеновВыход);
			КонтекстСобытияФинал.Вставить("Результат", ПоследнийТекст);
			КонтекстСобытияФинал.Вставить("Агент", ДанныеАгента.Ссылка);
			ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.OnRunComplete, КонтекстСобытияФинал);
			// SESS-02: сохранить историю сессии (best-effort, не падать).
			СохранитьСессию(Состояние, ДанныеАгента, КонтекстТриггера, RunId);
			Возврат;
		КонецЕсли;

		// 6. PERMISSION + DISPATCH по каждому действию.
		Для Каждого Действие Из Действия Цикл

			ОбработатьДействие(Состояние, Действие, ДанныеАгента, RunId, КонтекстТриггера);

			Состояние.ДействийВсего = Состояние.ДействийВсего + 1;
			Если Состояние.ДействийВсего >= МаксДействий Тогда
				ПолезнаяНагрузкаМаксД = Новый Структура;
				ПолезнаяНагрузкаМаксД.Вставить("code", "max_actions_reached");
				ПолезнаяНагрузкаМаксД.Вставить("actions", Состояние.ДействийВсего);
				ЗафиксироватьСобытие(RunId, "MaxStepsReached", ПолезнаяНагрузкаМаксД);
				Прервать;
			КонецЕсли;

		КонецЦикла;

		// 6а. ОТКРЫВАЮЩИЙ ШАГ (PLAN-17, итерация 2): принудить объявление плана,
		// если модель на первом шаге его не объявила. Симметричен закрывающему
		// шагу (см. ветку "5" выше по коду) и переиспользует ту же механику
		// (ВыполнитьВспомогательныйШагПлана). Живой прогон 0.1.0.368 показал:
		// с tool_choice=required и ПОЛНЫМ набором tools слабая модель (gemma-
		// 4-e2b) выбрала прикладной tool вместо update_plan - план остался не
		// объявлен, закрывающему шагу впоследствии нечего закрывать. Решение:
		// если план пуст ПОСЛЕ первого шага - один дополнительный вызов LLM с
		// единственным доступным tool (update_plan). Полный набор tools на
		// обычном первом шаге НЕ ограничивается (решение пользователя:
		// инструменты модели не скрывать) - ограничение только на этом
		// дополнительном вызове, тем же приёмом, что у закрывающего шага.
		//
		// Условие входа - все четыре:
		//  1. ПланироватьРаботуДляВыбора = Истина - тот же флаг PLAN-15.
		//  2. Состояние.ШаговВсего = 0 - это ещё первый шаг (инкремент строго
		//     в конце итерации цикла, см. "9. Шаг += 1" ниже) - открывающий
		//     шаг выполняется не более одного раза на запуск.
		//  3. Не ЭтоResumeИзСнимка И Не ЭтоПродолжениеНадзора - симметрично
		//     фиксу R-1 части Б: открывающий шаг тоже только для истинно
		//     нового запуска, не для продолжения после паузы/надзора.
		//  4. Состояние.План.Пункты.Количество() = 0 - план не объявлен вовсе
		//     (ни моделью на этом шаге - диспетчеризация update_plan из п.6
		//     уже отработала бы и заполнила Состояние.План, ни унаследован
		//     из предыдущего состояния - для нового запуска План создаётся
		//     пустым в НовоеСостояние). Если модель сама вызвала update_plan
		//     на первом шаге - открывающий шаг не выполняется (План уже не
		//     пуст к этой точке).
		// Если условие не выполнено - поведение не меняется, код продолжается
		// штатно с "7. ПАУЗА ДЛЯ APPROVAL".
		Если ПланироватьРаботуДляВыбора = Истина
			И Состояние.ШаговВсего = 0
			И Не ЭтоResumeИзСнимка И Не ЭтоПродолжениеНадзора
			И Состояние.План.Пункты.Количество() = 0 Тогда

			ТекстОткрытияПлана = НСтр("ru = 'Объяви план работы через update_plan: перечисли этапы задачи, отметь уже выполненные';
				|en = 'Announce the work plan via update_plan: list the task steps, mark the ones already completed'");

			ВыполнитьВспомогательныйШагПлана(Состояние, ДанныеАгента, RunId, КонтекстТриггера,
				ОкноКонтекста, ТекстОткрытияПлана, "plan_open",
				"ШаговВсего=" + Строка(Состояние.ШаговВсего));

		КонецЕсли;

		// 7. ПАУЗА ДЛЯ APPROVAL.
		Если Состояние.ОжидаютApproval > 0 Тогда
			ar_AuditЗащищённыйРежим.СохранитьСнимокПривилегированно(RunId, Состояние);

			ДанныеПауза = Новый Структура;
			ДанныеПауза.Вставить("Статус", Перечисления.ar_СтатусЗапуска.PausedForApproval);
			// PLAN-04: магистральный путь паузы approval (D11) - прогресс плана
			// на момент постановки в очередь.
			ДополнитьДаннымиПлана(ДанныеПауза, Состояние);
			ЗавершитьЗапуск(RunId, ДанныеПауза);

			ПолезнаяНагрузкаПауза = Новый Структура;
			ПолезнаяНагрузкаПауза.Вставить("code", "run_paused_for_approval");
			ПолезнаяНагрузкаПауза.Вставить("pending", Состояние.ОжидаютApproval);
			ЗафиксироватьСобытие(RunId, "Paused", ПолезнаяНагрузкаПауза);
			Возврат;
		КонецЕсли;

		// 7а. ПАУЗА ДЛЯ INPUT (ask_user, TOOL-19 D10).
		// Статус PausedForInput уже выставлен внутри ar_ToolInteraction.ЗадатьВопросПользователю
		// через привилегированный фасад. Здесь только сохраняем снимок и возвращаем.
		Если Состояние.ОжидаютInput > 0 Тогда
			ar_AuditЗащищённыйРежим.СохранитьСнимокПривилегированно(RunId, Состояние);

			ПолезнаяНагрузкаПаузаInput = Новый Структура;
			ПолезнаяНагрузкаПаузаInput.Вставить("code",    "run_paused_for_input");
			ПолезнаяНагрузкаПаузаInput.Вставить("pending", Состояние.ОжидаютInput);
			ЗафиксироватьСобытие(RunId, "Paused", ПолезнаяНагрузкаПаузаInput);
			Возврат;
		КонецЕсли;

		// 7б. ПАУЗА ДЛЯ ОЖИДАНИЯ СОБЫТИЯ (wait_for_event, PLAN-11).
		// R1: tool wait_for_event НЕ пишет статус/ИБ - он только вернул маркер
		// паузы "awaiting_event" (разобран в ОбработатьДействие ниже). Здесь -
		// единственная точка, где статус PausedForEvent и поля
		// ar_ОжидаетСобытия/ar_ОжиданиеДо фактически ставятся, через тот же
		// магистральный путь ЗавершитьЗапуск, что и approval/max_steps (S2).
		Если Состояние.ОжидаютEvent > 0 Тогда
			ar_AuditЗащищённыйРежим.СохранитьСнимокПривилегированно(RunId, Состояние);

			ДанныеПаузаEvent = Новый Структура;
			ДанныеПаузаEvent.Вставить("Статус",         Перечисления.ar_СтатусЗапуска.PausedForEvent);
			ДанныеПаузаEvent.Вставить("ОжидаетСобытия", Состояние.ОжидаемоеСобытиеJSON);
			ДанныеПаузаEvent.Вставить("ОжиданиеДо",     Состояние.ОжиданиеДо);
			ДополнитьДаннымиПлана(ДанныеПаузаEvent, Состояние);
			ЗавершитьЗапуск(RunId, ДанныеПаузаEvent);

			ПолезнаяНагрузкаПаузаEvent = Новый Структура;
			ПолезнаяНагрузкаПаузаEvent.Вставить("code", "wait_started");
			// Эхо object_type/filter из уже сериализованного ar_ОжидаетСобытия -
			// разбор JSON best-effort, не блокирует постановку паузы при сбое.
			Попытка
				РазобранноеОжидание = ar_JSON.ИзJSON(Состояние.ОжидаемоеСобытиеJSON);
				Если ТипЗнч(РазобранноеОжидание) = Тип("Соответствие") Тогда
					ПолезнаяНагрузкаПаузаEvent.Вставить("object_type", РазобранноеОжидание.Получить("object_type"));
					ПолезнаяНагрузкаПаузаEvent.Вставить("filter",      РазобранноеОжидание.Получить("filter"));
				КонецЕсли;
			Исключение
				// Не блокируем постановку паузы - событие останется без деталей.
			КонецПопытки;
			ЗафиксироватьСобытие(RunId, "WaitEvent", ПолезнаяНагрузкаПаузаEvent);

			ПолезнаяНагрузкаПауза7б = Новый Структура;
			ПолезнаяНагрузкаПауза7б.Вставить("code",    "run_paused_for_event");
			ПолезнаяНагрузкаПауза7б.Вставить("pending", Состояние.ОжидаютEvent);
			ЗафиксироватьСобытие(RunId, "Paused", ПолезнаяНагрузкаПауза7б);
			Возврат;
		КонецЕсли;

		// 8. HOOK: AfterStep (HOOK-03, точка 9).
		КонтекстСобытияAfterStep = Новый Структура;
		КонтекстСобытияAfterStep.Вставить("RunId", RunId);
		КонтекстСобытияAfterStep.Вставить("Событие", Перечисления.ar_СобытиеHook.AfterStep);
		КонтекстСобытияAfterStep.Вставить("Sequence", Состояние.ШаговВсего);
		КонтекстСобытияAfterStep.Вставить("Агент", ДанныеАгента.Ссылка);
		КонтекстСобытияAfterStep.Вставить("ДействийНаШаге", Действия.Количество());
		КонтекстСобытияAfterStep.Вставить("ОжидаютApproval", Состояние.ОжидаютApproval);
		ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.AfterStep, КонтекстСобытияAfterStep);

		// 9. Шаг += 1.
		Состояние.ШаговВсего = Состояние.ШаговВсего + 1;

	КонецЦикла;

	// --- После цикла: лимит шагов исчерпан --------------------------------
	ПолезнаяНагрузкаМаксШ = Новый Структура;
	ПолезнаяНагрузкаМаксШ.Вставить("code", "max_steps_reached");
	ПолезнаяНагрузкаМаксШ.Вставить("steps", Состояние.ШаговВсего);
	ЗафиксироватьСобытие(RunId, "MaxStepsReached", ПолезнаяНагрузкаМаксШ);

	ДанныеМаксШ = Новый Структура;
	ДанныеМаксШ.Вставить("Статус", Перечисления.ar_СтатусЗапуска.MaxStepsReached);
	ДанныеМаксШ.Вставить("ОтветLLM", Состояние.Результат);
	ДанныеМаксШ.Вставить("ТокеновВход", Состояние.ТокеновВход);
	ДанныеМаксШ.Вставить("ТокеновВыход", Состояние.ТокеновВыход);
	ДанныеМаксШ.Вставить("ШаговВсего", Состояние.ШаговВсего);

	// CONS-10: надзор за достижением цели - до ЗавершитьЗапуск. Статус
	// MaxStepsReached не переопределяется - вердикт идёт отдельным полем.
	// ar_Надзор сам гарантирует, что ни одна ошибка не пролетит наружу (D7).
	ВердиктНадзораМаксШ = ar_Надзор.ПроверитьДостижениеЦели(RunId, Состояние, ДанныеАгента, КонтекстТриггера);
	ДанныеМаксШ.Вставить("ПоследнееРешениеНадзора", ВердиктНадзораМаксШ);

	// CONS-11: max_steps_reached - это УЖЕ исчерпание бюджета слоя 1
	// (Пока Состояние.ШаговВсего < МаксШагов - накопительная проверка за весь
	// RunId, D1). Продолжать здесь нельзя ни при каких обстоятельствах: новый
	// проход немедленно упрётся в тот же исчерпанный лимит на первой же
	// проверке условия цикла - не законное продолжение, а гарантированный
	// холостой оборот рекурсии. Поэтому здесь слои 2/3 не запрашиваются -
	// вердикт "Продолжить" от ar_Надзор переписывается на "Эскалировать" сразу
	// (budget - единственно возможная причина в этой ветке, см. спеку,
	// «Точка вызова трёх слоёв»).
	Если ВердиктНадзораМаксШ = "Продолжить" Тогда
		ДанныеМаксШ.ПоследнееРешениеНадзора = ar_Надзор.ЗафиксироватьЭскалациюБюджета(RunId);
	КонецЕсли;

	// PLAN-04: магистральный путь max_steps_reached - прогресс плана на момент
	// исчерпания бюджета шагов.
	ДополнитьДаннымиПлана(ДанныеМаксШ, Состояние);
	ЗавершитьЗапуск(RunId, ДанныеМаксШ);

	// HOOK: OnRunComplete (HOOK-03, точка 10в - max_steps_reached).
	КонтекстСобытияФинал = Новый Структура;
	КонтекстСобытияФинал.Вставить("RunId", RunId);
	КонтекстСобытияФинал.Вставить("Событие", Перечисления.ar_СобытиеHook.OnRunComplete);
	КонтекстСобытияФинал.Вставить("Статус", Перечисления.ar_СтатусЗапуска.MaxStepsReached);
	КонтекстСобытияФинал.Вставить("ШаговВсего", Состояние.ШаговВсего);
	КонтекстСобытияФинал.Вставить("ДействийВсего", Состояние.ДействийВсего);
	КонтекстСобытияФинал.Вставить("ТокеновВход", Состояние.ТокеновВход);
	КонтекстСобытияФинал.Вставить("ТокеновВыход", Состояние.ТокеновВыход);
	КонтекстСобытияФинал.Вставить("Результат", Состояние.Результат);
	КонтекстСобытияФинал.Вставить("Агент", ДанныеАгента.Ссылка);
	ar_Hooks.Вызвать(Перечисления.ar_СобытиеHook.OnRunComplete, КонтекстСобытияФинал);

	// SESS-02: сохранить историю сессии (best-effort, не падать).
	СохранитьСессию(Состояние, ДанныеАгента, КонтекстТриггера, RunId);

КонецПроцедуры

// Обработать одно действие: permission → dispatch / deny / approval.
// Результат каждого пути - observation в Состояние.Сообщения.
//
Процедура ОбработатьДействие(Состояние, Действие, ДанныеАгента, RunId, КонтекстТриггера)

	КонтекстЗапуска = КонтекстЗапуска(Состояние, ДанныеАгента, RunId, КонтекстТриггера);

	Решение = РазрешитьДействие(ДанныеАгента, Действие, КонтекстЗапуска);

	// ДИАГНОСТИКА (PERF-03): решение движка разрешений по каждому действию -
	// точка, где вызов либо уходит в диспетчер, либо отсекается.
	ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ОбработатьДействие", "debug_permission_decision",
		"Tool=" + ИмяДействия(Действие)
			+ "; Решение=" + Строка(Решение.Решение)
			+ "; Причина=" + Строка(Решение.Причина),
		"Информация", RunId);

	Если Решение.Решение = "deny" Тогда
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("code", "permission_denied");
		ПолезнаяНагрузка.Вставить("tool", ИмяДействия(Действие));
		ПолезнаяНагрузка.Вставить("reason", Решение.Причина);
		ЗафиксироватьСобытие(RunId, "Denied", ПолезнаяНагрузка);
		ДобавитьObservation(Состояние, Действие,
			"permission denied: " + Решение.Причина);
		Возврат;
	КонецЕсли;

	Если Решение.Решение = "approval_required" Тогда

		// Предвалидация ДО постановки в очередь: аргументы прогоняются через
		// сам tool в режиме dry_run. Без неё пользователь подтверждал заведомо
		// невыполнимое действие - реальный случай: акт сверки без организации
		// ушёл в очередь, был одобрен и только потом отклонён исполнителем с
		// organization_required. Подтверждение тратится впустую, а в аудите
		// остаётся approved-запись, по которой ничего не создано.
		ОшибкаАргументов = ПредпроверкаДействия(Действие, КонтекстЗапуска);
		Если Не ПустаяСтрока(ОшибкаАргументов) Тогда
			ПолезнаяНагрузкаОтказа = Новый Структура;
			ПолезнаяНагрузкаОтказа.Вставить("code", "approval_precheck_failed");
			ПолезнаяНагрузкаОтказа.Вставить("tool", ИмяДействия(Действие));
			ПолезнаяНагрузкаОтказа.Вставить("reason", ОшибкаАргументов);
			ЗафиксироватьСобытие(RunId, "ToolCalled", ПолезнаяНагрузкаОтказа);
			// Ошибка возвращается модели как обычный observation: у неё есть
			// шанс исправить аргументы и повторить вызов в том же запуске.
			ДобавитьObservation(Состояние, Действие, ОшибкаАргументов);
			Возврат;
		КонецЕсли;

		ApprovalId = ПоставитьApproval(КонтекстЗапуска, Состояние, Действие);
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("code", "approval_requested");
		ПолезнаяНагрузка.Вставить("tool", ИмяДействия(Действие));
		ПолезнаяНагрузка.Вставить("approval_id", ApprovalId);
		ЗафиксироватьСобытие(RunId, "ApprovalRequested", ПолезнаяНагрузка);
		ДобавитьObservation(Состояние, Действие,
			"queued for approval (id=" + ApprovalId + ")");
		Состояние.ОжидаютApproval = Состояние.ОжидаютApproval + 1;
		Возврат;
	КонецЕсли;

	// allow. Диспетчер сам пишет действие в ar_ДействияАгента
	// (ar_AuditДействия.Записать) и фиксирует событие tool_dispatched -
	// здесь дублировать запись не нужно.
	РезультатВызова = ВызватьTool(Действие, КонтекстЗапуска);

	ПолезнаяНагрузка = Новый Структура;
	ПолезнаяНагрузка.Вставить("code", "tool_called");
	ПолезнаяНагрузка.Вставить("tool", ИмяДействия(Действие));
	ПолезнаяНагрузка.Вставить("success", РезультатВызова.Успех);
	ПолезнаяНагрузка.Вставить("risk_level", РезультатВызова.RiskLevel);
	ЗафиксироватьСобытие(RunId, "ToolCalled", ПолезнаяНагрузка);

	// ОчиститьОшибкуДляLLM обрезает текст до 500 символов и предназначена для
	// текстов ошибок (стек-трейсы, ИнформацияОбОшибке) - применение к успешному
	// результату tool обрубало валидный JSON (например list_catalogs) на
	// произвольном символе, отправляя модели синтаксически битый observation.
	// Санация нужна только при Успех = Ложь; на успешном результате tool
	// сам отвечает за размер (см. ОграничитьРазмерObservation) и формат.
	Если РезультатВызова.Успех Тогда
		ТекстObservation = РезультатВызова.Результат;
	Иначе
		ТекстObservation = ar_Утилиты.ОчиститьОшибкуДляLLM(РезультатВызова.Результат);
	КонецЕсли;
	ДобавитьObservation(Состояние, Действие, ТекстObservation);

	// TOOL-19: если tool вернул паузу awaiting_user_input - пометить состояние,
	// чтобы основной цикл остановился после dispatch-итерации.
	Попытка
		РезJSON = ar_JSON.ИзJSON(РезультатВызова.Результат);
		ЗначениеПаузы = "";
		Если ТипЗнч(РезJSON) = Тип("Соответствие") Тогда
			ЗначениеПаузы = РезJSON.Получить("paused");
		ИначеЕсли ТипЗнч(РезJSON) = Тип("Структура") Тогда
			РезJSON.Свойство("paused", ЗначениеПаузы);
		КонецЕсли;
		Если ЗначениеПаузы = "awaiting_user_input" Тогда
			Состояние.ОжидаютInput = Состояние.ОжидаютInput + 1;
		ИначеЕсли ЗначениеПаузы = "awaiting_event" Тогда
			// PLAN-11: tool wait_for_event вернул маркер паузы. Данные для
			// ar_ОжидаетСобытия/ar_ОжиданиеДо (см. ветку «7б») формируются
			// здесь, а не внутри tool (R1 - tool не пишет Состояние/ИБ).
			ТипОбъектаПаузы    = "";
			ФильтрПаузы        = Неопределено;
			DeadlineHoursПаузы = 0;
			Если ТипЗнч(РезJSON) = Тип("Соответствие") Тогда
				ТипОбъектаПаузы    = РезJSON.Получить("object_type");
				ФильтрПаузы        = РезJSON.Получить("filter");
				DeadlineHoursПаузы = РезJSON.Получить("deadline_hours");
			КонецЕсли;

			ОжидаемоеСобытие = Новый Структура;
			ОжидаемоеСобытие.Вставить("object_type", ТипОбъектаПаузы);
			ОжидаемоеСобытие.Вставить("filter",      ?(ФильтрПаузы = Неопределено, Новый Структура, ФильтрПаузы));

			Состояние.ОжидаютEvent         = Состояние.ОжидаютEvent + 1;
			Состояние.ОжидаемоеСобытиеJSON = ar_JSON.ВЗначениеJSON(ОжидаемоеСобытие);
			Если ТипЗнч(DeadlineHoursПаузы) = Тип("Число") И DeadlineHoursПаузы > 0 Тогда
				Состояние.ОжиданиеДо = ТекущаяДатаСеанса() + DeadlineHoursПаузы * 3600;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Не блокируем dispatch при ошибке разбора маркера - фиксируем в
		// служебном логе для диагностики (best-effort, сам ar_СлужебныйЛог.
		// Записать не бросает исключений).
		ТекстОшибкиПаузы = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ОбработатьДействие", "paused_marker_parse_failed",
			ТекстОшибкиПаузы, "Предупреждение", RunId);
	КонецПопытки;

	// SCALE-04: после успешного describe_tool - запомнить описанные имена в
	// Состояние.ПодгруженныеTools, чтобы на следующей итерации их манифесты
	// попали в tool_definitions (см. ДозагрузитьОписанныеTools в
	// ВыполнитьАгентаВнутр). Тот же паттерн Попытка/Исключение, что и разбор
	// маркера паузы выше - повреждённый JSON не блокирует dispatch, просто не
	// даёт эффекта.
	Если ИмяДействия(Действие) = "describe_tool" И РезультатВызова.Успех Тогда
		Попытка
			ЗапомнитьОписанныеTools(Состояние, РезультатВызова.Результат);
		Исключение
			// Не блокируем dispatch при ошибке разбора результата describe_tool -
			// фиксируем в служебном логе для диагностики (best-effort).
			ТекстОшибкиРазбора = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ОбработатьДействие", "describe_tool_parse_failed",
				ТекстОшибкиРазбора, "Предупреждение", RunId);
		КонецПопытки;
	КонецЕсли;

	// PLAN-04: после успешного update_plan - слить присланные пункты с
	// Состояние.План (настоящий merge с историей, R1: сам tool мержил с
	// пустым НовыйПлан()) и зафиксировать событие PlanUpdated. Тот же паттерн
	// Попытка/Исключение, что и разбор describe_tool выше - битый JSON не
	// блокирует dispatch.
	Если ИмяДействия(Действие) = "update_plan" И РезультатВызова.Успех Тогда
		Попытка
			ОбработатьРезультатUpdatePlan(Состояние, РезультатВызова, RunId);
		Исключение
			ТекстОшибкиПлана = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ОбработатьДействие", "update_plan_parse_failed",
				ТекстОшибкиПлана, "Предупреждение", RunId);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// SCALE-04: разобрать JSON-результат describe_tool и добавить реально
// найденные имена ("tools[].name") в Состояние.ПодгруженныеTools - без
// дублей, регистронезависимо (тот же паттерн НРег/Соответствие, что в
// СИнструментамиВсегда). Имена из "not_found" не добавляются (спека §5,
// граничный случай «describe_tool вернул not_found для всех имён»).
//
// Параметры:
//  Состояние        - Структура - изменяется на месте (ключ ПодгруженныеTools).
//  РезультатJSON    - Строка    - JSON-observation describe_tool ({"tools":[...],"not_found":[...]}).
//
Процедура ЗапомнитьОписанныеTools(Состояние, Знач РезультатJSON)

	Если Не Состояние.Свойство("ПодгруженныеTools") Тогда
		Возврат;
	КонецЕсли;

	РазобранныйJSON = ar_JSON.ИзJSON(РезультатJSON);
	Если ТипЗнч(РазобранныйJSON) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	СписокTools = РазобранныйJSON.Получить("tools");
	Если ТипЗнч(СписокTools) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Встреченные = Новый Соответствие;
	Для Каждого ИмяУжеПодгруженное Из Состояние.ПодгруженныеTools Цикл
		Встреченные.Вставить(НРег(СокрЛП(Строка(ИмяУжеПодгруженное))), Истина);
	КонецЦикла;

	Для Каждого ЭлементTool Из СписокTools Цикл
		Если ТипЗнч(ЭлементTool) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ИмяTool = СокрЛП(Строка(ЭлементTool.Получить("name")));
		Если ПустаяСтрока(ИмяTool) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(ИмяTool);
		Если Встреченные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Встреченные.Вставить(Ключ, Истина);
		Состояние.ПодгруженныеTools.Добавить(ИмяTool);
	КонецЦикла;

КонецПроцедуры

// PLAN-04: разобрать JSON-observation успешного update_plan и слить
// присланные пункты с Состояние.План через ar_ПланЗапуска.Применить - здесь и
// только здесь происходит настоящее слияние с историей (в отличие от вызова
// внутри самого tool, который мержил с пустым НовыйПлан(), см. R1).
//
// Источник пунктов - "plan" из observation (уже нормализованные/усечённые
// ar_ПланЗапуска.Применить внутри tool), а не повторный разбор аргументов
// вызова steps - тот же итоговый набор пунктов более прямым путём, без
// повторной валидации. Элементы plan[i] после ar_JSON.ИзJSON - тоже
// Соответствие{title,status}, не Структура (граница типов, унаследованная из
// PLAN-03) - конвертация через ar_ПланЗапуска.НовыйПлан не подходит, нужна
// ar_ToolПлан.ПривестиШагиКСтруктурам (решение U7, единственная точка
// конвертации - дублирование запрещено).
//
// После слияния фиксирует событие PlanUpdated (см. Enums.ar_ТипСобытия,
// значение PlanUpdated, Comment: {steps_total, steps_done, steps:
// [{title,status}]}).
//
// Параметры:
//  Состояние       - Структура - изменяется на месте (ключ План).
//  РезультатВызова - Структура - результат ВызватьTool (Успех=Истина, Результат -
//                     JSON-observation update_plan).
//  RunId           - Строка    - для события PlanUpdated.
//
Процедура ОбработатьРезультатUpdatePlan(Состояние, РезультатВызова, RunId)

	// Защита от нарушения контракта вызывающей стороной (Состояние всегда
	// Структура в единственной реальной точке вызова - ОбработатьДействие -
	// но функция не должна падать, если это изменится).
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	РазобранныйJSON = ar_JSON.ИзJSON(РезультатВызова.Результат);
	Если ТипЗнч(РазобранныйJSON) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	СырыеПунктыPlan = РазобранныйJSON.Получить("plan");
	Если ТипЗнч(СырыеПунктыPlan) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	ПунктыКонвертированные = ar_ToolПлан.ПривестиШагиКСтруктурам(СырыеПунктыPlan);

	ПредыдущийПлан = ar_ПланЗапуска.НовыйПлан();
	Если ТипЗнч(Состояние) = Тип("Структура") И Состояние.Свойство("План") Тогда
		ПредыдущийПлан = Состояние.План;
	КонецЕсли;

	Состояние.План = ar_ПланЗапуска.Применить(ПредыдущийПлан, ПунктыКонвертированные);

	Прогресс = ar_ПланЗапуска.Прогресс(Состояние.План);

	// PLAN-06 (итерация 2): прогресс плана пишется в регистр НЕМЕДЛЕННО, здесь
	// же, а не только при ЗавершитьЗапуск/ДополнитьДаннымиПлана. Путь
	// прерывания запуска (Отменить/SCHED-04 sweeper/фейл постановки задания)
	// вызывает ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно
	// с "Прервать" БЕЗ доступа к Состояние - на медленной модели, где обрыв по
	// heartbeat происходит часто, колонка «Этап» иначе всегда оставалась
	// пустой (найденный дефект PLAN-06). Запись здесь идемпотентна и не
	// зависит от исхода запуска; best-effort - ошибка не должна прерывать
	// dispatch (тот же паттерн Попытка/Исключение, что и в вызывающей стороне,
	// ОбработатьДействие).
	Попытка
		ТекущийПунктДляЗаписи = ar_ПланЗапуска.ТекущийПункт(Состояние.План);
		ar_AuditЗащищённыйРежим.ЗаписатьПрогрессПланаПривилегированно(
			RunId,
			Прогресс.Всего,
			Прогресс.Закрыто,
			?(ТекущийПунктДляЗаписи = Неопределено, "", ТекущийПунктДляЗаписи.Заголовок));
	Исключение
		ТекстОшибкиЗаписи = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ОбработатьРезультатUpdatePlan", "plan_progress_write_failed",
			ТекстОшибкиЗаписи, "Предупреждение", RunId);
	КонецПопытки;

	Payload = Новый Структура;
	Payload.Вставить("code", "plan_updated");
	Payload.Вставить("steps_total", Прогресс.Всего);
	Payload.Вставить("steps_done",  Прогресс.Закрыто);
	ШагиPayload = Новый Массив;
	Для Каждого Пункт Из Состояние.План.Пункты Цикл
		ЭлементШага = Новый Структура;
		ЭлементШага.Вставить("title",  Пункт.Заголовок);
		ЭлементШага.Вставить("status", Пункт.Статус);
		ШагиPayload.Добавить(ЭлементШага);
	КонецЦикла;
	Payload.Вставить("steps", ШагиPayload);

	ЗафиксироватьСобытие(RunId, "PlanUpdated", Payload);

КонецПроцедуры

// Прочитать данные агента одним запросом. Возвращает Неопределено, если агент
// не найден или неактивен.
//
// Возвращаемое значение:
//  Структура - {Ссылка, Наименование, ИмяРоли1С, LLMПровайдер, Модель,
//               Температура, МаксШагов, МаксДействий, РежимАвтономии,
//               Инструкция} либо Неопределено.
//
Функция ПрочитатьДанныеАгента(СсылкаАгент)

	Если СсылкаАгент = Неопределено Или Не ЗначениеЗаполнено(СсылкаАгент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(СсылкаАгент) <> Тип("СправочникСсылка.ar_Агенты") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Наименование КАК Наименование,
		|	Агенты.ar_Активен КАК Активен,
		|	Агенты.ar_ИмяРоли1С КАК ИмяРоли1С,
		|	Агенты.ar_LLMПровайдер КАК LLMПровайдер,
		|	Агенты.ar_Модель КАК Модель,
		|	Агенты.ar_Температура КАК Температура,
		|	Агенты.ar_МаксШагов КАК МаксШагов,
		|	Агенты.ar_МаксДействий КАК МаксДействий,
		|	Агенты.ar_МаксСуммаДействия КАК МаксСуммаДействия,
		|	Агенты.ar_РежимАвтономии КАК РежимАвтономии,
		|	Агенты.ar_ИспользоватьСессии КАК ИспользоватьСессии,
		|	Агенты.ar_ПланироватьРаботу КАК ПланироватьРаботу,
		|	Агенты.ar_Инструкция КАК Инструкция
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	Агенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаАгент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Выборка.Активен <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Ссылка",         СсылкаАгент);
	Данные.Вставить("Наименование",   СокрЛП(Строка(Выборка.Наименование)));
	Данные.Вставить("ИмяРоли1С",      СокрЛП(Строка(Выборка.ИмяРоли1С)));
	Данные.Вставить("LLMПровайдер",   Выборка.LLMПровайдер);
	Данные.Вставить("Модель",         СокрЛП(Строка(Выборка.Модель)));
	Данные.Вставить("Температура",    Выборка.Температура);
	Данные.Вставить("МаксШагов",      НормализоватьЛимит(Выборка.МаксШагов, ar_Константы.МаксШагов()));
	Данные.Вставить("МаксДействий",   НормализоватьЛимит(Выборка.МаксДействий, ar_Константы.МаксДействий()));
	// 0 → нет лимита суммы. НормализоватьЛимит не подходит: усекает дробную часть
	// через Цел() (сумма Number 15.2). Используем нормализацию с сохранением копеек.
	Данные.Вставить("МаксСуммаДействия", НормализоватьСуммуЛимита(Выборка.МаксСуммаДействия));
	Данные.Вставить("РежимАвтономии", Выборка.РежимАвтономии);
	Данные.Вставить("ИспользоватьСессии", Выборка.ИспользоватьСессии = Истина);
	// PLAN-04: флажок планирования работы - под ним ДобавитьМанифестUpdatePlan
	// включает tool update_plan в tool_definitions.
	Данные.Вставить("ПланироватьРаботу", Выборка.ПланироватьРаботу = Истина);
	Данные.Вставить("Инструкция",     Строка(Выборка.Инструкция));
	Возврат Данные;

КонецФункции

// Собрать разобранные манифесты tools для режима «без агента» (UI-22) - по
// списку имён из КонтекстТриггера.ОверрайдTools, а не по ar_Агенты.
// ar_ДоступныеTools (см. ar_RuntimeКонтекст.СобратьОпределенияTools).
//
// Параметры:
//  КонтекстТриггера - Структура - ключ ОверрайдTools (Массив строк-имён tools).
//
// Возвращаемое значение:
//  Массив - разобранные JSON-манифесты активных tools (в порядке ОверрайдTools).
//
Функция ОпределенияOverrideTools(КонтекстТриггера)

	Результат = Новый Массив;

	ИменаTools = Неопределено;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("ОверрайдTools", ИменаTools);
	КонецЕсли;

	// ВРЕМЕННО (диагностика UI-22): состав ОверрайдTools на входе.
	ЗаписьЖурналаРегистрации(
		"AgentRunner.Debug.ОпределенияOverrideTools",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("ТипИменTools=%1; Значение=%2",
			Строка(ТипЗнч(ИменаTools)),
			?(ТипЗнч(ИменаTools) = Тип("Массив"), СтрСоединить(ИменаTools, ", "), Строка(ИменаTools))));

	Если ТипЗнч(ИменаTools) <> Тип("Массив") ИЛИ ИменаTools.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат ОпределенияToolsПоИменам(СИнструментамиВсегда(ИменаTools));

КонецФункции

// Дополнить список имён tools теми, что должны быть доступны агенту ВСЕГДА,
// независимо от пользовательского выбора в UI.
//
// Сейчас это ask_user - единственный законный способ задать уточняющий вопрос.
// Без него агент, которому не хватает данных, пишет вопрос обычным текстом и
// завершает запуск: цикл не приостанавливается, ответ пользователя подхватить
// некому, задача обрывается. Пользователь при этом видит осмысленный вопрос и
// не понимает, почему на его ответ ничего не происходит.
//
// Список служебный: выключать эти tools через переключатели UI нельзя, поэтому
// они добавляются здесь, а не в наборе оверрайда.
//
// Параметры:
//  ИменаTools - Массив - имена, выбранные пользователем/агентом.
//
// Возвращаемое значение:
//  Массив - тот же список плюс обязательные tools (без дублей, порядок
//           пользовательских имён сохраняется).
//
Функция СИнструментамиВсегда(Знач ИменаTools)

	Результат = Новый Массив;
	Встреченные = Новый Соответствие;

	Для Каждого Имя Из ИменаTools Цикл
		Ключ = НРег(СокрЛП(Строка(Имя)));
		Если ПустаяСтрока(Ключ) Или Встреченные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Встреченные.Вставить(Ключ, Истина);
		Результат.Добавить(Имя);
	КонецЦикла;

	Для Каждого ОбязательныйTool Из ОбязательныеИнструменты() Цикл
		Если Встреченные.Получить(НРег(ОбязательныйTool)) = Неопределено Тогда
			Результат.Добавить(ОбязательныйTool);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена tools, всегда доступных агенту независимо от выбора в UI.
//
// Возвращаемое значение:
//  Массив из Строка - snake_case-имена служебных tools.
//
Функция ОбязательныеИнструменты()
	Имена = Новый Массив;
	Имена.Добавить("ask_user");
	Возврат Имена;
КонецФункции

// UI-30: JSON-манифесты включённых tools по списку имён (в порядке списка).
// Общая часть ОпределенияOverrideTools и оверрайда tools агентского запуска.
//
// Параметры:
//  ИменаTools - Массив - snake_case-имена tools.
//
// Возвращаемое значение:
//  Массив - разобранные JSON-манифесты активных tools.
//
Функция ОпределенияToolsПоИменам(ИменаTools)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имена", ИменаTools);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Tools.ar_Имя КАК ИмяTool,
		|	Tools.ar_Включён КАК Включён,
		|	Tools.ar_JSONManifest КАК Манифест
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя В (&Имена)";
	Выборка = Запрос.Выполнить().Выбрать();

	// Соответствие имя → манифест, чтобы сохранить порядок ОверрайдTools
	// (важно для стабильности prompt между шагами цикла).
	МанифестыПоИмени = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		// ВРЕМЕННО (диагностика UI-22): что реально нашлось в справочнике.
		ЗаписьЖурналаРегистрации(
			"AgentRunner.Debug.ОпределенияOverrideTools",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон("Найден Tool: Имя=%1; Включён=%2; ДлинаМанифеста=%3",
				Строка(Выборка.ИмяTool), Строка(Выборка.Включён),
				СтрДлина(?(ТипЗнч(Выборка.Манифест) = Тип("Строка"), Выборка.Манифест, ""))));

		Если Выборка.Включён <> Истина Тогда
			Продолжить;
		КонецЕсли;

		МанифестСтрока = ?(ТипЗнч(Выборка.Манифест) = Тип("Строка"),
			Выборка.Манифест, Строка(Выборка.Манифест));
		РазобранныйМанифест = ar_JSON.ИзJSON(МанифестСтрока);
		Если РазобранныйМанифест <> Неопределено Тогда
			МанифестыПоИмени.Вставить(СокрЛП(Строка(Выборка.ИмяTool)), РазобранныйМанифест);
		Иначе
			// ВРЕМЕННО (диагностика UI-22): манифест не распарсился.
			ЗаписьЖурналаРегистрации(
				"AgentRunner.Debug.ОпределенияOverrideTools",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				СтрШаблон("Манифест не распарсился для Tool=%1", Строка(Выборка.ИмяTool)));
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяTool Из ИменаTools Цикл
		Манифест = МанифестыПоИмени.Получить(СокрЛП(Строка(ИмяTool)));
		Если Манифест <> Неопределено Тогда
			Результат.Добавить(НормализованныйМанифестTool(Манифест));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имя tool из манифеста в любом из двух форматов: обёрнутом
// ({"type":"function","function":{"name":...}}) и плоском ({"name":...}).
//
// Читать только "name" нельзя: после нормализации имя лежит внутри "function",
// и проверка дубля переставала находить ask_user, добавляя его вторым.
//
// Параметры:
//  Манифест - Соответствие, Структура - разобранный JSON-манифест.
//
// Возвращаемое значение:
//  Строка - имя tool либо "", если извлечь не удалось.
//
Функция ИмяИзМанифестаTool(Знач Манифест)

	Если ТипЗнч(Манифест) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	ФункцияОписание = Манифест.Получить("function");
	Если ТипЗнч(ФункцияОписание) = Тип("Соответствие") Тогда
		Возврат "" + ФункцияОписание.Получить("name");
	КонецЕсли;

	Возврат "" + Манифест.Получить("name");

КонецФункции

// Вспомогательный шаг плана: один принудительный вызов LLM с единственным
// доступным tool (update_plan), используемый и открывающим, и закрывающим
// шагом (PLAN-17, итерация 2). Общая механика: служебное user-сообщение в
// историю, поиск манифеста update_plan в ОкноКонтекста.tool_definitions,
// укороченный КонтекстLLM (Tools = только update_plan, ToolChoice =
// ForceFunction(update_plan) - см. спеку PLAN-17, раздел "Риски": полный
// набор tools на этом вызове означал бы, что tool_choice=required
// (LM Studio) заставит слабую модель вызвать ЛЮБОЙ доступный tool, включая
// мутирующий прикладной - недопустимо ни до объявления плана, ни после
// финального ответа), один вызов ar_LLMДиспетчер.Вызвать, разбор ответа,
// defensive-диспетчеризация ТОЛЬКО update_plan через ОбработатьДействие,
// метрики (СобратьМетрикиLLM/МетрикиСобытияLLM/событие LLMCalled) и
// диагностика через ar_СлужебныйЛог с префиксом <ПрефиксСобытий>_attempt/
// _applied/_skipped (+причина в тексте события _skipped).
//
// Попытка - ровно одна: возврат (успешный или skipped) происходит после
// первого и единственного вызова LLM, цикл/повтор не предусмотрены -
// однократность гарантируется самим местом вызова (открывающий шаг - один
// раз на запуск сразу после первого шага, закрывающий - один раз на
// прохождение ветки "нет действий").
//
// Параметры:
//  Состояние             - Структура - состояние цикла (Сообщения/План/
//                           ТокеновВход/ТокеновВыход мутируются на месте).
//  ДанныеАгента           - Структура - LLMПровайдер/Модель/Температура.
//  RunId                  - Строка - идентификатор запуска (для событий/лога).
//  КонтекстТриггера       - Структура - пробрасывается в ОбработатьДействие
//                           как есть (тот же контракт, что у основного шага).
//  ОкноКонтекста          - Структура - источник tool_definitions для поиска
//                           манифеста update_plan.
//  ТекстСлужебногоСообщения - Строка - текст user-сообщения, добавляемого в
//                           историю перед вызовом (разный для open/close).
//  ПрефиксСобытий         - Строка - "plan_open" либо "plan_close" - префикс
//                           кодов диагностики в ar_СлужебныйЛог.
//  ОписаниеДляЛога        - Строка - произвольный текст, дописываемый к
//                           диагностике attempt/applied (например, заголовок
//                           текущего пункта плана для закрывающего шага).
//
// Возвращаемое значение:
//  Булево - Истина, если update_plan был успешно применён на этом вызове.
//
Функция ВыполнитьВспомогательныйШагПлана(Состояние, ДанныеАгента, RunId, КонтекстТриггера,
	ОкноКонтекста, Знач ТекстСлужебногоСообщения, Знач ПрефиксСобытий, Знач ОписаниеДляЛога)

	Применено = Ложь;

	Попытка
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", ПрефиксСобытий + "_attempt",
			ОписаниеДляЛога, "Информация", RunId);
	Исключение
		// Best-effort - диагностика не должна ронять вспомогательный шаг плана.
		ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
			, , ПрефиксСобытий + "_attempt: вторичный сбой логирования");
	КонецПопытки;

	// Служебное user-сообщение - тем же паттерном, что
	// ПродолжитьЦиклПослеНадзора (:3147). Вызывающая сторона гарантирует
	// корректную позицию в истории (после последнего assistant-сообщения).
	Состояние.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), ТекстСлужебногоСообщения));

	// PLAN-17 (правка оркестратора, итерация 3): messages для этого вызова -
	// НЕ сырой Состояние.Сообщения (в нём нет системного сообщения вовсе),
	// а пересобранное окно контекста ПОСЛЕ добавления служебного сообщения
	// выше. ПостроитьКонтекст каждый раз заново формирует STABLE-слой
	// (role=system) из Состояние/ДанныеАгента (см. ar_RuntimeКонтекст.
	// СобратьСистемныйPrompt) - в нём актуальный блок "Текущий план: ...",
	// который и должна увидеть модель, чтобы закрыть/объявить ИМЕННО
	// существующие пункты (ar_ПланЗапуска.Применить сливает пункты по
	// нормализованному заголовку, не по индексу - без системного блока с
	// текущими заголовками модель не может их процитировать и создаёт новые
	// вместо закрытия старых). Переданный параметром ОкноКонтекста (снятый в
	// начале основного шага, ДО добавления служебного сообщения и ДО
	// диспетчеризации действий шага) для messages не используется - его
	// блок плана устарел к этому моменту.
	//
	// ВАЖНО: ОкноВсп.tool_definitions НЕ используется для поиска манифеста
	// update_plan - базовый ПостроитьКонтекст его не содержит вовсе, манифест
	// добавляется отдельным вызовом ДобавитьМанифестUpdatePlan в основном
	// шаге (см. :617, ПОСЛЕ ПостроитьКонтекст) - повторный вызов
	// ПостроитьКонтекст здесь его не воспроизводит. Поиск манифеста
	// по-прежнему идёт по параметру ОкноКонтекста.tool_definitions (собран
	// основным шагом целиком, уже включает update_plan) - см. ниже.
	ОкноВсп = ПостроитьКонтекст(Состояние, ДанныеАгента);

	// Манифест update_plan - единственный элемент Tools. НЕ полный
	// tool_definitions - см. комментарий к функции выше и спеку PLAN-17,
	// раздел "Риски". Источник поиска - параметр ОкноКонтекста (не ОкноВсп,
	// см. комментарий выше).
	МанифестUpdatePlanВсп = Неопределено;
	Для Каждого МанифестДляПоиска Из ОкноКонтекста.tool_definitions Цикл
		Если ИмяИзМанифестаTool(МанифестДляПоиска) = "update_plan" Тогда
			МанифестUpdatePlanВсп = МанифестДляПоиска;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если МанифестUpdatePlanВсп = Неопределено Тогда
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", ПрефиксСобытий + "_skipped",
				"причина=update_plan manifest not found in tool_definitions",
				"Предупреждение", RunId);
		Исключение
			// Best-effort - диагностика не должна ронять вспомогательный шаг плана.
			ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВыполнитьАгентаВнутр", УровеньЖурналаРегистрации.Ошибка,
				, , ПрефиксСобытий + "_skipped: вторичный сбой логирования");
		КонецПопытки;
		Возврат Ложь;
	КонецЕсли;

	ToolsВсп = Новый Массив;
	ToolsВсп.Добавить(МанифестUpdatePlanВсп);

	КонтекстLLMВсп = Новый Структура;
	КонтекстLLMВсп.Вставить("Провайдер", ДанныеАгента.LLMПровайдер);
	// PLAN-17 (правка оркестратора, итерация 3): ОкноВсп.messages, не
	// Состояние.Сообщения - см. комментарий у ПостроитьКонтекст выше.
	КонтекстLLMВсп.Вставить("Сообщения", ОкноВсп.messages);
	Если Не ПустаяСтрока(ДанныеАгента.Модель) Тогда
		КонтекстLLMВсп.Вставить("Модель", ДанныеАгента.Модель);
	КонецЕсли;
	Если ТипЗнч(ДанныеАгента.Температура) = Тип("Число") Тогда
		КонтекстLLMВсп.Вставить("Температура", ДанныеАгента.Температура);
	КонецЕсли;
	КонтекстLLMВсп.Вставить("Tools", ToolsВсп);
	НамерениеToolChoiceВсп = Новый Структура;
	НамерениеToolChoiceВсп.Вставить("Намерение", "ForceFunction");
	НамерениеToolChoiceВсп.Вставить("Функция", "update_plan");
	КонтекстLLMВсп.Вставить("ToolChoice", НамерениеToolChoiceВсп);
	КонтекстLLMВсп.Вставить("RunId", RunId);

	Попытка

		МоментДоLLMВсп = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ОтветLLMВсп = ar_LLMДиспетчер.Вызвать(КонтекстLLMВсп);
		ДлительностьLLMВспМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментДоLLMВсп;

		Если Не ОтветLLMВсп.Успех Тогда
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", ПрефиксСобытий + "_skipped",
				"причина=LLM call failed: "
					+ ar_Утилиты.ОчиститьОшибкуДляLLM(ОтветLLMВсп.Ошибка),
				"Предупреждение", RunId);
		Иначе
			СобратьМетрикиLLM(Состояние, ОтветLLMВсп);
			ПолезнаяНагрузкаLLMВсп = МетрикиСобытияLLM(ОтветLLMВсп,
				КонтекстLLMВсп.Сообщения, ДлительностьLLMВспМС);
			ЗафиксироватьСобытие(RunId, "LLMCalled", ПолезнаяНагрузкаLLMВсп);

			СообщениеАссистентаВсп = СообщениеAssistant(ОтветLLMВсп.Сообщение);
			Состояние.Сообщения.Добавить(СообщениеАссистентаВсп);

			РазобранныйОтветВсп = РазобратьОтвет(ОтветLLMВсп);
			ДействияВсп = РазобранныйОтветВсп.Действия;

			Если ДействияВсп.Количество() = 0 Тогда
				ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", ПрефиксСобытий + "_skipped",
					"причина=no tool-calls on this step",
					"Предупреждение", RunId);
			Иначе
				// Defensive: физически исключено, что модель вызовет что-то,
				// кроме update_plan (Tools содержит один элемент), но
				// диспетчеризуем только его - посторонний вызов не прогоняем
				// через ОбработатьДействие.
				Для Каждого ДействиеВсп Из ДействияВсп Цикл
					Если ИмяДействия(ДействиеВсп) = "update_plan" Тогда
						ОбработатьДействие(Состояние, ДействиеВсп, ДанныеАгента, RunId, КонтекстТриггера);
						ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", ПрефиксСобытий + "_applied",
							ОписаниеДляЛога, "Информация", RunId);
						Применено = Истина;
					Иначе
						ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", ПрефиксСобытий + "_skipped",
							"причина=unexpected tool call on this step: " + ИмяДействия(ДействиеВсп),
							"Предупреждение", RunId);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;

	Исключение
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВыполнитьАгентаВнутр", ПрефиксСобытий + "_skipped",
			"причина=exception: " + ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			"Ошибка", RunId);
	КонецПопытки;

	Возврат Применено;

КонецФункции

// Привести манифест tool к контракту OpenAI: {"type":"function","function":{...}}.
//
// Манифесты берутся из справочника ar_Tools как есть, и один некорректный
// элемент ломает распознавание молча: провайдер не видит его как функцию, а
// диагностика показывает tool доступным и включённым. Так ask_user не работал -
// его манифест был плоским, и модель вместо вызова tool писала вопрос текстом
// в чат. Нормализация здесь - страховка для любого tool с той же ошибкой.
//
// Параметры:
//  Манифест - Соответствие, Структура - разобранный JSON-манифест.
//
// Возвращаемое значение:
//  Соответствие, Структура - обёрнутый манифест либо исходный, если он уже
//                            в правильном формате или обернуть нечего.
//
Функция НормализованныйМанифестTool(Знач Манифест)

	Если ТипЗнч(Манифест) <> Тип("Соответствие") Тогда
		Возврат Манифест;
	КонецЕсли;

	// Уже обёрнут - ничего не делаем.
	Если Манифест.Получить("function") <> Неопределено Тогда
		Возврат Манифест;
	КонецЕсли;

	// Плоский манифест распознаём по обязательному полю name.
	Если Манифест.Получить("name") = Неопределено Тогда
		Возврат Манифест;
	КонецЕсли;

	ОбернутыйМанифест = Новый Соответствие;
	ОбернутыйМанифест.Вставить("type", "function");
	ОбернутыйМанифест.Вставить("function", Манифест);
	Возврат ОбернутыйМанифест;

КонецФункции

// UI-30: список имён оверрайда tools из Состояния (переживает снимок/resume).
//
// Возвращаемое значение:
//  Массив - имена tools; пустой массив = оверрайда нет.
//
Функция ОверрайдToolsИзСостояния(Состояние)

	Имена = Неопределено;
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("ОверрайдTools", Имена);
	КонецЕсли;
	Если ТипЗнч(Имена) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Имена;

КонецФункции

// UI-30: признак интерактивного чата из Состояния (триггер manual_chat*).
//
Функция ИнтерактивныйЧатИзСостояния(Состояние)

	Флаг = Ложь;
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("ИнтерактивныйЧат", Флаг);
	КонецЕсли;
	Возврат (Флаг = Истина);

КонецФункции

// UI-30/TOOL-19: добавить манифест ask_user в определения tools, если его нет.
// Манифест читается из реестра ar_Tools (регистрируется ar_ToolInteraction).
//
// Параметры:
//  ОпределенияTools - Массив - разобранные JSON-манифесты (изменяется на месте).
//
Процедура ДобавитьМанифестAskUser(ОпределенияTools)

	Для Каждого Манифест Из ОпределенияTools Цикл
		Если СокрЛП(ИмяИзМанифестаTool(Манифест)) = "ask_user" Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ИменаAsk = Новый Массив;
	ИменаAsk.Добавить("ask_user");
	Определения = ОпределенияToolsПоИменам(ИменаAsk);
	Если Определения.Количество() > 0 Тогда
		ОпределенияTools.Добавить(Определения[0]);
	КонецЕсли;

КонецПроцедуры

// PLAN-04: добавить манифест update_plan в определения tools, если его нет и
// у агента включён флажок ar_ПланироватьРаботу. Манифест читается из реестра
// ar_Tools (регистрируется ar_ToolПлан.ЗарегистрироватьTools, PLAN-03), по
// тому же образцу, что и ДобавитьМанифестAskUser.
//
// Режим «без агента» (UI-22, БезАгента=Истина): ДанныеАгента - синтетическая
// структура без реального флага ar_Агенты (см. ДанныеАгентаБезАгента) -
// обращение через Свойство, а не точку, чтобы отсутствующий ключ не бросал
// исключение; при отсутствии ключа условие ложно, update_plan не добавляется
// (флажок принадлежит конкретному агенту, синтетический агент им не владеет).
//
// Параметры:
//  ОпределенияTools - Массив    - разобранные JSON-манифесты (изменяется на месте).
//  ДанныеАгента      - Структура, Неопределено - см. ПрочитатьДанныеАгента/
//                       ДанныеАгентаБезАгента.
//
Процедура ДобавитьМанифестUpdatePlan(ОпределенияTools, ДанныеАгента)

	ПланироватьРаботу = Ложь;
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("ПланироватьРаботу", ПланироватьРаботу);
	КонецЕсли;
	Если ПланироватьРаботу <> Истина Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Манифест Из ОпределенияTools Цикл
		Если СокрЛП(ИмяИзМанифестаTool(Манифест)) = "update_plan" Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ИменаUpdatePlan = Новый Массив;
	ИменаUpdatePlan.Добавить("update_plan");
	Определения = ОпределенияToolsПоИменам(ИменаUpdatePlan);
	Если Определения.Количество() > 0 Тогда
		ОпределенияTools.Добавить(Определения[0]);
	КонецЕсли;

КонецПроцедуры

// SCALE-04: дозагрузить в ОпределенияTools манифесты tools, накопленных в
// Состояние.ПодгруженныеTools (заполняется в ОбработатьДействие после каждого
// успешного describe_tool). Манифесты, уже присутствующие в наборе по имени
// (ИмяИзМанифестаTool), не дублируются - тот же принцип, что уже применён в
// ДобавитьМанифестAskUser. Дописывает В КОНЕЦ массива, не переставляя порядок
// уже присутствующих определений (план §3.6, стабильность префикса промпта
// для провайдерского кэша).
//
// Параметры:
//  ОпределенияTools - Массив    - разобранные JSON-манифесты (изменяется на месте).
//  Состояние         - Структура - ключ ПодгруженныеTools (Массив из Строка).
//
Процедура ДозагрузитьОписанныеTools(ОпределенияTools, Состояние)

	ПодгруженныеИмена = Неопределено;
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Состояние.Свойство("ПодгруженныеTools", ПодгруженныеИмена);
	КонецЕсли;
	Если ТипЗнч(ПодгруженныеИмена) <> Тип("Массив") ИЛИ ПодгруженныеИмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИменаУжеВНаборе = Новый Соответствие;
	Для Каждого Манифест Из ОпределенияTools Цикл
		Ключ = НРег(СокрЛП(ИмяИзМанифестаTool(Манифест)));
		Если Не ПустаяСтрока(Ключ) Тогда
			ИменаУжеВНаборе.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	ИменаКДозагрузке = Новый Массив;
	Для Каждого Имя Из ПодгруженныеИмена Цикл
		Ключ = НРег(СокрЛП(Строка(Имя)));
		Если ПустаяСтрока(Ключ) ИЛИ ИменаУжеВНаборе.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИменаКДозагрузке.Добавить(Имя);
	КонецЦикла;

	Если ИменаКДозагрузке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// ОпределенияToolsПоИменам уже фильтрует по ar_Включён - tool, выключенный
	// между шагом describe_tool и текущей сборкой контекста, просто не
	// дозагрузится повторно (спека §5, граничный случай).
	Для Каждого Манифест Из ОпределенияToolsПоИменам(ИменаКДозагрузке) Цикл
		ОпределенияTools.Добавить(Манифест);
	КонецЦикла;

КонецПроцедуры

// Синтетический аналог ПрочитатьДанныеАгента для режима «без агента» (UI-22).
// Не читает справочник ar_Агенты (СсылкаАгент - пустая ссылка): провайдер и
// tools берутся из КонтекстТриггера, лимиты и режим автономии - дефолтные и
// самые консервативные (Manual - все Write-действия требуют approval, так
// как анонимный запуск не имеет владельца-агента, которому можно было бы
// доверить автономию).
//
// Параметры:
//  КонтекстТриггера - Структура - обязательные ключи ОверрайдTools (Массив
//                     строк-имён), ОверрайдПровайдер (СправочникСсылка.
//                     ar_LLMПровайдеры). См. ar_RuntimeЗапуск.
//                     СтартоватьВФонеБезАгента.
//
// Возвращаемое значение:
//  Структура - тот же контракт полей, что и ПрочитатьДанныеАгента, либо
//              Неопределено, если ОверрайдПровайдер не задан.
//
Функция ДанныеАгентаБезАгента(КонтекстТриггера)

	Если ТипЗнч(КонтекстТриггера) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОверрайдПровайдер = Неопределено;
	КонтекстТриггера.Свойство("ОверрайдПровайдер", ОверрайдПровайдер);
	Если ТипЗнч(ОверрайдПровайдер) <> Тип("СправочникСсылка.ar_LLMПровайдеры")
		ИЛИ Не ЗначениеЗаполнено(ОверрайдПровайдер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Ссылка",         Справочники.ar_Агенты.ПустаяСсылка());
	Данные.Вставить("Наименование",   НСтр("ru = 'Без агента'; en = 'No agent'"));
	Данные.Вставить("ИмяРоли1С",      "");
	Данные.Вставить("LLMПровайдер",   ОверрайдПровайдер);
	Данные.Вставить("Модель",         "");
	Данные.Вставить("Температура",    Неопределено);
	Данные.Вставить("МаксШагов",      ar_Константы.МаксШагов());
	Данные.Вставить("МаксДействий",   ar_Константы.МаксДействий());
	Данные.Вставить("МаксСуммаДействия", 0);
	Данные.Вставить("РежимАвтономии", Перечисления.ar_РежимАвтономии.Manual);
	// SESS-04: сессии включены и для режима «без агента» - ключ регистра
	// ar_Сессии (Агент=ПустаяСсылка, ЯкорьСсылка=Пользователь) уникален для
	// каждого пользователя, поэтому диалоги разных пользователей не пересекаются.
	// Раньше было жёстко Ложь - каждое сообщение чата стартовало без контекста
	// предыдущих сообщений того же диалога.
	Данные.Вставить("ИспользоватьСессии", Истина);
	Данные.Вставить("Инструкция",     "");
	Возврат Данные;

КонецФункции

// Нормализовать лимит: пустое/нулевое/отрицательное значение → дефолт.
//
Функция НормализоватьЛимит(Знач Значение, Знач Дефолт)
	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Цел(Значение);
	КонецЕсли;
	Возврат Дефолт;
КонецФункции

// Нормализовать лимит денежной суммы действия: пустое/нулевое/отрицательное → 0
// (0 = нет лимита). В отличие от НормализоватьЛимит сохраняет дробную часть
// (сумма - Number 15.2), не усекая копейки через Цел().
//
Функция НормализоватьСуммуЛимита(Знач Значение)
	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Проверить, что текущий пользователь сессии входит в роль ИмяРоли1С агента.
// Пустое ИмяРоли1С - роль не проверяется (агент без ролевого ограничения),
// фиксируется предупреждением в событиях. Проверка выполняется в правах
// текущего пользователя без поднятия привилегий (Plan §3.1).
//
// Параметры:
//  ДанныеАгента - Структура - данные агента из ПрочитатьДанныеАгента;
//                 используется поле ИмяРоли1С (Строка) - имя роли 1С.
//  RunId        - Строка    - идентификатор запуска для фиксации события проверки.
//
// Возвращаемое значение:
//  Булево - Истина, если проверка пройдена (или роль не задана);
//           Ложь - если роль не найдена, пользователь не определён
//           или не входит в роль (→ denied_globally в вызывающем коде).
//
Функция ПроверитьРольПользователя(ДанныеАгента, RunId)

	Если ПустаяСтрока(ДанныеАгента.ИмяРоли1С) Тогда
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("code", "role_check_skipped");
		ПолезнаяНагрузка.Вставить("warning", "agent has empty ИмяРоли1С");
		ЗафиксироватьСобытие(RunId, "PermissionCheck", ПолезнаяНагрузка);
		Возврат Истина;
	КонецЕсли;

	МетаданныеРоли = Метаданные.Роли.Найти(ДанныеАгента.ИмяРоли1С);
	Если МетаданныеРоли = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийПользовательИБ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТекущийПользовательИБ.Роли.Содержит(МетаданныеРоли);

КонецФункции

// CONS-02: строит текст факта об области данных профиля запуска для
// STABLE-слоя промпта (§3.6-подобная секция, аналог ИнструкцияДобавкаРутины).
// Источник профиля - КонтекстТриггера.ПрофильЗапуска, прокинутый
// ar_RuntimeЗапуск.СтартоватьВФоне при резолве по рутине; отсутствие ключа
// (профиль не указан) - штатный, самый частый случай (решение 22, обратная
// совместимость) - возвращает "".
//
// Ошибка чтения/построения (профиль помечен на удаление между записью
// рутины и стартом, сбой запроса) не должна прерывать запуск - по аналогии
// с ar_RuntimeКонтекст.ЗагрузитьБлокПамяти ("вспомогательная секция; ошибка
// не должна прерывать сборку контекста... фиксируем в журнале и продолжаем
// без блока", спека CONS-02 «Граничные случаи»).
//
// Область данных без ограничений (ТЧ ar_ОбластьДанных профиля пуста) -
// секция намеренно не добавляется (симметрично отсутствию профиля - раз
// ограничений нет, факт не несёт информации для модели).
//
// Параметры:
//  КонтекстТриггера - Структура, Неопределено - см. ВыполнитьАгентаВнутр;
//                     ключ ПрофильЗапуска - СправочникСсылка.ar_ПрофилиЗапуска,
//                     опционален.
//  RunId            - Строка(36) - для журнала при ошибке.
//
// Возвращаемое значение:
//  Строка - непустой текст факта либо "".
//
Функция ФактОбластиДанныхПрофиля(Знач КонтекстТриггера, Знач RunId)

	Если ТипЗнч(КонтекстТриггера) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	ПрофильЗапуска = Неопределено;
	Если Не КонтекстТриггера.Свойство("ПрофильЗапуска", ПрофильЗапуска)
		Или Не ЗначениеЗаполнено(ПрофильЗапуска) Тогда
		Возврат "";
	КонецЕсли;

	Попытка

		ТаблицаПравил = ar_ПрофилиЗапуска.ПрочитатьОбластьДанных(ПрофильЗапуска);

		// Профиль без реальных ограничений (ТЧ пуста либо все строки имеют
		// пустой ar_Параметр - см. ar_ПрофилиЗапуска.СгруппироватьПоПараметру) -
		// секция не добавляется вовсе, симметрично отсутствию профиля (спека
		// CONS-02, «Граничные случаи», DoD D6). Проверка через
		// ЭффективнаяОбластьДанныхПоТаблице (Соответствие по параметру), а не
		// по количеству строк ТЧ - та же группировка, что и в расшифровке.
		Если ar_ПрофилиЗапуска.ЭффективнаяОбластьДанныхПоТаблице(ТаблицаПравил).Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;

		Расшифровка = ar_ПрофилиЗапуска.ТекстоваяРасшифровкаПоТаблице(ТаблицаПравил);
		Возврат СтрШаблон(
			НСтр("ru = 'Область данных этого запуска (профиль «%1»):
				|%2'; en = 'Data scope for this run (profile ""%1""):
				|%2'"),
			Строка(ПрофильЗапуска),
			Расшифровка);

	Исключение
		ТекстОш = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'ar_RuntimeЦикл.ФактОбластиДанныхПрофиля'; en = 'ar_RuntimeЦикл.DataScopeFactFromProfile'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон("RunId=%1; %2", RunId, ТекстОш));
		Возврат "";
	КонецПопытки;

КонецФункции

// Создать пустое состояние нового запуска.
//
Функция НовоеСостояние(RunId)
	Состояние = Новый Структура;
	Состояние.Вставить("Сообщения",       Новый Массив);
	Состояние.Вставить("ШаговВсего",      0);
	Состояние.Вставить("ДействийВсего",   0);
	// CONS-11: граница начала ТЕКУЩЕГО прохода в терминах Sequence сквозного
	// счётчика ДействийВсего - используется ar_Надзор для выборки действий
	// именно этого прохода (не всего RunId) при построении отпечатка (слой 2).
	// Для нового запуска = 0; для продолжения после надзора переустанавливается
	// в ПродолжитьЦиклПослеНадзора; при resume после approval/input сохраняется
	// значением из снимка (ДополнитьКлючи ниже подставит 0 только для старых
	// снимков без этого ключа - обратная совместимость).
	Состояние.Вставить("ДействийВсегоНаНачалоПрохода", 0);
	Состояние.Вставить("ОжидаютApproval", 0);
	Состояние.Вставить("ОжидаютInput",   0);
	// PLAN-11: счётчик паузы wait_for_event + данные для ветки «7б» (см.
	// ниже). ДополнитьКлючи подставит эти три поля для снимков до PLAN-11
	// (обратная совместимость, тот же механизм, что и у остальных ключей).
	Состояние.Вставить("ОжидаютEvent",         0);
	Состояние.Вставить("ОжидаемоеСобытиеJSON", "");
	Состояние.Вставить("ОжиданиеДо",           Дата(1, 1, 1));
	Состояние.Вставить("Результат",       "");
	Состояние.Вставить("RunId",           RunId);
	Состояние.Вставить("ТокеновВход",     0);
	Состояние.Вставить("ТокеновВыход",    0);
	Состояние.Вставить("DryRun",          Ложь);
	// MEM-03: UUID пользователя ИБ - инициатора запуска (для памяти-владельца
	// в режиме «без агента»). Заполняется в ВыполнитьАгентаВнутр из
	// КонтекстТриггера.ПользовательUUID.
	Состояние.Вставить("ПользовательUUID", "");
	// SCALE-04: имена tools, подгруженных через describe_tool в рамках этого
	// запуска - дозагружаются в tool_definitions каждой итерации (см.
	// ДозагрузитьОписанныеTools), переживают снимок/resume как обычное поле
	// структуры (ДополнитьКлючи покрывает старые снимки без этого ключа).
	Состояние.Вставить("ПодгруженныеTools", Новый Массив);
	// PLAN-04: план работы агента (update_plan) - Структура{Пункты, Усечено},
	// см. ar_ПланЗапуска.НовыйПлан. Переживает снимок/resume как обычное поле
	// структуры (ДополнитьКлючи подставит пустой план для снимков до PLAN-04).
	Состояние.Вставить("План", ar_ПланЗапуска.НовыйПлан());
	// PLAN-19: счётчик повторных попыток при пустом финальном ответе LLM (без
	// текста и без tool-calls) - "ровно одна попытка на весь запуск". 0 - ещё
	// не использована, 1 - уже использована (не сбрасывается, переживает
	// снимок/resume и supervisor_continue как обычное поле структуры -
	// ДополнитьКлючи подставит 0 для снимков до PLAN-19).
	Состояние.Вставить("ПустойОтветПопыток", 0);
	Возврат Состояние;
КонецФункции

// Восстановить состояние из снимка (resume после approval).
// Снимок берётся либо из КонтекстТриггера.Снимок (положен ar_RuntimeЗапуск.Возобновить),
// либо читается напрямую через ar_AuditЗапуски.ПрочитатьСнимок.
// Возвращает Неопределено при несовместимой версии/отсутствии снимка.
//
Функция ВосстановитьСостояние(RunId, КонтекстТриггера)

	Снимок = Неопределено;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("Снимок", Снимок);
	КонецЕсли;

	Если Снимок = Неопределено Тогда
		Снимок = ar_AuditЗапуски.ПрочитатьСнимок(RunId);
	КонецЕсли;

	Если Снимок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Проверку совместимости версии формата выполняет ar_AuditЗапуски.ПрочитатьСнимок
	// через ar_SnapshotМигратор (RT-09): если снимок вернулся не Неопределено,
	// значит версия совместима или успешно мигрирована. Здесь жёсткой проверки
	// v=1 больше нет - доверяем результату ПрочитатьСнимок.
	Состояние = Неопределено;
	Снимок.Свойство("state", Состояние);
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Гарантируем наличие всех ключей (на случай эволюции формата состояния).
	ДополнитьКлючи(Состояние, НовоеСостояние(RunId));
	Состояние.RunId = RunId;

	// APPR-03: если триггер несёт rejection-observation - вставить его в Сообщения,
	// чтобы LLM на следующем шаге знала, что предыдущее действие отклонено оператором.
	RejectionObs = Неопределено;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура")
		И КонтекстТриггера.Свойство("RejectionObservation", RejectionObs)
		И ТипЗнч(RejectionObs) = Тип("Структура") Тогда
		ВставитьRejectionObservation(Состояние, RejectionObs);
	КонецЕсли;

	// UI-31/APPR-05: массовый approve - по одному tool-результату на каждый
	// approval_id, разрешённый одним кликом «Разрешить все» (см. ar_RuntimeЗапуск.
	// Возобновить, КонтекстОтклонения-Массив). Модель ждёт результат каждого
	// своего tool_call, единая склеенная строка нарушила бы протокол.
	RejectionObsМассив = Неопределено;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура")
		И КонтекстТриггера.Свойство("RejectionObservations", RejectionObsМассив)
		И ТипЗнч(RejectionObsМассив) = Тип("Массив") Тогда
		Для Каждого ОдноНаблюдение Из RejectionObsМассив Цикл
			Если ТипЗнч(ОдноНаблюдение) = Тип("Структура") Тогда
				ВставитьRejectionObservation(Состояние, ОдноНаблюдение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// TOOL-19 D10: если триггер "input_resume" - вставить user_answer как
	// tool-observation, заменяя маркер паузы в последнем сообщении.
	ТекущийТриггер = "";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("Триггер", ТекущийТриггер);
	КонецЕсли;
	Если ТекущийТриггер = "input_resume" Тогда
		UserAnswer = "";
		InputApprovalId = "";
		Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
			КонтекстТриггера.Свойство("user_answer", UserAnswer);
			КонтекстТриггера.Свойство("InputApprovalId", InputApprovalId);
		КонецЕсли;
		ВставитьUserAnswerObservation(Состояние, InputApprovalId, UserAnswer);
	КонецЕсли;

	// PLAN-12 D5: если триггер "event_resume" - вставить observation о
	// наступившем событии как tool-результат, заменяя маркер паузы
	// "awaiting_event" в последнем сообщении. ДопКонтекст собран врезкой
	// ar_RuntimeЗапуск.НайтиИРазбудитьСпящийЗапуск и передан явно через
	// параметр ДопКонтекст функции Возобновить (не через поля КонтекстТриггера
	// типа TOOL-19, где источник - карточка approval).
	Если ТекущийТриггер = "event_resume" Тогда
		EventObjectType = "";
		EventObject = "";
		Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
			КонтекстТриггера.Свойство("event_object_type", EventObjectType);
			КонтекстТриггера.Свойство("event_object", EventObject);
		КонецЕсли;
		ВставитьEventResumeObservation(Состояние, EventObjectType, EventObject);
	КонецЕсли;

	// PLAN-13 D5: если триггер "deadline_resume" - вставить observation о
	// том, что событие не наступило в срок, как tool-результат, заменяя
	// маркер паузы "awaiting_event" в последнем сообщении. В отличие от
	// event_resume, ДопКонтекст не нужен (см. .docs/specs/PLAN-13.md,
	// «Поведение») - дедлайну достаточно факта истечения, не требуется
	// передавать, какой объект/тип наступил (он и не наступил).
	Если ТекущийТриггер = "deadline_resume" Тогда
		ВставитьDeadlineResumeObservation(Состояние);
	КонецЕсли;

	// PLAN-19 D1/D2: после подмены на месте маркера паузы (выше) новость о
	// пробуждении оказывается не в самом конце истории, если открывающий шаг
	// плана PLAN-17 успел отработать до паузы (см. .docs/specs/PLAN-19.md,
	// Факт А) - его хвост assistant(update_plan)/tool(результат) остаётся
	// ПОСЛЕ подменённого observation. Дописываем новое user-сообщение строго
	// в конец Состояние.Сообщения (не заменяя ничего) - слабая модель иначе
	// не воспринимает пробуждение как повод отвечать (живой прогон PLAN-18,
	// 0.1.0.373, два пустых ответа подряд). Только для event_resume/
	// deadline_resume - approval_resume/manual_resume/input_resume не трогаем
	// (обоснование - см. спеку, раздел "approval_resume/input_resume - НЕ
	// трогать").
	Если ТекущийТриггер = "event_resume" Тогда
		ТекстResumeУведомления = НСтр("ru = 'Событие наступило: %1 %2. Продолжи работу и сообщи пользователю итог';
			|en = 'The event has occurred: %1 %2. Continue the work and report the outcome to the user'");
		ТекстResumeУведомления = СтрШаблон(ТекстResumeУведомления, EventObjectType, EventObject);
		Состояние.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), ТекстResumeУведомления));
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВосстановитьСостояние", "event_resume_notice",
				"EventObjectType=" + EventObjectType + "; EventObject=" + EventObject, "Информация", RunId);
		Исключение
			// Best-effort - диагностика не должна ронять restore.
			ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВосстановитьСостояние", УровеньЖурналаРегистрации.Ошибка,
				, , "event_resume_notice: вторичный сбой логирования");
		КонецПопытки;
	ИначеЕсли ТекущийТриггер = "deadline_resume" Тогда
		ТекстResumeУведомления = НСтр("ru = 'Срок ожидания истёк, событие не наступило. Продолжи работу и сообщи пользователю итог';
			|en = 'The waiting deadline has expired, the event did not occur. Continue the work and report the outcome to the user'");
		Состояние.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), ТекстResumeУведомления));
		Попытка
			ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ВосстановитьСостояние", "event_resume_notice",
				"deadline_resume", "Информация", RunId);
		Исключение
			// Best-effort - диагностика не должна ронять restore.
			ЗаписьЖурналаРегистрации("AgentRunner.Debug.ВосстановитьСостояние", УровеньЖурналаРегистрации.Ошибка,
				, , "event_resume_notice: вторичный сбой логирования");
		КонецПопытки;
	Иначе
		// PLAN-19: approval_resume/manual_resume/input_resume и обычный новый
		// запуск - служебное уведомление о резюме не добавляется (см. спеку,
		// раздел "approval_resume/input_resume - НЕ трогать").
	КонецЕсли;

	Возврат Состояние;

КонецФункции

// Вставить tool-observation (role=tool) в Состояние.Сообщения при resume после
// решения оператора по approval - отклонения (APPR-03) или одобрения, включая
// массовый approve (UI-31/APPR-05, вызывается по одной структуре на approval_id).
// Формат согласован с ДобавитьObservation.
//
// Параметры:
//  Состояние         - Структура - восстановленное состояние цикла.
//  КонтекстОтклонения - Структура - {ToolCallId: Строка, ТекстObservation: Строка}.
//
Процедура ВставитьRejectionObservation(Состояние, КонтекстОтклонения)

	ТекстObservation = "";
	КонтекстОтклонения.Свойство("ТекстObservation", ТекстObservation);
	ToolCallId = "";
	КонтекстОтклонения.Свойство("ToolCallId", ToolCallId);

	Наблюдение = Новый Структура;
	Наблюдение.Вставить("role", "tool");
	Наблюдение.Вставить("content", ?(ТипЗнч(ТекстObservation) = Тип("Строка"), ТекстObservation, ""));
	Наблюдение.Вставить("tool_call_id", ?(ТипЗнч(ToolCallId) = Тип("Строка"), ToolCallId, ""));
	Состояние.Сообщения.Добавить(Наблюдение);

КонецПроцедуры

// Вставить ответ оператора (role=tool) в Состояние.Сообщения при resume
// после ask_user (TOOL-19 D10). Обновляет последнее сообщение-паузу (если оно
// содержит маркер awaiting_user_input), заменяя его на ответ оператора.
//
// Параметры:
//  Состояние       - Структура - восстановленное состояние цикла.
//  InputApprovalId - Строка    - UUID записи очереди (для сопоставления).
//  UserAnswer      - Строка    - текст ответа оператора.
//
Процедура ВставитьUserAnswerObservation(Состояние, Знач InputApprovalId, Знач UserAnswer)

	// Найти в Сообщениях последнее tool-сообщение с маркером awaiting_user_input.
	// Если оно есть — заменить его ответом оператора.
	// Если нет — добавить новое сообщение role=tool с ответом (fallback).

	ИндексПаузы = -1;
	ToolCallIdПаузы = "";

	// Обратный перебор: BSL не поддерживает Шаг в цикле Для - счётчик Сч идёт
	// от -(N-1) до 0 с обычным шагом +1, реальный индекс - это -Сч (паттерн БСП,
	// см. напр. ОбщегоНазначения.ЗаполнитьЗначенияСвойств).
	Для Сч = -(Состояние.Сообщения.Количество() - 1) По 0 Цикл
		н = -Сч;
		Сообщение = Состояние.Сообщения[н];
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		РольСооб = "";
		КонтентСооб = "";
		Сообщение.Свойство("role", РольСооб);
		Сообщение.Свойство("content", КонтентСооб);
		Если РольСооб = "tool" Тогда
			ПарсингJSON = ar_JSON.ИзJSON(КонтентСооб);
			ЗначениеПаузы = "";
			Если ТипЗнч(ПарсингJSON) = Тип("Соответствие") Тогда
				ЗначениеПаузы = ПарсингJSON.Получить("paused");
			ИначеЕсли ТипЗнч(ПарсингJSON) = Тип("Структура") Тогда
				ПарсингJSON.Свойство("paused", ЗначениеПаузы);
			КонецЕсли;
			Если ЗначениеПаузы = "awaiting_user_input" Тогда
				ИндексПаузы = н;
				Сообщение.Свойство("tool_call_id", ToolCallIdПаузы);
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ОтветJSON = ar_JSON.ВЗначениеJSON(Новый Структура("user_answer", UserAnswer));

	Если ИндексПаузы >= 0 Тогда
		// Заменяем маркер паузы ответом.
		НовоеСооб = Новый Структура;
		НовоеСооб.Вставить("role",         "tool");
		НовоеСооб.Вставить("content",      ОтветJSON);
		НовоеСооб.Вставить("tool_call_id", ToolCallIdПаузы);
		Состояние.Сообщения.Удалить(ИндексПаузы);
		Состояние.Сообщения.Вставить(ИндексПаузы, НовоеСооб);
	Иначе
		// Fallback: добавляем новое сообщение.
		НовоеСооб = Новый Структура;
		НовоеСооб.Вставить("role",         "tool");
		НовоеСооб.Вставить("content",      ОтветJSON);
		НовоеСооб.Вставить("tool_call_id", "");
		Состояние.Сообщения.Добавить(НовоеСооб);
	КонецЕсли;

	// Сбрасываем счётчик ОжидаютInput чтобы основной цикл не остановился снова.
	Если Состояние.Свойство("ОжидаютInput") Тогда
		Состояние.ОжидаютInput = 0;
	КонецЕсли;

КонецПроцедуры

// Найти в Состояние.Сообщения последнее tool-сообщение с маркером паузы
// "awaiting_event" (эхо ar_ToolПлан.Диспетчер/"ОжидатьСобытия"). Общая
// приватная функция для ВставитьEventResumeObservation (PLAN-12) и
// ВставитьDeadlineResumeObservation (PLAN-13) - обе заменяют один и тот же
// маркер паузы разным итоговым JSON (событие наступило / дедлайн истёк),
// сам поиск идентичен (S1: не дублировать 20+ строк обратного перебора).
// Прямой образец обратного перебора - ВставитьUserAnswerObservation выше
// (другой маркер, "awaiting_user_input").
//
// Параметры:
//  Состояние - Структура - восстановленное состояние цикла.
//
// Возвращаемое значение:
//  Структура - {Индекс: Число, ToolCallId: Строка}. Индекс = -1, если маркер
//  паузы не найден (вызывающая сторона делает fallback - добавляет новое
//  сообщение).
//
Функция НайтиМаркерПаузыAwaitingEvent(Состояние)

	Результат = Новый Структура("Индекс, ToolCallId", -1, "");

	// Обратный перебор: см. комментарий в ВставитьUserAnswerObservation про
	// отсутствие Шаг в цикле Для (паттерн БСП).
	Для Сч = -(Состояние.Сообщения.Количество() - 1) По 0 Цикл
		н = -Сч;
		Сообщение = Состояние.Сообщения[н];
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		РольСооб = "";
		КонтентСооб = "";
		Сообщение.Свойство("role", РольСооб);
		Сообщение.Свойство("content", КонтентСооб);
		Если РольСооб = "tool" Тогда
			ПарсингJSON = ar_JSON.ИзJSON(КонтентСооб);
			ЗначениеПаузы = "";
			Если ТипЗнч(ПарсингJSON) = Тип("Соответствие") Тогда
				ЗначениеПаузы = ПарсингJSON.Получить("paused");
			ИначеЕсли ТипЗнч(ПарсингJSON) = Тип("Структура") Тогда
				ПарсингJSON.Свойство("paused", ЗначениеПаузы);
			КонецЕсли;
			Если ЗначениеПаузы = "awaiting_event" Тогда
				Результат.Индекс = н;
				ToolCallIdПаузы = "";
				Сообщение.Свойство("tool_call_id", ToolCallIdПаузы);
				Результат.ToolCallId = ToolCallIdПаузы;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменить (или добавить, если маркер не найден) tool-сообщение в
// Состояние.Сообщения итоговым JSON-observation по месту найденного
// маркера паузы "awaiting_event". Общий хвост для ВставитьEventResumeObservation
// и ВставитьDeadlineResumeObservation - обе вызывают НайтиМаркерПаузыAwaitingEvent,
// затем эту процедуру с разным ОбъектObservation.
//
// Параметры:
//  Состояние         - Структура - восстановленное состояние цикла.
//  МаркерПаузы        - Структура - результат НайтиМаркерПаузыAwaitingEvent.
//  ОбъектObservation  - Структура - итоговое содержимое tool-результата.
//
Процедура ЗаменитьМаркерПаузыObservation(Состояние, МаркерПаузы, ОбъектObservation)

	ОтветJSON = ar_JSON.ВЗначениеJSON(ОбъектObservation);

	Если МаркерПаузы.Индекс >= 0 Тогда
		// Заменяем маркер паузы итоговым observation.
		НовоеСооб = Новый Структура;
		НовоеСооб.Вставить("role",         "tool");
		НовоеСооб.Вставить("content",      ОтветJSON);
		НовоеСооб.Вставить("tool_call_id", МаркерПаузы.ToolCallId);
		Состояние.Сообщения.Удалить(МаркерПаузы.Индекс);
		Состояние.Сообщения.Вставить(МаркерПаузы.Индекс, НовоеСооб);
	Иначе
		// Fallback: добавляем новое сообщение.
		НовоеСооб = Новый Структура;
		НовоеСооб.Вставить("role",         "tool");
		НовоеСооб.Вставить("content",      ОтветJSON);
		НовоеСооб.Вставить("tool_call_id", "");
		Состояние.Сообщения.Добавить(НовоеСооб);
	КонецЕсли;

	// Сбрасываем счётчик ОжидаютEvent чтобы основной цикл не остановился снова
	// (общий для event_resume и deadline_resume - обе ветки завершают паузу).
	Если Состояние.Свойство("ОжидаютEvent") Тогда
		Состояние.ОжидаютEvent = 0;
	КонецЕсли;

КонецПроцедуры

// Вставить observation о наступившем событии (role=tool) в Состояние.Сообщения
// при resume после пробуждения спящего PausedForEvent-запуска (PLAN-12 D5).
// Обновляет последнее сообщение-паузу (если оно содержит маркер
// "awaiting_event" - эхо ar_ToolПлан.Диспетчер/"ОжидатьСобытия"), заменяя его
// на подтверждение наступления события.
//
// Параметры:
//  Состояние       - Структура - восстановленное состояние цикла.
//  EventObjectType - Строка    - полное имя типа сработавшего объекта.
//  EventObject     - Строка    - строковое представление сработавшей ссылки.
//
Процедура ВставитьEventResumeObservation(Состояние, Знач EventObjectType, Знач EventObject)

	МаркерПаузы = НайтиМаркерПаузыAwaitingEvent(Состояние);

	ОбъектObservation = Новый Структура;
	ОбъектObservation.Вставить("event_occurred", Истина);
	ОбъектObservation.Вставить("object_type",    EventObjectType);
	ОбъектObservation.Вставить("object",         EventObject);

	ЗаменитьМаркерПаузыObservation(Состояние, МаркерПаузы, ОбъектObservation);

КонецПроцедуры

// Вставить observation об истёкшем дедлайне (role=tool) в Состояние.Сообщения
// при resume после дедлайна ожидания события (PLAN-13 D5, триггер
// "deadline_resume", ar_Scheduler.ОбработатьОдинДедлайн). Обновляет последнее
// сообщение-паузу (если оно содержит маркер "awaiting_event"), заменяя его на
// подтверждение НЕнаступления события - модель, увидев свой же маркер паузы
// с event_occurred=false, понимает, что дедлайн истёк, а не что фильтр
// совпал, и может продолжить работу другим путём или сама решить
// эскалировать/завершиться. Эхо-контракт симметричен event_resume
// (event_occurred: true vs false).
//
// Параметры:
//  Состояние - Структура - восстановленное состояние цикла.
//
Процедура ВставитьDeadlineResumeObservation(Состояние)

	МаркерПаузы = НайтиМаркерПаузыAwaitingEvent(Состояние);

	ОбъектObservation = Новый Структура;
	ОбъектObservation.Вставить("event_occurred", Ложь);
	ОбъектObservation.Вставить("reason",         "deadline_expired");
	ОбъектObservation.Вставить("object_type",    "");

	ЗаменитьМаркерПаузыObservation(Состояние, МаркерПаузы, ОбъектObservation);

КонецПроцедуры

// Дополнить структуру недостающими ключами из эталона (без перезаписи имеющихся).
//
Процедура ДополнитьКлючи(Структура, Эталон)
	Для Каждого КлючЗначение Из Эталон Цикл
		Если Не Структура.Свойство(КлючЗначение.Ключ) Тогда
			Структура.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Аккумулировать токены LLM между шагами цикла (диспетчер не суммирует - LLM-06).
//
Процедура СобратьМетрикиLLM(Состояние, ОтветLLM)
	ТокеновВход = 0;
	ОтветLLM.Свойство("ТокеновВход", ТокеновВход);
	ТокеновВыход = 0;
	ОтветLLM.Свойство("ТокеновВыход", ТокеновВыход);
	Если ТипЗнч(ТокеновВход) = Тип("Число") Тогда
		Состояние.ТокеновВход = Состояние.ТокеновВход + ТокеновВход;
	КонецЕсли;
	Если ТипЗнч(ТокеновВыход) = Тип("Число") Тогда
		Состояние.ТокеновВыход = Состояние.ТокеновВыход + ТокеновВыход;
	КонецЕсли;
КонецПроцедуры

// Payload события llm_called.
//
// Параметры:
//   ОтветLLM       - Структура - ответ LLM-диспетчера (LLM-02): usage, провайдер, попытки.
//   Сообщения      - Массив, Неопределено - (UI-11) массив сообщений prompt, отправленный
//                    в LLM на этом шаге (КонтекстLLM.Сообщения, см. СобратьКонтекстLLM).
//                    Сохраняется в payload как ключ "messages" - полный prompt для
//                    модального просмотра в CommonForm.ar_ПросмотрЗапуска
//                    («Показать prompt»). Аддитивный параметр: Неопределено по умолчанию
//                    не меняет существующий состав payload (code/tokens_in/tokens_out/
//                    provider/attempts).
//   ДлительностьМС - Число - (CONS-16) длительность вызова ar_LLMДиспетчер.Вызвать
//                    в миллисекундах, включая ретраи внутри диспетчера. Аддитивный
//                    параметр со значением по умолчанию 0 - существующие вызовы
//                    МетрикиСобытияLLM без третьего аргумента не ломаются.
//                    Сохраняется в payload как ключ "latency_ms". Используется
//                    ступенью сжатия ar_Scheduler.СжатьПорциюСобытийLLM (30 дней) -
//                    единственное поле сводки, которое переживает удаление "messages".
//
// LLM-14 (часть Б): payload дополнительно содержит "balance_rub"
// (Число|Неопределено) и "low_balance" (Булево) - баланс шлюза AgentRunner
// Cloud из успешного ответа. У остальных провайдеров - дефолты
// Неопределено/Ложь, без исключений.
//
// Возвращаемое значение:
//   Структура - payload события LLMCalled: code, tokens_in, tokens_out,
//               provider, attempts, latency_ms, balance_rub, low_balance, messages.
//
Функция МетрикиСобытияLLM(ОтветLLM, Сообщения = Неопределено, ДлительностьМС = 0)
	Payload = Новый Структура;
	Payload.Вставить("code", "llm_called");
	ТокеновВход = 0;
	ОтветLLM.Свойство("ТокеновВход", ТокеновВход);
	ТокеновВыход = 0;
	ОтветLLM.Свойство("ТокеновВыход", ТокеновВыход);
	ПровайдерИтог = "";
	ОтветLLM.Свойство("ПровайдерИтог", ПровайдерИтог);
	ПопытокСделано = 0;
	ОтветLLM.Свойство("ПопытокСделано", ПопытокСделано);
	Payload.Вставить("tokens_in", ТокеновВход);
	Payload.Вставить("tokens_out", ТокеновВыход);
	Payload.Вставить("provider", ПровайдерИтог);
	Payload.Вставить("attempts", ПопытокСделано);
	Payload.Вставить("latency_ms", ДлительностьМС);

	// LLM-14 (часть Б): balance_rub/low_balance - опциональные поля ответа
	// LLM-диспетчера (заполняет только ar_LLMAgentRunnerCloud). Читаем
	// защищённо через Свойство(), т.к. у остальных провайдеров ключей может
	// не быть физически - хотя после расширения ar_LLMДиспетчер.
	// НовыйРезультатПровайдера() они там будут как дефолты
	// (Неопределено/Ложь).
	БалансРуб = Неопределено;
	ОтветLLM.Свойство("БалансРуб", БалансРуб);
	БалансНизкий = Ложь;
	ОтветLLM.Свойство("БалансНизкий", БалансНизкий);
	Payload.Вставить("balance_rub", БалансРуб);
	Payload.Вставить("low_balance", БалансНизкий);

	// UI-11: полный массив сообщений prompt (для модального просмотра).
	Если ТипЗнч(Сообщения) = Тип("Массив") Тогда
		Payload.Вставить("messages", Сообщения);
	Иначе
		Payload.Вставить("messages", Новый Массив);
	КонецЕсли;

	Возврат Payload;
КонецФункции

// Проверить статус отмены запуска. Возвращает Истина, если статус = Cancelled
// (требуется немедленный выход без дополнительных событий).
//
Функция ПроверитьОтмену(RunId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запуски.ar_Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|ГДЕ
		|	Запуски.ar_RunId = &RunId";
	Запрос.УстановитьПараметр("RunId", RunId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус = Перечисления.ar_СтатусЗапуска.Cancelled;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Контекст для передачи в LLM-диспетчер (контракт LLM-02).
//
Функция СобратьКонтекстLLM(ОкноКонтекста, ДанныеАгента)

	КонтекстLLM = Новый Структура;
	КонтекстLLM.Вставить("Провайдер", ДанныеАгента.LLMПровайдер);

	Сообщения = Неопределено;
	Если ТипЗнч(ОкноКонтекста) = Тип("Структура") Тогда
		ОкноКонтекста.Свойство("messages", Сообщения);
	КонецЕсли;
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Сообщения = Новый Массив;
	КонецЕсли;
	КонтекстLLM.Вставить("Сообщения", Сообщения);

	Если Не ПустаяСтрока(ДанныеАгента.Модель) Тогда
		КонтекстLLM.Вставить("Модель", ДанныеАгента.Модель);
	КонецЕсли;
	Если ТипЗнч(ДанныеАгента.Температура) = Тип("Число") Тогда
		КонтекстLLM.Вставить("Температура", ДанныеАгента.Температура);
	КонецЕсли;

	ОпределенияTools = Неопределено;
	Если ТипЗнч(ОкноКонтекста) = Тип("Структура") Тогда
		ОкноКонтекста.Свойство("tool_definitions", ОпределенияTools);
	КонецЕсли;
	Если ТипЗнч(ОпределенияTools) = Тип("Массив") Тогда
		КонтекстLLM.Вставить("Tools", ОпределенияTools);
	КонецЕсли;

	Возврат КонтекстLLM;

КонецФункции

// Контекст запуска для permission/dispatch (КонтекстЗапуска).
//
// Sequence - порядковый номер текущего действия внутри запуска (= число уже
// выполненных действий). Используется диспетчером для измерения регистра
// ar_ДействияАгента и для детерминированного IdempotencyKey (DISP-04).
//
// MEM-03: поле ПользовательUUID пробрасывается из Состояния - tools памяти
// (ar_ToolПамять.Запомнить/ВспомнитьПамять) используют его как владельца
// записи/поиска, когда Агент пуст (режим «без агента», UI-22).
//
Функция КонтекстЗапуска(Состояние, ДанныеАгента, RunId, КонтекстТриггера = Неопределено)
	// DryRun берётся из Состояния (проставлено из КонтекстТриггера в
	// ВыполнитьАгентаВнутр, DISP-03). Дефолт - Ложь, если ключ отсутствует
	// (старый снимок до DISP-03 - ДополнитьКлючи добавит Ложь при resume).
	DryRun = Ложь;
	Состояние.Свойство("DryRun", DryRun);

	// MEM-03: UUID пользователя ИБ из Состояния (заполнено в ВыполнитьАгентаВнутр
	// из КонтекстТриггера.ПользовательUUID). Дефолт - "" (старый снимок без поля -
	// ДополнитьКлючи подставит "").
	ПользовательUUID = "";
	Состояние.Свойство("ПользовательUUID", ПользовательUUID);
	ПользовательUUID = СокрЛП(?(ТипЗнч(ПользовательUUID) = Тип("Строка"), ПользовательUUID, ""));

	Контекст = Новый Структура;
	Контекст.Вставить("RunId", RunId);
	Контекст.Вставить("Агент", ДанныеАгента.Ссылка);
	Контекст.Вставить("РежимАвтономии", ДанныеАгента.РежимАвтономии);
	Контекст.Вставить("DryRun", (DryRun = Истина));
	Контекст.Вставить("Sequence", Состояние.ДействийВсего);
	Контекст.Вставить("ПользовательUUID", ПользовательUUID);

	// UI-22: режим «без агента» - whitelist tool проверяется по ОверрайдTools
	// вместо ar_Агенты.ar_ДоступныеTools (см. ar_PermissionEngine.ТоолВWhitelist).
	БезАгента = Ложь;
	ОверрайдTools = Неопределено;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("БезАгента", БезАгента);
		КонтекстТриггера.Свойство("ОверрайдTools", ОверрайдTools);
	КонецЕсли;
	Если БезАгента = Истина Тогда
		Контекст.Вставить("БезАгента", Истина);
		Контекст.Вставить("ОверрайдTools", ?(ТипЗнч(ОверрайдTools) = Тип("Массив"), ОверрайдTools, Новый Массив));
	Иначе
		// UI-30: оверрайд tools агентского запуска - whitelist L1 проверяется
		// по этому списку (см. ar_PermissionEngine.ВыполнитьПроверки). Источник -
		// Состояние: переживает resume, в отличие от КонтекстТриггера.
		ИменаОверрайда = ОверрайдToolsИзСостояния(Состояние);
		Если ИменаОверрайда.Количество() > 0 Тогда
			Контекст.Вставить("ОверрайдTools", ИменаОверрайда);
		КонецЕсли;
	КонецЕсли;

	Возврат Контекст;
КонецФункции

// Добавить observation (role=tool) в контекст сообщений.
//
Процедура ДобавитьObservation(Состояние, Действие, ТекстНаблюдения)
	Наблюдение = Новый Структура;
	Наблюдение.Вставить("role", "tool");
	Наблюдение.Вставить("content", ?(ТипЗнч(ТекстНаблюдения) = Тип("Строка"), ТекстНаблюдения, ""));
	Наблюдение.Вставить("tool_call_id", ИдВызоваДействия(Действие));
	Состояние.Сообщения.Добавить(Наблюдение);
КонецПроцедуры

// Сообщение ассистента из ответа LLM (сохраняет tool_calls при наличии).
//
Функция СообщениеAssistant(СообщениеИзLLM)
	Сообщение = Новый Структура;
	Сообщение.Вставить("role", "assistant");
	Сообщение.Вставить("content", СтрокаЗначения(СообщениеИзLLM, "content"));
	ToolCalls = Неопределено;
	Если ТипЗнч(СообщениеИзLLM) = Тип("Структура") И СообщениеИзLLM.Свойство("tool_calls", ToolCalls) Тогда
		Если ТипЗнч(ToolCalls) = Тип("Массив") И ToolCalls.Количество() > 0 Тогда
			Сообщение.Вставить("tool_calls", ToolCalls);
		КонецЕсли;
	КонецЕсли;
	Возврат Сообщение;
КонецФункции

// Безопасно извлечь строковое значение по ключу из Структуры/Соответствия.
//
Функция СтрокаЗначения(Источник, Ключ)
	Значение = Неопределено;
	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Источник.Свойство(Ключ, Значение);
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Значение = Источник.Получить(Ключ);
	Иначе
		Значение = Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Имя инструмента из разобранного действия.
//
Функция ИмяДействия(Действие)
	Имя = "";
	Если ТипЗнч(Действие) = Тип("Структура") Тогда
		Действие.Свойство("Имя", Имя);
		Если ПустаяСтрока(Имя) Тогда
			Действие.Свойство("name", Имя);
		КонецЕсли;
	КонецЕсли;
	Возврат ?(ТипЗнч(Имя) = Тип("Строка"), Имя, "");
КонецФункции

// Идентификатор tool-call из разобранного действия (для tool_call_id observation).
//
Функция ИдВызоваДействия(Действие)
	Ид = "";
	Если ТипЗнч(Действие) = Тип("Структура") Тогда
		Действие.Свойство("ИдВызова", Ид);
		Если ПустаяСтрока(Ид) Тогда
			Действие.Свойство("id", Ид);
		КонецЕсли;
	КонецЕсли;
	Возврат ?(ТипЗнч(Ид) = Тип("Строка"), Ид, "");
КонецФункции

// Нормализовать значение якоря из КонтекстТриггера в строковый ключ ar_Якорь (SESS-05).
//
// Единая точка конвертации: источники триггеров (форма ar_Диалог,
// ar_ОбработчикПодписок, ar_Scheduler) по-прежнему кладут в КонтекстТриггера
// либо готовую строку (chat:<uuid>), либо ссылку ИБ на объект - конвертация
// в универсальный строковый формат происходит здесь, один раз, на входе
// в ядро (ПодмешатьИсториюСессии/СохранитьСессию).
//
// Правила:
//  * Строка с известным префиксом (chat:/ref:/agent:) - возвращается как есть.
//  * ЛюбаяСсылка (в т.ч. незаимствованный тип - XMLСтрока не требует
//    заимствования) - оборачивается в "ref:" + XMLСтрока(Ссылка).
//  * Неопределено/пустая ссылка/неизвестный тип - пустая строка ("якоря нет",
//    сохраняет no-op контракт SESS-01/02).
//
// Параметры:
//  ЗначениеИзКонтекста - Строка, ЛюбаяСсылка, Неопределено - сырое значение
//                        КонтекстТриггера.ЯкорьСсылка.
//
// Возвращаемое значение:
//  Строка - нормализованный якорь ar_Якорь либо пустая строка.
//
Функция НормализоватьЯкорьДляСессии(ЗначениеИзКонтекста)

	Если ЗначениеИзКонтекста = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(ЗначениеИзКонтекста) = Тип("Строка") Тогда
		Возврат ЗначениеИзКонтекста;
	КонецЕсли;

	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеИзКонтекста)) Тогда
		Если Не ЗначениеЗаполнено(ЗначениеИзКонтекста) Тогда
			Возврат "";
		КонецЕсли;
		Попытка
			Возврат "ref:" + XMLСтрока(ЗначениеИзКонтекста);
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='AgentRunner.SESS-05: ошибка нормализации якоря сессии'"),
				УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
			Возврат "";
		КонецПопытки;
	КонецЕсли;

	// Неизвестный тип - трактуем как "якоря нет".
	Возврат "";

КонецФункции

// Подмешать историю активной сессии в Состояние.Сообщения (SESS-01).
//
// Выполняется ТОЛЬКО для нового (не resume) запуска - вызывается из ветки
// Иначе-блока ВыполнитьАгентаВнутр сразу после НовоеСостояние.
//
// Параметры:
//  Состояние          - Структура - состояние цикла (свежесозданное НовоеСостояние).
//  СсылкаАгент        - СправочникСсылка.ar_Агенты - запускаемый агент.
//  КонтекстТриггера   - Структура - контекст триггера запуска.
//  ДанныеАгента       - Структура - данные агента (содержит ИспользоватьСессии).
//  RunId              - Строка(36) - идентификатор текущего запуска (для SESS-08 лога).
//
Процедура ПодмешатьИсториюСессии(Состояние, СсылкаАгент, КонтекстТриггера, ДанныеАгента, RunId)

	// --- Шаг 1: извлечение и нормализация Якоря из КонтекстТриггера (SESS-05) ---
	СыройЯкорь = Неопределено;
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("ЯкорьСсылка", СыройЯкорь);
	КонецЕсли;

	Якорь = НормализоватьЯкорьДляСессии(СыройЯкорь);

	// SESS-Debug (диагностика в разработке, оставлено намеренно): якорь
	// сессии на чтении - сверять с записью "form_created" (ar_Диалог) и
	// "sess_write" (ниже в СохранитьСессию), чтобы отслеживать воспроизведение
	// Якоря между сообщениями одного окна чата.
	ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ПодмешатьИсториюСессии", "sess_read",
		СтрШаблон("СыройЯкорь=%1, Якорь='%2'",
			?(СыройЯкорь = Неопределено, "Неопределено", Строка(СыройЯкорь)), Якорь),
		, RunId);

	// Если Якорь не передан, не заполнен или неизвестного формата - no-op.
	Если ПустаяСтрока(Якорь) Тогда
		Возврат;
	КонецЕсли;

	// Примечание: СсылкаАгент может быть пустой ссылкой для no-agent-запуска
	// (см. ar_RuntimeЗапуск.СтартоватьВФонеБезАгента) - это допустимо, приводится
	// к ключу измерения через ar_AuditЗащищённыйРежим.КлючИзмеренияАгент (SESS-07),
	// симметрично записи в СохранитьСессию (SESS-04/SESS-06).

	// --- Шаг 2: проверка флага ИспользоватьСессии (SESS-04) ---
	// Сессии - opt-in (ar_ИспользоватьСессии), требуют непустого Якоря.
	// UI-30: для чат-якорей (chat:*) сессия ведётся всегда - иначе «продолжить
	// старый диалог» не даёт LLM контекста у агентов с выключенным флагом.
	ИспользоватьСессии = Ложь;
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("ИспользоватьСессии", ИспользоватьСессии);
	КонецЕсли;
	Если ИспользоватьСессии <> Истина И Не СтрНачинаетсяС(Якорь, "chat:") Тогда
		Возврат;
	КонецЕсли;

	// --- Шаг 3: поиск записи ar_Сессии по (Агент, Якорь) ---
	// SESS-06: чтение выполняется привилегированно (см. doc-комментарий
	// ar_AuditЗащищённыйРежим.ПрочитатьСессиюПривилегированно) - симметрично
	// привилегированной записи в СохранитьСессию, у обычного пользователя
	// нет права "Чтение" на ar_Сессии.
	МенеджерЗаписи = ar_AuditЗащищённыйРежим.ПрочитатьСессиюПривилегированно(СсылкаАгент, Якорь);

	ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ПодмешатьИсториюСессии", "sess_read_result",
		СтрШаблон("Выбран=%1 по Якорь='%2'", МенеджерЗаписи.Выбран(), Якорь), , RunId);

	Если Не МенеджерЗаписи.Выбран() Тогда
		// Запись не найдена - истории нет, no-op.
		Возврат;
	КонецЕсли;

	// Запись найдена - проверяем активность.
	Если МенеджерЗаписи.ar_Активна <> Истина Тогда
		// Сессия деактивирована (TTL истёк или закрыта вручную) -
		// трактуем как «истории нет», не реактивируем (SESS-02/SESS-03).
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ПодмешатьИсториюСессии", "sess_inactive",
			СтрШаблон("ar_Активна=%1", МенеджерЗаписи.ar_Активна), , RunId);
		Возврат;
	КонецЕсли;

	ИсторияИзСессии = ИзвлечьИсториюИзМенеджераЗаписи(МенеджерЗаписи);

	ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ПодмешатьИсториюСессии", "sess_extract_result",
		СтрШаблон("ИсторияИзСессии=%1, Количество=%2",
			?(ИсторияИзСессии = Неопределено, "Неопределено", "Массив"),
			?(ИсторияИзСессии = Неопределено, "-", Строка(ИсторияИзСессии.Количество()))), , RunId);

	Если ИсторияИзСессии = Неопределено
		Или ИсторияИзСессии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// --- Шаг 4: подмешивание истории в начало Состояние.Сообщения ---
	// Состояние.Сообщения гарантированно пуст (из НовоеСостояние) -
	// Добавить() эквивалентно вставке в начало.
	Для Каждого Сообщение Из ИсторияИзСессии Цикл
		Состояние.Сообщения.Добавить(Сообщение);
	КонецЦикла;

	ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ПодмешатьИсториюСессии", "sess_merged",
		СтрШаблон("ПодмешаноСообщений=%1, ВсегоВСостоянии=%2",
			ИсторияИзСессии.Количество(), Состояние.Сообщения.Количество()), , RunId);

КонецПроцедуры

// Извлечь и десериализовать историю сообщений из ХранилищеЗначения записи
// регистра ar_Сессии. Толерантна к формату снимка (Структура/Соответствие)
// и к отсутствию/повреждению данных - вынесена отдельно от
// ПодмешатьИсториюСессии для снижения когнитивной сложности вызывающей
// процедуры.
//
// Параметры:
//  МенеджерЗаписи - РегистрСведенийМенеджерЗаписи.ar_Сессии - прочитанная запись.
//
// Возвращаемое значение:
//  Массив, Неопределено - массив сообщений истории либо Неопределено,
//                          если данных нет/формат не распознан.
//
Функция ИзвлечьИсториюИзМенеджераЗаписи(МенеджерЗаписи)

	Хранилище = МенеджерЗаписи.ar_ИсторияСжатая;
	Если Хранилище = Неопределено
		Или ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ИзвлечьИсториюИзМенеджераЗаписи", "sess_no_storage",
			СтрШаблон("ТипХранилища=%1", ?(Хранилище = Неопределено, "Неопределено", ТипЗнч(Хранилище))));
		Возврат Неопределено;
	КонецЕсли;

	Снимок = Хранилище.Получить();

	// Толерантная проверка формата: {v: 1, history: [...]}.
	// Если Снимок - Соответствие, используем .Получить(); если Структура - .Свойство().
	Версия = 0;
	ИсторияИзСессии = Неопределено;

	Если ТипЗнч(Снимок) = Тип("Структура") Тогда
		Снимок.Свойство("v", Версия);
		Снимок.Свойство("history", ИсторияИзСессии);
	ИначеЕсли ТипЗнч(Снимок) = Тип("Соответствие") Тогда
		Версия = Снимок.Получить("v");
		Если ТипЗнч(Версия) <> Тип("Число") Тогда
			Версия = 0;
		КонецЕсли;
		ИсторияИзСессии = Снимок.Получить("history");
	Иначе
		// Неизвестный формат - graceful degrade, не ошибка.
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ИзвлечьИсториюИзМенеджераЗаписи", "sess_unknown_snapshot_type",
			СтрШаблон("ТипСнимка=%1", ТипЗнч(Снимок)));
		Возврат Неопределено;
	КонецЕсли;

	Если Версия <> 1
		Или ТипЗнч(ИсторияИзСессии) <> Тип("Массив") Тогда
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ИзвлечьИсториюИзМенеджераЗаписи", "sess_version_mismatch",
			СтрШаблон("Версия=%1, ТипИстории=%2",
				Версия, ?(ИсторияИзСессии = Неопределено, "Неопределено", ТипЗнч(ИсторияИзСессии))));
		Возврат Неопределено;
	КонецЕсли;

	Возврат ИсторияИзСессии;

КонецФункции

// Сохранить историю сессии после штатного завершения запуска (SESS-02).
//
// Выполняет: извлечение Якорь → компакция истории → сериализация →
// привилегированная запись в ar_Сессии. Best-effort: любая ошибка
// логируется через ЗаписьЖурналаРегистрации и не пробрасывается.
//
// Параметры:
//  Состояние          - Структура - состояние цикла (содержит Сообщения).
//  ДанныеАгента       - Структура - данные агента (LLMПровайдер, Модель, Ссылка).
//  КонтекстТриггера   - Структура - контекст триггера запуска.
//  RunId              - Строка(36) - идентификатор завершившегося запуска.
//
Процедура СохранитьСессию(Состояние, ДанныеАгента, КонтекстТриггера, RunId)

	// --- Шаг 1: проверка флага ИспользоватьСессии (SESS-04) ---
	// Сессии - opt-in (ar_ИспользоватьСессии). UI-30: для чат-якорей (chat:*)
	// сессия ведётся всегда - ранний выход отложен до извлечения Якоря (Шаг 2).
	ИспользоватьСессии = Ложь;
	Если ТипЗнч(ДанныеАгента) = Тип("Структура") Тогда
		ДанныеАгента.Свойство("ИспользоватьСессии", ИспользоватьСессии);
	КонецЕсли;

	// --- Шаг 2: извлечение и нормализация Якоря из КонтекстТриггера (SESS-05) ---
	СыройЯкорь = Неопределено;
	ПользовательUUID = "";
	Если ТипЗнч(КонтекстТриггера) = Тип("Структура") Тогда
		КонтекстТриггера.Свойство("ЯкорьСсылка", СыройЯкорь);
		КонтекстТриггера.Свойство("ПользовательUUID", ПользовательUUID);
	КонецЕсли;

	Якорь = НормализоватьЯкорьДляСессии(СыройЯкорь);

	// SESS-Debug (диагностика в разработке, оставлено намеренно): якорь
	// сессии на записи - сверять с "sess_read"/"sess_read_result" и "form_created".
	ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.СохранитьСессию", "sess_write",
		СтрШаблон("СыройЯкорь=%1, Якорь='%2'",
			?(СыройЯкорь = Неопределено, "Неопределено", Строка(СыройЯкорь)), Якорь),
		, RunId);

	Если ПустаяСтрока(Якорь) Тогда
		Возврат;
	КонецЕсли;
	// UI-30: для чат-якорей сессия сохраняется независимо от флага агента -
	// симметрично чтению в ПодмешатьИсториюСессии.
	Если ИспользоватьСессии <> Истина И Не СтрНачинаетсяС(Якорь, "chat:") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ПользовательUUID) <> Тип("Строка") Тогда
		ПользовательUUID = "";
	КонецЕсли;

	// --- Шаг 3: компакция истории ---
	MaxContext = ar_RuntimeКонтекст.MaxContextПровайдера(ДанныеАгента);

	Сообщения = Состояние.Сообщения;
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	Если MaxContext > 0 И Сообщения.Количество() > 0 Тогда
		РезультатКомпакции = ar_LLMКомпакция.Применить(Сообщения, MaxContext, ДанныеАгента.Модель);
		ИсторияДляСохранения = РезультатКомпакции.Сообщения;
	Иначе
		ИсторияДляСохранения = Сообщения;
	КонецЕсли;

	// --- Шаг 3: сериализация {v:1, history:[...]} ---
	Снимок = Новый Соответствие;
	Снимок.Вставить("v", 1);
	Снимок.Вставить("history", ИсторияДляСохранения);

	// --- Шаг 4: привилегированная запись (best-effort) ---
	Попытка
		ar_AuditЗащищённыйРежим.СохранитьСессиюПривилегированно(
			ДанныеАгента.Ссылка, Якорь, RunId, Снимок, ПользовательUUID);
	Исключение
		// SESS-02: ошибка сохранения сессии не должна менять статус уже
		// завершённого запуска. Логируем и продолжаем без проброса.
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(
			ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru='AgentRunner.SESS-02: ошибка сохранения сессии'"),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбёрткиАудита

// Тонкие обёртки над аудит-модулями. Изолируют точки вызова и гарантируют,
// что сбой аудита не валит цикл (контракт ar_AuditСобытия - не пробрасывает).

// Зафиксировать событие. ИмяСобытия - имя значения перечисления ar_ТипСобытия
// (Started, Completed, Failed, ContextBuilt, LLMCalled, ToolCalled,
// PermissionCheck, ApprovalRequested, Denied, Paused, MaxStepsReached).
// Машиночитаемая метка цикла (run_started, denied_globally и т.п.) кладётся в
// payload.code. Несуществующее имя значения молча пропускается модулем аудита.
//
Процедура ЗафиксироватьСобытие(RunId, ИмяСобытия, Payload)
	ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, ИмяСобытия, Payload);
КонецПроцедуры

// CONS-11: реально продолжить ReAct-цикл тем же RunId после вердикта надзора
// "Продолжить", прошедшего все три слоя детекции без остановки (см.
// ar_Надзор.РешитьПродолжатьЛи).
//
// МЕХАНИЗМ ПРОДОЛЖЕНИЯ (выбор аналитика/разработчика, см. .docs/specs/CONS-11.md,
// «Поведение», «Альтернатива, которую стоит явно оценить»): прямой рекурсивный
// вызов ВыполнитьАгентаВнутр внутри текущего серверного вызова - НЕ постановка
// нового фонового задания через ar_RuntimeЗапуск.ЗапуститьВФоне. Обоснование:
//  (а) не безграничная рекурсия - потолок 10 (слой 3) проверен ДО того, как эта
//      процедура вызывается (см. ar_Надзор.РешитьПродолжатьЛи), глубина стека
//      физически ограничена 10 вложенными вызовами ВыполнитьАгентаВнутр;
//  (б) сбой не роняет завершение И НЕ ПРЕРЫВАЕТ ПРОДОЛЖЕНИЕ (D10, ревью 1 -
//      направление default ИСПРАВЛЕНО по итогам ревью): см. Попытка/Исключение
//      ниже - любая ошибка подготовки продолжения (сборка НовыйКонтекстТриггера,
//      добавление управляющего сообщения) НЕ откатывает к штатному
//      ЗавершитьЗапуск, а продолжает минимальным контекстом - потолок 10
//      (слой 3) уже проверен и инкрементирован ДО вызова этой процедуры
//      (ar_Надзор.РешитьПродолжатьЛи вернула Продолжать=Истина), поэтому
//      ложный терминальный стоп здесь был бы дороже (см. doc-комментарий
//      ar_Надзор, шапка модуля, «Какая ошибка дороже»);
//  (в) видно, где кончается проход и начинается следующий - явная процедура,
//      вызываемая ТОЛЬКО из ветки run_completed (после РешитьПродолжатьЛи;
//      max_steps_reached продолжение не запускает никогда - см.
//      ar_Надзор.ЗафиксироватьЭскалациюБюджета выше по файлу), событие
//      ContinuationStarted маркирует границу в ar_СобытияЗапуска для
//      консоли/диагностики;
//  не конфликтует с CONS-09 (ar_АвтовозобновлениеЗапусков): не создаёт новый
//  RunId, не проходит через ar_RuntimeЗапуск.ЗапуститьВФоне/Возобновить -
//  ar_Scheduler.ОбработатьАвтовозобновление работает только со статусом Failed
//  и снимками approval-паузы, эта функция их не трогает и не пересекается по
//  RunId (тот же запуск не может одновременно быть Failed и Completed).
//  Цена решения: рекурсивный вызов удерживает серверный контекст открытым на
//  все 10 потенциальных проходов - при типично коротких (2-3) продолжениях
//  это не создаёт проблем с таймаутом клиента (фоновое задание, не
//  синхронный вызов формы - см. doc-комментарий модуля, ВыполнитьАгента
//  вызывается ИСКЛЮЧИТЕЛЬНО из фонового задания).
//
// Параметры:
//  СсылкаАгент      - СправочникСсылка.ar_Агенты, Неопределено - агент запуска
//                      (Неопределено для БезАгента-режима).
//  RunId            - Строка(36) - идентификатор запуска (не меняется).
//  Состояние        - Структура - состояние цикла на момент run_completed/
//                      max_steps_reached (Сообщения/счётчики переносятся как
//                      есть - НЕ обнуляются, кроме границы прохода).
//  ПоследнийТекст   - Строка - финальный текст ответа агента на завершившемся
//                      проходе (для управляющего user-сообщения).
//  Причина          - Строка - "run_completed"/"max_steps_reached" (для
//                      события ContinuationStarted и диагностики).
//
// Примечание: ДанныеАгента текущего прохода параметром НЕ принимается -
// ДанныеАгента пересобирается заново на каждом вызове ВыполнитьАгентаВнутр
// (см. Шаг 0 - БезАгента/ОверрайдПровайдер читаются из КонтекстТриггера) -
// нужные для этого поля переносятся из Состояния явно ниже.
//
Процедура ПродолжитьЦиклПослеНадзора(Знач СсылкаАгент, Знач RunId, Знач Состояние,
		Знач ПоследнийТекст, Знач Причина)

	НовыйКонтекстТриггера = Неопределено;

	Попытка

		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("code", "continuation_started");
		ПолезнаяНагрузка.Вставить("reason", Причина);
		ЗафиксироватьСобытие(RunId, "ContinuationStarted", ПолезнаяНагрузка);

		// Управляющее user-сообщение (см. .docs/specs/CONS-11.md, «Поведение»):
		// агент видит, что уже делал (история не обнуляется), и получает явный
		// сигнал продолжать работу над той же целью.
		ТекстПродолжения = НСтр("ru = 'Цель ещё не достигнута. Продолжай работу над
			|исходной задачей, учитывая уже выполненные действия и их результаты
			|выше. Не повторяй уже выполненные вызовы с теми же аргументами без
			|причины - если предыдущий вызов не продвинул задачу, попробуй другой
			|подход или параметры.';
			|en = 'The goal has not been achieved yet. Continue working on the
			|original task, taking into account the actions already performed and
			|their results above. Do not repeat already performed calls with the
			|same arguments without reason - if the previous call did not advance
			|the task, try a different approach or parameters.'");
		Состояние.Сообщения.Добавить(ar_LLMКонтракт.НовоеСообщение(ar_LLMКонтракт.РольUser(), ТекстПродолжения));

		// Граница текущего прохода = накопленное число действий на момент
		// продолжения (Sequence НЕ обнуляется - см. doc-комментарий выше и
		// КонтекстЗапуска.Sequence, во избежание коллизии ключа ar_ДействияАгента).
		Состояние.ДействийВсегоНаНачалоПрохода = Состояние.ДействийВсего;

		НовыйКонтекстТриггера = Новый Структура;
		НовыйКонтекстТриггера.Вставить("Триггер", "supervisor_continue");
		// ^ присваивание НовыйКонтекстТриггера переменной, объявленной ДО этой
		// Попытка (см. выше) - нужно, чтобы catch-блок мог отличить "сборка
		// контекста не дошла даже до старта" (Неопределено) от "упала на
		// середине" (частично заполненная структура, всё равно годная для
		// рекурсивного вызова, см. catch ниже, D10).
		НовыйКонтекстТриггера.Вставить("Продолжение", Состояние);

		// ДанныеАгента пересобирается заново на КАЖДОМ вызове ВыполнитьАгентаВнутр
		// (не переносится из Состояния, см. Шаг 0 - БезАгента читается из
		// КонтекстТриггера.БезАгента ДО проверки ЭтоПродолжениеНадзора) - БезАгента/
		// ОверрайдTools/ОверрайдПровайдер нужно явно перенести из уже
		// накопленного Состояния (ЭтоПродолжениеНадзора пропускает их
		// пересоздание внутри Состояния, но не читает их для ДанныеАгента).
		БезАгентаИзСостояния = Ложь;
		Если ТипЗнч(Состояние) = Тип("Структура") Тогда
			Состояние.Свойство("БезАгента", БезАгентаИзСостояния);
		КонецЕсли;
		НовыйКонтекстТриггера.Вставить("БезАгента", (БезАгентаИзСостояния = Истина));

		ОверрайдToolsИзСостояния = Неопределено;
		Если ТипЗнч(Состояние) = Тип("Структура") Тогда
			Состояние.Свойство("ОверрайдTools", ОверрайдToolsИзСостояния);
		КонецЕсли;
		Если ТипЗнч(ОверрайдToolsИзСостояния) = Тип("Массив") Тогда
			НовыйКонтекстТриггера.Вставить("ОверрайдTools", ОверрайдToolsИзСостояния);
		КонецЕсли;

		ОверрайдПровайдерСсылкаНавигационная = "";
		Если ТипЗнч(Состояние) = Тип("Структура") Тогда
			Состояние.Свойство("ОверрайдПровайдер", ОверрайдПровайдерСсылкаНавигационная);
		КонецЕсли;
		Если ТипЗнч(ОверрайдПровайдерСсылкаНавигационная) = Тип("Строка")
			И Не ПустаяСтрока(ОверрайдПровайдерСсылкаНавигационная) Тогда
			ОверрайдПровайдерОбъект = ar_Утилиты.ОбъектИзНавигационнойСсылки(ОверрайдПровайдерСсылкаНавигационная);
			Если ЗначениеЗаполнено(ОверрайдПровайдерОбъект) Тогда
				НовыйКонтекстТриггера.Вставить("ОверрайдПровайдер", ОверрайдПровайдерОбъект);
			КонецЕсли;
		КонецЕсли;

	Исключение
		// D10 - направление default ТО ЖЕ, что в ar_Надзор.РешитьПродолжатьЛи
		// при сбое слоёв 1/2 (см. её doc-комментарий и шапку модуля ar_Надзор):
		// сбой ПОДГОТОВКИ продолжения (сборка КонтекстТриггера, добавление
		// управляющего сообщения) НЕ должен обрывать физическое продолжение -
		// потолок 10 (слой 3) УЖЕ проверен и инкрементирован ДО вызова этой
		// процедуры (ar_Надзор.РешитьПродолжатьЛи вернула Продолжать=Истина),
		// поэтому у этого прохода уже есть место в потолке, и досрочно
		// завершать запуск штатным статусом означало бы тот же ложный терминальный
		// стоп, которого D10 требует избегать. Вместо отката к ЗавершитьЗапуск -
		// повторная попытка продолжить МИНИМАЛЬНЫМ контекстом: если
		// НовыйКонтекстТриггера успел собраться частично (не Неопределено) -
		// используем его как есть (Sequence/Сообщения уже могли обновиться),
		// иначе строим новый пустой контекст с тем же Триггером и Состоянием
		// без управляющего user-сообщения (агент продолжит без явной подсказки
		// "цель не достигнута", но цикл не обрывается).
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Исключение
			ТекстОшибки = "не удалось получить текст ошибки";
		КонецПопытки;
		ar_СлужебныйЛог.Записать("ar_RuntimeЦикл.ПродолжитьЦиклПослеНадзора", "continuation_prepare_failed",
			"Сбой подготовки продолжения (текст/контекст) - продолжение ВСЁ РАВНО "
				+ "ВЫПОЛНЯЕТСЯ минимальным контекстом (D10, потолок слоя 3 "
				+ "уже учтён для этого прохода). " + ТекстОшибки,
			"Ошибка", RunId);

		Если ТипЗнч(НовыйКонтекстТриггера) <> Тип("Структура") Тогда
			НовыйКонтекстТриггера = Новый Структура;
			НовыйКонтекстТриггера.Вставить("Триггер", "supervisor_continue");
			НовыйКонтекстТриггера.Вставить("Продолжение", Состояние);
		КонецЕсли;
	КонецПопытки;

	// Рекурсивный вызов ВНЕ Попытка выше - сбои ВНУТРИ самого продолженного
	// прохода уже перехватываются верхним уровнем ВыполнитьАгента (тем же
	// try/catch, что оборачивает первый проход) и приводят к штатному Failed -
	// оборачивать здесь ещё раз означало бы двойную обработку одного и того же
	// исключения с риском несогласованных данных.
	ВыполнитьАгентаВнутр(СсылкаАгент, RunId, НовыйКонтекстТриггера);

КонецПроцедуры

// CONS-09: если ошибка LLM-вызова, приведшая запуск в Failed, классифицирована
// как транзиентная (ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка) и лимит попыток
// техповтора (3) ещё не исчерпан - планирует следующую попытку в
// ar_ПовторитьПосле и фиксирует событие RetryScheduled. Иначе (ошибка
// постоянна, либо попытки исчерпаны) - не делает ничего, возвращает
// Неопределено, запись останется обычным Failed без признака ожидания.
//
// Пауза по номеру ПРЕДСТОЯЩЕЙ попытки: 1-я → 1 минута, 2-я → 5 минут,
// 3-я → 15 минут. Номер попытки берётся из текущего значения
// ar_ПопытокВозобновления (инкрементирует его ar_Scheduler при успешном
// старте retry, не эта функция - см. ar_Scheduler.ОбработатьАвтовозобновление,
// блок 2).
//
// Best-effort: ошибка чтения счётчика/записи события не должна ронять уже
// решённый исход шага (запуск и так уходит в Failed) - логируется и
// проглатывается.
//
// Параметры:
//  RunId    - Строка   - идентификатор запуска.
//  ОтветLLM - Структура - результат последнего вызова провайдера (тот же
//             контракт, что принимает ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка:
//             КодСостояния, НеРеализован).
//
// Возвращаемое значение:
//  Структура {ПовторитьПосле: Дата} - если retry запланирован;
//  Неопределено - если retry не требуется/не назначен.
//
Функция ЗапланироватьТехповторЕслиНужно(RunId, ОтветLLM)

	Попытка

		Если Не ar_LLMДиспетчер.ЭтоТранзиентнаяОшибка(ОтветLLM) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ПопытокУже = ar_AuditЗапуски.ПрочитатьПопытокВозобновления(RunId);
		Если ПопытокУже >= 3 Тогда
			// Лимит исчерпан - повторы больше не назначаются, эта комбинация
			// (Failed + ar_ПовторитьПосле пусто + ar_ПопытокВозобновления = 3)
			// однозначно читается как «повторы исчерпаны».
			// CONS-12: единая точка уведомлений - ответственный уведомляется
			// письмом, что автоматические повторы исчерпаны. ar_Уведомления
			// сама перехватывает любые свои ошибки (D9) - сбой отправки не
			// должен ронять best-effort путь техповтора.
			ar_Уведомления.Уведомить(RunId, "retry_exhausted");
			Возврат Неопределено;
		КонецЕсли;

		НомерПредстоящейПопытки = ПопытокУже + 1;
		ПаузыМинут = Новый Массив;
		ПаузыМинут.Добавить(1);
		ПаузыМинут.Добавить(5);
		ПаузыМинут.Добавить(15);
		ПаузаМинут = ПаузыМинут[НомерПредстоящейПопытки - 1];

		ПовторитьПосле = ТекущаяДатаСеанса() + ПаузаМинут * 60;

		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("attempt", НомерПредстоящейПопытки);
		ПолезнаяНагрузка.Вставить("retry_at", ПовторитьПосле);
		ЗафиксироватьСобытие(RunId, "RetryScheduled", ПолезнаяНагрузка);

		Результат = Новый Структура;
		Результат.Вставить("ПовторитьПосле", ПовторитьПосле);
		Возврат Результат;

	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru='AgentRunner.CONS-09: ошибка планирования техповтора'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Обновить heartbeat запуска. Точечный привилегированный режим (AUD-06):
// ar_AuditЗапуски - Privileged=false в манифесте (платформа запрещает
// Privileged=true в общих модулях расширений), точка вызова уникальна для
// этого модуля - фасад ar_AuditЗащищённыйРежим не расширяется ради одной точки.
//
Процедура Heartbeat(RunId)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ar_AuditЗапуски.Heartbeat(RunId);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Изменить статус/метрики запуска.
//
// PLAN-04: дополнить структуру Данные...-структур перед вызовом
// ЗавершитьЗапуск тремя ключами прогресса плана (ТекущийЭтап/ЭтаповВсего/
// ЭтаповЗакрыто) - см. ar_AuditЗапуски.ЗаписатьЗапуск, ПрисвоитьЕслиЕсть (S2,
// три строки, тот же образец, что уже используется для ПоследнееРешениеНадзора/
// ОтпечатокШага). Единая точка для всех десяти точек вызова ЗавершитьЗапуск
// (уточнение U2) - вызывается одной строкой из каждой, риск «забыть одну из
// десяти» снят централизацией.
//
// Граничный случай (D10): если план не использовался в этом запуске
// (Состояние.План.Пункты пуст - агент без планирования либо update_plan ещё
// не вызывался) - ключи НЕ добавляются в структуру вовсе. ПрисвоитьЕслиЕсть
// пропускает ключ только при значении Неопределено (число 0 и строка "" -
// не Неопределено), поэтому запись «0/0/пусто» на каждое завершение
// перезаписала бы прежний прогресс на агентах без планирования - это прямо
// противоречит намерению PLAN-01 (пустой прогресс показывается пусто, а не
// "0/0", см. PLAN-06 DoD).
//
// Состояние может быть Неопределено или не содержать ключ План в трёх ранних
// точках (:118 - исключение до НовоеСостояние, :205/:218 - до Состояние =
// НовоеСостояние) - тогда функция no-op, ничего не добавляет.
//
// Параметры:
//  ДанныеСтруктура - Структура - Данные...-структура (изменяется на месте).
//  Состояние        - Структура, Неопределено - состояние цикла, ключ План.
//
Процедура ДополнитьДаннымиПлана(ДанныеСтруктура, Состояние)

	Если ТипЗнч(Состояние) <> Тип("Структура") Или Не Состояние.Свойство("План") Тогда
		Возврат;
	КонецЕсли;

	План = Состояние.План;
	Если ТипЗнч(План) <> Тип("Структура") Или Не План.Свойство("Пункты")
		Или ТипЗнч(План.Пункты) <> Тип("Массив") Или План.Пункты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Прогресс = ar_ПланЗапуска.Прогресс(План);
	ТекущийПункт = ar_ПланЗапуска.ТекущийПункт(План);

	ДанныеСтруктура.Вставить("ЭтаповВсего",   Прогресс.Всего);
	ДанныеСтруктура.Вставить("ЭтаповЗакрыто", Прогресс.Закрыто);
	ДанныеСтруктура.Вставить("ТекущийЭтап",
		?(ТекущийПункт = Неопределено, "", ТекущийПункт.Заголовок));

КонецПроцедуры

Процедура ЗавершитьЗапуск(RunId, ДанныеЗавершения)
	ar_AuditЗащищённыйРежим.ЗаписатьСтатусЗапускаПривилегированно(RunId, "Завершить", ДанныеЗавершения);
КонецПроцедуры

#КонецОбласти

#Область ИнтеграцияБлокеров

// Точки интеграции с зависимыми модулями. Каждая обёртка делегирует в реальный
// модуль ядра (контекст RT-04, парсер RT-05, разрешения PERM-01, approval
// APPR-01, диспетчер DISP-01) - изолирует точки вызова одной строкой.

// Построить окно контекста для LLM (RT-04).
//
Функция ПостроитьКонтекст(Состояние, ДанныеАгента)
	Возврат ar_RuntimeКонтекст.ПостроитьКонтекст(Состояние, ДанныеАгента);
КонецФункции

// Разобрать ответ LLM в массив действий и текст ответа.
//
Функция РазобратьОтвет(ОтветLLM)
	Возврат ar_RuntimeПарсер.РазобратьОтвет(ОтветLLM);
КонецФункции

// Проверить разрешение на действие. Делегируется движку разрешений (PERM-01).
//
Функция РазрешитьДействие(ДанныеАгента, Действие, КонтекстЗапуска)
	Возврат ar_PermissionEngine.РазрешитьДействие(ДанныеАгента, Действие, КонтекстЗапуска);
КонецФункции

// Предпроверка аргументов действия ПЕРЕД постановкой в очередь approval.
//
// Вызывает тот же tool в режиме _dry_run: mutating-логика в этом режиме не
// выполняется (контракт DISP-03), а разбор и валидация аргументов проходят
// полностью. Так ошибки вида organization_required обнаруживаются до того, как
// пользователь потратит подтверждение на невыполнимое действие.
//
// Возвращает "" - аргументы валидны, постановка в очередь разрешена;
// непустую строку - текст ошибки для observation (LLM сможет исправиться).
//
// Ошибки самой предпроверки (исключение, неразобранный ответ) НЕ блокируют
// постановку: назначение функции - отсеять заведомо провальные вызовы, а не
// стать новой точкой отказа.
//
// Параметры:
//  Действие        - Структура - {Имя, ИдВызова, Аргументы}.
//  КонтекстЗапуска - Структура - контекст текущего запуска.
//
// Возвращаемое значение:
//  Строка - "" либо текст ошибки.
//
Функция ПредпроверкаДействия(Знач Действие, Знач КонтекстЗапуска)

	ИмяTool = ИмяДействия(Действие);
	Если ПустаяСтрока(ИмяTool) Тогда
		Возврат "";
	КонецЕсли;

	АргументыJSON = АргументыДействияСтрокой(Действие);
	Если ПустаяСтрока(АргументыJSON) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Объект = ar_JSON.ИзJSON(АргументыJSON);
		Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
			Возврат "";
		КонецЕсли;

		// ar_ToolDispatcher.Вызвать читает DryRun из КонтекстЗапуска.DryRun (не из
		// аргументов) и своим значением безусловно перезаписывает _dry_run в
		// аргументах (ОбогатитьАргументы). Флаг в АргументыПроверки без этого
		// был бы затёрт обратно в Ложь - предпроверка исполняла бы tool по-боевому
		// и сама ставила approval в очередь, а следом основной код ставил второй -
		// два approval на одно действие модели. КонтекстЗапуска - Знач, копия
		// безопасна и не просачивается в реальную постановку после предпроверки.
		КонтекстПроверки = Новый Структура;
		Для Каждого КлючЗначение Из КонтекстЗапуска Цикл
			КонтекстПроверки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		КонтекстПроверки.Вставить("DryRun", Истина);

		АргументыПроверки = Новый Соответствие;
		Для Каждого КлючЗначение Из Объект Цикл
			АргументыПроверки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		АргументыПроверки.Вставить("_dry_run", Истина);

		РезультатВызова = ar_ToolDispatcher.Вызвать(
			ИмяTool, ar_JSON.ВЗначениеJSON(АргументыПроверки), КонтекстПроверки);
	Исключение
		// Предпроверка не должна ронять запуск - пропускаем в очередь.
		Возврат "";
	КонецПопытки;

	// Поле результата диспетчера называется «Результат» (см. ar_ToolDispatcher.Результат).
	Наблюдение = "";
	Если ТипЗнч(РезультатВызова) = Тип("Структура") Тогда
		РезультатВызова.Свойство("Результат", Наблюдение);
	КонецЕсли;
	Если ТипЗнч(Наблюдение) <> Тип("Строка") Или ПустаяСтрока(Наблюдение) Тогда
		Возврат "";
	КонецЕсли;

	Разобрано = ar_JSON.ИзJSON(Наблюдение);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	// Ошибка есть - возвращаем observation целиком: в нём и код, и detail с
	// подсказкой, как исправить вызов.
	Если ПустаяСтрока("" + Разобрано.Получить("error")) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Наблюдение;

КонецФункции

// Аргументы действия в виде JSON-строки ("" - если извлечь не удалось).
Функция АргументыДействияСтрокой(Знач Действие)

	Если ТипЗнч(Действие) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Аргументы = Неопределено;
	Если Не Действие.Свойство("Аргументы", Аргументы) Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Аргументы) = Тип("Строка") Тогда
		Возврат Аргументы;
	КонецЕсли;

	Если Аргументы = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ar_JSON.ВЗначениеJSON(Аргументы);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Поставить действие в очередь approval (APPR-01).
//
// Дополняет КонтекстЗапуска снимком состояния цикла (Состояние) для сохранения
// StateSnapshot и делегирует в ar_Approval.Поставить. Возвращает ApprovalId
// (UUID) поставленной записи либо "" (запуск в финальном статусе).
//
Функция ПоставитьApproval(КонтекстЗапуска, Состояние, Действие)
	КонтекстСоСнимком = Новый Структура;
	Для Каждого КлючЗначение Из КонтекстЗапуска Цикл
		КонтекстСоСнимком.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	КонтекстСоСнимком.Вставить("Состояние", Состояние);
	Возврат ar_Approval.Поставить(КонтекстСоСнимком, Действие);
КонецФункции

// Выполнить tool через диспетчер (DISP-01).
//
// Структура Действие от ar_RuntimeПарсер содержит только {Имя, ИдВызова, Аргументы}
// без ссылки на ar_Tools - диспетчер выполняет lookup по имени самостоятельно
// (ar_ToolDispatcher.НайтиToolПоИмени).
//
Функция ВызватьTool(Действие, КонтекстЗапуска)
	ИмяTool = ИмяДействия(Действие);
	АргументыJSON = СтрокаЗначения(Действие, "Аргументы");
	Возврат ar_ToolDispatcher.Вызвать(ИмяTool, АргументыJSON, КонтекстЗапуска);
КонецФункции

#КонецОбласти
