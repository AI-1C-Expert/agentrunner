//////////////////////////////////////////////////////////////////////////////
// Общий модуль aosМиграцииРутины (Routines Migrations).
//
// Программный обработчик миграции legacy-расписаний (ROUT-03): переносит данные
// из ar_Агенты.ar_РасписаниеCron в новые элементы справочника ar_Рутины
// (ar_ТипТриггера="cron"). Идемпотентна: повторный вызов не создаёт дубли.
//
// Scope ограничен переносом данных. Удаление legacy-ветки кода в ar_Scheduler
// (АгентыИзLegacyРасписания, anti-dup, параметры РутинаРеф/ИнструкцияДобавка
// в ЗапуститьАгента) - НЕ входит в DoD ROUT-03, выносится в отдельную задачу
// техдолга.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/ROUT-03.md, Plan §5 этап 2.
//////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Переносит ar_Агенты.ar_РасписаниеCron в новые элементы ar_Рутины
// (ТипТриггера="cron"). Идемпотентна: повторный вызов не создаёт дублирующих
// записей (проверка по паре Агент + expression).
//
// Параметры:
//  ОчищатьLegacy - Булево - если Истина (по умолчанию), очищает
//                    ar_Агенты.ar_РасписаниеCron после успешного переноса.
//                    Если Ложь - legacy-поле не трогается.
//
// Возвращаемое значение:
//  Структура:
//    Обработано    - Число - агентов с непустым ar_РасписаниеCron найдено.
//    Создано       - Число - новых ar_Рутины создано.
//    Пропущено     - Число - агентов пропущено (уже мигрированы ранее).
//    ОчищеноLegacy - Число - ar_РасписаниеCron очищено после переноса.
//    Ошибки        - Массив - тексты ошибок по отдельным агентам.
//
Функция МигрироватьРасписанияАгентов(Знач ОчищатьLegacy = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Создано", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("ОчищеноLegacy", 0);
	Результат.Вставить("Ошибки", Новый Массив);

	Агенты = АгентыСLegacyРасписанием();
	Результат.Обработано = Агенты.Количество();

	Для Каждого Агент Из Агенты Цикл
		ОбработатьОдногоАгента(Агент, ОчищатьLegacy, Результат);
	КонецЦикла;

	ЗаписатьИтогВЖурнал(Результат);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработать одного агента: проверка идемпотентности -> создание рутины ->
// очистка legacy. Создание рутины (шаг c) и очистка legacy-поля (шаг d) -
// независимые операции в отдельных Попытка/Исключение: ошибка очистки
// legacy-поля НЕ должна откатывать уже успешно созданную/существующую рутину
// (см. спеку UC-1 шаг d и граничный случай "ar_Агенты.Записать() падает").
//
Процедура ОбработатьОдногоАгента(Агент, ОчищатьLegacy, Результат)

	ВыражениеCron = Агент.РасписаниеCron;

	// Проверка идемпотентности: рутина с тем же expression уже существует?
	Если РутинаУжеМигрирована(Агент.Ссылка, ВыражениеCron) Тогда
		Результат.Пропущено = Результат.Пропущено + 1;
	Иначе
		// Шаг (c): создание рутины - своя независимая операция.
		Попытка
			СоздатьРутинуИзLegacy(Агент, ВыражениеCron);
			Результат.Создано = Результат.Создано + 1;
		Исключение
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Ошибка миграции для агента ""%1"": %2';
					|en = 'Migration error for agent ""%1"": %2'"),
				Агент.Имя, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.Ошибки.Добавить(ТекстОшибки);
			// Рутина не создана - очистка legacy для этого агента не выполняется.
			Возврат;
		КонецПопытки;
	КонецЕсли;

	// Шаг (d): очистка legacy-поля - независимая операция со своим
	// Попытка/Исключение. Ошибка здесь не откатывает уже созданную/
	// существующую рутину (Результат.Создано / Пропущено остаются в силе).
	Если ОчищатьLegacy Тогда
		ОчиститьLegacyПоле(Агент, Результат);
	КонецЕсли;

КонецПроцедуры

// Запрос агентов с непустым ar_РасписаниеCron.
//
Функция АгентыСLegacyРасписанием()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Агенты.Ссылка КАК Ссылка,
		|	Агенты.Наименование КАК Имя,
		|	Агенты.ar_РасписаниеCron КАК РасписаниеCron
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	НЕ Агенты.ПометкаУдаления
		|	И Агенты.ar_РасписаниеCron <> """"";

	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Ссылка", Выборка.Ссылка);
		Строка.Вставить("Имя", Строка(Выборка.Имя));
		Строка.Вставить("РасписаниеCron", Выборка.РасписаниеCron);
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверить, существует ли уже рутина с тем же cron-выражением для агента.
// Идемпотентность: пара Агент + expression уникально идентифицирует миграцию.
//
Функция РутинаУжеМигрирована(Знач СсылкаАгент, Знач ВыражениеCron)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", СсылкаАгент);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Рутины.ar_ПараметрыJSON КАК ПараметрыJSON
		|ИЗ
		|	Справочник.ar_Рутины КАК Рутины
		|ГДЕ
		|	Рутины.ar_Агент = &Агент
		|	И Рутины.ar_ТипТриггера = ""cron""
		|	И НЕ Рутины.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Параметры = ar_JSON.ИзJSON(Выборка.ПараметрыJSON);
		Если Параметры = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СуществующееВыражение = Неопределено;
		Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
			СуществующееВыражение = Параметры.Получить("expression");
		ИначеЕсли ТипЗнч(Параметры) = Тип("Структура") Тогда
			Параметры.Свойство("expression", СуществующееВыражение);
		КонецЕсли;

		Если СуществующееВыражение <> Неопределено
			И Строка(СуществующееВыражение) = ВыражениеCron Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Создать новый элемент ar_Рутины из legacy-расписания агента.
//
Процедура СоздатьРутинуИзLegacy(Знач Агент, Знач ВыражениеCron)

	Объект = Справочники.ar_Рутины.СоздатьЭлемент();

	// ar_Имя: "Расписание агента <ИмяАгента>", обрезка до 150 символов.
	ИмяРутины = "Расписание агента " + Агент.Имя;
	Если СтрДлина(ИмяРутины) > 150 Тогда
		ИмяРутины = Лев(ИмяРутины, 150);
	КонецЕсли;

	Объект.ar_Имя = ИмяРутины;
	Объект.ar_Агент = Агент.Ссылка;
	Объект.ar_ТипТриггера = "cron";
	Объект.ar_ПараметрыJSON = СформироватьПараметрыJSON(ВыражениеCron);
	Объект.ar_ИнструкцияПереопределение = "";
	Объект.ar_Активна = Истина;

	Объект.Записать();

КонецПроцедуры

// Сформировать JSON {"expression": "<cron>"} с экранированием спецсимволов.
//
Функция СформироватьПараметрыJSON(Знач ВыражениеCron)

	// Используем платформенный ЗаписьJSON для корректного экранирования.
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, Новый Структура("expression", ВыражениеCron));
	
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Очистить ar_Агенты.ar_РасписаниеCron после успешного переноса (шаг d).
// Самостоятельная операция: ошибка записи перехватывается локально и не
// влияет на результат шага (c) - созданная/существующая рутина не откатывается.
//
Процедура ОчиститьLegacyПоле(Агент, Результат)

	Попытка
		ОбъектАгента = Агент.Ссылка.ПолучитьОбъект();
		ОбъектАгента.ar_РасписаниеCron = "";
		ОбъектАгента.Записать();
		Результат.ОчищеноLegacy = Результат.ОчищеноLegacy + 1;
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка очистки legacy-расписания для агента ""%1"": %2';
				|en = 'Failed to clear legacy schedule for agent ""%1"": %2'"),
			Агент.Имя, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Ошибки.Добавить(ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Записать итог миграции в журнал регистрации.
//
Процедура ЗаписатьИтогВЖурнал(Результат)

	ТекстИтога = СтрШаблон(
		НСтр("ru = 'Миграция рутин завершена: обработано=%1, создано=%2, пропущено=%3, очищено legacy=%4, ошибок=%5';
			|en = 'Routines migration completed: processed=%1, created=%2, skipped=%3, legacy cleared=%4, errors=%5'"),
		Результат.Обработано, Результат.Создано, Результат.Пропущено,
		Результат.ОчищеноLegacy, Результат.Ошибки.Количество());

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'aosМиграцииРутины'; en = 'ar_MigrationsSkillsRoutines'"),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		ТекстИтога);

	// Ошибки - отдельными записями с уровнем Ошибка.
	Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'aosМиграцииРутины'; en = 'ar_MigrationsSkillsRoutines'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
