////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolАварийный (Tool Emergency Write).
//
// Аварийный mutating-tool Слоя 0: save_object - создание или изменение
// произвольного объекта ИБ целевой конфигурации без специализированного
// business-tool. ТОЛЬКО для крайних случаев; предпочтение всегда у Слоя 1.
//
// RiskLevel = Commit, ТребуетApproval = Истина - любая запись требует явного
// одобрения оператором через ar_ОчередьApproval (APPR-01).
//
// Линии защиты:
//   1. Блокировка объектов расширения (ЭтоОбъектРасширения): отказ до approval.
//      Ошибка "unknown_object_type" скрывает факт существования ar_*-объектов
//      (security-by-obscurity, решение зафиксировано в спеке TOOL-18, итерация 2).
//   2. Defence-in-depth: ar_PermissionEngine.ОбъектЗапрещён как второй рубеж
//      после L3.5 Guard PermissionEngine (PERM-05).
//
// Ограничения v1.0: только реквизиты заголовка (без табличных частей).
// Whitelist типов: Справочник, Документ, ПланВидовХарактеристик, БизнесПроцесс, Задача.
//
// Запрещено: Выполнить(), Вычислить(), УстановитьПривилегированныйРежим() в
//   tool-логике и в ЗарегистрироватьTools() (DoD D13).
//   Запись в ar_Tools при регистрации выполняется в привилегированном контексте
//   вызывающего (ar_ToolDispatcher.ЗарегистрироватьМодуль).
// Фактическая ЗАПИСЬ объекта - отдельный механизм после approval (паттерн create_invoice_draft).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
//
// См. спеку: .docs/specs/TOOL-18.md, Plan §2.8, §3.4, §3.5.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер второго уровня модуля ar_ToolАварийный. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolАварийный.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры.
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "СохранитьОбъект" Тогда
		Возврат СохранитьОбъект(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Tool save_object: аварийная запись произвольного объекта ИБ.
//
// Выполняет все защитные проверки и ставит payload в очередь approval.
// Фактическая запись объекта происходит ПОСЛЕ одобрения оператором (паттерн APPR-01).
//
// Параметры:
//  Аргументы - Строка    - JSON аргументов: object_type, ref (опц.), fields,
//                          _dry_run, _idempotency_key.
//  Контекст  - Структура - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//
// Возвращаемое значение:
//  Строка - JSON-observation: queued_for_approval / dry_run / {"error":"..."}.
//
Функция СохранитьОбъект(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат СохранитьОбъектВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Зарегистрировать tool save_object в справочнике ar_Tools (TOOL-18).
// Идемпотентно: создаёт при отсутствии, обновляет при наличии.
//
// Привилегированный режим: НЕ устанавливается внутри этого метода (DoD D13).
// Запись в ar_Tools выполняется в привилегированном контексте вызывающего
// (ar_ToolDispatcher.ЗарегистрироватьМодуль поднимает привилегии перед вызовом).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } - статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);
	ЗарегистрироватьОдинTool(ОписаниеToolСохранитьОбъект(), Статистика);
	Возврат Статистика;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная логика save_object (выделена для перехвата исключений в СохранитьОбъект).
//
// Параметры:
//  Аргументы - Строка    - JSON аргументов tool.
//  Контекст  - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция СохранитьОбъектВнутр(Знач Аргументы, Знач Контекст)

	// 1. Десериализация аргументов.
	АргументыJSON = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(АргументыJSON) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	// 2. Проверка обязательного параметра object_type.
	ТипОбъектаСтрока = СокрЛП(Строка(ЗначениеПоКлючу(АргументыJSON, "object_type", "")));
	Если ПустаяСтрока(ТипОбъектаСтрока) Тогда
		Возврат ОшибочныйJSON("object_type_required");
	КонецЕсли;

	// 3. Поиск типа в метаданных.
	МД = Метаданные.НайтиПоПолномуИмени(ТипОбъектаСтрока);
	Если МД = Неопределено Тогда
		Возврат ОшибочныйJSON("unknown_object_type");
	КонецЕсли;

	// 4. Проверка допустимости класса метаданных (whitelist).
	Если Не КлассМДДоступен(МД) Тогда
		Возврат ОшибочныйJSON("object_type_not_writable");
	КонецЕсли;

	// 5. Защита #1: блокировка объектов расширения (ЭтоОбъектРасширения).
	//    Выполняется ДО обращения к ОбъектЗапрещён (быстрый возврат, DoD D5).
	//    Возвращаем unknown_object_type вместо access_denied_to_extension_object:
	//    это security-by-obscurity - не раскрываем факт существования ar_*-объектов
	//    внешнему агенту (AI Error "Потенциальная утечка информации", TOOL-18 итерация 2).
	Если ЭтоОбъектРасширения(МД) Тогда
		Возврат ОшибочныйJSON("unknown_object_type");
	КонецЕсли;

	// 6. Defence-in-depth #2: deny-list через ar_PermissionEngine.ОбъектЗапрещён (DoD D6).
	РежимЗапрета = Перечисления.ar_РежимЗапретаЗаписи.Любое;
	ТекстЗапрета = "";
	Попытка
		Запрещено = ar_PermissionEngine.ОбъектЗапрещён(ТипОбъектаСтрока, РежимЗапрета);
	Исключение
		// Ошибка чтения реестра - fail-closed.
		Запрещено = Истина;
		ТекстЗапрета = НСтр("ru = 'ошибка чтения реестра запрещённых объектов';
			|en = 'error reading forbidden objects registry'");
	КонецПопытки;
	Если Запрещено Тогда
		СообщениеОбОшибке = "object_write_forbidden";
		Если Не ПустаяСтрока(ТекстЗапрета) Тогда
			СообщениеОбОшибке = СообщениеОбОшибке + ": " + ТекстЗапрета;
		КонецЕсли;
		Возврат ОшибочныйJSON(СообщениеОбОшибке);
	КонецЕсли;

	// 7. DryRun (DISP-03): после проверок безопасности, до постановки в очередь.
	//    deny-list срабатывает и при DryRun (тест-кейс T6, DoD D7/D8).
	ЭтоDryRun = ar_ToolDispatcher.ИзвлечьDryRun(Аргументы);
	Если ЭтоDryRun Тогда
		Возврат СформироватьOтветDryRun(АргументыJSON, ТипОбъектаСтрока);
	КонецЕсли;

	// 8. Валидация и обработка параметра ref.
	СтрокаRef = СокрЛП(Строка(ЗначениеПоКлючу(АргументыJSON, "ref", "")));
	ДействиеСтрока = "create";
	КонкретнаяСсылка = Неопределено;
	Если Не ПустаяСтрока(СтрокаRef) Тогда
		// Разыменование ссылки через ar_ToolUniversal.
		КонкретнаяСсылка = ar_ToolUniversal.РазыменоватьСсылку(СтрокаRef, ТипОбъектаСтрока);
		Если КонкретнаяСсылка = Неопределено Тогда
			Возврат ОшибочныйJSON("object_not_found");
		КонецЕсли;
		// Проверка совпадения типа ссылки.
		Если Не ОбъектПринадлежитТипу(КонкретнаяСсылка, МД) Тогда
			Возврат ОшибочныйJSON("ref_type_mismatch");
		КонецЕсли;
		ДействиеСтрока = "update";
	КонецЕсли;

	// 9. Валидация параметра fields.
	ПоляJSON = ЗначениеПоКлючу(АргументыJSON, "fields", Неопределено);
	Если ПоляJSON = Неопределено Или ТипЗнч(ПоляJSON) <> Тип("Соответствие")
		Или ПоляJSON.Количество() = 0 Тогда
		Возврат ОшибочныйJSON("fields_required");
	КонецЕсли;

	// 10. Проверка и подготовка полей.
	РезультатПолей = ПроверитьПоля(ПоляJSON, МД);
	Если РезультатПолей.Ошибка <> "" Тогда
		Возврат ОшибочныйJSONСДеталью(РезультатПолей.Код, РезультатПолей.Поле);
	КонецЕсли;

	// 11. Сборка ActionPayload для очереди.
	ДанныеДействия = Новый Структура;
	ДанныеДействия.Вставить("object_type", ТипОбъектаСтрока);
	ДанныеДействия.Вставить("action",      ДействиеСтрока);
	ДанныеДействия.Вставить("fields",      ПоляJSON);
	Если КонкретнаяСсылка <> Неопределено Тогда
		ДанныеДействия.Вставить("ref", СтрокаRef);
	КонецЕсли;
	Если РезультатПолей.НеизвестныеПоля.Количество() > 0 Тогда
		// Предупреждение о неизвестных реквизитах - не блокирует постановку (DoD D11).
		ДанныеДействия.Вставить("unknown_fields_warning", РезультатПолей.НеизвестныеПоля);
	КонецЕсли;

	ДанныеДействияJSON = ar_JSON.ВЗначениеJSON(ДанныеДействия);

	// 12. Постановка в очередь approval (APPR-01).
	КлючИдемпотентности = ar_ToolDispatcher.ИзвлечьIdempotencyKey(Аргументы);

	ОписаниеДействия = Новый Структура;
	ОписаниеДействия.Вставить("Имя",           "save_object");
	ОписаниеДействия.Вставить("ИдВызова",       ?(КонкретнаяСсылка = Неопределено, "", СтрокаRef));
	ОписаниеДействия.Вставить("Аргументы",      ar_JSON.ИзJSON(ДанныеДействияJSON));
	ОписаниеДействия.Вставить("IdempotencyKey", КлючИдемпотентности);
	ОписаниеДействия.Вставить("RiskLevel",      "Commit");
	ОписаниеДействия.Вставить("Обоснование",
		НСтр("ru = 'Аварийная запись объекта ИБ через save_object';
			|en = 'Emergency write of IB object via save_object'"));

	КодApproval = ar_Approval.Поставить(НормализоватьКонтекст(Контекст), ОписаниеДействия);

	// 13. Формирование ответа.
	Ответ = Новый Структура;
	Ответ.Вставить("status",      "queued_for_approval");
	Ответ.Вставить("approval_id", КодApproval);
	Ответ.Вставить("object_type", ТипОбъектаСтрока);
	Ответ.Вставить("action",      ДействиеСтрока);

	РезультатJSON = ar_JSON.ВЗначениеJSON(Ответ);
	Возврат ?(ПустаяСтрока(РезультатJSON), "{""status"":""queued_for_approval""}", РезультатJSON);

КонецФункции

// Сформировать DryRun-ответ для save_object.
//
// Параметры:
//  АргументыJSON    - Соответствие - разобранные JSON-аргументы.
//  ТипОбъектаСтрока - Строка       - полное имя типа метаданных.
//
// Возвращаемое значение:
//  Строка - JSON dry_run.
//
Функция СформироватьOтветDryRun(Знач АргументыJSON, Знач ТипОбъектаСтрока)

	СтрокаRef = СокрЛП(Строка(ЗначениеПоКлючу(АргументыJSON, "ref", "")));
	ДействиеСтрока = ?(ПустаяСтрока(СтрокаRef), "create", "update");

	ПоляJSON = ЗначениеПоКлючу(АргументыJSON, "fields", Неопределено);
	КоличествоПолей = 0;
	Если ТипЗнч(ПоляJSON) = Тип("Соответствие") Тогда
		КоличествоПолей = ПоляJSON.Количество();
	КонецЕсли;

	Симуляция = Новый Структура;
	Симуляция.Вставить("object_type",  ТипОбъектаСтрока);
	Симуляция.Вставить("action",       ДействиеСтрока);
	Симуляция.Вставить("fields_count", КоличествоПолей);

	Возврат ar_ToolDispatcher.СформироватьDryRunJSON("save_object", Симуляция);

КонецФункции

// Проверить принадлежность объекта метаданных к допустимому для save_object классу.
// Whitelist: Справочник, Документ, ПланВидовХарактеристик, БизнесПроцесс, Задача.
//
// Параметры:
//   МД - ОбъектМетаданных - найденный объект метаданных.
//
// Возвращаемое значение:
//   Булево - Истина если тип допустим для save_object.
//
Функция КлассМДДоступен(Знач МД)

	Если Метаданные.Справочники.Содержит(МД) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.Документы.Содержит(МД) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.ПланыВидовХарактеристик.Содержит(МД) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.БизнесПроцессы.Содержит(МД) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Метаданные.Задачи.Содержит(МД) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Проверить принадлежность объекта метаданных к расширению AgentRunner.
// Имя начинается с префикса "AOS_" (без учёта регистра).
// Та же логика, что в ar_ToolUniversal.ИсточникРасширения.
//
// Параметры:
//   МД - ОбъектМетаданных - объект метаданных для проверки.
//
// Возвращаемое значение:
//   Булево - Истина если объект принадлежит расширению AgentRunner.
//
Функция ЭтоОбъектРасширения(Знач МД)
	Перем ДлинаПрефиксаAOS;
	ДлинаПрефиксаAOS = 4; // Длина префикса "AOS_".
	Возврат Лев(ВРег(МД.Имя), ДлинаПрефиксаAOS) = "AOS_";
КонецФункции

// Проверить принадлежность ссылки к типу объекта метаданных МД.
//
// Параметры:
//   Ссылка - Произвольный    - разыменованная ссылка объекта.
//   МД     - ОбъектМетаданных - ожидаемый тип метаданных.
//
// Возвращаемое значение:
//   Булево - Истина если ссылка принадлежит ожидаемому типу.
//
Функция ОбъектПринадлежитТипу(Знач Ссылка, Знач МД)

	Попытка
		МДСсылки = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
		Возврат МДСсылки = МД;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Проверить поля fields: существование реквизита в МД и совместимость типов.
//
// Параметры:
//   ПоляJSON - Соответствие    - {"ИмяРеквизита": значение}.
//   МД       - ОбъектМетаданных - объект метаданных целевого типа.
//
// Возвращаемое значение:
//   Структура {
//     Ошибка          - Строка - "" если OK, иначе код ошибки;
//     Код             - Строка - код ошибки;
//     Поле            - Строка - имя проблемного реквизита;
//     НеизвестныеПоля - Массив - имена реквизитов не из МД (предупреждение).
//   }
//
Функция ПроверитьПоля(Знач ПоляJSON, Знач МД)

	Итог = Новый Структура;
	Итог.Вставить("Ошибка",          "");
	Итог.Вставить("Код",             "");
	Итог.Вставить("Поле",            "");
	Итог.Вставить("НеизвестныеПоля", Новый Массив);

	// Строим индекс реквизитов МД.
	ИндексРеквизитов = Новый Соответствие;
	Если МД.Реквизиты <> Неопределено Тогда
		Для Каждого РеквизитМД Из МД.Реквизиты Цикл
			ИндексРеквизитов.Вставить(ВРег(РеквизитМД.Имя), РеквизитМД);
		КонецЦикла;
	КонецЕсли;

	Для Каждого КлючЗначение Из ПоляJSON Цикл
		ИмяПоля  = КлючЗначение.Ключ;
		Значение = КлючЗначение.Значение;

		РеквизитМД = ИндексРеквизитов.Получить(ВРег(ИмяПоля));
		Если РеквизитМД = Неопределено Тогда
			// Неизвестный реквизит - предупреждение, не ошибка (DoD D11).
			Итог.НеизвестныеПоля.Добавить(ИмяПоля);
			Продолжить;
		КонецЕсли;

		// Проверка совместимости типа значения с типом реквизита.
		Если Не ТипПоляСовместим(Значение, РеквизитМД) Тогда
			Итог.Ошибка = "field_type_mismatch";
			Итог.Код    = "field_type_mismatch";
			Итог.Поле   = ИмяПоля;
			Возврат Итог;
		КонецЕсли;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Проверить совместимость JSON-значения с типом реквизита метаданных.
//
// Параметры:
//   Значение   - Произвольный               - JSON-значение.
//   РеквизитМД - ОбъектМетаданных.Реквизит - описание реквизита из МД.
//
// Возвращаемое значение:
//   Булево - Истина если тип значения совместим с типом реквизита.
//
Функция ТипПоляСовместим(Знач Значение, Знач РеквизитМД)

	// null/Неопределено совместимо с любым типом.
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	// Получить описание типа реквизита (платформа не бросает исключение для MD-объектов).
	ТипыРеквизита = РеквизитМД.Тип;
	Если ТипыРеквизита = Неопределено Тогда
		// Тип реквизита недоступен - пропускаем без блокировки.
		Возврат Истина;
	КонецЕсли;

	// Строка - совместима только если реквизит содержит строковый или ссылочный тип.
	// Разыменование строк-ссылок выполняется при реальной записи объекта.
	Если ТипЗначения = Тип("Строка") Тогда
		// Проверяем, что реквизит принимает строки или ссылочные типы (UUID / навигационная ссылка).
		Если ТипыРеквизита.СодержитТип(Тип("Строка")) Тогда
			Возврат Истина;
		КонецЕсли;
		// Ссылочные типы: проверяем наличие хотя бы одного ссылочного типа в составе.
		Для Каждого ТипЭлемента Из ТипыРеквизита.Типы() Цикл
			МДТипа = Метаданные.НайтиПоТипу(ТипЭлемента);
			Если МДТипа <> Неопределено Тогда
				Возврат Истина; // Ссылочный тип - строка может быть UUID/навигационной ссылкой.
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	// Число - совместимо только с числовыми типами реквизита.
	Если ТипЗначения = Тип("Число") Тогда
		Возврат ТипыРеквизита.СодержитТип(Тип("Число"));
	КонецЕсли;

	// Булево - совместимо только с булевыми типами.
	Если ТипЗначения = Тип("Булево") Тогда
		Возврат ТипыРеквизита.СодержитТип(Тип("Булево"));
	КонецЕсли;

	// Соответствие (вложенный JSON-объект) - не поддерживается в v1.0.
	// Массив - не поддерживается в v1.0.
	Возврат Ложь;

КонецФункции

// Сформировать описание tool save_object для реестра ar_Tools.
//
// Возвращаемое значение:
//  Структура - описание tool с полями Имя, Синоним, Описание, ОбщийМодуль, ...
//
Функция ОписаниеToolСохранитьОбъект()

	Описание = Новый Структура;
	Описание.Вставить("Имя",             "save_object");
	Описание.Вставить("Синоним",
		НСтр("ru = 'Сохранить объект'; en = 'Save object'"));
	Описание.Вставить("Описание",
		НСтр("ru = 'Аварийная запись или изменение объекта ИБ. Только для случаев,"
			+ " когда нет подходящего business-tool. Требует явного одобрения оператором.';
			|en = 'Emergency write or update of an IB object. Only for cases"
			+ " when no suitable business-tool exists. Requires explicit operator approval.'"));
	Описание.Вставить("ОбщийМодуль",     "ar_ToolАварийный");
	Описание.Вставить("ИмяПроцедуры",   "СохранитьОбъект");
	Описание.Вставить("RiskLevel",       "Commit");
	Описание.Вставить("ТребуетApproval", Истина);
	Описание.Вставить("Версия",          "1.0.0");
	Описание.Вставить("Включён",         Истина);
	Описание.Вставить("КраткоеОписание",
		НСтр("ru = 'Записать объект напрямую (аварийный запасной путь)';
			|en = 'Write an object directly (emergency fallback path)'"));
	Описание.Вставить("JSONManifest",    МанифестСохранитьОбъект(Описание.Описание));
	Возврат Описание;

КонецФункции

// JSON Schema аргументов save_object, обёрнутая в OpenAI tool-format
// (см. ar_ToolUniversal.МанифестTool - образец контракта). Ранее ar_JSONManifest
// не заполнялся вовсе - tool попадал в список без манифеста, что LLM-провайдер
// либо отклонял, либо получал искажённый список tools.
//
// Параметры:
//  ОписаниеTool - Строка - готовый текст описания (см. ОписаниеToolСохранитьОбъект).
//
Функция МанифестСохранитьОбъект(Знач ОписаниеTool)

	Свойства = Новый Структура;
	Свойства.Вставить("object_type", СвойствоСхемыАварийный("string",
		"Полное имя типа метаданных (например 'Справочник.Контрагенты')."));
	Свойства.Вставить("ref", СвойствоСхемыАварийный("string",
		"Навигационная ссылка или UUID существующего объекта. Пусто - создать новый."));
	Свойства.Вставить("fields", СвойствоСхемыАварийный("object",
		"Реквизиты для записи: {ИмяРеквизита: значение}. Обязателен, минимум одно поле."));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", СписокИзСтрокАварийный("object_type", "fields"));

	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", "save_object");
	ФункцияОписание.Вставить("description", ОписаниеTool);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);
	Возврат ar_JSON.ВЗначениеJSON(Манифест);

КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
Функция СвойствоСхемыАварийный(Знач Тип, Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Массив строк из переданных значений (для required в JSON Schema).
Функция СписокИзСтрокАварийный(Знач Значение1, Знач Значение2 = Неопределено)
	Список = Новый Массив;
	Список.Добавить(Значение1);
	Если Значение2 <> Неопределено Тогда
		Список.Добавить(Значение2);
	КонецЕсли;
	Возврат Список;
КонецФункции

// Идемпотентно создать/обновить запись ar_Tools по описанию.
// Вызывается из ЗарегистрироватьTools(), который в свою очередь вызывается из
// ar_ToolDispatcher.ЗарегистрироватьМодуль в привилегированном контексте.
//
// Параметры:
//   Описание   - Структура - описание tool (Имя, Синоним, ОбщийМодуль, Версия, ...).
//   Статистика - Структура - {Создано, Обновлено} - счётчик обновляется по ссылке.
//
Процедура ЗарегистрироватьОдинTool(Знач Описание, Статистика)

	СуществующаяСсылка = НайтиToolПоИмени(Описание.Имя);

	Если СуществующаяСсылка = Неопределено Тогда
		ОбъектTool = Справочники.ar_Tools.СоздатьЭлемент();
		Статистика.Создано = Статистика.Создано + 1;
	Иначе
		ОбъектTool = СуществующаяСсылка.ПолучитьОбъект();
		Статистика.Обновлено = Статистика.Обновлено + 1;
	КонецЕсли;

	ОбъектTool.Наименование          = Описание.Синоним;
	ОбъектTool.ar_Имя               = Описание.Имя;
	ОбъектTool.ar_ОбщийМодуль       = Описание.ОбщийМодуль;
	ОбъектTool.ar_ИмяПроцедуры      = Описание.ИмяПроцедуры;
	ОбъектTool.ar_RiskLevel          = Перечисления.ar_RiskLevel[Описание.RiskLevel];
	ОбъектTool.ar_Описание           = Описание.Описание;
	ОбъектTool.ar_КраткоеОписание    = Описание.КраткоеОписание;
	ОбъектTool.ar_ТребуетApproval    = Описание.ТребуетApproval;
	ОбъектTool.ar_Включён            = Описание.Включён;
	ОбъектTool.ar_Версия             = Описание.Версия;
	ОбъектTool.ar_JSONManifest       = Описание.JSONManifest;
	ОбъектTool.Записать();

КонецПроцедуры

// Найти ссылку ar_Tools по реквизиту ar_Имя.
//
// Параметры:
//   ИмяTool - Строка - имя tool (snake_case).
//
// Возвращаемое значение:
//   СправочникСсылка.ar_Tools или Неопределено, если нет записи.
//
Функция НайтиToolПоИмени(Знач ИмяTool)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Tools.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ar_Tools КАК Tools
		|ГДЕ
		|	Tools.ar_Имя = &Имя
		|	И НЕ Tools.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", СокрЛП(ИмяTool));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Безопасно получить значение из JSON-соответствия по ключу.
//
// Параметры:
//   Карта   - Соответствие  - разобранный JSON-объект.
//   Ключ    - Строка        - имя ключа.
//   Дефолт  - Произвольный  - значение при отсутствии ключа.
//
// Возвращаемое значение:
//   Произвольный - значение по ключу или Дефолт.
//
Функция ЗначениеПоКлючу(Знач Карта, Знач Ключ, Знач Дефолт = Неопределено)
	Если ТипЗнч(Карта) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Карта.Получить(Ключ);
	Возврат ?(Значение = Неопределено, Дефолт, Значение);
КонецФункции

// Нормализовать КонтекстЗапуска: при Неопределено вернуть структуру с пустым RunId.
//
// Параметры:
//   Контекст - Структура или Неопределено - КонтекстЗапуска.
//
// Возвращаемое значение:
//   Структура - контекст с RunId.
//
Функция НормализоватьКонтекст(Знач Контекст)
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Возврат Контекст;
	КонецЕсли;
	Возврат Новый Структура("RunId", "");
КонецФункции

// JSON-строка ошибки: {"error":"<код>"}.
//
// Параметры:
//   КодОшибки - Строка - код ошибки.
//
// Возвращаемое значение:
//   Строка - JSON {"error":"<код>"}.
//
Функция ОшибочныйJSON(Знач КодОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", ?(ТипЗнч(КодОшибки) = Тип("Строка"), КодОшибки, ""));
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""save_object_error""}", Результат);
КонецФункции

// JSON-строка ошибки с дополнительным полем.
//
// Параметры:
//   КодОшибки       - Строка - код ошибки ("field_type_mismatch", "internal_error").
//   ЗначениеДопПоля - Строка - значение доп. поля (имя поля или деталь ошибки).
//
// Возвращаемое значение:
//   Строка - JSON {"error":"<код>", "<поле>":"<значение>"}.
//
Функция ОшибочныйJSONСДеталью(Знач КодОшибки, Знач ЗначениеДопПоля)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Если КодОшибки = "field_type_mismatch" Тогда
		Объект.Вставить("field",  ЗначениеДопПоля);
	Иначе
		Объект.Вставить("detail", ЗначениеДопПоля);
	КонецЕсли;
	Результат = ar_JSON.ВЗначениеJSON(Объект);
	Возврат ?(ПустаяСтрока(Результат), "{""error"":""" + КодОшибки + """}", Результат);
КонецФункции

#КонецОбласти
