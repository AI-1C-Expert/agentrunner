// Tool prepare_reconciliation_email (RECON-01): стадия 1 - читает акт сверки
// (act_ref), собирает payload черновика письма (без создания письма и
// вложения на этой стадии) и ставит действие в очередь approval.
//
// RiskLevel = Draft, ТребуетApproval = Истина (паттерн create_invoice_draft).
// Фактическое создание черновика письма выполняет ИсполнитьПодготовкуПисьма -
// стадия 2, вызывается из ar_Approval.ИсполнитьApprovedДействие после
// подтверждения оператором.
//
// Контракт DryRun (DISP-03): при _dry_run = Истина возвращается
// ar_ToolDispatcher.СформироватьDryRunJSON(...) без чтения данных.
//
// Параметры:
//  Аргументы - Строка    - JSON: {"act_ref":...,"to_email":...,"subject":...,"body":...}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: {"status":"queued_for_approval","approval_id":...,
//           "payload":{...}} либо {"error":"..."}.
//
Функция ПодготовитьПисьмоСверки(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ПодготовитьПисьмоСверкиВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool get_invoice_reminder_history (PAY-01): история напоминаний по счёту
// (РегистрСведений.ПредметыПапкиВзаимодействий, Предмет=счёт). RiskLevel =
// Read, ТребуетApproval = Ложь.
//
// Параметры:
//  Аргументы - Строка    - JSON: {"invoice_ref":..., "include_all_interactions":...}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. .docs/specs/PAY-01.md, §get_invoice_reminder_history).
//
Функция ИсторияНапоминанийПоСчёту(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ИсторияНапоминанийПоСчётуВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool prepare_payment_reminder_email (PAY-01): стадия 1 - читает счёт, сумму
// долга, проверяет исключения, собирает payload черновика письма-напоминания
// и ставит действие в очередь approval. RiskLevel = Draft, ТребуетApproval =
// Истина. Фактическое создание черновика - ИсполнитьПодготовкуПисьмаНапоминания
// (стадия 2), вызывается из ar_Approval.ИсполнитьApprovedДействие.
//
// Параметры:
//  Аргументы - Строка    - JSON: {"invoice_ref":..., "subject":..., "body":...,
//              "to_email":..., "attach_invoice":...}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: {"status":"queued_for_approval","approval_id":...,
//           "payload":{...}} либо {"error":"..."}.
//
Функция ПодготовитьПисьмоНапоминание(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ПодготовитьПисьмоНапоминаниеВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сформировать observation-заглушку не реализованного tool:
//   {"status":"not_implemented","tool":"<имя>","hint":"Available in TOOL-07"}.
//
// Параметры:
//  ИмяTool - Строка - имя tool для поля "tool".
//
// Возвращаемое значение:
//  Строка - JSON-observation заглушки.
//
Функция ЗаглушкаНеРеализовано(Знач ИмяTool)
	Объект = Новый Структура;
	Объект.Вставить("status", "not_implemented");
	Объект.Вставить("tool", ИмяTool);
	Объект.Вставить("hint", "Available in TOOL-07");
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// JSON-строка ошибки-observation: {"error":"<код>"}.
//
// Параметры:
//  КодОшибки - Строка - код ошибки для поля "error".
//
// Возвращаемое значение:
//  Строка - JSON-observation ошибки.
//
Функция ОшибочныйJSON(Знач КодОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// JSON-строка ошибки с деталью: {"error":"<код>","detail":"<текст>"}.
Функция ОшибочныйJSONСДеталью(Знач КодОшибки, Знач Деталь)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("detail", Деталь);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

// Сериализует структуру/массив в JSON-строку (без переносов строк).
Функция СтруктуруВJSONКоммуникации(Знач Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "");
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

// Возвращает значение из Соответствия по ключу с дефолтом.
Функция ЗначениеПоКлючуКоммуникации(Знач Коллекция, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(Коллекция) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Коллекция.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат Значение;
КонецФункции

#КонецОбласти

#Область PrepareReconciliationEmail

// Основная логика prepare_reconciliation_email, стадия 1 (RECON-01). Выделена
// из ПодготовитьПисьмоСверки, чтобы внешний Попытка/Исключение ловил любые
// непредвиденные ошибки (DoD «check_1c_code без Error»).
//
// Алгоритм (см. .docs/specs/RECON-01.md, §prepare_reconciliation_email):
//  1. DryRun (DISP-03).
//  2. Десериализация + валидация act_ref (обязателен).
//  3. Разыменование акта сверки, чтение Контрагент/период/остаток.
//  4. to_email: явный аргумент, либо email контрагента из КИ БСП (graceful).
//  5. Сборка Payload (без создания письма/вложения - они появятся на стадии 2)
//     и постановка в очередь approval (ar_Approval.Поставить).
//
Функция ПодготовитьПисьмоСверкиВнутр(Знач Аргументы, Знач Контекст)

	// 1. DryRun (DISP-03): при Истина - симулированный ответ без чтения данных.
	Если ar_ToolDispatcher.ИзвлечьDryRun(Аргументы) Тогда
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("prepare_reconciliation_email", Неопределено);
	КонецЕсли;

	// 2. Десериализация аргументов.
	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	СтрокаАкта = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "act_ref", "")));
	Если ПустаяСтрока(СтрокаАкта) Тогда
		Возврат ОшибочныйJSON("act_ref_required");
	КонецЕсли;

	// 3. Разыменование акта сверки + чтение данных для payload.
	РезультатАкта = РазыменоватьАктСверки(СтрокаАкта);
	Если РезультатАкта.Ошибка <> "" Тогда
		Возврат ОшибочныйJSON(РезультатАкта.Ошибка);
	КонецЕсли;

	Попытка
		ДанныеАкта = ПрочитатьДанныеАктаСверки(РезультатАкта.Ссылка);
	Исключение
		Возврат ОшибочныйJSON("access_denied");
	КонецПопытки;

	Если ДанныеАкта = Неопределено Тогда
		Возврат ОшибочныйJSON("act_not_found");
	КонецЕсли;

	// 4. Адресат: явный to_email либо email контрагента из КИ БСП (graceful).
	ToEmail = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "to_email", "")));
	EmailИсточник = "argument";
	ПричинаОтсутствияEmail = "";
	Если ПустаяСтрока(ToEmail) Тогда
		ToEmail = EmailКонтрагента(ДанныеАкта.Контрагент, ПричинаОтсутствияEmail);
		EmailИсточник = "contragent_ci";
	КонецЕсли;

	// Пустой email НЕ ошибка: tool готовит ЧЕРНОВИК письма (ОтправитьСразу = Ложь),
	// который всё равно уходит на подтверждение оператору - тот может дописать
	// адрес прямо в письме. Раньше здесь возвращался client_email_not_found и
	// вся операция падала из-за незаполненной карточки контрагента.
	// Предупреждение прокидывается в payload и в ответ, чтобы и оператор, и LLM
	// видели, что адресат не определён.
	Если ПустаяСтрока(ToEmail) Тогда
		EmailИсточник = "not_found";
	КонецЕсли;

	// 5. Тема/текст письма - явные аргументы либо типовой шаблон.
	Тема = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "subject", "")));
	Если ПустаяСтрока(Тема) Тогда
		Тема = СтрШаблон(НСтр("ru = 'Акт сверки взаиморасчётов за %1 - %2'"),
			ДанныеАкта.Период, ДанныеАкта.КонтрагентИмя);
	КонецЕсли;

	Текст = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "body", "")));
	Если ПустаяСтрока(Текст) Тогда
		Текст = СтрШаблон(НСтр("ru = 'Добрый день!
			|
			|Направляем акт сверки взаиморасчётов за период %1 по контрагенту %2.
			|Остаток на начало периода: %3.
			|
			|Просим подтвердить акт или сообщить о расхождениях.'"),
			ДанныеАкта.Период, ДанныеАкта.КонтрагентИмя,
			ar_Утилиты.ФорматЧисло(ДанныеАкта.ОстатокНаНачало));
	КонецЕсли;

	// 6. Payload approval-действия. act_ref - навигационная ссылка (не сам
	// объект): вложение-печатная форма формируется на стадии 2, чтобы не
	// удерживать двоичные данные в StateSnapshot очереди (см. докстринг
	// ИсполнитьПодготовкуПисьма).
	Payload = Новый Структура;
	Payload.Вставить("action", "prepare_reconciliation_email");
	Payload.Вставить("act_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(РезультатАкта.Ссылка));
	Payload.Вставить("to_email", ToEmail);
	Payload.Вставить("to_email_source", EmailИсточник);
	Payload.Вставить("subject", Тема);
	Payload.Вставить("body", Текст);
	Payload.Вставить("contragent_name", ДанныеАкта.КонтрагентИмя);

	КонтекстЗапуска = ?(ТипЗнч(Контекст) = Тип("Структура"), Контекст, Новый Структура);
	IdempotencyKey = ar_ToolDispatcher.ИзвлечьIdempotencyKey(Аргументы);

	Действие = Новый Структура;
	Действие.Вставить("Имя", "prepare_reconciliation_email");
	Действие.Вставить("ИдВызова", "");
	Действие.Вставить("Аргументы", Payload);
	Действие.Вставить("IdempotencyKey", IdempotencyKey);
	Действие.Вставить("RiskLevel", "Draft");

	ApprovalИД = ar_Approval.Поставить(КонтекстЗапуска, Действие);

	Результат = Новый Структура;
	Результат.Вставить("status", "queued_for_approval");
	Результат.Вставить("approval_id", ApprovalИД);
	Результат.Вставить("payload", Payload);

	// Адресат не определён - черновик создастся, но перед отправкой оператору
	// нужно вписать адрес (либо повторить вызов с явным to_email).
	Если ПустаяСтрока(ToEmail) Тогда
		Результат.Вставить("warning", "client_email_not_found");
		Результат.Вставить("warning_detail",
			"email контрагента """ + ДанныеАкта.КонтрагентИмя + """ не определён"
			+ ?(ПустаяСтрока(ПричинаОтсутствияEmail), "",
				" (" + ПричинаОтсутствияEmail + ")")
			+ ". Черновик будет создан без адресата - укажите to_email"
			+ " или заполните email в контактной информации контрагента.");
	КонецЕсли;

	Возврат СтруктуруВJSONКоммуникации(Результат);

КонецФункции

// Разыменовывает акт сверки по строке (навигационная ссылка/UUID).
// Возвращает Структуру { Ссылка, Ошибка }.
Функция РазыменоватьАктСверки(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных(
		"АктСверкиВзаиморасчетов", "АктСверкиВзаиморасчетов");
	МДАкт = Метаданные.Документы.Найти(ИмяРеальное);
	Если МДАкт = Неопределено Тогда
		Результат.Ошибка = "act_not_found";
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("ДокументСсылка." + ИмяРеальное);
	Ссылка = Неопределено;

	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Попытка
			КандидатСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
			Если ТипЗнч(КандидатСсылка) = ТипСсылки Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		Попытка
			УникИдент = Новый УникальныйИдентификатор(СтрокаСсылки);
			КандидатСсылка = Документы[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если ЗначениеЗаполнено(КандидатСсылка) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Ошибка = "act_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

// Читает данные акта сверки, нужные для payload письма (в правах пользователя).
// Возвращает Структуру { Контрагент, КонтрагентИмя, Организация, Период,
// ОстатокНаНачало } | Неопределено, если акт не найден/недоступен.
//
Функция ПрочитатьДанныеАктаСверки(Знач Ссылка)

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных(
		"АктСверкиВзаиморасчетов", "АктСверкиВзаиморасчетов");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Акты.Контрагент КАК Контрагент,
		|	Акты.Контрагент.Наименование КАК КонтрагентИмя,
		|	Акты.Организация КАК Организация,
		|	Акты.ДатаНачала КАК ДатаНачала,
		|	Акты.ДатаОкончания КАК ДатаОкончания,
		|	Акты.ОстатокНаНачало КАК ОстатокНаНачало
		|ИЗ
		|	Документ." + ИмяРеальное + " КАК Акты
		|ГДЕ
		|	Акты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Контрагент", Выборка.Контрагент);
	Данные.Вставить("КонтрагентИмя", СокрЛП(Строка(Выборка.КонтрагентИмя)));
	Данные.Вставить("Организация", Выборка.Организация);
	// Период идёт в тему и текст письма КЛИЕНТУ - формат человекочитаемый
	// ("01.01.2008 - 31.03.2008"), а не ISO 8601 (ФорматДата), который
	// предназначен для машинного обмена и выглядел в письме как
	// "2008-01-01T00:00:00".
	Данные.Вставить("Период", СтрШаблон("%1 - %2",
		ar_Утилиты.ФорматДатаПользователю(Выборка.ДатаНачала),
		ar_Утилиты.ФорматДатаПользователю(Выборка.ДатаОкончания)));
	Данные.Вставить("ОстатокНаНачало", ?(ТипЗнч(Выборка.ОстатокНаНачало) = Тип("Число"),
		Выборка.ОстатокНаНачало, 0));

	Возврат Данные;

КонецФункции

// SESS-Debug: компактный дамп таблицы КИ (Тип/Представление построчно) для лога.
// Ограничен 5 строками и 300 символами - не для продакшн-нагрузки, а для
// диагностики client_email_not_found.
Функция ДампТаблицыКИ(Знач ТаблицаКИ)

	Попытка
		ЕстьТип = (ТаблицаКИ.Колонки.Найти("Тип") <> Неопределено);
		ЕстьВид = (ТаблицаКИ.Колонки.Найти("Вид") <> Неопределено);
		ЕстьПредставление = (ТаблицаКИ.Колонки.Найти("Представление") <> Неопределено);

		Результат = "";
		Счетчик = 0;
		Для Каждого СтрокаКИ Из ТаблицаКИ Цикл
			Счетчик = Счетчик + 1;
			Если Счетчик > 5 Тогда
				Результат = Результат + " ...";
				Прервать;
			КонецЕсли;
			Результат = Результат + "["
				+ ?(ЕстьТип, "Тип=" + Строка(СтрокаКИ.Тип), "")
				+ ?(ЕстьВид, "; Вид=" + Строка(СтрокаКИ.Вид), "")
				+ ?(ЕстьПредставление, "; Предст=""" + Строка(СтрокаКИ.Представление) + """", "")
				+ "]";
		КонецЦикла;

		Возврат Лев(Результат, 300);
	Исключение
		Возврат "<дамп недоступен>";
	КонецПопытки;

КонецФункции

// Читает email контрагента через подсистему БСП «УправлениеКонтактнойИнформацией»
// (graceful - при отсутствии подсистемы/значения возвращает "").
//
Функция EmailКонтрагента(Знач СсылкаКонтрагента, Причина = "")

	// SESS-Debug: у функции много «тихих» точек выхода, каждая маскировалась
	// одинаковым client_email_not_found. Логируем причину, чтобы не гадать.
	Если Метаданные.ОбщиеМодули.Найти("УправлениеКонтактнойИнформацией") = Неопределено Тогда
		Причина = "нет общего модуля УправлениеКонтактнойИнформацией";
		ar_СлужебныйЛог.Записать("ar_ToolКоммуникации", "EmailКонтрагента", Причина, "Ошибка");
		Возврат "";
	КонецЕсли;

	ТипEmail = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;

	// ВАЖНО: 4-й параметр ТолькоПредставление по умолчанию = Истина, и в этом
	// режиме БСП уходит в ветку обратной совместимости, которая без указанного
	// вида/типа КИ всегда возвращает "" (а не таблицу). Поэтому тип передаём
	// явно, а ТолькоПредставление = Ложь - только так вернётся ТаблицаЗначений.
	Попытка
		ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			СсылкаКонтрагента, ТипEmail, Неопределено, Ложь);
	Исключение
		Причина = "исключение БСП: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ar_СлужебныйЛог.Записать("ar_ToolКоммуникации", "EmailКонтрагента",
			Причина + "; контрагент=" + Строка(СсылкаКонтрагента), "Ошибка");
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(ТаблицаКИ) <> Тип("ТаблицаЗначений") Тогда
		Причина = "БСП вернула не таблицу, а " + Строка(ТипЗнч(ТаблицаКИ))
			+ " (значение: """ + Строка(ТаблицаКИ) + """)";
		ar_СлужебныйЛог.Записать("ar_ToolКоммуникации", "EmailКонтрагента", Причина, "Ошибка");
		Возврат "";
	КонецЕсли;

	ЕстьКолонкаТип = (ТаблицаКИ.Колонки.Найти("Тип") <> Неопределено);
	ЕстьКолонкаПредставление = (ТаблицаКИ.Колонки.Найти("Представление") <> Неопределено);
	Если Не ЕстьКолонкаПредставление Тогда
		Причина = "в таблице КИ нет колонки Представление";
		ar_СлужебныйЛог.Записать("ar_ToolКоммуникации", "EmailКонтрагента", Причина, "Ошибка");
		Возврат "";
	КонецЕсли;

	Для Каждого СтрокаКИ Из ТаблицаКИ Цикл
		Представление = СокрЛП(Строка(СтрокаКИ.Представление));
		Если ПустаяСтрока(Представление) Тогда
			Продолжить;
		КонецЕсли;
		// Отбор по типу уже сделан на стороне БСП; колонка Тип - страховка.
		Если ЕстьКолонкаТип И СтрокаКИ.Тип <> ТипEmail Тогда
			Продолжить;
		КонецЕсли;
		Возврат Представление;
	КонецЦикла;

	// Дошли сюда - таблица получена, но подходящей строки нет.
	// Отбор по типу email мог не дать строк по трём разным причинам: у контрагента
	// вообще нет КИ, есть КИ но без email, либо строки срезал "ВЫБРАТЬ РАЗРЕШЕННЫЕ"
	// внутри БСП (нехватка прав). Перечитываем КИ без фильтра, чтобы различить.
	Если ТаблицаКИ.Количество() = 0 Тогда
		ВсяКИ = Неопределено;
		Попытка
			ВсяКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				СсылкаКонтрагента, Неопределено, Неопределено, Ложь);
		Исключение
			ВсяКИ = Неопределено;
		КонецПопытки;

		Если ТипЗнч(ВсяКИ) = Тип("ТаблицаЗначений") И ВсяКИ.Количество() > 0 Тогда
			Причина = "email не заполнен: КИ у контрагента есть (строк="
				+ Строка(ВсяКИ.Количество()) + "), но среди них нет типа"
				+ " ""Адрес электронной почты""; дамп=" + ДампТаблицыКИ(ВсяКИ);
		Иначе
			Причина = "у контрагента не заполнена контактная информация"
				+ " (ни одной строки КИ; возможна также нехватка прав на чтение КИ)";
		КонецЕсли;
	Иначе
		Причина = "таблица КИ получена, строк=" + Строка(ТаблицаКИ.Количество())
			+ ", но email не найден; дамп=" + ДампТаблицыКИ(ТаблицаКИ);
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ToolКоммуникации", "EmailКонтрагента",
		Причина + "; контрагент=" + Строка(СсылкаКонтрагента), "Ошибка");
	Возврат "";

КонецФункции

#КонецОбласти

#Область PaymentReminderHistory

// Основная логика get_invoice_reminder_history (PAY-01). Выделена из
// ИсторияНапоминанийПоСчёту, чтобы внешний Попытка/Исключение ловил любые
// непредвиденные ошибки.
//
Функция ИсторияНапоминанийПоСчётуВнутр(Знач Аргументы, Знач Контекст)

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	СтрокаСчёта = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "invoice_ref", "")));
	Если ПустаяСтрока(СтрокаСчёта) Тогда
		Возврат ОшибочныйJSON("invoice_ref_required");
	КонецЕсли;

	РезультатСчёта = РазыменоватьСчётНаОплату(СтрокаСчёта);
	Если РезультатСчёта.Ошибка <> "" Тогда
		Возврат ОшибочныйJSON(РезультатСчёта.Ошибка);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Письма.Ссылка КАК Письмо,
		|	Письма.Дата КАК Дата,
		|	Письма.Тема КАК Тема,
		|	Письма.СтатусПисьма КАК СтатусПисьма,
		|	Письма.ДатаОтправления КАК ДатаОтправления
		|ИЗ
		|	РегистрСведений.ПредметыПапкиВзаимодействий КАК Предметы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектронноеПисьмоИсходящее КАК Письма
		|		ПО Предметы.Взаимодействие = Письма.Ссылка
		|ГДЕ
		|	Предметы.Предмет = &СчётСсылка
		|УПОРЯДОЧИТЬ ПО
		|	Письма.Дата УБЫВ";
	Запрос.УстановитьПараметр("СчётСсылка", РезультатСчёта.Ссылка);

	Напоминания = Новый Массив;
	ПоследняяДата = Неопределено;

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			БылоОтправлено = СтатусПисьмаОтправлен(Выборка.СтатусПисьма);
			Элемент = Новый Структура;
			Элемент.Вставить("date", ar_Утилиты.ФорматДата(Выборка.Дата));
			Элемент.Вставить("subject", СокрЛП(Строка(Выборка.Тема)));
			Элемент.Вставить("email_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Письмо));
			Элемент.Вставить("was_sent", БылоОтправлено);
			Напоминания.Добавить(Элемент);
			Если ПоследняяДата = Неопределено Тогда
				ПоследняяДата = Выборка.Дата;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ИнформацияОшибки = ИнформацияОбОшибке();
		ar_СлужебныйЛог.Записать("ar_ToolКоммуникации.ИсторияНапоминанийПоСчётуВнутр",
			"reminder_history_query_failed",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОшибки), "Ошибка");
		Возврат ОшибочныйJSONСДеталью("query_failed",
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОшибки)));
	КонецПопытки;

	ДнейСПоследнегоНапоминания = Неопределено;
	Если ПоследняяДата <> Неопределено Тогда
		ДнейСПоследнегоНапоминания = Цел((ТекущаяДатаСеанса() - ПоследняяДата) / 86400);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("invoice_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(РезультатСчёта.Ссылка));
	Результат.Вставить("reminder_count", Напоминания.Количество());
	Результат.Вставить("last_reminder_date", ?(ПоследняяДата = Неопределено, Неопределено, ar_Утилиты.ФорматДата(ПоследняяДата)));
	Результат.Вставить("days_since_last_reminder", ДнейСПоследнегоНапоминания);
	Результат.Вставить("next_reminder_level", Напоминания.Количество() + 1);
	Результат.Вставить("reminders", Напоминания);

	Возврат СтруктуруВJSONКоммуникации(Результат);

КонецФункции

// Истина, если СтатусПисьма - "Отправлено" (ПеречислениеСсылка.
// СтатусыИсходящегоЭлектронногоПисьма). Значение перечисления подтверждено
// прямым чтением Enums/СтатусыИсходящегоЭлектронногоПисьма.xml дампа БП.
//
Функция СтатусПисьмаОтправлен(Знач СтатусПисьма)
	Попытка
		Возврат СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Отправлено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Разыменовывает счёт на оплату покупателю по строке (навигационная
// ссылка/UUID). Возвращает Структуру { Ссылка, Ошибка }.
//
Функция РазыменоватьСчётНаОплату(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных(
		"СчетНаОплатуПокупателю", "СчетНаОплатуПокупателю");
	МДСчёт = Метаданные.Документы.Найти(ИмяРеальное);
	Если МДСчёт = Неопределено Тогда
		Результат.Ошибка = "invoice_not_found";
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("ДокументСсылка." + ИмяРеальное);
	Ссылка = Неопределено;

	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Попытка
			КандидатСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
			Если ТипЗнч(КандидатСсылка) = ТипСсылки Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		Попытка
			УникИдент = Новый УникальныйИдентификатор(СтрокаСсылки);
			КандидатСсылка = Документы[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если ЗначениеЗаполнено(КандидатСсылка) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Ошибка = "invoice_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область PreparePaymentReminderEmail

// Основная логика prepare_payment_reminder_email, стадия 1 (PAY-01). Выделена
// из ПодготовитьПисьмоНапоминание, чтобы внешний Попытка/Исключение ловил
// любые непредвиденные ошибки.
//
// Алгоритм (см. .docs/specs/PAY-01.md, §prepare_payment_reminder_email):
//  1. DryRun (DISP-03).
//  2. Десериализация + валидация invoice_ref/subject/body (обязательны).
//  3. Разыменование счёта.
//  4. Повторная проверка исключений (ПрименитьФильтрИсключенийКоммуникации,
//     PKG-09: локальная копия ar_ToolФинансы.ПрименитьФильтрИсключений из
//     пакета) - свойство могли взвести уже после того, как агент получил
//     список.
//  5. Чтение шапки счёта + суммы долга.
//  6. to_email: явный аргумент, иначе EmailКонтрагента (пустой - warning,
//     НЕ ошибка).
//  7. Payload → ar_Approval.Поставить.
//
Функция ПодготовитьПисьмоНапоминаниеВнутр(Знач Аргументы, Знач Контекст)

	Если ar_ToolDispatcher.ИзвлечьDryRun(Аргументы) Тогда
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("prepare_payment_reminder_email", Неопределено);
	КонецЕсли;

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	СтрокаСчёта = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "invoice_ref", "")));
	Тема = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "subject", "")));
	Текст = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "body", "")));

	Если ПустаяСтрока(СтрокаСчёта) Тогда
		Возврат ОшибочныйJSON("invoice_ref_required");
	КонецЕсли;
	Если ПустаяСтрока(Тема) Тогда
		Возврат ОшибочныйJSON("subject_required");
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Возврат ОшибочныйJSON("body_required");
	КонецЕсли;

	// 3. Разыменование счёта.
	РезультатСчёта = РазыменоватьСчётНаОплату(СтрокаСчёта);
	Если РезультатСчёта.Ошибка <> "" Тогда
		Возврат ОшибочныйJSON(РезультатСчёта.Ошибка);
	КонецЕсли;

	Попытка
		ДанныеСчёта = ПрочитатьДанныеСчётаНаОплату(РезультатСчёта.Ссылка);
	Исключение
		Возврат ОшибочныйJSON("access_denied");
	КонецПопытки;

	Если ДанныеСчёта = Неопределено Тогда
		Возврат ОшибочныйJSON("invoice_not_found");
	КонецЕсли;

	// 4. Повторная проверка исключений (свойство могли взвести уже после того,
	// как агент получил список list_unpaid_invoices).
	СвойствоИсключений = НайтиСвойствоИсключенийПоИмениКоммуникации();
	Если СвойствоИсключений <> Неопределено Тогда
		Исключён = ПрименитьФильтрИсключенийКоммуникации(
			ДанныеСчёта.Контрагент, РезультатСчёта.Ссылка, СвойствоИсключений);
		Если Исключён Тогда
			Возврат ОшибочныйJSONСДеталью("invoice_excluded",
				ПричинаИсключенияСчётаКоммуникации(ДанныеСчёта.Контрагент, РезультатСчёта.Ссылка, СвойствоИсключений));
		КонецЕсли;
	КонецЕсли;

	// 6. Адресат: явный to_email либо email контрагента из КИ БСП (graceful).
	ToEmail = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Объект, "to_email", "")));
	EmailИсточник = "argument";
	ПричинаОтсутствияEmail = "";
	Если ПустаяСтрока(ToEmail) Тогда
		ToEmail = EmailКонтрагента(ДанныеСчёта.Контрагент, ПричинаОтсутствияEmail);
		EmailИсточник = "contragent_ci";
	КонецЕсли;
	Если ПустаяСтрока(ToEmail) Тогда
		EmailИсточник = "not_found";
	КонецЕсли;

	AttachInvoice = (ЗначениеПоКлючуКоммуникации(Объект, "attach_invoice", Истина) <> Ложь);

	// 7. Payload approval-действия. invoice_ref - навигационная ссылка (не сам
	// объект): вложение-печатная форма формируется на стадии 2 (тот же принцип,
	// что и в prepare_reconciliation_email).
	Payload = Новый Структура;
	Payload.Вставить("action", "prepare_payment_reminder_email");
	Payload.Вставить("invoice_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(РезультатСчёта.Ссылка));
	Payload.Вставить("to_email", ToEmail);
	Payload.Вставить("to_email_source", EmailИсточник);
	Payload.Вставить("subject", Тема);
	Payload.Вставить("body", Текст);
	Payload.Вставить("contragent_name", ДанныеСчёта.КонтрагентИмя);
	Payload.Вставить("attach_invoice", AttachInvoice);

	КонтекстЗапуска = ?(ТипЗнч(Контекст) = Тип("Структура"), Контекст, Новый Структура);
	IdempotencyKey = ar_ToolDispatcher.ИзвлечьIdempotencyKey(Аргументы);

	Действие = Новый Структура;
	Действие.Вставить("Имя", "prepare_payment_reminder_email");
	Действие.Вставить("ИдВызова", "");
	Действие.Вставить("Аргументы", Payload);
	Действие.Вставить("IdempotencyKey", IdempotencyKey);
	Действие.Вставить("RiskLevel", "Draft");

	ApprovalИД = ar_Approval.Поставить(КонтекстЗапуска, Действие);

	Результат = Новый Структура;
	Результат.Вставить("status", "queued_for_approval");
	Результат.Вставить("approval_id", ApprovalИД);
	Результат.Вставить("payload", Payload);

	Если ПустаяСтрока(ToEmail) Тогда
		Результат.Вставить("warning", "client_email_not_found");
		Результат.Вставить("warning_detail",
			"email контрагента """ + ДанныеСчёта.КонтрагентИмя + """ не определён"
			+ ?(ПустаяСтрока(ПричинаОтсутствияEmail), "",
				" (" + ПричинаОтсутствияEmail + ")")
			+ ". Черновик будет создан без адресата - укажите to_email"
			+ " или заполните email в контактной информации контрагента.");
	КонецЕсли;

	Возврат СтруктуруВJSONКоммуникации(Результат);

КонецФункции

// PKG-09: доп.свойство "Исключить из напоминаний об оплате" - поиск по имени.
// Локальная копия ar_ToolФинансы.НайтиСвойствоИсключенийПоИмени (тот модуль
// перенесён в пакет "AgentRunner Бухгалтерия" вместе с buh_list_unpaid_invoices,
// см. .docs/specs/PKG-09.md) - тот же принцип дублирования простого запроса,
// что уже применён ниже в ПричинаИсключенияСчётаКоммуникации, а не новая
// зависимость ядра от пакета (ядро не должно знать о конкретных пакетах).
//
Функция НайтиСвойствоИсключенийПоИмениКоммуникации() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Свойства.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
		|ГДЕ
		|	Свойства.Имя = &Имя";
	Запрос.УстановитьПараметр("Имя", ИмяСвойстваИсключенийОплатКоммуникации());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Программное имя доп.свойства исключений из напоминаний об оплате -
// фиксированное, администратор заводит свойство с этим именем в «Дополнительных
// реквизитах и сведениях» (подсистема БСП «Свойства»). Значение ОБЯЗАНО
// совпадать с ar_ToolФинансы.ИмяСвойстваИсключенийОплат в пакете "AgentRunner
// Бухгалтерия" - оба потребителя читают ОДНО и то же доп.свойство.
//
Функция ИмяСвойстваИсключенийОплатКоммуникации()
	Возврат "ar_ИсключитьИзНапоминанийОбОплате";
КонецФункции

// Проверяет, исключён ли счёт из напоминаний об оплате: взведённое Булево-
// значение доп.свойства у контрагента (Справочник.Контрагенты.
// ДополнительныеРеквизиты) ИЛИ у самого счёта (РегистрСведений.
// ДополнительныеСведения). Вызывается ТОЧЕЧНО для ОДНОГО счёта - повторная
// проверка ПОСЛЕ того, как buh_list_unpaid_invoices (пакет) уже мог вернуть
// счёт без учёта позже взведённого свойства.
//
// Параметры:
//  СсылкаКонтрагента  - СправочникСсылка.Контрагенты.
//  СсылкаСчёта        - ДокументСсылка.СчетНаОплатуПокупателю.
//  СвойствоИсключений - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения.
//
// Возвращаемое значение:
//  Булево - Истина, если счёт исключён (по любому из двух источников).
//
Функция ПрименитьФильтрИсключенийКоммуникации(Знач СсылкаКонтрагента, Знач СсылкаСчёта, Знач СвойствоИсключений)

	Если СвойствоИсключений = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Найдено
		|ИЗ
		|	Справочник.Контрагенты.ДополнительныеРеквизиты КАК ДопРеквизиты
		|ГДЕ
		|	ДопРеквизиты.Ссылка = &Контрагент
		|	И ДопРеквизиты.Свойство = &Свойство
		|	И ДопРеквизиты.Значение = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДопСведения
		|ГДЕ
		|	ДопСведения.Объект = &Счёт
		|	И ДопСведения.Свойство = &Свойство
		|	И ДопСведения.Значение = ИСТИНА";
	Запрос.УстановитьПараметр("Контрагент", СсылкаКонтрагента);
	Запрос.УстановитьПараметр("Счёт", СсылкаСчёта);
	Запрос.УстановитьПараметр("Свойство", СвойствоИсключений);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Причина исключения счёта ("by_client"/"by_invoice") - для детали ошибки
// invoice_excluded. Симметрична ar_ToolФинансы.ПричинаИсключенияСчёта в пакете
// (PKG-09), но эта функция локальная (пакет не экспортирует свою приватную
// версию, а дублировать простой запрос дешевле новой зависимости ядра от
// пакета).
//
Функция ПричинаИсключенияСчётаКоммуникации(Знач СсылкаКонтрагента, Знач СсылкаСчёта, Знач СвойствоИсключений)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Найдено
		|ИЗ
		|	Справочник.Контрагенты.ДополнительныеРеквизиты КАК ДопРеквизиты
		|ГДЕ
		|	ДопРеквизиты.Ссылка = &Контрагент
		|	И ДопРеквизиты.Свойство = &Свойство
		|	И ДопРеквизиты.Значение = ИСТИНА";
	Запрос.УстановитьПараметр("Контрагент", СсылкаКонтрагента);
	Запрос.УстановитьПараметр("Свойство", СвойствоИсключений);

	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат "by_client";
	КонецЕсли;

	Возврат "by_invoice";

КонецФункции

// Читает данные счёта на оплату покупателю, нужные для payload письма и
// подсчёта долга (в правах пользователя). Возвращает Структуру { Контрагент,
// КонтрагентИмя, Сумма, СуммаОплаты, ДолгСуммы } | Неопределено, если счёт не
// найден/недоступен. Сумма оплаты считается тем же способом, что и в
// list_unpaid_invoices (РегистрНакопления.ОплатаСчетов.Обороты), но по одному
// конкретному счёту - без периода отбора счетов (виден весь срок жизни
// документа).
//
Функция ПрочитатьДанныеСчётаНаОплату(Знач Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Контрагент КАК Контрагент,
		|	Счета.Контрагент.Наименование КАК КонтрагентИмя,
		|	Счета.Организация КАК Организация,
		|	Счета.СуммаДокумента КАК Сумма,
		|	ЕСТЬNULL(ОплатаСчетовОбороты.СуммаОборот, 0) КАК СуммаОплаты
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю КАК Счета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОплатаСчетов.Обороты(
		|				&ДатаНачалаОборотов, &ДатаОкончанияОборотов, , СчетНаОплату = &Ссылка
		|			) КАК ОплатаСчетовОбороты
		|		ПО ОплатаСчетовОбороты.Организация = Счета.Организация
		|		И ОплатаСчетовОбороты.СчетНаОплату = Счета.Ссылка
		|ГДЕ
		|	Счета.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаНачалаОборотов", ДобавитьМесяц(ТекущаяДатаСеанса(), -60));
	Запрос.УстановитьПараметр("ДатаОкончанияОборотов", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Контрагент", Выборка.Контрагент);
	Данные.Вставить("КонтрагентИмя", СокрЛП(Строка(Выборка.КонтрагентИмя)));
	Данные.Вставить("Сумма", ПривестиКЧислуКоммуникации(Выборка.Сумма));
	Данные.Вставить("СуммаОплаты", ПривестиКЧислуКоммуникации(Выборка.СуммаОплаты));
	Данные.Вставить("ДолгСуммы", Макс(0, ПривестиКЧислуКоммуникации(Выборка.Сумма) - ПривестиКЧислуКоммуникации(Выборка.СуммаОплаты)));

	Возврат Данные;

КонецФункции

// Приводит значение выборки запроса к Числу (0 при Неопределено/не-число).
Функция ПривестиКЧислуКоммуникации(Знач Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти

#Область ExecuteReconciliationEmail

// RECON-01: стадия 2 approved-действия prepare_reconciliation_email. Вызывается
// из ar_Approval.ИсполнитьApprovedДействие после перевода записи очереди в
// approved. Создаёт черновик Документы.ЭлектронноеПисьмоИсходящее родной
// фабрикой БП (Взаимодействия.СоздатьПисьмо, ОтправитьСразу = Ложь) с
// вложением - печатной формой акта сверки (MXL, через ту же публичную БСП-точку
// УправлениеПечатью.НапечататьВФайл, что и ar_ToolОтчёты.ПолучитьПечатнуюФормуВнутр).
// Отправку НЕ выполняет.
//
// Работает в правах пользователя, подтвердившего действие - привилегированный
// режим НЕ поднимается (тот же контракт, что и
// ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта).
//
// Параметры:
//  ApprovalId        - Строка - идентификатор записи очереди (для лога).
//  ActionPayloadJSON - Строка - JSON, сохранённый в ar_ОчередьApproval.
//              ar_ActionPayloadJSON: {tool_name, arguments: Payload, ...}.
//
// Возвращаемое значение:
//  Структура - {Выполнено: Булево, DocumentRef: ДокументСсылка.ЭлектронноеПисьмоИсходящее/
//               Неопределено, Сообщения: Массив из Строка}.
//
Функция ИсполнитьПодготовкуПисьма(Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Результат = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	РазобраноActionPayload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Если ТипЗнч(РазобраноActionPayload) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_json");
		Возврат Результат;
	КонецЕсли;

	ToolName = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(РазобраноActionPayload, "tool_name", "")));
	Если ToolName <> "prepare_reconciliation_email" Тогда
		Результат.Сообщения.Добавить("no_executor_for_action:" + ToolName);
		Возврат Результат;
	КонецЕсли;

	Payload = ЗначениеПоКлючуКоммуникации(РазобраноActionPayload, "arguments", Неопределено);
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_arguments");
		Возврат Результат;
	КонецЕсли;

	// Повторное разыменование act_ref (тот же паттерн, что и в
	// ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта - payload хранит строку
	// навигации, не саму ссылку).
	СтрокаАкта = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "act_ref", "")));
	Если ПустаяСтрока(СтрокаАкта) Тогда
		Результат.Сообщения.Добавить("act_ref_required");
		Возврат Результат;
	КонецЕсли;
	РезультатАкта = РазыменоватьАктСверки(СтрокаАкта);
	Если РезультатАкта.Ошибка <> "" Тогда
		Результат.Сообщения.Добавить(РезультатАкта.Ошибка);
		Возврат Результат;
	КонецЕсли;

	// Пустой ToEmail не блокирует создание черновика (см. стадию 1): письмо
	// создаётся без строки получателя, оператор вписывает адрес перед отправкой.
	ToEmail = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "to_email", "")));

	Тема = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "subject", "")));
	Текст = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "body", "")));
	ИмяКонтрагента = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "contragent_name", "")));

	// 1. Печатная форма акта → вложение во временное хранилище (MXL).
	РезультатВложения = СформироватьВложениеАктаСверки(РезультатАкта.Ссылка);
	Если РезультатВложения.Ошибка <> "" Тогда
		Результат.Сообщения.Добавить(РезультатВложения.Ошибка);
		Возврат Результат;
	КонецЕсли;

	// 2. Учётная запись для отправки по умолчанию (без интерактива).
	УчетнаяЗапись = Неопределено;
	Попытка
		УчетнаяЗапись = УправлениеЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	Исключение
		УчетнаяЗапись = Неопределено;
	КонецПопытки;

	Если УчетнаяЗапись = Неопределено Или Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Результат.Сообщения.Добавить("no_email_account");
		Возврат Результат;
	КонецЕсли;

	// 3. Сборка Сообщения (Взаимодействия.ПараметрыПисьма) + Получатели/Вложения.
	Попытка
		Сообщение = Взаимодействия.ПараметрыПисьма();
		Сообщение.Тема = Тема;
		Сообщение.Текст = Текст;

		// Получателя добавляем только с непустым адресом: строка с пустым
		// Адрес некорректна для БП и мешает оператору дописать адресата вручную.
		Если Не ПустаяСтрока(ToEmail) Тогда
			СтрокаПолучателя = Сообщение.Получатели.Добавить();
			СтрокаПолучателя.Адрес = ToEmail;
			СтрокаПолучателя.Представление = ИмяКонтрагента;
			СтрокаПолучателя.ИсточникКонтактнойИнформации = РезультатАкта.Ссылка.Контрагент;
		КонецЕсли;

		СтрокаВложения = Сообщение.Вложения.Добавить();
		СтрокаВложения.Представление = РезультатВложения.ИмяФайла;
		СтрокаВложения.АдресВоВременномХранилище = РезультатВложения.Адрес;

		// 4. Родная фабрика БП: черновик, БЕЗ отправки. Взаимодействия.
		// СоздатьПисьмо(Сообщение, УчетнаяЗапись, ОтправитьСразу=Ложь) уже
		// записывает документ ЭлектронноеПисьмоИсходящее и возвращает
		// РезультатОтправкиПисьма {Отправлено, ОписаниеОшибки, СсылкаНаПисьмо,
		// ...} - при ОтправитьСразу=Ложь функция возвращается сразу после
		// записи письма, СсылкаНаПисьмо уже проставлена (Отправлено=Ложь).
		РезультатПисьма = Взаимодействия.СоздатьПисьмо(Сообщение, УчетнаяЗапись, Ложь);
		Если РезультатПисьма.СсылкаНаПисьмо = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось создать письмо: '")
				+ РезультатПисьма.ОписаниеОшибки;
		КонецЕсли;
	Исключение
		Результат.Сообщения.Добавить(ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ar_СлужебныйЛог.Записать("ar_ToolКоммуникации.ИсполнитьПодготовкуПисьма",
			"prepare_reconciliation_email_write_failed",
			"ApprovalId=" + ApprovalId + ": " + Результат.Сообщения[Результат.Сообщения.ВГраница()],
			"Ошибка");
		Возврат Результат;
	КонецПопытки;

	Результат.Выполнено = Истина;
	Результат.DocumentRef = РезультатПисьма.СсылкаНаПисьмо;

	ar_СлужебныйЛог.Записать("ar_ToolКоммуникации.ИсполнитьПодготовкуПисьма",
		"prepare_reconciliation_email_written",
		"ApprovalId=" + ApprovalId, "Информация", "", Результат.DocumentRef);

	Возврат Результат;

КонецФункции

// Формирует печатную форму акта сверки (MXL) и кладёт её во временное
// хранилище. Reuses паттерн ar_ToolОтчёты.ПолучитьПечатнуюФормуВнутр - тот же
// публичный API БСП УправлениеПечатью (КомандыПечатиОбъектаДоступныеДляВложений
// + НапечататьВФайл), НЕ прямой вызов Печать() менеджера документа.
//
// Возвращаемое значение:
//  Структура { Адрес, ИмяФайла, Ошибка } - Ошибка непустая при неудаче.
//
// Признак «внешняя (подключаемая через Дополнительные отчёты и обработки)
// команда печати» - см. ar_ToolОтчёты.ЭтоВнешняяКомандаПечати (тот же паттерн).
Функция ЭтоВнешняяКомандаПечатиКоммуникации(Знач Команда)
	Попытка
		Возврат СтрНайти(НРег(Строка(Команда.МенеджерПечати)), "дополнительныеотчетыиобработки") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тонкая обёртка над обобщённой СформироватьВложениеДокумента - сохраняет
// прежнюю сигнатуру/поведение для RECON-01 (уже APPROVED, менять поведение
// нельзя): имя файла вложения фиксировано как "Акт сверки.mxl".
//
Функция СформироватьВложениеАктаСверки(Знач СсылкаАкта)
	Возврат СформироватьВложениеДокумента(СсылкаАкта, "Акт сверки.mxl");
КонецФункции

// PAY-01: обобщение СформироватьВложениеАктаСверки на любую ссылку с
// доступными командами печати - используется и для акта сверки (через
// тонкую обёртку выше), и для счёта на оплату покупателю
// (prepare_payment_reminder_email, стадия 2). Формирует печатную форму (MXL)
// через публичный API БСП УправлениеПечатью (КомандыПечатиОбъектаДоступныеДляВложений
// + НапечататьВФайл) и кладёт её во временное хранилище.
//
// Параметры:
//  Знач Ссылка      - ЛюбаяСсылка - объект с доступными командами печати.
//  Знач ИмяФайла    - Строка      - имя файла вложения (с расширением .mxl).
//
// Возвращаемое значение:
//  Структура { Адрес, ИмяФайла, Ошибка } - Ошибка непустая при неудаче.
//
Функция СформироватьВложениеДокумента(Знач Ссылка, Знач ИмяФайла = "Документ.mxl") Экспорт

	Результат = Новый Структура("Адрес, ИмяФайла, Ошибка", "", "", "");

	МД = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если МД = Неопределено Тогда
		Результат.Ошибка = "print_form_not_found";
		Возврат Результат;
	КонецЕсли;

	КомандыПечати = Неопределено;
	Попытка
		КомандыПечати = УправлениеПечатью.КомандыПечатиОбъектаДоступныеДляВложений(МД);
	Исключение
		Результат.Ошибка = "print_form_not_found";
		Возврат Результат;
	КонецПопытки;

	Если КомандыПечати = Неопределено Или КомандыПечати.Количество() = 0 Тогда
		Результат.Ошибка = "print_form_not_found";
		Возврат Результат;
	КонецЕсли;

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Ссылка);

	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	ФорматыСохранения = Новый Массив;
	ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.MXL);
	НастройкиСохранения.ФорматыСохранения = ФорматыСохранения;
	НастройкиСохранения.УпаковатьВАрхив = Ложь;

	Для Каждого Команда Из КомандыПечати Цикл

		// Пропускаем внешние команды (подсистема «Дополнительные отчёты и
		// обработки») - тот же принцип отбора кандидатов, что и в
		// ar_ToolОтчёты.ЭтоВнешняяКомандаПечати.
		Если ЭтоВнешняяКомандаПечатиКоммуникации(Команда) Тогда
			Продолжить;
		КонецЕсли;

		ФайлыПечати = Неопределено;
		Попытка
			ФайлыПечати = УправлениеПечатью.НапечататьВФайл(Команда, МассивОбъектов, НастройкиСохранения);
		Исключение
			Продолжить;
		КонецПопытки;

		Если ТипЗнч(ФайлыПечати) = Тип("ТаблицаЗначений") И ФайлыПечати.Количество() > 0 Тогда
			Попытка
				Результат.Адрес = ПоместитьВоВременноеХранилище(ФайлыПечати[0].ДвоичныеДанные);
				Результат.ИмяФайла = ИмяФайла;
				Возврат Результат;
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	Результат.Ошибка = "print_form_not_found";
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ExecutePaymentReminderEmail

// PAY-01: стадия 2 approved-действия prepare_payment_reminder_email. Точная
// калька ИсполнитьПодготовкуПисьма (RECON-01), но для счёта на оплату вместо
// акта сверки: вложение через обобщённую СформироватьВложениеДокумента,
// ОбязательноУказан ДополнительныеПараметры.Предмет = счёт (даёт историю
// напоминаний tool get_invoice_reminder_history). Отправку НЕ выполняет.
//
// Работает в правах пользователя, подтвердившего действие - привилегированный
// режим НЕ поднимается (тот же контракт, что и ИсполнитьПодготовкуПисьма).
//
// Параметры:
//  ApprovalId        - Строка - идентификатор записи очереди (для лога).
//  ActionPayloadJSON - Строка - JSON, сохранённый в ar_ОчередьApproval.
//
// Возвращаемое значение:
//  Структура - {Выполнено: Булево, DocumentRef: ДокументСсылка.ЭлектронноеПисьмоИсходящее/
//               Неопределено, Сообщения: Массив из Строка}.
//
Функция ИсполнитьПодготовкуПисьмаНапоминания(Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Результат = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	РазобраноActionPayload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Если ТипЗнч(РазобраноActionPayload) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_json");
		Возврат Результат;
	КонецЕсли;

	ToolName = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(РазобраноActionPayload, "tool_name", "")));
	Если ToolName <> "prepare_payment_reminder_email" Тогда
		Результат.Сообщения.Добавить("no_executor_for_action:" + ToolName);
		Возврат Результат;
	КонецЕсли;

	Payload = ЗначениеПоКлючуКоммуникации(РазобраноActionPayload, "arguments", Неопределено);
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_arguments");
		Возврат Результат;
	КонецЕсли;

	СтрокаСчёта = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "invoice_ref", "")));
	Если ПустаяСтрока(СтрокаСчёта) Тогда
		Результат.Сообщения.Добавить("invoice_ref_required");
		Возврат Результат;
	КонецЕсли;
	РезультатСчёта = РазыменоватьСчётНаОплату(СтрокаСчёта);
	Если РезультатСчёта.Ошибка <> "" Тогда
		Результат.Сообщения.Добавить(РезультатСчёта.Ошибка);
		Возврат Результат;
	КонецЕсли;

	ToEmail = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "to_email", "")));
	Тема = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "subject", "")));
	Текст = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "body", "")));
	ИмяКонтрагента = СокрЛП(Строка(ЗначениеПоКлючуКоммуникации(Payload, "contragent_name", "")));
	AttachInvoice = (ЗначениеПоКлючуКоммуникации(Payload, "attach_invoice", Истина) = Истина);

	// 1. Вложение - печатная форма счёта (опционально, attach_invoice).
	РезультатВложения = Неопределено;
	Если AttachInvoice Тогда
		РезультатВложения = СформироватьВложениеДокумента(РезультатСчёта.Ссылка, "Счёт на оплату.mxl");
		Если РезультатВложения.Ошибка <> "" Тогда
			Результат.Сообщения.Добавить(РезультатВложения.Ошибка);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// 2. Учётная запись для отправки по умолчанию (без интерактива).
	УчетнаяЗапись = Неопределено;
	Попытка
		УчетнаяЗапись = УправлениеЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	Исключение
		УчетнаяЗапись = Неопределено;
	КонецПопытки;

	Если УчетнаяЗапись = Неопределено Или Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Результат.Сообщения.Добавить("no_email_account");
		Возврат Результат;
	КонецЕсли;

	// 3. Сборка Сообщения (Взаимодействия.ПараметрыПисьма) + Получатели/Вложения.
	Попытка
		Сообщение = Взаимодействия.ПараметрыПисьма();
		Сообщение.Тема = Тема;
		Сообщение.Текст = Текст;

		Если Не ПустаяСтрока(ToEmail) Тогда
			СтрокаПолучателя = Сообщение.Получатели.Добавить();
			СтрокаПолучателя.Адрес = ToEmail;
			СтрокаПолучателя.Представление = ИмяКонтрагента;
			СтрокаПолучателя.ИсточникКонтактнойИнформации = РезультатСчёта.Ссылка.Контрагент;
		КонецЕсли;

		Если AttachInvoice И РезультатВложения <> Неопределено Тогда
			СтрокаВложения = Сообщение.Вложения.Добавить();
			СтрокаВложения.Представление = РезультатВложения.ИмяФайла;
			СтрокаВложения.АдресВоВременномХранилище = РезультатВложения.Адрес;
		КонецЕсли;

		// Предмет ОБЯЗАТЕЛЕН - даёт историю напоминаний (tool
		// get_invoice_reminder_history, РегистрСведений.ПредметыПапкиВзаимодействий).
		Сообщение.ДополнительныеПараметры.Предмет = РезультатСчёта.Ссылка;

		// Родная фабрика БП: черновик, БЕЗ отправки.
		РезультатПисьма = Взаимодействия.СоздатьПисьмо(Сообщение, УчетнаяЗапись, Ложь);
		Если РезультатПисьма.СсылкаНаПисьмо = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось создать письмо: '")
				+ РезультатПисьма.ОписаниеОшибки;
		КонецЕсли;
	Исключение
		Результат.Сообщения.Добавить(ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ar_СлужебныйЛог.Записать("ar_ToolКоммуникации.ИсполнитьПодготовкуПисьмаНапоминания",
			"prepare_payment_reminder_email_write_failed",
			"ApprovalId=" + ApprovalId + ": " + Результат.Сообщения[Результат.Сообщения.ВГраница()],
			"Ошибка");
		Возврат Результат;
	КонецПопытки;

	Результат.Выполнено = Истина;
	Результат.DocumentRef = РезультатПисьма.СсылкаНаПисьмо;

	ar_СлужебныйЛог.Записать("ar_ToolКоммуникации.ИсполнитьПодготовкуПисьмаНапоминания",
		"prepare_payment_reminder_email_written",
		"ApprovalId=" + ApprovalId, "Информация", "", Результат.DocumentRef);

	Возврат Результат;

КонецФункции

#КонецОбласти

