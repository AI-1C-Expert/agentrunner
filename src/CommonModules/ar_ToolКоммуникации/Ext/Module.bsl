// Общий модуль ar_ToolКоммуникации (Tool Communications).
//
// Tool-слой исходящих коммуникаций и задач (Plan §2.8 этап 1):
// send_email_draft, notify_telegram, create_task.
//
// На этапе DISP-02 модуль содержит СТАБЫ-заглушки с корректным контрактом -
// полная реализация подключается в TOOL-07 без изменений в центральном
// диспетчере (ar_ToolDispatcher). Маршрутизация второго уровня выполняется
// локальной экспортной функцией Диспетчер по имени процедуры.
//
// RECON-01: реализован prepare_reconciliation_email - двухстадийный tool
// (стадия 1 в этом модуле: сборка payload + постановка в очередь approval;
// стадия 2: исполнитель ИсполнитьПодготовкуПисьма, вызывается из
// ar_Approval.ИсполнитьApprovedДействие после подтверждения оператором -
// создаёт черновик Документы.ЭлектронноеПисьмоИсходящее родной фабрикой БП
// Взаимодействия.СоздатьПисьмо с вложением-актом, ОтправитьСразу = Ложь).
//
// Контракт tool-функции:
//   Вход:  Аргументы (Строка) - JSON-объект аргументов от LLM.
//          Контекст (Структура) - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//   Выход: Строка JSON - observation для добавления в контекст как role:tool.
//
// Контракт DryRun (DISP-03):
//   Каждая mutating-функция (RiskLevel = Draft/Write/Commit), например
//   send_email_draft, notify_telegram, create_task, ОБЯЗАНА:
//   1. Вызвать ar_ToolDispatcher.ИзвлечьDryRun(Аргументы).
//   2. При Истина - вернуть ar_ToolDispatcher.СформироватьDryRunJSON(...) вида
//      {"dry_run": true, "tool": "<имя>", "simulated": {...}} БЕЗ записи в данные ИБ
//      (не отправлять письмо/уведомление, не писать в ar_ОчередьApproval).
//   Read-only функции DryRun игнорируют (проверка не обязательна).
//
// Контракт IdempotencyKey (DISP-04):
//   Каждая commit-функция (RiskLevel = Commit) с ТребуетApproval = Истина:
//   1. Получает _idempotency_key из аргументов (через
//      ar_ToolDispatcher.ИзвлечьIdempotencyKey или прямым разбором JSON).
//   2. После успешного выполнения действия вызывает
//      ar_ToolDispatcher.ПометитьApprovalВыполненным(_idempotency_key, РезультатJSON) -
//      запись очереди переходит в executed, результат кэшируется.
//   3. Диспетчер сам проверяет наличие кэша до вызова (НайтиПредыдущийРезультат) -
//      дублирующая проверка в tool не обязательна, но допускается (defence-in-depth).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Mutating-tools (send_email_draft, notify_telegram, create_task,
// prepare_reconciliation_email) строят payload в очередь approval - не
// коммитят напрямую (Plan §2.8, §3.1, §4).
//
// См. спеку: .docs/specs/DISP-02.md, .docs/specs/RECON-01.md, Plan §2.8, §3.4.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Идемпотентно создаёт/обновляет записи реестра ar_Tools для tools модуля
// ar_ToolКоммуникации (RECON-01: prepare_reconciliation_email). Прочие tools
// модуля (send_email_draft, notify_telegram, create_task) остаются
// заглушками TOOL-17/DISP-02 и в реестр не регистрируются.
//
// Привилегированный режим: запись в служебный справочник ar_Tools требует прав;
// реестр заполняется при разворачивании/обновлении расширения. Поднятие
// привилегий локальное, с парным сбросом (Plan §1.3).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } - статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинTool(ОписаниеToolПодготовитьПисьмоСверки(), Статистика);
		ЗарегистрироватьОдинTool(ОписаниеToolИсторияНапоминаний(), Статистика);
		ЗарегистрироватьОдинTool(ОписаниеToolПодготовитьПисьмоНапоминание(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

// Диспетчер второго уровня модуля ar_ToolКоммуникации. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolКоммуникации.
//
// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры (например "ОтправитьДрафтEmail").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ОтправитьДрафтEmail" Тогда
		Возврат ОтправитьДрафтEmail(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "УведомитьTelegram" Тогда
		Возврат УведомитьTelegram(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СоздатьЗадачу" Тогда
		Возврат СоздатьЗадачу(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПодготовитьПисьмоСверки" Тогда
		Возврат ПодготовитьПисьмоСверки(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ИсторияНапоминанийПоСчёту" Тогда
		Возврат ИсторияНапоминанийПоСчёту(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПодготовитьПисьмоНапоминание" Тогда
		Возврат ПодготовитьПисьмоНапоминание(Аргументы, Контекст);
	// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
	// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Tool send_email_draft: построить payload черновика письма в очередь approval.
// СТАБ DISP-02 - полная реализация в TOOL-07.
Функция ОтправитьДрафтEmail(Знач Аргументы, Знач Контекст) Экспорт
	Возврат ЗаглушкаНеРеализовано("send_email_draft");
КонецФункции

