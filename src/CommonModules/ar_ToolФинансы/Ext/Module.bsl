// Tool get_account_balance: универсальные остатки/обороты произвольного счёта
// плана счетов Хозрасчетный в разрезе субконто (Контрагент/Договор для 62,
// graceful для прочего состава субконто).
//
// RiskLevel = Read, DryRun игнорируется (read-only, чтение безопасно).
//
// Параметры:
//  Аргументы - Строка    - JSON: {"account":"62","date":"...",
//              "organization_ref":"...","only_debit":false,"limit":50}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation (см. .docs/specs/RECON-01.md, §get_account_balance).
//
Функция ПолучитьОстатокСчёта(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ПолучитьОстатокСчётаВнутр(Аргументы);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

