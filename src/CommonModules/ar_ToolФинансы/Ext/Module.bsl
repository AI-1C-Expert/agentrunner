////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ToolФинансы (Tool Finance).
//
// Tool-слой финансовой/складской аналитики целевой конфигурации (Plan §2.8
// этап 1): query_payments, find_overdue_receivables, get_balance,
// get_sales_report, get_inventory.
//
// RECON-01: реализован get_account_balance - универсальный read-only доступ к
// остаткам/оборотам произвольного счёта плана счетов Хозрасчетный в разрезе
// субконто (РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты). find_overdue_
// receivables зарегистрирован как алиас-пресет того же расчёта с
// account="62", only_debit=true (обратная совместимость существующих
// пресетов). Прочие tools модуля (query_payments, get_sales_report,
// get_inventory) остаются СТАБАМИ DISP-02.
//
// Контракт tool-функции:
//   Вход:  Аргументы (Строка) - JSON-объект аргументов от LLM.
//          Контекст (Структура) - КонтекстЗапуска {RunId, Агент, DryRun, ...}.
//   Выход: Строка JSON - observation для добавления в контекст как role:tool.
//
// Контракт DryRun (DISP-03):
//   Каждая mutating-функция (RiskLevel = Draft/Write/Commit) ОБЯЗАНА:
//   1. Вызвать ar_ToolDispatcher.ИзвлечьDryRun(Аргументы).
//   2. При Истина - вернуть ar_ToolDispatcher.СформироватьDryRunJSON(...) вида
//      {"dry_run": true, "tool": "<имя>", "simulated": {...}} БЕЗ записи в данные ИБ.
//   Read-only функции DryRun игнорируют (проверка не обязательна). Этот модуль
//   содержит только read-only аналитику - проверка флага не требуется.
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь.
// Tools исполняются в правах пользователя сессии - RLS целевой КФ работает
// естественно (Plan §2.8, §3.1).
//
// См. спеку: .docs/specs/DISP-02.md, .docs/specs/RECON-01.md, Plan §2.8, §3.4.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Идемпотентно создаёт/обновляет записи реестра ar_Tools для tools модуля
// ar_ToolФинансы (RECON-01: get_account_balance, find_overdue_receivables).
// Прочие tools модуля (query_payments, get_balance, get_sales_report,
// get_inventory) остаются заглушками TOOL-17/DISP-02 и в реестр не
// регистрируются.
//
// Привилегированный режим: запись в служебный справочник ar_Tools требует прав;
// реестр заполняется при разворачивании/обновлении расширения. Поднятие
// привилегий локальное, с парным сбросом (Plan §1.3).
//
// Возвращаемое значение:
//  Структура { Создано - Число, Обновлено - Число } - статистика регистрации.
//
Функция ЗарегистрироватьTools() Экспорт

	Статистика = Новый Структура("Создано, Обновлено", 0, 0);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗарегистрироватьОдинTool(ОписаниеToolПолучитьОстатокСчёта(), Статистика);
		ЗарегистрироватьОдинTool(ОписаниеToolПросроченнаяДебиторка(), Статистика);
		ЗарегистрироватьОдинTool(ОписаниеToolСписокНеоплаченныхСчетов(), Статистика);
		ЗарегистрироватьОдинTool(ОписаниеToolПоискОрганизаций(), Статистика);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Статистика;

КонецФункции

// Диспетчер второго уровня модуля ar_ToolФинансы. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolФинансы.
//
// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры (например "ЗапросПлатежей").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция Диспетчер(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ЗапросПлатежей" Тогда
		Возврат ЗапросПлатежей(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПросроченнаяДебиторка" Тогда
		Возврат ПросроченнаяДебиторка(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПолучитьОстатокСчёта" Тогда
		Возврат ПолучитьОстатокСчёта(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПолучитьОстаток" Тогда
		Возврат ПолучитьОстаток(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ОтчётОПродажах" Тогда
		Возврат ОтчётОПродажах(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ОстаткиТоваров" Тогда
		Возврат ОстаткиТоваров(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СписокНеоплаченныхСчетов" Тогда
		Возврат СписокНеоплаченныхСчетов(Аргументы, Контекст);
	// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
	// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

