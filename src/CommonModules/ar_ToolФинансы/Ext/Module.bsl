// JSON Schema аргументов get_account_balance, обёрнутая в OpenAI tool-format.
Функция МанифестПолучитьОстатокСчёта()
	Свойства = Новый Структура;
	Свойства.Вставить("account", СвойствоСхемыФинансы("string",
		"Код счёта плана счетов Хозрасчетный (например '62'). По умолчанию '62'."));
	Свойства.Вставить("date", СвойствоСхемыФинансы("string",
		"Дата остатков в ISO 8601 (YYYY-MM-DD). По умолчанию - текущая дата."));
	Свойства.Вставить("organization_inn", СвойствоСхемыФинансы("string",
		"ИНН ОРГАНИЗАЦИИ - нашего юрлица (опционально, фильтр). Приоритетный"
		+ " способ отобрать по организации: ссылки для неё НЕ принимаются"
		+ " (по наименованию есть organization_name)."
		+ " Бери значение из поля organization_inn в items/by_contragent"
		+ " предыдущего вызова. НЕ путай с ИНН контрагента из search_clients -"
		+ " для контрагента есть contragent_inn."
		+ " НЕ ЗАПОЛНЯЙ этот аргумент, если пользователь не назвал конкретную"
		+ " организацию: чтобы узнать, ПО КАКИМ организациям есть долг у"
		+ " контрагента, вызывай с одним contragent_inn - список организаций"
		+ " с их ИНН вернётся в by_contragent."));
	Свойства.Вставить("organization_name", СвойствоСхемыФинансы("string",
		"Наименование ОРГАНИЗАЦИИ - нашего юрлица - или его часть"
		+ " (опционально). Используй, когда пользователь назвал организацию"
		+ " словами, а ИНН неизвестен. Поиск без учёта регистра: точное"
		+ " совпадение приоритетнее вхождения подстроки. Если подходит"
		+ " несколько, вернётся organization_name_ambiguous со списком"
		+ " кандидатов и их ИНН - уточни у пользователя и повтори с"
		+ " organization_inn. Игнорируется, если задан organization_inn."
		+ " НЕ путай с наименованием контрагента - для него search_clients."));
	Свойства.Вставить("contragent_inn", СвойствоСхемыФинансы("string",
		"ИНН контрагента (опционально, фильтр). Надёжнее ссылки: бери его из"
		+ " search_clients (поле inn) как есть. Синоним: client_inn."
		+ " Для запроса вида «долг контрагента X» это ЕДИНСТВЕННЫЙ нужный"
		+ " аргумент - организацию не указывай."));
	Свойства.Вставить("contragent_ref", СвойствоСхемыФинансы("string",
		"Навигационная ссылка или UUID контрагента (опционально, фильтр)."
		+ " Указывай его, когда нужно сальдо ОДНОГО контрагента - иначе"
		+ " вернётся вся база. Синоним: client_ref."));
	Свойства.Вставить("contract_ref", СвойствоСхемыФинансы("string",
		"Навигационная ссылка или UUID договора (опционально, фильтр)."
		+ " Для сальдо по конкретному договору контрагента."));
	Свойства.Вставить("settlement_document_ref", СвойствоСхемыФинансы("string",
		"Навигационная ссылка документа расчётов (опционально, фильтр) - для"
		+ " сальдо по конкретному документу (реализация, поступление и т.п.)."
		+ " Синоним: document_ref."));
	Свойства.Вставить("only_debit", СвойствоСхемыФинансы("boolean",
		"Вернуть только субконто с сальдо Дт > 0 (для отбора должников)."));
	Свойства.Вставить("limit", СвойствоСхемыФинансы("integer",
		"Максимум записей (1..200, по умолчанию 50)."));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);

	Возврат ОбернутьВOpenAIФорматФинансы("get_account_balance",
		"Остатки/обороты произвольного счёта плана счетов Хозрасчетный."
		+ " Если у счёта есть разрез по контрагентам, в ответе будет поле"
		+ " by_contragent - готовый свод (total_debit, total_credit, net_debt)"
		+ " по каждому контрагенту, посчитанный по всем субсчетам, договорам и"
		+ " организациям. Для вопросов вида «сколько должен X» бери net_debt"
		+ " оттуда, не суммируя items вручную."
		+ " Поле items - сырая детализация ОСВ: одна строка = организация +"
		+ " субсчёт (account_code) + субконто, с раздельными balance_debit и"
		+ " balance_credit (они НЕ свёрнуты между строками)."
		+ " Для счетов с количественным учётом добавляются quantity_*, с"
		+ " валютным - currency_* (наличие видно по флагам has_quantity /"
		+ " has_currency в ответе). Read-only.",
		Параметры);
КонецФункции

