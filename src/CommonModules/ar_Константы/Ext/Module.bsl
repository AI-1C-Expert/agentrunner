// Возвращает массив разрешённых хостов LLM (URL allowlist).
//
// Парсинг: строка из константы ar_LLM_AllowList_URL разбивается по Символы.ПС
// с удалением пустых строк и обрезкой пробелов. Если константа пуста -
// возвращается захардкоженный дефолт из 4 стандартных провайдеров.
//
// Возвращаемое значение:
//  Массив из Строка - список хостов (без схемы и пути), например "api.openai.com".
//
Функция LLMAllowListURL() Экспорт

	Значение = Константы.ar_LLM_AllowList_URL.Получить();
	Результат = Новый Массив;

	Если Не ПустаяСтрока(Значение) Тогда
		Строки = СтрРазделить(Значение, Символы.ПС, Ложь);
		Для Каждого Строка Из Строки Цикл
			Хост = СокрЛП(Строка);
			Если Не ПустаяСтрока(Хост) Тогда
				Результат.Добавить(Хост);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("api.openai.com");
		Результат.Добавить("api.anthropic.com");
		Результат.Добавить("llm.api.cloud.yandex.net");
		Результат.Добавить("gigachat.devices.sberbank.ru");
		// OAuth2-эндпоинт GigaChat (получение Bearer-токена, LLM-05).
		Результат.Добавить("ngw.devices.sberbank.ru");
		// Собственный облачный LLM-шлюз AgentRunner (LLM-12).
		Результат.Добавить("agentrunner.ru");
		// Локальные inference-серверы (LM Studio, Ollama, LLaMA.cpp и т.п.,
		// см. ar_LLMLocalCompatible) - трафик не покидает машину, ar_HTTP
		// разрешает для них http:// в дополнение к обычному https://.
		Результат.Добавить("localhost");
		Результат.Добавить("127.0.0.1");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Извлекает хост из URL (без схемы, порта и пути).
//
// Лёгкий парсер для нужд allowlist: полноценный разбор URL живёт в
// ar_HTTP.РазобратьURL, но он служебный (не экспортный), а здесь нужен только
// хост. Никаких regexp и Выполнить() - только строковые функции платформы.
//
// Параметры:
//   URL - Строка - произвольный URL, например "http://192.168.1.50:1234/v1".
//
// Возвращаемое значение:
//   Строка - хост в нижнем регистре ("192.168.1.50"), пустая строка если
//            разобрать не удалось.
//
Функция ХостИзURL(Знач URL) Экспорт

	Если ТипЗнч(URL) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Текст = НРег(СокрЛП(URL));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	// Отбрасываем схему.
	ПозицияСхемы = СтрНайти(Текст, "://");
	Если ПозицияСхемы > 0 Тогда
		Текст = Сред(Текст, ПозицияСхемы + 3);
	КонецЕсли;

	// Отбрасываем credentials вида user:pass@host.
	ПозицияСобаки = СтрНайти(Текст, "@");
	Если ПозицияСобаки > 0 Тогда
		Текст = Сред(Текст, ПозицияСобаки + 1);
	КонецЕсли;

	// Отбрасываем путь, query и fragment.
	ДляОбрезки = Новый Массив;
	ДляОбрезки.Добавить("/");
	ДляОбрезки.Добавить("?");
	ДляОбрезки.Добавить("#");
	Для Каждого Разделитель Из ДляОбрезки Цикл
		Позиция = СтрНайти(Текст, Разделитель);
		Если Позиция > 0 Тогда
			Текст = Лев(Текст, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	// Отбрасываем порт (IPv6 в BaseURL провайдеров не поддерживается).
	ПозицияДвоеточия = СтрНайти(Текст, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Текст = Лев(Текст, ПозицияДвоеточия - 1);
	КонецЕсли;

	Возврат СокрЛП(Текст);

КонецФункции

// Добавляет хост в allowlist LLM (константа ar_LLM_AllowList_URL), если его
// там ещё нет. Идемпотентна: повторный вызов с тем же хостом ничего не меняет.
//
// Зачем: мастер настройки и карточка провайдера позволяют ввести произвольный
// BaseURL (локальный inference-сервер в сети предприятия, корпоративный
// LLM-шлюз). Без этого вызова первый же запрос падал с "URL не входит в
// allowlist LLM", и пользователю приходилось вручную искать константу в
// Настройках. Адрес введён администратором осознанно - считаем доверенным.
//
// Важно про пустую константу: LLMAllowListURL() при пустом значении возвращает
// захардкоженный дефолт. Поэтому перед дозаписью список материализуется целиком
// (дефолт + новый хост), иначе константа с одним хостом отрезала бы все
// стандартные провайдеры.
//
// Параметры:
//   Хост - Строка - хост без схемы и порта ("192.168.1.50", "llm.corp.local").
//          Может быть передан и полный URL - хост будет извлечён.
//   Источник - Строка - откуда пришёл вызов, для записи в ar_СлужебныйЛог.
//
// Возвращаемое значение:
//   Булево - Истина, если константа была изменена (хост добавлен).
//
Функция ДобавитьХостВAllowList(Знач Хост, Знач Источник = "") Экспорт

	Если ТипЗнч(Хост) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	ХостНормализованный = НРег(СокрЛП(Хост));

	// Если передали полный URL - вытащим из него хост.
	Если СтрНайти(ХостНормализованный, "://") > 0 Или СтрНайти(ХостНормализованный, "/") > 0
		Или СтрНайти(ХостНормализованный, ":") > 0 Тогда
		ХостНормализованный = ХостИзURL(ХостНормализованный);
	КонецЕсли;

	Если ПустаяСтрока(ХостНормализованный) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущийСписок = LLMAllowListURL();

	// Семантика совпадения повторяет ar_HTTP.ХостВAllowList: точное равенство
	// либо суффикс для элементов, начинающихся с точки (".openai.com" уже
	// разрешает "api.openai.com" - дубль добавлять не нужно).
	Для Каждого Элемент Из ТекущийСписок Цикл

		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;

		ЭлементНормализованный = НРег(СокрЛП(Элемент));
		Если ПустаяСтрока(ЭлементНормализованный) Тогда
			Продолжить;
		КонецЕсли;

		Если ЭлементНормализованный = ХостНормализованный Тогда
			Возврат Ложь; // уже разрешён - ничего не делаем
		КонецЕсли;

		Если Лев(ЭлементНормализованный, 1) = "."
			И СтрЗаканчиваетсяНа(ХостНормализованный, ЭлементНормализованный) Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	ТекущийСписок.Добавить(ХостНормализованный);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.ar_LLM_AllowList_URL.Установить(СтрСоединить(ТекущийСписок, Символы.ПС));
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	ar_СлужебныйЛог.Записать("ar_Константы.ДобавитьХостВAllowList", "SEC-Allowlist",
		"Хост [" + ХостНормализованный + "] добавлен в allowlist автоматически. Источник: "
		+ ?(ПустаяСтрока(Источник), "не указан", Источник));

	Возврат Истина;

КонецФункции

// Возвращает максимальный допустимый размер тела HTTP-ответа в байтах.
//
// Используется модулем ar_HTTP.ВыполнитьPOST для защиты сессии 1С от
// аномально больших ответов LLM-провайдеров (HTTP-03, Plan §3.8).
// Администратор может задать произвольный лимит через константу
// ar_МаксРазмерОтветаHTTP; при значении 0 используется дефолт 4 MB.
//
// Возвращаемое значение:
//  Число - лимит в байтах. Если константа = 0 - дефолт 4194304 (4 MB).
//
Функция МаксРазмерОтветаHTTP() Экспорт

	Значение = Константы.ar_МаксРазмерОтветаHTTP.Получить();
	Если Значение = 0 Тогда
		Возврат 4194304; // 4 MB
	КонецЕсли;
	Возврат Значение;

КонецФункции

