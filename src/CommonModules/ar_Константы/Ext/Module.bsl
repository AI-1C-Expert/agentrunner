// Возвращает максимальное число суммарных активных запусков агентов
// (rate-limiter планировщика, SCHED-05).
//
// Возвращаемое значение:
//  Число - предел суммарных активных запусков. Если константа = 0 - дефолт 20.
//
Функция МаксСуммарныхЗапусков() Экспорт

	Значение = Константы.ar_МаксСуммарныхЗапусков.Получить();
	Если Значение = 0 Тогда
		Возврат 20;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Возвращает порог предупреждения диагностики планировщика в секундах (SCHED-06).
//
// Если последний успешный запуск регламентного задания AgentRunner старше этого
// порога - форма «Настройки AgentRunner» помечает задание как warning.
//
// Возвращаемое значение:
//  Число - порог в секундах. Если константа = 0 - дефолт 300 (5 минут).
//
Функция ПорогПредупрежденияПланировщика() Экспорт

	Значение = Константы.ar_ПорогПредупрежденияПланировщикаСек.Получить();
	Если Значение = 0 Тогда
		Возврат 300;
	КонецЕсли;
	Возврат Значение;

КонецФункции

