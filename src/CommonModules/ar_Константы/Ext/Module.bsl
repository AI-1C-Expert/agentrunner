// Возвращает workspace-prompt (общий системный prompt) расширения.
//
// Если константа ar_ОбщийСистемныйPrompt не заполнена администратором -
// возвращает содержимое общего макета ar_СистемныйPromptШаблон (дефолтный
// системный prompt "из коробки", PROMPT-01). Константа, если заполнена,
// полностью переопределяет дефолт из макета (не дополняет его).
//
// Возвращаемое значение:
//  Строка - текст workspace-prompt (может быть пустой строкой, если и
//           константа, и макет недоступны).
//
Функция ОбщийСистемныйPrompt() Экспорт

	ЗначениеКонстанты = СокрЛП(Константы.ar_ОбщийСистемныйPrompt.Получить());
	Если Не ПустаяСтрока(ЗначениеКонстанты) Тогда
		Возврат ЗначениеКонстанты;
	КонецЕсли;

	Возврат ДефолтныйСистемныйPromptИзМакета();

КонецФункции

// Читает дефолтный текст системного prompt из общего макета
// ar_СистемныйPromptШаблон (TemplateType = TextDocument, PROMPT-01).
// Best-effort: при отсутствии/повреждении макета возвращает пустую строку,
// не бросает исключение - отсутствие workspace-prompt не должно ронять запуск.
//
// Возвращаемое значение:
//  Строка - текст макета либо "".
//
Функция ДефолтныйСистемныйPromptИзМакета()

	Попытка
		// SESS-Debug: Variable is not defined (ОбщиеМакеты) в контексте модуля
		// расширения - глобальная коллекция ОбщиеМакеты недоступна как переменная
		// для объектов, определённых в расширении. ПолучитьОбщийМакет(Строка) -
		// платформенная глобальная функция, работает и для макетов расширения.
		Макет = ПолучитьОбщийМакет("ar_СистемныйPromptШаблон");
		Возврат СокрЛП(Макет.ПолучитьТекст());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

