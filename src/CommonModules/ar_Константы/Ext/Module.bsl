// Возвращает порог длительности вызова инструмента в секундах, свыше которого
// ar_ToolDispatcher пишет в ar_СлужебныйЛог предупреждение "slow_tool" (PERF-05).
// 0 - автообнаружение отключено (отчёт «Производительность инструментов»
// продолжает работать, порог используется только для подсветки строк).
//
// Возвращаемое значение:
//  Число - порог в секундах. 0 - осознанное значение администратора
//  («выключить автообнаружение»), а не признак «не настроено», поэтому в 0
//  дефолт НЕ подставляется. Ветка с возвратом 15 срабатывает только на
//  нечисловом значении и практически недостижима: незаполненная числовая
//  константа возвращает 0, а не Неопределено. Дефолт 15 проставляется разово
//  обработчиком обновления ИнициализироватьПорогМедленногоTool (0.1.0.252).
//
Функция ПорогМедленногоToolСек() Экспорт

	Значение = Константы.ar_ПорогМедленногоTool.Получить();
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 15;
	КонецЕсли;
	Возврат Значение;

КонецФункции

