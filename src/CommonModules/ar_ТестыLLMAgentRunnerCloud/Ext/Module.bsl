// Тест-модуль ar_ТестыLLMAgentRunnerCloud -- юнит-тесты провайдера
// ar_LLMAgentRunnerCloud, добавленные в рамках LLM-14.
//
// ПОКРЫТИЕ (уровень юнит-тестов, без реального HTTP-вызова шлюза):
//
//   Часть A -- разбор кода ошибки 402 (ОписаниеОшибкиHTTP/ИзвлечьКодОшибки):
//     Тест_ОписаниеОшибкиHTTP_402_InsufficientBalance_ТекстПроБаланс
//     Тест_ОписаниеОшибкиHTTP_402_LimitExceeded_ТекстПроЛимит
//     Тест_ОписаниеОшибкиHTTP_402_БезТела_ТекстПроБалансFallback
//     Тест_ОписаниеОшибкиHTTP_402_НевалидныйJSON_ТекстПроБалансFallback
//     Тест_ОписаниеОшибкиHTTP_402_БезПоляCode_ТекстПроБалансFallback
//     Тест_ИзвлечьКодОшибки_НетЧисловыхЗначенийВТексте
//
//   Часть Б -- проброс баланса успешного ответа (ПарситьБаланс):
//     Тест_ПарситьБаланс_BalanceRubИLowBalanceFalse
//     Тест_ПарситьБаланс_LowBalanceTrueБезBalanceRub_ОстаётсяНеопределено
//     Тест_ПарситьБаланс_БезОбоихПолей_Дефолты
//     Тест_ПарситьБаланс_LowBalanceСтрока_Игнорируется
//     Тест_ПарситьБаланс_IdempotentРеплей_БалансПарсится
//     Тест_ВалидироватьОтвет_БезКлючейБаланса_OpenAIRegression
//
// Запуск: каждая Тест_*-функция возвращает Истина/Ложь без сайд-эффектов на ИБ.
// Не требует HTTP-публикации, реального ключа шлюза или сетевого доступа --
// тестируются только чистые функции разбора JSON-тела ответа/ошибки, ставшие
// экспортными специально для этого модуля (см. doc-comments в
// ar_LLMAgentRunnerCloud: ОписаниеОшибкиHTTP, ИзвлечьКодОшибки, ПарситьБаланс,
// НовыйРезультат).
//
// Ограничения:
//   * Тесты диспетчерного fallback (кейс 7 из .docs/specs/LLM-14.md, часть Б)
//     и тесты ar_RuntimeЦикл.МетрикиСобытияLLM / журнала регистрации (кейсы 8-9)
//     требуют реальных ссылок на справочник ar_LLMПровайдеры и/или фонового
//     задания -- не покрыты здесь на юнит-уровне, см. заметки в спеке LLM-14.
//   * Тест ar_МастерНастройки.ПроверитьСоединениеНаСервере (кейс 10) требует
//     реального HTTP-вызова шлюза -- ручная smoke-проверка, не юнит-тест.
//
// Спека: .docs/specs/LLM-14.md
////////////////////////////////////////////////////////////////////////////////

#Область ЧастьA_РазборКодаОшибки402

// Тест: 402 с телом {"error":"...", "code":"insufficient_balance", "balance":0}
// -- ожидается текст ошибки про баланс ("Пополните счёт"), без числовых значений.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ОписаниеОшибкиHTTP_402_InsufficientBalance_ТекстПроБаланс() Экспорт
	Попытка
		// Требуемая для теста строка баланса из входного JSON ("required":777) -
		// значение специально нестандартное (не 0/1/2...), чтобы не пересекаться
		// с цифрами, которые могут случайно встретиться в служебных частях
		// текста (доменные имена, версии и т.п.) - проверка отсутствия именно
		// этого числа в итоговом тексте надёжнее проверки "любая цифра".
		HTTPОтвет = Новый Структура("КодСостояния, Тело, Ошибка",
			402, "{""error"":""no money"",""code"":""insufficient_balance"",""balance"":0,""required"":777}", "");

		Текст = ar_LLMAgentRunnerCloud.ОписаниеОшибкиHTTP(HTTPОтвет);

		Если ПустаяСтрока(Текст) Тогда
			Возврат Ложь;
		КонецЕсли;
		// Текст должен содержать хотя бы одно из ожидаемых слов про баланс.
		СодержитОжидаемоеСлово = (СтрНайти(Текст, "аланс") > 0 ИЛИ СтрНайти(Текст, "Пополните") > 0);
		Если Не СодержитОжидаемоеСлово Тогда
			Возврат Ложь;
		КонецЕсли;
		// Числовое значение required (777) не должно течь в текст ошибки.
		Если СтрНайти(Текст, "777") > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: 402 с телом {"error":"...", "code":"limit_exceeded", "limit":100, "period":"day"}
// -- ожидается текст ошибки про лимит ("личном кабинете"), без числовых значений.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ОписаниеОшибкиHTTP_402_LimitExceeded_ТекстПроЛимит() Экспорт
	Попытка
		// Значение лимита (999) специально нестандартное - см. комментарий
		// в предыдущем тесте про выбор числа для надёжной проверки утечки.
		HTTPОтвет = Новый Структура("КодСостояния, Тело, Ошибка",
			402, "{""error"":""too much"",""code"":""limit_exceeded"",""limit"":999,""period"":""day""}", "");

		Текст = ar_LLMAgentRunnerCloud.ОписаниеОшибкиHTTP(HTTPОтвет);

		Если ПустаяСтрока(Текст) Тогда
			Возврат Ложь;
		КонецЕсли;
		// Текст должен содержать хотя бы одно из ожидаемых слов про лимит.
		СодержитОжидаемоеСлово = (СтрНайти(Текст, "имит") > 0 ИЛИ СтрНайти(Текст, "личном кабинете") > 0);
		Если Не СодержитОжидаемоеСлово Тогда
			Возврат Ложь;
		КонецЕсли;
		// Числовое значение лимита (999) не должно течь в текст ошибки.
		Если СтрНайти(Текст, "999") > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: 402 без тела -- regression-проверка на дефолтную ветку про баланс
// (fallback безопасного поведения, если сайт не прислал тело).
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ОписаниеОшибкиHTTP_402_БезТела_ТекстПроБалансFallback() Экспорт
	Попытка
		HTTPОтвет = Новый Структура("КодСостояния, Тело, Ошибка", 402, "", "");

		Текст = ar_LLMAgentRunnerCloud.ОписаниеОшибкиHTTP(HTTPОтвет);

		Если ПустаяСтрока(Текст) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если СтрНайти(Текст, "аланс") = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

