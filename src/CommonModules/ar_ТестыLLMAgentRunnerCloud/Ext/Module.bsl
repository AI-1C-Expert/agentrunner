// Тест: ИзвлечьКодОшибки корректно извлекает "code" из валидного JSON,
// а ОписаниеОшибкиHTTP на его основе не включает числа (limit/balance/required)
// в итоговый текст ни для одной из двух веток 402.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ИзвлечьКодОшибки_НетЧисловыхЗначенийВТексте() Экспорт
	Попытка
		Если ar_LLMAgentRunnerCloud.ИзвлечьКодОшибки(
			"{""code"":""insufficient_balance"",""required"":42}") <> "insufficient_balance" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ar_LLMAgentRunnerCloud.ИзвлечьКодОшибки(
			"{""code"":""limit_exceeded""}") <> "limit_exceeded" Тогда
			Возврат Ложь;
		КонецЕсли;
		// Невалидный/отсутствующий code -> "".
		Если ar_LLMAgentRunnerCloud.ИзвлечьКодОшибки("") <> "" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ar_LLMAgentRunnerCloud.ИзвлечьКодОшибки("not json") <> "" Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ЧастьБ_ПрокидываниеБаланса

// Тест: 200 + balance_rub: 42.5, low_balance: false ->
// Результат.БалансРуб=42.5, Результат.БалансНизкий=Ложь.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПарситьБаланс_BalanceRubИLowBalanceFalse() Экспорт
	Попытка
		Ответ = Новый Соответствие;
		Ответ.Вставить("balance_rub", 42.5);
		Ответ.Вставить("low_balance", Ложь);

		Результат = ar_LLMAgentRunnerCloud.НовыйРезультат();
		ar_LLMAgentRunnerCloud.ПарситьБаланс(Ответ, Результат);

		Если Результат.БалансРуб <> 42.5 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Результат.БалансНизкий <> Ложь Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: 200 + low_balance: true без balance_rub ->
// БалансРуб=Неопределено (НЕ 0), БалансНизкий=Истина.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПарситьБаланс_LowBalanceTrueБезBalanceRub_ОстаётсяНеопределено() Экспорт
	Попытка
		Ответ = Новый Соответствие;
		Ответ.Вставить("low_balance", Истина);

		Результат = ar_LLMAgentRunnerCloud.НовыйРезультат();
		ar_LLMAgentRunnerCloud.ПарситьБаланс(Ответ, Результат);

		Если Результат.БалансРуб <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Результат.БалансНизкий <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: 200 без обоих полей (эмуляция старой версии шлюза) ->
// дефолты Неопределено/Ложь, без исключений.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПарситьБаланс_БезОбоихПолей_Дефолты() Экспорт
	Попытка
		Ответ = Новый Соответствие;
		Ответ.Вставить("content", "hello");

		Результат = ar_LLMAgentRunnerCloud.НовыйРезультат();
		ar_LLMAgentRunnerCloud.ПарситьБаланс(Ответ, Результат);

		Если Результат.БалансРуб <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Результат.БалансНизкий <> Ложь Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
