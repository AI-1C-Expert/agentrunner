//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ОписаниеОшибкиHTTP_402_НевалидныйJSON_ТекстПроБалансFallback() Экспорт
	Попытка
		HTTPОтвет = Новый Структура("КодСостояния, Тело, Ошибка", 402, "not a json {{{", "");

		Текст = ar_LLMAgentRunnerCloud.ОписаниеОшибкиHTTP(HTTPОтвет);

		Если ПустаяСтрока(Текст) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если СтрНайти(Текст, "аланс") = 0 Тогда
			Возврат Ложь;
