КонецФункции

// Тест: 402 с валидным JSON, но без поля "code" -- дефолтная ветка про баланс
// (сайт старой версии, поле code не прислано).
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ОписаниеОшибкиHTTP_402_БезПоляCode_ТекстПроБалансFallback() Экспорт
	Попытка
		HTTPОтвет = Новый Структура("КодСостояния, Тело, Ошибка",
			402, "{""error"":""no money""}", "");

		Текст = ar_LLMAgentRunnerCloud.ОписаниеОшибкиHTTP(HTTPОтвет);

