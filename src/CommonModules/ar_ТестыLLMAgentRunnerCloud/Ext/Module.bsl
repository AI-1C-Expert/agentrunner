КонецФункции

// Тест: 200 + low_balance: "true" (Строка, не Булево) -- defensive: значение
// игнорируется, остаётся дефолт Ложь, без падения.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПарситьБаланс_LowBalanceСтрока_Игнорируется() Экспорт
	Попытка
		Ответ = Новый Соответствие;
		Ответ.Вставить("low_balance", "true");

		Результат = ar_LLMAgentRunnerCloud.НовыйРезультат();
		ar_LLMAgentRunnerCloud.ПарситьБаланс(Ответ, Результат);

		Если Результат.БалансНизкий <> Ложь Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: idempotent-реплей ({idempotent:true, usage, balance_rub} без content) ->
// БалансРуб всё равно корректно парсится (ПарситьБаланс не зависит от content).
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ПарситьБаланс_IdempotentРеплей_БалансПарсится() Экспорт
	Попытка
		Ответ = Новый Соответствие;
		Ответ.Вставить("idempotent", Истина);
		Ответ.Вставить("balance_rub", 15);

		Результат = ar_LLMAgentRunnerCloud.НовыйРезультат();
		ar_LLMAgentRunnerCloud.ПарситьБаланс(Ответ, Результат);

		Если Результат.БалансРуб <> 15 Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Тест: ar_LLMКонтракт.ВалидироватьОтвет() на структуре без ключей
// БалансРуб/БалансНизкий (эмуляция ответа OpenAI) -> по-прежнему возвращает
// "" -- regression-проверка, что остальные 4 провайдера не ломаются.
//
// Возвращаемое значение:
//   Булево -- Истина при прохождении теста.
//
Функция Тест_ВалидироватьОтвет_БезКлючейБаланса_OpenAIRegression() Экспорт
	Попытка
		ОтветOpenAI = Новый Структура;
		ОтветOpenAI.Вставить("Успех", Истина);
		Сообщение = Новый Структура;
		Сообщение.Вставить("role", "assistant");
		Сообщение.Вставить("content", "hi");
		ОтветOpenAI.Вставить("Сообщение", Сообщение);
		ОтветOpenAI.Вставить("ТокеновВход", 10);
		ОтветOpenAI.Вставить("ТокеновВыход", 5);
		ОтветOpenAI.Вставить("Ошибка", "");
		ОтветOpenAI.Вставить("КодСостояния", 200);
		// Намеренно БЕЗ ключей БалансРуб/БалансНизкий -- как у реального OpenAI.

		ОшибкаВалидации = ar_LLMКонтракт.ВалидироватьОтвет(ОтветOpenAI);

		Если Не ПустаяСтрока(ОшибкаВалидации) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти
