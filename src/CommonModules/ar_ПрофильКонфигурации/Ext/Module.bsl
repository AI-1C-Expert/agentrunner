////////////////////////////////////////////////////////////////////////////////
// Общий модуль ar_ПрофильКонфигурации (UNIV-01).
//
// Единая точка хранения "на чём стоит" расширение AgentRunner: тип/имя/версия
// целевой (не-расширенной) конфигурации + произвольные пары ключ-значение
// профиля (например маппинг реквизитов для будущей UNIV-02). Хранилище -
// РегистрСведений.ar_ПрофильКонфигурации (независимый, непериодический,
// измерение ar_Ключ строкового типа - см. project_empty_ref_dimension_bug).
//
// Публичный интерфейс:
//   ОпределитьКонфигурацию()             - Структура {Имя, Версия, Тип}, не кэшируется.
//   Значение(Ключ, ПоУмолчанию)          - тонкий фасад, делегирует в
//                                          ar_ПрофильКонфигурацииПовтИсп.ЗначениеБезКэша.
//   Установить(Ключ, Значение, Источник) - запись значения профиля.
//   ЗаполнитьАвтоматически()             - автозаполнение служебных +
//                                          (только на БП) предметных ключей.
//
// Кэш: см. отдельный модуль ar_ПрофильКонфигурацииПовтИсп (ReturnValuesReuse =
// НаВремяВызова) и сброс в RecordSetModule.bsl регистра ar_ПрофильКонфигурации
// (ПередЗаписью) - по образцу ar_ПравилаМаскированияПДн (PII-05).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь -
// чтение/запись профиля не требует привилегий (не ПДн и не approval-очередь).
//
// Запрещено: Выполнить(), Вычислить().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Определяет тип/имя/версию целевой (не-расширенной) конфигурации, на которую
// установлено расширение AgentRunner. Классификация - точное (не подстроковое)
// сравнение НРег(Метаданные.Имя) со словарём известных имён. Проверено локально
// только для БП (см. таблицу классификации в UNIV-01.md); имена УТ/ERP/КА/УНФ -
// непроверенные гипотезы, помечены ниже комментарием "ГИПОТЕЗА".
//
// Никогда не выбрасывает исключение - любая внутренняя ошибка перехватывается
// и трактуется как Тип = "Неизвестно" (тот же fail-safe контракт, что у
// ar_ToolDispatcher: "диспетчер не выбрасывает исключений наружу").
//
// Результат не кэшируется на уровне этой функции - дёшева, вызывается редко
// (на старте мастера настройки и в ЗаполнитьАвтоматически()), в отличие от
// Значение(), которая обслуживает каждый tool-вызов.
//
// Возвращаемое значение:
//   Структура - со свойствами:
//     Имя    - Строка - Метаданные.Имя как есть (например "БухгалтерияПредприятия").
//     Версия - Строка - Метаданные.Версия как есть (например "3.0.190.22").
//     Тип    - Строка - одно из "УТ" | "БП" | "ERP" | "КА" | "УНФ" | "Неизвестно".
//
Функция ОпределитьКонфигурацию() Экспорт

	Попытка

		ИмяКонфигурации = Метаданные.Имя;
		ВерсияКонфигурации = Метаданные.Версия;

		Возврат Новый Структура("Имя, Версия, Тип",
			ИмяКонфигурации, ВерсияКонфигурации, ТипКонфигурацииПоИмени(ИмяКонфигурации));

	Исключение
		// Fail-safe: любая внутренняя ошибка (например Метаданные.Версия
		// недоступна в редком сценарии) не должна ронять вызывающий код -
		// тот же контракт, что у ar_ToolDispatcher.
		ar_СлужебныйЛог.Записать(
			"ar_ПрофильКонфигурации.ОпределитьКонфигурацию",
			"determine_configuration_error",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			"Предупреждение");
		Возврат Новый Структура("Имя, Версия, Тип", "", "", "Неизвестно");
	КонецПопытки;

КонецФункции

// Возвращает значение профиля конфигурации по логическому ключу. Тонкий фасад -
// делегирует в ar_ПрофильКонфигурацииПовтИсп.ЗначениеБезКэша, кэширующую на
// время текущего серверного вызова (см. докстринг ar_ПрофильКонфигурацииПовтИсп).
// Не бросает исключений - ошибка чтения регистра трактуется как "запись не
// найдена" (см. ЗначениеБезКэшаПовтИсп ниже).
//
// Параметры:
//   Ключ        - Строка - логический ключ настройки профиля.
//   ПоУмолчанию - Строка - значение, возвращаемое если запись не найдена.
//                 По умолчанию - пустая строка.
//
// Возвращаемое значение:
//   Строка - значение ar_Значение найденной записи, либо ПоУмолчанию.
//
Функция Значение(Знач Ключ, Знач ПоУмолчанию = "") Экспорт

	Результат = ar_ПрофильКонфигурацииПовтИсп.ЗначениеБезКэша(Ключ);

	Если Результат = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Устанавливает (создаёт или перезаписывает) значение профиля конфигурации
// по логическому ключу.
//
// Параметры:
//   Ключ      - Строка - логический ключ настройки профиля.
//   Значение  - Строка - записываемое значение.
//   Источник  - Строка - "auto" | "manual" | "preset". Иное значение
//               отклоняется - трактуется как "manual" (безопасный дефолт),
//               событие фиксируется в ar_СлужебныйЛог. По умолчанию "manual".
//
Процедура Установить(Знач Ключ, Знач Значение, Знач Источник = "manual") Экспорт

	ИсточникПроверенный = Источник;
	Если Не ДопустимыйИсточник(Источник) Тогда
		ТекстПредупрежденияИсточника = СтрШаблон(
			"Недопустимое значение Источник=""%1"" для ключа ""%2"", применён ""manual""",
			Источник, Ключ);
		ar_СлужебныйЛог.Записать(
			"ar_ПрофильКонфигурации.Установить",
			"invalid_source_value",
			ТекстПредупрежденияИсточника,
			"Предупреждение");
		ИсточникПроверенный = "manual";
	КонецЕсли;

	// project_empty_ref_dimension_bug: обязательный канонический порядок -
	// ar_Ключ устанавливается ДО Прочитать() (чтобы Прочитать() нашла нужную
	// запись), а затем ПЕРЕУСТАНАВЛИВАЕТСЯ ПОВТОРНО непосредственно перед
	// Записать(Истина). Это НЕ дублирование по невнимательности:
	// МенеджерЗаписи.Прочитать() для НЕсуществующей записи (первая запись
	// нового ключа) сбрасывает все ранее установленные поля объекта, включая
	// измерения, независимо от их типа - без повторного присваивания запись
	// уйдёт с пустым ar_Ключ, и последующее чтение по этому ключу молча не
	// найдёт запись (тот же класс бага, что и на ссылочном измерении).
	МенеджерЗаписи = РегистрыСведений.ar_ПрофильКонфигурации.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ar_Ключ = Ключ;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.ar_Ключ = Ключ; // Переустановка ОБЯЗАТЕЛЬНА - см. комментарий выше.
	МенеджерЗаписи.ar_Значение = Значение;
	МенеджерЗаписи.ar_Источник = ИсточникПроверенный;
	МенеджерЗаписи.Записать(Истина);

	// Подстраховка на случай, если сброс через RecordSetModule.ПередЗаписью
	// регистра ar_ПрофильКонфигурации по какой-либо причине не сработает
	// (риск 4 UNIV-01.md) - сброс кэша не должен зависеть от единственной
	// точки. ОбновитьПовторноИспользуемыеЗначения() сбрасывает весь кэш
	// ПовтИсп текущего сеанса - безопасно, кэши пересчитаются заново при
	// следующем обращении.
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Автоматически определяет и заполняет профиль конфигурации:
//   1. Всегда пишет 3 служебных ключа "configuration.name"/"configuration.version"/
//      "configuration.type" (Источник = "auto") - независимо от Тип, включая
//      "Неизвестно".
//   2. Только если Тип = "БП" - дополнительно пишет 4 проверенных content-ключа
//      маппинга ("invoice.client_attribute", "invoice.contract_attribute",
//      "invoice.items_table", "invoice.total_attribute"), Источник = "auto".
//      Финальные имена ключей маппинга согласуются с UNIV-02 при её реализации.
//   3. Никакие имена реквизитов УТ/ERP/КА/УНФ не хардкодятся - на любом другом
//      Тип пишутся только служебные ключи.
//   4. Идемпотентна: повторный вызов перезаписывает ключи, которые сама функция
//      пишет, теми же значениями - НЕ дублирует записи (измерение ar_Ключ
//      гарантирует перезапись через Установить()). Ключ с текущим
//      Источник ∈ {"manual","preset"} НЕ перезаписывается - событие
//      "auto_fill_skipped_manual_override" логируется в ar_СлужебныйЛог.
//
Процедура ЗаполнитьАвтоматически() Экспорт

	Конфигурация = ОпределитьКонфигурацию();

	УстановитьЕслиНеРучной("configuration.name", Конфигурация.Имя);
	УстановитьЕслиНеРучной("configuration.version", Конфигурация.Версия);
	УстановитьЕслиНеРучной("configuration.type", Конфигурация.Тип);

	// Предметные content-ключи маппинга - только для проверенной локально БП
	// (3.0.190.22). Имена реквизитов УТ/ERP/КА/УНФ намеренно не хардкодятся -
	// придут профилями через UNIV-04 (см. UNIV-01.md, раздел "ЗаполнитьАвтоматически()").
	Если Конфигурация.Тип = "БП" Тогда
		УстановитьЕслиНеРучной("invoice.client_attribute", "Контрагент");
		УстановитьЕслиНеРучной("invoice.contract_attribute", "ДоговорКонтрагента");
		УстановитьЕслиНеРучной("invoice.items_table", "Товары");
		УстановитьЕслиНеРучной("invoice.total_attribute", "СуммаДокумента");
	КонецЕсли;

КонецПроцедуры

// Внутренняя (без кэша) выборка значения профиля конфигурации по ключу.
// Выполняет обращение к регистру на каждый вызов - не вызывать напрямую в
// обход кэша, используйте публичную Значение() (делегирует в
// ar_ПрофильКонфигурацииПовтИсп). Публичная (Экспорт), т.к. является точкой
// входа для соседнего модуля ar_ПрофильКонфигурацииПовтИсп - не вызывается
// из этого модуля напрямую, кроме собственной обёртки Значение().
//
// Не бросает исключений: ошибка чтения регистра трактуется как "запись не
// найдена" и логируется через ar_СлужебныйЛог с уровнем "Предупреждение".
//
// Параметры:
//   Ключ - Строка - логический ключ настройки профиля.
//
// Возвращаемое значение:
//   Строка, Неопределено - значение ar_Значение найденной записи, либо
//          Неопределено, если запись отсутствует или чтение завершилось ошибкой.
//
Функция ЗначениеБезКэшаПовтИсп(Знач Ключ) Экспорт

	Попытка

		МенеджерЗаписи = РегистрыСведений.ar_ПрофильКонфигурации.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_Ключ = Ключ;
		МенеджерЗаписи.Прочитать();

		Если Не МенеджерЗаписи.Выбран() Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат МенеджерЗаписи.ar_Значение;

	Исключение
		ТекстОшибкиЧтенияЗначения = СтрШаблон("Ошибка чтения профиля по ключу ""%1"": %2",
			Ключ, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ar_СлужебныйЛог.Записать(
			"ar_ПрофильКонфигурации.ЗначениеБезКэшаПовтИсп",
			"profile_value_read_error",
			ТекстОшибкиЧтенияЗначения,
			"Предупреждение");
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Классифицирует имя конфигурации в один из типов "УТ"/"БП"/"ERP"/"КА"/"УНФ"/
// "Неизвестно" точным (не подстроковым) сравнением НРег(ИмяКонфигурации) со
// словарём известных имён. Неверная гипотеза при точном сравнении безопасно
// даёт "Неизвестно", не ложное срабатывание (см. UNIV-01.md, "Обязательное
// архитектурное решение по безопасности гипотез").
//
// Параметры:
//   ИмяКонфигурации - Строка - Метаданные.Имя целевой конфигурации.
//
// Возвращаемое значение:
//   Строка - "УТ" | "БП" | "ERP" | "КА" | "УНФ" | "Неизвестно".
//
Функция ТипКонфигурацииПоИмени(Знач ИмяКонфигурации)

	ИмяВНижнемРегистре = НРег(ИмяКонфигурации);

	// ✅ Проверено локально: /Users/alex/Documents/1C/БП/src/Configuration.xml
	// -> <Name>БухгалтерияПредприятия</Name>, <Version>3.0.190.22</Version>.
	Если ИмяВНижнемРегистре = "бухгалтерияпредприятия" Тогда
		Возврат "БП";
	КонецЕсли;

	// ⚠️ ГИПОТЕЗА, не проверено - см. UNIV-01.md. УТ 11 недоступна ни локально,
	// ни в onemcp - имя выбрано по конвенции 1С (кириллица без пробелов).
	Если ИмяВНижнемРегистре = "управлениеторговлей" Тогда
		Возврат "УТ";
	КонецЕсли;

	// ⚠️ ГИПОТЕЗА, не проверено - см. UNIV-01.md. Наименее надёжная гипотеза -
	// 1С в имени метаданных ERP исторически использует смешанную латиницу/
	// кириллицу ("ERPУправлениеПредприятием" по открытым источникам, без
	// пробелов - Метаданные.Имя не допускает пробелов в принципе).
	Если ИмяВНижнемРегистре = "erpуправлениепредприятием" Тогда
		Возврат "ERP";
	КонецЕсли;

	// ⚠️ ГИПОТЕЗА, не проверено - см. UNIV-01.md.
	Если ИмяВНижнемРегистре = "комплекснаяавтоматизация" Тогда
		Возврат "КА";
	КонецЕсли;

	// ⚠️ ГИПОТЕЗА, не проверено - см. UNIV-01.md.
	Если ИмяВНижнемРегистре = "управлениенашейфирмой" Тогда
		Возврат "УНФ";
	КонецЕсли;

	Возврат "Неизвестно";

КонецФункции

// Проверяет допустимость значения Источник ∈ {"auto", "manual", "preset"}.
//
// Параметры:
//   Источник - Строка - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значение входит в допустимый словарь.
//
Функция ДопустимыйИсточник(Знач Источник)

	Возврат Источник = "auto" Или Источник = "manual" Или Источник = "preset";

КонецФункции

// Записывает значение ключа профиля через Установить(Источник = "auto"), но
// только если текущий Источник этого ключа НЕ входит в {"manual","preset"} -
// корректная трактовка идемпотентности ЗаполнитьАвтоматически() (см. UNIV-01.md):
// повторный вызов не должен разрушать осознанный ручной ввод администратора
// или применённый пресет. Если ключ уже установлен вручную/пресетом - запись
// пропускается, событие "auto_fill_skipped_manual_override" фиксируется в
// ar_СлужебныйЛог.
//
// Параметры:
//   Ключ     - Строка - логический ключ настройки профиля.
//   Значение - Строка - записываемое значение (при Источник = "auto").
//
Процедура УстановитьЕслиНеРучной(Знач Ключ, Знач Значение)

	ТекущийИсточник = ИсточникЗначения(Ключ);

	Если ТекущийИсточник = "manual" Или ТекущийИсточник = "preset" Тогда
		ТекстПропускаАвтозаполнения = СтрШаблон(
			"Ключ ""%1"" не перезаписан автозаполнением - текущий Источник=""%2""",
			Ключ, ТекущийИсточник);
		ar_СлужебныйЛог.Записать(
			"ar_ПрофильКонфигурации.ЗаполнитьАвтоматически",
			"auto_fill_skipped_manual_override",
			ТекстПропускаАвтозаполнения,
			"Информация");
		Возврат;
	КонецЕсли;

	Установить(Ключ, Значение, "auto");

КонецПроцедуры

// Возвращает текущее значение ar_Источник для ключа профиля (без кэша - читает
// регистр напрямую, используется только внутри ЗаполнитьАвтоматически() перед
// принятием решения о перезаписи, вызывается не так часто, как Значение()).
//
// Параметры:
//   Ключ - Строка - логический ключ настройки профиля.
//
// Возвращаемое значение:
//   Строка - значение ar_Источник найденной записи, либо "" если записи нет
//            или чтение завершилось ошибкой (fail-safe: трактуется как "нет
//            ручного значения", позволяя автозаполнению продолжить работу).
//
Функция ИсточникЗначения(Знач Ключ)

	Попытка

		МенеджерЗаписи = РегистрыСведений.ar_ПрофильКонфигурации.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ar_Ключ = Ключ;
		МенеджерЗаписи.Прочитать();

		Если Не МенеджерЗаписи.Выбран() Тогда
			Возврат "";
		КонецЕсли;

		Возврат МенеджерЗаписи.ar_Источник;

	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

