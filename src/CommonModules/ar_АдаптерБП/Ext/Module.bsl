// Общий модуль ar_АдаптерБП (BP Adapter).
//
// UNIV-06: референсная реализация контракта ar_АдаптерЗаполнения для
// конфигурации «1С:Бухгалтерия предприятия» 3.0 (тип «БП»). Конфигурация-
// специфичный код - имена реквизитов документа СчетНаОплатуПокупателю
// (Контрагент, Организация, ВидОперации, СуммаВключаетНДС, Товары и т.д.)
// зашиты как есть, indirection (UNIV-02/ar_МаппингМетаданных) сюда намеренно
// не привносится - адаптер и есть предметный, конфигурация-специфичный код.
//
// Порядок вызовов внутри СоздатьЧерновикСчёта критичен (проверено чтением
// /Users/alex/Documents/1C/БП/src/Documents/СчетНаОплатуПокупателю/Ext/ObjectModule.bsl,
// см. .docs/specs/UNIV-06.md, раздел «Критический предварительный факт»):
//   1. СоздатьДокумент().
//   2. Заполнить(Неопределено) - ДО присвоения прикладных полей: вызывает
//      ОбработкаЗаполнения(Неопределено, Ложь) -> ЗаполнениеДокументов.Заполнить,
//      который проставляет ВидОперации, СуммаВключаетНДС/НДСВключенВСтоимость,
//      ставку НДС, Организацию по умолчанию, БанковскийСчет (+ ВалютаДокумента).
//      Присвоение этих полей ПОСЛЕ шага 3 из адаптера ЗАТИРАЕТ типовой расчёт -
//      прямо запрещено спекой и DoD.
//   3. Присвоение прикладных полей из Payload (Контрагент, опционально
//      Организация, Комментарий).
//   4. Заполнение ТЧ Товары - см. докстринг СоздатьЧерновикСчёта.
//   5. ПроверитьЗаполнение() - обязателен, сообщения собираются через
//      ПолучитьСообщенияПользователю(Истина), чтобы дойти до observation LLM.
//
// АДАПТЕРУ ЗАПРЕЩЕНО вручную вызывать РаботаСКурсамиВалют.ПолучитьКурсВалюты /
// ОтветственныеЛицаБП.УстановитьОтветственныхЛиц «ради полноты DoD» - это код
// процедуры ПриКопировании (копирование существующего документа), а не
// ОбработкаЗаполнения (создание с нуля). Ручное воспроизведение типовой логики
// поверх Заполнить() - ровно то, против чего направлен первоисточник
// (.docs/Ревью-универсальность-тулов.md, Разрыв №3). Решение пользователя
// 2026-07-17 (Р2, .docs/specs/UNIV-06.md): DoD = то, что реально проставляет
// родной механизм, не более.
//
// RECON-01: СоздатьАктСверки реализует второй контракт ar_АдаптерЗаполнения -
// акт сверки взаиморасчётов. Проверено чтением
// /Volumes/T9/1C_DB/3.0.201.16/scr/Documents/АктСверкиВзаиморасчетов/Ext/ObjectModule.bsl
// (ОбработкаЗаполнения, строки 5-65): Документы.АктСверкиВзаиморасчетов.
// СоздатьДокумент() → Заполнить(ДанныеЗаполнения), где ДанныеЗаполнения -
// Структура {Организация, Контрагент, ЗаполнитьПоДаннымОрганизации,
// [СчетаУчетаРасчетов]}. Заполнить() сам вызывает УстановитьПериодСверки
// (следующий период по последнему акту - логика в ManagerModule) и, при
// ЗаполнитьПоДаннымОрганизации=Истина, ЗаполнитьАктСверкиПоДаннымИБ. Период
// АДАПТЕРОМ НЕ ДУБЛИРУЕТСЯ - ручной расчёт периода поверх Заполнить() запрещён
// (см. .docs/specs/RECON-01.md, §4 «Адаптерный метод»).
//
// Свойства модуля: Сервер, без вызова с клиента, Привилегированный = Ложь -
// создание черновика не требует привилегий, работает в правах пользователя
// сессии (RLS должен отработать штатно).
//
// См. спеку: .docs/specs/UNIV-06.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Конфигурации, которые поддерживает этот адаптер (контракт ar_АдаптерЗаполнения).
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ПоддерживаемыеКонфигурации() Экспорт

	Список = Новый Массив;
	Список.Добавить("БП");
	Возврат Список;

КонецФункции

// Логические имена объектов метаданных, без которых этот адаптер не работает
// (контракт ar_АдаптерЗаполнения). Не заменяет и не дублирует по назначению
// Справочник.ar_Tools.ar_ТребуемыеОбъекты (UNIV-03, требования tool в целом) -
// это внутренняя декларация конкретной реализации адаптера, см. .docs/specs/UNIV-06.md,
// раздел «ar_ТребуемыеОбъекты vs ТребуемыеОбъекты() адаптера».
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ТребуемыеОбъекты() Экспорт

	Список = Новый Массив;
	Список.Добавить("СчетНаОплатуПокупателю");
	Список.Добавить("Контрагенты");
	// RECON-01: акт сверки взаиморасчётов (второй контракт адаптера,
	// СоздатьАктСверки) - объект добавлен в общий список требований адаптера,
	// а не выделен в отдельный (см. .docs/specs/RECON-01.md, §4 - «на усмотрение
	// разработчика, но объект должен присутствовать»).
	Список.Добавить("АктСверкиВзаиморасчетов");
	Возврат Список;

КонецФункции

// Создать НЕЗАПИСАННЫЙ черновик документа «Счёт на оплату покупателю» родными
// механизмами БП 3.0 (см. докстринг модуля про порядок вызовов).
//
// Заполнение ТЧ «Товары» - присваиванием построчно (НЕ вызовом
// ОбработкаТабличныхЧастей.ЗаполнитьИзТаблицыНоменклатуры). Причина
// (см. .docs/specs/UNIV-06.md, раздел «Заполнение ТЧ ‘родным механизмом’»):
// реальный родной метод требует данные во временном хранилище (архитектурно
// неудобно для tool, который уже держит позиции разобранным массивом структур
// Payload.items) и имеет непроверенный на этой БД контракт перезаписи цен
// (тело ОбработкаТабличныхЧастей.ЗаполнитьИзТаблицыНоменклатуры не выгружено
// локально, не проиндексировано в onemcp - риск, что метод пересчитывает Цену/
// Сумму из ТипЦен, перезаписывая явно переданную LLM price). Присваивание
// безопаснее для предсказуемости (DoD «документ, эквивалентный созданному
// руками» трактуется по позициям/суммам, не по внутреннему алгоритму
// заполнения) - после присваивания строк вызывается подтверждённый лёгкий
// КлиентСервер-метод РассчитатьСуммуНДСТабЧасти для пересчёта НДС по строке.
//
// Параметры:
//  Payload   - Структура - {client_ref (СправочникСсылка.Контрагенты),
//                          items (Массив структур {nomenclature_ref, quantity,
//                          price, vat_rate}), organization_ref
//                          (СправочникСсылка.Организации, может быть
//                          Неопределено), comment (Строка)} - уже
//                          разыменованные ссылки.
//  Отказ     - Булево    - выходной параметр: Истина при провалившейся
//                          ПроверитьЗаполнение().
//  Сообщения - Массив из Строка - выходной параметр: причины отказа/
//                          предупреждения из ПроверитьЗаполнение().
//
// Возвращаемое значение:
//  ДокументОбъект.СчетНаОплатуПокупателю - заполненный, НЕ ЗАПИСАННЫЙ объект,
//                          при Отказ = Ложь.
//  Неопределено           - при Отказ = Истина.
//
Функция СоздатьЧерновикСчёта(Знач Payload, Отказ, Сообщения) Экспорт

	Отказ = Ложь;
	Если Сообщения = Неопределено Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	// 1. Создать документ.
	Док = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();

	// 2. Дата НЕ проставляется руками - ЗаполнениеДокументов.Заполнить сама
	// проставит НачалоДня(ТекущаяДатаПользователя()), если Дата не заполнена
	// (см. докстринг модуля). Довериться типовому механизму, единообразно с
	// остальными полями.

	// 3. КЛЮЧЕВОЙ ШАГ - типовое заполнение ДО присвоения прикладных полей.
	// Вызывает ОбработкаЗаполнения(Неопределено, Ложь) -> ЗаполнениеДокументов.
	// Заполнить(Док, Неопределено). Безопасно при ДанныеЗаполнения=Неопределено
	// (параметр опционален, ветвление по Тип("Структура") просто пропускается).
	// Именно здесь проставляются ВидОперации, СуммаВключаетНДС/
	// НДСВключенВСтоимость/ДокументБезНДС/НДСНеВыделять, ставка НДС,
	// БанковскийСчет/БанковскийСчетОрганизации (+ ВалютаДокумента через них),
	// Организация (основная по умолчанию, если Payload её не задаёт заранее).
	Док.Заполнить(Неопределено);

	// 4. ПОСЛЕ Заполнить() - присвоение прикладных полей из Payload.
	// ВидОперации/СуммаВключаетНДС НЕ трогаем - уже проставлены шагом 3,
	// присвоение этих полей здесь затёрло бы типовой расчёт (см. докстринг
	// модуля, DoD запрещает это явно).
	Если ЗначениеЗаполнено(Payload.client_ref) Тогда
		Док.Контрагент = Payload.client_ref;
	КонецЕсли;

	ОрганизацияИзPayload = Неопределено;
	Payload.Свойство("organization_ref", ОрганизацияИзPayload);
	Если ОрганизацияИзPayload <> Неопределено И ЗначениеЗаполнено(ОрганизацияИзPayload) Тогда
		// Явное намерение пользователя/LLM важнее дефолта, проставленного
		// шагом 3 (основная организация по умолчанию) - приоритет Payload.
		Док.Организация = ОрганизацияИзPayload;
	КонецЕсли;

	КомментарийИзPayload = "";
	Payload.Свойство("comment", КомментарийИзPayload);
	Если Не ПустаяСтрока(СокрЛП(Строка(КомментарийИзPayload))) Тогда
		Док.Комментарий = СокрЛП(Строка(КомментарийИзPayload));
	КонецЕсли;

	// 5. Заполнение ТЧ Товары - см. докстринг функции про выбор варианта.
	ЗаполнитьТовары(Док, Payload);

	// 6. Проверка заполнения - ОБЯЗАТЕЛЬНА. Вызывает ОбработкаПроверкиЗаполнения
	// документа (зависит от функциональных опций/учётной политики). Сообщения
	// собираются ПОСЛЕ ПроверитьЗаполнение() через ПолучитьСообщенияПользователю,
	// иначе они останутся в буфере сессии и не дойдут до observation LLM.
	Если Не Док.ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		СобратьСообщенияПользователя(Сообщения);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Док;

КонецФункции

// RECON-01: создать НЕЗАПИСАННЫЙ акт сверки взаиморасчётов родными механизмами
// БП 3.0 (см. докстринг модуля про порядок вызовов и источник).
//
// Порядок: СоздатьДокумент() → Заполнить(ДанныеЗаполнения) → ПроверитьЗаполнение().
// ДанныеЗаполнения.ЗаполнитьПоДаннымОрганизации = Истина - включает вызов
// Документы.АктСверкиВзаиморасчетов.ЗаполнитьАктСверкиПоДаннымИБ внутри
// ОбработкаЗаполнения документа (типовой механизм заполнения ТЧ по данным
// бухучёта). Период (ДатаНачала/ДатаОкончания) НЕ проставляется руками -
// УстановитьПериодСверки вызывается изнутри Заполнить() и сама определяет
// «следующий период по последнему акту» (ManagerModule документа).
//
// Параметры:
//  Payload   - Структура - {client_ref (СправочникСсылка.Контрагенты),
//                          organization_ref (СправочникСсылка.Организации,
//                          может быть Неопределено), accounts (Массив из
//                          Строка - коды счетов плана счетов Хозрасчетный,
//                          может быть пустым)}.
//  Отказ     - Булево    - выходной параметр: Истина при провалившейся
//                          ПроверитьЗаполнение().
//  Сообщения - Массив из Строка - выходной параметр: причины отказа/
//                          предупреждения из ПроверитьЗаполнение().
//
// Возвращаемое значение:
//  ДокументОбъект.АктСверкиВзаиморасчетов - заполненный, НЕ ЗАПИСАННЫЙ объект,
//                          при Отказ = Ложь.
//  Неопределено           - при Отказ = Истина.
//
Функция СоздатьАктСверки(Знач Payload, Отказ, Сообщения) Экспорт

	Отказ = Ложь;
	Если Сообщения = Неопределено Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	Если Payload.client_ref = Неопределено Или Не ЗначениеЗаполнено(Payload.client_ref) Тогда
		Отказ = Истина;
		Сообщения.Добавить("client_not_found");
		Возврат Неопределено;
	КонецЕсли;

	// 1. Создать документ.
	Док = Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();

	// 2. ДанныеЗаполнения - контракт родного ОбработкаЗаполнения (см. докстринг
	// функции). СчетаУчетаРасчетов добавляется, только если Payload.accounts
	// непуст - иначе типовой механизм возьмёт стандартный набор счетов расчётов
	// (УчетВзаиморасчетов.ПолучитьТаблицуСчетовУчетаВзаиморасчетов) сам.
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", Payload.organization_ref);
	ДанныеЗаполнения.Вставить("Контрагент", Payload.client_ref);
	ДанныеЗаполнения.Вставить("ЗаполнитьПоДаннымОрганизации", Истина);

	СчетаИзPayload = Неопределено;
	Payload.Свойство("accounts", СчетаИзPayload);
	Если ТипЗнч(СчетаИзPayload) = Тип("Массив") И СчетаИзPayload.Количество() > 0 Тогда
		СчетаССылками = РазыменоватьСчетаУчётаРасчётов(СчетаИзPayload, Сообщения);
		Если СчетаССылками.Количество() > 0 Тогда
			ДанныеЗаполнения.Вставить("СчетаУчетаРасчетов", СчетаССылками);
		КонецЕсли;
	КонецЕсли;

	// 3. КЛЮЧЕВОЙ ШАГ - родное заполнение. Вызывает ОбработкаЗаполнения
	// документа: ЗаполнениеДокументов.Заполнить, УстановитьПериодСверки,
	// (при ЗаполнитьПоДаннымОрганизации=Истина) ЗаполнитьАктСверкиПоДаннымИБ.
	// Период НЕ дублируется - см. докстринг функции.
	Док.Заполнить(ДанныеЗаполнения);

	// 4. Проверка заполнения - ОБЯЗАТЕЛЬНА (тот же паттерн, что и
	// СоздатьЧерновикСчёта: сообщения собираются ПОСЛЕ ПроверитьЗаполнение()).
	Если Не Док.ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		СобратьСообщенияПользователя(Сообщения);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Док;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет ТЧ Товары построчным присваиванием из Payload.items (см. докстринг
// СоздатьЧерновикСчёта про выбор варианта вместо ОбработкаТабличныхЧастей.
// ЗаполнитьИзТаблицыНоменклатуры). После заполнения строки пересчитывает НДС
// подтверждённым лёгким методом ОбработкаТабличныхЧастейКлиентСервер.
// РассчитатьСуммуНДСТабЧасти (КлиентСервер-модуль, без побочных эффектов
// полного механизма ОбработкаТабличныхЧастей).
//
// Параметры:
//  Док     - ДокументОбъект.СчетНаОплатуПокупателю - уже прошедший Заполнить().
//  Payload - Структура - см. СоздатьЧерновикСчёта, поле items.
//
Процедура ЗаполнитьТовары(Док, Знач Payload)

	Позиции = Неопределено;
	Если Не Payload.Свойство("items", Позиции) Или ТипЗнч(Позиции) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Позиция Из Позиции Цикл

		Стр = Док.Товары.Добавить();

		НоменклатураСсылка = Неопределено;
		Если ТипЗнч(Позиция) = Тип("Структура") Тогда
			Позиция.Свойство("nomenclature_ref", НоменклатураСсылка);
		КонецЕсли;
		Если НоменклатураСсылка <> Неопределено И ЗначениеЗаполнено(НоменклатураСсылка) Тогда
			Стр.Номенклатура = НоменклатураСсылка;
		КонецЕсли;

		Количество = 0;
		Позиция.Свойство("quantity", Количество);
		Стр.Количество = Количество;

		Цена = 0;
		Позиция.Свойство("price", Цена);
		Стр.Цена = Цена;

		Стр.Сумма = Количество * Цена;

		// РассчитатьСуммуНДСТабЧасти - подтверждённый лёгкий КлиентСервер-метод
		// (используется в ЗаполнитьИзТаблицыНоменклатуры документа
		// РеализацияТоваровУслуг). Пересчитывает НДС по строке на основании
		// Стр.Сумма/Стр.СтавкаНДС и Док.СуммаВключаетНДС (уже проставлен шагом 3
		// СоздатьЧерновикСчёта типовым Заполнить()).
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СтавкаНДС", Стр.Метаданные()) Тогда
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(Стр, Док.СуммаВключаетНДС);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Собирает сообщения пользователя, накопленные ПроверитьЗаполнение(), в
// выходной массив Сообщения (для observation LLM). Очищает буфер сообщений
// сессии (Истина в ПолучитьСообщенияПользователю).
//
// Параметры:
//  Сообщения - Массив из Строка - мутируется по ссылке (Добавить для каждого
//              накопленного СообщениеПользователю).
//
Процедура СобратьСообщенияПользователя(Сообщения)

	Для Каждого СообщениеПольз Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = СокрЛП(СообщениеПольз.Текст);
		Если Не ПустаяСтрока(Текст) Тогда
			Сообщения.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Если Сообщения.Количество() = 0 Тогда
		Сообщения.Добавить("fill_check_failed");
	КонецЕсли;

КонецПроцедуры

// RECON-01: разыменовывает коды счетов плана счетов Хозрасчетный
// (Payload.accounts, например ["62"]) в массив ПланСчетовСсылка.Хозрасчетный
// для ДанныеЗаполнения.СчетаУчетаРасчетов. Коды, не найденные в плане счетов,
// пропускаются с предупреждением (graceful) - не блокируют создание акта.
//
// Параметры:
//  Коды      - Массив из Строка - коды счетов ("62", "60" и т.п.).
//  Сообщения - Массив из Строка - мутируется по ссылке (Добавить предупреждений
//              "account_code_not_found:<код>").
//
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.Хозрасчетный - только найденные счета.
//
Функция РазыменоватьСчетаУчётаРасчётов(Знач Коды, Сообщения)

	Результат = Новый Массив;

	Для Каждого СыройКод Из Коды Цикл
		Код = СокрЛП(Строка(СыройКод));
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;

		Счёт = Неопределено;
		Попытка
			Счёт = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
		Исключение
			Счёт = Неопределено;
		КонецПопытки;

		Если Счёт = Неопределено Или Не ЗначениеЗаполнено(Счёт) Тогда
			Сообщения.Добавить("account_code_not_found:" + Код);
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Счёт);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
