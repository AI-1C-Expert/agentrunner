////////////////////////////////////////////////////////////////////////////////
// Модуль HTTP-сервиса ar_AgentsAPI (Внешний API -- Агенты).
//
// Реализует REST-endpoint для внешнего запуска агентов.
// Полный URL: https://<хост>/<база>/hs/ar_AgentsAPI/v1/agents/{id}/trigger
//
// Аутентификация двухуровневая:
//   Уровень 1 -- Basic Auth пользователя ИБ (платформа 1С, до входа в обработчик).
//   Уровень 2 -- заголовок X-Agent-Token проверяется через ar_Secrets.
//
// Зависимости: ar_Secrets, ar_RuntimeЗапуск, ar_JSON, ar_AuditСобытия, ar_Утилиты.
//
// Безопасность:
//   * Значение X-Agent-Token в журнал регистрации НЕ пишется.
//   * Заголовок Authorization маскируется через ar_Утилиты.МаскироватьСекреты
//     перед любой записью в лог.
//   * В теле ответа 401/403 -- нет деталей о структуре токена.
//   * Привилегированный режим в этом модуле НЕ устанавливается.
//
// Максимальный размер тела запроса: 64 KB (65 536 байт).
//
// См. спеку: .docs/specs/HTTPS-01.md, Plan §2.7.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиМетодовHTTP

// Обработчик POST /v1/agents/{id}/trigger
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос от платформы.
//
// Возвращаемое значение:
//   HTTPСервисОтвет -- 202 / 400 / 401 / 403 / 404 / 422 / 429 / 500
//
Функция v1_agents_id_trigger_post(Запрос)

	// Шаг 1: Чтение тела и проверка размера.
	ТелоЗапроса = ПрочитатьТелоЗапроса(Запрос);
	Если ТелоЗапроса = Неопределено Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(500,
			"internal_error",
			НСтр("ru = 'Ошибка чтения тела запроса'; en = 'Failed to read request body'"));
	КонецЕсли;

	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(400,
			"empty_body",
			НСтр("ru = 'Тело запроса не может быть пустым'; en = 'Request body must not be empty'"));
	КонецЕсли;

	ПроверкаРазмера = ar_JSON.ПроверитьРазмерАргументов(ТелоЗапроса, МаксРазмерТелаБайт());
	Если Не ПроверкаРазмера.Корректно Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(400,
			"request_too_large",
			НСтр("ru = 'Тело запроса превышает допустимый размер 64 KB'; en = 'Request body exceeds the 64 KB limit'"));
	КонецЕсли;

	// Шаг 2: Поиск агента по id и получение его данных одним запросом.
	СтрокаId = Запрос.ПараметрыURL["id"];
	ДанныеАгента = НайтиАгентаСДанными(СтрокаId);
	Если ДанныеАгента = Неопределено Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(404,
			"agent_not_found",
			НСтр("ru = 'Агент не найден'; en = 'Agent not found'"));
	КонецЕсли;
	АгентСсылка = ДанныеАгента.Ссылка;

	// Шаг 3: Десериализация тела запроса.
	ДанныеЗапроса = ar_JSON.ИзJSON(ТелоЗапроса);
	Если ДанныеЗапроса = Неопределено Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(400,
			"invalid_json",
			НСтр("ru = 'Тело запроса содержит невалидный JSON'; en = 'Request body contains invalid JSON'"));
	КонецЕсли;

	Если ТипЗнч(ДанныеЗапроса) <> Тип("Соответствие") Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(400,
			"invalid_body",
			НСтр("ru = 'Тело запроса должно быть JSON-объектом'; en = 'Request body must be a JSON object'"));
	КонецЕсли;

	// Проверка обязательного поля input.
	ВводПользователя = ДанныеЗапроса.Получить("input");
	Если ВводПользователя = Неопределено
		Или ТипЗнч(ВводПользователя) <> Тип("Строка")
		Или ПустаяСтрока(ВводПользователя) Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(400,
			"missing_required_field",
			НСтр("ru = 'Обязательное поле input отсутствует или пустое'; en = 'Required field input is missing or empty'"));
	КонецЕсли;

	// Шаг 4: Проверка X-Agent-Token с использованием ТокенИдентификатора из шага 2.
	РезультатТокена = ar_HTTPСервисПомощник.ПроверитьТокенАгента(ДанныеАгента.ТокенИдентификатор, Запрос);
	Если Не РезультатТокена.Успех Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(401,
			РезультатТокена.КодОшибки,
			НСтр("ru = 'Неверный или отсутствующий X-Agent-Token'; en = 'Invalid or missing X-Agent-Token'"));
	КонецЕсли;

	// Шаг 5: Проверка активности агента и наличия провайдера.
	Если Не ДанныеАгента.Активен Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(403,
			"agent_inactive",
			НСтр("ru = 'Агент неактивен'; en = 'Agent is inactive'"));
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДанныеАгента.LLMПровайдер) Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(422,
			"no_llm_provider",
			НСтр("ru = 'У агента не задан LLM-провайдер'; en = 'Agent has no LLM provider configured'"));
	КонецЕсли;

	// Шаг 6: Сборка контекста триггера и запуск агента.
	КонтекстТриггера = СобратьКонтекстТриггера(ДанныеЗапроса, ВводПользователя);

	РезультатЗапуска = ВыполнитьЗапуск(АгентСсылка, КонтекстТриггера, Запрос);
	Если ТипЗнч(РезультатЗапуска) = Тип("HTTPСервисОтвет") Тогда
		// ВыполнитьЗапуск вернул ответ ошибки или дубля.
		Возврат РезультатЗапуска;
	КонецЕсли;

	// Шаг 7: Запись audit-события (не блокирует успешный ответ).
	AuditPayload = Новый Структура;
	AuditPayload.Вставить("agent_id", Строка(АгентСсылка.УникальныйИдентификатор()));
	AuditPayload.Вставить("run_id", РезультатЗапуска.RunId);
	AuditPayload.Вставить("trigger", "webhook");
	AuditPayload.Вставить("dry_run", КонтекстТриггера.DryRun);
	ЗафиксироватьAuditWebhook(РезультатЗапуска.RunId, AuditPayload, Запрос);

	// Шаг 8: Формирование ответа 202.
	ОтветТело = Новый Структура;
	ОтветТело.Вставить("run_id", РезультатЗапуска.RunId);
	ОтветТело.Вставить("status", "started");
	ОтветТело.Вставить("agent_id", Строка(АгентСсылка.УникальныйИдентификатор()));
	ОтветТело.Вставить("started_at",
		Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));

	Возврат ar_HTTPСервисПомощник.СформироватьОтветJSON(202, ОтветТело);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Максимально допустимый размер тела запроса: 64 KB.
//
// Возвращаемое значение:
//   Число -- максимальный размер в байтах.
//
Функция МаксРазмерТелаБайт()
	Возврат 65536; // 64 KB
КонецФункции

// Прочитать тело входящего HTTP-запроса как строку.
// При ошибке чтения записывает в журнал и возвращает Неопределено.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий запрос.
//
// Возвращаемое значение:
//   Строка -- тело запроса;
//   Неопределено -- при ошибке чтения.
//
Функция ПрочитатьТелоЗапроса(Знач Запрос)
	Попытка
		Возврат Запрос.ПолучитьТелоКакСтроку();
	Исключение
		ЗаписатьВЖурнал(
			НСтр("ru = 'Ошибка чтения тела запроса'; en = 'Request body read error'"),
			ИнформацияОбОшибке(), Запрос);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Найти агента по строковому id и вернуть его данные одним запросом.
// Объединяет поиск и получение атрибутов, исключая избыточные обращения к БД.
// При невалидном UUID-формате или если агент не найден возвращает Неопределено (-> 404).
//
// Параметры:
//   СтрокаId - Строка - строковое представление UUID из URL.
//
// Возвращаемое значение:
//   Структура -- {Ссылка, Активен: Булево, LLMПровайдер: Ссылка, ТокенИдентификатор: Строка};
//   Неопределено -- если UUID невалиден или агент не найден / помечен на удаление.
//
Функция НайтиАгентаСДанными(Знач СтрокаId)

	Если ТипЗнч(СтрокаId) <> Тип("Строка") Или ПустаяСтрока(СтрокаId) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УИ = Неопределено;
	Попытка
		УИ = Новый УникальныйИдентификатор(СтрокаId);
	Исключение
		// Невалидный UUID-формат -- не раскрываем причину, возвращаем 404.
		Возврат Неопределено;
	КонецПопытки;

	АгентСсылка = Справочники.ar_Агенты.ПолучитьСсылку(УИ);
	Если Не ЗначениеЗаполнено(АгентСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Один запрос: существование + все нужные реквизиты (std487 -- без "ленивой" загрузки).
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Агенты.Ссылка КАК Ссылка,
		|	Агенты.ar_Активен КАК Активен,
		|	Агенты.ar_LLMПровайдер КАК LLMПровайдер,
		|	Агенты.ar_ТокенИдентификатор КАК ТокенИдентификатор
		|ИЗ
		|	Справочник.ar_Агенты КАК Агенты
		|ГДЕ
		|	Агенты.Ссылка = &Ссылка
		|	И Агенты.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Ссылка", АгентСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Ссылка", Выборка.Ссылка);
	Данные.Вставить("Активен", Выборка.Активен = Истина);
	Данные.Вставить("LLMПровайдер", Выборка.LLMПровайдер);
	Данные.Вставить("ТокенИдентификатор", Строка(Выборка.ТокенИдентификатор));
	Возврат Данные;

КонецФункции

// Собрать структуру контекста триггера из данных запроса.
//
// Параметры:
//   ДанныеЗапроса    - Соответствие - десериализованное тело запроса.
//   ВводПользователя - Строка       - значение поля "input".
//
// Возвращаемое значение:
//   Структура -- {Триггер, Input, AnchorRef, DryRun, Metadata}.
//
Функция СобратьКонтекстТриггера(Знач ДанныеЗапроса, Знач ВводПользователя)

	AnchorRef = "";
	ЗначениеAnchorRef = ДанныеЗапроса.Получить("anchor_ref");
	Если ТипЗнч(ЗначениеAnchorRef) = Тип("Строка") Тогда
		AnchorRef = ЗначениеAnchorRef;
	КонецЕсли;

	ЗначениеDryRun = ДанныеЗапроса.Получить("dry_run");
	DryRun = (ЗначениеDryRun = Истина);

	Метаданные = ДанныеЗапроса.Получить("metadata");
	Если ТипЗнч(Метаданные) <> Тип("Соответствие") Тогда
		Метаданные = Новый Соответствие;
	КонецЕсли;

	КонтекстТриггера = Новый Структура;
	КонтекстТриггера.Вставить("Триггер", "webhook");
	КонтекстТриггера.Вставить("Input", ВводПользователя);
	КонтекстТриггера.Вставить("AnchorRef", AnchorRef);
	КонтекстТриггера.Вставить("DryRun", DryRun);
	КонтекстТриггера.Вставить("Metadata", Метаданные);
	Возврат КонтекстТриггера;

КонецФункции

// Выполнить запуск агента в фоне.
// При дубликате или ошибке запуска возвращает HTTPСервисОтвет (ответ-ошибка или дубль).
// При успехе возвращает Структуру результата запуска {Успех, RunId, Причина}.
//
// Параметры:
//   АгентСсылка      - СправочникСсылка.ar_Агенты - ссылка на агента.
//   КонтекстТриггера - Структура - контекст запуска агента.
//   Запрос           - HTTPСервисЗапрос - для логирования ошибок.
//
// Возвращаемое значение:
//   HTTPСервисОтвет -- если запуск не удался (ошибка или дубль);
//   Структура       -- результат {Успех, RunId, Причина} при успешном запуске.
//
Функция ВыполнитьЗапуск(Знач АгентСсылка, Знач КонтекстТриггера, Знач Запрос)

	РезультатЗапуска = Неопределено;
	Попытка
		РезультатЗапуска = ar_RuntimeЗапуск.СтартоватьВФоне(АгентСсылка, КонтекстТриггера);
	Исключение
		ЗаписатьВЖурнал(
			НСтр("ru = 'Ошибка вызова СтартоватьВФоне'; en = 'Error calling СтартоватьВФоне'"),
			ИнформацияОбОшибке(), Запрос);
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(500,
			"start_failed",
			НСтр("ru = 'Ошибка при запуске агента'; en = 'Failed to start the agent'"));
	КонецПопытки;

	Если РезультатЗапуска = Неопределено Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(500,
			"start_failed",
			НСтр("ru = 'Нет ответа от модуля запуска'; en = 'No response from launch module'"));
	КонецЕсли;

	// Случай "агент уже выполняется": дедупликация по ключу.
	Если Не РезультатЗапуска.Успех И РезультатЗапуска.Причина = "duplicate_run" Тогда
		ОтветДубль = Новый Структура;
		ОтветДубль.Вставить("run_id", РезультатЗапуска.RunId);
		ОтветДубль.Вставить("status", "already_running");
		ОтветДубль.Вставить("agent_id", Строка(АгентСсылка.УникальныйИдентификатор()));
		ОтветДубль.Вставить("started_at",
			Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		Возврат ar_HTTPСервисПомощник.СформироватьОтветJSON(202, ОтветДубль);
	КонецЕсли;

	Если Не РезультатЗапуска.Успех Тогда
		КодОшибки = ?(РезультатЗапуска.Причина = "background_jobs_unavailable",
			"background_jobs_unavailable", "start_failed");
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(500,
			КодОшибки,
			НСтр("ru = 'Не удалось запустить агента'; en = 'Failed to start the agent'"));
	КонецЕсли;

	Возврат РезультатЗапуска;

КонецФункции

// Зафиксировать audit-событие webhook_trigger_accepted.
// Не пробрасывает исключения -- audit не должен блокировать успешный ответ.
//
// Параметры:
//   RunId        - Строка      - идентификатор запуска.
//   AuditPayload - Структура   - данные события.
//   Запрос       - HTTPСервисЗапрос - для логирования при ошибке audit.
//
Процедура ЗафиксироватьAuditWebhook(Знач RunId, Знач AuditPayload, Знач Запрос)
	Попытка
		ar_AuditЗащищённыйРежим.ЗаписатьСобытиеПривилегированно(RunId, "webhook_trigger_accepted", AuditPayload);
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ЗаписатьВЖурнал(
			НСтр("ru = 'Ошибка записи audit webhook_trigger_accepted';"
				+ " en = 'Failed to write audit event webhook_trigger_accepted'"),
			ИнфоОбОшибке, Запрос);
	КонецПопытки;
КонецПроцедуры

// Записать ошибку в журнал регистрации с маскировкой данных запроса.
// Значение X-Agent-Token намеренно не включается в сообщение.
//
// Параметры:
//   Сообщение    - Строка            - краткое описание ошибки.
//   ИнфоОбОшибке - ИнформацияОбОшибке - информация об исключении.
//   Запрос       - HTTPСервисЗапрос  - для маскировки заголовка Authorization.
//
Процедура ЗаписатьВЖурнал(Знач Сообщение, Знач ИнфоОбОшибке, Знач Запрос = Неопределено)

	ТекстОшибки = "";
	Попытка
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(ТекстОшибки);
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось получить текст ошибки'; en = 'Could not get error text'");
	КонецПопытки;

	// Маскируем заголовок Authorization перед записью в журнал.
	КонтекстЗапроса = "";
	Если Запрос <> Неопределено Тогда
		Попытка
			AuthHeader = Запрос.Заголовки["Authorization"];
			Если ЗначениеЗаполнено(AuthHeader) Тогда
				// Маскируем само значение заголовка (Base64-строку Basic Auth).
				КонтекстЗапроса = "Authorization: " + ar_Утилиты.МаскироватьСекреты(AuthHeader);
			КонецЕсли;
		Исключение
			// Не можем прочитать заголовок -- продолжаем логирование без него.
			КонтекстЗапроса = "";
		КонецПопытки;
	КонецЕсли;

	ПолноеСообщение = Сообщение;
	Если Не ПустаяСтрока(КонтекстЗапроса) Тогда
		ПолноеСообщение = ПолноеСообщение + Символы.ПС + КонтекстЗапроса;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПолноеСообщение = ПолноеСообщение + Символы.ПС + ТекстОшибки;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ar_AgentsAPI'; en = 'ar_AgentsAPI'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ПолноеСообщение);

КонецПроцедуры

