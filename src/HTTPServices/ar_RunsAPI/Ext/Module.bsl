// Модуль HTTP-сервиса ar_RunsAPI (Внешний API -- Запуски).
//
// Реализует два read-only REST-endpoint:
//   GET /v1/runs/{id}         -- сводка запуска из регистра ar_Запуски
//   GET /v1/runs/{id}/events  -- список событий из регистра ar_СобытияЗапуска
//
// Полный URL: https://<хост>/<база>/hs/ar_RunsAPI/v1/runs/{id}[/events]
//
// Аутентификация двухуровневая:
//   Уровень 1 -- Basic Auth пользователя ИБ (платформа 1С, до входа в обработчик).
//   Уровень 2 -- заголовок X-Agent-Token; сравнивается со значением из ar_Secrets.
//
// Зависимости: ar_Secrets, ar_JSON, ar_Утилиты.
//
// Безопасность:
//   * Значение X-Agent-Token в журнал регистрации НЕ пишется.
//   * StateSnapshot (бинарное поле) НЕ включается в ответ.
//   * Привилегированный режим в этом модуле НЕ устанавливается.
//   * Оба эндпоинта read-only -- блокировки не нужны.
//
// Порядок проверок:
//   1. Найти запуск по id (если нет -> 404).
//   2. Проверить X-Agent-Token (если неверный -> 401).
//   3. Вернуть данные -> 200.
// Такой порядок не раскрывает факт существования токена,
// раскрывает только факт несуществования run_id.
//
// Параметры пагинации events:
//   limit    -- макс. число записей в ответе (дефолт 100, макс 500).
//   after_seq -- возвращать события с Sequence > after_seq (дефолт 0).
//
// Конвертация дат: платформа 1С хранит даты в локальном времени сервера.
// Для ISO 8601 с Z-суффиксом применяем УниверсальноеВремя(Дата).
//
// Магические числа HTTP-кодов (задокументированы здесь для соответствия MagicNumber):
//   200 = OK; 401 = Unauthorized; 404 = Not Found; 422 = Unprocessable Entity; 500 = Internal Server Error
//
// См. спеку: .docs/specs/HTTPS-02.md, Plan §2.7.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиМетодовHTTP

// Обработчик GET /v1/runs/{id}
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос от платформы.
//
// Возвращаемое значение:
//   HTTPСервисОтвет -- 200 / 401 / 404 / 500
//
Функция v1_runs_id_get(Запрос)

	// Шаг 1: Получить и нормализовать RunId из URL.
	СтрокаId = СтрокаRunId(Запрос.ПараметрыURL["id"]);
	Если ПустаяСтрока(СтрокаId) Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(404,
			"run_not_found",
			НСтр("ru = 'Запуск не найден'; en = 'Run not found'"));
	КонецЕсли;

	// Шаг 2: Читать запись из регистра. Если нет -- 404.
	ДанныеЗапуска = ПолучитьДанныеЗапуска(СтрокаId);
	Если ДанныеЗапуска = Неопределено Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(404,
			"run_not_found",
			НСтр("ru = 'Запуск не найден'; en = 'Run not found'"));
	КонецЕсли;

	// Шаг 3: Проверить X-Agent-Token.
	РезультатТокена = ar_HTTPСервисПомощник.ПроверитьТокенАгента(ДанныеЗапуска.ТокенИдентификатор, Запрос);
	Если Не РезультатТокена.Успех Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(401,
			РезультатТокена.КодОшибки,
			НСтр("ru = 'Неверный или отсутствующий X-Agent-Token'; en = 'Invalid or missing X-Agent-Token'"));
	КонецЕсли;

	// Шаг 4: Сериализовать и вернуть 200.
	ОтветТело = Новый Структура;
	ОтветТело.Вставить("run_id",         ДанныеЗапуска.RunId);
	ОтветТело.Вставить("agent_id",       ДанныеЗапуска.AgentId);
	ОтветТело.Вставить("status",         ДанныеЗапуска.Статус);
	ОтветТело.Вставить("trigger",        ДанныеЗапуска.Триггер);
	ОтветТело.Вставить("started_at",     ДанныеЗапуска.СтартовалВ);
	ОтветТело.Вставить("finished_at",    ДанныеЗапуска.ЗавершенВ);
	ОтветТело.Вставить("steps_total",    ДанныеЗапуска.ШаговВсего);
	ОтветТело.Вставить("tokens_in",      ДанныеЗапуска.ТокеновВход);
	ОтветТело.Вставить("tokens_out",     ДанныеЗапуска.ТокеновВыход);
	ОтветТело.Вставить("cost_rub",       ДанныеЗапуска.СтоимостьРуб);
	ОтветТело.Вставить("last_heartbeat", ДанныеЗапуска.LastHeartbeat);
	ОтветТело.Вставить("parent_run_id",  ДанныеЗапуска.РодительскийRunId);

	Возврат ar_HTTPСервисПомощник.СформироватьОтветJSON(200, ОтветТело);

КонецФункции

// Обработчик GET /v1/runs/{id}/events
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос от платформы.
//
// Возвращаемое значение:
//   HTTPСервисОтвет -- 200 / 401 / 404 / 422 / 500
//
Функция v1_runs_id_events_get(Запрос)

	// Шаг 1: RunId из URL.
	СтрокаId = СтрокаRunId(Запрос.ПараметрыURL["id"]);
	Если ПустаяСтрока(СтрокаId) Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(404,
			"run_not_found",
			НСтр("ru = 'Запуск не найден'; en = 'Run not found'"));
	КонецЕсли;

	// Шаг 2: Параметры пагинации.
	ПараметрыСтраницы = РазобратьПараметрыПагинации(Запрос);
	Если ПараметрыСтраницы.Ошибка Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(422,
			ПараметрыСтраницы.КодОшибки,
			ПараметрыСтраницы.Сообщение);
	КонецЕсли;
	Лимит    = ПараметрыСтраницы.Лимит;
	AfterSeq = ПараметрыСтраницы.AfterSeq;

	// Шаг 3: Проверить существование RunId.
	ДанныеЗапуска = ПолучитьДанныеЗапуска(СтрокаId);
	Если ДанныеЗапуска = Неопределено Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(404,
			"run_not_found",
			НСтр("ru = 'Запуск не найден'; en = 'Run not found'"));
	КонецЕсли;

	// Шаг 4: Проверить X-Agent-Token.
	РезультатТокена = ar_HTTPСервисПомощник.ПроверитьТокенАгента(ДанныеЗапуска.ТокенИдентификатор, Запрос);
	Если Не РезультатТокена.Успех Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(401,
			РезультатТокена.КодОшибки,
			НСтр("ru = 'Неверный или отсутствующий X-Agent-Token'; en = 'Invalid or missing X-Agent-Token'"));
	КонецЕсли;

	// Шаг 5: Читать события с пагинацией.
	РезультатСобытий = ПолучитьСобытияЗапуска(СтрокаId, Лимит, AfterSeq);
	Если РезультатСобытий.Ошибка Тогда
		Возврат ar_HTTPСервисПомощник.СформироватьОтветОшибки(500,
			"internal_error",
			НСтр("ru = 'Внутренняя ошибка при чтении событий'; en = 'Internal error reading events'"));
	КонецЕсли;

	// Шаг 6: Сформировать ответ.
	ОтветТело = Новый Структура;
	ОтветТело.Вставить("run_id",         СтрокаId);
	ОтветТело.Вставить("events",         РезультатСобытий.События);
	ОтветТело.Вставить("has_more",       РезультатСобытий.ЕстьЕще);
	ОтветТело.Вставить("next_after_seq", РезультатСобытий.ПоследнийSeq);
	Если РезультатСобытий.Усечено Тогда
		ОтветТело.Вставить("truncated", Истина);
	КонецЕсли;

	Возврат ar_HTTPСервисПомощник.СформироватьОтветJSON(200, ОтветТело);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нормализовать RunId к строке нижнего регистра (UUID без скобок).
//
// Параметры:
//   RunId - Произвольный - значение из ПараметрыURL["id"].
//
// Возвращаемое значение:
//   Строка -- нормализованный UUID или пустая строка при ошибке.
//
Функция СтрокаRunId(Знач RunId)
	Если ТипЗнч(RunId) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат НРег(СокрЛП(RunId));
КонецФункции

// Разобрать параметры пагинации из строки запроса.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий запрос.
//
// Возвращаемое значение:
//   Структура -- {Ошибка: Булево, КодОшибки: Строка, Сообщение: Строка, Лимит: Число, AfterSeq: Число}.
//
Функция РазобратьПараметрыПагинации(Знач Запрос)

	Рез = Новый Структура;
	Рез.Вставить("Ошибка",    Ложь);
	Рез.Вставить("КодОшибки", "");
	Рез.Вставить("Сообщение", "");
	Рез.Вставить("Лимит",     100);
	Рез.Вставить("AfterSeq",  0);

	ПараметрLimit    = Запрос.ПараметрыЗапроса["limit"];
	ПараметрAfterSeq = Запрос.ПараметрыЗапроса["after_seq"];

	Если ПараметрLimit <> Неопределено И Не ПустаяСтрока(ПараметрLimit) Тогда
		Если Не ЭтоЦелоеНеотрицательноеЧисло(ПараметрLimit) Тогда
			Рез.Ошибка    = Истина;
			Рез.КодОшибки = "invalid_parameter";
			Рез.Сообщение = НСтр("ru = 'Параметр limit должен быть числом'; en = 'Parameter limit must be a number'");
			Возврат Рез;
		КонецЕсли;
		Рез.Лимит = Число(ПараметрLimit);
		Если Рез.Лимит > 500 Тогда
			Рез.Ошибка    = Истина;
			Рез.КодОшибки = "limit_too_large";
			Рез.Сообщение = НСтр("ru = 'Параметр limit не может превышать 500'; en = 'Parameter limit cannot exceed 500'");
			Возврат Рез;
		КонецЕсли;
		Если Рез.Лимит < 1 Тогда
			Рез.Лимит = 1;
		КонецЕсли;
	КонецЕсли;

	Если ПараметрAfterSeq <> Неопределено И Не ПустаяСтрока(ПараметрAfterSeq) Тогда
		Если Не ЭтоЦелоеНеотрицательноеЧисло(ПараметрAfterSeq) Тогда
			Рез.Ошибка    = Истина;
			Рез.КодОшибки = "invalid_parameter";
			Рез.Сообщение = НСтр("ru = 'Параметр after_seq должен быть числом'; en = 'Parameter after_seq must be a number'");
			Возврат Рез;
		КонецЕсли;
		Рез.AfterSeq = Число(ПараметрAfterSeq);
	КонецЕсли;

	Возврат Рез;

КонецФункции

// Проверить, является ли строка целым неотрицательным числом.
//
// Параметры:
//   Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//   Булево -- Истина если строка содержит целое неотрицательное число (без знака минус и точки).
//
Функция ЭтоЦелоеНеотрицательноеЧисло(Знач Значение)
	СтрЗначение = СокрЛП(Значение);
	Если СтрДлина(СтрЗначение) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрДлина(СтрЗаменить(СтрЗначение, "0123456789", "")) = 0;
КонецФункции

// Найти запись в регистре ar_Запуски по RunId.
//
// Параметры:
//   СтрокаId - Строка - строковый UUID запуска.
//
// Возвращаемое значение:
//   Структура -- данные запуска:
//     {RunId, AgentId, ТокенИдентификатор, Статус, Триггер, СтартовалВ,
//      ЗавершенВ, ШаговВсего, ТокеновВход, ТокеновВыход, СтоимостьРуб,
//      LastHeartbeat, РодительскийRunId};
//   Неопределено -- если запись не найдена или id невалиден.
//
// Примечание: AgentId и ТокенИдентификатор получаются JOIN'ом с ar_Агенты
// в одном запросе, чтобы избежать lazy-load через точку.
//
Функция ПолучитьДанныеЗапуска(Знач СтрокаId)

	Если ТипЗнч(СтрокаId) <> Тип("Строка") Или ПустаяСтрока(СтрокаId) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.ar_RunId               КАК RunId,
		|	Запуски.ar_Статус              КАК Статус,
		|	Запуски.ar_Триггер             КАК Триггер,
		|	Запуски.ar_СтартовалВ          КАК СтартовалВ,
		|	Запуски.ar_ЗавершенВ           КАК ЗавершенВ,
		|	Запуски.ar_ШаговВсего          КАК ШаговВсего,
		|	Запуски.ar_ТокеновВход         КАК ТокеновВход,
		|	Запуски.ar_ТокеновВыход        КАК ТокеновВыход,
		|	Запуски.ar_СтоимостьРуб        КАК СтоимостьРуб,
		|	Запуски.ar_LastHeartbeat       КАК LastHeartbeat,
		|	Запуски.ar_РодительскийRunId   КАК РодительскийRunId,
		|	Агенты.Ссылка                   КАК АгентСсылка,
		|	Агенты.ar_ТокенИдентификатор   КАК ТокенИдентификатор
		|ИЗ
		|	РегистрСведений.ar_Запуски КАК Запуски
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ar_Агенты КАК Агенты
		|		ПО Запуски.ar_АгентРеф = Агенты.Ссылка
		|ГДЕ
		|	Запуски.ar_RunId = &RunId";
	Запрос.УстановитьПараметр("RunId", СтрокаId);

	Выборка = Неопределено;
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписатьВЖурнал(
			НСтр("ru = 'Ошибка чтения регистра ar_Запуски'; en = 'Error reading register ar_Запуски'"),
			ИнформацияОбОшибке(), Неопределено);
		Возврат Неопределено;
	КонецПопытки;

	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Получаем UUID агента из ссылки в BSL (не через точку в запросе -- RefOveruse).
	AgentId      = Неопределено;
	АгентСсылка  = Выборка.АгентСсылка;
	Если ЗначениеЗаполнено(АгентСсылка) Тогда
		AgentId = НРег(Строка(АгентСсылка.УникальныйИдентификатор()));
	КонецЕсли;

	// Статус -- строковое представление значения перечисления.
	СтатусСтр = "";
	Попытка
		СтатусСтр = Строка(Выборка.Статус);
	Исключение
		СтатусСтр = "";
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("RunId",              Выборка.RunId);
	Данные.Вставить("AgentId",            AgentId);
	Данные.Вставить("ТокенИдентификатор", Строка(Выборка.ТокенИдентификатор));
	Данные.Вставить("Статус",            СтатусСтр);
	Данные.Вставить("Триггер",           Выборка.Триггер);
	Данные.Вставить("СтартовалВ",        ФорматДатыISO8601НулиПустая(Выборка.СтартовалВ));
	Данные.Вставить("ЗавершенВ",         ФорматДатыISO8601НулиПустая(Выборка.ЗавершенВ));
	Данные.Вставить("ШаговВсего",        Выборка.ШаговВсего);
	Данные.Вставить("ТокеновВход",       Выборка.ТокеновВход);
	Данные.Вставить("ТокеновВыход",      Выборка.ТокеновВыход);
	Данные.Вставить("СтоимостьРуб",      Выборка.СтоимостьРуб);
	Данные.Вставить("LastHeartbeat",     ФорматДатыISO8601НулиПустая(Выборка.LastHeartbeat));
	Данные.Вставить("РодительскийRunId", ?(ПустаяСтрока(Выборка.РодительскийRunId), Неопределено, Выборка.РодительскийRunId));
	Возврат Данные;

КонецФункции

// Получить события запуска из регистра ar_СобытияЗапуска.
//
// Параметры:
//   СтрокаId - Строка - UUID запуска.
//   Лимит    - Число  - максимальное количество событий.
//   AfterSeq - Число  - возвращать события с Sequence > AfterSeq.
//
// Возвращаемое значение:
//   Структура -- {Ошибка: Булево, События: Массив, ЕстьЕще: Булево, ПоследнийSeq: Число, Усечено: Булево}.
//
Функция ПолучитьСобытияЗапуска(Знач СтрокаId, Знач Лимит, Знач AfterSeq)

	Рез = Новый Структура;
	Рез.Вставить("Ошибка",       Ложь);
	Рез.Вставить("События",      Новый Массив);
	Рез.Вставить("ЕстьЕще",      Ложь);
	Рез.Вставить("ПоследнийSeq", AfterSeq);
	Рез.Вставить("Усечено",      Ложь);

	ЛимитЗапроса = Лимит + 1;
	Запрос1С = Новый Запрос;
	Запрос1С.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(ЛимитЗапроса, "ЧГ=0") + "
		|	События.ar_Sequence      КАК Sequence,
		|	События.ar_МоментВремени КАК МоментВремени,
		|	События.ar_ТипСобытия    КАК ТипСобытия,
		|	События.ar_PayloadJSON   КАК PayloadJSON
		|ИЗ
		|	РегистрСведений.ar_СобытияЗапуска КАК События
		|ГДЕ
		|	События.ar_RunId     = &RunId
		|	И События.ar_Sequence > &AfterSeq
		|УПОРЯДОЧИТЬ ПО
		|	События.ar_Sequence ВОЗР";
	Запрос1С.УстановитьПараметр("RunId",    СтрокаId);
	Запрос1С.УстановитьПараметр("AfterSeq", AfterSeq);

	Попытка
		РезультатЗапроса = Запрос1С.Выполнить();
	Исключение
		ЗаписатьВЖурнал(
			НСтр("ru = 'Ошибка чтения событий запуска'; en = 'Error reading run events'"),
			ИнформацияОбОшибке(), Неопределено);
		Рез.Ошибка = Истина;
		Возврат Рез;
	КонецПопытки;

	Выборка        = РезультатЗапроса.Выбрать();
	НомерЗаписи    = 0;
	ОбщийРазмер    = 0;
	МаксРазмерБайт = 4194304; // 4 MB

	Пока Выборка.Следующий() Цикл
		НомерЗаписи = НомерЗаписи + 1;
		Если НомерЗаписи > Лимит Тогда
			// Получили лишнюю запись -- подтверждает наличие следующей страницы.
			Рез.ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;

		СобытиеСтр = СобытиеВСтруктуру(Выборка);
		Рез.События.Добавить(СобытиеСтр);
		Рез.ПоследнийSeq = Выборка.Sequence;

		// Проверка общего размера ответа (4 MB), оценка по длине строки payload.
		ОбщийРазмер = ОбщийРазмер + СтрДлина(Выборка.PayloadJSON) * 2;
		Если ОбщийРазмер > МаксРазмерБайт Тогда
			Рез.Усечено = Истина;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Рез;

КонецФункции

// Преобразовать строку выборки события в структуру для JSON-ответа.
//
// Параметры:
//   Выборка - РезультатЗапросаВыборка - строка с полями события.
//
// Возвращаемое значение:
//   Структура -- {seq, occurred_at, event_type, payload}.
//
Функция СобытиеВСтруктуру(Знач Выборка)

	ТипСобытияСтр = "";
	Попытка
		ТипСобытияСтр = Строка(Выборка.ТипСобытия);
	Исключение
		ТипСобытияСтр = "";
	КонецПопытки;

	ПолезнаяНагрузка = Новый Соответствие;
	Если Не ПустаяСтрока(Выборка.PayloadJSON) Тогда
		Попытка
			РезультатJSON = ar_JSON.ИзJSON(Выборка.PayloadJSON);
			Если РезультатJSON <> Неопределено Тогда
				ПолезнаяНагрузка = РезультатJSON;
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал(
				НСтр("ru = 'Ошибка разбора PayloadJSON события'; en = 'Error parsing event PayloadJSON'"),
				ИнформацияОбОшибке(), Неопределено);
			ПолезнаяНагрузка = Новый Соответствие;
		КонецПопытки;
	КонецЕсли;

	СобытиеСтр = Новый Структура;
	СобытиеСтр.Вставить("seq",        Выборка.Sequence);
	СобытиеСтр.Вставить("occurred_at", ФорматДатыISO8601(Выборка.МоментВремени));
	СобытиеСтр.Вставить("event_type",  ТипСобытияСтр);
	СобытиеСтр.Вставить("payload",     ПолезнаяНагрузка);

	Возврат СобытиеСтр;

КонецФункции

// Форматировать дату в ISO 8601 UTC (2026-06-18T12:00:00Z).
//
// Примечание: платформа 1С хранит тип Дата в локальном времени сервера.
// Для получения UTC применяем УниверсальноеВремя, которая использует
// смещение часового пояса, настроенное в параметрах сеанса / ОС сервера.
//
// Параметры:
//   Дата - Дата - дата в локальном времени сервера.
//
// Возвращаемое значение:
//   Строка -- ISO 8601 с Z-суффиксом.
//
Функция ФорматДатыISO8601(Знач Дата)
	ДатаUTC = УниверсальноеВремя(Дата);
	Возврат Формат(ДатаUTC, "ДФ=yyyy-MM-ddTHH:mm:ssZ");
КонецФункции

// Форматировать дату в ISO 8601 UTC или вернуть Неопределено если дата пустая.
//
// Параметры:
//   Дата - Дата - дата в локальном времени сервера (может быть пустой датой 0001-01-01).
//
// Возвращаемое значение:
//   Строка       -- ISO 8601 с Z-суффиксом.
//   Неопределено -- если дата пустая (нулевое значение в платформе).
//
Функция ФорматДатыISO8601НулиПустая(Знач Дата)
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ФорматДатыISO8601(Дата);
КонецФункции

// Записать ошибку в журнал регистрации.
// Значение X-Agent-Token намеренно не включается в сообщение.
//
// Параметры:
//   Сообщение    - Строка             - краткое описание ошибки.
//   ИнфоОбОшибке - ИнформацияОбОшибке - информация об исключении.
//   Запрос       - HTTPСервисЗапрос   - для маскировки заголовка Authorization (может быть Неопределено).
//
Процедура ЗаписатьВЖурнал(Знач Сообщение, Знач ИнфоОбОшибке, Знач Запрос)

	ТекстОшибки = "";
	Попытка
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
		ТекстОшибки = ar_Утилиты.МаскироватьСекреты(ТекстОшибки);
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось получить текст ошибки'; en = 'Could not get error text'");
	КонецПопытки;

	КонтекстЗапроса = "";
	Если Запрос <> Неопределено Тогда
		Попытка
			AuthHeader = Запрос.Заголовки["Authorization"];
			Если ЗначениеЗаполнено(AuthHeader) Тогда
				// Маскируем Base64-строку Basic Auth.
				КонтекстЗапроса = "Authorization: " + ar_Утилиты.МаскироватьСекреты(AuthHeader);
			КонецЕсли;
		Исключение
			КонтекстЗапроса = "";
		КонецПопытки;
	КонецЕсли;

	ПолноеСообщение = Сообщение;
	Если Не ПустаяСтрока(КонтекстЗапроса) Тогда
		ПолноеСообщение = ПолноеСообщение + Символы.ПС + КонтекстЗапроса;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПолноеСообщение = ПолноеСообщение + Символы.ПС + ТекстОшибки;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ar_RunsAPI'; en = 'ar_RunsAPI'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ПолноеСообщение);

КонецПроцедуры

#КонецОбласти
