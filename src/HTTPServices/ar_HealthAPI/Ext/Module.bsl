// Модуль HTTP-сервиса ar_HealthAPI (Внешний API -- Мониторинг).
//
// Реализует liveness/readiness health-check endpoint для внешнего мониторинга.
// Полный URL: https://<хост>/<база>/hs/ar_HealthAPI/v1/health
//
// Аутентификация: Basic Auth пользователя ИБ (уровень платформы).
// X-Agent-Token не используется -- этот endpoint не требует токена агента.
//
// Параметры строки запроса:
//   verbose=true (или "1") -- включить детальную секцию "checks" в ответе.
//
// Коды ответов:
//   200 OK      -- нормальная работа (status: ok) или деградация (status: degraded).
//   401         -- неверный Basic Auth (от платформы).
//   503         -- критическая ошибка: liveness = false, платформа не может ответить.
//
// Зависимости: ar_Scheduler, ar_Константы, ar_JSON.
//
// Безопасность:
//   * В теле ответа нет ключей LLM, токенов, данных из БезопасноеХранилище.
//   * При verbose=true раскрываются только имена РЗ и их статус.
//   * Привилегированный режим в этом модуле НЕ устанавливается.
//
// См. спеку: .docs/specs/HTTPS-03.md, Plan §2.7.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиМетодовHTTP

// Обработчик GET /v1/health
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос от платформы.
//
// Возвращаемое значение:
//   HTTPСервисОтвет -- 200 OK / 503 Service Unavailable.
//
Функция v1_health_get(Запрос)

	Попытка

		// Шаг 1: Определить режим verbose (нечувствительно к регистру: true/True/TRUE/1).
		// ПараметрыЗапроса["verbose"] возвращает Неопределено, если параметр отсутствует.
		ПараметрVerbose = Запрос.ПараметрыЗапроса["verbose"];
		СтрVerbose = ?(ПараметрVerbose = Неопределено, "", ПараметрVerbose);
		Verbose = (НРег(СтрVerbose) = "true") Или (СтрVerbose = "1");

		// Шаг 2: Проверка liveness.
		РезультатLiveness = ПроверитьLiveness();

		// Шаг 3: Проверка readiness.
		РезультатReadiness = ПроверитьReadiness();

		// Шаг 4: Агрегация статуса.
		ReadinessOk = РезультатReadiness.ok;
		Если РезультатLiveness.ok И ReadinessOk Тогда
			Статус = "ok";
		ИначеЕсли РезультатLiveness.ok Тогда
			Статус = "degraded";
		Иначе
			Статус = "error";
		КонецЕсли;

		// Шаг 5: Получить версию и timestamp.
		// Версию берём из метаданных подключённого расширения (Configuration.xml.Version)
		// через ar_Утилиты.ВерсияРасширения() - единый достоверный источник версии.
		Версия = "";
		Попытка
			Версия = ar_Утилиты.ВерсияРасширения();
		Исключение
			Версия = "0.0.0";
		КонецПопытки;
		Если Версия = "?" Тогда
			Версия = "0.0.0";
		КонецЕсли;

		// ТекущаяУниверсальнаяДата() возвращает время UTC; суффикс Z -- Latin.
		Timestamp = Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ssZ");

		// Шаг 6: Сборка тела ответа.
		ТелоОтвета = Новый Структура;
		ТелоОтвета.Вставить("status",    Статус);
		ТелоОтвета.Вставить("version",   Версия);
		ТелоОтвета.Вставить("timestamp", Timestamp);
		ТелоОтвета.Вставить("liveness",  РезультатLiveness.ok);
		ТелоОтвета.Вставить("readiness", ReadinessOk);

		// Шаг 7: Добавить секцию checks при verbose=true.
		Если Verbose Тогда
			ТелоОтвета.Вставить("checks", РезультатReadiness.checks);
		КонецЕсли;

		// Шаг 8: Определить HTTP-код.
		Если РезультатLiveness.ok Тогда
			КодОтвета = 200; // 200 OK
		Иначе
			КодОтвета = КодСервисНедоступен(); // 503 Service Unavailable
		КонецЕсли;

		Возврат ar_HTTPСервисПомощник.СформироватьОтветJSON(КодОтвета, ТелоОтвета);

	Исключение

		// Критическая ошибка в обработчике -- возврат 503.
		ЗаписатьВЖурнал(
			НСтр("ru = 'Критическая ошибка AgentRunner.HealthAPI'; en = 'AgentRunner.HealthAPI critical error'"),
			ИнформацияОбОшибке());

		МинимальноеТело = Новый Структура;
		МинимальноеТело.Вставить("status",   "error");
		МинимальноеТело.Вставить("liveness", Ложь);

		Возврат ar_HTTPСервисПомощник.СформироватьОтветJSON(КодСервисНедоступен(), МинимальноеТело);

	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверить liveness -- платформа обрабатывает запрос и BSL выполняется.
// Факт вызова функции = liveness OK. При критической ошибке доступа к метаданным -- Ложь.
//
// Возвращаемое значение:
//   Структура -- {ok: Булево, message: Строка}.
//
Функция ПроверитьLiveness()

	Результат = Новый Структура;
	Результат.Вставить("ok",      Истина);
	Результат.Вставить("message", "");

	Попытка
		// Минимальная проверка: доступ к метаданным конфигурации.
		// Если метаданные недоступны -- платформа деградирована.
		НазваниеКонф = Метаданные.Имя;
		Если ПустаяСтрока(НазваниеКонф) Тогда
			Результат.ok      = Ложь;
			Результат.message = НСтр("ru = 'Метаданные конфигурации недоступны'; en = 'Configuration metadata unavailable'");
		КонецЕсли;
	Исключение
		Результат.ok      = Ложь;
		Результат.message = НСтр("ru = 'Ошибка доступа к метаданным'; en = 'Metadata access error'");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверить readiness -- все критические подсистемы AgentRunner работают.
//
// Вызывает:
//   ar_Scheduler.ДиагностикаПланировщика() -- статус 8 регламентных заданий.
//   ПроверитьКонстанты()                   -- заполненность критических констант.
//   ПроверитьПровайдеры()                  -- количество включённых LLM-провайдеров.
//
// Возвращаемое значение:
//   Структура -- {ok: Булево, checks: Структура}.
//
Функция ПроверитьReadiness()

	Результат = Новый Структура;
	Результат.Вставить("ok",     Истина);
	Результат.Вставить("checks", Новый Структура);

	// --- Проверка регламентных заданий ---
	СтатусыРЗ = Новый Массив;
	Попытка
		СтатусыРЗ = ar_Scheduler.ДиагностикаПланировщика();
	Исключение
		ЭлОшибки = Новый Структура;
		ЭлОшибки.Вставить("name",               "scheduler");
		ЭлОшибки.Вставить("display_name",        НСтр("ru = 'Планировщик AgentRunner'; en = 'AgentRunner Scheduler'"));
		ЭлОшибки.Вставить("status",              "error");
		ЭлОшибки.Вставить("last_run_seconds_ago", -1);
		СтатусыРЗ.Добавить(ЭлОшибки);
	КонецПопытки;

	// Преобразовать массив структур в формат JSON-ответа и проверить readiness.
	СписокRZ = Новый Массив;
	Для Каждого Элемент Из СтатусыРЗ Цикл
		РЗОбъект = Новый Структура;
		РЗОбъект.Вставить("name",               Строка(Элемент.Имя));
		РЗОбъект.Вставить("display_name",        Строка(Элемент.Синоним));
		РЗОбъект.Вставить("status",              Строка(Элемент.Статус));
		РЗОбъект.Вставить("last_run_seconds_ago", Элемент.СекундНазад);
		СписокRZ.Добавить(РЗОбъект);

		Если Элемент.Статус = "warning" Или Элемент.Статус = "error" Тогда
			Результат.ok = Ложь;
		КонецЕсли;
	КонецЦикла;
	Результат.checks.Вставить("scheduler", СписокRZ);

	// --- Проверка констант ---
	РезультатКонстант = ПроверитьКонстанты();
	Результат.checks.Вставить("constants", РезультатКонстант.checks);
	Если Не РезультатКонстант.ok Тогда
		Результат.ok = Ложь;
	КонецЕсли;

	// --- Проверка провайдеров ---
	РезультатПровайдеров = ПроверитьПровайдеры();
	Результат.checks.Вставить("providers", РезультатПровайдеров);
	// Количество провайдеров = 0 -- предупреждение, но не фатально для readiness.

	Возврат Результат;

КонецФункции

// Проверить заполненность критических констант AgentRunner.
//
// Возвращаемое значение:
//   Структура -- {ok: Булево, checks: Структура{version_set, timeout_set, max_steps_set}}.
//
Функция ПроверитьКонстанты()

	Результат = Новый Структура;
	Результат.Вставить("ok",     Истина);
	Результат.Вставить("checks", Новый Структура);

	// Версия расширения (из метаданных подключённого расширения).
	ВерсияРасширенияЗаполнена = Ложь;
	Попытка
		ВерсияРасширения = ar_Утилиты.ВерсияРасширения();
		ВерсияРасширенияЗаполнена = (ВерсияРасширения <> "0.0.0")
			И (ВерсияРасширения <> "?") И Не ПустаяСтрока(ВерсияРасширения);
	Исключение
		ВерсияРасширенияЗаполнена = Ложь;
	КонецПопытки;

	// Таймаут LLM.
	ТаймаутЗаполнен = Ложь;
	Попытка
		ТаймаутЗаполнен = (ar_Константы.ТаймаутLLM() > 0);
	Исключение
		ТаймаутЗаполнен = Ложь;
	КонецПопытки;

	// Максимальное количество шагов.
	МаксШаговЗаполнен = Ложь;
	Попытка
		МаксШаговЗаполнен = (ar_Константы.МаксШагов() > 0);
	Исключение
		МаксШаговЗаполнен = Ложь;
	КонецПопытки;

	Результат.checks.Вставить("version_set",   ВерсияРасширенияЗаполнена);
	Результат.checks.Вставить("timeout_set",   ТаймаутЗаполнен);
	Результат.checks.Вставить("max_steps_set", МаксШаговЗаполнен);

	Если Не ВерсияРасширенияЗаполнена Или Не ТаймаутЗаполнен Или Не МаксШаговЗаполнен Тогда
		Результат.ok = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Подсчитать количество включённых LLM-провайдеров в справочнике.
//
// Возвращаемое значение:
//   Структура -- {ok: Булево, enabled_count: Число}.
//
Функция ПроверитьПровайдеры()

	Результат = Новый Структура;
	Результат.Вставить("ok",            Ложь);
	Результат.Вставить("enabled_count", 0);

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	Справочник.ar_LLMПровайдеры КАК Провайдеры
			|ГДЕ
			|	Провайдеры.ar_Включён = ИСТИНА
			|	И Провайдеры.ПометкаУдаления = ЛОЖЬ";

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Количество = Выборка.Количество;
			Результат.enabled_count = Количество;
			Результат.ok = (Количество > 0);
		КонецЕсли;
	Исключение
		// Нет прав или справочник недоступен -- не фатально.
		Результат.Вставить("error_reading", Истина);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает HTTP-код 503 Service Unavailable (сервис недоступен).
// Выделено для именования кода ответа вместо магического числа.
//
// Возвращаемое значение:
//   Число -- код HTTP 503.
//
Функция КодСервисНедоступен()
	// RFC 7231 §6.6.4: 503 Service Unavailable.
	Возврат 503; // NOSONAR: именованная функция-константа, магическое число здесь осознанно.
КонецФункции

// Записать ошибку в журнал регистрации.
//
// Параметры:
//   Сообщение    - Строка              - краткое описание ошибки.
//   ИнфоОбОшибке - ИнформацияОбОшибке - информация об исключении.
//
Процедура ЗаписатьВЖурнал(Знач Сообщение, Знач ИнфоОбОшибке)

	ТекстОшибки = "";
	Попытка
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось получить текст ошибки'; en = 'Could not get error text'");
	КонецПопытки;

	ПолноеСообщение = Сообщение;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПолноеСообщение = ПолноеСообщение + Символы.ПС + ТекстОшибки;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'AgentRunner.HealthAPI'; en = 'AgentRunner.HealthAPI'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ПолноеСообщение);

КонецПроцедуры

#КонецОбласти
