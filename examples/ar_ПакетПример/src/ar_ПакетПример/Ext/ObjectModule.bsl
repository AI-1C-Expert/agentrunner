// Элемент JSON Schema: { "type": ..., "description": ... }.
//
// Параметры:
//  Тип      - Строка - тип JSON Schema свойства ("string", "integer" и т. п.).
//  Описание - Строка - человекочитаемое описание свойства для LLM.
//
// Возвращаемое значение:
//  Структура - {type, description}.
//
Функция СвойствоСхемыDemo(Знач Тип, Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}} - тот же
// контракт, что и у ядровых tools (см. ar_ToolCRM.ОбернутьВOpenAIФормат).
//
// Параметры:
//  Имя       - Строка    - полное имя tool (с namespace).
//  Описание  - Строка    - человекочитаемое описание tool для LLM.
//  Параметры - Структура - JSON Schema параметров ({type, properties, required}).
//
// Возвращаемое значение:
//  Строка - JSON-манифест вида {"type":"function","function":{...}}.
//
Функция ОбернутьВOpenAIФорматDemo(Знач Имя, Знач Описание, Знач Параметры)
	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", Имя);
	ФункцияОписание.Вставить("description", Описание);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);
	Возврат ar_JSON.ВЗначениеJSON(Манифест);
КонецФункции

// Реализация tool demo_echo. Read-only, _dry_run не проверяется (чтение в
// dry-run безопасно по определению, см. Tutorial-свой-tool.md §3.4).
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"text": "..."}.
//  Контекст      - Структура - контекст запуска. Не используется (read-only).
//
// Возвращаемое значение:
//  Строка - JSON-observation {"text":"<эхо>"} либо {"error":"<код>"}.
//
Функция ВыполнитьDemoEcho(Знач АргументыJSON, Знач Контекст)

	Аргументы = ДесериализоватьАргументыDemo(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаDemo("invalid_json_arguments");
	КонецЕсли;

	Текст = ЗначениеИзКоллекцииDemo(Аргументы, "text", Неопределено);
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат ОшибкаDemo("text is required");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("text", Текст);
	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Реализация tool demo_draft_note. RiskLevel = Draft, ТребуетApproval =
// Истина: функция строит payload заметки и ставит его в очередь
// ar_ОчередьApproval через ar_Approval.Поставить - не пишет в ИБ напрямую
// (правило 1.7.1 .docs/Контракт-пакета-tools.md). DryRun проверяется в
// начале функции по общему контракту mutating tools
// (см. Tutorial-свой-tool.md §3.3).
//
// Параметры:
//  АргументыJSON - Строка    - JSON вида {"text": "..."}.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, ...).
//
// Возвращаемое значение:
//  Строка - JSON-observation:
//   dry_run:   {"dry_run":true,"tool":"demo_draft_note","simulated":{...}}
//   approval:  {"approval_id":"<UUID>","status":"pending_approval"}
//   ошибка:    {"error":"<код>"}
//
Функция ВыполнитьDemoDraftNote(Знач АргументыJSON, Знач Контекст)

	Если ar_ToolDispatcher.ИзвлечьDryRun(АргументыJSON) Тогда
		СимулированныеДанные = Новый Структура("text_preview", "(dry-run, запись не выполняется)");
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("demo_draft_note", СимулированныеДанные);
	КонецЕсли;

	Аргументы = ДесериализоватьАргументыDemo(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОшибкаDemo("invalid_json_arguments");
	КонецЕсли;

	Текст = ЗначениеИзКоллекцииDemo(Аргументы, "text", Неопределено);
	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат ОшибкаDemo("text is required");
	КонецЕсли;

	IdempotencyKey = ar_ToolDispatcher.ИзвлечьIdempotencyKey(АргументыJSON);

	ПейлоадЗаметки = Новый Структура;
	ПейлоадЗаметки.Вставить("text", Текст);

	Действие = Новый Структура;
	Действие.Вставить("Имя", "demo_draft_note");
	Действие.Вставить("ИдВызова", ar_Утилиты.НовыйUUID());
	Действие.Вставить("Аргументы", ПейлоадЗаметки);
	Действие.Вставить("IdempotencyKey", IdempotencyKey);
	Действие.Вставить("RiskLevel", "Draft");

	Попытка
		ApprovalId = ar_Approval.Поставить(Контекст, Действие);
	Исключение
		ИнформацияОшибки = ИнформацияОбОшибке();
		ar_СлужебныйЛог.Записать("ar_ПакетПример.ВыполнитьDemoDraftNote", "demo_approval_enqueue_failed",
			ИнформацияОшибки.ПодробноеПредставлениеОшибки(), "Ошибка");
		Возврат ОшибкаDemo("approval_enqueue_failed");
	КонецПопытки;

	Если ПустаяСтрока(ApprovalId) Тогда
		Возврат ОшибкаDemo("approval_enqueue_skipped");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("approval_id", ApprovalId);
	Результат.Вставить("status", "pending_approval");
	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Разбирает JSON-строку аргументов tool в Соответствие.
//
// Параметры:
//  АргументыJSON - Строка - JSON-объект аргументов от LLM.
//
// Возвращаемое значение:
//  Соответствие - разобранные аргументы; Неопределено при пустом входе или
//  ошибке парсинга JSON.
//
Функция ДесериализоватьАргументыDemo(Знач АргументыJSON)
	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат ar_JSON.ИзJSON(АргументыJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Читает значение поля из Соответствия аргументов с дефолтом при отсутствии.
//
// Параметры:
//  Коллекция - Соответствие - разобранные JSON-аргументы.
//  Ключ      - Строка - имя поля.
//  Дефолт    - Произвольный - значение при отсутствии поля.
//
// Возвращаемое значение:
//  Произвольный - значение поля или Дефолт.
//
Функция ЗначениеИзКоллекцииDemo(Знач Коллекция, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(Коллекция) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Коллекция.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Формирует JSON-строку ошибки-observation.
//
// Параметры:
//  КодОшибки - Строка - машиночитаемый код ошибки.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<код>"}.
//
Функция ОшибкаDemo(Знач КодОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

#КонецОбласти