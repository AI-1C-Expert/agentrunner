#Область ПрограммныйИнтерфейс

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчёты и
// обработки». Вид = ДополнительнаяОбработка (глобальная, без Назначения).
// БезопасныйРежим = Истина - значение по умолчанию самой БСП
// (ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке), здесь не
// переопределяется - см. .docs/Контракт-пакета-tools.md §1.1.
//
// Команда с Идентификатор = "ar_ToolPack" - маркер принадлежности пакета
// AgentRunner (см. .docs/Контракт-пакета-tools.md §1.2). Значение
// регистрозависимое и фиксированное - по нему PKG-03 отбирает кандидатов на
// регистрацию запросом к ТЧ Команды, без загрузки бинарника обработки.
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Пакет инструментов AgentRunner: пример'");

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = НСтр("ru = 'Пакет инструментов AgentRunner'");
	НоваяКоманда.Идентификатор        = "ar_ToolPack";
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП "Дополнительные отчёты и обработки". Команда
// "ar_ToolPack" - маркерная (см. СведенияОВнешнейОбработке выше): её прямой
// интерактивный вызов из UI пользователем не предусмотрен. Маркер существует
// только для отбора кандидатов на регистрацию пакета запросом ядра
// AgentRunner (PKG-03) по ТЧ Команды справочника ДополнительныеОтчетыИОбработки,
// а не для запуска через командный интерфейс - поэтому обработчик только
// выводит пользователю пояснение и не выполняет прикладного действия.
//
// Параметры:
//  ИдентификаторКоманды        - Строка    - идентификатор вызванной команды.
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП.
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ToolPack" Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетПример.ВыполнитьКоманду", "demo_toolpack_marker_invoked",
			НСтр("ru = 'ar_ToolPack - служебный маркер пакета инструментов AgentRunner,'
				|' прикладного действия по этой команде не предусмотрено.'"));
	КонецЕсли;

КонецПроцедуры

// Манифест пакета tools - контракт PKG-01 (см. .docs/Контракт-пакета-tools.md
// §1.4). Вызывается ядром AgentRunner при регистрации/переподтверждении
// пакета (PKG-03). Не принимает аргументов.
//
// Возвращаемое значение:
//  Структура - манифест пакета:
//   * schema_version - Число    - версия схемы контракта (текущая - 1).
//   * namespace       - Строка  - префикс имён tools пакета.
//   * Версия          - Строка  - SemVer версии пакета.
//   * Категории       - Массив структур - {Имя, Представление, ОписаниеДляLLM, Порядок}.
//   * Tools           - Массив структур - описания tools пакета (§1.5 контракта).
//
Функция ar_ОписаниеTools() Экспорт

	Манифест = Новый Структура;
	Манифест.Вставить("schema_version", 1);
	Манифест.Вставить("namespace", "demo");
	Манифест.Вставить("Версия", "1.0.0");

	Категория = Новый Структура;
	Категория.Вставить("Имя", "demo");
	Категория.Вставить("Представление", НСтр("ru = 'Демонстрационные инструменты'"));
	Категория.Вставить("ОписаниеДляLLM", НСтр("ru = 'Примеры tools эталонного пакета AgentRunner'"));
	Категория.Вставить("Порядок", 1);

	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Манифест.Вставить("Категории", Категории);

	Tools = Новый Массив;
	Tools.Добавить(ar_ОписаниеToolDemoEcho());
	Tools.Добавить(ar_ОписаниеToolDemoDraftNote());
	Манифест.Вставить("Tools", Tools);

	Возврат Манифест;

КонецФункции

// Единая точка входа вызова tools пакета - контракт PKG-01 (см.
// .docs/Контракт-пакета-tools.md §1.6). Вызывается ядром AgentRunner на
// каждый вызов tool из этого пакета (PKG-04). Диспетчеризация внутри пакета -
// на авторе (без Выполнить()/Вычислить()), см. Plan §1.3.
//
// Параметры:
//  ИмяTool       - Строка    - полное имя tool с namespace ("demo_echo",
//                  "demo_draft_note").
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащённый
//                  ядром системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun,
//                  при наличии - Агент). Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьTool(Знач ИмяTool, Знач АргументыJSON, Знач Контекст) Экспорт

	Если ИмяTool = "demo_echo" Тогда
		Возврат ВыполнитьDemoEcho(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "demo_draft_note" Тогда
		Возврат ВыполнитьDemoDraftNote(АргументыJSON, Контекст);
	Иначе
		Возврат ОшибкаDemo("unknown_tool");
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание tool demo_echo для манифеста пакета (RiskLevel = Read,
// ТребуетApproval = Ложь). Возвращает переданный аргумент без записи в ИБ -
// минимальная демонстрация read-only контракта (§1.5 документа).
//
// Возвращаемое значение:
//  Структура - элемент массива Tools манифеста пакета.
//
Функция ar_ОписаниеToolDemoEcho()

	Описание = Новый Структура;
	Описание.Вставить("Имя", "demo_echo");
	Описание.Вставить("Описание",
		НСтр("ru = 'Возвращает переданный текст без изменений. Read-only, для проверки подключения пакета.'"));
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Эхо переданного текста'"));
	Описание.Вставить("JSONManifest", МанифестDemoEcho());
	Описание.Вставить("RiskLevel", "Read");
	Описание.Вставить("ТребуетApproval", Ложь);
	Описание.Вставить("Версия", "1.0.0");
	Описание.Вставить("Категория", "demo");
	Возврат Описание;

КонецФункции

