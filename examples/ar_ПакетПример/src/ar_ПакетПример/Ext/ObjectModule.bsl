// JSON Schema аргументов demo_echo в OpenAI tool-format.
//
// Возвращаемое значение:
//  Строка - JSON-манифест вида {"type":"function","function":{...}}.
//
Функция МанифестDemoEcho()

	Свойства = Новый Структура;
	Свойства.Вставить("text", СвойствоСхемыDemo("string", НСтр("ru = 'Текст, который нужно вернуть без изменений.'")));

	Обязательные = Новый Массив;
	Обязательные.Добавить("text");

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Обязательные);

	Возврат ОбернутьВOpenAIФорматDemo("demo_echo",
		НСтр("ru = 'Возвращает переданный текст без изменений. Read-only.'"), Параметры);

КонецФункции

