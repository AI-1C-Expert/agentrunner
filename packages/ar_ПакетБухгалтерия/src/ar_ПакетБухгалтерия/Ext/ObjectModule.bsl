// Сериализует структуру/массив в JSON-строку.
Функция СтруктуруВJSON(Знач Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "");
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Признак «физическое лицо» по значению перечисления ЮридическоеФизическоеЛицо.
// Если перечисления или значения в конфигурации нет (нетиповой случай) —
// возвращает Ложь, чтобы не отдавать LLM ложноположительный признак.
Функция ЭтоФизическоеЛицо(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Перечисление = Метаданные.Перечисления.Найти("ЮридическоеФизическоеЛицо");
	Если Перечисление = Неопределено
		Или Перечисление.ЗначенияПеречисления.Найти("ФизическоеЛицо") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Значение = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;

КонецФункции

