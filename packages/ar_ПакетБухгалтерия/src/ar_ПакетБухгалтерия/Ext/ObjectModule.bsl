//
// Возвращаемое значение:
//  Строка - JSON {valid, errors, warnings, ...} либо {"error":"..."}.
//
Функция ВалидироватьДокумент(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ВалидироватьДокументВнутр(Аргументы);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool create_reconciliation_act (RECON-01): создаёт и ЗАПИСЫВАЕТ (без
// проведения) акт сверки взаиморасчётов родным заполнением БП
// (ar_АдаптерЗаполнения.СоздатьАктСверки → ar_АдаптерБП.СоздатьАктСверки).
//
// RiskLevel = Write, ТребуетApproval = Ложь - осознанное отклонение от
// hard-rule «все mutating tools через approval» (решение пользователя
// 2026-07-21, зафиксировано в .docs/specs/RECON-01.md, §create_reconciliation_act
// «Почему без адаптерной approval-развилки»). Запись выполняется в правах
// пользователя сессии - привилегированный режим НЕ используется.
//
// Контракт DryRun (DISP-03): при _dry_run = Истина возвращается
// ar_ToolDispatcher.СформироватьDryRunJSON(...) без записи в данные ИБ.
//
// Параметры:
//  Аргументы - Строка    - JSON: {"client_ref":...,"organization_ref":...,
//              "stale_after_months":1,"accounts":["62"],"force":false}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: {"status":"created",...} / {"status":"skipped",...}
//           либо {"error":"..."}.
//
Функция СоздатьАктСверки(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат СоздатьАктСверкиВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Исполнитель approved-действия create_reconciliation_act (см.
// ar_Approval.ИсполнитьApprovedДействие). Нужен для случая, когда tool всё же
// прошёл через очередь approval: в реестре ar_Tools у записи стоит
// ar_ТребуетApproval = Истина (например, запись создана до того, как описание
// tool переключили на Ложь, либо флаг изменён администратором). Без этого
// исполнителя подтверждённое пользователем действие тихо терялось с
// "no_executor_for_action:create_reconciliation_act", хотя approve состоялся.
//
// Переиспользует основную логику tool (СоздатьАктСверкиВнутр) на сохранённых
// аргументах - отдельной ветки создания документа не заводим, чтобы поведение
// approve-пути и прямого вызова не разъезжалось.
//
// Параметры:
//  ApprovalId        - Строка - идентификатор записи очереди (для лога).
//  ActionPayloadJSON - Строка - см. ar_Approval.СобратьActionPayloadJSON.
//
// Возвращаемое значение:
//  Структура { Выполнено - Булево, DocumentRef - ЛюбаяСсылка/Неопределено,
//              Сообщения - Массив } - контракт исполнителя approve-пути.
//
Функция ИсполнитьСоздатьАктСверки(Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Результат = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	РазобраноActionPayload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Если ТипЗнч(РазобраноActionPayload) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_json");
		Возврат Результат;
	КонецЕсли;

	ToolName = СокрЛП(Строка(ЗначениеПоКлючу(РазобраноActionPayload, "tool_name", "")));
	Если ToolName <> "buh_create_reconciliation_act" Тогда
		Результат.Сообщения.Добавить("no_executor_for_action:" + ToolName);
		Возврат Результат;
	КонецЕсли;

	Аргументы = ЗначениеПоКлючу(РазобраноActionPayload, "arguments", Неопределено);
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_arguments");
		Возврат Результат;
	КонецЕсли;

	// Аргументы уже подтверждены пользователем - повторный DryRun здесь не нужен
	// и не должен «съесть» исполнение, поэтому флаг снимается явно.
	АргументыИсполнения = Новый Соответствие;
	Для Каждого КлючЗначение Из Аргументы Цикл
		АргументыИсполнения.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	АргументыИсполнения.Вставить("_dry_run", Ложь);

	ОтветJSON = СоздатьАктСверкиВнутр(ar_JSON.ВЗначениеJSON(АргументыИсполнения), Неопределено);

	Разобрано = ar_JSON.ИзJSON(ОтветJSON);
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_tool_response");
		Возврат Результат;
	КонецЕсли;

	Статус = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "status", "")));
	ТекстОшибки = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "error", "")));

	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Результат.Сообщения.Добавить(ТекстОшибки);
		ar_СлужебныйЛог.Записать("ar_ToolДокументы.ИсполнитьСоздатьАктСверки",
			"reconciliation_act_not_created",
			"ApprovalId=" + ApprovalId + ": " + ОтветJSON, "Ошибка");
		Возврат Результат;
	КонецЕсли;

	// status = "skipped" (свежий акт уже есть) - это не сбой: действие
	// отработало штатно, документ просто не понадобился.
	Результат.Выполнено = (Статус = "created" Или Статус = "skipped");

	// Сообщение обязано быть самодостаточным. Раньше сюда клалось голое слово
	// "skipped", и модель читала его как "шаг пропущен, всё хорошо": в чате
	// пользователю сообщалось "акт создан", хотя нового документа не появилось,
	// а ссылка вела на старый акт. Причину и дату несём вместе со статусом.
	Если Статус = "skipped" Тогда
		ПричинаПропуска = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "reason", "")));
		ДатаПоследнегоАкта = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "last_act_date", "")));

		ТекстПропуска = НСтр("ru='НОВЫЙ ДОКУМЕНТ НЕ СОЗДАН (status=skipped)';
		                     |en='NO NEW DOCUMENT CREATED (status=skipped)'");
		Если ПричинаПропуска = "recent_act_exists" Тогда
			ТекстПропуска = ТекстПропуска + ". "
				+ НСтр("ru='Причина: у контрагента уже есть свежий акт сверки от';
				       |en='Reason: the counterparty already has a recent act dated'")
				+ " " + ДатаПоследнегоАкта + ". "
				+ НСтр("ru='Ссылка ниже ведёт на этот СУЩЕСТВУЮЩИЙ акт, а не на новый."
					+ " Сообщи пользователю, что акт не создавался, и назови дату"
					+ " имеющегося. Чтобы создать акт всё равно - повтори вызов с"
					+ " force=true.';"
					+ " en='The reference below points to that EXISTING act, not a new"
					+ " one. Tell the user no act was created and give the existing"
					+ " date. To create one anyway, retry with force=true.'");
		ИначеЕсли Не ПустаяСтрока(ПричинаПропуска) Тогда
			ТекстПропуска = ТекстПропуска + ". reason=" + ПричинаПропуска;
		КонецЕсли;

		Результат.Сообщения.Добавить(ТекстПропуска);
	Иначе
		Результат.Сообщения.Добавить(?(ПустаяСтрока(Статус), "unknown_status", Статус));
	КонецЕсли;

	// created → act_ref, skipped → last_act_ref (см. СоздатьАктСверкиВнутр).
	СсылкаДокумента = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "act_ref", "")));
	Если ПустаяСтрока(СсылкаДокумента) Тогда
		СсылкаДокумента = СокрЛП(Строка(ЗначениеПоКлючу(Разобрано, "last_act_ref", "")));
	КонецЕсли;
	Если Не ПустаяСтрока(СсылкаДокумента) Тогда
		Попытка
			Результат.DocumentRef = ar_Утилиты.ОбъектИзНавигационнойСсылки(СсылкаДокумента);
		Исключение
			Результат.DocumentRef = Неопределено;
		КонецПопытки;
	КонецЕсли;

	ar_СлужебныйЛог.Записать("ar_ToolДокументы.ИсполнитьСоздатьАктСверки",
		"reconciliation_act_executed",
		"ApprovalId=" + ApprovalId + ": status=" + Статус + ", ref=" + СсылкаДокумента,
		"Информация");

	Возврат Результат;

КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область CreateInvoiceDraft

// Основная логика create_invoice_draft (стадия 1: payload-preview без записи).
// Выделена из СоздатьЧерновикСчёта, чтобы внешний Попытка/Исключение ловил
// любые непредвиденные ошибки и очищал текст для LLM (DoD D14).
//
Функция СоздатьЧерновикСчётаВнутр(Знач Аргументы, Знач Контекст)

	// 1. DryRun (DISP-03): при Истина - симулированный ответ без обращения к данным ИБ.
	Если ar_ToolDispatcher.ИзвлечьDryRun(Аргументы) Тогда
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("buh_create_invoice_draft", Неопределено);
	КонецЕсли;

	// 2. Десериализация аргументов.
	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	// 3. Проверка наличия типа документа в метаданных (graceful, DoD D15).
	МДДокумент = Метаданные.Документы.Найти(
		ar_ToolDispatcher.ИмяОбъектаМетаданных("СчетНаОплатуПокупателю", "СчетНаОплатуПокупателю"));
	Если МДДокумент = Неопределено Тогда
		Возврат ОшибочныйJSONСДеталью("document_type_not_found",
			"СчетНаОплатуПокупателю не найден в метаданных");
	КонецЕсли;

	// 4. Разыменование контрагента.
	СтрокаКлиента = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "client_ref", "")));
	Если ПустаяСтрока(СтрокаКлиента) Тогда
		Возврат ОшибочныйJSON("client_not_found");
	КонецЕсли;
	РезультатКлиента = РазыменоватьСсылкуКонтрагента(СтрокаКлиента);
	Если РезультатКлиента.Ошибка <> "" Тогда
		Возврат ОшибочныйJSON(РезультатКлиента.Ошибка);
	КонецЕсли;
	СсылкаКлиента = РезультатКлиента.Ссылка;

	// 5. Чтение наименования контрагента в правах пользователя (access_denied - обработать).
	Попытка
		ИмяКлиента = ПрочитатьНаименованиеКонтрагента(СсылкаКлиента);
	Исключение
		Возврат ОшибочныйJSON("access_denied");
	КонецПопытки;

	// 6. Валидация позиций items (тип, quantity > 0, price >= 0).
	РезультатПозиций = ВалидироватьПозиции(ЗначениеПоКлючу(Объект, "items", Неопределено));
	Если РезультатПозиций.Ошибка <> "" Тогда
		Если ПустаяСтрока(РезультатПозиций.Деталь) Тогда
			Возврат ОшибочныйJSON(РезультатПозиций.Ошибка);
		КонецЕсли;
		Возврат ОшибочныйJSONСДеталью(РезультатПозиций.Ошибка, РезультатПозиций.Деталь);
	КонецЕсли;

	Предупреждения = Новый Массив;

	// 7. Опциональная организация (graceful - не блокер). Строка навигации
	// сохраняется в Payload как есть (organization_ref) - понадобится
	// исполнителю approved-действия (UNIV-06) для повторного разыменования
	// в момент фактической записи документа, см. ИсполнитьСоздатьЧерновикСчёта.
	ОрганизацияИмя = "";
	СтрокаОрганизации = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "organization_ref", "")));
	Если НЕ ПустаяСтрока(СтрокаОрганизации) Тогда
		РезультатОрг = РазыменоватьОрганизацию(СтрокаОрганизации);
		Если РезультатОрг.Ошибка <> "" Тогда
			Предупреждения.Добавить("organization_not_found");
			СтрокаОрганизации = ""; // Невалидную ссылку не переносим в Payload.
		Иначе
			ОрганизацияИмя = РезультатОрг.Наименование;
		КонецЕсли;
	КонецЕсли;

	// 8. Комментарий (обрезка до 1000).
	КомментарийОбрезан = Ложь;
	Комментарий = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "comment", "")));
	Если СтрДлина(Комментарий) > 1000 Тогда
		Комментарий = Лев(Комментарий, 1000);
		КомментарийОбрезан = Истина;
	КонецЕсли;

	// 9. Итог по позициям + перенос предупреждений уровня позиций.
	Итого = РезультатПозиций.Итого;
	Для Каждого ПредупреждениеПозиции Из РезультатПозиций.Предупреждения Цикл
		Предупреждения.Добавить(ПредупреждениеПозиции);
	КонецЦикла;

	// 10. Сборка ActionPayloadJSON.
	Payload = СформироватьPayloadСчёта(СсылкаКлиента, ИмяКлиента, РезультатПозиций.Позиции,
		Итого, Комментарий, ОрганизацияИмя, СтрокаОрганизации, Предупреждения);

	// 11. Постановка payload в очередь approval (APPR-01). Документ НЕ создаётся
	// немедленно - он будет создан после подтверждения оператором.
	КонтекстЗапуска = ?(ТипЗнч(Контекст) = Тип("Структура"), Контекст, Новый Структура);
	IdempotencyKey = ar_ToolDispatcher.ИзвлечьIdempotencyKey(Аргументы);

	Действие = Новый Структура;
	Действие.Вставить("Имя", "buh_create_invoice_draft");
	Действие.Вставить("ИдВызова", "");
	Действие.Вставить("Аргументы", Payload);
	Действие.Вставить("IdempotencyKey", IdempotencyKey);
	Действие.Вставить("RiskLevel", "Draft");

	ApprovalИД = ar_Approval.Поставить(КонтекстЗапуска, Действие);

	Результат = Новый Структура;
	Результат.Вставить("status", "queued_for_approval");
	Результат.Вставить("approval_id", ApprovalИД);
	Результат.Вставить("total", Итого);
	Результат.Вставить("payload", Payload);
	Если КомментарийОбрезан Тогда
		Результат.Вставить("comment_truncated", Истина);
	КонецЕсли;

	Возврат СтруктуруВJSONДокументы(Результат);

КонецФункции

// Валидирует массив позиций счёта. Возвращает Структуру:
//   { Ошибка - Строка, Деталь - Строка, Позиции - Массив (нормализованные),
//     Итого - Число, Предупреждения - Массив }.
// При Ошибка <> "" остальные поля игнорируются.
//
Функция ВалидироватьПозиции(Знач СыройСписок)

	Результат = Новый Структура("Ошибка, Деталь, Позиции, Итого, Предупреждения",
		"", "", Новый Массив, 0, Новый Массив);

	Если ТипЗнч(СыройСписок) <> Тип("Массив") Или СыройСписок.Количество() = 0 Тогда
		Результат.Ошибка = "items_required";
		Возврат Результат;
	КонецЕсли;

	Итого = 0;
	НомерСтроки = 0;

	Для Каждого СыраяПозиция Из СыройСписок Цикл
		НомерСтроки = НомерСтроки + 1;

		Если ТипЗнч(СыраяПозиция) <> Тип("Соответствие") Тогда
			Результат.Ошибка = "items_invalid";
			Результат.Деталь = "item #" + НомерСтроки + " is not an object";
			Возврат Результат;
		КонецЕсли;

		Количество = ЗначениеПоКлючу(СыраяПозиция, "quantity", Неопределено);
		Если ТипЗнч(Количество) <> Тип("Число") Тогда
			Результат.Ошибка = "items_invalid";
			Результат.Деталь = "quantity must be a number";
			Возврат Результат;
		КонецЕсли;
		Если Количество <= 0 Тогда
			Результат.Ошибка = "items_invalid";
			Результат.Деталь = "quantity must be > 0";
			Возврат Результат;
		КонецЕсли;

		Цена = ЗначениеПоКлючу(СыраяПозиция, "price", Неопределено);
		Если ТипЗнч(Цена) <> Тип("Число") Тогда
			Результат.Ошибка = "items_invalid";
			Результат.Деталь = "price must be a number";
			Возврат Результат;
		КонецЕсли;
		Если Цена < 0 Тогда
			Результат.Ошибка = "items_invalid";
			Результат.Деталь = "price cannot be negative";
			Возврат Результат;
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("quantity", Количество);
		Позиция.Вставить("price", Цена);
		Позиция.Вставить("total", Количество * Цена);

		// Номенклатура (graceful: не найдена → пометка, не блок).
		СтрокаНоменклатуры = СокрЛП(Строка(ЗначениеПоКлючу(СыраяПозиция, "nomenclature_ref", "")));
		Позиция.Вставить("nomenclature_ref", СтрокаНоменклатуры);
		Если ПустаяСтрока(СтрокаНоменклатуры) Тогда
			Позиция.Вставить("missing_nomenclature", Истина);
			Результат.Предупреждения.Добавить("item #" + НомерСтроки + ": nomenclature_ref empty");
		Иначе
			РезультатНом = РазыменоватьНоменклатуру(СтрокаНоменклатуры);
			Если РезультатНом.Ошибка <> "" Тогда
				Позиция.Вставить("missing_nomenclature", Истина);
				Результат.Предупреждения.Добавить("item #" + НомерСтроки + ": nomenclature not found");
			Иначе
				Позиция.Вставить("nomenclature_name", РезультатНом.Наименование);
			КонецЕсли;
		КонецЕсли;

		СтавкаНДС = СокрЛП(Строка(ЗначениеПоКлючу(СыраяПозиция, "vat_rate", "")));
		Если НЕ ПустаяСтрока(СтавкаНДС) Тогда
			Позиция.Вставить("vat_rate", СтавкаНДС);
		КонецЕсли;

		Итого = Итого + Количество * Цена;
		Результат.Позиции.Добавить(Позиция);
	КонецЦикла;

	Результат.Итого = Итого;
	Возврат Результат;

КонецФункции

// Собирает ActionPayloadJSON-структуру черновика счёта.
Функция СформироватьPayloadСчёта(Знач СсылкаКлиента, Знач ИмяКлиента, Знач Позиции,
		Знач Итого, Знач Комментарий, Знач ОрганизацияИмя, Знач СтрокаОрганизации, Знач Предупреждения)

	Payload = Новый Структура;
	Payload.Вставить("action", "buh_create_invoice_draft");
	Payload.Вставить("client_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаКлиента));
	Payload.Вставить("client_name", ИмяКлиента);
	Payload.Вставить("items", Позиции);
	Payload.Вставить("total", Итого);
	Если НЕ ПустаяСтрока(Комментарий) Тогда
		Payload.Вставить("comment", Комментарий);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ОрганизацияИмя) Тогда
		Payload.Вставить("organization", ОрганизацияИмя);
	КонецЕсли;
	// UNIV-06: строка навигации организации (не только имя) - исполнителю
	// approved-действия нужна ссылка для повторного разыменования при
	// фактической записи документа (см. ИсполнитьСоздатьЧерновикСчёта).
	Если НЕ ПустаяСтрока(СтрокаОрганизации) Тогда
		Payload.Вставить("organization_ref", СтрокаОрганизации);
	КонецЕсли;
	Payload.Вставить("warnings", Предупреждения);
	Возврат Payload;

КонецФункции

// UNIV-06: минимальный исполнитель approved-действия create_invoice_draft.
// Замыкает цепочку tool -> payload -> очередь -> approve -> запись (без этой
// точки DoD «документ, эквивалентный созданному руками» непроверяем - см.
// .docs/specs/UNIV-06.md, раздел «Второй критический факт»).
//
// Вызывается из ar_Approval.Принять (через служебную ИсполнитьApprovedДействие)
// сразу после перевода записи в approved и фиксации аудита - до хука
// AfterApproval. Точка выбрана в ar_Approval, а не в форме очереди, потому что
// через Принять проходят оба пути подтверждения - одиночный и массовый (APPR-05).
//
// Отрабатывает только при tool_name = "buh_create_invoice_draft"; для прочих
// действий - явный no-op "no_executor_for_action:<имя>" (обобщённый диспетчер
// "payload.action -> исполнитель" для всех mutating tools вне скоупа этой
// задачи - технический долг, см. «Риски» спеки).
//
// Заново разыменовывает client_ref/items[].nomenclature_ref/organization_ref
// из сохранённого Payload (те же функции РазыменоватьСсылкуКонтрагента и
// т.д., что и на стадии постановки в очередь - не дублируются). Вызывает
// ar_АдаптерЗаполнения.СоздатьЧерновикСчёта и, при успехе, записывает
// результат без проведения (контракт ОписаниеToolСоздатьЧерновикСчёта:
// «без проведения»).
//
// Работает в правах пользователя, подтвердившего действие (сеанс оператора,
// вызвавшего ar_Approval.Принять) - привилегированный режим НЕ поднимается
// (Plan §1.3: только там, где спека/DoD требует; создание черновика документа
// привилегий не требует, RLS должен отработать штатно). Важно: ar_Approval
// поднимает привилегии точечно для чтения/записи служебных регистров очереди
// и аудита и сбрасывает их до этого вызова - документ пишется в правах сеанса.
//
// Параметры:
//  ApprovalId - Строка - идентификатор записи очереди approval (для лога).
//  ActionPayloadJSON - Строка - JSON, сохранённый в ar_ОчередьApproval.
//              ar_ActionPayloadJSON (см. ar_Approval.СобратьActionPayloadJSON):
//              {tool_name, arguments: Payload, ...}.
//
// Возвращаемое значение:
//  Структура - {Выполнено: Булево, DocumentRef: СправочникСсылка/Неопределено,
//               Сообщения: Массив из Строка}.
//
Функция ИсполнитьСоздатьЧерновикСчёта(Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Результат = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);

	РазобраноActionPayload = ar_JSON.ИзJSON(ActionPayloadJSON);
	Если ТипЗнч(РазобраноActionPayload) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_json");
		Возврат Результат;
	КонецЕсли;

	ToolName = СокрЛП(Строка(ЗначениеПоКлючу(РазобраноActionPayload, "tool_name", "")));
	Если ToolName <> "buh_create_invoice_draft" Тогда
		// Явный no-op для прочих действий - обобщённый диспетчер вне скоупа
		// UNIV-06 (см. докстринг функции). Не иллюзия поддержки: сообщение
		// прямо называет причину.
		Результат.Сообщения.Добавить("no_executor_for_action:" + ToolName);
		Возврат Результат;
	КонецЕсли;

	Payload = ЗначениеПоКлючу(РазобраноActionPayload, "arguments", Неопределено);
	Если ТипЗнч(Payload) <> Тип("Соответствие") Тогда
		Результат.Сообщения.Добавить("invalid_action_payload_arguments");
		Возврат Результат;
	КонецЕсли;

	// Разыменование client_ref (обязателен).
	СтрокаКлиента = СокрЛП(Строка(ЗначениеПоКлючу(Payload, "client_ref", "")));
	Если ПустаяСтрока(СтрокаКлиента) Тогда
		Результат.Сообщения.Добавить("client_not_found");
		Возврат Результат;
	КонецЕсли;
	РезультатКлиента = РазыменоватьСсылкуКонтрагента(СтрокаКлиента);
	Если РезультатКлиента.Ошибка <> "" Тогда
		Результат.Сообщения.Добавить(РезультатКлиента.Ошибка);
		Возврат Результат;
	КонецЕсли;

	// Разыменование organization_ref (опционален).
	СсылкаОрганизации = Неопределено;
	СтрокаОрганизации = СокрЛП(Строка(ЗначениеПоКлючу(Payload, "organization_ref", "")));
	Если НЕ ПустаяСтрока(СтрокаОрганизации) Тогда
		РезультатОрг = РазыменоватьОрганизацию(СтрокаОрганизации);
		Если РезультатОрг.Ошибка = "" Тогда
			СсылкаОрганизации = РезультатОрг.Ссылка;
		КонецЕсли;
		// Невалидная организация на этапе исполнения - не блокер (organization_ref
		// изначально опционален, ar_АдаптерБП.СоздатьЧерновикСчёта сработает на
		// дефолте, проставленном типовым Заполнить()).
	КонецЕсли;

	// Разыменование позиций.
	СыраяПозиции = ЗначениеПоКлючу(Payload, "items", Новый Массив);
	ПозицииДляАдаптера = Новый Массив;
	Для Каждого СыраяПозиция Из СыраяПозиции Цикл
		Если ТипЗнч(СыраяПозиция) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаНоменклатуры = СокрЛП(Строка(ЗначениеПоКлючу(СыраяПозиция, "nomenclature_ref", "")));
		НоменклатураСсылка = Неопределено;
		Если НЕ ПустаяСтрока(СтрокаНоменклатуры) Тогда
			РезультатНом = РазыменоватьНоменклатуру(СтрокаНоменклатуры);
			Если РезультатНом.Ошибка = "" Тогда
				НоменклатураСсылка = РезультатНом.Ссылка;
			КонецЕсли;
		КонецЕсли;

		ПозицияАдаптера = Новый Структура;
		ПозицияАдаптера.Вставить("nomenclature_ref", НоменклатураСсылка);
		ПозицияАдаптера.Вставить("quantity", ЗначениеПоКлючу(СыраяПозиция, "quantity", 0));
		ПозицияАдаптера.Вставить("price", ЗначениеПоКлючу(СыраяПозиция, "price", 0));
		ПозицииДляАдаптера.Добавить(ПозицияАдаптера);
	КонецЦикла;

	PayloadДляАдаптера = Новый Структура;
	PayloadДляАдаптера.Вставить("client_ref", РезультатКлиента.Ссылка);
	PayloadДляАдаптера.Вставить("organization_ref", СсылкаОрганизации);
	PayloadДляАдаптера.Вставить("items", ПозицииДляАдаптера);
	PayloadДляАдаптера.Вставить("comment", СокрЛП(Строка(ЗначениеПоКлючу(Payload, "comment", ""))));

	Отказ = Ложь;
	СообщенияАдаптера = Новый Массив;
	Док = ar_АдаптерЗаполнения.СоздатьЧерновикСчёта(PayloadДляАдаптера, Отказ, СообщенияАдаптера);

	Для Каждого Сообщение Из СообщенияАдаптера Цикл
		Результат.Сообщения.Добавить(Сообщение);
	КонецЦикла;

	Если Отказ Или Док = Неопределено Тогда
		ar_СлужебныйЛог.Записать("ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта",
			"create_invoice_draft_fill_failed",
			"ApprovalId=" + ApprovalId + ": " + СтрСоединить(Результат.Сообщения, "; "),
			"Предупреждение");
		Возврат Результат;
	КонецЕсли;

	// Запись документа БЕЗ проведения (контракт ОписаниеToolСоздатьЧерновикСчёта:
	// «без проведения»). Привилегированный режим НЕ поднимается - работа в
	// правах пользователя, инициировавшего approve.
	Попытка
		Док.Записать();
	Исключение
		Результат.Сообщения.Добавить(ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ar_СлужебныйЛог.Записать("ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта",
			"create_invoice_draft_write_failed",
			"ApprovalId=" + ApprovalId + ": " + Результат.Сообщения[Результат.Сообщения.ВГраница()],
			"Ошибка");
		Возврат Результат;
	КонецПопытки;

	Результат.Выполнено = Истина;
	Результат.DocumentRef = Док.Ссылка;

	ar_СлужебныйЛог.Записать("ar_ToolДокументы.ИсполнитьСоздатьЧерновикСчёта",
		"create_invoice_draft_written",
		"ApprovalId=" + ApprovalId,
		"Информация", "", Док.Ссылка);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область GetInvoice

// Основная логика get_invoice (read-only).
Функция ПолучитьСчётВнутр(Знач Аргументы)

	// 1. Проверка наличия типа документа в метаданных (graceful, DoD D15).
	МДДокумент = Метаданные.Документы.Найти(
		ar_ToolDispatcher.ИмяОбъектаМетаданных("СчетНаОплатуПокупателю", "СчетНаОплатуПокупателю"));
	Если МДДокумент = Неопределено Тогда
		Возврат ОшибочныйJSONСДеталью("document_type_not_found",
			"СчетНаОплатуПокупателю не найден в метаданных");
	КонецЕсли;

	// 2. Десериализация аргументов.
	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	СтрокаСсылки = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "invoice_ref", "")));
	Номер = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "invoice_number", "")));

	Если ПустаяСтрока(СтрокаСсылки) И ПустаяСтрока(Номер) Тогда
		Возврат ОшибочныйJSON("invoice_ref_or_number_required");
	КонецЕсли;

	МножественныйРезультат = Ложь;
	КоличествоНайдено = 0;

	// 3. Приоритет - поиск по ссылке.
	Если НЕ ПустаяСтрока(СтрокаСсылки) Тогда
		РезультатСсылки = РазыменоватьДокументСчёт(СтрокаСсылки);
		Если РезультатСсылки.Ошибка = "wrong_document_type" Тогда
			Возврат ОшибочныйJSONСПолем("wrong_document_type", "actual_type", РезультатСсылки.ФактическийТип);
		ИначеЕсли РезультатСсылки.Ошибка <> "" Тогда
			Возврат ОшибочныйJSON("invoice_not_found");
		КонецЕсли;
		СсылкаДокумента = РезультатСсылки.Ссылка;
	Иначе
		// 4. Поиск по номеру (+ опц. дата, диапазон ±1 день).
		ДатаУточнение = РазобратьДатуISO(СокрЛП(Строка(ЗначениеПоКлючу(Объект, "invoice_date", ""))));
		РезультатПоиска = НайтиСчётПоНомеру(Номер, ДатаУточнение);
		Если РезультатПоиска.Ссылка = Неопределено Тогда
			Возврат ОшибочныйJSON("invoice_not_found");
		КонецЕсли;
		СсылкаДокумента = РезультатПоиска.Ссылка;
		МножественныйРезультат = РезультатПоиска.Множественно;
		КоличествоНайдено = РезультатПоиска.Количество;
	КонецЕсли;

	// 5. Чтение шапки + позиций в правах пользователя.
	// Отделяем реальную ошибку структуры (несуществующий реквизит в целевой
	// конфигурации - например, у демо-счёта иные имена полей) от отказа доступа:
	// раньше любое исключение маскировалось под access_denied, скрывая причину.
	Попытка
		Шапка = ПрочитатьШапкуСчёта(СсылкаДокумента, МДДокумент);
		ДанныеПозиций = ПрочитатьПозицииСчёта(СсылкаДокумента, МДДокумент);
	Исключение
		Возврат КлассифицироватьОшибкуЧтения(ИнформацияОбОшибке());
	КонецПопытки;

	// UNIV-02: предупреждения о реквизитах/ТЧ, отсутствующих в целевой
	// конфигурации (маппинг через ar_МаппингМетаданных нашёл имя, но такого
	// поля нет в метаданных) - собираются из обеих подфункций чтения.
	СобранныеПредупреждения = Новый Массив;
	Для Каждого Предупреждение Из Шапка.Предупреждения Цикл
		СобранныеПредупреждения.Добавить(Предупреждение);
	КонецЦикла;
	Для Каждого Предупреждение Из ДанныеПозиций.Предупреждения Цикл
		СобранныеПредупреждения.Добавить(Предупреждение);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("invoice_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаДокумента));
	Результат.Вставить("number", Шапка.Номер);
	Результат.Вставить("date", Шапка.Дата);
	Результат.Вставить("client_name", Шапка.КлиентИмя);
	Результат.Вставить("organization", Шапка.ОрганизацияИмя);
	Если НЕ ПустаяСтрока(Шапка.ДоговорИмя) Тогда
		Результат.Вставить("contract", Шапка.ДоговорИмя);
	КонецЕсли;
	Результат.Вставить("total", Шапка.Сумма);
	Результат.Вставить("posted", Шапка.Проведён);
	Результат.Вставить("marked_for_deletion", Шапка.ПометкаУдаления);
	Результат.Вставить("items", ДанныеПозиций.Позиции);
	Результат.Вставить("items_truncated", ДанныеПозиций.Обрезано);
	Если МножественныйРезультат Тогда
		Результат.Вставить("multiple_found", Истина);
		Результат.Вставить("count", КоличествоНайдено);
	КонецЕсли;
	Если СобранныеПредупреждения.Количество() > 0 Тогда
		Результат.Вставить("warnings", СобранныеПредупреждения);
	КонецЕсли;

	Возврат СтруктуруВJSONДокументы(Результат);

КонецФункции

// Полное имя таблицы "Документ.<ИмяВМетаданных>" для источника запроса. Имя
// объекта метаданных - с учётом переопределения (ar_ПереопределенияОбъектов,
// см. ar_ToolDispatcher.ИмяОбъектаМетаданных) - для целевой конфигурации, где
// документ называется не "СчетНаОплатуПокупателю". Алиас "Счета" в тексте
// запроса остаётся прежним - меняется только имя таблицы-источника.
Функция ИмяТаблицыСчёт()
	Возврат "Документ." + ar_ToolDispatcher.ИмяОбъектаМетаданных(
		"СчетНаОплатуПокупателю", "СчетНаОплатуПокупателю");
КонецФункции

// Поиск счёта по номеру (+ опц. дата). Возвращает Структуру:
//   { Ссылка, Множественно - Булево, Количество - Число }.
// При нескольких совпадениях - первый по убыванию даты (спека: multiple_found).
//
Функция НайтиСчётПоНомеру(Знач Номер, Знач ДатаУточнение)

	Результат = Новый Структура("Ссылка, Множественно, Количество", Неопределено, Ложь, 0);

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	" + ИмяТаблицыСчёт() + " КАК Счета
		|ГДЕ
		|	Счета.Номер = &Номер";

	Если ЗначениеЗаполнено(ДатаУточнение) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС
			+ "	И Счета.Дата МЕЖДУ &ДатаНачала И &ДатаКонца";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО Счета.Дата УБЫВ";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Номер", Номер);
	Если ЗначениеЗаполнено(ДатаУточнение) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаУточнение) - 86400);
		Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаУточнение) + 86400);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Счётчик = 0;
	Пока Выборка.Следующий() Цикл
		Счётчик = Счётчик + 1;
		Если Результат.Ссылка = Неопределено Тогда
			Результат.Ссылка = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Результат.Количество = Счётчик;
	Результат.Множественно = (Счётчик > 1);
	Возврат Результат;

КонецФункции

// Читает шапку счёта одним запросом. Поля, отсутствующие в метаданных, отдаются
// пустыми (graceful). Возвращает Структуру с реквизитами шапки и Предупреждения
// (Массив строк "attribute_not_available:<ключ>:<имя>").
//
// UNIV-02: имена трёх предметных реквизитов (клиент/договор/сумма) разрешаются
// через ar_МаппингМетаданных.ИмяРеквизита - indirection для чтения, с проверкой
// наличия в МДДокумент.Реквизиты до включения поля в текст запроса (эталонный
// паттерн - ВыполнитьСтатическиеПроверки в этом же модуле). Стандартные для
// документа поля (Номер/Дата/Организация/Проведен/ПометкаУдаления) не мапятся,
// вне объёма задачи.
//
Функция ПрочитатьШапкуСчёта(Знач Ссылка, Знач МДДокумент)

	Данные = Новый Структура;
	Данные.Вставить("Номер", "");
	Данные.Вставить("Дата", "");
	Данные.Вставить("КлиентИмя", "");
	Данные.Вставить("ОрганизацияИмя", "");
	Данные.Вставить("ДоговорИмя", "");
	Данные.Вставить("Сумма", 0);
	Данные.Вставить("Проведён", Ложь);
	Данные.Вставить("ПометкаУдаления", Ложь);
	Данные.Вставить("Предупреждения", Новый Массив);

	СхемаМаппинга = СхемаПолейШапкиСчёта(МДДокумент);
	ПоляВыборки = СобратьПоляВыборкиШапки(СхемаМаппинга, Данные.Предупреждения);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	" + ПоляВыборки + "
		|ИЗ
		|	" + ИмяТаблицыСчёт() + " КАК Счета
		|ГДЕ
		|	Счета.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ЗаполнитьДанныеШапкиИзВыборки(Данные, Выборка, СхемаМаппинга);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Разрешает через ar_МаппингМетаданных имена трёх предметных реквизитов
// шапки счёта и проверяет их фактическое наличие в метаданных. Возвращает
// Массив Структур { ЛогическийКлюч, ИмяРеквизита, АлиасРезультата,
// НужноНаименование - Булево, Есть - Булево }.
//
Функция СхемаПолейШапкиСчёта(Знач МДДокумент)

	Схема = Новый Массив;

	ЭлементКлиент = ЭлементСхемыПоляШапки("invoice.client_attribute", "Контрагент",
		"КлиентИмя", Истина, МДДокумент);
	ЭлементДоговор = ЭлементСхемыПоляШапки("invoice.contract_attribute", "ДоговорКонтрагента",
		"ДоговорИмя", Истина, МДДокумент);
	ЭлементСумма = ЭлементСхемыПоляШапки("invoice.total_attribute", "СуммаДокумента",
		"Сумма", Ложь, МДДокумент);

	Схема.Добавить(ЭлементКлиент);
	Схема.Добавить(ЭлементДоговор);
	Схема.Добавить(ЭлементСумма);

	Возврат Схема;

КонецФункции

Функция ЭлементСхемыПоляШапки(Знач ЛогическийКлюч, Знач ИмяПоУмолчанию, Знач АлиасРезультата,
	Знач НужноНаименование, Знач МДДокумент)

	ИмяРеквизита = ar_МаппингМетаданных.ИмяРеквизита(ЛогическийКлюч, ИмяПоУмолчанию);
	Элемент = Новый Структура;
	Элемент.Вставить("ЛогическийКлюч", ЛогическийКлюч);
	Элемент.Вставить("ИмяРеквизита", ИмяРеквизита);
	Элемент.Вставить("АлиасРезультата", АлиасРезультата);
	Элемент.Вставить("НужноНаименование", НужноНаименование);
	Элемент.Вставить("Есть", МДДокумент.Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
	Возврат Элемент;

КонецФункции

// Собирает список полей ВЫБРАТЬ по схеме маппинга (см. СхемаПолейШапкиСчёта),
// добавляя "attribute_not_available:..." в Предупреждения для отсутствующих
// реквизитов. Точечная навигация ".Наименование" применяется только к полям
// с НужноНаименование=Истина - семантика "показать имя текстом" сохраняется
// только для ссылочных реквизитов (клиент/договор), не для суммы.
//
Функция СобратьПоляВыборкиШапки(Знач СхемаМаппинга, Знач Предупреждения)

	ПоляВыборки = "Счета.Номер КАК Номер, Счета.Дата КАК Дата,"
		+ " Счета.Организация.Наименование КАК ОрганизацияИмя,"
		+ " Счета.Проведен КАК Проведён, Счета.ПометкаУдаления КАК ПометкаУдаления";

	Для Каждого Элемент Из СхемаМаппинга Цикл
		Если Элемент.Есть Тогда
			Если Элемент.НужноНаименование Тогда
				ПоляВыборки = ПоляВыборки + ", Счета." + Элемент.ИмяРеквизита
					+ ".Наименование КАК " + Элемент.АлиасРезультата;
			Иначе
				ПоляВыборки = ПоляВыборки + ", Счета." + Элемент.ИмяРеквизита
					+ " КАК " + Элемент.АлиасРезультата;
			КонецЕсли;
		Иначе
			Предупреждения.Добавить("attribute_not_available:" + Элемент.ЛогическийКлюч
				+ ":" + Элемент.ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоляВыборки;

КонецФункции

// Заполняет Данные (см. ПрочитатьШапкуСчёта) базовыми полями шапки, а также
// (при наличии реквизита в метаданных, СхемаМаппинга.*.Есть) полями клиента/
// договора/суммы, разрешёнными через ar_МаппингМетаданных. Обращение к полям
// выборки - прямыми именами (не динамическое), т.к. набор из трёх предметных
// полей фиксирован и невелик - динамизация полей выборки не нужна.
//
Процедура ЗаполнитьДанныеШапкиИзВыборки(Данные, Знач Выборка, Знач СхемаМаппинга)

	Данные.Номер = СокрЛП(Строка(Выборка.Номер));
	Данные.Дата = ar_Утилиты.ФорматДата(Выборка.Дата);
	Данные.ОрганизацияИмя = СокрЛП(Строка(Выборка.ОрганизацияИмя));
	Данные.Проведён = (Выборка.Проведён = Истина);
	Данные.ПометкаУдаления = (Выборка.ПометкаУдаления = Истина);

	Если ЭлементСхемыЕсть(СхемаМаппинга, "КлиентИмя") Тогда
		Данные.КлиентИмя = СокрЛП(Строка(Выборка.КлиентИмя));
	КонецЕсли;
	Если ЭлементСхемыЕсть(СхемаМаппинга, "ДоговорИмя") Тогда
		Данные.ДоговорИмя = СокрЛП(Строка(Выборка.ДоговорИмя));
	КонецЕсли;
	Если ЭлементСхемыЕсть(СхемаМаппинга, "Сумма") Тогда
		Данные.Сумма = ?(ТипЗнч(Выборка.Сумма) = Тип("Число"), Выборка.Сумма, 0);
	КонецЕсли;

КонецПроцедуры

// Возвращает Есть (Булево) элемента схемы маппинга по АлиасРезультата.
Функция ЭлементСхемыЕсть(Знач СхемаМаппинга, Знач АлиасРезультата)

	Для Каждого Элемент Из СхемаМаппинга Цикл
		Если Элемент.АлиасРезультата = АлиасРезультата Тогда
			Возврат Элемент.Есть;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Читает позиции ТЧ Товары счёта (лимит 100). Возвращает Структуру:
//   { Позиции - Массив, Обрезано - Булево, Предупреждения - Массив }.
// При отсутствии ТЧ в метаданных - пустой массив без падения (плюс
// Предупреждения += "attribute_not_available:invoice.items_table:...").
//
// UNIV-02: имя ТЧ - через ar_МаппингМетаданных.ИмяРеквизита. Колонки внутри
// ТЧ (Номенклатура/Количество/Цена/Сумма) не мапятся - вне объёма задачи.
//
Функция ПрочитатьПозицииСчёта(Знач Ссылка, Знач МДДокумент)

	Результат = Новый Структура("Позиции, Обрезано, Предупреждения", Новый Массив, Ложь, Новый Массив);

	ИмяТЧТовары = ar_МаппингМетаданных.ИмяРеквизита("invoice.items_table", "Товары");

	Если МДДокумент.ТабличныеЧасти.Найти(ИмяТЧТовары) = Неопределено Тогда
		Результат.Предупреждения.Добавить(
			"attribute_not_available:invoice.items_table:" + ИмяТЧТовары);
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 101
		|	Товары.Номенклатура.Наименование КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	" + ИмяТаблицыСчёт() + "." + ИмяТЧТовары + " КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Счётчик = 0;
	Пока Выборка.Следующий() Цикл
		Счётчик = Счётчик + 1;
		Если Счётчик > 100 Тогда
			Результат.Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Позиция = Новый Структура;
		Позиция.Вставить("nomenclature", СокрЛП(Строка(Выборка.Номенклатура)));
		Позиция.Вставить("quantity", ?(ТипЗнч(Выборка.Количество) = Тип("Число"), Выборка.Количество, 0));
		Позиция.Вставить("price", ?(ТипЗнч(Выборка.Цена) = Тип("Число"), Выборка.Цена, 0));
		Позиция.Вставить("total", ?(ТипЗнч(Выборка.Сумма) = Тип("Число"), Выборка.Сумма, 0));
		Результат.Позиции.Добавить(Позиция);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ValidateDocument

// Основная логика validate_document (read-only, статические проверки).
Функция ВалидироватьДокументВнутр(Знач Аргументы)

	// 1. Десериализация аргументов.
	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	СтрокаСсылки = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "document_ref", "")));
	Если ПустаяСтрока(СтрокаСсылки) Тогда
		Возврат ОшибочныйJSON("document_ref_required");
	КонецЕсли;

	// 2. Разыменование документа (любой тип документа).
	РезультатСсылки = РазыменоватьЛюбойДокумент(СтрокаСсылки);
	Если РезультатСсылки.Ошибка <> "" Тогда
		Возврат ОшибочныйJSON("document_not_found");
	КонецЕсли;
	СсылкаДокумента = РезультатСсылки.Ссылка;
	ИмяТипа = РезультатСсылки.ИмяТипа;

	// 3. Проверка соответствия указанного document_type.
	УказанныйТип = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "document_type", "")));
	НесовпадениеТипа = "";
	Если НЕ ПустаяСтрока(УказанныйТип) Тогда
		ОжидаемоеИмя = СтрЗаменить(УказанныйТип, "Документ.", "");
		Если НРег(ОжидаемоеИмя) <> НРег(ИмяТипа) Тогда
			НесовпадениеТипа = "document_type_mismatch";
		КонецЕсли;
	КонецЕсли;

	МДДокумент = Метаданные.Документы.Найти(ИмяТипа);

	// 4. Статические проверки.
	Попытка
		ПроверкиРезультат = ВыполнитьСтатическиеПроверки(СсылкаДокумента, МДДокумент, ИмяТипа);
	Исключение
		Возврат ОшибочныйJSON("access_denied");
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("document_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(СсылкаДокумента));
	Результат.Вставить("document_type", "Документ." + ИмяТипа);
	Результат.Вставить("valid", ПроверкиРезультат.Ошибки.Количество() = 0);
	Результат.Вставить("errors", ПроверкиРезультат.Ошибки);
	Результат.Вставить("warnings", ПроверкиРезультат.Предупреждения);
	Если ПроверкиРезультат.ТипНеизвестен Тогда
		Результат.Вставить("type_unknown", Истина);
	КонецЕсли;
	Если НЕ ПустаяСтрока(НесовпадениеТипа) Тогда
		Результат.Вставить("warning_code", НесовпадениеТипа);
	КонецЕсли;

	Возврат СтруктуруВJSONДокументы(Результат);

КонецФункции

// Выполняет набор статических проверок документа. Возвращает Структуру:
//   { Ошибки - Массив, Предупреждения - Массив, ТипНеизвестен - Булево }.
// Каждый элемент Ошибки/Предупреждения - Структура {field, message}.
//
Функция ВыполнитьСтатическиеПроверки(Знач Ссылка, Знач МДДокумент, Знач ИмяТипа)

	Результат = Новый Структура("Ошибки, Предупреждения, ТипНеизвестен",
		Новый Массив, Новый Массив, Ложь);

	Если МДДокумент = Неопределено Тогда
		// Нестандартная конфигурация - только базовые проверки (дата, пометка).
		Результат.ТипНеизвестен = Истина;
		ДобавитьБазовыеПроверки(Ссылка, ИмяТипа, Результат);
		Возврат Результат;
	КонецЕсли;

	ЕстьКонтрагент = (МДДокумент.Реквизиты.Найти("Контрагент") <> Неопределено);
	ЕстьОрганизация = (МДДокумент.Реквизиты.Найти("Организация") <> Неопределено);
	ЕстьДоговор = (МДДокумент.Реквизиты.Найти("ДоговорКонтрагента") <> Неопределено);
	ЕстьСумма = (МДДокумент.Реквизиты.Найти("СуммаДокумента") <> Неопределено);
	ЕстьТЧТовары = (МДДокумент.ТабличныеЧасти.Найти("Товары") <> Неопределено);

	// Сбор полей шапки одним запросом.
	ПоляВыборки = "Док.Дата КАК Дата, Док.ПометкаУдаления КАК ПометкаУдаления";
	Если ЕстьКонтрагент Тогда
		ПоляВыборки = ПоляВыборки + ", Док.Контрагент КАК Контрагент";
	КонецЕсли;
	Если ЕстьОрганизация Тогда
		ПоляВыборки = ПоляВыборки + ", Док.Организация КАК Организация";
	КонецЕсли;
	Если ЕстьДоговор Тогда
		ПоляВыборки = ПоляВыборки + ", Док.ДоговорКонтрагента КАК ДоговорКонтрагента";
	КонецЕсли;
	Если ЕстьСумма Тогда
		ПоляВыборки = ПоляВыборки + ", Док.СуммаДокумента КАК СуммаДокумента";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 " + ПоляВыборки + Символы.ПС
		+ "ИЗ Документ." + ИмяТипа + " КАК Док" + Символы.ПС
		+ "ГДЕ Док.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ДобавитьЗапись(Результат.Ошибки, "Ссылка", "Документ не найден или недоступен");
		Возврат Результат;
	КонецЕсли;

	// Дата.
	Если НЕ ЗначениеЗаполнено(Выборка.Дата) Тогда
		ДобавитьЗапись(Результат.Ошибки, "Дата", "Дата документа не заполнена");
	КонецЕсли;

	// Контрагент.
	Если ЕстьКонтрагент И НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
		ДобавитьЗапись(Результат.Ошибки, "Контрагент", "Контрагент не заполнен");
	КонецЕсли;

	// Организация.
	Если ЕстьОрганизация И НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
		ДобавитьЗапись(Результат.Ошибки, "Организация", "Организация не заполнена");
	КонецЕсли;

	// Договор (предупреждение).
	Если ЕстьДоговор И НЕ ЗначениеЗаполнено(Выборка.ДоговорКонтрагента) Тогда
		ДобавитьЗапись(Результат.Предупреждения, "ДоговорКонтрагента",
			"Договор не заполнен - счёт будет без привязки к договору");
	КонецЕсли;

	// Сумма.
	Если ЕстьСумма И ?(ТипЗнч(Выборка.СуммаДокумента) = Тип("Число"), Выборка.СуммаДокумента, 0) <= 0 Тогда
		ДобавитьЗапись(Результат.Ошибки, "СуммаДокумента", "Сумма документа должна быть больше нуля");
	КонецЕсли;

	// Позиции ТЧ Товары.
	Если ЕстьТЧТовары Тогда
		ПроверитьПозицииТовары(Ссылка, ИмяТипа, Результат);
	КонецЕсли;

	// Пометка удаления - предупреждение.
	Если Выборка.ПометкаУдаления = Истина Тогда
		ДобавитьЗапись(Результат.Предупреждения, "ПометкаУдаления", "Документ помечен на удаление");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Базовые проверки для документа неизвестного типа (только дата + пометка).
Процедура ДобавитьБазовыеПроверки(Знач Ссылка, Знач ИмяТипа, Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Дата КАК Дата,
		|	Док.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ." + ИмяТипа + " КАК Док
		|ГДЕ
		|	Док.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если НЕ ЗначениеЗаполнено(Выборка.Дата) Тогда
			ДобавитьЗапись(Результат.Ошибки, "Дата", "Дата документа не заполнена");
		КонецЕсли;
		Если Выборка.ПометкаУдаления = Истина Тогда
			ДобавитьЗапись(Результат.Предупреждения, "ПометкаУдаления", "Документ помечен на удаление");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Проверка непустоты ТЧ Товары (для документов с этой ТЧ).
Процедура ПроверитьПозицииТовары(Знач Ссылка, Знач ИмяТипа, Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Товары.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяТипа + ".Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Если Запрос.Выполнить().Пустой() Тогда
		ДобавитьЗапись(Результат.Ошибки, "Товары", "Табличная часть «Товары» пуста");
	КонецЕсли;

КонецПроцедуры

// Добавляет запись {field, message} в массив ошибок/предупреждений.
Процедура ДобавитьЗапись(Массив, Знач Поле, Знач Сообщение)
	Запись = Новый Структура;
	Запись.Вставить("field", Поле);
	Запись.Вставить("message", Сообщение);
	Массив.Добавить(Запись);
КонецПроцедуры

#КонецОбласти

#Область ReconciliationAct

// Основная логика create_reconciliation_act (RECON-01). Выделена из
// СоздатьАктСверки, чтобы внешний Попытка/Исключение ловил любые
// непредвиденные ошибки (DoD «check_1c_code без Error»).
//
// Алгоритм (см. .docs/specs/RECON-01.md, §create_reconciliation_act):
//  1. DryRun (DISP-03).
//  2. Десериализация + валидация client_ref (обязателен).
//  3. Разыменование client_ref/organization_ref (переиспользует
//     РазыменоватьСсылкуКонтрагента/РазыменоватьОрганизацию). ОБА обязательны:
//     дефолт «основная организация» убран, см. шаг разыменования организации.
//  4. Порог свежести: последний не помеченный на удаление акт сверки для пары
//     (Организация, Контрагент) по убыванию ДатаОкончания. Если найден и
//     ДатаОкончания >= ДобавитьМесяц(ТекущаяДата, -stale_after_months) и НЕ
//     force → {"status":"skipped","reason":"recent_act_exists",...}.
//  5. Вызов ar_АдаптерЗаполнения.СоздатьАктСверки (родное Заполнить(), период
//     НЕ дублируется - УстановитьПериодСверки вызывается внутри Заполнить()).
//  6. Запись объекта БЕЗ проведения (контракт спеки: «без проведения», без
//     approval - решение пользователя зафиксировано в докстринге СоздатьАктСверки).
//
Функция СоздатьАктСверкиВнутр(Знач Аргументы, Знач Контекст)

	// 1. DryRun (DISP-03) вычисляется здесь, но выход по нему - НИЖЕ, после
	// разбора и валидации аргументов. Раньше заглушка возвращалась сразу, и
	// dry-run-вызов не проверял аргументы вовсе: предпроверка перед очередью
	// approval (ar_RuntimeЦикл.ПредпроверкаДействия) получала «успех» и
	// пропускала заведомо невыполнимое действие к пользователю на подтверждение.
	ЭтоDryRun = ar_ToolDispatcher.ИзвлечьDryRun(Аргументы);

	// 2. Десериализация аргументов.
	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSON("invalid_json_arguments");
	КонецЕсли;

	СтрокаКлиента = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "client_ref", "")));
	Если ПустаяСтрока(СтрокаКлиента) Тогда
		Возврат ОшибочныйJSON("client_not_found");
	КонецЕсли;

	// 3. Разыменование контрагента (обязателен).
	РезультатКлиента = РазыменоватьСсылкуКонтрагента(СтрокаКлиента);
	Если РезультатКлиента.Ошибка <> "" Тогда
		Возврат ОшибочныйJSON(РезультатКлиента.Ошибка);
	КонецЕсли;
	СсылкаКлиента = РезультатКлиента.Ссылка;

	// Разыменование организации - ОБЯЗАТЕЛЬНА. Раньше она была опциональной, и
	// при отсутствии типовое Заполнить() молча подставляло основную организацию
	// пользователя. Для акта сверки это опасный дефолт: сальдо контрагента может
	// быть по другому юрлицу, и документ создавался пустым, выглядя при этом
	// успешно созданным (реальный случай: Шилов ПБОЮЛ, сальдо по «Торговому дому
	// "Комплексный"», акт ушёл на основную организацию).
	// organization_inn - предпочтительный способ задать организацию: ИНН модель
	// переносит из данных дословно, а навигационные ссылки регулярно кладёт не
	// в тот аргумент (реальный случай: ссылка на контрагента в organization_ref,
	// из-за чего акты ушли по чужим контрагентам).
	СсылкаОрганизации = Неопределено;
	СтрокаИННОрганизации = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "organization_inn", "")));
	Если Не ПустаяСтрока(СтрокаИННОрганизации) Тогда
		РезультатПоИНН = ar_ToolФинансы.НайтиОрганизациюПоИННЭкспорт(СтрокаИННОрганизации);
		Если РезультатПоИНН.Ошибка <> "" Тогда
			// Деталь отдельно распознаёт «сюда передали ИНН контрагента» -
			// именно так промахивалась LLM; без подсказки она повторяет вызов.
			Возврат ОшибочныйJSONСДеталью(РезультатПоИНН.Ошибка,
				ar_ToolФинансы.ДетальНенайденнойОрганизацииЭкспорт(
					СтрокаИННОрганизации, РезультатПоИНН.Ошибка));
		КонецЕсли;
		СсылкаОрганизации = РезультатПоИНН.Ссылка;
	КонецЕсли;

	// Ссылка на организацию не принимается - только ИНН (см. докстринг блока
	// выше). Старый ключ распознаём, чтобы объяснить, а не молча пропустить.
	СтрокаОрганизацииУстар = СокрЛП(Строка(ЗначениеПоКлючу(Объект, "organization_ref", "")));
	Если СсылкаОрганизации = Неопределено И Не ПустаяСтрока(СтрокаОрганизацииУстар) Тогда
		Возврат ОшибочныйJSONСДеталью("organization_ref_not_supported",
			НСтр("ru='Организация задаётся только по ИНН - передай"
				+ " organization_inn. Аргумент organization_ref больше не"
				+ " поддерживается. ИНН возьми из поля organization_inn в"
				+ " by_contragent (find_overdue_receivables). ИНН контрагента"
				+ " из search_clients сюда класть НЕЛЬЗЯ.';"
				+ " en='Organization is specified by INN only: pass"
				+ " organization_inn. organization_ref is no longer supported.'"));
	КонецЕсли;

	Если СсылкаОрганизации = Неопределено Тогда
		Возврат ОшибочныйJSONСДеталью("organization_required",
			НСтр("ru='Не указана организация. Сальдо контрагента может быть по"
				+ " нескольким юрлицам, и выбрать его за вас нельзя."
				+ " НЕ СПРАШИВАЙ ИНН организации у пользователя - определи его"
				+ " сам. Следующий шаг: вызови find_overdue_receivables с"
				+ " аргументами {""account"":""62"",""contragent_inn"":""<ИНН"
				+ " контрагента из search_clients>""} - организацию в нём НЕ"
				+ " указывай. В ответе, в блоке by_contragent, будет строка на"
				+ " каждую организацию с долгом и её organization_inn; повтори"
				+ " создание акта с этим organization_inn (по акту на каждую"
				+ " организацию, если их несколько).';"
				+ " en='Organization is required: pass organization_inn."
				+ " Do NOT ask the user for it. Next step: call"
				+ " find_overdue_receivables with"
				+ " {""account"":""62"",""contragent_inn"":""<INN from"
				+ " search_clients>""} and no organization filter; by_contragent"
				+ " returns organization_inn for every organization with debt."
				+ " Then retry this tool with that organization_inn.'"));
	КонецЕсли;

	// Выход по DryRun - ЗДЕСЬ, после того как клиент и организация разыменованы
	// и признаны валидными. Симуляция подтверждает: аргументы корректны, вызов
	// выполним. Данные ИБ при этом не изменяются - записи документа ниже нет.
	Если ЭтоDryRun Тогда
		Возврат ar_ToolDispatcher.СформироватьDryRunJSON("buh_create_reconciliation_act", Неопределено);
	КонецЕсли;

	Force = (ЗначениеПоКлючу(Объект, "force", Ложь) = Истина);

	СтароеПорогМесяцев = 1;
	СыроеЗначениеПорога = ЗначениеПоКлючу(Объект, "stale_after_months", Неопределено);
	Если ТипЗнч(СыроеЗначениеПорога) = Тип("Число") И СыроеЗначениеПорога >= 0 Тогда
		СтароеПорогМесяцев = Цел(СыроеЗначениеПорога);
	КонецЕсли;

	// 4. Проверка порога свежести (пропускается при force).
	Если Не Force Тогда
		ПоследнийАкт = НайтиПоследнийАктСверки(СсылкаКлиента, СсылкаОрганизации);
		Если ПоследнийАкт <> Неопределено Тогда
			ГраницаУстаревания = ДобавитьМесяц(ТекущаяДатаСеанса(), -СтароеПорогМесяцев);
			Если ПоследнийАкт.ДатаОкончания >= ГраницаУстаревания Тогда
				Результат = Новый Структура;
				Результат.Вставить("status", "skipped");
				Результат.Вставить("reason", "recent_act_exists");
				Результат.Вставить("last_act_date", ar_Утилиты.ФорматДата(ПоследнийАкт.ДатаОкончания));
				Результат.Вставить("last_act_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(ПоследнийАкт.Ссылка));
				Возврат СтруктуруВJSONДокументы(Результат);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Счета учёта расчётов (опционально, по умолчанию - адаптер сам не
	// добавит "СчетаУчетаРасчетов" в ДанныеЗаполнения, и родное Заполнить()
	// возьмёт типовой набор счетов расчётов, см. ar_АдаптерБП.СоздатьАктСверки).
	Счета = Новый Массив;
	СырыеСчета = ЗначениеПоКлючу(Объект, "accounts", Неопределено);
	Если ТипЗнч(СырыеСчета) = Тип("Массив") Тогда
		Для Каждого СыройКод Из СырыеСчета Цикл
			КодСчёта = СокрЛП(Строка(СыройКод));
			Если Не ПустаяСтрока(КодСчёта) Тогда
				Счета.Добавить(КодСчёта);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	PayloadДляАдаптера = Новый Структура;
	PayloadДляАдаптера.Вставить("client_ref", СсылкаКлиента);
	PayloadДляАдаптера.Вставить("organization_ref", СсылкаОрганизации);
	PayloadДляАдаптера.Вставить("accounts", Счета);

	// 5. Родное заполнение через адаптер (двухуровневое ветвление, без
	// Выполнить()/Вычислить(), период не дублируется - см. докстринг функции).
	Отказ = Ложь;
	СообщенияАдаптера = Новый Массив;
	Док = ar_АдаптерЗаполнения.СоздатьАктСверки(PayloadДляАдаптера, Отказ, СообщенияАдаптера);

	Если Отказ Или Док = Неопределено Тогда
		Возврат ОшибочныйJSONСМассивом("fill_check_failed", СообщенияАдаптера);
	КонецЕсли;

	// 6. Запись БЕЗ проведения, БЕЗ approval (решение пользователя, см. докстринг
	// СоздатьАктСверки). Привилегированный режим НЕ поднимается - правах сессии.
	Попытка
		Док.Записать();
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("write_failed", ТекстОшибки);
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("status", "created");
	Результат.Вставить("act_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Док.Ссылка));
	// Организация и контрагент - в ответе явными именами: по одним лишь GUID
	// в ссылках ни LLM, ни пользователь не увидят, по какому юрлицу создан акт.
	Результат.Вставить("organization_name", СокрЛП(Строка(Док.Организация)));
	Результат.Вставить("contragent_name", СокрЛП(Строка(СсылкаКлиента)));
	Результат.Вставить("number", СокрЛП(Строка(Док.Номер)));
	Результат.Вставить("date", ar_Утилиты.ФорматДата(Док.Дата));
	Результат.Вставить("period_start", ar_Утилиты.ФорматДата(Док.ДатаНачала));
	Результат.Вставить("period_end", ar_Утилиты.ФорматДата(Док.ДатаОкончания));
	Результат.Вставить("total_by_org", ПривестиКЧислуДокумент(Док.ОстатокНаНачало));
	Если СообщенияАдаптера.Количество() > 0 Тогда
		Результат.Вставить("warnings", СообщенияАдаптера);
	КонецЕсли;

	Возврат СтруктуруВJSONДокументы(Результат);

КонецФункции

// Находит последний (по убыванию ДатаОкончания) не помеченный на удаление акт
// сверки для пары (Организация, Контрагент). Организация может быть
// Неопределено - в этом случае фильтр по организации не применяется (ищем
// последний акт с этим контрагентом по любой организации), что осторожнее
// в сторону "не создавать дубль", чем разрешить создание нового акта, когда
// свежий уже есть под другой организацией.
//
// Возвращаемое значение:
//  Структура { Ссылка, ДатаОкончания } | Неопределено, если актов нет.
//
Функция НайтиПоследнийАктСверки(Знач СсылкаКлиента, Знач СсылкаОрганизации)

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных(
		"АктСверкиВзаиморасчетов", "АктСверкиВзаиморасчетов");
	МДАкт = Метаданные.Документы.Найти(ИмяРеальное);
	Если МДАкт = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Акты.Ссылка КАК Ссылка,
		|	Акты.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Документ." + ИмяРеальное + " КАК Акты
		|ГДЕ
		|	Акты.Контрагент = &Контрагент
		|	И НЕ Акты.ПометкаУдаления";

	Если СсылкаОрганизации <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	И Акты.Организация = &Организация";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "	Акты.ДатаОкончания УБЫВ";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Контрагент", СсылкаКлиента);
	Если СсылкаОрганизации <> Неопределено Тогда
		Запрос.УстановитьПараметр("Организация", СсылкаОрганизации);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Ссылка, ДатаОкончания", Выборка.Ссылка, Выборка.ДатаОкончания);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Приводит значение реквизита документа к Числу (0 при Неопределено/не-число).
Функция ПривестиКЧислуДокумент(Знач Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;
КонецФункции

// JSON-строка ошибки с массивом сообщений: {"error":"<код>","messages":[...]}.
Функция ОшибочныйJSONСМассивом(Знач КодОшибки, Знач Сообщения)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Объект.Вставить("messages", Сообщения);
	Возврат СтруктуруВJSONДокументы(Объект);
КонецФункции

#КонецОбласти

#Область РазыменованиеСсылок

// Разыменовывает контрагента по строке (навигационная ссылка или UUID).
// Возвращает Структуру { Ссылка, Ошибка }. Ошибка непустая → client_not_found.
//
Функция РазыменоватьСсылкуКонтрагента(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	// Имя объекта метаданных - с учётом переопределения (ar_ПереопределенияОбъектов,
	// см. ar_ToolDispatcher.ИмяОбъектаМетаданных). Тип("СправочникСсылка."+ИмяРеальное)
	// и Справочники[ИмяРеальное] (индексация по строке) вместо статической точечной
	// нотации Тип("СправочникСсылка.Контрагенты")/Справочники.Контрагенты - последние
	// жёстко ссылаются на конкретный объект метаданных и не работают для целевой
	// конфигурации, где справочник называется иначе (например "_ДемоКонтрагенты").
	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");

	МДКонтрагенты = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДКонтрагенты = Неопределено Тогда
		Результат.Ошибка = "client_not_found";
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("СправочникСсылка." + ИмяРеальное);
	ИмяТаблицы = "Справочник." + ИмяРеальное;

	Ссылка = Неопределено;

	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Ссылка = ИзвлечьСсылкуИзНавигации(СтрокаСсылки, ТипСсылки);
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		УникИдент = ПопробоватьUUIDДокументы(СтрокаСсылки);
		Если УникИдент <> Неопределено Тогда
			КандидатСсылка = Справочники[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если СсылкаСуществует(КандидатСсылка, ИмяТаблицы) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Ссылка = Неопределено
		Или ТипЗнч(Ссылка) <> ТипСсылки
		Или НЕ СсылкаСуществует(Ссылка, ИмяТаблицы) Тогда
		Результат.Ошибка = "client_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

// Разыменовывает номенклатуру по строке. Возвращает Структуру { Наименование, Ошибка }.
Функция РазыменоватьНоменклатуру(Знач СтрокаСсылки)

	// Ссылка нужна исполнителю approved-действия (UNIV-06): адаптер заполнения
	// оперирует ссылками, а не наименованиями. Наименование остаётся для вызывающих
	// кода-путей, которым нужен только текст для payload/observation.
	Результат = Новый Структура("Ссылка, Наименование, Ошибка", Неопределено, "", "");

	// См. комментарий в РазыменоватьСсылкуКонтрагента про динамическое имя объекта.
	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Номенклатура", "Номенклатура");

	МДНоменклатура = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДНоменклатура = Неопределено Тогда
		Результат.Ошибка = "nomenclature_not_found";
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("СправочникСсылка." + ИмяРеальное);
	ИмяТаблицы = "Справочник." + ИмяРеальное;

	Ссылка = Неопределено;
	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Ссылка = ИзвлечьСсылкуИзНавигации(СтрокаСсылки, ТипСсылки);
	КонецЕсли;
	Если Ссылка = Неопределено Тогда
		УникИдент = ПопробоватьUUIDДокументы(СтрокаСсылки);
		Если УникИдент <> Неопределено Тогда
			КандидатСсылка = Справочники[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если СсылкаСуществует(КандидатСсылка, ИмяТаблицы) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Ссылка = Неопределено
		Или ТипЗнч(Ссылка) <> ТипСсылки
		Или НЕ СсылкаСуществует(Ссылка, ИмяТаблицы) Тогда
		Результат.Ошибка = "nomenclature_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Результат.Наименование = СокрЛП(Строка(Ссылка));
	Возврат Результат;

КонецФункции

// Разыменовывает организацию по строке. Возвращает Структуру
//   { Ссылка, Наименование, Ошибка } - см. комментарий в РазыменоватьНоменклатуру
//   про назначение Ссылки.
Функция РазыменоватьОрганизацию(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Наименование, Ошибка", Неопределено, "", "");

	// См. комментарий в РазыменоватьСсылкуКонтрагента про динамическое имя объекта.
	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации");

	МДОрганизации = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДОрганизации = Неопределено Тогда
		Результат.Ошибка = "organization_not_found";
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("СправочникСсылка." + ИмяРеальное);
	ИмяТаблицы = "Справочник." + ИмяРеальное;

	Ссылка = Неопределено;
	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Ссылка = ИзвлечьСсылкуИзНавигации(СтрокаСсылки, ТипСсылки);
	КонецЕсли;
	Если Ссылка = Неопределено Тогда
		УникИдент = ПопробоватьUUIDДокументы(СтрокаСсылки);
		Если УникИдент <> Неопределено Тогда
			КандидатСсылка = Справочники[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если СсылкаСуществует(КандидатСсылка, ИмяТаблицы) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Ссылка = Неопределено
		Или ТипЗнч(Ссылка) <> ТипСсылки
		Или НЕ СсылкаСуществует(Ссылка, ИмяТаблицы) Тогда
		Результат.Ошибка = "organization_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Результат.Наименование = СокрЛП(Строка(Ссылка));
	Возврат Результат;

КонецФункции

// Разыменовывает документ строго как СчетНаОплатуПокупателю. Возвращает Структуру
//   { Ссылка, Ошибка, ФактическийТип }. При несовпадении типа → "wrong_document_type".
//
Функция РазыменоватьДокументСчёт(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Ошибка, ФактическийТип", Неопределено, "", "");

	// См. комментарий в РазыменоватьСсылкуКонтрагента про динамическое имя объекта.
	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("СчетНаОплатуПокупателю", "СчетНаОплатуПокупателю");
	ТипСсылки = Тип("ДокументСсылка." + ИмяРеальное);
	ИмяТаблицы = "Документ." + ИмяРеальное;

	Ссылка = Неопределено;
	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Ссылка = ПривестиКСсылке(ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки));
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		УникИдент = ПопробоватьUUIDДокументы(СтрокаСсылки);
		Если УникИдент <> Неопределено Тогда
			КандидатСсылка = Документы[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если СсылкаСуществует(КандидатСсылка, ИмяТаблицы) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		Результат.Ошибка = "invoice_not_found";
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Ссылка) <> ТипСсылки Тогда
		Результат.Ошибка = "wrong_document_type";
		Результат.ФактическийТип = ИмяТипаОбъекта(Ссылка);
		Возврат Результат;
	КонецЕсли;

	Если НЕ СсылкаСуществует(Ссылка, ИмяТаблицы) Тогда
		Результат.Ошибка = "invoice_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

// Разыменовывает любой документ по навигационной ссылке. Возвращает Структуру
//   { Ссылка, Ошибка, ИмяТипа }. UUID без типа не поддерживается (для validate
//   document_ref ожидается навигационная ссылка).
//
Функция РазыменоватьЛюбойДокумент(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Ошибка, ИмяТипа", Неопределено, "", "");

	Ссылка = Неопределено;
	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Ссылка = ПривестиКСсылке(ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки));
	КонецЕсли;

	Если Ссылка = Неопределено Или НЕ ЭтоДокументСсылка(Ссылка) Тогда
		Результат.Ошибка = "document_not_found";
		Возврат Результат;
	КонецЕсли;

	ИмяТипа = ИмяТипаОбъекта(Ссылка);
	Если ПустаяСтрока(ИмяТипа) Или НЕ СсылкаСуществует(Ссылка, "Документ." + ИмяТипа) Тогда
		Результат.Ошибка = "document_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Результат.ИмяТипа = ИмяТипа;
	Возврат Результат;

КонецФункции

// Приводит результат ar_Утилиты.ОбъектИзНавигационнойСсылки к ссылке (на случай, если вернулся объект, а не ссылка).
Функция ПривестиКСсылке(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоДокументСсылка(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		КандидатСсылка = Значение.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ЭтоДокументСсылка(КандидатСсылка), КандидатСсылка, Неопределено);
КонецФункции

// Извлекает ссылку нужного типа из результата навигации.
Функция ИзвлечьСсылкуИзНавигации(Знач СтрокаСсылки, Знач ОжидаемыйТип)
	Ссылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
	Возврат ?(Ссылка <> Неопределено И ТипЗнч(Ссылка) = ОжидаемыйТип, Ссылка, Неопределено);
КонецФункции

// Признак: значение - ссылка на документ (любой).
Функция ЭтоДокументСсылка(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Метаданное = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если Метаданное = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Метаданные.Документы.Содержит(Метаданное);
КонецФункции

// Возвращает короткое имя типа метаданных ссылки ("СчетНаОплатуПокупателю").
Функция ИмяТипаОбъекта(Знач Ссылка)
	Метаданное = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Возврат ?(Метаданное = Неопределено, "", Метаданное.Имя);
КонецФункции

// Безопасно разбирает строку как УникальныйИдентификатор. Неопределено при ошибке.
Функция ПопробоватьUUIDДокументы(Знач Строка)
	Попытка
		Возврат Новый УникальныйИдентификатор(Строка);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Проверяет существование объекта по ссылке через запрос к указанной таблице.
Функция СсылкаСуществует(Знач Ссылка, Знач ИмяТаблицы)
	Если Ссылка = Неопределено Или НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка" + Символы.ПС
		+ "ИЗ " + ИмяТаблицы + " КАК Т" + Символы.ПС
		+ "ГДЕ Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

// Разбирает дату ISO 8601 (YYYY-MM-DD). Пустая дата при ошибке.
Функция РазобратьДатуISO(Знач СтрокаДаты)
	Если ПустаяСтрока(СтрокаДаты) Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Чистая = СтрЗаменить(СтрЗаменить(СтрокаДаты, "-", ""), ":", "");
		Чистая = СтрЗаменить(Чистая, "T", "");
		Чистая = СтрЗаменить(Чистая, " ", "");
		Если СтрДлина(Чистая) >= 8 Тогда
			Возврат Дата(Лев(Чистая, 8));
		КонецЕсли;
	Исключение
		Возврат '00010101';
	КонецПопытки;
	Возврат '00010101';
КонецФункции

// Полное имя таблицы "Справочник.<ИмяВМетаданных>" для источника запроса.
// Имя объекта метаданных - с учётом переопределения (ar_ПереопределенияОбъектов,
// см. ar_ToolDispatcher.ИмяОбъектаМетаданных).
Функция ИмяТаблицыКонтрагентыДокументы()
	Возврат "Справочник." + ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");
КонецФункции

// Читает наименование контрагента (в правах пользователя).
Функция ПрочитатьНаименованиеКонтрагента(Знач Ссылка)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Наименование КАК Наименование
		|ИЗ
		|	" + ИмяТаблицыКонтрагентыДокументы() + " КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Наименование));
	КонецЕсли;
	Возврат "";
КонецФункции

