	Свойства.Вставить("comment", СвойствоСхемыДокументы("string",
		"Комментарий к счёту (опционально, до 1000 симв.)"));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("required", СписокИзСтрок2("client_ref", "items"));
	Параметры.Вставить("properties", Свойства);

	Возврат ОбернутьВOpenAIФорматДокументы("buh_create_invoice_draft",
