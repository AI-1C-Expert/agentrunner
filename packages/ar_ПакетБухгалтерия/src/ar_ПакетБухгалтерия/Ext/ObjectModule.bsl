	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);

	Возврат ОбернутьВOpenAIФорматФинансы("buh_search_organizations",
		"Поиск НАШИХ ОРГАНИЗАЦИЙ (юрлиц, от имени которых ведётся учёт) по"
		+ " части наименования или ИНН. Возвращает name/inn/kpp - подставляй"
		+ " полученный inn в organization_inn финансовых tools"
