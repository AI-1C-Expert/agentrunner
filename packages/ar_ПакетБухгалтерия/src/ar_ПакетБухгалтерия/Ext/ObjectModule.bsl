// Основная логика get_account_balance (RECON-01). Выделена из
// ПолучитьОстатокСчёта/ПросроченнаяДебиторка, чтобы внешний Попытка/Исключение
// в вызывающих функциях ловил любые непредвиденные ошибки (DoD «check_1c_code
// без Error»), и чтобы ПросроченнаяДебиторка могла переиспользовать этот же
// внутренний расчёт с пресетными account/only_debit.
//
// Алгоритм:
//  1. Десериализация аргументов, дефолты (account="62", limit=50).
//  2. Разыменование плана счетов "Хозрасчетный" (через ar_ToolDispatcher.
//     ИмяОбъектаМетаданных - переносимость на случай переопределения имени).
//  3. Поиск счёта по коду (ПланыСчетов.<Хозрасчетный>.НайтиПоКоду).
//  4. Опциональное разыменование organization_ref (graceful - при ошибке
//     фильтр по организации просто не применяется, warning в ответе).
//  5. Запрос к виртуальной таблице ОстаткиИОбороты в разрезе Субконто1/
//     Субконто2 (если состав субконто счёта - ровно 2, первое ссылочное).
//     При ином составе - сальдо без детализации (WithoutDetail) + warning.
//  6. Сборка JSON-ответа (см. .docs/specs/RECON-01.md, §get_account_balance).
//
Функция ПолучитьОстатокСчётаВнутр(Знач Аргументы)

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат ОшибочныйJSONФинансы("invalid_json_arguments");
	КонецЕсли;

	КодСчёта = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "account", "62")));
	Если ПустаяСтрока(КодСчёта) Тогда
		КодСчёта = "62";
	КонецЕсли;

	ТолькоДебет = (ЗначениеПоКлючуФинансы(Объект, "only_debit", Ложь) = Истина);

	Лимит = 50;
	СыройЛимит = ЗначениеПоКлючуФинансы(Объект, "limit", Неопределено);
	Если ТипЗнч(СыройЛимит) = Тип("Число") Тогда
		ЦелыйЛимит = Цел(СыройЛимит);
		Если ЦелыйЛимит >= 1 И ЦелыйЛимит <= 200 Тогда
			Лимит = ЦелыйЛимит;
		КонецЕсли;
	КонецЕсли;

	ДатаОстатков = ТекущаяДатаСеанса();
	СтрокаДаты = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "date", "")));
	Если Не ПустаяСтрока(СтрокаДаты) Тогда
		РазобраннаяДата = ar_Утилиты.ДатаИзСтроки(СтрокаДаты);
		Если ЗначениеЗаполнено(РазобраннаяДата) Тогда
			ДатаОстатков = РазобраннаяДата;
		КонецЕсли;
	КонецЕсли;

	Предупреждения = Новый Массив;

	// Неизвестные аргументы - в warnings, а не молча в мусор. Раньше лишний ключ
	// игнорировался, и вызов вида {"account":"62","client_ref":"..."} возвращал
	// сальдо по ВСЕЙ базе с success=true: LLM принимала это за данные одного
	// контрагента и выдавала чужие суммы как его собственные. Тихий отказ хуже
	// явной ошибки - теперь о нём видно в ответе (системный промпт, правило 9).
	ДобавитьПредупрежденияОНеизвестныхКлючах(Объект, Предупреждения);

	// 2-3. План счетов + счёт по коду.
	ИмяПланаСчетов = ar_ToolDispatcher.ИмяОбъектаМетаданных("Хозрасчетный", "Хозрасчетный");
	МДПланСчетов = Метаданные.ПланыСчетов.Найти(ИмяПланаСчетов);
	Если МДПланСчетов = Неопределено Тогда
		Возврат ОшибочныйJSONФинансы("chart_of_accounts_not_found");
	КонецЕсли;

	Счёт = Неопределено;
	Попытка
		Счёт = ПланыСчетов[ИмяПланаСчетов].НайтиПоКоду(КодСчёта);
	Исключение
		Счёт = Неопределено;
	КонецПопытки;

	Если Счёт = Неопределено Или Не ЗначениеЗаполнено(Счёт) Тогда
		Возврат ОшибочныйJSONСДетальюФинансы("account_not_found", КодСчёта);
	КонецЕсли;

	// 4. Организация (опционально).
	//
	// ВХОД ТОЛЬКО ПО ИНН. Приём организации навигационной ссылкой убран
	// намеренно: за четыре прогона LLM ни разу не передала organization_ref
	// корректно - клала туда ссылку на контрагента, потом голый ИНН
	// контрагента. Каждый раз это возвращало всю базу под видом данных по
	// одному контрагенту, а однажды привело к созданию актов сверки по чужим
	// контрагентам (включая гос. органы). Латание частных случаев (проверка
	// типа ссылки, проверка формата) закрывало ровно пойманный промах и не
	// закрывало следующий, поэтому убран сам класс ошибки: ИНН модель берёт
	// из search_clients дословно и не путает - это видно по логам, контрагента
	// она находит верно каждый раз.
	//
	// Любой отказ разыменования - ЖЁСТКАЯ ОШИБКА, не warning: пользователь
	// просил конкретную организацию, и вернуть вместо неё всю базу нельзя.
	СсылкаОрганизации = Неопределено;
	СтрокаИННОрганизации = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "organization_inn", "")));
	// Наименование - запасной путь: пользователь называет организацию словами,
	// а ИНН модели взять неоткуда (search_clients ищет контрагентов, не наши
	// юрлица). Приоритет у ИНН: он однозначен, наименование - нет.
	СтрокаИмениОрганизации = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "organization_name", "")));

	// Ссылку больше не принимаем, но старый ключ распознаём - чтобы объяснить,
	// а не молча проигнорировать. Если организация при этом задана рабочим
	// способом (ИНН или наименование), лишний ключ не повод отказывать - он
	// уйдёт в warnings как неизвестный аргумент.
	СтрокаОрганизацииУстар = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "organization_ref", "")));
	Если Не ПустаяСтрока(СтрокаОрганизацииУстар)
		И ПустаяСтрока(СтрокаИННОрганизации)
		И ПустаяСтрока(СтрокаИмениОрганизации) Тогда
		Возврат ОшибочныйJSONСДетальюФинансы("organization_ref_not_supported",
			НСтр("ru='Организация задаётся только по ИНН - передай"
				+ " organization_inn. Аргумент organization_ref больше не"
				+ " поддерживается. Внимание: ИНН или ссылка контрагента (из"
				+ " search_clients) сюда класть НЕЛЬЗЯ - для контрагента есть"
				+ " contragent_inn / contragent_ref."
				+ " ЕСЛИ НУЖЕН ДОЛГ ОДНОГО КОНТРАГЕНТА ПО ВСЕМ ОРГАНИЗАЦИЯМ -"
				+ " повтори вызов с contragent_inn (или contragent_ref) и БЕЗ"
				+ " organization_*: организация - необязательный аргумент, а в"
				+ " ответе by_contragent придут все организации с долгом и их"
				+ " organization_inn. Спрашивать ИНН организации у пользователя"
				+ " для этого НЕ нужно.';"
				+ " en='Organization is specified by INN only: pass"
				+ " organization_inn. organization_ref is no longer supported."
				+ " Do not pass a counterparty INN/ref here - use contragent_inn."
				+ " For one counterparty across all organizations, retry with"
				+ " contragent_inn and no organization filter: it is optional,"
				+ " and by_contragent returns every organization with its INN.'"));
	КонецЕсли;

	Если Не ПустаяСтрока(СтрокаИННОрганизации) Тогда
		РезультатПоИНН = НайтиОрганизациюПоИНН(СтрокаИННОрганизации);
		Если РезультатПоИНН.Ошибка <> "" Тогда
			Возврат ОшибочныйJSONСДетальюФинансы(РезультатПоИНН.Ошибка,
				ДетальНенайденнойОрганизации(СтрокаИННОрганизации, РезультатПоИНН.Ошибка));
		КонецЕсли;
		СсылкаОрганизации = РезультатПоИНН.Ссылка;
	ИначеЕсли Не ПустаяСтрока(СтрокаИмениОрганизации) Тогда
		РезультатПоИмени = НайтиОрганизациюПоНаименованию(СтрокаИмениОрганизации);
		Если РезультатПоИмени.Ошибка <> "" Тогда
			Возврат ОшибочныйJSONСДетальюФинансы(РезультатПоИмени.Ошибка,
				ДетальОрганизацииПоНаименованию(СтрокаИмениОрганизации,
					РезультатПоИмени.Ошибка, РезультатПоИмени.Кандидаты));
		КонецЕсли;
		СсылкаОрганизации = РезультатПоИмени.Ссылка;
	КонецЕсли;

	// 4б. Контрагент (опционально) - отбор по Субконто1 прямо в запросе.
	// Так же, как организация: вход по ИНН (contragent_inn / client_inn).
	// Ссылка (contragent_ref / client_ref) ПОКА принимается - в отличие от
	// организации, по ней LLM не ошибалась ни разу, а items/by_contragent
	// возвращают contragent_ref, и его переиспользование - штатный сценарий.
	СсылкаКонтрагента = Неопределено;

	СтрокаИННКонтрагента = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "contragent_inn", "")));
	Если ПустаяСтрока(СтрокаИННКонтрагента) Тогда
		СтрокаИННКонтрагента = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "client_inn", "")));
	КонецЕсли;

	Если Не ПустаяСтрока(СтрокаИННКонтрагента) Тогда
		РезультатКонтрИНН = НайтиКонтрагентаПоИНН(СтрокаИННКонтрагента);
		Если РезультатКонтрИНН.Ошибка <> "" Тогда
			Возврат ОшибочныйJSONСДетальюФинансы(РезультатКонтрИНН.Ошибка, СтрокаИННКонтрагента);
		КонецЕсли;
		СсылкаКонтрагента = РезультатКонтрИНН.Ссылка;
	КонецЕсли;

	Если СсылкаКонтрагента = Неопределено Тогда
		СтрокаКонтрагента = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "contragent_ref", "")));
		Если ПустаяСтрока(СтрокаКонтрагента) Тогда
			СтрокаКонтрагента = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "client_ref", "")));
		КонецЕсли;
		Если Не ПустаяСтрока(СтрокаКонтрагента) Тогда
			РезультатКонтрагента = РазыменоватьКонтрагентаФинансы(СтрокаКонтрагента);
			Если РезультатКонтрагента.Ошибка <> "" Тогда
				// Жёсткая ошибка, а не warning: фильтр запрошен - значит
				// применён или ошибка. Вся база вместо одного контрагента -
				// недопустимый ответ.
				Возврат ОшибочныйJSONСДетальюФинансы("contragent_not_found",
					ДетальНенайденногоКонтрагента(СтрокаКонтрагента));
			КонецЕсли;
			СсылкаКонтрагента = РезультатКонтрагента.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 4в. Договор (опционально) - отбор по Субконто2. Осмыслен только вместе
	// с разрезом «Договоры» у счёта; проверка этого - ниже, где известен состав
	// субконто.
	СсылкаДоговора = Неопределено;
	СтрокаДоговора = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "contract_ref", "")));
	Если Не ПустаяСтрока(СтрокаДоговора) Тогда
		РезультатДоговора = РазыменоватьДоговорФинансы(СтрокаДоговора);
		Если РезультатДоговора.Ошибка <> "" Тогда
			// Жёстко, как и остальные фильтры: запрошенный отбор либо
			// применяется, либо вызов отклоняется.
			Возврат ОшибочныйJSONСДетальюФинансы("contract_not_found", СтрокаДоговора);
		КонецЕсли;
		СсылкаДоговора = РезультатДоговора.Ссылка;
	КонецЕсли;

	// 4г. Документ расчётов - Субконто3. Тип ссылки заранее не известен (это
	// любой документ расчётов: реализация, поступление, платёжка...), поэтому
	// разыменование идёт универсальным ОбъектИзНавигационнойСсылки без проверки
	// конкретного типа - в отличие от контрагента/договора.
	СсылкаДокумента = Неопределено;
	СтрокаДокументаРасчётов = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "settlement_document_ref", "")));
	Если ПустаяСтрока(СтрокаДокументаРасчётов) Тогда
		СтрокаДокументаРасчётов = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "document_ref", "")));
	КонецЕсли;
	Если Не ПустаяСтрока(СтрокаДокументаРасчётов) Тогда
		Попытка
			КандидатДокумент = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаДокументаРасчётов);
		Исключение
			КандидатДокумент = Неопределено;
		КонецПопытки;
		Если КандидатДокумент = Неопределено Или Не ЗначениеЗаполнено(КандидатДокумент) Тогда
			Возврат ОшибочныйJSONСДетальюФинансы("settlement_document_not_found",
				СтрокаДокументаРасчётов);
		КонецЕсли;
		СсылкаДокумента = КандидатДокумент;
	КонецЕсли;

	// 5. Определить виды субконто счёта ПО ИМЕНИ, а не по их количеству.
	// Раньше требовалось ровно 2 вида субконто, из-за чего типовой счёт 62 БП
	// (Контрагенты + Договоры + ДокументыРасчётовСКонтрагентом = 3 вида) уходил
	// в ветку без детализации с warning subconto_composition_unsupported.
	// Детализация возможна, если у счёта есть вид субконто "Контрагенты";
	// "Договоры" опциональны (для счетов без договорного разреза).
	ВидыСубконтоСчёта = ИменаВидовСубконтоСчёта(Счёт);
	ЕстьСубконтоКонтрагенты = (ВидыСубконтоСчёта.Найти("Контрагенты") <> Неопределено);
	ЕстьСубконтоДоговоры = (ВидыСубконтоСчёта.Найти("Договоры") <> Неопределено);
	// Имя предопределённого элемента ПВХ - именно во множественном числе
	// [Реф: БП/CommonModules/БухгалтерскиеОтчеты:4235,
	// ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами].
	ЕстьСубконтоДокументы = (ВидыСубконтоСчёта.Найти("ДокументыРасчетовСКонтрагентами") <> Неопределено);

	// Количество/валютная сумма - небалансовые ресурсы Хозрасчетного, привязанные
	// к признакам учёта счёта (Количественный/Валютный). У счёта без признака они
	// всегда нули, и отдавать их в observation - значит подсовывать LLM пустые
	// поля, которые она может принять за настоящий нулевой остаток.
	// Признаки читаются со счёта [Реф: БП/CommonModules/БухгалтерскиеОтчеты,
	// ВыборкаСчета.Количественный / .Валютный].
	ЕстьКоличественныйУчёт = ПризнакУчётаСчёта(Счёт, "Количественный");
	ЕстьВалютныйУчёт = ПризнакУчётаСчёта(Счёт, "Валютный");

	ЕстьДетализацияПоСубконто = ЕстьСубконтоКонтрагенты;
	Если Не ЕстьДетализацияПоСубконто Тогда
		Предупреждения.Добавить("subconto_composition_unsupported");
	КонецЕсли;

	// Ошибка выполнения запроса - НЕ обязательно отказ в правах: это может быть
	// и ошибка компиляции текста запроса (неверный разрез субконто, отсутствующее
	// поле виртуальной таблицы). Раньше любое исключение маскировалось под
	// access_denied, из-за чего настоящая причина не доходила ни до LLM, ни в лог.
	Попытка
		Если ЕстьДетализацияПоСубконто Тогда
			// Отбор по договору возможен только при наличии разреза «Договоры».
			Если СсылкаДоговора <> Неопределено И Не ЕстьСубконтоДоговоры Тогда
				Предупреждения.Добавить("contract_filter_unsupported");
				СсылкаДоговора = Неопределено;
			КонецЕсли;
			// Разрез по документу расчётов запрашивается ТОЛЬКО когда по нему
			// задан фильтр: иначе каждая пара контрагент+договор развернулась бы
			// на все свои документы расчётов и выдача разрослась бы кратно.
			Если СсылкаДокумента <> Неопределено И Не ЕстьСубконтоДокументы Тогда
				Предупреждения.Добавить("settlement_document_filter_unsupported");
				СсылкаДокумента = Неопределено;
			КонецЕсли;
			РезультатЗапроса = ВыполнитьЗапросОстатковССубконто(
				Счёт, ДатаОстатков, СсылкаОрганизации, ЕстьСубконтоДоговоры,
				СсылкаКонтрагента, СсылкаДоговора, СсылкаДокумента);
		Иначе
			// Без разреза по субконто отборы по ним невозможны - сообщаем,
			// чтобы фильтр не выглядел применённым.
			Если СсылкаКонтрагента <> Неопределено Тогда
				Предупреждения.Добавить("contragent_filter_unsupported");
			КонецЕсли;
			Если СсылкаДоговора <> Неопределено Тогда
				Предупреждения.Добавить("contract_filter_unsupported");
			КонецЕсли;
			Если СсылкаДокумента <> Неопределено Тогда
				Предупреждения.Добавить("settlement_document_filter_unsupported");
			КонецЕсли;
			РезультатЗапроса = ВыполнитьЗапросОстатковБезДетализации(Счёт, ДатаОстатков, СсылкаОрганизации);
		КонецЕсли;
	Исключение

		ИнформацияОшибки = ИнформацияОбОшибке();
		ТекстОшибкиЗапроса = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОшибки);

		ar_СлужебныйЛог.Записать(
			"ar_ToolФинансы.ПолучитьОстатокСчётаВнутр",
			"account_balance_query_failed",
			ТекстОшибкиЗапроса
				+ Символы.ПС + "Счёт=" + КодСчёта
				+ ", ЕстьДетализацияПоСубконто=" + Строка(ЕстьДетализацияПоСубконто)
				+ ", ЕстьСубконтоДоговоры=" + Строка(ЕстьСубконтоДоговоры)
				+ ", ВидыСубконто=" + СтрСоединить(ВидыСубконтоСчёта, ","),
			"Ошибка");

		// Отказ в правах отличаем по признакам платформы, остальное - query_failed
		// с кратким текстом ошибки, чтобы LLM могла объяснить проблему пользователю.
		Если ЭтоОшибкаПравДоступа(ТекстОшибкиЗапроса) Тогда
			Возврат ОшибочныйJSONФинансы("access_denied");
		КонецЕсли;

		Возврат ОшибочныйJSONСДетальюФинансы("query_failed",
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОшибки)));

	КонецПопытки;

	// 6. Сборка ответа.
	Элементы = Новый Массив;
	ВсегоНайдено = 0;
	ВсегоДебетСальдо = 0;
	ВсегоКредитСальдо = 0;
	СводКонтрагентов = Новый Соответствие;

	Пока РезультатЗапроса.Следующий() Цикл

		СальдоНачальноеДт = ПривестиКЧислу(РезультатЗапроса.НачальныйОстатокДт);
		СальдоНачальноеКт = ПривестиКЧислу(РезультатЗапроса.НачальныйОстатокКт);
		СальдоКонечноеДт  = ПривестиКЧислу(РезультатЗапроса.КонечныйОстатокДт);
		СальдоКонечноеКт  = ПривестиКЧислу(РезультатЗапроса.КонечныйОстатокКт);
		ОборотДт = ПривестиКЧислу(РезультатЗапроса.ОборотДт);
		ОборотКт = ПривестиКЧислу(РезультатЗапроса.ОборотКт);

		// only_debit отсекает строку, только если она пуста и по Дт, и по Кт
		// (движения были, остаток закрылся). Строку с кредитовым остатком
		// НЕ отбрасываем: у контрагента может быть долг по одному договору и
		// аванс по другому, и решение «должник или нет» принимается по сумме
		// всех его строк - это работа LLM, инструмент отдаёт сырые факты.
		// Раньше фильтр применялся к каждой строке независимо, и кредитовые
		// договоры выпадали из выдачи, завышая долг контрагента.
		Если ТолькоДебет И СальдоКонечноеДт = 0 И СальдоКонечноеКт = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Инкремент ДО обрезки: total_found показывает, сколько строк подошло
		// под условие, а не сколько уместилось в ответ (раньше поле всегда
		// равнялось длине обрезанного списка и о факте обрезки не сообщало).
		ВсегоНайдено = ВсегоНайдено + 1;

		// Итоги - по ВСЕЙ выборке, а не только по показанным строкам: иначе при
		// срабатывании лимита total_debit_balance занижался бы на хвост.
		ВсегоДебетСальдо = ВсегоДебетСальдо + СальдоКонечноеДт;
		ВсегоКредитСальдо = ВсегоКредитСальдо + СальдоКонечноеКт;

		// Свод по контрагенту накапливается ЗДЕСЬ, до обрезки по лимиту: иначе
		// у контрагента, часть строк которого не поместилась в items, свод
		// оказался бы неполным и противоречил бы собственным сырым данным.
		НакопитьСводПоКонтрагенту(СводКонтрагентов, РезультатЗапроса,
			ЕстьДетализацияПоСубконто, СальдоКонечноеДт, СальдоКонечноеКт);

		Если Элементы.Количество() >= Лимит Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("organization_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(РезультатЗапроса.Организация));
		Элемент.Вставить("organization_name", СокрЛП(Строка(РезультатЗапроса.Организация)));
		// ИНН - то, чем организация задаётся на входе. Без него в выдаче модели
		// неоткуда взять значение для повторного вызова с фильтром.
		Элемент.Вставить("organization_inn", ИННСсылки(РезультатЗапроса.Организация));
		Элемент.Вставить("account_code", СокрЛП(Строка(РезультатЗапроса.КодСчета)));
		Если ЕстьДетализацияПоСубконто Тогда
			// Движение без заполненного субконто - в ОСВ это строка "<...>".
			// Пустое имя ни о чём не говорит LLM, поэтому подписываем явно.
			Если ЗначениеЗаполнено(РезультатЗапроса.Субконто1) Тогда
				Элемент.Вставить("contragent_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(РезультатЗапроса.Субконто1));
				Элемент.Вставить("contragent_name", СокрЛП(Строка(РезультатЗапроса.Субконто1)));
			Иначе
				Элемент.Вставить("contragent_ref", "");
				Элемент.Вставить("contragent_name", НСтр("ru='<без контрагента>'; en='<no counterparty>'"));
			КонецЕсли;
			Если ЕстьСубконтоДоговоры Тогда
				Если ЗначениеЗаполнено(РезультатЗапроса.Субконто2) Тогда
					Элемент.Вставить("contract_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(РезультатЗапроса.Субконто2));
					Элемент.Вставить("contract_name", СокрЛП(Строка(РезультатЗапроса.Субконто2)));
				Иначе
					Элемент.Вставить("contract_ref", "");
					Элемент.Вставить("contract_name", НСтр("ru='<без договора>'; en='<no contract>'"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Элемент.Вставить("balance_begin_debit", СальдоНачальноеДт);
		Элемент.Вставить("balance_begin_credit", СальдоНачальноеКт);
		Элемент.Вставить("debit_turnover", ОборотДт);
		Элемент.Вставить("credit_turnover", ОборотКт);
		Элемент.Вставить("balance_debit", СальдоКонечноеДт);
		Элемент.Вставить("balance_credit", СальдоКонечноеКт);
		Если ЕстьКоличественныйУчёт Тогда
			Элемент.Вставить("quantity_debit", ПривестиКЧислу(РезультатЗапроса.КоличествоДт));
			Элемент.Вставить("quantity_credit", ПривестиКЧислу(РезультатЗапроса.КоличествоКт));
			Элемент.Вставить("quantity_turnover_debit", ПривестиКЧислу(РезультатЗапроса.КоличествоОборотДт));
			Элемент.Вставить("quantity_turnover_credit", ПривестиКЧислу(РезультатЗапроса.КоличествоОборотКт));
		КонецЕсли;
		Если ЕстьВалютныйУчёт Тогда
			Элемент.Вставить("currency_amount_debit", ПривестиКЧислу(РезультатЗапроса.ВалютнаяСуммаДт));
			Элемент.Вставить("currency_amount_credit", ПривестиКЧислу(РезультатЗапроса.ВалютнаяСуммаКт));
			Элемент.Вставить("currency_turnover_debit", ПривестиКЧислу(РезультатЗапроса.ВалютнаяСуммаОборотДт));
			Элемент.Вставить("currency_turnover_credit", ПривестиКЧислу(РезультатЗапроса.ВалютнаяСуммаОборотКт));
		КонецЕсли;

		Элементы.Добавить(Элемент);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("account", КодСчёта);
	Результат.Вставить("date", ar_Утилиты.ФорматДата(ДатаОстатков));
	Результат.Вставить("items", Элементы);
	Результат.Вставить("total_debit_balance", ВсегоДебетСальдо);
	Результат.Вставить("total_credit_balance", ВсегоКредитСальдо);
	Результат.Вставить("total_found", ВсегоНайдено);
	Результат.Вставить("returned", Элементы.Количество());
	Результат.Вставить("has_quantity", ЕстьКоличественныйУчёт);
	Результат.Вставить("has_currency", ЕстьВалютныйУчёт);
	// Строки развёрнуты по субсчетам: Дт и Кт одного контрагента НЕ свёрнуты
	// между собой. Явный флаг, чтобы LLM не приняла набор строк за итог.
	Результат.Вставить("rows_are_expanded_by_subaccount", Истина);

	// Готовый свод по контрагентам - чтобы LLM не считала арифметику сама.
	// Строится по всей выборке (до обрезки по лимиту), поэтому корректен даже
	// когда items обрезаны.
	Если ЕстьДетализацияПоСубконто Тогда
		СводМассив = СводКонтрагентовВМассив(СводКонтрагентов, ТолькоДебет);
		Результат.Вставить("by_contragent", СводМассив);
		Результат.Вставить("by_contragent_count", СводМассив.Количество());
		Результат.Вставить("answer_hint", НСтр(
			"ru='Для ответа на вопрос ""у кого долги"" используй by_contragent:"
			+ " это готовый свод (net_debt = total_debit - total_credit), уже"
			+ " отсортированный по убыванию долга. Одна строка = пара"
			+ " организация + контрагент, суммы посчитаны по всем субсчетам и"
			+ " договорам внутри этой организации. Один контрагент может"
			+ " встретиться в нескольких строках с разными организациями -"
			+ " это не дубли, складывать их между собой нельзя. Массив items -"
			+ " сырая детализация, суммировать его вручную не нужно.';"
			+ " en='Use by_contragent to answer ""who owes us"": a ready rollup"
			+ " (net_debt = total_debit - total_credit) sorted by debt"
			+ " descending. One row = organization + counterparty pair. The same"
			+ " counterparty may appear under several organizations; those are"
			+ " not duplicates and must not be summed together. The items array"
			+ " is raw detail; do not sum it manually.'"));
	КонецЕсли;
	Если ВсегоНайдено > Элементы.Количество() Тогда
		Предупреждения.Добавить("result_truncated");
	КонецЕсли;
	Если Предупреждения.Количество() > 0 Тогда
		Результат.Вставить("warnings", Предупреждения);
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Запрос к виртуальной таблице ОстаткиИОбороты счёта Хозрасчетный в разрезе
// Субконто1/Субконто2 (типовой случай - Контрагент/Договор для счёта 62).
// Ресурс регистра Хозрасчетный называется "Сумма" - имена полей виртуальной
// таблицы: СуммаНачальныйОстатокДт/Кт, СуммаОборотДт/Кт, СуммаКонечныйОстатокДт/Кт
// (Реф: паттерн onemcp accounting_register_balances - "Имена полей остатков:
// СуммаОстаток..."; для ОстаткиИОбороты суффиксы Дт/Кт добавляются к каждому
// из трёх видов сумм). Период - НачалоГода(ДатаОстатков)..КонецДня(ДатаОстатков):
// конечный остаток - "на дату" (спека RECON-01), обороты - с начала года
// (см. НачалоПериодаОборотов). Отбор по счёту - В ИЕРАРХИИ, чтобы движения
// субсчетов (62.01, 62.02, ...) попадали в результат при запросе счёта-группы 62.
//
// Дт и Кт возвращаются РАЗДЕЛЬНО (СуммаКонечныйОстатокДт/Кт), без вычитания
// одного из другого: инструмент отдаёт сырые факты, а свод под вопрос
// пользователя делает LLM. Счёт выведен в разрез (КодСчета), поэтому субсчета
// 62.01/62.21/62.22 приходят отдельными строками со своими Дт и Кт - как в
// развёрнутой ОСВ. Свёртка по контрагенту (когда 1С вычитает Кт субсчетов из
// Дт) - это ДРУГОЕ представление той же ОСВ, и считать его должен потребитель.
//
// Здесь НЕ используется СуммаКонечныйРазвернутыйОстатокДт/Кт: развёртка в 1С
// работает по субсчетам, а не внутри группировки субконто, поэтому при отборе
// «Счет В ИЕРАРХИИ (62)» она давала нули по Кт - все субсчета уже схлопнуты
// в одну строку до того, как развёртка могла сработать.
//
// Организация выводится в разрез ВСЕГДА: это единственное балансовое измерение
// Хозрасчетного (Balance=true), и без него строки разных организаций
// схлопывались бы по ключу Контрагент+Договор, суммируя чужие остатки.
//
// Количество и ВалютнаяСумма - небалансовые ресурсы, привязанные к признакам
// учёта счёта; в observation попадают только если признак у счёта взведён
// (см. ПризнакУчётаСчёта).
//
// Возвращает выборку с колонками Организация/Счет/КодСчета/Субконто1/Субконто2/
// НачальныйОстатокДт/Кт/ОборотДт/Кт/КонечныйОстатокДт/Кт/
// КоличествоДт/Кт/КоличествоОборотДт/Кт/
// ВалютнаяСуммаДт/Кт/ВалютнаяСуммаОборотДт/Кт.
//
Функция ВыполнитьЗапросОстатковССубконто(Знач Счёт, Знач ДатаОстатков, Знач СсылкаОрганизации,
	Знач ЕстьСубконтоДоговоры = Истина, Знач СсылкаКонтрагента = Неопределено,
	Знач СсылкаДоговора = Неопределено, Знач СсылкаДокумента = Неопределено)

	// Виды субконто передаются ОДНИМ параметром-массивом ссылок ПВХ
	// (эталон: БП/CommonModules/ЗаполнениеБухгалтерскойОтчетностиИтоги, запрос
	// с &ВидыСубконто). Порядок элементов массива задаёт нумерацию Субконто1/
	// Субконто2 в виртуальной таблице.
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	Если ЕстьСубконтоДоговоры Тогда
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	КонецЕсли;
	// Разрез под документ расчётов добавляется ТОЛЬКО под фильтр по нему: без
	// фильтра он лишь дробит выдачу (каждая пара контрагент+договор разошлась бы
	// по всем своим документам расчётов), а этот разрез нужен в таблице лишь
	// для условия отбора.
	//
	// Номер субконто = позиция в массиве ВидыСубконто, а не номер разреза у
	// счёта: без «Договоров» документ расчётов встаёт вторым (Субконто2), с
	// ними - третьим. Привязывать отбор жёстко к Субконто3 нельзя - на счёте
	// без договорного разреза он молча указывал бы не на то поле.
	ОтборПоДокументу = (СсылкаДокумента <> Неопределено);
	Если ОтборПоДокументу Тогда
		ВидыСубконто.Добавить(
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами);
	КонецЕсли;

	// Субконто2 выбирается только если у счёта есть разрез "Договоры" - иначе
	// в выборке этого разреза нет и поле осталось бы пустым.
	Если ЕстьСубконтоДоговоры Тогда
		ПолеСубконто2 = "	Остатки.Субконто2 КАК Субконто2,";
	Иначе
		ПолеСубконто2 = "	НЕОПРЕДЕЛЕНО КАК Субконто2,";
	КонецЕсли;

	// Отборы по субконто идут в ПОСЛЕДНИЙ параметр виртуальной таблицы («Условие»,
	// туда же, где отбор по организации), а НЕ в параметр отбора по счёту: в
	// момент вычисления условия по счёту полей Субконто1..N ещё не существует
	// (платформа отвечает Field not found "Субконто1").
	// [Реф: БП/CommonModules/ЗакрытиеМесяца:1590 -
	//  ОстаткиИОбороты(..., Счет В (&Счета), ЗНАЧЕНИЕ(...ВидСубконто),
	//                  Организация В (&Организации) И НЕ Субконто1 В (&Статьи))]
	УсловияСубконто = Новый Массив;

	Если СсылкаКонтрагента <> Неопределено Тогда
		УсловияСубконто.Добавить("Субконто1 = &Контрагент");
	КонецЕсли;

	// Договор - Субконто2, отбор возможен только когда этот разрез реально
	// запрошен (иначе поля Субконто2 в таблице нет).
	Если СсылкаДоговора <> Неопределено И ЕстьСубконтоДоговоры Тогда
		УсловияСубконто.Добавить("Субконто2 = &Договор");
	КонецЕсли;

	Если ОтборПоДокументу Тогда
		// Позиция документа расчётов в массиве ВидыСубконто: 3-я с договорами,
		// 2-я без них (см. сборку ВидыСубконто выше).
		НомерСубконтоДокумента = ?(ЕстьСубконтоДоговоры, "3", "2");
		УсловияСубконто.Добавить("Субконто" + НомерСубконтоДокумента + " = &ДокументРасчетов");
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Остатки.Организация КАК Организация,
		|	Остатки.Счет КАК Счет,
		|	Остатки.Счет.Код КАК КодСчета,
		|	Остатки.Субконто1 КАК Субконто1,
		|" + ПолеСубконто2 + "
		|	Остатки.СуммаНачальныйОстатокДт КАК НачальныйОстатокДт,
		|	Остатки.СуммаНачальныйОстатокКт КАК НачальныйОстатокКт,
		|	Остатки.СуммаОборотДт КАК ОборотДт,
		|	Остатки.СуммаОборотКт КАК ОборотКт,
		|	Остатки.СуммаКонечныйОстатокДт КАК КонечныйОстатокДт,
		|	Остатки.СуммаКонечныйОстатокКт КАК КонечныйОстатокКт,
		|	Остатки.КоличествоКонечныйОстатокДт КАК КоличествоДт,
		|	Остатки.КоличествоКонечныйОстатокКт КАК КоличествоКт,
		|	Остатки.КоличествоОборотДт КАК КоличествоОборотДт,
		|	Остатки.КоличествоОборотКт КАК КоличествоОборотКт,
		|	Остатки.ВалютнаяСуммаКонечныйОстатокДт КАК ВалютнаяСуммаДт,
		|	Остатки.ВалютнаяСуммаКонечныйОстатокКт КАК ВалютнаяСуммаКт,
		|	Остатки.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
		|	Остатки.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаОборотКт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|		&НачалоПериода,
		|		&КонецПериода,
		|		,
		|		,
		|		Счет В ИЕРАРХИИ (&Счёт),
		|		&ВидыСубконто" + ХвостУсловияОстатков(СсылкаОрганизации, УсловияСубконто) + ") КАК Остатки
		|УПОРЯДОЧИТЬ ПО
		|	КонечныйОстатокДт УБЫВ,
		|	КонечныйОстатокКт УБЫВ";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаОборотов(ДатаОстатков));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОстатков));
	Запрос.УстановитьПараметр("Счёт", Счёт);
	Если СсылкаОрганизации <> Неопределено Тогда
		Запрос.УстановитьПараметр("Организация", СсылкаОрганизации);
	КонецЕсли;
	Если СсылкаКонтрагента <> Неопределено Тогда
		Запрос.УстановитьПараметр("Контрагент", СсылкаКонтрагента);
	КонецЕсли;
	Если СсылкаДоговора <> Неопределено И ЕстьСубконтоДоговоры Тогда
		Запрос.УстановитьПараметр("Договор", СсылкаДоговора);
	КонецЕсли;
	Если ОтборПоДокументу Тогда
		Запрос.УстановитьПараметр("ДокументРасчетов", СсылкаДокумента);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Запрос к виртуальной таблице ОстаткиИОбороты счёта Хозрасчетный БЕЗ
// детализации по субконто (fallback для нетипового состава субконто, graceful
// см. докстринг ПолучитьОстатокСчётаВнутр). Субконто1/Субконто2 в выборке
// заведомо Неопределено - вызывающий код это учитывает через ЕстьДетализацияПоСубконто.
//
Функция ВыполнитьЗапросОстатковБезДетализации(Знач Счёт, Знач ДатаОстатков, Знач СсылкаОрганизации)

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Остатки.Организация КАК Организация,
		|	Остатки.Счет.Код КАК КодСчета,
		|	Остатки.СуммаНачальныйОстатокДт КАК НачальныйОстатокДт,
		|	Остатки.СуммаНачальныйОстатокКт КАК НачальныйОстатокКт,
		|	Остатки.СуммаОборотДт КАК ОборотДт,
		|	Остатки.СуммаОборотКт КАК ОборотКт,
		|	Остатки.СуммаКонечныйОстатокДт КАК КонечныйОстатокДт,
		|	Остатки.СуммаКонечныйОстатокКт КАК КонечныйОстатокКт,
		|	Остатки.КоличествоКонечныйОстатокДт КАК КоличествоДт,
		|	Остатки.КоличествоКонечныйОстатокКт КАК КоличествоКт,
		|	Остатки.КоличествоОборотДт КАК КоличествоОборотДт,
		|	Остатки.КоличествоОборотКт КАК КоличествоОборотКт,
		|	Остатки.ВалютнаяСуммаКонечныйОстатокДт КАК ВалютнаяСуммаДт,
		|	Остатки.ВалютнаяСуммаКонечныйОстатокКт КАК ВалютнаяСуммаКт,
		|	Остатки.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
		|	Остатки.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаОборотКт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|		&НачалоПериода,
		|		&КонецПериода,
		|		,
		|		,
		|		Счет В ИЕРАРХИИ (&Счёт)" + ХвостБезДетализации(СсылкаОрганизации) + ") КАК Остатки
		|УПОРЯДОЧИТЬ ПО
		|	КонечныйОстатокДт УБЫВ";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаОборотов(ДатаОстатков));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОстатков));
	Запрос.УстановитьПараметр("Счёт", Счёт);
	Если СсылкаОрганизации <> Неопределено Тогда
		Запрос.УстановитьПараметр("Организация", СсылкаОрганизации);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Имена видов субконто счёта (элементы ПВХ ВидыСубконтоХозрасчетные) в порядке
// их следования у счёта. Используется, чтобы определить наличие разрезов
// "Контрагенты"/"Договоры" по имени, а не по количеству видов субконто:
// у типового счёта 62 БП их три (плюс ДокументыРасчётовСКонтрагентом).
//
// Параметры:
//  Счёт - ПланСчетовСсылка - счёт плана счетов Хозрасчетный.
//
// Возвращаемое значение:
//  Массив из Строка - имена видов субконто ("Контрагенты", "Договоры", ...).
//                     Пустой массив, если состав субконто недоступен.
//
Функция ИменаВидовСубконтоСчёта(Знач Счёт)

	Имена = Новый Массив;

	Попытка
		СоставСубконто = Счёт.ВидыСубконто;
	Исключение
		Возврат Имена;
	КонецПопытки;

	Если СоставСубконто = Неопределено Тогда
		Возврат Имена;
	КонецЕсли;

	Для Каждого СтрокаСубконто Из СоставСубконто Цикл
		Попытка
			ВидСубконто = СтрокаСубконто.ВидСубконто;
		Исключение
			Продолжить;
		КонецПопытки;
		Если Не ЗначениеЗаполнено(ВидСубконто) Тогда
			Продолжить;
		КонецЕсли;
		// Имя предопределённого элемента ПВХ - устойчивый идентификатор разреза
		// (наименование локализуемо и может отличаться между конфигурациями).
		// У непредопределённых элементов свойство пустое - такой вид субконто
		// в разрезы не попадает, детализация по нему не строится.
		Попытка
			ИмяПредопределённого = СокрЛП(ВидСубконто.ИмяПредопределенныхДанных);
		Исключение
			ИмяПредопределённого = "";
		КонецПопытки;
		Если Не ПустаяСтрока(ИмяПредопределённого) Тогда
			Имена.Добавить(ИмяПредопределённого);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Накопить строку выборки в свод по паре Организация+Контрагент.
// Свод суммирует Дт и Кт контрагента по всем его субсчетам и договорам ВНУТРИ
// одной организации - именно так 1С считает свёрнутую ОСВ по счёту.
// Поверх организаций свёртка НЕ идёт: долг перед одним юрлицом не гасится
// авансом, полученным другим (иначе Атлантика-Трейдинг с 564 900 Дт по
// «Атлантике» и 100 000 Кт по «Атлантика-Снабжению» давал бы 464 900 -
// величину, которой в ОСВ нет).
//
// Зачем свод вообще: сырые строки развёрнуты по субсчетам, и чтобы получить
// «долг контрагента», их нужно сложить и вычесть Кт из Дт. Слабая LLM на этой
// арифметике ошибается (путает строки, теряет кредитовые, подаёт сумму Дт как
// итоговый долг), поэтому расчёт делает сам инструмент, а модели остаётся
// пересказать готовые числа. Сырые строки при этом сохраняются в items - для
// вопросов, где нужна детализация по договорам/субсчетам.
//
// Параметры:
//  Свод              - Соответствие - накопитель (изменяется).
//  ВыборкаСтроки     - ВыборкаИзРезультатаЗапроса - текущая строка.
//  ЕстьДетализация   - Булево - есть ли разрез по контрагентам.
//  СальдоДт, СальдоКт - Число - конечные остатки строки.
//
Процедура НакопитьСводПоКонтрагенту(Свод, Знач ВыборкаСтроки, Знач ЕстьДетализация,
	Знач СальдоДт, Знач СальдоКт)

	Если Не ЕстьДетализация Тогда
		Возврат;
	КонецЕсли;

	Контрагент = ВыборкаСтроки.Субконто1;
	Организация = ВыборкаСтроки.Организация;

	// Ключ - ПАРА Организация+Контрагент. Сворачивать контрагента поверх
	// организаций нельзя: долг перед одним юрлицом не гасится авансом,
	// полученным другим юрлицом, и 1С в ОСВ их тоже не смешивает.
	// Строки без контрагента (в ОСВ это "<...>") сводим в псевдогруппу внутри
	// своей организации - строковый ключ не конфликтует с представлениями
	// ссылок, потому что содержит их UUID.
	Если ЗначениеЗаполнено(Контрагент) Тогда
		КлючКонтрагента = Строка(Контрагент.УникальныйИдентификатор());
	Иначе
		КлючКонтрагента = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(Организация) Тогда
		КлючОрганизации = Строка(Организация.УникальныйИдентификатор());
	Иначе
		КлючОрганизации = "";
	КонецЕсли;
	Ключ = КлючОрганизации + "|" + КлючКонтрагента;

	Строка = Свод.Получить(Ключ);
	Если Строка = Неопределено Тогда
		Строка = Новый Структура("Ссылка, Организация, Дебет, Кредит",
			Контрагент, Организация, 0, 0);
		Свод.Вставить(Ключ, Строка);
	КонецЕсли;

	Строка.Дебет = Строка.Дебет + СальдоДт;
	Строка.Кредит = Строка.Кредит + СальдоКт;

КонецПроцедуры

// Преобразовать накопленный свод в массив структур для JSON-ответа,
// отсортированный по убыванию чистого долга (net_debt = Дебет - Кредит).
//
// ТолькоДебет=Истина оставляет только реальных должников (net_debt > 0) - это
// и есть корректный ответ на вопрос «у кого долги», в отличие от фильтрации
// сырых строк, где кредитовые строки того же контрагента терялись.
//
// Параметры:
//  Свод        - Соответствие - накопитель из НакопитьСводПоКонтрагенту.
//  ТолькоДебет - Булево - оставить только должников.
//
// Возвращаемое значение:
//  Массив из Структура - строки свода для сериализации.
//
Функция СводКонтрагентовВМассив(Знач Свод, Знач ТолькоДебет)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка");
	Таблица.Колонки.Добавить("Организация");
	Таблица.Колонки.Добавить("Дебет", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Кредит", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Нетто", Новый ОписаниеТипов("Число"));

	Для Каждого КлючЗначение Из Свод Цикл
		Значение = КлючЗначение.Значение;
		Нетто = Значение.Дебет - Значение.Кредит;
		Если ТолькоДебет И Нетто <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Ссылка = Значение.Ссылка;
		НоваяСтрока.Организация = Значение.Организация;
		НоваяСтрока.Дебет = Значение.Дебет;
		НоваяСтрока.Кредит = Значение.Кредит;
		НоваяСтрока.Нетто = Нетто;
	КонецЦикла;

	Таблица.Сортировать("Нетто Убыв");

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("organization_ref",
			ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаТаблицы.Организация));
		Элемент.Вставить("organization_name", СокрЛП(Строка(СтрокаТаблицы.Организация)));
		// ИНН организации - ключ для create_reconciliation_act и повторных
		// вызовов с фильтром (организация задаётся только по ИНН).
		Элемент.Вставить("organization_inn", ИННСсылки(СтрокаТаблицы.Организация));
		Если ЗначениеЗаполнено(СтрокаТаблицы.Ссылка) Тогда
			Элемент.Вставить("contragent_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(СтрокаТаблицы.Ссылка));
			Элемент.Вставить("contragent_name", СокрЛП(Строка(СтрокаТаблицы.Ссылка)));
			Элемент.Вставить("contragent_inn", ИННСсылки(СтрокаТаблицы.Ссылка));
		Иначе
			Элемент.Вставить("contragent_ref", "");
			Элемент.Вставить("contragent_name", НСтр("ru='<без контрагента>'; en='<no counterparty>'"));
		КонецЕсли;
		Элемент.Вставить("total_debit", СтрокаТаблицы.Дебет);
		Элемент.Вставить("total_credit", СтрокаТаблицы.Кредит);
		Элемент.Вставить("net_debt", СтрокаТаблицы.Нетто);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Признак учёта счёта ("Количественный", "Валютный", ...) - реквизит счёта
// плана счетов Хозрасчетный. Небалансовые ресурсы регистра (Количество,
// ВалютнаяСумма) заполнены только у счетов с соответствующим признаком.
//
// Читается через Попытка: у нетипового плана счетов реквизита может не быть,
// и тогда tool должен деградировать (признак Ложь = поля просто не выводятся),
// а не падать с ошибкой.
//
// Параметры:
//  Счёт        - ПланСчетовСсылка - счёт плана счетов Хозрасчетный.
//  ИмяПризнака - Строка           - имя реквизита-признака учёта.
//
// Возвращаемое значение:
//  Булево - Истина, если признак есть и взведён.
//
Функция ПризнакУчётаСчёта(Знач Счёт, Знач ИмяПризнака)

	Попытка
		Значение = Счёт[ИмяПризнака];
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат (Значение = Истина);

КонецФункции

// Истина, если текст ошибки выполнения запроса похож на отказ в правах доступа
// (а не на ошибку компиляции текста запроса). Проверка по подстрокам платформы -
// точного программного признака у исключения запроса нет.
//
// Параметры:
//  ТекстОшибки - Строка - подробное представление ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если это похоже на отказ в правах.
//
Функция ЭтоОшибкаПравДоступа(Знач ТекстОшибки)

	ТекстНРег = НРег(ТекстОшибки);

	Возврат СтрНайти(ТекстНРег, "прав доступа") > 0
		Или СтрНайти(ТекстНРег, "недостаточно прав") > 0
		Или СтрНайти(ТекстНРег, "нарушение прав") > 0
		Или СтрНайти(ТекстНРег, "access violation") > 0
		Или СтрНайти(ТекстНРег, "insufficient rights") > 0;

КонецФункции

// Начало периода для оборотов виртуальной таблицы ОстаткиИОбороты.
// Обороты считаются с начала года даты остатков (а не за одни сутки, как было
// раньше) - иначе поля debit_turnover/credit_turnover в ответе tool означали
// движения ровно за один день и вводили LLM в заблуждение. Начальный остаток
// при этом - на начало года, конечный - на конец указанной даты.
//
// Параметры:
//  ДатаОстатков - Дата - дата, на которую считаются остатки.
//
// Возвращаемое значение:
//  Дата - начало года даты остатков.
//
Функция НачалоПериодаОборотов(Знач ДатаОстатков)
	Возврат НачалоГода(ДатаОстатков);
КонецФункции

// Хвост текста виртуальной таблицы с последним параметром "Условие" - фильтром
// по организации (измерение балансовой аналитики, стандартное для типовых
// конфигураций). Это ОТДЕЛЬНЫЙ параметр виртуальной таблицы, а не довесок к
// отбору по счёту - см. эталон БП: ОстаткиИОбороты(..., Счет В (&Счета),
// &ВидыСубконто, Организация = &Организация).
//
// Возвращает готовый хвост ВМЕСТЕ с разделителем, чтобы при незаданной
// организации не оставалось висячей запятой перед закрывающей скобкой.
//
// Параметры:
//  СсылкаОрганизации - СправочникСсылка, Неопределено - фильтр по организации.
//  НуженРазделитель  - Булево - Истина: перед условием ставится запятая
//                      (предыдущий параметр уже выведен без неё). Ложь:
//                      запятая уже стоит в тексте запроса, добавлять не нужно.
//
// Возвращаемое значение:
//  Строка - хвост текста запроса ("" либо ", Организация = &Организация").
//
Функция ПараметрУсловияОрганизации(Знач СсылкаОрганизации)

	Если СсылкаОрганизации = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ",
		|		Организация = &Организация";

КонецФункции

// Хвост виртуальной таблицы с последним параметром «Условие»: фильтр по
// организации И отборы по субконто в ОДНОМ выражении - это один параметр
// таблицы, а не два разных.
//
// Отборы по субконто нельзя приклеивать к параметру отбора по счёту: там полей
// Субконто1..N ещё нет, платформа отвечает Field not found "Субконто1"
// [Реф: БП/CommonModules/ЗакрытиеМесяца:1590 - "Организация В (&Организации)
//  И НЕ Субконто1 В (&СтатьиУбытковПрошлыхЛет)"].
//
// Параметры:
//  СсылкаОрганизации - СправочникСсылка, Неопределено - фильтр по организации.
//  УсловияСубконто   - Массив из Строка - готовые выражения вида
//                      "Субконто1 = &Контрагент". Может быть пустым.
//
// Возвращаемое значение:
//  Строка - "" либо ",\n<условие> [И <условие>...]" вместе с разделителем.
//
Функция ХвостУсловияОстатков(Знач СсылкаОрганизации, Знач УсловияСубконто)

	Части = Новый Массив;

	Если СсылкаОрганизации <> Неопределено Тогда
		Части.Добавить("Организация = &Организация");
	КонецЕсли;

	Если ТипЗнч(УсловияСубконто) = Тип("Массив") Тогда
		Для Каждого Условие Из УсловияСубконто Цикл
			Если Не ПустаяСтрока(Условие) Тогда
				Части.Добавить(Условие);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ",
		|		" + СтрСоединить(Части, "
		|			И ");

КонецФункции

// Хвост виртуальной таблицы для запроса БЕЗ детализации по субконто.
// Позиция параметра "Виды субконто" пропускается пустым значением - она нужна
// только чтобы условие по организации встало в свою позицию. Если организация
// не задана, оба параметра опускаются целиком (иначе осталась бы висячая
// запятая перед закрывающей скобкой и запрос не скомпилировался бы).
//
// Параметры:
//  СсылкаОрганизации - СправочникСсылка, Неопределено - фильтр по организации.
//
// Возвращаемое значение:
//  Строка - хвост текста запроса ("" либо ", , Организация = &Организация").
//
Функция ХвостБезДетализации(Знач СсылкаОрганизации)

	Если СсылкаОрганизации = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ",
		|		,
		|		Организация = &Организация";

КонецФункции

// Аргументы, которые понимает get_account_balance / find_overdue_receivables.
// Всё, чего здесь нет, попадает в warnings как unknown_argument (см.
// ДобавитьПредупрежденияОНеизвестныхКлючах).
//
// Возвращаемое значение:
//  Массив из Строка - имена поддерживаемых ключей.
//
Функция ПоддерживаемыеАргументыОстатков()

	Имена = Новый Массив;
	Имена.Добавить("account");
	Имена.Добавить("date");
	Имена.Добавить("organization_inn");
	Имена.Добавить("organization_name");
	// organization_ref больше не поддерживается как фильтр, но остаётся в
	// списке: он обрабатывается явной ошибкой organization_ref_not_supported,
	// и дублировать её ещё и warning'ом unknown_argument незачем.
	Имена.Добавить("organization_ref");
	Имена.Добавить("contragent_inn");
	Имена.Добавить("client_inn");
	Имена.Добавить("contragent_ref");
	Имена.Добавить("client_ref");
	Имена.Добавить("contract_ref");
	Имена.Добавить("settlement_document_ref");
	Имена.Добавить("document_ref");
	Имена.Добавить("only_debit");
	Имена.Добавить("limit");
	// Служебные ключи диспетчера - приходят в каждом вызове, шумом быть не должны.
	Имена.Добавить("_dry_run");
	Имена.Добавить("_idempotency_key");

	Возврат Имена;

КонецФункции

// Добавляет в Предупреждения по одной записи "unknown_argument:<ключ>" на
// каждый непонятый аргумент.
//
// Зачем: молча проигнорированный фильтр - самый опасный вид отказа. Вызов
// {"account":"62","client_ref":"..."} возвращал сальдо по всей базе с
// success=true, и LLM подавала чужие суммы как данные одного контрагента.
//
// Параметры:
//  Объект         - Соответствие - разобранные аргументы.
//  Предупреждения - Массив       - накопитель warnings (изменяется).
//
Процедура ДобавитьПредупрежденияОНеизвестныхКлючах(Знач Объект, Предупреждения)

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Поддерживаемые = ПоддерживаемыеАргументыОстатков();

	Для Каждого КлючЗначение Из Объект Цикл
		Ключ = СокрЛП(Строка(КлючЗначение.Ключ));
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если Поддерживаемые.Найти(Ключ) = Неопределено Тогда
			Предупреждения.Добавить("unknown_argument:" + Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Находит организацию по ИНН. Возвращает Структуру { Ссылка, Ошибка }.
//
// ИНН - более устойчивый способ указать организацию, чем навигационная ссылка:
// его модель переносит из данных дословно, тогда как ссылки регулярно попадают
// не в тот аргумент (реальный случай: ссылка на контрагента в organization_ref).
//
// Коды ошибок:
//  organization_not_found_by_inn - нет организации с таким ИНН;
//  organization_inn_ambiguous    - несколько организаций с одним ИНН
//                                  (обособленные подразделения): выбрать за
//                                  пользователя нельзя, нужна ссылка.
//
// Параметры:
//  ИНН - Строка - ИНН организации (лишние пробелы игнорируются).
//
// Возвращаемое значение:
//  Структура { Ссылка, Ошибка }.
//
Функция НайтиОрганизациюПоИНН(Знач ИНН)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации");
	МДОрганизации = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДОрганизации = Неопределено Или МДОрганизации.Реквизиты.Найти("ИНН") = Неопределено Тогда
		Результат.Ошибка = "organization_not_found_by_inn";
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяРеальное + " КАК Организации
		|ГДЕ
		|	Организации.ИНН = &ИНН
		|	И НЕ Организации.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));

	Попытка
		Выборка = Запрос.Выполнить().Выгрузить();
	Исключение
		Результат.Ошибка = "organization_not_found_by_inn";
		Возврат Результат;
	КонецПопытки;

	Если Выборка.Количество() = 0 Тогда
		Результат.Ошибка = "organization_not_found_by_inn";
		Возврат Результат;
	КонецЕсли;

	// Несколько организаций с одним ИНН - выбирать за пользователя нельзя.
	Если Выборка.Количество() > 1 Тогда
		Результат.Ошибка = "organization_inn_ambiguous";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Выборка[0].Ссылка;
	Возврат Результат;

КонецФункции

// ИНН элемента справочника ("" - если реквизита нет, ссылка пустая или чтение
// не удалось). Используется для вывода organization_inn / contragent_inn.
//
Функция ИННСсылки(Знач Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат СокрЛП(Строка(Ссылка.ИНН));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Основная логика search_organizations. Выделена из ПоискОрганизаций, чтобы
// внешний Попытка/Исключение ловил любые непредвиденные ошибки.
//
// Поиск идёт по трём полям наименования И по ИНН одновременно: пользователь
// может продиктовать как «Атлантика», так и цифры ИНН, а различать это по
// виду строки - лишняя эвристика (ПохожеНаИНН уже показала, что модель
// путает классы значений).
//
Функция ПоискОрганизацийВнутр(Знач Аргументы, Знач Контекст)

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Объект = Новый Соответствие;
	КонецЕсли;

	Предупреждения = Новый Массив;
	ДобавитьПредупрежденияОНеизвестныхКлючахОрганизаций(Объект, Предупреждения);

	Запрос = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "query", "")));

	// Дефолт 50: справочник организаций редко больше, поэтому типовой вызов
	// «покажи организации» отдаёт полный список и модели незачем гадать про
	// обрезку. Потолок 500 - чтобы полный список можно было дозапросить и на
	// базе с сотнями юрлиц (при 100 это было невозможно).
	Лимит = 50;
	СыройЛимит = ЗначениеПоКлючуФинансы(Объект, "limit", Неопределено);
	Если ТипЗнч(СыройЛимит) = Тип("Число") Тогда
		ЦелыйЛимит = Цел(СыройЛимит);
		Если ЦелыйЛимит >= 1 И ЦелыйЛимит <= 500 Тогда
			Лимит = ЦелыйЛимит;
		КонецЕсли;
	КонецЕсли;

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации");
	МДОрганизации = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДОрганизации = Неопределено Тогда
		Возврат ОшибочныйJSONСДетальюФинансы("catalog_not_found",
			НСтр("ru = 'Справочник Организации не найден в конфигурации.';
				|en = 'Catalog Организации not found in the configuration.'"));
	КонецЕсли;

	// Состав реквизитов отличается между конфигурациями - отсутствующее поле
	// в текст запроса не попадает (иначе Field not found на чужой КФ).
	ЕстьСокращенное = (МДОрганизации.Реквизиты.Найти("НаименованиеСокращенное") <> Неопределено);
	ЕстьПолное = (МДОрганизации.Реквизиты.Найти("НаименованиеПолное") <> Неопределено);
	ЕстьИНН = (МДОрганизации.Реквизиты.Найти("ИНН") <> Неопределено);
	ЕстьКПП = (МДОрганизации.Реквизиты.Найти("КПП") <> Неопределено);
	ЕстьОбособленное = (МДОрганизации.Реквизиты.Найти("ОбособленноеПодразделение") <> Неопределено);
	ЕстьГоловная = (МДОрганизации.Реквизиты.Найти("ГоловнаяОрганизация") <> Неопределено);

	ПоляВыборки = "Организации.Ссылка КАК Ссылка,
		|	Организации.Наименование КАК Наименование";
	Если ЕстьСокращенное Тогда
		ПоляВыборки = ПоляВыборки + ",
		|	Организации.НаименованиеСокращенное КАК НаименованиеСокращенное";
	КонецЕсли;
	Если ЕстьПолное Тогда
		ПоляВыборки = ПоляВыборки + ",
		|	Организации.НаименованиеПолное КАК НаименованиеПолное";
	КонецЕсли;
	Если ЕстьИНН Тогда
		ПоляВыборки = ПоляВыборки + ",
		|	Организации.ИНН КАК ИНН";
	КонецЕсли;
	Если ЕстьКПП Тогда
		ПоляВыборки = ПоляВыборки + ",
		|	Организации.КПП КАК КПП";
	КонецЕсли;
	Если ЕстьОбособленное Тогда
		ПоляВыборки = ПоляВыборки + ",
		|	Организации.ОбособленноеПодразделение КАК ОбособленноеПодразделение";
	КонецЕсли;
	Если ЕстьГоловная Тогда
		ПоляВыборки = ПоляВыборки + ",
		|	Организации.ГоловнаяОрганизация КАК ГоловнаяОрганизация";
	КонецЕсли;

	// Пустой query = вернуть весь список: это осмысленный сценарий «покажи,
	// какие у нас организации», а не ошибка вызова.
	Если ПустаяСтрока(Запрос) Тогда
		УсловиеОтбора = "ИСТИНА";
	Иначе
		УсловиеОтбора = "Организации.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
		Если ЕстьСокращенное Тогда
			УсловиеОтбора = УсловиеОтбора + "
			|		ИЛИ Организации.НаименованиеСокращенное ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
		КонецЕсли;
		Если ЕстьПолное Тогда
			УсловиеОтбора = УсловиеОтбора + "
			|		ИЛИ Организации.НаименованиеПолное ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
		КонецЕсли;
		Если ЕстьИНН Тогда
			УсловиеОтбора = УсловиеОтбора + "
			|		ИЛИ Организации.ИНН ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
		КонецЕсли;
	КонецЕсли;

	// ПАКЕТНЫЙ запрос: сначала ОБЩЕЕ количество подходящих организаций (без
	// лимита), затем сама выдача (с лимитом).
	//
	// Зачем отдельный подсчёт: раньше total_found возвращал длину УЖЕ
	// усечённого массива, и при limit=15 модель получала {"total_found": 15,
	// "truncated": true} - после чего уверенно отвечала «в базе 15
	// организаций». Числу с именем «всего найдено» она верит больше, чем
	// флагу рядом. Теперь total_found - это сколько есть В БАЗЕ, а сколько
	// реально отдано, видно по длине items и по полю returned.
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ
		|	Справочник." + ИмяРеальное + " КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|	И (" + УсловиеОтбора + ")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	" + ПоляВыборки + "
		|ИЗ
		|	Справочник." + ИмяРеальное + " КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|	И (" + УсловиеОтбора + ")
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	ЗапросОрганизаций.УстановитьПараметр("Шаблон", "%" + ЭкранироватьШаблонПодобно(Запрос) + "%");

	Попытка
		РезультатыПакета = ЗапросОрганизаций.ВыполнитьПакет();
		ВыборкаСчётчика = РезультатыПакета[0].Выбрать();
		ВсегоВБазе = ?(ВыборкаСчётчика.Следующий(), ВыборкаСчётчика.Всего, 0);
		Выборка = РезультатыПакета[1].Выбрать();
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДетальюФинансы("query_failed", ТекстОшибки);
	КонецПопытки;

	// Лимит применён самим запросом (ПЕРВЫЕ N) - выборку дочитываем целиком.
	Элементы = Новый Массив;
	Пока Выборка.Следующий() Цикл

		Элемент = Новый Структура;
		Элемент.Вставить("name", СокрЛП(Строка(Выборка.Наименование)));
		Элемент.Вставить("full_name",
			?(ЕстьПолное, СокрЛП(Строка(Выборка.НаименованиеПолное)), ""));
		Элемент.Вставить("short_name",
			?(ЕстьСокращенное, СокрЛП(Строка(Выборка.НаименованиеСокращенное)), ""));
		// inn - ключевое поле выдачи: именно им модель повторяет вызов
		// финансовых tools через organization_inn.
		Элемент.Вставить("inn", ?(ЕстьИНН, СокрЛП(Строка(Выборка.ИНН)), ""));
		Элемент.Вставить("kpp", ?(ЕстьКПП, СокрЛП(Строка(Выборка.КПП)), ""));
		Элемент.Вставить("organization_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Ссылка));

		// Обособленные подразделения делят ИНН с головной организацией -
		// это и есть источник organization_inn_ambiguous. Помечаем их явно,
		// чтобы модель могла объяснить пользователю, почему по ИНН неоднозначно.
		Если ЕстьОбособленное Тогда
			Элемент.Вставить("is_separate_subdivision", Выборка.ОбособленноеПодразделение = Истина);
		КонецЕсли;
		Если ЕстьГоловная И ЗначениеЗаполнено(Выборка.ГоловнаяОрганизация) Тогда
			Элемент.Вставить("head_organization", СокрЛП(Строка(Выборка.ГоловнаяОрганизация)));
		КонецЕсли;

		Элементы.Добавить(Элемент);

	КонецЦикла;

	Обрезано = (ВсегоВБазе > Элементы.Количество());

	Ответ = Новый Структура;
	Ответ.Вставить("items", Элементы);
	// total_found - сколько подходит под отбор ВСЕГО (не длина items!),
	// returned - сколько реально отдано в этом ответе.
	Ответ.Вставить("total_found", ВсегоВБазе);
	Ответ.Вставить("returned", Элементы.Количество());
	Ответ.Вставить("truncated", Обрезано);
	Если Обрезано Тогда
		// Текст предупреждения намеренно содержит ОБА числа: модель отвечает
		// пользователю по нему, и без явного «показаны N из M» она выдаёт
		// усечённый список как полный.
		Предупреждения.Добавить(СтрШаблон(
			НСтр("ru = 'result_truncated: показаны %1 из %2 организаций. Это НЕ полный список - повтори вызов с limit=%2 (максимум 500) или уточни query.';
				|en = 'result_truncated: showing %1 of %2 organizations. This is NOT the full list - retry with limit=%2 (max 500) or narrow the query.'"),
			Элементы.Количество(), ВсегоВБазе));
	КонецЕсли;
	Если Элементы.Количество() = 0 Тогда
		Ответ.Вставить("hint", НСтр("ru = 'Ничего не найдено. Вызови search_organizations без query, чтобы увидеть все организации базы. Не путай организацию (наше юрлицо) с контрагентом - для контрагентов есть search_clients.';
			|en = 'Nothing found. Call search_organizations without query to list all organizations. Do not confuse an organization with a counterparty - use search_clients for those.'"));
	КонецЕсли;
	Если Предупреждения.Количество() > 0 Тогда
		Ответ.Вставить("warnings", Предупреждения);
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Ответ);

КонецФункции

// Добавляет "unknown_argument:<ключ>" на каждый непонятый аргумент
// search_organizations - молча проигнорированный фильтр опаснее отказа.
//
Процедура ДобавитьПредупрежденияОНеизвестныхКлючахОрганизаций(Знач Объект, Предупреждения)

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Поддерживаемые = Новый Массив;
	Поддерживаемые.Добавить("query");
	Поддерживаемые.Добавить("limit");
	Поддерживаемые.Добавить("_dry_run");
	Поддерживаемые.Добавить("_idempotency_key");

	Для Каждого КлючЗначение Из Объект Цикл
		Ключ = СокрЛП(Строка(КлючЗначение.Ключ));
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если Поддерживаемые.Найти(Ключ) = Неопределено Тогда
			Предупреждения.Добавить("unknown_argument:" + Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Находит организацию по НАИМЕНОВАНИЮ (вхождение подстроки). Возвращает
// Структуру { Ссылка, Ошибка, Кандидаты }.
//
// ЗАЧЕМ: до этой функции организация задавалась ТОЛЬКО ИНН, а пользователь
// в чате называет организацию по имени («выведи неоплаченные счета по
// Атлантике»). Узнать ИНН модели было неоткуда: search_clients ищет
// КОНТРАГЕНТОВ, наши юрлица в нём не участвуют. Итог на базе с несколькими
// организациями: название уходило в organization_inn и tool отвечал
// organization_not_found_by_inn, либо организация не задавалась вовсе и
// срабатывало organization_scope_not_configured. На базе с ОДНОЙ организацией
// дефект не проявлялся - её подставляло правило single_org.
//
// АЛГОРИТМ (двухступенчатый - точное совпадение имеет приоритет над вхождением,
// иначе «Атлантика» была бы неоднозначна при наличии «Атлантика-Плюс»):
//  1. Точное совпадение (без учёта регистра) по Наименование /
//     НаименованиеСокращенное / НаименованиеПолное. Ровно одна - она и есть.
//  2. Иначе - вхождение подстроки ПОДОБНО "%текст%" по тем же трём полям.
//
// Спецсимволы ПОДОБНО (%, _, [) экранируются - иначе «ООО_Ромашка» матчил бы
// произвольный символ вместо подчёркивания, а «100%» вернул бы всю базу.
//
// Коды ошибок:
//  organization_not_found_by_name - нет организации с таким наименованием;
//  organization_name_ambiguous    - подходит несколько: выбирать за
//                                   пользователя нельзя (отчёт по чужому
//                                   юрлицу хуже отказа), в Кандидаты кладём
//                                   список для уточнения.
//
// Параметры:
//  Наименование - Строка - наименование или его часть.
//
// Возвращаемое значение:
//  Структура { Ссылка - СправочникСсылка.Организации либо Неопределено;
//              Ошибка - Строка;
//              Кандидаты - Массив из СправочникСсылка.Организации - заполнен
//                          при organization_name_ambiguous }.
//
Функция НайтиОрганизациюПоНаименованию(Знач Наименование)

	Результат = Новый Структура("Ссылка, Ошибка, Кандидаты", Неопределено, "", Новый Массив);

	Текст = СокрЛП(Строка(Наименование));
	Если ПустаяСтрока(Текст) Тогда
		Результат.Ошибка = "organization_not_found_by_name";
		Возврат Результат;
	КонецЕсли;

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации");
	МДОрганизации = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДОрганизации = Неопределено Тогда
		Результат.Ошибка = "organization_not_found_by_name";
		Возврат Результат;
	КонецЕсли;

	// Дополнительные поля наименования есть не во всякой конфигурации:
	// в БП это НаименованиеСокращенное/НаименованиеПолное, в другой КФ их
	// может не быть. Отсутствующее поле в запрос не попадает - иначе
	// «Field not found» на чужой конфигурации.
	ЕстьСокращенное = (МДОрганизации.Реквизиты.Найти("НаименованиеСокращенное") <> Неопределено);
	ЕстьПолное = (МДОрганизации.Реквизиты.Найти("НаименованиеПолное") <> Неопределено);

	// Шаг 1: точное совпадение. ВРЕГ с обеих сторон обязателен: в отличие от
	// ПОДОБНО (тот регистронезависим по стандарту std726), оператор "="
	// сравнивает строки С УЧЁТОМ регистра, а пользователь диктует голосом -
	// «атлантика» должна находить «Атлантика».
	УсловиеТочное = "ВРЕГ(Организации.Наименование) = &ТекстВРЕГ";
	Если ЕстьСокращенное Тогда
		УсловиеТочное = УсловиеТочное + "
			|	ИЛИ ВРЕГ(Организации.НаименованиеСокращенное) = &ТекстВРЕГ";
	КонецЕсли;
	Если ЕстьПолное Тогда
		УсловиеТочное = УсловиеТочное + "
			|	ИЛИ ВРЕГ(Организации.НаименованиеПолное) = &ТекстВРЕГ";
	КонецЕсли;

	НайденныеТочно = ВыполнитьПоискОрганизацийПоУсловию(ИмяРеальное, УсловиеТочное, Текст);
	Если НайденныеТочно = Неопределено Тогда
		Результат.Ошибка = "organization_not_found_by_name";
		Возврат Результат;
	КонецЕсли;

	Если НайденныеТочно.Количество() = 1 Тогда
		Результат.Ссылка = НайденныеТочно[0];
		Возврат Результат;
	КонецЕсли;

	Если НайденныеТочно.Количество() > 1 Тогда
		Результат.Ошибка = "organization_name_ambiguous";
		Результат.Кандидаты = НайденныеТочно;
		Возврат Результат;
	КонецЕсли;

	// Шаг 2: вхождение подстроки.
	УсловиеВхождение = "Организации.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
	Если ЕстьСокращенное Тогда
		УсловиеВхождение = УсловиеВхождение + "
			|	ИЛИ Организации.НаименованиеСокращенное ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
	КонецЕсли;
	Если ЕстьПолное Тогда
		УсловиеВхождение = УсловиеВхождение + "
			|	ИЛИ Организации.НаименованиеПолное ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
	КонецЕсли;

	НайденныеПоВхождению = ВыполнитьПоискОрганизацийПоУсловию(ИмяРеальное, УсловиеВхождение, Текст);
	Если НайденныеПоВхождению = Неопределено Или НайденныеПоВхождению.Количество() = 0 Тогда
		Результат.Ошибка = "organization_not_found_by_name";
		Возврат Результат;
	КонецЕсли;

	Если НайденныеПоВхождению.Количество() > 1 Тогда
		Результат.Ошибка = "organization_name_ambiguous";
		Результат.Кандидаты = НайденныеПоВхождению;
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = НайденныеПоВхождению[0];
	Возврат Результат;

КонецФункции

// Выполняет запрос поиска организаций по готовому тексту условия.
// Общая часть двух шагов НайтиОрганизациюПоНаименованию.
//
// Возвращает Массив ссылок либо Неопределено, если запрос не выполнился
// (например, поле условия отсутствует в конфигурации) - вызывающий код
// трактует Неопределено как «не найдено», а не падает.
//
// Лимит 21: отличить «одна» от «несколько» достаточно двух строк, но список
// кандидатов в детали ошибки полезно показать целиком, а 20 - разумный
// потолок для текста, который читает LLM.
//
Функция ВыполнитьПоискОрганизацийПоУсловию(Знач ИмяРеальное, Знач ТекстУсловия, Знач Текст)

	// Отбор делает СУБД (ГДЕ ... ПОДОБНО / =), а не перебор в коде, поэтому
	// ограничение применяется УЖЕ К СОВПАДЕНИЯМ: на базе с сотнями организаций
	// нужная не «теряется за лимитом». Потолок нужен лишь чтобы не тащить в
	// память весь справочник, когда шаблон совпал почти со всем.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(ПотолокВыборкиКандидатов(), "ЧГ=0") + "
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяРеальное + " КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|	И (" + ТекстУсловия + ")
		|УПОРЯДОЧИТЬ ПО
		|	Организации.Наименование";
	Запрос.УстановитьПараметр("ТекстВРЕГ", ВРег(Текст));
	Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьШаблонПодобно(Текст) + "%");

	Попытка
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(СтрокаТаблицы.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько совпадений максимум вытаскиваем из БД при разрешении организации по
// наименованию. Отбор уже выполнила СУБД, поэтому это не «первые N справочника»,
// а «первые N ПОДХОДЯЩИХ». 200 с запасом покрывает реальные базы и при этом
// даёт честно посчитать неоднозначность, а не упереться в 21.
//
Функция ПотолокВыборкиКандидатов()
	Возврат 200;
КонецФункции

// Сколько кандидатов перечисляем в тексте ошибки organization_name_ambiguous.
// Больше двадцати модель всё равно не покажет пользователю осмысленно, а
// контекст расходуется - остальные сворачиваем в «...соответствует N».
//
Функция ЛимитКандидатовПоиска()
	Возврат 20;
КонецФункции

// Экранирует спецсимволы оператора ПОДОБНО символом "~" (объявляется в запросе
// как СПЕЦСИМВОЛ "~").
//
// Без экранирования «ООО_Ромашка» матчил бы «ООО-Ромашка» и «ОООxРомашка»
// (подчёркивание = любой одиночный символ), а строка с «%» вернула бы весь
// справочник и превратилась в organization_name_ambiguous на ровном месте.
//
// Своей реализации здесь намеренно нет: берём штатную функцию БСП
// [Реф: БСП/ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе]. Она
// экранирует полный набор служебных символов "~_%[]^" - самописный вариант в
// этом модуле упускал "]" и "^" (требование std726).
//
Функция ЭкранироватьШаблонПодобно(Знач Текст)

	Возврат ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(Текст);

КонецФункции

// Деталь к отказу по наименованию организации: перечень кандидатов с ИНН,
// чтобы модель могла либо переспросить пользователя через ask_user, либо
// повторить вызов с точным organization_inn - без этого она повторяет тот же
// промах с тем же наименованием.
//
Функция ДетальОрганизацииПоНаименованию(Знач Наименование, Знач КодОшибки, Знач Кандидаты)

	Если КодОшибки = "organization_name_ambiguous" Тогда
		// Кандидатов может быть больше, чем помещается в текст (список
		// ограничен ЛимитКандидатовПоиска). Молчать об этом нельзя: модель
		// иначе выдаёт усечённый перечень как исчерпывающий.
		Если Кандидаты.Количество() > ЛимитКандидатовПоиска() Тогда
			Показано = Новый Массив;
			Для Индекс = 0 По ЛимитКандидатовПоиска() - 1 Цикл
				Показано.Добавить(Кандидаты[Индекс]);
			КонецЦикла;
			Возврат СтрШаблон(
				НСтр("ru = 'Наименованию ""%1"" соответствует организаций: %2 (это больше, чем можно перечислить). Первые %3: %4. Уточни у пользователя, какая нужна, и повтори вызов с organization_inn - либо задай более точное наименование.';
					|en = 'Name ""%1"" matches %2 organizations (too many to list). First %3: %4. Ask the user which one and retry with organization_inn.'"),
				Наименование, Кандидаты.Количество(), ЛимитКандидатовПоиска(),
				ПредставлениеОрганизацийСИНН(Показано));
		КонецЕсли;

		Возврат СтрШаблон(
			НСтр("ru = 'Наименованию ""%1"" соответствует несколько организаций (%2): %3. Уточни у пользователя, какая нужна, и повтори вызов с organization_inn.';
				|en = 'Name ""%1"" matches several organizations (%2): %3. Ask the user which one and retry with organization_inn.'"),
			Наименование, Кандидаты.Количество(), ПредставлениеОрганизацийСИНН(Кандидаты));
	КонецЕсли;

	// Не найдено - показываем, что вообще есть в базе: чаще всего пользователь
	// назвал организацию иначе, чем она заведена («Атлантика» против «ООО
	// Атлантика-Торг»), и списка достаточно, чтобы модель сама сопоставила.
	ВсеОрганизации = ВсеАктивныеОрганизации();
	Если ВсеОрганизации.Количество() > 0 И ВсеОрганизации.Количество() <= 30 Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'Организация с наименованием ""%1"" не найдена. В базе есть: %2. Выбери подходящую и повтори вызов с organization_inn (или уточни у пользователя).';
				|en = 'Organization named ""%1"" not found. Available: %2.'"),
			Наименование, ПредставлениеОрганизацийСИНН(ВсеОрганизации));
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Организация с наименованием ""%1"" не найдена. Используй search_organizations, чтобы найти её по части названия и получить ИНН.';
			|en = 'Organization named ""%1"" not found. Use search_organizations to look it up by name fragment.'"),
		Наименование);

КонецФункции

// Представление списка организаций с ИНН: «Атлантика (ИНН 7701234567)».
// ИНН обязателен в тексте - именно им модель повторяет вызов, одного
// наименования для этого недостаточно.
//
Функция ПредставлениеОрганизацийСИНН(Знач МассивОрганизаций)

	Элементы = Новый Массив;
	Для Каждого Орг Из МассивОрганизаций Цикл
		ИНН = ИННСсылки(Орг);
		Если ПустаяСтрока(ИНН) Тогда
			Элементы.Добавить(СокрЛП(Строка(Орг)));
		Иначе
			Элементы.Добавить(СтрШаблон("%1 (ИНН %2)", СокрЛП(Строка(Орг)), ИНН));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Элементы, ", ");

КонецФункции

// Находит контрагента по ИНН. Контракт и коды ошибок симметричны
// НайтиОрганизациюПоИНН: contragent_not_found_by_inn / contragent_inn_ambiguous.
//
// У контрагентов дубли по ИНН встречаются чаще, чем у организаций (одно юрлицо
// заведено несколько раз), поэтому неоднозначность - отдельный код, а не
// «взять первого попавшегося».
//
Функция НайтиКонтрагентаПоИНН(Знач ИНН)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");
	МДКонтрагенты = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДКонтрагенты = Неопределено Или МДКонтрагенты.Реквизиты.Найти("ИНН") = Неопределено Тогда
		Результат.Ошибка = "contragent_not_found_by_inn";
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяРеальное + " КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", СокрЛП(ИНН));

	Попытка
		Выборка = Запрос.Выполнить().Выгрузить();
	Исключение
		Результат.Ошибка = "contragent_not_found_by_inn";
		Возврат Результат;
	КонецПопытки;

	Если Выборка.Количество() = 0 Тогда
		Результат.Ошибка = "contragent_not_found_by_inn";
		Возврат Результат;
	КонецЕсли;

	Если Выборка.Количество() > 1 Тогда
		Результат.Ошибка = "contragent_inn_ambiguous";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Выборка[0].Ссылка;
	Возврат Результат;

КонецФункции

// Диагностическая деталь к отказу по организации. Отдельно распознаётся случай
// «передан ИНН КОНТРАГЕНТА» - именно так промахнулась LLM в реальном прогоне
// (ИНН Шилова из search_clients ушёл в organization_inn). Без этой подсказки
// модель повторяет тот же вызов.
//
Функция ДетальНенайденнойОрганизации(Знач ИНН, Знач КодОшибки)

	Если КодОшибки = "organization_inn_ambiguous" Тогда
		Возврат СтрШаблон(
			НСтр("ru='ИНН %1 принадлежит нескольким организациям - уточни, какая нужна.';
				|en='INN %1 matches several organizations.'"), ИНН);
	КонецЕсли;

	РезультатКонтрагент = НайтиКонтрагентаПоИНН(ИНН);
	Если РезультатКонтрагент.Ошибка = "" Тогда
		Возврат СтрШаблон(
			НСтр("ru='ИНН %1 - это КОНТРАГЕНТ ""%2"", а не наша организация."
				+ " Для отбора по контрагенту используй contragent_inn."
				+ " Организация - это наше юрлицо, её ИНН есть в поле"
				+ " organization_inn строк items/by_contragent.';
				|en='INN %1 belongs to counterparty ""%2"", not to an"
				+ " organization. Use contragent_inn instead.'"),
			ИНН, СокрЛП(Строка(РезультатКонтрагент.Ссылка)));
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru='Организация с ИНН %1 не найдена.';
			|en='Organization with INN %1 not found.'"), ИНН);

КонецФункции

// Диагностическая деталь к отказу по контрагенту: отдельно подсказываем, если
// вместо ссылки передали голые цифры (похоже на ИНН).
//
Функция ДетальНенайденногоКонтрагента(Знач СтрокаСсылки)

	Если ПохожеНаИНН(СтрокаСсылки) Тогда
		Возврат СтрШаблон(
			НСтр("ru='""%1"" похоже на ИНН, а не на ссылку. Для отбора по ИНН"
				+ " используй contragent_inn.';
				|en='""%1"" looks like an INN. Use contragent_inn instead.'"),
			СтрокаСсылки);
	КонецЕсли;

	Возврат СтрокаСсылки;

КонецФункции

// Истина, если строка состоит только из цифр и имеет длину ИНН (10 или 12).
// Нужна, чтобы отличить «передали ИНН вместо ссылки» от прочих промахов:
// именно так пришёл вызов {"organization_ref":"9334123401"}.
//
Функция ПохожеНаИНН(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) <> 10 И СтрДлина(Текст) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Истина, если строка - навигационная ссылка на элемент справочника
// Контрагенты. Нужна, чтобы отличить «организация не найдена» от «сюда положили
// контрагента»: первое - мягкая деградация с warning, второе - ошибка вызова.
//
// Проверка идёт по ИМЕНИ объекта в самой навигационной ссылке
// ("e1cib/data/Справочник.Контрагенты?ref=..."), без обращения к базе:
// разыменование здесь не нужно, а по UUID тип вообще не определить.
//
// Параметры:
//  СтрокаСсылки - Строка - значение аргумента.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылка указывает на справочник контрагентов.
//
Функция ЭтоСсылкаНаКонтрагента(Знач СтрокаСсылки)

	Если ТипЗнч(СтрокаСсылки) <> Тип("Строка") Или ПустаяСтрока(СтрокаСсылки) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");
	Возврат СтрНайти(НРег(СтрокаСсылки), НРег("Справочник." + ИмяРеальное)) > 0;

КонецФункции

// Разыменовывает договор контрагента по строке (навигационная ссылка/UUID).
// Возвращает Структуру { Ссылка, Ошибка }.
//
Функция РазыменоватьДоговорФинансы(Знач СтрокаСсылки)
	Возврат РазыменоватьСправочникФинансы(СтрокаСсылки,
		"ДоговорыКонтрагентов", "contract_not_found");
КонецФункции

// Разыменовывает контрагента по строке (навигационная ссылка/UUID).
// Возвращает Структуру { Ссылка, Ошибка } - тот же контракт, что и
// РазыменоватьОрганизациюФинансы.
//
Функция РазыменоватьКонтрагентаФинансы(Знач СтрокаСсылки)
	Возврат РазыменоватьСправочникФинансы(СтрокаСсылки,
		"Контрагенты", "contragent_not_found");
КонецФункции

// Общее разыменование элемента справочника по навигационной ссылке или UUID.
// Выделено, чтобы контрагент и договор не дублировали один и тот же код
// (для организации остаётся своя функция - у неё отдельный код ошибки и она
// уже используется в других местах модуля).
//
// Параметры:
//  СтрокаСсылки    - Строка - навигационная ссылка "e1cib/data/..." либо UUID.
//  ЛогическоеИмя   - Строка - имя справочника для ar_ToolDispatcher.ИмяОбъектаМетаданных.
//  КодОшибки       - Строка - код в поле Ошибка при неудаче.
//
// Возвращаемое значение:
//  Структура { Ссылка, Ошибка }.
//
Функция РазыменоватьСправочникФинансы(Знач СтрокаСсылки, Знач ЛогическоеИмя, Знач КодОшибки)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных(ЛогическоеИмя, ЛогическоеИмя);
	МДСправочник = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДСправочник = Неопределено Тогда
		Результат.Ошибка = КодОшибки;
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("СправочникСсылка." + ИмяРеальное);
	Ссылка = Неопределено;

	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Попытка
			КандидатСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
			Если ТипЗнч(КандидатСсылка) = ТипСсылки Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		Попытка
			УникИдент = Новый УникальныйИдентификатор(СтрокаСсылки);
			КандидатСсылка = Справочники[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если ЗначениеЗаполнено(КандидатСсылка) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Ошибка = КодОшибки;
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

// Разыменовывает организацию по строке (навигационная ссылка/UUID).
// Возвращает Структуру { Ссылка, Ошибка }.
Функция РазыменоватьОрганизациюФинансы(Знач СтрокаСсылки)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации");
	МДОрганизации = Метаданные.Справочники.Найти(ИмяРеальное);
	Если МДОрганизации = Неопределено Тогда
		Результат.Ошибка = "organization_not_found";
		Возврат Результат;
	КонецЕсли;

	ТипСсылки = Тип("СправочникСсылка." + ИмяРеальное);
	Ссылка = Неопределено;

	Если СтрНайти(НРег(СтрокаСсылки), "e1cib/") > 0 Тогда
		Попытка
			КандидатСсылка = ar_Утилиты.ОбъектИзНавигационнойСсылки(СтрокаСсылки);
			Если ТипЗнч(КандидатСсылка) = ТипСсылки Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Тогда
		Попытка
			УникИдент = Новый УникальныйИдентификатор(СтрокаСсылки);
			КандидатСсылка = Справочники[ИмяРеальное].ПолучитьСсылку(УникИдент);
			Если ЗначениеЗаполнено(КандидатСсылка) Тогда
				Ссылка = КандидатСсылка;
			КонецЕсли;
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ссылка = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Ошибка = "organization_not_found";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

// Приводит значение выборки запроса к Числу (0 при Неопределено/не-число).
Функция ПривестиКЧислу(Знач Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Возвращает значение из Соответствия по ключу с дефолтом.
Функция ЗначениеПоКлючуФинансы(Знач Коллекция, Знач Ключ, Знач Дефолт)
	Если ТипЗнч(Коллекция) <> Тип("Соответствие") Тогда
		Возврат Дефолт;
	КонецЕсли;
	Значение = Коллекция.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат Значение;
КонецФункции

#КонецОбласти

#Область НеоплаченныеСчета

// Основная логика list_unpaid_invoices (PAY-01). Выделена из
// СписокНеоплаченныхСчетов, чтобы внешний Попытка/Исключение ловил любые
// непредвиденные ошибки (DoD «check_1c_code без Error»).
//
// Алгоритм (см. .docs/specs/PAY-01.md, §list_unpaid_invoices):
//  1. Десериализация аргументов, дефолты (days_back=30, limit=50).
//  2. Разрешение организаций (аргумент/настройка/единственная в базе).
//  3. Опциональный фильтр по контрагенту (client_ref).
//  4. Поиск доп.свойства исключений по имени (best-effort, warning при
//     отсутствии) - соединения-исключения подключаются к тексту запроса
//     ТОЛЬКО если свойство найдено.
//  5. Запрос: счета + статус оплаты + срок оплаты + факт оплаты (Обороты) +
//     (условно) соединения-исключения - фильтрация исключений ВНУТРИ запроса
//     (условие ГДЕ при include_excluded=false), НЕ постфильтром в цикле по
//     выборке - ни одного дополнительного запроса к БД на строку списка не
//     выполняется (excluded/exclusion_reason читаются из полей выборки,
//     подтянутых теми же ЛЕВЫМИ СОЕДИНЕНИЯМИ).
//  6. Пост-обработка: payment_status/debt_amount/days_overdue вычисляются
//     на стороне 1С (не в SQL); only_unpaid/include_partially_paid/
//     min_amount/limit применяются здесь же, к уже отобранным строкам.
//
Функция СписокНеоплаченныхСчетовВнутр(Знач Аргументы, Знач Контекст)

	Объект = ar_JSON.ИзJSON(Аргументы);
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Объект = Новый Соответствие;
	КонецЕсли;

	Предупреждения = Новый Массив;
	ДобавитьПредупрежденияОНеизвестныхКлючахСчетов(Объект, Предупреждения);

	// 1. Период.
	ТекущаяДата = ТекущаяДатаСеанса();
	СтрокаДатыОт = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "date_from", "")));
	СтрокаДатыДо = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "date_to", "")));

	Если Не ПустаяСтрока(СтрокаДатыОт) И Не ПустаяСтрока(СтрокаДатыДо) Тогда
		РазобраннаяОт = ar_Утилиты.ДатаИзСтроки(СтрокаДатыОт);
		РазобраннаяДо = ar_Утилиты.ДатаИзСтроки(СтрокаДатыДо);
		Если РазобраннаяОт = Неопределено Или РазобраннаяДо = Неопределено Тогда
			Возврат ОшибочныйJSONФинансы("invalid_date_range");
		КонецЕсли;
		ДатаНачалаОтбора = НачалоДня(РазобраннаяОт);
		ДатаОкончанияОтбора = КонецДня(РазобраннаяДо);
	Иначе
		// 365, а не 30: неоплаченный счёт по определению старый - отбор по
		// ДАТЕ ВЫСТАВЛЕНИЯ с коротким окном прятал именно ту задолженность,
		// ради которой tool и вызывают. Верхнюю границу выдачи держит limit.
		ДнейНазад = ДнейНазадПоУмолчанию();
		СыроеДнейНазад = ЗначениеПоКлючуФинансы(Объект, "days_back", Неопределено);
		Если ТипЗнч(СыроеДнейНазад) = Тип("Число") Тогда
			ЦелыеДниНазад = Цел(СыроеДнейНазад);
			Если ЦелыеДниНазад >= 1 И ЦелыеДниНазад <= 365 Тогда
				ДнейНазад = ЦелыеДниНазад;
			КонецЕсли;
		КонецЕсли;
		ДатаНачалаОтбора = НачалоДня(ТекущаяДата - ДнейНазад * 86400);
		ДатаОкончанияОтбора = КонецДня(ТекущаяДата);
	КонецЕсли;

	// 2. Организации. Наименование - запасной путь к ИНН: пользователь в чате
	// называет организацию словами, а ИНН модели взять неоткуда.
	СтрокаИННОрганизации = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "organization_inn", "")));
	СтрокаИмениОрганизации = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "organization_name", "")));
	РазрешениеОрг = РазрешитьОрганизацииОплат(СтрокаИННОрганизации, СтрокаИмениОрганизации);
	Если РазрешениеОрг.Ошибка <> "" Тогда
		Возврат ОшибочныйJSONСДетальюФинансы(РазрешениеОрг.Ошибка, РазрешениеОрг.Деталь);
	КонецЕсли;
	Для Каждого ТекстПредупреждения Из РазрешениеОрг.Предупреждения Цикл
		Предупреждения.Добавить(ТекстПредупреждения);
	КонецЦикла;

	// 3. Контрагент (опционально).
	СсылкаКонтрагента = Неопределено;
	СтрокаКонтрагента = СокрЛП(Строка(ЗначениеПоКлючуФинансы(Объект, "client_ref", "")));
	Если Не ПустаяСтрока(СтрокаКонтрагента) Тогда
		РезультатКонтрагента = РазыменоватьКонтрагентаФинансы(СтрокаКонтрагента);
		Если РезультатКонтрагента.Ошибка <> "" Тогда
			Возврат ОшибочныйJSONСДетальюФинансы("client_not_found", СтрокаКонтрагента);
		КонецЕсли;
		СсылкаКонтрагента = РезультатКонтрагента.Ссылка;
	КонецЕсли;

	// Аргументы отбора/выдачи.
	ТолькоНеоплаченные = (ЗначениеПоКлючуФинансы(Объект, "only_unpaid", Истина) <> Ложь);
	ВключатьЧастичноОплаченные = (ЗначениеПоКлючуФинансы(Объект, "include_partially_paid", Истина) <> Ложь);
	ВключатьИсключённые = (ЗначениеПоКлючуФинансы(Объект, "include_excluded", Ложь) = Истина);

	МинСумма = Неопределено;
	СыраяМинСумма = ЗначениеПоКлючуФинансы(Объект, "min_amount", Неопределено);
	Если ТипЗнч(СыраяМинСумма) = Тип("Число") Тогда
		МинСумма = СыраяМинСумма;
	КонецЕсли;

	Лимит = 50;
	СыройЛимит = ЗначениеПоКлючуФинансы(Объект, "limit", Неопределено);
	Если ТипЗнч(СыройЛимит) = Тип("Число") Тогда
		ЦелыйЛимит = Цел(СыройЛимит);
		Если ЦелыйЛимит >= 1 И ЦелыйЛимит <= 200 Тогда
			Лимит = ЦелыйЛимит;
		КонецЕсли;
	КонецЕсли;

	// 4. Доп.свойство исключений - поиск по имени (best-effort).
	СвойствоИсключений = НайтиСвойствоИсключенийПоИмени();
	ЕстьСвойствоИсключений = (СвойствоИсключений <> Неопределено);
	Если Не ЕстьСвойствоИсключений Тогда
		Предупреждения.Добавить("exclusion_property_not_found");
	КонецЕсли;

	// 5. Запрос.
	Попытка
		Выборка = ВыполнитьЗапросНеоплаченныхСчетов(ДатаНачалаОтбора, ДатаОкончанияОтбора,
			РазрешениеОрг.Организации, СсылкаКонтрагента, ЕстьСвойствоИсключений, СвойствоИсключений,
			ВключатьИсключённые);
	Исключение
		ИнформацияОшибки = ИнформацияОбОшибке();
		ТекстОшибкиЗапроса = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОшибки);
		ar_СлужебныйЛог.Записать("ar_ToolФинансы.СписокНеоплаченныхСчетовВнутр",
			"unpaid_invoices_query_failed", ТекстОшибкиЗапроса, "Ошибка");
		Если ЭтоОшибкаПравДоступа(ТекстОшибкиЗапроса) Тогда
			Возврат ОшибочныйJSONФинансы("access_denied");
		КонецЕсли;
		Возврат ОшибочныйJSONСДетальюФинансы("query_failed",
			ar_Утилиты.ОчиститьОшибкуДляLLM(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОшибки)));
	КонецПопытки;

	// 6. Пост-обработка.
	Счета = Новый Массив;
	ВсегоНайдено = 0;
	ВсегоИсключено = 0;
	ИтогоСумма = 0;
	ИтогоДолг = 0;

	Пока Выборка.Следующий() Цикл

		СуммаОплаты = ПривестиКЧислу(Выборка.СуммаОплаты);
		СуммаДокумента = ПривестиКЧислу(Выборка.Сумма);
		СуммаДолга = Макс(0, СуммаДокумента - СуммаОплаты);

		Если СуммаДолга <= 0 Тогда
			СтатусОплаты = "paid";
		ИначеЕсли СуммаОплаты > 0 Тогда
			СтатусОплаты = "partial";
		Иначе
			СтатусОплаты = "unpaid";
		КонецЕсли;

		Если ТолькоНеоплаченные И СтатусОплаты = "paid" Тогда
			Продолжить;
		КонецЕсли;
		Если Не ВключатьЧастичноОплаченные И СтатусОплаты = "partial" Тогда
			Продолжить;
		КонецЕсли;
		Если МинСумма <> Неопределено И СуммаДолга < МинСумма Тогда
			Продолжить;
		КонецЕсли;

		// Признаки исключения - поля ИсключёнКонтрагент/ИсключёнСчёт УЖЕ
		// прочитаны тем же запросом (условные ЛЕВЫЕ СОЕДИНЕНИЯ, см.
		// ВыполнитьЗапросНеоплаченныхСчетов) - здесь только интерпретация
		// значений выборки, БЕЗ дополнительных запросов к БД на строку
		// (см. Замечания ревью 1, п.2 - CreateQueryInCycle устранён).
		// Обращение к полям Выборка.ИсключёнКонтрагент/ИсключёнСчёт ТОЛЬКО
		// внутри Если ЕстьСвойствоИсключений - операторы И/ИЛИ в BSL НЕ short-
		// circuit (оба операнда вычисляются всегда), поля в выборке отсутствуют
		// вовсе, когда СвойствоИсключений не найдено (см. ПоляИсключений в
		// ВыполнитьЗапросНеоплаченныхСчетов) - обращение к ним дало бы
		// FieldNotFound.
		ИсключёнПоКонтрагенту = Ложь;
		ИсключёнПоСчёту = Ложь;
		Если ЕстьСвойствоИсключений Тогда
			ИсключёнПоКонтрагенту = (Выборка.ИсключёнКонтрагент = Истина);
			ИсключёнПоСчёту = Не ИсключёнПоКонтрагенту И (Выборка.ИсключёнСчёт = Истина);
		КонецЕсли;
		Исключён = ИсключёнПоКонтрагенту Или ИсключёнПоСчёту;

		Если Исключён Тогда
			ВсегоИсключено = ВсегоИсключено + 1;
			Если Не ВключатьИсключённые Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ВсегоНайдено = ВсегоНайдено + 1;
		ИтогоСумма = ИтогоСумма + СуммаДокумента;
		ИтогоДолг = ИтогоДолг + СуммаДолга;

		Если Счета.Количество() >= Лимит Тогда
			Продолжить;
		КонецЕсли;

		СрокОплаты = Выборка.СрокОплаты;
		Если ЗначениеЗаполнено(СрокОплаты) Тогда
			ДнейПросрочки = Макс(0, ЦелыеДниМеждуДатами(СрокОплаты, ТекущаяДата));
		Иначе
			ДнейПросрочки = Неопределено;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("invoice_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.СчётНаОплату));
		Элемент.Вставить("number", СокрЛП(Строка(Выборка.Номер)));
		Элемент.Вставить("date", ar_Утилиты.ФорматДата(Выборка.Дата));
		Элемент.Вставить("client_ref", ar_Утилиты.НавигационнаяСсылкаОбъекта(Выборка.Контрагент));
		Элемент.Вставить("client_name", СокрЛП(Строка(Выборка.КонтрагентИмя)));
		Элемент.Вставить("client_inn", СокрЛП(Строка(Выборка.КонтрагентИНН)));
		Элемент.Вставить("organization_name", СокрЛП(Строка(Выборка.Организация)));
		Элемент.Вставить("amount", СуммаДокумента);
		Элемент.Вставить("paid_amount", СуммаОплаты);
		Элемент.Вставить("debt_amount", СуммаДолга);
		Элемент.Вставить("currency", СокрЛП(Строка(Выборка.ВалютаДокумента)));
		Элемент.Вставить("payment_status", СтатусОплаты);
		Элемент.Вставить("due_date", ?(ЗначениеЗаполнено(СрокОплаты), ar_Утилиты.ФорматДата(СрокОплаты), Неопределено));
		Элемент.Вставить("days_overdue", ДнейПросрочки);
		Элемент.Вставить("days_since_issue", ЦелыеДниМеждуДатами(Выборка.Дата, ТекущаяДата));
		Элемент.Вставить("excluded", Исключён);
		Если ИсключёнПоКонтрагенту Тогда
			ПричинаИсключения = "by_client";
		ИначеЕсли ИсключёнПоСчёту Тогда
			ПричинаИсключения = "by_invoice";
		Иначе
			ПричинаИсключения = Неопределено;
		КонецЕсли;
		Элемент.Вставить("exclusion_reason", ПричинаИсключения);

		Счета.Добавить(Элемент);

	КонецЦикла;

	Если ВсегоНайдено > Счета.Количество() Тогда
		Предупреждения.Добавить("result_truncated");
	КонецЕсли;

	Область = Новый Структура;
	Область.Вставить("organization_name", РазрешениеОрг.ПредставлениеОрганизаций);
	Область.Вставить("organization_source", РазрешениеОрг.Источник);
	Область.Вставить("excluded_count", ВсегоИсключено);

	Итоги = Новый Структура;
	Итоги.Вставить("total_amount", ИтогоСумма);
	Итоги.Вставить("total_debt", ИтогоДолг);

	Результат = Новый Структура;
	Результат.Вставить("invoices", Счета);
	Результат.Вставить("scope", Область);
	Результат.Вставить("totals", Итоги);
	Результат.Вставить("total_found", ВсегоНайдено);

	// Пусто по названной организации - но у похожей по имени счета могут быть
	// (справочник вида «Атлантика», «Атлантика Группа», «Атлантика-Снабжение»:
	// точное совпадение уводит в однофамильца, и tool честно отвечает «ноль»,
	// а пользователь читает это как «счетов нет вообще»). Отдаём счётчики по
	// похожим, чтобы модель переспросила по существу, а не пересказывала пустоту.
	Если ВсегоНайдено = 0 И РазрешениеОрг.Источник = "argument"
		И РазрешениеОрг.Организации.Количество() = 1 Тогда

		Похожие = ПохожиеОрганизацииСоСчетами(РазрешениеОрг.Организации[0],
			ДатаНачалаОтбора, ДатаОкончанияОтбора);
		Если Похожие.Количество() > 0 Тогда
			Результат.Вставить("similar_organizations", Похожие);
			Предупреждения.Добавить("no_invoices_for_organization");
		КонецЕсли;

	КонецЕсли;

	Если Предупреждения.Количество() > 0 Тогда
		Результат.Вставить("warnings", Предупреждения);
	Иначе
		Результат.Вставить("warnings", Новый Массив);
	КонецЕсли;

	Возврат ar_JSON.ВЗначениеJSON(Результат);

КонецФункции

// Запрос счетов покупателям за период с фактом оплаты и статусом (текст -
// по образцу Reports/АнализНеоплаченныхСчетовПокупателям, см.
// .docs/specs/PAY-01.md §list_unpaid_invoices). Обороты ОплатаСчетов
// считаются с НачалоДня(МинДата) до ТекущаяДатаСеанса() - широкий диапазон
// независимо от периода отбора самих счетов (см. «Риски» спеки: иначе оплата
// позже отчётной даты выборки терялась бы).
//
// Фильтрация исключений - ВНУТРИ этого запроса, НЕ постфильтром в цикле по
// выборке (см. Замечания ревью 1, п.2 - постфильтр с доп.запросами на строку
// был CreateQueryInCycle и портил limit неполными страницами). Признаки
// ИсключёнКонтрагент/ИсключёнСчёт подтягиваются условными ЛЕВЫМИ СОЕДИНЕНИЯМИ
// (ТЧ Контрагенты.ДополнительныеРеквизиты и РегистрСведений.
// ДополнительныеСведения) ТОЛЬКО если СвойствоИсключений найдено - иначе
// фрагменты вовсе не подключаются к тексту запроса. При
// ВключатьИсключённые = Ложь строки с любым из двух признаков ИСТИНА
// отсекаются условием ГДЕ - вызывающая сторона получает точный limit без
// постобработки; сами значения признаков всё равно возвращаются в выборке
// (нужны для excluded/exclusion_reason при ВключатьИсключённые = Истина).
//
// Параметры:
//  ДатаНачалаОтбора, ДатаОкончанияОтбора - Дата - период отбора счетов.
//  МассивОрганизаций                     - Массив - организации (непустой).
//  СсылкаКонтрагента                     - СправочникСсылка/Неопределено.
//  ЕстьСвойствоИсключений                - Булево.
//  СвойствоИсключений                    - ПланВидовХарактеристикСсылка/Неопределено.
//  ВключатьИсключённые                   - Булево - Истина: не отсекать
//                                          исключённые строки в ГДЕ (аргумент
//                                          include_excluded tool).
//
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - поля ИсключёнКонтрагент/ИсключёнСчёт
//  присутствуют, только если ЕстьСвойствоИсключений = Истина.
//
Функция ВыполнитьЗапросНеоплаченныхСчетов(Знач ДатаНачалаОтбора, Знач ДатаОкончанияОтбора,
	Знач МассивОрганизаций, Знач СсылкаКонтрагента, Знач ЕстьСвойствоИсключений, Знач СвойствоИсключений,
	Знач ВключатьИсключённые = Ложь)

	УсловиеКонтрагента = "";
	Если СсылкаКонтрагента <> Неопределено Тогда
		УсловиеКонтрагента = "
			|	И СчетНаОплатуПокупателю.Контрагент = &Контрагент";
	КонецЕсли;

	// Исключение по контрагенту - соединение с ТЧ ДополнительныеРеквизиты
	// контрагента (значение Булево через Характеристика.ДополнительныеРеквизитыИСведения).
	// Исключение по счёту - соединение с РегистрСведений.ДополнительныеСведения
	// (Объект = счёт). Оба - ЛЕВЫЕ соединения (не должны сужать выборку сами
	// по себе - сужение делает отдельное условие ГДЕ ниже, только когда
	// ВключатьИсключённые = Ложь).
	ПоляИсключений = "";
	СоединенияИсключений = "";
	УсловиеИсключений = "";
	Если ЕстьСвойствоИсключений Тогда
		ПоляИсключений =
			",
			|	ЕСТЬNULL(ИсклПоКонтрагенту.Значение, ЛОЖЬ) КАК ИсключёнКонтрагент,
			|	ЕСТЬNULL(ИсклПоСчёту.Значение, ЛОЖЬ) КАК ИсключёнСчёт";
		СоединенияИсключений =
			"
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ДополнительныеРеквизиты КАК ИсклПоКонтрагенту
			|	ПО ИсклПоКонтрагенту.Ссылка = СчетНаОплатуПокупателю.Контрагент
			|	И ИсклПоКонтрагенту.Свойство = &СвойствоИсключений
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИсклПоСчёту
			|	ПО ИсклПоСчёту.Объект = СчетНаОплатуПокупателю.Ссылка
			|	И ИсклПоСчёту.Свойство = &СвойствоИсключений";
		Если Не ВключатьИсключённые Тогда
			УсловиеИсключений = "
				|	И НЕ (ЕСТЬNULL(ИсклПоКонтрагенту.Значение, ЛОЖЬ) ИЛИ ЕСТЬNULL(ИсклПоСчёту.Значение, ЛОЖЬ))";
		КонецЕсли;
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	СчетНаОплатуПокупателю.Ссылка КАК СчётНаОплату,
		|	СчетНаОплатуПокупателю.Номер КАК Номер,
		|	СчетНаОплатуПокупателю.Дата КАК Дата,
		|	СчетНаОплатуПокупателю.Организация КАК Организация,
		|	СчетНаОплатуПокупателю.Контрагент КАК Контрагент,
		|	СчетНаОплатуПокупателю.Контрагент.Наименование КАК КонтрагентИмя,
		|	СчетНаОплатуПокупателю.Контрагент.ИНН КАК КонтрагентИНН,
		|	СчетНаОплатуПокупателю.СуммаДокумента КАК Сумма,
		|	СчетНаОплатуПокупателю.ВалютаДокумента КАК ВалютаДокумента,
		|	СтатусыДокументов.Статус КАК Статус,
		|	СрокиОплатыДокументов.СрокОплаты КАК СрокОплаты,
		|	ЕСТЬNULL(ОплатаСчетовОбороты.СуммаОборот, 0) КАК СуммаОплаты" + ПоляИсключений + "
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументов КАК СтатусыДокументов
		|		ПО СтатусыДокументов.Организация = СчетНаОплатуПокупателю.Организация
		|		И СтатусыДокументов.Документ = СчетНаОплатуПокупателю.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиОплатыДокументов КАК СрокиОплатыДокументов
		|		ПО СрокиОплатыДокументов.Организация = СчетНаОплатуПокупателю.Организация
		|		И СрокиОплатыДокументов.Документ = СчетНаОплатуПокупателю.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОплатаСчетов.Обороты(
		|				&ДатаНачалаОборотов, &ДатаОкончанияОборотов, , СчетНаОплату В
		|					(ВЫБРАТЬ СчетНаОплатуПокупателю.Ссылка
		|					 ИЗ Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		|					 ГДЕ СчетНаОплатуПокупателю.Дата МЕЖДУ &ДатаНачалаОтбора И &ДатаОкончанияОтбора)
		|			) КАК ОплатаСчетовОбороты
		|		ПО ОплатаСчетовОбороты.Организация = СчетНаОплатуПокупателю.Организация
		|		И ОплатаСчетовОбороты.СчетНаОплату = СчетНаОплатуПокупателю.Ссылка" + СоединенияИсключений + "
		|ГДЕ
		|	СчетНаОплатуПокупателю.Проведен
		|	И НЕ СчетНаОплатуПокупателю.ПометкаУдаления
		|	И СчетНаОплатуПокупателю.Дата МЕЖДУ &ДатаНачалаОтбора И &ДатаОкончанияОтбора
		|	И СчетНаОплатуПокупателю.Организация В (&Организации)
		|	И (СтатусыДокументов.Статус ЕСТЬ NULL ИЛИ СтатусыДокументов.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусОплатыСчета.Отменен))"
		+ УсловиеКонтрагента + УсловиеИсключений;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаНачалаОборотов", НачалоДня(ДатаМинимальнаяДляОборотов()));
	Запрос.УстановитьПараметр("ДатаОкончанияОборотов", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДатаНачалаОтбора", ДатаНачалаОтбора);
	Запрос.УстановитьПараметр("ДатаОкончанияОтбора", ДатаОкончанияОтбора);
	Запрос.УстановитьПараметр("Организации", МассивОрганизаций);
	Если СсылкаКонтрагента <> Неопределено Тогда
		Запрос.УстановитьПараметр("Контрагент", СсылкаКонтрагента);
	КонецЕсли;
	Если ЕстьСвойствоИсключений Тогда
		Запрос.УстановитьПараметр("СвойствоИсключений", СвойствоИсключений);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Организации, похожие по наименованию на заданную, у которых за тот же
// период ЕСТЬ счета покупателям (PAY-01, п.1 разбора кейса «Атлантика
// Группа»). Вызывается ТОЛЬКО когда по явно названной организации выдача
// пустая - иначе лишний запрос к БД на каждый успешный вызов tool.
//
// Зачем: в справочнике организаций живут однофамильцы («Атлантика»,
// «Атлантика Группа», «Атлантика-Снабжение», «Атлантика-Трейдинг»). Точное
// совпадение по имени уводит в ту из них, где счетов нет, tool возвращает
// честный ноль, а пользователь читает ответ как «неоплаченных счетов нет» -
// хотя у соседней организации они есть. Счётчик по похожим даёт модели
// материал для уточняющего вопроса вместо пересказа пустоты.
//
// Похожесть - вхождение ПЕРВОГО слова наименования (для «Атлантика Группа»
// это «Атлантика»): дешевле и предсказуемее нечёткого сравнения, и покрывает
// типовой случай «общий корень + уточнение». Сама заданная организация из
// результата исключается.
//
// Счета считаются ТЕМ ЖЕ отбором, что и основной запрос (проведён, не помечен
// на удаление, статус не Отменен, тот же период) - иначе подсказка обещала бы
// счета, которых повторный вызов не покажет. Полнота оплаты здесь НЕ
// проверяется: это счётчик «есть что смотреть», а не выдача.
//
// Параметры:
//  ЗаданнаяОрганизация - СправочникСсылка.Организации - та, по которой пусто.
//  ДатаНачалаОтбора, ДатаОкончанияОтбора - Дата - период основного запроса.
//
// Возвращаемое значение:
//  Массив из Структура (organization_name, organization_inn, invoices_count) -
//  пустой, если похожих со счетами нет.
//
Функция ПохожиеОрганизацииСоСчетами(Знач ЗаданнаяОрганизация,
	Знач ДатаНачалаОтбора, Знач ДатаОкончанияОтбора)

	Результат = Новый Массив;

	Наименование = СокрЛП(Строка(ЗаданнаяОрганизация));
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Результат;
	КонецЕсли;

	// Первое слово - основа поиска однофамильцев.
	ЧастиИмени = СтрРазделить(Наименование, " ", Ложь);
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Основа = СокрЛП(ЧастиИмени[0]);
	// Односимвольная основа дала бы шаблон "%х%" - половина справочника.
	Если СтрДлина(Основа) < 3 Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 10
		|	Организации.Ссылка КАК Организация,
		|	КОЛИЧЕСТВО(СчетНаОплатуПокупателю.Ссылка) КАК КоличествоСчетов
		|ИЗ
		|	Справочник." + ИмяРеальное + " КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		|		ПО СчетНаОплатуПокупателю.Организация = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументов КАК СтатусыДокументов
		|		ПО СтатусыДокументов.Организация = СчетНаОплатуПокупателю.Организация
		|		И СтатусыДокументов.Документ = СчетНаОплатуПокупателю.Ссылка
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|	И Организации.Ссылка <> &ЗаданнаяОрганизация
		|	И Организации.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|	И СчетНаОплатуПокупателю.Проведен
		|	И НЕ СчетНаОплатуПокупателю.ПометкаУдаления
		|	И СчетНаОплатуПокупателю.Дата МЕЖДУ &ДатаНачалаОтбора И &ДатаОкончанияОтбора
		|	И (СтатусыДокументов.Статус ЕСТЬ NULL ИЛИ СтатусыДокументов.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусОплатыСчета.Отменен))
		|СГРУППИРОВАТЬ ПО
		|	Организации.Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	КоличествоСчетов УБЫВ";
	Запрос.УстановитьПараметр("ЗаданнаяОрганизация", ЗаданнаяОрганизация);
	Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьШаблонПодобно(Основа) + "%");
	Запрос.УстановитьПараметр("ДатаНачалаОтбора", ДатаНачалаОтбора);
	Запрос.УстановитьПараметр("ДатаОкончанияОтбора", ДатаОкончанияОтбора);

	// Подсказка - вспомогательная: её падение не должно ронять сам ответ
	// tool, который к этому моменту уже полностью собран.
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ar_СлужебныйЛог.Записать("ar_ToolФинансы.ПохожиеОрганизацииСоСчетами",
			"similar_orgs_query_failed",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "Предупреждение");
		Возврат Новый Массив;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("organization_name", СокрЛП(Строка(Выборка.Организация)));
		Элемент.Вставить("organization_inn", ИННСсылки(Выборка.Организация));
		Элемент.Вставить("invoices_count", Выборка.КоличествоСчетов);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нижняя граница периода оборотов ОплатаСчетов - достаточно широкая, чтобы
// покрыть оплату по любому счёту в пределах разумного срока жизни данных
// (5 лет назад от текущей даты сеанса). Фиксированная константа проще и
// надёжнее динамического МИН(Дата) по документам (без обращения к базе).
//
Функция ДатаМинимальнаяДляОборотов()
	Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -60);
КонецФункции

// Глубина отбора счетов по умолчанию (days_back), когда период не задан
// явно ни date_from/date_to, ни days_back. Год, а не месяц: фильтр
// применяется к ДАТЕ ВЫСТАВЛЕНИЯ счёта, а просроченная задолженность тем
// и отличается, что счёт выставлен давно - на 30 днях tool отвечал «не
// найдено» при наличии долга. Совпадает с верхней границей допустимого
// days_back, так что дефолт даёт максимально широкое окно.
//
Функция ДнейНазадПоУмолчанию()
	Возврат 365;
КонецФункции

// Целое число дней между двумя датами (МАКС(0,...) не применяется здесь -
// вызывающий код сам решает, нужен ли Макс).
//
Функция ЦелыеДниМеждуДатами(Знач ОтДата, Знач ДоДата)
	Возврат Цел((ДоДата - ОтДата) / 86400);
КонецФункции

// Аргументы, которые понимает list_unpaid_invoices. Всё, чего здесь нет,
// попадает в warnings как unknown_argument (см. ДобавитьПредупрежденияОНеизвестныхКлючахСчетов).
//
Функция ПоддерживаемыеАргументыСчетов()

	Имена = Новый Массив;
	Имена.Добавить("days_back");
	Имена.Добавить("date_from");
	Имена.Добавить("date_to");
	Имена.Добавить("organization_inn");
	Имена.Добавить("organization_name");
	Имена.Добавить("client_ref");
	Имена.Добавить("only_unpaid");
	Имена.Добавить("include_partially_paid");
	Имена.Добавить("min_amount");
	Имена.Добавить("include_excluded");
	Имена.Добавить("limit");
	Имена.Добавить("_dry_run");
	Имена.Добавить("_idempotency_key");

	Возврат Имена;

КонецФункции

// Добавляет в Предупреждения по одной записи "unknown_argument:<ключ>" на
// каждый непонятый аргумент list_unpaid_invoices.
//
Процедура ДобавитьПредупрежденияОНеизвестныхКлючахСчетов(Знач Объект, Предупреждения)

	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Поддерживаемые = ПоддерживаемыеАргументыСчетов();

	Для Каждого КлючЗначение Из Объект Цикл
		Ключ = СокрЛП(Строка(КлючЗначение.Ключ));
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если Поддерживаемые.Найти(Ключ) = Неопределено Тогда
			Предупреждения.Добавить("unknown_argument:" + Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОрганизацииИИсключенияОплат

// Разрешает список организаций контроля оплат (PAY-01, §Организации контроля).
// Используется list_unpaid_invoices и (через экспортную обёртку) prepare_
// payment_reminder_email / get_invoice_reminder_history там, где применимо.
//
// Порядок разрешения:
//  1. Явный АргументИНН (либо АргументНаименование, если ИНН не задан) -
//     приоритет, разовый просмотр одной организации. Если она не входит в
//     настроенный список - НЕ ошибка, warning organization_out_of_scope,
//     Источник="argument".
//  2. Иначе - весь список из ar_Настройки.СписокЗначений("ОрганизацииКонтроляОплат")
//     (счета отбираются по нескольким организациям сразу), Источник="constant".
//  3. Настройка пуста и в базе ОДНА организация (без пометки удаления) -
//     берём её, Источник="single_org".
//  4. Настройка пуста и организаций несколько - Ошибка=organization_scope_not_configured.
//
// Строки настройки, которые НЕ удалось разыменовать (навигационная ссылка/UUID
// битая, объект удалён и т.п.) - НЕ пропускаются молча: организация тихо
// выпавшая из контроля означает недосбор по её неоплаченным счетам, а вызывающая
// сторона не узнала бы об этом (см. Замечания ревью 1, п.1). Такие строки
// собираются и возвращаются в Предупреждения как "settings_ref_unresolved" с
// перечнем нерезолвящихся значений - вызывающий код обязан прокинуть их в
// warnings ответа tool.
//
// Параметры:
//  Знач АргументИНН - Строка - ИНН организации из аргумента tool (может быть "").
//  Знач АргументНаименование - Строка - наименование организации или его часть
//              (organization_name). Используется, ТОЛЬКО если АргументИНН пуст:
//              ИНН однозначен, наименование - нет, поэтому при обоих заданных
//              выигрывает ИНН.
//
// Возвращаемое значение:
//  Структура { Организации - Массив из СправочникСсылка.Организации;
//              Источник - Строка ("argument"/"constant"/"single_org"/"");
//              ПредставлениеОрганизаций - Строка;
//              Предупреждения - Массив Строк (может содержать
//                "organization_out_of_scope" и/или
//                "settings_ref_unresolved: <список нерезолвящихся строк>");
//              Ошибка - Строка; Деталь - Строка }.
//
Функция РазрешитьОрганизацииОплат(Знач АргументИНН, Знач АргументНаименование = "") Экспорт

	Результат = Новый Структура(
		"Организации, Источник, ПредставлениеОрганизаций, Предупреждения, Ошибка, Деталь",
		Новый Массив, "", "", Новый Массив, "", "");

	// Список из настройки - нужен в любом случае (для проверки out_of_scope
	// при явном ИНН и как основной путь при его отсутствии).
	//
	// Значение строки ТЧ приходит в двух видах, оба поддерживаются:
	//  * СправочникСсылка.Организации - реквизит ar_Значение имеет тип
	//    ЛюбаяСсылка (AnyIBRef), администратор выбрал организацию подбором
	//    в форме. Берём ссылку как есть - разыменовывать нечего;
	//  * Строка - навигационная ссылка "e1cib/data/Справочник.Организации?ref=..."
	//    в ar_ЗначениеСтрока (исходный вариант хранения, см. ar_Настройки).
	//    Разыменовываем через РазыменоватьОрганизациюФинансы.
	// Проверка идёт по ТИПУ значения, а не по Строка(...): для ссылки
	// Строка(Ссылка) даёт представление ("Атлантика"), которое не является
	// навигационной ссылкой и не разыменовывается - раньше такие строки молча
	// уходили в НеразрешённыеСтроки, список организаций оказывался пустым и
	// tool возвращал organization_scope_not_configured при заполненной настройке.
	// Значения, которые не удалось привести к ссылке на организацию, НЕ
	// отбрасываются молча - собираются отдельно и попадают в Предупреждения.
	СтрокиИзНастройки = ar_Настройки.СписокЗначений("ОрганизацииКонтроляОплат");
	СписокИзНастройки = Новый Массив;
	НеразрешённыеСтроки = Новый Массив;
	ТипОрганизации = Тип("СправочникСсылка." + ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации"));
	Для Каждого ЭлементНастройки Из СтрокиИзНастройки Цикл

		Если ТипЗнч(ЭлементНастройки) = ТипОрганизации Тогда
			Если ЗначениеЗаполнено(ЭлементНастройки) Тогда
				СписокИзНастройки.Добавить(ЭлементНастройки);
			Иначе
				НеразрешённыеСтроки.Добавить(НСтр("ru = '<пустая ссылка>'; en = '<empty ref>'"));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		СокрЛПСтрока = СокрЛП(Строка(ЭлементНастройки));
		РезультатОрг = РазыменоватьОрганизациюФинансы(СокрЛПСтрока);
		Если РезультатОрг.Ошибка = "" Тогда
			СписокИзНастройки.Добавить(РезультатОрг.Ссылка);
		Иначе
			НеразрешённыеСтроки.Добавить(СокрЛПСтрока);
		КонецЕсли;

	КонецЦикла;
	Если НеразрешённыеСтроки.Количество() > 0 Тогда
		Результат.Предупреждения.Добавить("settings_ref_unresolved: "
			+ СтрСоединить(НеразрешённыеСтроки, ", "));
	КонецЕсли;

	// Организация из аргумента: ИНН - приоритетный (однозначный) способ,
	// наименование - запасной, для случая «пользователь назвал организацию
	// словами, а ИНН модели взять негде».
	СсылкаИзАргумента = Неопределено;

	Если Не ПустаяСтрока(АргументИНН) Тогда

		РезультатПоИНН = НайтиОрганизациюПоИНН(АргументИНН);
		Если РезультатПоИНН.Ошибка <> "" Тогда
			Результат.Ошибка = РезультатПоИНН.Ошибка;
			Результат.Деталь = ДетальНенайденнойОрганизации(АргументИНН, РезультатПоИНН.Ошибка);
			Возврат Результат;
		КонецЕсли;

		СсылкаИзАргумента = РезультатПоИНН.Ссылка;

	ИначеЕсли Не ПустаяСтрока(АргументНаименование) Тогда

		РезультатПоИмени = НайтиОрганизациюПоНаименованию(АргументНаименование);
		Если РезультатПоИмени.Ошибка <> "" Тогда
			Результат.Ошибка = РезультатПоИмени.Ошибка;
			Результат.Деталь = ДетальОрганизацииПоНаименованию(
				АргументНаименование, РезультатПоИмени.Ошибка, РезультатПоИмени.Кандидаты);
			Возврат Результат;
		КонецЕсли;

		СсылкаИзАргумента = РезультатПоИмени.Ссылка;

	КонецЕсли;

	Если СсылкаИзАргумента <> Неопределено Тогда

		Результат.Организации.Добавить(СсылкаИзАргумента);
		Результат.Источник = "argument";
		Результат.ПредставлениеОрганизаций = СокрЛП(Строка(СсылкаИзАргумента));

		Если СписокИзНастройки.Найти(СсылкаИзАргумента) = Неопределено
			И СписокИзНастройки.Количество() > 0 Тогда
			Результат.Предупреждения.Добавить("organization_out_of_scope");
		КонецЕсли;

		Возврат Результат;

	КонецЕсли;

	Если СписокИзНастройки.Количество() > 0 Тогда
		Результат.Организации = СписокИзНастройки;
		Результат.Источник = "constant";
		Результат.ПредставлениеОрганизаций = ПредставлениеСпискаОрганизаций(СписокИзНастройки);
		Возврат Результат;
	КонецЕсли;

	// Настройка пуста - смотрим, сколько организаций в базе всего.
	ВсеОрганизации = ВсеАктивныеОрганизации();
	Если ВсеОрганизации.Количество() = 1 Тогда
		Результат.Организации.Добавить(ВсеОрганизации[0]);
		Результат.Источник = "single_org";
		Результат.ПредставлениеОрганизаций = СокрЛП(Строка(ВсеОрганизации[0]));
		Возврат Результат;
	КонецЕсли;

	// В детали перечисляем организации С ИНН: без ИНН модель видит названия,
	// но повторить вызов ей нечем - organization_inn она взять неоткуда, и
	// диалог зацикливается на том же отказе. При большом справочнике список
	// не выводим (пустая трата контекста) - отправляем в search_organizations.
	Результат.Ошибка = "organization_scope_not_configured";
	Если ВсеОрганизации.Количество() <= 30 Тогда
		Результат.Деталь = СтрШаблон(
			НСтр("ru = 'Настройка ""ОрганизацииКонтроляОплат"" не заполнена, а в базе несколько организаций (%1): %2. Передай organization_name (наименование или его часть) либо organization_inn для разового просмотра одной организации, либо заполни настройку через set_setting.';
				|en = 'Setting ""ОрганизацииКонтроляОплат"" is not configured, and the database has multiple organizations (%1): %2. Pass organization_name or organization_inn for a single organization, or configure the setting via set_setting.'"),
			ВсеОрганизации.Количество(), ПредставлениеОрганизацийСИНН(ВсеОрганизации));
	Иначе
		Результат.Деталь = СтрШаблон(
			НСтр("ru = 'Настройка ""ОрганизацииКонтроляОплат"" не заполнена, а в базе несколько организаций (%1). Передай organization_name (наименование или его часть) либо organization_inn - нужную организацию можно найти через search_organizations.';
				|en = 'Setting ""ОрганизацииКонтроляОплат"" is not configured, and the database has multiple organizations (%1). Pass organization_name or organization_inn - use search_organizations to look one up.'"),
			ВсеОрганизации.Количество());
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Все организации без пометки удаления (для правила single_org/деталь ошибки
// organization_scope_not_configured).
//
Функция ВсеАктивныеОрганизации()

	ИмяРеальное = ar_ToolDispatcher.ИмяОбъектаМетаданных("Организации", "Организации");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяРеальное + " КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Человекочитаемое представление списка организаций через запятую.
Функция ПредставлениеСпискаОрганизаций(Знач МассивОрганизаций)
	Имена = Новый Массив;
	Для Каждого Орг Из МассивОрганизаций Цикл
		Имена.Добавить(СокрЛП(Строка(Орг)));
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

// Находит доп.свойство исключений из напоминаний об оплате по имени
// (PAY-01, §Исключения). Своего регистра исключений не заводим - используем
// штатное «Дополнительные реквизиты и сведения» БСП. Поле поиска - Имя
// (программный идентификатор), НЕ Заголовок (отображаемое наименование).
//
// Возвращаемое значение:
//  ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения либо
//  Неопределено (свойство не заведено администратором - не ошибка).
//
Функция НайтиСвойствоИсключенийПоИмени() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Свойства.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
		|ГДЕ
		|	Свойства.Имя = &Имя";
	Запрос.УстановитьПараметр("Имя", ИмяСвойстваИсключенийОплат());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Программное имя доп.свойства исключений из напоминаний об оплате -
// фиксированное, администратор заводит свойство с этим именем в «Дополнительных
// реквизитах и сведениях» (подсистема БСП «Свойства»).
//
Функция ИмяСвойстваИсключенийОплат() Экспорт
	Возврат "ar_ИсключитьИзНапоминанийОбОплате";
КонецФункции

// Проверяет, исключён ли счёт из напоминаний об оплате: взведённое Булево-
// значение доп.свойства у контрагента (Справочник.Контрагенты.
// ДополнительныеРеквизиты) ИЛИ у самого счёта (РегистрСведений.
// ДополнительныеСведения). Вызывается ТОЧЕЧНО для ОДНОГО счёта - единственный
// вызывающий код: prepare_payment_reminder_email (стадия 1, повторная
// проверка ПОСЛЕ того, как list_unpaid_invoices уже мог вернуть счёт без
// учёта позже взведённого свойства). Для list_unpaid_invoices (список,
// потенциально много строк) эта функция НЕ используется - там фильтрация
// исключений выполняется внутри самого запроса, см. докстринг
// ВыполнитьЗапросНеоплаченныхСчетов (Замечания ревью 1, п.2).
//
// Параметры:
//  СсылкаКонтрагента  - СправочникСсылка.Контрагенты.
//  СсылкаСчёта        - ДокументСсылка.СчетНаОплатуПокупателю.
//  СвойствоИсключений - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения.
//
// Возвращаемое значение:
//  Булево - Истина, если счёт исключён (по любому из двух источников).
//
Функция ПрименитьФильтрИсключений(Знач СсылкаКонтрагента, Знач СсылкаСчёта, Знач СвойствоИсключений) Экспорт

	Если СвойствоИсключений = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Найдено
		|ИЗ
		|	Справочник.Контрагенты.ДополнительныеРеквизиты КАК ДопРеквизиты
		|ГДЕ
		|	ДопРеквизиты.Ссылка = &Контрагент
		|	И ДопРеквизиты.Свойство = &Свойство
		|	И ДопРеквизиты.Значение = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДопСведения
		|ГДЕ
		|	ДопСведения.Объект = &Счёт
		|	И ДопСведения.Свойство = &Свойство
		|	И ДопСведения.Значение = ИСТИНА";
	Запрос.УстановитьПараметр("Контрагент", СсылкаКонтрагента);
	Запрос.УстановитьПараметр("Счёт", СсылкаСчёта);
	Запрос.УстановитьПараметр("Свойство", СвойствоИсключений);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

