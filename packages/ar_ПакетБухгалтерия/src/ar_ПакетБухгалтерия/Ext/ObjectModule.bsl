// Классифицировать исключение чтения документа: отличить структурную ошибку
// (несуществующий реквизит/поле - типично при несовпадении имён реквизитов
// целевой конфигурации с зашитыми в tool) от реального отказа доступа (RLS).
// Раньше ЛЮБОЕ исключение возвращалось как access_denied, маскируя причину и
// сбивая LLM/пользователя с толку. Текст ошибки очищается для LLM.
//
// Параметры:
//  ИнфоОбОшибке - ИнформацияОбОшибке - перехваченное исключение.
//
// Возвращаемое значение:
//  Строка - JSON: {"error":"document_read_error","detail":"..."} для структурных
//           ошибок либо {"error":"access_denied"} для отказов доступа.
//
Функция КлассифицироватьОшибкуЧтения(Знач ИнфоОбОшибке)

	ТекстПодробно = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
	ТекстНРег = НРег(ТекстПодробно);

	// Признаки отказа доступа (RLS / права).
	ПризнакиДоступа = "право доступа,недостаточно прав,access,rls,запрещено выполнять";
	Для Каждого Признак Из СтрРазделить(ПризнакиДоступа, ",") Цикл
		Если СтрНайти(ТекстНРег, СокрЛП(Признак)) > 0 Тогда
			Возврат ОшибочныйJSON("access_denied");
		КонецЕсли;
	КонецЦикла;

	// Иначе - структурная/иная ошибка чтения: отдаём реальный (очищенный) текст.
	ЧистыйТекст = ar_Утилиты.ОчиститьОшибкуДляLLM(ТекстПодробно);
	Возврат ОшибочныйJSONСДеталью("document_read_error", ЧистыйТекст);

КонецФункции

#КонецОбласти

#КонецОбласти


#Область ToolФинансы


// ДиспетчерФинансы второго уровня модуля ar_ToolФинансы. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolФинансы.
//
// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры (например "ЗапросПлатежей").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ДиспетчерФинансы(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "ЗапросПлатежей" Тогда
		Возврат ЗапросПлатежей(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПросроченнаяДебиторка" Тогда
		Возврат ПросроченнаяДебиторка(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПолучитьОстатокСчёта" Тогда
		Возврат ПолучитьОстатокСчёта(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПолучитьОстаток" Тогда
		Возврат ПолучитьОстаток(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ОтчётОПродажах" Тогда
		Возврат ОтчётОПродажах(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ОстаткиТоваров" Тогда
		Возврат ОстаткиТоваров(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СписокНеоплаченныхСчетов" Тогда
		Возврат СписокНеоплаченныхСчетов(Аргументы, Контекст);
	// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
	// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
	Иначе
		Возврат ОшибочныйJSONФинансы("unknown_procedure");
	КонецЕсли;

КонецФункции

