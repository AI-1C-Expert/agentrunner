// Адаптер описания buh_search_clients для манифеста пакета.
Функция ОписаниеПакетаToolПоискКлиентов()
	Описание = ОписаниеToolПоискКлиентов();
	Описание.Вставить("КраткоеОписание", НСтр("ru = 'Найти контрагента, клиента, поставщика по имени или ИНН';
		|en = 'Find a counterparty, client, or supplier by name or tax ID'"));
	Описание.Вставить("Категория", "buh_crm");
	Возврат Описание;
КонецФункции

