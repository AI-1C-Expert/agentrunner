#Область ToolДокументы

// ДиспетчерДокументы второго уровня модуля ar_ToolДокументы. Маршрутизирует вызов по
// имени процедуры БЕЗ Выполнить()/Вычислить(). Вызывается из
// ar_ToolDispatcher.ВыполнитьПроцедуруToolДокументы.
//
// !!! ДОБАВЛЯТЬ НОВУЮ TOOL-ПРОЦЕДУРУ ЗДЕСЬ: ветвь ИначеЕсли с делегированием
// в экспортную функцию модуля. Неизвестная процедура → {"error":"unknown_procedure"}.
//
// Параметры:
//  ИмяПроцедуры - Строка    - имя tool-процедуры (например "СоздатьЧерновикСчёта").
//  Аргументы    - Строка    - JSON-аргументы от LLM.
//  Контекст     - Структура - КонтекстЗапуска.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ДиспетчерДокументы(Знач ИмяПроцедуры, Знач Аргументы, Знач Контекст) Экспорт

	Если ИмяПроцедуры = "СоздатьЧерновикСчёта" Тогда
		Возврат СоздатьЧерновикСчёта(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ПолучитьСчёт" Тогда
		Возврат ПолучитьСчёт(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "ВалидироватьДокумент" Тогда
		Возврат ВалидироватьДокумент(Аргументы, Контекст);
	ИначеЕсли ИмяПроцедуры = "СоздатьАктСверки" Тогда
		Возврат СоздатьАктСверки(Аргументы, Контекст);
	Иначе
		Возврат ОшибочныйJSON("unknown_procedure");
	КонецЕсли;

КонецФункции

// Tool create_invoice_draft: построить payload черновика счёта и поставить в
// очередь approval.
//
// RiskLevel = Draft, ТребуетApproval = Истина. Валидирует аргументы, разыменовывает
// контрагента/номенклатуру, считает итог, формирует ActionPayloadJSON и ставит его
// в очередь approval (ar_Approval.Поставить, APPR-01). Документ НЕ создаётся
// немедленно - он создаётся после подтверждения оператором. Возвращает статус
// "queued_for_approval" с approval_id.
//
// Привилегированный режим НЕ используется - работа в правах пользователя сессии
// (постановку в привилегированную очередь инкапсулирует модуль ar_Approval).
//
// Параметры:
//  Аргументы - Строка    - JSON аргументов tool (см. JSONManifest в спеке).
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation: payload-preview / dry-run / {"error":"..."}.
//
Функция СоздатьЧерновикСчёта(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат СоздатьЧерновикСчётаВнутр(Аргументы, Контекст);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool get_invoice: чтение счёта на оплату по ссылке или номеру (read-only).
//
// RiskLevel = Read. DryRun игнорируется (чтение в dry-run безопасно).
//
// Параметры:
//  Аргументы - Строка    - JSON: {"invoice_ref":...,"invoice_number":...,"invoice_date":...}.
//  Контекст  - Структура - КонтекстЗапуска. Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON с данными счёта либо {"error":"..."}.
//
Функция ПолучитьСчёт(Знач Аргументы, Знач Контекст = Неопределено) Экспорт

	Попытка
		Возврат ПолучитьСчётВнутр(Аргументы);
	Исключение
		ТекстОшибки = ar_Утилиты.ОчиститьОшибкуДляLLM(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОшибочныйJSONСДеталью("internal_error", ТекстОшибки);
	КонецПопытки;

КонецФункции

// Tool validate_document: статическая проверка заполнения документа (read-only).
//
// RiskLevel = Read. DryRun игнорируется. Без сайд-эффектов и без вызова
// ПроверитьЗаполнение() - собственный набор проверок через запрос (спека §validate_document).
//
// Параметры:
//  Аргументы - Строка    - JSON: {"document_ref":...,"document_type":...}.
