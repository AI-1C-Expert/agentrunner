// Внешняя обработка ar_ПакетБухгалтерия - пакет tools AgentRunner «Бухгалтерия»
// (PKG-09).
//
// Namespace манифеста: "buh". Переносит из ядра расширения AgentRunner 10 tools,
// специфичных для прикладной конфигурации «Бухгалтерия предприятия» 3.0 (БП):
// поиск/обновление контрагентов (buh_search_clients, buh_update_client_contact),
// работа со счетами и актами сверки (buh_create_invoice_draft, buh_get_invoice,
// buh_validate_document, buh_create_reconciliation_act), финансовая аналитика
// (buh_get_account_balance, buh_find_overdue_receivables, buh_search_organizations,
// buh_list_unpaid_invoices).
//
// Контракт пакета - см. .docs/Контракт-пакета-tools.md:
//   * ar_ОписаниеTools()   - манифест пакета (namespace, версия, категории, tools).
//   * ar_ВыполнитьTool()   - единая точка входа вызова tool пакета (§1.6).
//   * ar_ИсполнитьApprovedTool() - отложенный исполнитель approved-действия
//     (§1.7.5) для mutating tools с ТребуетApproval=Истина - здесь единственный
//     такой tool: buh_create_invoice_draft. Вызывается ar_Approval (ядро) ПОСЛЕ
//     подтверждения оператором, не из ar_ВыполнитьTool напрямую.
//
// ПРОИСХОЖДЕНИЕ КОДА: реализации функций перенесены КОПИРОВАНИЕМ из ядровых
// общих модулей ar_ToolCRM, ar_ToolДокументы, ar_ToolФинансы (см. .docs/specs/
// PKG-09.md) без изменения бизнес-логики. Изменения при переносе:
//   1. Имена 10 tools получили префикс "buh_" (namespace-контракт PKG-01 §1.4 -
//      ar_ToolПакеты.ВалидироватьОдинTool безусловно отклоняет tool пакета без
//      префикса "<namespace>_").
//   2. Три модуля объединены в один ObjectModule (платформенное ограничение:
//      внешняя обработка не может содержать несколько общих модулей) - имена
//      приватных служебных функций, совпадавшие между исходными модулями,
//      разведены суффиксом домена (Документы/Финансы), чтобы не столкнуться
//      внутри одного модуля. Публичные точки входа (ПоискКлиентов,
//      СоздатьЧерновикСчёта, ПолучитьОстатокСчёта и т.п.) переименований не
//      получили - конфликтов имён между ними не было.
//   3. Ядровой upsert-регистратор ar_Tools (ЗарегистрироватьTools/
//      ЗарегистрироватьОдинTool/НайтиСсылкуToolПоИмени) не перенесён - пакеты
//      регистрируются другим механизмом (ar_ОписаниеTools -> PKG-03
//      ar_ToolПакеты.ЗаписатьПакетИTools), собственный upsert пакету не нужен.
//
// ИЗВЕСТНОЕ ОГРАНИЧЕНИЕ (зафиксировано в спеке PKG-09, раздел «Заметки»):
// контракт пакетов (ar_ToolПакеты.ЗарегистрироватьОдинToolПакета) не
// пробрасывает реквизит ar_Tools.ar_ТребуетАдаптер - третий, независимый
// критерий видимости tool в ar_ToolDispatcher.РезультатПроверкиДоступности
// (наличие зарегистрированного ar_АдаптерЗаполнения для текущей конфигурации).
// buh_create_invoice_draft и buh_create_reconciliation_act сами по себе
// внутри РЕАЛИЗАЦИИ по-прежнему используют ar_АдаптерЗаполнения (общий модуль
// ядра, доступен пакету) и корректно откажут понятной ошибкой, если адаптер
// не зарегистрирован - но сам факт "адаптер есть/нет" не влияет на то,
// покажет ли ядро эти два tool модели ДО вызова. Расширение контракта
// ar_ToolПакеты под ТребуетАдаптер вне объёма PKG-09.
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Регистрация внешней обработки в подсистеме БСП «Дополнительные отчёты и
// обработки». Вид = ДополнительнаяОбработка (глобальная, без Назначения),
// БезопасныйРежим = Истина по умолчанию (не переопределяется, см.
// .docs/Контракт-пакета-tools.md §1.1).
//
// Команда с Идентификатор = "ar_ToolPack" - маркер принадлежности пакета
// AgentRunner (см. examples/ar_ПакетПример, PKG-01/PKG-03).
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.12.205");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'AgentRunner: Бухгалтерия'");

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = НСтр("ru = 'Пакет инструментов AgentRunner: Бухгалтерия'");
	НоваяКоманда.Идентификатор        = "ar_ToolPack";
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Обработчик команды БСП "Дополнительные отчёты и обработки". Команда
// "ar_ToolPack" - маркерная (см. СведенияОВнешнейОбработке выше), прямого
// прикладного действия не выполняет - существует только для отбора
// кандидатов на регистрацию пакета ядром AgentRunner (PKG-03).
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "ar_ToolPack" Тогда
		ar_СлужебныйЛог.Записать("ar_ПакетБухгалтерия.ВыполнитьКоманду", "buh_toolpack_marker_invoked",
			НСтр("ru = 'ar_ToolPack - служебный маркер пакета инструментов AgentRunner,'
				|' прикладного действия по этой команде не предусмотрено.'"));
	КонецЕсли;

КонецПроцедуры

// Манифест пакета tools - контракт PKG-01 (.docs/Контракт-пакета-tools.md §1.4).
// Вызывается ядром AgentRunner при регистрации/переподтверждении пакета (PKG-03).
//
// Возвращаемое значение:
//  Структура - манифест пакета: schema_version, namespace, Версия, Категории,
//  Tools (см. §1.5 контракта).
//
Функция ar_ОписаниеTools() Экспорт

	Манифест = Новый Структура;
	Манифест.Вставить("schema_version", 1);
	Манифест.Вставить("namespace", "buh");
	Манифест.Вставить("Версия", "1.0.0");

	КатегорияCRM = Новый Структура;
	КатегорияCRM.Вставить("Имя", "buh_crm");
	КатегорияCRM.Вставить("Представление", НСтр("ru = 'Бухгалтерия: CRM'"));
	КатегорияCRM.Вставить("ОписаниеДляLLM", НСтр("ru = 'Работа с контрагентами (Бухгалтерия предприятия 3.0)'"));
	КатегорияCRM.Вставить("Порядок", 1);

	КатегорияДокументы = Новый Структура;
	КатегорияДокументы.Вставить("Имя", "buh_documents");
	КатегорияДокументы.Вставить("Представление", НСтр("ru = 'Бухгалтерия: Документы'"));
	КатегорияДокументы.Вставить("ОписаниеДляLLM", НСтр("ru = 'Счета на оплату, акты сверки (Бухгалтерия предприятия 3.0)'"));
	КатегорияДокументы.Вставить("Порядок", 2);

	КатегорияФинансы = Новый Структура;
	КатегорияФинансы.Вставить("Имя", "buh_finance");
	КатегорияФинансы.Вставить("Представление", НСтр("ru = 'Бухгалтерия: Финансы'"));
	КатегорияФинансы.Вставить("ОписаниеДляLLM", НСтр("ru = 'Остатки счетов, дебиторка, организации (Бухгалтерия предприятия 3.0)'"));
	КатегорияФинансы.Вставить("Порядок", 3);

	Категории = Новый Массив;
	Категории.Добавить(КатегорияCRM);
	Категории.Добавить(КатегорияДокументы);
	Категории.Добавить(КатегорияФинансы);
	Манифест.Вставить("Категории", Категории);

	Tools = Новый Массив;
	Tools.Добавить(ОписаниеПакетаToolПоискКлиентов());
	Tools.Добавить(ОписаниеПакетаToolОбновитьКонтакт());
	Tools.Добавить(ОписаниеПакетаToolСоздатьЧерновикСчёта());
	Tools.Добавить(ОписаниеПакетаToolПолучитьСчёт());
	Tools.Добавить(ОписаниеПакетаToolВалидироватьДокумент());
	Tools.Добавить(ОписаниеПакетаToolСоздатьАктСверки());
	Tools.Добавить(ОписаниеПакетаToolПолучитьОстатокСчёта());
	Tools.Добавить(ОписаниеПакетаToolПросроченнаяДебиторка());
	Tools.Добавить(ОписаниеПакетаToolПоискОрганизаций());
	Tools.Добавить(ОписаниеПакетаToolСписокНеоплаченныхСчетов());
	Манифест.Вставить("Tools", Tools);

	Возврат Манифест;

КонецФункции

// Единая точка входа вызова tools пакета - контракт PKG-01 (.docs/Контракт-
// пакета-tools.md §1.6). Вызывается ядром AgentRunner (ar_ToolПлагинВызов)
// на каждый вызов tool из этого пакета. Диспетчеризация внутри пакета - без
// Выполнить()/Вычислить(), по имени с namespace-префиксом "buh_".
//
// Параметры:
//  ИмяTool       - Строка    - полное имя tool с namespace (например
//                  "buh_search_clients").
//  АргументыJSON - Строка    - JSON-объект аргументов от LLM, обогащённый
//                  ядром системными полями _dry_run/_idempotency_key.
//  Контекст      - Структура - контекст запуска (RunId, Sequence, DryRun,
//                  при наличии - Агент). Может быть Неопределено.
//
// Возвращаемое значение:
//  Строка - JSON-observation.
//
Функция ar_ВыполнитьTool(Знач ИмяTool, Знач АргументыJSON, Знач Контекст) Экспорт

	Если ИмяTool = "buh_search_clients" Тогда
		Возврат ПоискКлиентов(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_update_client_contact" Тогда
		Возврат ОбновитьКонтактКлиента(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_create_invoice_draft" Тогда
		Возврат СоздатьЧерновикСчёта(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_get_invoice" Тогда
		Возврат ПолучитьСчёт(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_validate_document" Тогда
		Возврат ВалидироватьДокумент(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_create_reconciliation_act" Тогда
		Возврат СоздатьАктСверки(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_get_account_balance" Тогда
		Возврат ПолучитьОстатокСчёта(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_find_overdue_receivables" Тогда
		Возврат ПросроченнаяДебиторка(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_search_organizations" Тогда
		Возврат ПоискОрганизаций(АргументыJSON, Контекст);
	ИначеЕсли ИмяTool = "buh_list_unpaid_invoices" Тогда
		Возврат СписокНеоплаченныхСчетов(АргументыJSON, Контекст);
	Иначе
		Возврат ОшибкаПакета("unknown_tool");
	КонецЕсли;

КонецФункции

// Отложенный исполнитель approved-действия (.docs/Контракт-пакета-tools.md
// §1.7.5) - вызывается ЯДРОМ (ar_ToolDispatcher.ИсполнитьApprovedДействиеПакета
// -> ar_ToolПлагинВызов.ВызватьИсполнениеApproved) ПОСЛЕ подтверждения
// оператором в ar_Approval, НЕ из ar_ВыполнитьTool напрямую. Единственный tool
// пакета с ТребуетApproval=Истина - buh_create_invoice_draft: документ
// «Счёт на оплату» не создаётся при постановке в очередь, а создаётся ЗДЕСЬ.
//
// buh_create_reconciliation_act формально тоже разбирается (симметрично
// исходному ar_ToolДокументы.ИсполнитьСоздатьАктСверки), хотя на практике
// НЕДОСТИЖИМ этим путём: create_reconciliation_act записывает документ сразу
// внутри ar_ВыполнитьTool (ТребуетApproval=Ложь, решение RECON-01,
// .docs/specs/RECON-01.md) и никогда не проходит через очередь approval.
//
// Параметры:
//  ИмяTool           - Строка - полное имя tool с namespace.
//  ApprovalId        - Строка - идентификатор записи очереди ar_ОчередьApproval.
//  ActionPayloadJSON - Строка - JSON, сохранённый в очереди при постановке
//                      (см. ar_Approval.СобратьActionPayloadJSON).
//
// Возвращаемое значение:
//  Структура - {Выполнено: Булево, Сообщения: Массив строк,
//               [DocumentRef: ЛюбаяСсылка]} - контракт ar_Approval.
//               Неизвестное для пакета имя tool -> {Выполнено: Ложь,
//               Сообщения: ["no_executor_for_action:<имя>"]}.
//
Функция ar_ИсполнитьApprovedTool(Знач ИмяTool, Знач ApprovalId, Знач ActionPayloadJSON) Экспорт

	Если ИмяTool = "buh_create_invoice_draft" Тогда
		Возврат ИсполнитьСоздатьЧерновикСчёта(ApprovalId, ActionPayloadJSON);
	ИначеЕсли ИмяTool = "buh_create_reconciliation_act" Тогда
		Возврат ИсполнитьСоздатьАктСверки(ApprovalId, ActionPayloadJSON);
	Иначе
		Результат = Новый Структура("Выполнено, DocumentRef, Сообщения", Ложь, Неопределено, Новый Массив);
		Результат.Сообщения.Добавить("no_executor_for_action:" + ИмяTool);
		Возврат Результат;
	КонецЕсли;

КонецФункции

// Формирует JSON-строку ошибки-observation для контракта ar_ВыполнитьTool.
//
// Параметры:
//  КодОшибки - Строка - машиночитаемый код ошибки.
//
// Возвращаемое значение:
//  Строка - JSON вида {"error":"<код>"}.
//
Функция ОшибкаПакета(Знач КодОшибки)
	Объект = Новый Структура;
	Объект.Вставить("error", КодОшибки);
	Возврат ar_JSON.ВЗначениеJSON(Объект);
КонецФункции

#Область ОписанияПакетаTools

// Ниже - тонкие адаптеры контракта манифеста ПАКЕТА (.docs/Контракт-пакета-
// tools.md §1.5) поверх ЯДРОВЫХ функций-описаний ОписаниеTool* (перенесены
// без изменений из ar_ToolCRM/ar_ToolДокументы/ar_ToolФинансы вместе с
// реализацией - см. область РегистрацияTools ниже по модулю). Ядровые поля
