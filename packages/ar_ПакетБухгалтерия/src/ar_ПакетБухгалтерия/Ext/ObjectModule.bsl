	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", СписокИзСтрок("query"));

	Возврат ОбернутьВOpenAIФормат("buh_search_clients",
		"Поиск контрагентов по строке (наименование, полное наименование, ИНН). Read-only.",
		Параметры);
