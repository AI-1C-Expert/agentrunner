// JSON Schema аргументов update_client_contact (DoD D11), обёрнутая в OpenAI tool-format.
Функция МанифестОбновитьКонтакт()
	Свойства = Новый Структура;
	Свойства.Вставить("client_ref", СвойствоСхемы("string",
		"Навигационная ссылка (e1cib/...) или UUID контрагента."));
	Свойства.Вставить("phone", СвойствоСхемы("string", "Новый номер телефона (произвольный формат)."));
	Свойства.Вставить("email", СвойствоСхемы("string", "Новый адрес электронной почты."));
	Свойства.Вставить("contact_person", СвойствоСхемы("string", "Имя контактного лица."));
	Свойства.Вставить("comment", СвойствоСхемы("string", "Комментарий к изменению для оператора approval."));

	Параметры = Новый Структура;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", СписокИзСтрок("client_ref"));

	Возврат ОбернутьВOpenAIФормат("buh_update_client_contact",
		"Подготовить изменение контактных данных контрагента (телефон, email,"
		+ " контактное лицо). Этап 1: read-only, возвращает proposed_changes без записи.",
		Параметры);
КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format:
// {"type":"function","function":{"name","description","parameters"}}.
// Формат обязателен для всех LLM-провайдеров (OpenAI-совместимые API, включая
// локальные - LM Studio и т.п.) - без обёртки провайдер возвращает 400 на
// список tools (см. ar_ToolUniversal.МанифестTool - образец контракта).
Функция ОбернутьВOpenAIФормат(Знач Имя, Знач Описание, Знач Параметры)
	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", Имя);
	ФункцияОписание.Вставить("description", Описание);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);
	Возврат СтруктуруВJSON(Манифест);
КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
Функция СвойствоСхемы(Знач Тип, Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Массив из одной строки (для поля required JSON Schema).
Функция СписокИзСтрок(Знач Значение)
	Список = Новый Массив;
	Список.Добавить(Значение);
	Возврат Список;
КонецФункции



#КонецОбласти

// Десериализует JSON-строку аргументов в Соответствие.
// Возвращает Неопределено при ошибке парсинга.
Функция ДесериализоватьАргументы(Знач АргументыJSON)

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или ПустаяСтрока(АргументыJSON) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(АргументыJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Читает значение из коллекции (Соответствие/Структура) с дефолтом.
Функция ПолучитьЗначениеИзКоллекции(Знач Коллекция, Знач Ключ, Знач Дефолт)

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Значение = Коллекция.Получить(Ключ);
		Если Значение = Неопределено Тогда
			Возврат Дефолт;
		КонецЕсли;
		Возврат Значение;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Коллекция.Свойство(Ключ, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Дефолт;
	КонецЕсли;

	Возврат Дефолт;

КонецФункции

// Экранирует спецсимволы оператора ПОДОБНО.
// Символ экранирования — тильда "~". В тексте запроса ключевое слово
// языка запросов называется СПЕЦСИМВОЛ, а не ЭКРАНИРОВАНИЕ — конструкция
// ПОДОБНО &Параметр ЭКРАНИРОВАНИЕ "~" вызывает ошибку парсера
// ("Expression expected \")\"" на месте ЭКРАНИРОВАНИЕ), т.к. такого
// ключевого слова в языке запросов 1С не существует.
//
// Своей реализации здесь нет: берём штатную функцию БСП
// [Реф: БСП/ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе]. Она
// экранирует полный набор служебных символов "~_%[]^", тогда как прежний
// самописный вариант обрабатывал только "~_%[" — незакрытая скобка "]" и
// символ отрицания "^" уходили в шаблон как есть. Требование #std726.
Функция ЭкранироватьПодобно(Знач СтрокаПоиска)

	Возврат ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(СтрокаПоиска);

КонецФункции

// Полное имя таблицы "Справочник.<ИмяВМетаданных>" для источника запроса.
// Имя объекта метаданных берётся с учётом переопределения (регистр
// ar_ПереопределенияОбъектов, см. ar_ToolDispatcher.ИмяОбъектаМетаданных) -
// для целевых конфигураций, где справочник называется не "Контрагенты"
// (например, демо-конфигурация со справочником "_ДемоКонтрагенты").
// Алиас "Контрагенты" в тексте запроса остаётся прежним - меняется только
// имя таблицы-источника, поля запроса продолжают обращаться через алиас.
Функция ИмяТаблицыКонтрагенты()
	Возврат "Справочник." + ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты");
КонецФункции

// Строит и выполняет запрос к справочнику Контрагенты.
Функция ВыполнитьЗапросКонтрагентов(Знач СтрокаПоиска, Знач Лимит,
		Знач ЕстьПолноеНаименование, Знач ЕстьИНН, Знач ЕстьКПП, Знач ЕстьЮрФизЛицо)

	ПоляВыборки = "Контрагенты.Ссылка КАК Ссылка," + Символы.ПС
		+ "	Контрагенты.Наименование КАК Наименование";

	Если ЕстьПолноеНаименование Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.НаименованиеПолное КАК НаименованиеПолное";
	КонецЕсли;
	Если ЕстьИНН Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.ИНН КАК ИНН";
	КонецЕсли;
	Если ЕстьКПП Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.КПП КАК КПП";
	КонецЕсли;
	Если ЕстьЮрФизЛицо Тогда
		ПоляВыборки = ПоляВыборки + "," + Символы.ПС + "	Контрагенты.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо";
	КонецЕсли;

	// Условие поиска: по Наименование (всегда) + НаименованиеПолное и ИНН — если есть.
	УсловияПоиска = "Контрагенты.Наименование ПОДОБНО &ШаблонПоиска СПЕЦСИМВОЛ ""~""";
	Если ЕстьПолноеНаименование Тогда
		УсловияПоиска = УсловияПоиска + Символы.ПС
			+ "	ИЛИ Контрагенты.НаименованиеПолное ПОДОБНО &ШаблонПоиска СПЕЦСИМВОЛ ""~""";
	КонецЕсли;
	Если ЕстьИНН Тогда
		УсловияПоиска = УсловияПоиска + Символы.ПС
			+ "	ИЛИ Контрагенты.ИНН = &ТочныйПоиск";
	КонецЕсли;

	// ВЫБРАТЬ ПЕРВЫЕ N требует константу в тексте запроса, не параметр (&Лимит
	// синтаксически недопустим на этом месте). Лимит уже провалидирован
	// вызывающей стороной как целое число 1..50 (см. п.3 ВыполнитьSearchClients).
	// Формат(..., "ЧГ=0") - обязателен: Строка(Лимит) для чисел >= 1000 вставляет
	// разделитель групп ("1 500"), что ломает текст запроса.
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ "	" + ПоляВыборки + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	" + ИмяТаблицыКонтрагенты() + " КАК Контрагенты" + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ "	НЕ Контрагенты.ПометкаУдаления" + Символы.ПС
		+ "	И (" + УсловияПоиска + ")";

	// Учёт иерархичности — добавим И НЕ ЭтоГруппа только если справочник иерархический.
	// Метаданные.Справочники.Найти() вместо точечной нотации Метаданные.Справочники.
	// Контрагенты - последняя жёстко ссылается на конкретный объект метаданных
	// и не может учитывать переопределение имени (ar_ПереопределенияОбъектов).
	МДКонтрагентыИерарх = Метаданные.Справочники.Найти(
		ar_ToolDispatcher.ИмяОбъектаМетаданных("Контрагенты", "Контрагенты"));
	Если МДКонтрагентыИерарх <> Неопределено И МДКонтрагентыИерарх.Иерархический Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	И НЕ Контрагенты.ЭтоГруппа";
	КонецЕсли;

	ЭкранированныйПоиск = ЭкранироватьПодобно(СтрокаПоиска);
	ШаблонПоиска = "%" + ЭкранированныйПоиск + "%";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ШаблонПоиска", ШаблонПоиска);
	Запрос.УстановитьПараметр("ТочныйПоиск", СтрокаПоиска);

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Сериализует выборку в JSON-строку результата.
Функция СериализоватьРезультат(ВыборкаДанных, Знач ЕстьПолноеНаименование, Знач ЕстьИНН,
		Знач ЕстьКПП, Знач ЕстьЮрФизЛицо, Знач Предупреждение)

	Элементы = Новый Массив;
	Счётчик = 0;

	Пока ВыборкаДанных.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ref", ПолучитьНавигационнуюСсылку(ВыборкаДанных.Ссылка));
		Элемент.Вставить("name", Строка(ВыборкаДанных.Наименование));

		Если ЕстьПолноеНаименование Тогда
			Элемент.Вставить("full_name", Строка(ВыборкаДанных.НаименованиеПолное));
		КонецЕсли;
		Если ЕстьИНН Тогда
			Элемент.Вставить("inn", Строка(ВыборкаДанных.ИНН));
		КонецЕсли;
		Если ЕстьКПП Тогда
			Элемент.Вставить("kpp", Строка(ВыборкаДанных.КПП));
		КонецЕсли;
		Если ЕстьЮрФизЛицо Тогда
			// Сравниваем напрямую со значением перечисления: представление зависит
			// от языка пользователя и в локализованных конфигурациях даёт ложь.
			Элемент.Вставить("is_individual",
				ЭтоФизическоеЛицо(ВыборкаДанных.ЮридическоеФизическоеЛицо));
		КонецЕсли;

		Элементы.Добавить(Элемент);
		Счётчик = Счётчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("total_found", Счётчик);
	Если НЕ ПустаяСтрока(Предупреждение) Тогда
		Результат.Вставить("warning", Предупреждение);
	КонецЕсли;

	Возврат СтруктуруВJSON(Результат);

КонецФункции

// Формирует JSON-строку ошибки в формате контракта tool.
Функция СформироватьОшибку(Знач СообщениеОбОшибке)

	Результат = Новый Структура;
	Результат.Вставить("error", СообщениеОбОшибке);
	Результат.Вставить("items", Новый Массив);
	Возврат СтруктуруВJSON(Результат);

КонецФункции

