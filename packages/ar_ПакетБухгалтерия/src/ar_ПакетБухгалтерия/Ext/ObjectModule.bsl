// Tool find_overdue_receivables: просроченная дебиторская задолженность.
//
// RECON-01: алиас-пресет над ПолучитьОстатокСчёта - тот же расчёт с
// account="62" (расчёты с покупателями), only_debit=true (только сальдо
// Дт > 0, то есть должники). Явные значения account/only_debit из Аргументы
// (если LLM их всё же передала) НЕ переопределяют пресет - контракт tool
// фиксирован (обратная совместимость существующих пресетов, см.
// .docs/specs/RECON-01.md, раздел «find_overdue_receivables»).
//
// RiskLevel = Read, DryRun игнорируется.
//
Функция ПросроченнаяДебиторка(Знач Аргументы, Знач Контекст) Экспорт

	Попытка
		Объект = ar_JSON.ИзJSON(Аргументы);
	Исключение
		Объект = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Объект = Новый Соответствие;
	КонецЕсли;

	АргументыПресета = Новый Соответствие;
	Для Каждого КлючЗначение Из Объект Цикл
		АргументыПресета.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	АргументыПресета.Вставить("account", "62");
	АргументыПресета.Вставить("only_debit", Истина);

	Возврат ПолучитьОстатокСчётаВнутр(ar_JSON.ВЗначениеJSON(АргументыПресета));

КонецФункции

