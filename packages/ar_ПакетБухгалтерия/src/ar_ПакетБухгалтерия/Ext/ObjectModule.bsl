// Массив из двух строк (для поля ТребуемыеОбъекты list_unpaid_invoices).
Функция СписокДвухСтрокФинансы(Знач Значение1, Знач Значение2)
	Список = Новый Массив;
	Список.Добавить(Значение1);
	Список.Добавить(Значение2);
	Возврат Список;
КонецФункции

// Оборачивает JSON Schema параметров в единый OpenAI tool-format (см.
// ar_ToolCRM.ОбернутьВOpenAIФормат - единый контракт для всех tool-модулей).
Функция ОбернутьВOpenAIФорматФинансы(Знач Имя, Знач Описание, Знач Параметры)
	ФункцияОписание = Новый Структура;
	ФункцияОписание.Вставить("name", Имя);
	ФункцияОписание.Вставить("description", Описание);
	ФункцияОписание.Вставить("parameters", Параметры);

	Манифест = Новый Структура;
	Манифест.Вставить("type", "function");
	Манифест.Вставить("function", ФункцияОписание);

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "");
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Манифест);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

// Элемент JSON Schema: { "type": ..., "description": ... }.
Функция СвойствоСхемыФинансы(Знач Тип, Знач Описание)
	Свойство = Новый Структура;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;
КонецФункции

// Массив из одной строки (для поля ТребуемыеОбъекты).
Функция СписокИзСтрокФинансы(Знач Значение)
	Список = Новый Массив;
	Список.Добавить(Значение);
	Возврат Список;
КонецФункции



